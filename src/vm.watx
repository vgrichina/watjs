      (if (i32.ne (call $tok_kind) (i32.const 20))
        (then (block $ae (loop $al
          (br_if $ae (i32.eq (call $tok_kind) (i32.const 20)))  ;; ']' (trailing comma)
          (if (i32.eq (call $tok_kind) (i32.const 22))  ;; elision: ,, → a real hole
            (then
              (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_hole))
              (call $vm_emit_op (local.get $code) (i32.const 52)))  ;; APPEND hole
            (else (if (i32.eq (call $tok_kind) (i32.const 54))  ;; ...spread
              (then
                (call $next_token)
                ;; a SpreadElement requires an AssignmentExpression operand (`[...]` / `[..., 1]` → SyntaxError)
                (if (i32.or (i32.eq (call $tok_kind) (i32.const 20)) (i32.or (i32.eq (call $tok_kind) (i32.const 22)) (i32.eq (call $tok_kind) (i32.const 0))))
                  (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Unexpected token after spread operator")) (return)))
                (call $vm_c_expr (local.get $code))
                (call $vm_emit_op (local.get $code) (i32.const 53)))  ;; SPREAD into array
              (else
                (call $vm_c_expr (local.get $code))
                (call $vm_emit_op (local.get $code) (i32.const 52))))))  ;; APPEND
