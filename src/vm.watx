      (i32.store (i32.add (i32.add (local.get $fn) (i32.const 44)) (i32.mul (local.get $np) (i32.const 4))) (i32.sub (i32.load (i32.const 696)) (i32.sub (local.get $arrsrcstart) (i32.const 1)))))
    (else (i32.store (i32.add (i32.add (local.get $fn) (i32.const 40)) (i32.mul (local.get $np) (i32.const 4))) (i32.const 0))))
  (call $vm_emit_op (local.get $code) (i32.const 61)) (call $vm_emit_op (local.get $code) (local.get $fn))  ;; CLOSURE (capture defining scope)
  (i32.store (i32.const 680) (local.get $litstart)) (i32.store (i32.const 684) (call $vm_emit_cursor)))  ;; record arrow-literal span [680,684] for name-inference

;; class declaration/expression. Cursor at 'class'. Builds the prototype object,
;; the constructor, and methods (static members stored on the prototype for now).
;; isExpr=1 leaves the class value on the operand stack; isExpr=0 (declaration)
;; STOREVARs it under the class name.
(func $vm_c_class (param $code i32) (param $isExpr i32) (effects)
  (call $next_token)  ;; 'class'
  (let $clsname i32 (i32.const 0))  ;; optional (anonymous class expression)
  (if (i32.and (i32.eq (call $tok_kind) (i32.const 3)) (i32.eqz (call $tok_is_kw (cstring "extends"))))
    (then (set! $clsname (call $ident_name)) (call $next_token)))
  (let $litstart i32 (call $vm_emit_cursor))  ;; class-literal emit span start (IsAnonymousFunctionDefinition)
  (let $protoT i32 (call $vm_tmpname))
  (let $ctorT i32 (call $vm_tmpname))
  (let $superT i32 (i32.const 0))
  (if (call $tok_is_kw (cstring "extends"))
    (then
      (call $next_token)
      (set! $superT (call $vm_tmpname))
      (call $vm_c_postfix (local.get $code))
      (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $superT))))
  (call $next_token)  ;; '{'
  (call $vm_emit_op (local.get $code) (i32.const 36)) (call $vm_emit_op (local.get $code) (i32.const 0))  ;; NEWOBJ 0 → empty proto
  (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $protoT))
  ;; per-instance field initializers: a flat array [name1, thunk1, ...] stored on the
  ;; proto as @@fieldinits and replayed by NEW/NEWSPREAD onto each instance.
  (let $fieldsT i32 (call $vm_tmpname))
  (call $vm_emit_op (local.get $code) (i32.const 29)) (call $vm_emit_op (local.get $code) (i32.const 0))  ;; NEWARRAY 0 (instance fields)
  (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $fieldsT))
  (let $staticT i32 (call $vm_tmpname))
  (call $vm_emit_op (local.get $code) (i32.const 29)) (call $vm_emit_op (local.get $code) (i32.const 0))  ;; NEWARRAY 0 (static fields)
  (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $staticT))
  (let $hasstatic i32 (i32.const 0))  ;; any static FIELD seen? (only then emit APPLYSTATIC, so SETPROTO stays the last op for name inference)
  ;; static METHODS/accessors are deferred into this [kind,key,fn,...] triples array and
  ;; applied to the CONSTRUCTOR (not the prototype) after it is built — the ctor value isn't
  ;; available during the member loop (it may textually follow). kind: 0=method,1=get,2=set.
  (let $smethT i32 (call $vm_tmpname))
  (call $vm_emit_op (local.get $code) (i32.const 29)) (call $vm_emit_op (local.get $code) (i32.const 0))  ;; NEWARRAY 0 (static methods)
  (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $smethT))
  (let $hassmeth i32 (i32.const 0))  ;; any static METHOD/accessor seen? (only then emit APPLYSMETHS)
  (if (local.get $superT)
    (then
      (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $protoT))
      (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $superT))
      (call $vm_emit_op (local.get $code) (i32.const 57))  ;; EXTEND → [proto]
      (call $vm_emit_op (local.get $code) (i32.const 11))))
  (let $hasctor i32 (i32.const 0))
  (block $cme (loop $cml
    (br_if $cme (i32.eq (call $tok_kind) (i32.const 18)))  ;; '}'
    (br_if $cme (i32.eq (call $tok_kind) (i32.const 0)))
    (if (call $eat (i32.const 21)) (then (br $cml)))  ;; stray ';' between members
    ;; leading modifiers: `static`, then `async`, then `*` (generator). `async *` is an async
    ;; generator method; `async` alone is an async method (both parsed below).
    (let $isgen i32 (i32.const 0))
    (let $isasync i32 (i32.const 0))
    (let $isstatic i32 (i32.const 0))
    (let $memberstart i32 (i32.const 0))  ;; source start of the method definition (after `static`, incl. get/set/async/*)
    (if (call $str_eq (call $ident_name) (cstring "static"))  ;; `static` modifier (unless member named "static")
      (then
        (let $stc i32 (call $cursor_save))
        (call $next_token)
        (if (i32.or (i32.eq (call $tok_kind) (i32.const 15)) (i32.or (i32.eq (call $tok_kind) (i32.const 24)) (i32.or (i32.eq (call $tok_kind) (i32.const 18)) (i32.eq (call $tok_kind) (i32.const 21)))))  ;; `(` `=` `}` `;` after `static` → it's a member NAMED "static", not the modifier
          (then (call $cursor_restore (local.get $stc)))
          (else (set! $isstatic (i32.const 1))))))  ;; confirmed `static` modifier
    ;; static initialization block: `static { ... }` → append [@@staticblock, blockThunk] to staticT
    (if (i32.and (local.get $isstatic) (i32.eq (call $tok_kind) (i32.const 17)))
      (then
        (set! $hasstatic (i32.const 1))
        (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $staticT))  ;; LOADVAR staticT
        (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_str (cstring "@@staticblock")))  ;; PUSH sentinel name
        (call $vm_emit_op (local.get $code) (i32.const 52))  ;; APPEND name
        (call $vm_emit_block_thunk (local.get $code))  ;; → blockThunk on stack
        (call $vm_emit_op (local.get $code) (i32.const 52))  ;; APPEND thunk
        (call $vm_emit_op (local.get $code) (i32.const 11))  ;; POP array
        (br $cml)))  ;; next class member
    (set! $memberstart (call $tok_start))  ;; method-def starts here (after `static`, before async/*/get/set/name)
    ;; `async` modifier (unless the member is named "async", e.g. `async(){}` / `async = 1`,
    ;; or a LineTerminator follows — then `async` is the method name per [no LineTerminator here]).
    (if (call $str_eq (call $ident_name) (cstring "async"))
      (then
        (let $asc i32 (call $cursor_save))
        (call $next_token)
        (if (i32.or (call $nl_before) (i32.or (i32.eq (call $tok_kind) (i32.const 15)) (i32.or (i32.eq (call $tok_kind) (i32.const 24)) (i32.eq (call $tok_kind) (i32.const 18)))))
          (then (call $cursor_restore (local.get $asc)))
          (else (set! $isasync (i32.const 1))))))  ;; confirmed `async` modifier
    (if (i32.eq (call $tok_kind) (i32.const 12)) (then (set! $isgen (i32.const 1)) (call $next_token)))  ;; `*` generator method (async `*` → async generator)
    (if (i32.eq (call $tok_kind) (i32.const 19))  ;; [computed](){} method  |  [computed] = field
      (then
        (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $protoT))  ;; LOADVAR proto
        (call $next_token) (call $vm_c_expr (local.get $code)) (call $next_token)  ;; '[' key ']' → [proto, key]
        (if (i32.eq (call $tok_kind) (i32.const 15))  ;; method → non-enumerable {W,C}, name from key
          (then
            (i32.store (i32.const 236) (local.get $isgen)) (i32.store (i32.const 232) (local.get $isasync))
            (i32.store (i32.const 700) (i32.add (local.get $memberstart) (i32.const 1)))  ;; class method source span
            (if (local.get $isstatic)
              (then  ;; static computed method → defer onto smethT ([0,key,fn]); stack is [proto, key]
                (i32.store (i32.const 692) (i32.const 1))  ;; static method → no .prototype
                (let $cmk i32 (call $vm_tmpname))
                (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $cmk))  ;; STOREVAR key → [proto]
                (call $vm_emit_op (local.get $code) (i32.const 11))  ;; POP proto
                (set! $hassmeth (i32.const 1))
                (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $smethT))  ;; LOADVAR smethT
                (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $num (f64.const 0)))  ;; kind 0=method
                (call $vm_emit_op (local.get $code) (i32.const 52))  ;; APPEND kind
                (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $cmk))  ;; LOADVAR key
                (call $vm_emit_op (local.get $code) (i32.const 52))  ;; APPEND key
                (call $vm_c_fnbody (local.get $code) (i32.const 0))  ;; → [smethT, fn]
                (call $vm_emit_op (local.get $code) (i32.const 52))  ;; APPEND fn
                (call $vm_emit_op (local.get $code) (i32.const 11)))  ;; POP smethT
              (else
                (call $vm_c_fnbody (local.get $code) (i32.const 0))  ;; → [proto, key, fn]
                (call $vm_emit_op (local.get $code) (i32.const 87)))))  ;; DEFMETH_KEY (pops all three)
          (else  ;; computed field [k] = v (stack: [proto, key]) → append [key, thunk] to static/instance array
            (let $ck i32 (call $vm_tmpname))
            (if (local.get $isstatic) (then (set! $hasstatic (i32.const 1))))
            (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $ck))  ;; STOREVAR key → [proto]
            (call $vm_emit_op (local.get $code) (i32.const 11))  ;; POP proto → []
            (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (if i32 (local.get $isstatic) (then (local.get $staticT)) (else (local.get $fieldsT))))  ;; LOADVAR target array
            (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $ck))  ;; LOADVAR key
            (call $vm_emit_op (local.get $code) (i32.const 52))  ;; APPEND key
            (if (i32.eq (call $tok_kind) (i32.const 24))  ;; = initializer
              (then (call $next_token) (call $vm_emit_field_thunk (local.get $code)))
              (else (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef))))
            (call $vm_emit_op (local.get $code) (i32.const 52))  ;; APPEND thunk/undef
            (call $vm_emit_op (local.get $code) (i32.const 11))))  ;; POP array
        (drop (call $eat (i32.const 21)))
        (br $cml)))
    ;; getter/setter:  get NAME(){}  |  set NAME(arg){}
    (let $gsc i32 (call $cursor_save))
    (let $gsk i32 (call $ident_name)) (call $next_token)
    (if (i32.and (i32.or (call $str_eq (local.get $gsk) (cstring "get")) (call $str_eq (local.get $gsk) (cstring "set")))
                 (i32.or (i32.eq (call $tok_kind) (i32.const 3)) (i32.or (i32.eq (call $tok_kind) (i32.const 2)) (i32.or (i32.eq (call $tok_kind) (i32.const 1)) (i32.eq (call $tok_kind) (i32.const 19))))))  ;; get/set NAME|"str"|NUM|[computed](){}
      (then
