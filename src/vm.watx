  (if (local.get $sphas)
    (then  ;; build an args array, then CALLSPREAD
      (call $vm_emit_op (local.get $code) (i32.const 29)) (call $vm_emit_op (local.get $code) (i32.const 0))  ;; NEWARRAY 0
      (if (i32.ne (call $tok_kind) (i32.const 16))
        (then (block $se2 (loop $sl2
          (br_if $se2 (i32.eq (call $tok_kind) (i32.const 16)))  ;; trailing comma → ')' ends the args
          (if (i32.eq (call $tok_kind) (i32.const 54))
            (then (call $next_token)
                  (if (i32.or (i32.eq (call $tok_kind) (i32.const 16)) (i32.or (i32.eq (call $tok_kind) (i32.const 22)) (i32.eq (call $tok_kind) (i32.const 0))))
                    (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Unexpected token after spread operator")) (return)))  ;; `f(...)` → SyntaxError
                  (call $vm_c_expr (local.get $code)) (call $vm_emit_op (local.get $code) (i32.const 53)))  ;; SPREAD
            (else (call $vm_c_expr (local.get $code)) (call $vm_emit_op (local.get $code) (i32.const 52))))  ;; APPEND
          (br_if $se2 (i32.eqz (call $eat (i32.const 22))))
          (br $sl2)))))
      (call $next_token)  ;; ')'
      (if (local.get $devmark) (then (call $vm_emit_op (local.get $code) (i32.const 118)) (call $vm_emit_op (local.get $code) (local.get $devmark))))  ;; DIRECTEVALMARK
      (call $vm_emit_op (local.get $code) (i32.const 54))  ;; CALLSPREAD
      (return)))
  (let $argc i32 (i32.const 0))
  (if (i32.ne (call $tok_kind) (i32.const 16))
    (then (block $ce (loop $cl
      (br_if $ce (i32.eq (call $tok_kind) (i32.const 16)))  ;; trailing comma → ')'
      (call $vm_c_expr (local.get $code))
      (set! $argc (i32.add (local.get $argc) (i32.const 1)))
      (br_if $ce (i32.eqz (call $eat (i32.const 22))))
      (br $cl)))))
