        (i32.store (i32.add (local.get $h) (i32.const 4)) (i32.load (i32.add (local.get $code) (i32.add (local.get $ip) (i32.const 4)))))  ;; catch var name
        (i32.store (i32.add (local.get $h) (i32.const 8)) (local.get $frame))
        (i32.store (i32.add (local.get $h) (i32.const 12)) (local.get $sp))
        (i32.store (i32.add (local.get $h) (i32.const 16)) (local.get $scope))
