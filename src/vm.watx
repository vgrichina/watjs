  ;; reg 884: is `super()` CALL allowed? Only inside a DERIVED class constructor (reg404==2). Same
  ;; lexical rules as reg 868 (arrows inherit; plain fn/field-init reset). Saved/restored per body.
  (let $savesupercall i32 (i32.load (i32.const 884)))
  (i32.store (i32.const 884) (i32.eq (local.get $classf) (i32.const 2)))
  (let $savehc i32 (i32.load (i32.const 372)))  ;; nested fn: its own hoist list
  (let $savehb i32 (i32.load (i32.const 376)))
