        (set! $sp (i32.add (local.get $sp) (i32.const 8)))
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 107))  ;; LOADACTION — push the yield*-step action (reg840: 0 yield / 1 done-continue / 2 gen-return)
      (then
        (i64.store (i32.add (local.get $stack) (local.get $sp)) (call $num (f64.convert_i32_s (i32.load (i32.const 840)))))
        (set! $sp (i32.add (local.get $sp) (i32.const 8)))
