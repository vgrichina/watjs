;; logical OR (||, kind 35): short-circuit via JMPT_PEEK (keep truthy operand)
(func $vm_c_or (param $code i32) (effects)
  (call $vm_c_and (local.get $code))
  (let $anyand i32 (i32.load (i32.const 944)))  ;; did any operand at this level use `&&`? (?? may not mix with && or ||)
  (let $patches i32 (call $heap_alloc (i32.const 256)))
  (let $np i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ne (call $tok_kind) (i32.const 35)))
    (call $next_token)
    (i32.store (i32.add (local.get $patches) (i32.mul (local.get $np) (i32.const 4))) (call $vm_emit_jump (local.get $code) (i32.const 28)))  ;; JMPT_PEEK
    (set! $np (i32.add (local.get $np) (i32.const 1)))
    (call $vm_emit_op (local.get $code) (i32.const 11))  ;; POP (discard falsy left)
    (i32.store (i32.const 956) (i32.const 0))
    (call $vm_c_and (local.get $code))
    (set! $anyand (i32.or (local.get $anyand) (i32.load (i32.const 944))))
    (br $l)))
  (let $i i32 (i32.const 0))
  (block $pe (loop $pl
    (br_if $pe (i32.ge_s (local.get $i) (local.get $np)))
    (call $vm_patch (local.get $code) (i32.load (i32.add (local.get $patches) (i32.mul (local.get $i) (i32.const 4)))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $pl)))
