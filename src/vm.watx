        (br $cml)))  ;; next class member
    (if (i32.eq (call $tok_kind) (i32.const 12)) (then (set! $isgen (i32.const 1)) (call $next_token)))  ;; `*` generator method
    (if (i32.eq (call $tok_kind) (i32.const 19))  ;; [computed](){} method  |  [computed] = field
      (then
        (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $protoT))  ;; LOADVAR proto
        (call $next_token) (call $vm_c_expr (local.get $code)) (call $next_token)  ;; '[' key ']' → [proto, key]
