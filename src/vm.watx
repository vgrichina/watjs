;; is `name` present in buf[0..n) (array of string pointers)?
(func $dup_has (param $buf i32) (param $n i32) (param $name i32) (result i32) (effects)
  (let $i i32 (i32.const 0))
  (block $b (loop $l
    (br_if $b (i32.ge_s (local.get $i) (local.get $n)))
    (if (call $str_eq (i32.load (i32.add (local.get $buf) (i32.mul (local.get $i) (i32.const 4)))) (local.get $name)) (then (return (i32.const 1))))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
  (i32.const 0))

;; Classify a lexical binding collision. Returns 0 = ok to add, 1 = SyntaxError, 2 = duplicate permitted
;; (skip re-add). A name colliding with a var name is always an error. A name colliding with an existing
;; lexical name is an error UNLESS (Annex B) the code is sloppy and BOTH the existing and the new binding
;; are plain FunctionDeclarations (isplain=1; generator/async/class/let/const are not plain).
(func $lex_collide (param $lexb i32) (param $ln i32) (param $lexk i32) (param $varb i32) (param $vn i32) (param $nm i32) (param $isplain i32) (result i32) (effects)
  (if (call $dup_has (local.get $varb) (local.get $vn) (local.get $nm)) (then (return (i32.const 1))))
  (let $i i32 (i32.const 0))
  (block $b (loop $l
    (br_if $b (i32.ge_s (local.get $i) (local.get $ln)))
    (if (call $str_eq (i32.load (i32.add (local.get $lexb) (i32.mul (local.get $i) (i32.const 4)))) (local.get $nm))
      (then
        (if (i32.load (i32.const 388)) (then (return (i32.const 1))))  ;; strict → any duplicate is an error
        (if (i32.eqz (local.get $isplain)) (then (return (i32.const 1))))
        (if (i32.eqz (i32.load (i32.add (local.get $lexk) (i32.mul (local.get $i) (i32.const 4))))) (then (return (i32.const 1))))  ;; existing not a plain function
        (return (i32.const 2))))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
  (i32.const 0))

;; Early Error: the LexicallyDeclaredNames of a switch CaseBlock must have no duplicates and must be
;; disjoint from its VarDeclaredNames (Annex B B.3.4 exempts sloppy plain-FunctionDeclaration duplicates).
;; Token pre-scan from the first clause (cursor just past '{') to the matching '}'; only CaseBlock-level
;; (relative brace-depth 0) statement-position declarations count. Cursor restored. First binding identifier
;; per declarator only (enough for the redeclaration tests); destructuring patterns are skipped.
;; $initstmt: 1 for a plain Block (statement position begins right after '{'), 0 for a switch CaseBlock
;; (the first StatementList begins after a `case E:` / `default:`).
(func $vm_switch_dup_check (param $initstmt i32) (effects)
  (let $save i32 (call $cursor_save))
  (let $lexb i32 (call $heap_alloc (i32.const 4096)))
  (let $lexk i32 (call $heap_alloc (i32.const 4096)))  ;; per-lexical-name kind: 1 = plain function
  (let $varb i32 (call $heap_alloc (i32.const 4096)))
  (let $ln i32 (i32.const 0))
  (let $vn i32 (i32.const 0))
  (let $depth i32 (i32.const 0))
  (let $stmt i32 (local.get $initstmt))
  (let $expc i32 (i32.const 0))
  (let $govern i32 (i32.const 0))  ;; a '(head)' whose governed sub-statement (NOT a direct list item) follows
  (block $done (loop $lp
    (let $k i32 (call $tok_kind))
    (br_if $done (i32.eqz (local.get $k)))
    (if (i32.and (i32.eq (local.get $k) (i32.const 18)) (i32.eqz (local.get $depth))) (then (br $done)))  ;; the CaseBlock's '}'
    (if (i32.or (i32.eq (local.get $k) (i32.const 15)) (i32.or (i32.eq (local.get $k) (i32.const 17)) (i32.eq (local.get $k) (i32.const 19))))
      (then (set! $depth (i32.add (local.get $depth) (i32.const 1))) (set! $stmt (i32.const 0)) (call $next_token) (br $lp)))
    (if (i32.or (i32.eq (local.get $k) (i32.const 16)) (i32.or (i32.eq (local.get $k) (i32.const 18)) (i32.eq (local.get $k) (i32.const 20))))
      (then (set! $depth (i32.sub (local.get $depth) (i32.const 1)))
        (if (i32.eqz (local.get $depth))
          (then (if (i32.and (i32.eq (local.get $k) (i32.const 16)) (local.get $govern))
                  (then (set! $govern (i32.const 0)) (set! $stmt (i32.const 0)))  ;; ')' of a control head → governed body is NOT a list item
                  (else (set! $stmt (i32.const 1))))))
        (call $next_token) (br $lp)))
    (if (i32.gt_s (local.get $depth) (i32.const 0)) (then (call $next_token) (br $lp)))
    (if (i32.eq (local.get $k) (i32.const 21)) (then (set! $stmt (i32.const 1)) (call $next_token) (br $lp)))  ;; ';'
    (if (i32.and (i32.eq (local.get $k) (i32.const 37)) (local.get $expc)) (then (set! $expc (i32.const 0)) (set! $stmt (i32.const 1)) (call $next_token) (br $lp)))  ;; case/default ':'
    (if (i32.eq (local.get $k) (i32.const 3))
      (then
        (if (i32.or (call $tok_is_kw (cstring "case")) (call $tok_is_kw (cstring "default")))
          (then (set! $expc (i32.const 1)) (set! $stmt (i32.const 0)) (call $next_token) (br $lp)))
        (if (local.get $stmt)
          (then
            ;; a control-flow statement governs a nested sub-statement whose declarations are NOT
            ;; CaseBlock-level. if/for/while/with/switch consume a '(head)' first (govern flag); else/do
            ;; govern the immediately-following statement.
            (if (i32.or (call $tok_is_kw (cstring "if")) (i32.or (call $tok_is_kw (cstring "for")) (i32.or (call $tok_is_kw (cstring "while")) (i32.or (call $tok_is_kw (cstring "with")) (call $tok_is_kw (cstring "switch"))))))
              (then (set! $govern (i32.const 1)) (set! $stmt (i32.const 0)) (call $next_token) (br $lp)))
            (if (i32.or (call $tok_is_kw (cstring "else")) (call $tok_is_kw (cstring "do")))
              (then (set! $stmt (i32.const 0)) (call $next_token) (br $lp)))
            ;; var NAME → VarDeclaredNames
            (if (call $tok_is_kw (cstring "var"))
              (then (call $next_token)
                (if (i32.eq (call $tok_kind) (i32.const 3))
                  (then (let $nm i32 (call $ident_name))
                    (if (call $dup_has (local.get $lexb) (local.get $ln) (local.get $nm)) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Identifier has already been declared")) (br $done)))
                    (if (i32.lt_s (local.get $vn) (i32.const 1024)) (then (i32.store (i32.add (local.get $varb) (i32.mul (local.get $vn) (i32.const 4))) (local.get $nm)) (set! $vn (i32.add (local.get $vn) (i32.const 1)))))))
                (set! $stmt (i32.const 0)) (br $lp)))
            ;; let/const/class NAME → lexical (kind 0, not a plain function)
            (if (i32.or (call $tok_is_kw (cstring "let")) (i32.or (call $tok_is_kw (cstring "const")) (call $tok_is_kw (cstring "class"))))
              (then (call $next_token)
                (if (i32.eq (call $tok_kind) (i32.const 3))
                  (then (let $nm i32 (call $ident_name))
                    (let $c i32 (call $lex_collide (local.get $lexb) (local.get $ln) (local.get $lexk) (local.get $varb) (local.get $vn) (local.get $nm) (i32.const 0)))
                    (if (i32.eq (local.get $c) (i32.const 1)) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Identifier has already been declared")) (br $done)))
                    (if (i32.and (i32.eqz (local.get $c)) (i32.lt_s (local.get $ln) (i32.const 1024))) (then (i32.store (i32.add (local.get $lexb) (i32.mul (local.get $ln) (i32.const 4))) (local.get $nm)) (i32.store (i32.add (local.get $lexk) (i32.mul (local.get $ln) (i32.const 4))) (i32.const 0)) (set! $ln (i32.add (local.get $ln) (i32.const 1)))))))
                (set! $stmt (i32.const 0)) (br $lp)))
            ;; using [await] NAME → lexical (a UsingDeclaration BoundName). Contextual: only a declaration
            ;; when a BindingIdentifier follows on the SAME line (else `using` is an IdentifierReference).
            (if (call $tok_is_kw (cstring "using"))
              (then (call $next_token)
                (if (call $tok_is_kw (cstring "await")) (then (call $next_token)))  ;; `await using` (skip the await keyword)
                (if (i32.and (i32.eqz (call $nl_before)) (i32.eq (call $tok_kind) (i32.const 3)))
                  (then (let $nm i32 (call $ident_name))
                    (let $c i32 (call $lex_collide (local.get $lexb) (local.get $ln) (local.get $lexk) (local.get $varb) (local.get $vn) (local.get $nm) (i32.const 0)))
                    (if (i32.eq (local.get $c) (i32.const 1)) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Identifier has already been declared")) (br $done)))
                    (if (i32.and (i32.eqz (local.get $c)) (i32.lt_s (local.get $ln) (i32.const 1024))) (then (i32.store (i32.add (local.get $lexb) (i32.mul (local.get $ln) (i32.const 4))) (local.get $nm)) (i32.store (i32.add (local.get $lexk) (i32.mul (local.get $ln) (i32.const 4))) (i32.const 0)) (set! $ln (i32.add (local.get $ln) (i32.const 1)))))))
                (set! $stmt (i32.const 0)) (br $lp)))
            ;; function [*] NAME → lexical (plain only if no '*'; a generator is kind 0)
            (if (call $tok_is_kw (cstring "function"))
              (then (call $next_token)
                (let $isgen i32 (i32.eq (call $tok_kind) (i32.const 12)))
                (if (local.get $isgen) (then (call $next_token)))
                (if (i32.eq (call $tok_kind) (i32.const 3))
                  (then (let $nm i32 (call $ident_name))
                    (let $c i32 (call $lex_collide (local.get $lexb) (local.get $ln) (local.get $lexk) (local.get $varb) (local.get $vn) (local.get $nm) (i32.eqz (local.get $isgen))))
                    (if (i32.eq (local.get $c) (i32.const 1)) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Identifier has already been declared")) (br $done)))
                    (if (i32.and (i32.eqz (local.get $c)) (i32.lt_s (local.get $ln) (i32.const 1024))) (then (i32.store (i32.add (local.get $lexb) (i32.mul (local.get $ln) (i32.const 4))) (local.get $nm)) (i32.store (i32.add (local.get $lexk) (i32.mul (local.get $ln) (i32.const 4))) (i32.eqz (local.get $isgen))) (set! $ln (i32.add (local.get $ln) (i32.const 1)))))))
                (set! $stmt (i32.const 0)) (br $lp)))
            ;; async function [*] NAME → lexical, always kind 0 (not a plain FunctionDeclaration)
            (if (call $tok_is_kw (cstring "async"))
              (then (call $next_token)
                (if (i32.and (i32.eq (call $tok_kind) (i32.const 3)) (call $tok_is_kw (cstring "function")))
                  (then (call $next_token)
                    (if (i32.eq (call $tok_kind) (i32.const 12)) (then (call $next_token)))
                    (if (i32.eq (call $tok_kind) (i32.const 3))
                      (then (let $nm i32 (call $ident_name))
                        (let $c i32 (call $lex_collide (local.get $lexb) (local.get $ln) (local.get $lexk) (local.get $varb) (local.get $vn) (local.get $nm) (i32.const 0)))
                        (if (i32.eq (local.get $c) (i32.const 1)) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Identifier has already been declared")) (br $done)))
                        (if (i32.and (i32.eqz (local.get $c)) (i32.lt_s (local.get $ln) (i32.const 1024))) (then (i32.store (i32.add (local.get $lexb) (i32.mul (local.get $ln) (i32.const 4))) (local.get $nm)) (i32.store (i32.add (local.get $lexk) (i32.mul (local.get $ln) (i32.const 4))) (i32.const 0)) (set! $ln (i32.add (local.get $ln) (i32.const 1)))))))))
                (set! $stmt (i32.const 0)) (br $lp)))))
        (set! $stmt (i32.const 0)) (call $next_token) (br $lp)))
    (set! $stmt (i32.const 0)) (call $next_token) (br $lp)))
  (call $cursor_restore (local.get $save))
  ;; a block/CaseBlock lexical name may ALSO not be a VarDeclaredName in a NESTED sub-block
  ;; (`{ let x; { var x; } }`) — the depth-0 scan above misses those. For each collected lexical name,
  ;; scan the whole block for a matching `var` (skipping nested function bodies). Cursor is at $save
  ;; (just inside the block's '{'), so var_name_in_block is called with noenter=1.
  (if (i32.eqz (call $err))
    (then
      (let $nvi i32 (i32.const 0))
      (block $nve (loop $nvl
        (br_if $nve (i32.ge_s (local.get $nvi) (local.get $ln)))
        (call $cursor_restore (local.get $save))
        (if (call $var_name_in_block (i32.load (i32.add (local.get $lexb) (i32.mul (local.get $nvi) (i32.const 4)))) (i32.const 1))
          (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Identifier has already been declared")) (call $cursor_restore (local.get $save)) (return)))
        (set! $nvi (i32.add (local.get $nvi) (i32.const 1))) (br $nvl)))
      (call $cursor_restore (local.get $save)))))

;; Early Error: the LexicallyDeclaredNames of a function body may not contain any parameter name
;; (`function f(a){ let a; }` is a SyntaxError; `var a` / `function a(){}` are var-scoped and may alias
;; a param, so they are NOT checked). Cursor at the body '{'; scan body-top-level (brace-depth 0,
;; statement-position, governed-statement-aware) let/const/class names vs the $params array. Restored.
;; First binding identifier per declarator only (destructuring patterns skipped, matching switch check).
;; General top-level lexical-dup + param collision check. $isprog: 1 = program/eval top level (cursor at
;; the first token, scan to EOF); 0 = function body (cursor at '{', scan to the matching '}'). Params are
;; seeded as var-scoped names, so a lexical (let/const/class) colliding a param errors while a `var`/inner
;; `function` may alias one. At this level `function`/`async function` are VAR-scoped (may redeclare each
;; other), so only lexical-vs-lexical and lexical-vs-var(incl function) collisions are errors.
(func $vm_param_body_check (param $params i32) (param $np i32) (effects) (call $vm_lex_dup_scan (local.get $params) (local.get $np) (i32.const 0)))
(func $vm_lex_dup_scan (param $params i32) (param $np i32) (param $isprog i32) (effects)
  (let $save i32 (call $cursor_save))
  (let $lexb i32 (call $heap_alloc (i32.const 4096)))  ;; lexical names (let/const/class)
  (let $varb i32 (call $heap_alloc (i32.const 4096)))  ;; var-scoped names (var + top-level function) + seeded params
  (let $ln i32 (i32.const 0))
  (let $vn i32 (i32.const 0))
  ;; seed params into varb (so a lexical colliding a param is caught; a var/function aliasing one is not)
  (block $se (loop $sl
    (br_if $se (i32.ge_s (local.get $vn) (local.get $np)))
    (i32.store (i32.add (local.get $varb) (i32.mul (local.get $vn) (i32.const 4))) (i32.load (i32.add (local.get $params) (i32.mul (local.get $vn) (i32.const 4)))))
    (set! $vn (i32.add (local.get $vn) (i32.const 1))) (br $sl)))
  (if (i32.eqz (local.get $isprog)) (then (call $next_token)))  ;; function body: past the '{'
  (let $depth i32 (i32.const 0))
  (let $stmt i32 (i32.const 1))
  (let $govern i32 (i32.const 0))
  (block $done (loop $lp
    (let $k i32 (call $tok_kind))
    (br_if $done (i32.eqz (local.get $k)))
    (if (i32.and (i32.eqz (local.get $isprog)) (i32.and (i32.eq (local.get $k) (i32.const 18)) (i32.eqz (local.get $depth)))) (then (br $done)))  ;; the body's '}'
    (if (i32.or (i32.eq (local.get $k) (i32.const 15)) (i32.or (i32.eq (local.get $k) (i32.const 17)) (i32.eq (local.get $k) (i32.const 19))))
      (then (set! $depth (i32.add (local.get $depth) (i32.const 1))) (set! $stmt (i32.const 0)) (call $next_token) (br $lp)))
    (if (i32.and (i32.or (i32.eq (local.get $k) (i32.const 16)) (i32.or (i32.eq (local.get $k) (i32.const 18)) (i32.eq (local.get $k) (i32.const 20)))) (i32.gt_s (local.get $depth) (i32.const 0)))
      (then (set! $depth (i32.sub (local.get $depth) (i32.const 1)))
        (if (i32.eqz (local.get $depth))
          (then (if (i32.and (i32.eq (local.get $k) (i32.const 16)) (local.get $govern))
                  (then (set! $govern (i32.const 0)) (set! $stmt (i32.const 0)))
                  (else (set! $stmt (i32.const 1))))))
        (call $next_token) (br $lp)))
    (if (i32.gt_s (local.get $depth) (i32.const 0)) (then (call $next_token) (br $lp)))
    (if (i32.eq (local.get $k) (i32.const 21)) (then (set! $stmt (i32.const 1)) (call $next_token) (br $lp)))  ;; ';'
    (if (i32.eq (local.get $k) (i32.const 3))
      (then
        (if (local.get $stmt)
          (then
            (if (i32.or (call $tok_is_kw (cstring "if")) (i32.or (call $tok_is_kw (cstring "for")) (i32.or (call $tok_is_kw (cstring "while")) (i32.or (call $tok_is_kw (cstring "with")) (call $tok_is_kw (cstring "switch"))))))
              (then (set! $govern (i32.const 1)) (set! $stmt (i32.const 0)) (call $next_token) (br $lp)))
            (if (i32.or (call $tok_is_kw (cstring "else")) (call $tok_is_kw (cstring "do")))
              (then (set! $stmt (i32.const 0)) (call $next_token) (br $lp)))
            ;; let/const/class NAME → lexical: collides with any prior lexical OR var(incl param) name
            (if (i32.or (call $tok_is_kw (cstring "let")) (i32.or (call $tok_is_kw (cstring "const")) (call $tok_is_kw (cstring "class"))))
              (then (call $next_token)
                (if (i32.eq (call $tok_kind) (i32.const 3))
                  (then (let $nm i32 (call $ident_name))
                    (if (i32.or (call $dup_has (local.get $lexb) (local.get $ln) (local.get $nm)) (call $dup_has (local.get $varb) (local.get $vn) (local.get $nm)))
                      (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Identifier has already been declared")) (br $done)))
                    (if (i32.lt_s (local.get $ln) (i32.const 1024)) (then (i32.store (i32.add (local.get $lexb) (i32.mul (local.get $ln) (i32.const 4))) (local.get $nm)) (set! $ln (i32.add (local.get $ln) (i32.const 1)))))))
                (set! $stmt (i32.const 0)) (br $lp)))
            ;; var NAME → var-scoped: errors only if it collides a prior LEXICAL name (var-var is fine)
            (if (call $tok_is_kw (cstring "var"))
              (then (call $next_token)
                (if (i32.eq (call $tok_kind) (i32.const 3))
                  (then (let $nm i32 (call $ident_name))
                    (if (call $dup_has (local.get $lexb) (local.get $ln) (local.get $nm))
                      (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Identifier has already been declared")) (br $done)))
                    (if (i32.lt_s (local.get $vn) (i32.const 1024)) (then (i32.store (i32.add (local.get $varb) (i32.mul (local.get $vn) (i32.const 4))) (local.get $nm)) (set! $vn (i32.add (local.get $vn) (i32.const 1)))))))
                (set! $stmt (i32.const 0)) (br $lp)))
            ;; function [*] NAME → var-scoped at this level: errors only vs a prior LEXICAL name
            (if (call $tok_is_kw (cstring "function"))
              (then (call $next_token)
                (if (i32.eq (call $tok_kind) (i32.const 12)) (then (call $next_token)))  ;; '*'
                (if (i32.eq (call $tok_kind) (i32.const 3))
                  (then (let $nm i32 (call $ident_name))
                    (if (call $dup_has (local.get $lexb) (local.get $ln) (local.get $nm))
                      (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Identifier has already been declared")) (br $done)))
                    (if (i32.lt_s (local.get $vn) (i32.const 1024)) (then (i32.store (i32.add (local.get $varb) (i32.mul (local.get $vn) (i32.const 4))) (local.get $nm)) (set! $vn (i32.add (local.get $vn) (i32.const 1)))))))
                (set! $stmt (i32.const 0)) (br $lp)))))
        (set! $stmt (i32.const 0)) (call $next_token) (br $lp)))
    (set! $stmt (i32.const 0)) (call $next_token) (br $lp)))
  (call $cursor_restore (local.get $save)))

;; Pre-declare the TOP-LEVEL (depth-0, statement-position) let/const/class bindings of the block/function
;; body at the current '{' as v_tdz, so a reference BEFORE the declaration is a TDZ ReferenceError (not
;; "undeclared" / a leaked global). Emits `PUSH v_tdz; LEXDEFINIT name` per identifier declarator; the real
;; declaration later flips v_tdz→value in place (scope_define updates). Does NOT descend into nested
;; blocks/functions/for-heads (those bind in their own scope). Cursor at '{'; restored. Mirrors the
;; governed-statement + depth scan of vm_lex_dup_scan.
(func $vm_hoist_lex (param $code i32) (effects)
  (let $save i32 (call $cursor_save))
  (call $next_token)  ;; past the '{'
  (let $depth i32 (i32.const 0))
  (let $stmt i32 (i32.const 1))
  (let $govern i32 (i32.const 0))
  (block $done (loop $lp
    (let $k i32 (call $tok_kind))
    (br_if $done (i32.eqz (local.get $k)))
    (if (i32.and (i32.eq (local.get $k) (i32.const 18)) (i32.eqz (local.get $depth))) (then (br $done)))  ;; the block's '}'
    (if (i32.or (i32.eq (local.get $k) (i32.const 15)) (i32.or (i32.eq (local.get $k) (i32.const 17)) (i32.eq (local.get $k) (i32.const 19))))
      (then (set! $depth (i32.add (local.get $depth) (i32.const 1))) (set! $stmt (i32.const 0)) (call $next_token) (br $lp)))  ;; ( [ {
    (if (i32.and (i32.or (i32.eq (local.get $k) (i32.const 16)) (i32.or (i32.eq (local.get $k) (i32.const 18)) (i32.eq (local.get $k) (i32.const 20)))) (i32.gt_s (local.get $depth) (i32.const 0)))
      (then (set! $depth (i32.sub (local.get $depth) (i32.const 1)))
        (if (i32.eqz (local.get $depth))
          (then (if (i32.and (i32.eq (local.get $k) (i32.const 16)) (local.get $govern))
                  (then (set! $govern (i32.const 0)) (set! $stmt (i32.const 0)))
                  (else (set! $stmt (i32.const 1))))))
        (call $next_token) (br $lp)))
    (if (i32.gt_s (local.get $depth) (i32.const 0)) (then (call $next_token) (br $lp)))
    (if (i32.eq (local.get $k) (i32.const 21)) (then (set! $stmt (i32.const 1)) (call $next_token) (br $lp)))  ;; ';'
    (if (i32.eq (local.get $k) (i32.const 3))
      (then
        (if (local.get $stmt)
          (then
            (if (i32.or (call $tok_is_kw (cstring "if")) (i32.or (call $tok_is_kw (cstring "for")) (i32.or (call $tok_is_kw (cstring "while")) (i32.or (call $tok_is_kw (cstring "with")) (call $tok_is_kw (cstring "switch"))))))
              (then (set! $govern (i32.const 1)) (set! $stmt (i32.const 0)) (call $next_token) (br $lp)))
            (if (i32.or (call $tok_is_kw (cstring "else")) (call $tok_is_kw (cstring "do")))
              (then (set! $stmt (i32.const 0)) (call $next_token) (br $lp)))
            (if (i32.or (call $tok_is_kw (cstring "let")) (i32.or (call $tok_is_kw (cstring "const")) (call $tok_is_kw (cstring "class"))))
              (then
                (let $iscls i32 (call $tok_is_kw (cstring "class")))
                (call $next_token)  ;; consume let/const/class
                (block $lhdone (loop $lhl
                  (br_if $lhdone (i32.ne (call $tok_kind) (i32.const 3)))  ;; declarator not an identifier (pattern/anon class) → stop
                  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_tdz))
                  (call $vm_emit_op (local.get $code) (i32.const 114)) (call $vm_emit_op (local.get $code) (call $ident_name))  ;; LEXDEFINIT NAME = v_tdz
                  (br_if $lhdone (local.get $iscls))  ;; a class declaration binds exactly one name
                  (call $next_token)  ;; consume NAME
                  (if (i32.eq (call $tok_kind) (i32.const 24))  ;; '=' initializer → skip to the next top-level ','
                    (then
                      (call $next_token)
                      (let $hd i32 (i32.const 0))
                      (let $fst i32 (i32.const 1))
                      (block $lsep (loop $lsl
                        (let $ik i32 (call $tok_kind))
                        (br_if $lhdone (i32.eqz (local.get $ik)))
                        (br_if $lhdone (i32.and (i32.eqz (local.get $fst)) (i32.and (i32.eqz (local.get $hd)) (i32.and (call $nl_before) (i32.ne (local.get $ik) (i32.const 22))))))  ;; ASI
                        (set! $fst (i32.const 0))
                        (if (i32.or (i32.eq (local.get $ik) (i32.const 15)) (i32.or (i32.eq (local.get $ik) (i32.const 19)) (i32.eq (local.get $ik) (i32.const 17))))
                          (then (set! $hd (i32.add (local.get $hd) (i32.const 1))) (call $next_token) (br $lsl)))
                        (if (i32.or (i32.eq (local.get $ik) (i32.const 16)) (i32.or (i32.eq (local.get $ik) (i32.const 20)) (i32.eq (local.get $ik) (i32.const 18))))
                          (then (br_if $lhdone (i32.eqz (local.get $hd))) (set! $hd (i32.sub (local.get $hd) (i32.const 1))) (call $next_token) (br $lsl)))
                        (br_if $lhdone (i32.and (i32.eqz (local.get $hd)) (i32.eq (local.get $ik) (i32.const 21))))  ;; ';'
                        (if (i32.and (i32.eqz (local.get $hd)) (i32.eq (local.get $ik) (i32.const 22))) (then (call $next_token) (br $lsep)))  ;; top-level ','
                        (call $next_token) (br $lsl)))
                      (br $lhl))
                    (else  ;; no initializer: ',' → next declarator; else the list ends
                      (br_if $lhdone (i32.ne (call $tok_kind) (i32.const 22)))
                      (call $next_token) (br $lhl)))))
                (set! $stmt (i32.const 0)) (br $lp)))))
        (set! $stmt (i32.const 0)) (call $next_token) (br $lp)))
    (set! $stmt (i32.const 0)) (call $next_token) (br $lp)))
  (call $cursor_restore (local.get $save)))

;; Early Error (parse phase): `delete` applied to a MemberExpression.PrivateName /
;; CallExpression.PrivateName — including the case where the operand is wholly wrapped
;; in cover-parens ("delete ((this.#x))"). Token pre-scan from the current cursor:
;; skip N leading '(' , walk one member/call chain tracking whether its LAST access is a
;; '.#private', then require exactly N trailing ')' and no continuation (a following
;; '.'/'['/'('/'`' means the private access wasn't the outermost op → legal). Returns 1
;; iff the operand is such a private-final reference. Cursor is fully restored.
(func $vm_delete_priv_check (result i32) (effects)
  (let $save i32 (call $cursor_save))
  (let $nlp i32 (i32.const 0))
  (block $pd (loop $pl
    (br_if $pd (i32.ne (call $tok_kind) (i32.const 15)))  ;; '('
    (set! $nlp (i32.add (local.get $nlp) (i32.const 1))) (call $next_token) (br $pl)))
  (let $ok i32 (i32.const 0))
  (let $lastpriv i32 (i32.const 0))
  (if (i32.eq (call $tok_kind) (i32.const 3))  ;; a primary reference must begin with an identifier / this
    (then
      (call $next_token)
      (block $ce (loop $cl
        (let $k i32 (call $tok_kind))
        (if (i32.eq (local.get $k) (i32.const 23))  ;; '.'
          (then
            (call $next_token)
            (if (i32.eq (call $tok_kind) (i32.const 3))
              (then
                (set! $lastpriv (i32.and (i32.ge_s (call $str_len (call $ident_name)) (i32.const 1))
                                         (i32.eq (call $str_byte (call $ident_name) (i32.const 0)) (i32.const 35))))
                (call $next_token) (br $cl))
              (else (br $ce)))))  ;; '.' not followed by an identifier → bail out of the chain
        (if (i32.or (i32.eq (local.get $k) (i32.const 19)) (i32.eq (local.get $k) (i32.const 15)))  ;; '[' index or '(' call
          (then
            (set! $lastpriv (i32.const 0))
            (let $depth i32 (i32.const 0))
            (block $sb (loop $sl
              (let $t i32 (call $tok_kind))
              (br_if $sb (i32.eqz (local.get $t)))  ;; EOF
              (if (i32.or (i32.eq (local.get $t) (i32.const 15)) (i32.or (i32.eq (local.get $t) (i32.const 19)) (i32.eq (local.get $t) (i32.const 17))))
                (then (set! $depth (i32.add (local.get $depth) (i32.const 1)))))
              (if (i32.or (i32.eq (local.get $t) (i32.const 16)) (i32.or (i32.eq (local.get $t) (i32.const 20)) (i32.eq (local.get $t) (i32.const 18))))
                (then (set! $depth (i32.sub (local.get $depth) (i32.const 1)))
                      (if (i32.eqz (local.get $depth)) (then (call $next_token) (br $sb)))))
              (call $next_token) (br $sl)))
            (br $cl)))
        (br $ce)))  ;; anything else ends the chain
      ;; consume the N trailing cover-parens
