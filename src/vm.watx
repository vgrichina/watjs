              (let $ofpend i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))  ;; JMPF → end (pops)
              ;; x = r.value  (read OUTSIDE the handler: a throwing value-getter is NOT an IteratorClose trigger)
              (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $rn))  ;; LOADVAR r
              (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (cstring "value"))  ;; GETPROP value → [val]
              (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (cstring "@@ofval"))  ;; STOREVAR @@ofval
              ;; handler around binding+body: on abrupt completion, IteratorClose then re-throw
              (call $vm_emit_op (local.get $code) (i32.const 48))  ;; PUSHHANDLER
              (let $ofhloc i32 (call $vm_emit_cursor)) (call $vm_emit_op (local.get $code) (i32.const 0))  ;; catchIp placeholder
              (call $vm_emit_op (local.get $code) (cstring "@@ofexc"))  ;; catch var
              (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (cstring "@@ofval"))  ;; LOADVAR @@ofval → [val]
              (if (local.get $ofpatcur)
                (then  ;; destructuring pattern: bind via vm_c_destructure_param
                  (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (cstring "@@ofdt"))  ;; STOREVAR temp
                  (let $ofbody i32 (call $cursor_save))
                  (call $cursor_restore (local.get $ofpatcur))
                  (call $vm_c_destructure_param (local.get $code) (cstring "@@ofdt"))
                  (call $cursor_restore (local.get $ofbody)))
                (else (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $ofvar))))  ;; STOREVAR x
              (call $vm_c_stmt (local.get $code))  ;; body
              ;; normal + continue converge here: POPHANDLER then loop
              (call $vm_patch_conts (local.get $code) (call $vm_emit_cursor))  ;; continue → POPHANDLER point
              (call $vm_emit_op (local.get $code) (i32.const 49))  ;; POPHANDLER
              (call $vm_emit_op (local.get $code) (i32.const 12)) (call $vm_emit_op (local.get $code) (local.get $oftop))  ;; JMP top
              ;; throw handler: exc bound to @@ofexc → IteratorClose, re-throw
              (i32.store (i32.add (local.get $code) (local.get $ofhloc)) (call $vm_emit_cursor))  ;; catchIp = here
              (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $itn))  ;; LOADVAR it
              (call $vm_emit_op (local.get $code) (i32.const 75))  ;; CLOSEITER-suppress (throw-completion: original exception wins)
              (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (cstring "@@ofexc"))  ;; LOADVAR @@ofexc
              (call $vm_emit_op (local.get $code) (i32.const 47))  ;; THROW (re-raise original)
              (call $vm_patch (local.get $code) (local.get $ofpend))  ;; done (normal exhaustion) → here (no IteratorClose)
              (let $ofskip i32 (call $vm_emit_jump (local.get $code) (i32.const 12)))  ;; JMP → endAll (skip break-close)
              (call $vm_patch_breaks (local.get $code) (call $vm_emit_cursor))  ;; break → here: POPHANDLER + close
              (call $vm_emit_op (local.get $code) (i32.const 49))  ;; POPHANDLER (remove for-of handler)
              (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $itn))  ;; LOADVAR it
              (call $vm_emit_op (local.get $code) (i32.const 74))  ;; CLOSEITER (it.return() on break)
              (call $vm_patch (local.get $code) (local.get $ofskip))  ;; endAll
              (if (local.get $isof) (then (call $vm_finally_pop)))  ;; remove the iterator-close finally entry
              (call $vm_loop_exit (local.get $ofls))
              (return)))
          (call $cursor_restore (local.get $ofdetect))  ;; not for-of → regular for
          (let $flsave i32 (call $vm_loop_enter))
          (call $vm_emit_op (local.get $code) (i32.const 90))  ;; RESETCOMPLETION: loop completion starts undefined
          ;; init (consumes up to ';')
          (if (i32.ne (call $tok_kind) (i32.const 21))
            (then
              (if (i32.or (call $tok_is_kw (cstring "var")) (i32.or (call $tok_is_kw (cstring "let")) (call $tok_is_kw (cstring "const"))))
                (then
                  (call $next_token)  ;; consume var/let/const
                  (if (i32.or (i32.eq (call $tok_kind) (i32.const 19)) (i32.eq (call $tok_kind) (i32.const 17)))  ;; [..]/{..} destructuring pattern
                    (then
                      (let $fpatcur i32 (call $cursor_save))
                      (let $fpsd i32 (i32.const 0))
                      (block $fpske (loop $fpskl
                        (let $fpk i32 (call $tok_kind))
                        (br_if $fpske (i32.eq (local.get $fpk) (i32.const 0)))
                        (if (i32.or (i32.eq (local.get $fpk) (i32.const 19)) (i32.or (i32.eq (local.get $fpk) (i32.const 17)) (i32.eq (local.get $fpk) (i32.const 15)))) (then (set! $fpsd (i32.add (local.get $fpsd) (i32.const 1)))))
                        (if (i32.or (i32.eq (local.get $fpk) (i32.const 20)) (i32.or (i32.eq (local.get $fpk) (i32.const 18)) (i32.eq (local.get $fpk) (i32.const 16))))
                          (then (set! $fpsd (i32.sub (local.get $fpsd) (i32.const 1))) (if (i32.eqz (local.get $fpsd)) (then (call $next_token) (br $fpske)))))
                        (call $next_token) (br $fpskl)))
                      (call $next_token)  ;; consume '='
                      (call $vm_c_expr (local.get $code))
                      (let $fvtmp i32 (call $vm_tmpname))
                      (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $fvtmp))
                      (let $fvpost i32 (call $cursor_save))
                      (call $cursor_restore (local.get $fpatcur))
                      (call $vm_c_destructure_param (local.get $code) (local.get $fvtmp))
                      (call $cursor_restore (local.get $fvpost)))
                    (else
                      (let $fin i32 (call $ident_name)) (call $next_token) (call $next_token)  ;; NAME =
                      (call $vm_c_expr (local.get $code))
                      (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $fin)))))
                (else
                  (call $look_save)
                  (let $fin2 i32 (call $ident_name)) (call $next_token)
                  (if (i32.eq (call $tok_kind) (i32.const 24))
                    (then (call $next_token) (call $vm_c_expr (local.get $code))
                          (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $fin2)))
                    (else (call $look_restore) (call $vm_c_commaexpr (local.get $code)) (call $vm_emit_op (local.get $code) (i32.const 11))))))))
          (call $expect (i32.const 21) (cstring "expected ;"))
          (let $ftop i32 (call $vm_emit_cursor))
          (if (i32.ne (call $tok_kind) (i32.const 21))
            (then (call $vm_c_expr (local.get $code)))
            (else (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_bool (i32.const 1)))))
          (call $expect (i32.const 21) (cstring "expected ;"))
          (let $fpend i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))  ;; JMPF → end
          ;; save update-clause cursor, skip its tokens to the ')'
          (let $fupd i32 (call $cursor_save))
          (let $fdepth i32 (i32.const 0))
          (block $fse (loop $fsl
            (br_if $fse (i32.eq (call $tok_kind) (i32.const 0)))
            (if (i32.eq (call $tok_kind) (i32.const 15)) (then (set! $fdepth (i32.add (local.get $fdepth) (i32.const 1)))))
            (if (i32.eq (call $tok_kind) (i32.const 16))
              (then (br_if $fse (i32.eqz (local.get $fdepth))) (set! $fdepth (i32.sub (local.get $fdepth) (i32.const 1)))))
            (call $next_token)
            (br $fsl)))
          (call $next_token)  ;; ')'
          (call $vm_c_stmt (local.get $code))  ;; body
          (let $fpost i32 (call $cursor_save))
          ;; continue → the update clause (compiled next)
          (call $vm_patch_conts (local.get $code) (call $vm_emit_cursor))
          ;; re-scan + compile the update, then loop
          (call $cursor_restore (local.get $fupd))
          (if (i32.ne (call $tok_kind) (i32.const 16))
            (then (call $vm_c_commaexpr (local.get $code)) (call $vm_emit_op (local.get $code) (i32.const 11))))  ;; update; POP
          (call $vm_emit_op (local.get $code) (i32.const 12)) (call $vm_emit_op (local.get $code) (local.get $ftop))  ;; JMP top
          (call $vm_patch (local.get $code) (local.get $fpend))
          (call $vm_patch_breaks (local.get $code) (call $vm_emit_cursor))  ;; break → end
          (call $cursor_restore (local.get $fpost))  ;; lexer resumes after the body
          (call $vm_loop_exit (local.get $flsave))
          (return)))
      ;; assignment:  NAME = expr ;   |  NAME op= expr ;
      (call $look_save)
      (let $an i32 (call $ident_name)) (call $next_token)
      (if (i32.or (i32.eq (call $tok_kind) (i32.const 24)) (i32.or (i32.and (i32.ge_s (call $tok_kind) (i32.const 40)) (i32.le_s (call $tok_kind) (i32.const 43))) (i32.or (i32.and (i32.ge_s (call $tok_kind) (i32.const 59)) (i32.le_s (call $tok_kind) (i32.const 61))) (i32.or (i32.eq (call $tok_kind) (i32.const 38)) (i32.eq (call $tok_kind) (i32.const 39))))))  ;; = / op= / ||= / ++ / --
        (then (if (call $vm_strict_lhs_check (local.get $an)) (then (return)))))  ;; strict: eval/arguments target → SyntaxError
      (if (i32.eq (call $tok_kind) (i32.const 24))  ;; '='
        (then
          (call $next_token)
          (call $vm_c_expr (local.get $code))
          (if (i32.or (i32.eq (i32.load (i32.add (local.get $code) (i32.sub (call $vm_emit_cursor) (i32.const 8)))) (i32.const 61)) (i32.eq (i32.load (i32.add (local.get $code) (i32.sub (call $vm_emit_cursor) (i32.const 4)))) (i32.const 51)))  ;; `x = <anon fn>` → x.name = "x"
            (then (call $vm_emit_op (local.get $code) (i32.const 72)) (call $vm_emit_op (local.get $code) (local.get $an))))
          (call $vm_emit_op (local.get $code) (if i32 (i32.load (i32.const 388)) (then (i32.const 80)) (else (i32.const 85)))) (call $vm_emit_op (local.get $code) (local.get $an))  ;; plain assign: strict→80 (ReferenceError if undeclared) / sloppy→85 (implicit global)
          (drop (call $eat (i32.const 21)))
          (return)))
      ;; logical assignment a ||= b (59) / a &&= b (60) / a ??= b (61): short-circuit
      (if (i32.and (i32.ge_s (call $tok_kind) (i32.const 59)) (i32.le_s (call $tok_kind) (i32.const 61)))
        (then
          (let $jop i32 (if i32 (i32.eq (call $tok_kind) (i32.const 59)) (then (i32.const 28))   ;; ||= → JMPT_PEEK
                          (else (if i32 (i32.eq (call $tok_kind) (i32.const 60)) (then (i32.const 27)) (else (i32.const 68))))))  ;; &&=→JMPF_PEEK, ??=→JMP_NN
          (call $next_token)
          (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $an))  ;; LOADVAR a → [a]
          (let $p1 i32 (call $vm_emit_jump (local.get $code) (local.get $jop)))  ;; short-circuit → keep a
          (call $vm_emit_op (local.get $code) (i32.const 11))  ;; POP a
          (call $vm_c_expr (local.get $code))                  ;; eval RHS → [b]
          (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $an))  ;; STOREVAR a (pops)
          (let $p2 i32 (call $vm_emit_jump (local.get $code) (i32.const 12)))  ;; JMP → end
          (call $vm_patch (local.get $code) (local.get $p1))   ;; keep-branch: [a]
          (call $vm_emit_op (local.get $code) (i32.const 11))  ;; POP a (statement discards)
          (call $vm_patch (local.get $code) (local.get $p2))
          (drop (call $eat (i32.const 21)))
          (return)))
      (if (i32.or (i32.and (i32.ge_s (call $tok_kind) (i32.const 40)) (i32.le_s (call $tok_kind) (i32.const 43))) (i32.eq (call $tok_kind) (i32.const 58)))  ;; += -= *= /= **=
        (then
          (let $cop i32 (if i32 (i32.eq (call $tok_kind) (i32.const 40)) (then (i32.const 2))   ;; ADD
                          (else (if i32 (i32.eq (call $tok_kind) (i32.const 41)) (then (i32.const 3))   ;; SUB
                          (else (if i32 (i32.eq (call $tok_kind) (i32.const 42)) (then (i32.const 4))
                          (else (if i32 (i32.eq (call $tok_kind) (i32.const 58)) (then (i32.const 43)) (else (i32.const 5))))))))))  ;; MUL/POW/DIV
          (call $next_token)
          (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $an))  ;; LOADVAR
          (call $vm_c_expr (local.get $code))                                                                       ;; RHS
          (call $vm_emit_op (local.get $code) (local.get $cop))
          (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $an))  ;; STOREVAR
          (drop (call $eat (i32.const 21)))
          (return)))
      (call $look_restore)))
  ;; array destructuring assignment statement:  [a, b, ...r] = expr
  (if (i32.eq (call $tok_kind) (i32.const 19))  ;; '['
    (then
      (call $look_save)
      (call $next_token)  ;; consume '['
      (let $dadepth i32 (i32.const 1))
      (block $dase (loop $dasl
        (let $dak i32 (call $tok_kind))
        (br_if $dase (i32.eq (local.get $dak) (i32.const 0)))
        (if (i32.or (i32.eq (local.get $dak) (i32.const 19)) (i32.or (i32.eq (local.get $dak) (i32.const 17)) (i32.eq (local.get $dak) (i32.const 15)))) (then (set! $dadepth (i32.add (local.get $dadepth) (i32.const 1)))))
        (if (i32.or (i32.eq (local.get $dak) (i32.const 20)) (i32.or (i32.eq (local.get $dak) (i32.const 18)) (i32.eq (local.get $dak) (i32.const 16))))
          (then (set! $dadepth (i32.sub (local.get $dadepth) (i32.const 1))) (br_if $dase (i32.eqz (local.get $dadepth)))))
        (call $next_token) (br $dasl)))
      (call $next_token)  ;; consume matching ']'
      (let $daisda i32 (i32.eq (call $tok_kind) (i32.const 24)))  ;; '=' follows → destructuring assignment
      (call $look_restore)
      (if (local.get $daisda)
        (then
          ;; route through vm_c_destructure_param (handles nested/default/rest/holes
          ;; for identifier targets). Parse RHS first (it follows the pattern), stash
          ;; it in a temp, then rewind and destructure the pattern out of the temp.
          (let $ps i32 (call $cursor_save))     ;; at '['
          (call $vm_skip_balanced)              ;; past matching ']'
          (call $next_token)                    ;; consume '='
          (call $vm_c_expr (local.get $code))   ;; RHS → [val]
          (let $datmp i32 (call $vm_tmpname))
          (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $datmp))  ;; STOREVAR tmp
          (let $rs i32 (call $cursor_save))     ;; after the RHS
          (call $cursor_restore (local.get $ps))  ;; back to '['
          (let $damode i32 (i32.load (i32.const 676)))
          (i32.store (i32.const 676) (i32.const 1))  ;; assignment-destructuring: leaf targets assign, not bind
          (call $vm_c_destructure_param (local.get $code) (local.get $datmp))
          (i32.store (i32.const 676) (local.get $damode))
          (call $cursor_restore (local.get $rs))  ;; skip past the RHS we pre-parsed
          (drop (call $eat (i32.const 21)))
          (return)))))
  ;; object destructuring assignment statement:  ({a, b: c} = expr)
  (if (i32.eq (call $tok_kind) (i32.const 15))  ;; '('
    (then
      (call $look_save)
      (call $next_token)  ;; '('
      (if (i32.eq (call $tok_kind) (i32.const 17))  ;; '{'
        (then
          (call $next_token)  ;; '{'
          (let $oddepth i32 (i32.const 1))
          (block $odse (loop $odsl
            (let $odk i32 (call $tok_kind))
            (br_if $odse (i32.eq (local.get $odk) (i32.const 0)))
            (if (i32.or (i32.eq (local.get $odk) (i32.const 17)) (i32.or (i32.eq (local.get $odk) (i32.const 19)) (i32.eq (local.get $odk) (i32.const 15)))) (then (set! $oddepth (i32.add (local.get $oddepth) (i32.const 1)))))
            (if (i32.or (i32.eq (local.get $odk) (i32.const 18)) (i32.or (i32.eq (local.get $odk) (i32.const 20)) (i32.eq (local.get $odk) (i32.const 16))))
              (then (set! $oddepth (i32.sub (local.get $oddepth) (i32.const 1))) (br_if $odse (i32.eqz (local.get $oddepth)))))
            (call $next_token) (br $odsl)))
          (call $next_token)  ;; '}'
          (let $odisda i32 (i32.eq (call $tok_kind) (i32.const 24)))  ;; '=' → destructuring assignment
          (call $look_restore)
          (if (local.get $odisda)
            (then
              (call $next_token)  ;; consume '(' → cursor at '{'
              (let $ps i32 (call $cursor_save))     ;; at '{'
              (call $vm_skip_balanced)              ;; past matching '}'
              (call $next_token)                    ;; consume '='
              (call $vm_c_expr (local.get $code))   ;; RHS → [val] (stops at ')')
              (let $odtmp i32 (call $vm_tmpname))
              (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $odtmp))  ;; STOREVAR tmp
              (let $rs i32 (call $cursor_save))     ;; at ')'
              (call $cursor_restore (local.get $ps))  ;; back to '{'
              (let $odmode i32 (i32.load (i32.const 676)))
              (i32.store (i32.const 676) (i32.const 1))  ;; assignment-destructuring mode
              (call $vm_c_destructure_param (local.get $code) (local.get $odtmp))
              (i32.store (i32.const 676) (local.get $odmode))
              (call $cursor_restore (local.get $rs))  ;; back to ')'
              (call $next_token)  ;; consume ')'
              (drop (call $eat (i32.const 21)))
              (return))))
        (else (call $look_restore)))))
  ;; expression statement → store value to the completion register (op 71), so
  ;; eval()/JSON.parse can read the last expression value. Same stack effect as POP.
  (call $vm_c_commaexpr (local.get $code))
  (call $vm_emit_op (local.get $code) (i32.const 71))  ;; SETCOMPLETION (pops TOS → mem 288)
  (drop (call $eat (i32.const 21))))

;; compile a whole program (statement list) → HALT-terminated bytecode
;; Hoist `var` declarations: emit `PUSH undefined; STOREVAR name` for each var in
;; the current source (lexer just lex_init'd, no token read yet), so the binding
;; exists before its declaration line — `x; var x = 1;` sees undefined, not a
;; ReferenceError. Nested function bodies are skipped (their vars hoist to them).
;; Single-declarator form, mirroring the re-scan engine's hoist_vars.
;; A statement-position `function name(){}` (paren-depth 0, after start/;/{/})
;; is a DECLARATION → hoist it. Anything else (e.g. `while(function f(){})`,
;; `x = function g(){}`) is a function EXPRESSION → its name must NOT leak, so
;; just skip its body. $pd = paren/bracket depth, $prevk = previous token kind.
(func $vm_hoist (param $code i32) (effects)
  (let $pd i32 (i32.const 0))
  (let $prevk i32 (i32.const 0))
  (call $next_token)
  (block $done (loop $scan
    (let $k i32 (call $tok_kind))
    (br_if $done (i32.eq (local.get $k) (i32.const 0)))
    (if (i32.or (i32.eq (local.get $k) (i32.const 15)) (i32.eq (local.get $k) (i32.const 19)))
      (then (set! $pd (i32.add (local.get $pd) (i32.const 1)))))
    (if (i32.and (i32.or (i32.eq (local.get $k) (i32.const 16)) (i32.eq (local.get $k) (i32.const 20))) (i32.gt_s (local.get $pd) (i32.const 0)))
      (then (set! $pd (i32.sub (local.get $pd) (i32.const 1)))))
    (if (i32.eq (local.get $k) (i32.const 3))
      (then
        (if (call $tok_is_kw (cstring "function"))
          (then
            (if (i32.and (i32.eqz (local.get $pd))
                  (i32.or (i32.eqz (local.get $prevk)) (i32.or (i32.eq (local.get $prevk) (i32.const 21)) (i32.or (i32.eq (local.get $prevk) (i32.const 17)) (i32.eq (local.get $prevk) (i32.const 18))))))
              (then  ;; declaration → compile + bind here (cursor ends at next statement)
                (let $hfnm i32 (call $vm_c_function (local.get $code)))
                (if (local.get $hfnm)
                  (then (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $hfnm)))
                  (else (call $vm_emit_op (local.get $code) (i32.const 11))))
                (set! $prevk (i32.const 18)))
              (else (call $hoist_skip_fn)))  ;; expression → skip body (cursor at '}')
            (br $scan)))
        (if (call $tok_is_kw (cstring "var"))
          (then
            (call $next_token)
            (if (i32.eq (call $tok_kind) (i32.const 3))
              (then
                (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef))
                (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (call $ident_name))))))))
    (set! $prevk (local.get $k))
    (call $next_token)
    (br $scan))))

(func $vm_compile_prog (param $ptr i32) (param $len i32) (result i32) (effects)
  (i32.store (i32.const 208) (i32.const 0)) (i32.store (i32.const 216) (i32.const 0))  ;; no enclosing loop
  (i32.store (i32.const 224) (i32.const 0)) (i32.store (i32.const 232) (i32.const 0))  ;; temp counter, async flag
  (i32.store (i32.const 240) (i32.const 0))  ;; typeof-operand depth
  (i32.store (i32.const 244) (i32.const 0)) (i32.store (i32.const 248) (i32.const 0)) (i32.store (i32.const 228) (i32.const 0))  ;; labels: pending, current, depth
  (i32.store (i32.const 252) (call $heap_alloc (i32.const 2048)))  ;; label-entry stack
  (i32.store (i32.const 320) (i32.const 0)) (i32.store (i32.const 340) (call $heap_alloc (i32.const 512)))  ;; finally stack (8-byte entries: kind+data)
  (i32.store (i32.const 360) (i32.const 0))  ;; innermost loop's finally-base
  (i32.store (i32.const 372) (i32.const 0)) (i32.store (i32.const 376) (call $heap_alloc (i32.const 1024)))  ;; fn-hoist position list
  (i32.store (i32.const 388) (i32.const 0))  ;; compile-time strict-mode flag (lexically inherited)
  ;; Size the code buffer to the source: bytecode is bounded by a small multiple
  ;; of source length (densest real case ~5 bytes/char; 16 is a safe ceiling),
  ;; plus a fixed 128 KB base that covers the always-compiled Error prelude. A
  ;; flat 4 MB buffer used to LEAK 4 MB per (nested/repeated) eval — the bump
  ;; allocator ran dry after ~5 evals (memory access out of bounds).
  (let $code i32 (call $heap_alloc (i32.add (i32.mul (local.get $len) (i32.const 16)) (i32.const 131072))))
  (call $vm_set_emit_cursor (i32.const 0))
  ;; the Error-hierarchy prelude is compiled into the same buffer first, so its
  ;; constructors exist (as VM functions) before user code runs (new ReferenceError, etc.)
  (let $pre i32 (call $prelude_src))
  (call $set_src (i32.add (local.get $pre) (i32.const 4)) (call $str_len (local.get $pre)))
  (call $lex_init)
  (call $next_token)
  (block $pe (loop $pl
    (br_if $pe (i32.eq (call $tok_kind) (i32.const 0)))
    (br_if $pe (call $err))
    (call $vm_c_stmt (local.get $code))
    (br $pl)))
  ;; program-level "use strict" directive → the whole program (and its functions,
  ;; incl. hoisted ones) is strict. Detect BEFORE vm_hoist so hoisted fns inherit it.
  (call $set_src (local.get $ptr) (local.get $len))
  (call $lex_init)
  (call $next_token)
  (if (i32.eq (call $tok_kind) (i32.const 2))
    (then (if (call $str_eq (call $decode_str (i32.add (call $src) (call $tok_start)) (call $tok_len)) (cstring "use strict"))
      (then (i32.store (i32.const 388) (i32.const 1))))))
  ;; hoist the user program's var declarations (define as undefined up front)
  (call $set_src (local.get $ptr) (local.get $len))
  (call $lex_init)
  (call $vm_hoist (local.get $code))
  ;; reset the completion register at runtime AFTER the prelude (whose trailing
  ;; expression statements leave a value in mem 288) and BEFORE user code, so a
  ;; user program with no expression statement (e.g. `var x`, ``) completes to undefined.
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef))
  (call $vm_emit_op (local.get $code) (i32.const 71))  ;; SETCOMPLETION undefined
  ;; now compile the user program
  (call $set_src (local.get $ptr) (local.get $len))
  (call $lex_init)
  (call $next_token)
  (block $e (loop $l
    (br_if $e (i32.eq (call $tok_kind) (i32.const 0)))
    (br_if $e (call $err))
    ;; top-level `function name(){}` was already compiled+bound by vm_hoist — skip it
    (if (i32.and (i32.eq (call $tok_kind) (i32.const 3)) (call $tok_is_kw (cstring "function")))
      (then (call $hoist_skip_fn) (call $next_token))
      (else (call $vm_c_stmt (local.get $code))))
    (br $l)))
  (call $vm_emit_op (local.get $code) (i32.const 0))  ;; HALT
  (local.get $code))

;; compile a single arithmetic expression, HALT-terminated
(func $vm_compile (param $ptr i32) (param $len i32) (result i32) (effects)
  (call $set_src (local.get $ptr) (local.get $len))
  (call $lex_init)
  (call $next_token)
  (let $code i32 (call $heap_alloc (i32.const 8192)))
  (call $vm_set_emit_cursor (i32.const 0))
  (call $vm_c_add (local.get $code))
  (call $vm_emit_op (local.get $code) (i32.const 0))  ;; HALT
  (local.get $code))

;; compile a ';'-separated list of expressions, YIELDing each — a stand-in for a
;; generator body, to exercise suspend/resume. Layout: [expr YIELD]* HALT
(func $vm_compile_gen (param $ptr i32) (param $len i32) (result i32) (effects)
  (call $set_src (local.get $ptr) (local.get $len))
  (call $lex_init)
  (call $next_token)
  (let $code i32 (call $heap_alloc (i32.const 8192)))
  (call $vm_set_emit_cursor (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.eq (call $tok_kind) (i32.const 0)))  ;; EOF
    (call $vm_c_add (local.get $code))
    (call $vm_emit_op (local.get $code) (i32.const 7))  ;; YIELD
    (br_if $e (i32.ne (call $tok_kind) (i32.const 21)))  ;; ';'
    (call $next_token)
    (br $l)))
  (call $vm_emit_op (local.get $code) (i32.const 0))  ;; HALT
  (local.get $code))

;; ── resumable VM context — execution state reified in memory ──
;; layout: @0 code, @4 ip, @8 stack, @12 sp, @16 done, @20 scope (current),
;;         @24 curframe (in-memory call-frame chain), @28 gscope (globals)
(func $vm_new (param $code i32) (result i32) (effects)
  (let $ctx i32 (call $heap_alloc (i32.const 40)))
  (let $gs i32 (call $scope_new (i32.const 0) (i32.const 256)))
  (call $setup_globals (local.get $gs))  ;; builtins, prototypes, Math, etc.
  (call $scope_define (local.get $gs) (cstring "this") (call $mk_obj (local.get $gs)))  ;; global `this` = the global object
  (i32.store (local.get $ctx) (local.get $code))
  (i32.store (i32.add (local.get $ctx) (i32.const 4)) (i32.const 0))           ;; ip
  (i32.store (i32.add (local.get $ctx) (i32.const 8)) (call $heap_alloc (i32.const 1048576)))  ;; operand stack (1 MB; heap grows on demand)
  (i32.store (i32.add (local.get $ctx) (i32.const 12)) (i32.const 0))          ;; sp
  (i32.store (i32.add (local.get $ctx) (i32.const 16)) (i32.const 0))          ;; done
  (i32.store (i32.add (local.get $ctx) (i32.const 20)) (local.get $gs))        ;; current scope = globals
  (i32.store (i32.add (local.get $ctx) (i32.const 24)) (i32.const 0))          ;; no active frame
  (i32.store (i32.add (local.get $ctx) (i32.const 28)) (local.get $gs))        ;; global scope (closure parent)
  (i32.store (i32.add (local.get $ctx) (i32.const 32)) (i32.const 0))          ;; exception handler chain
  (i32.store (i32.add (local.get $ctx) (i32.const 36)) (i32.const 0))  ;; await resume flag
  (local.get $ctx))

(func $vm_done (param $ctx i32) (result i32) (effects) (i32.load (i32.add (local.get $ctx) (i32.const 16))))

;; A called function's enclosing scope is its captured closureScope (@24), or
;; the provided fallback (global scope) for statically-built fns (class methods,
;; empty constructors) that never ran a CLOSURE op.
(func $vm_fn_parent (param $fn i32) (param $fallback i32) (result i32) (effects)
  (let $cs i32 (i32.load (i32.add (local.get $fn) (i32.const 24))))
  (if i32 (local.get $cs) (then (local.get $cs)) (else (local.get $fallback))))

;; x instanceof F for VM functions: the prototype object is at fn@16, and an
;; instance's scope-parent chain links to it (see the NEW opcode). Native fns
;; (Map/Set/…) fall back to the production js_instanceof.
;; OrdinaryHasInstance(C=f, O=x) — the @@hasInstance-free proto-chain check. Used by
;; the instanceof operator's default path AND by Function.prototype[Symbol.hasInstance]
;; (native 451), so it must NOT consult @@hasInstance (that would recurse).
(func $ordinary_has_instance (param $x i64) (param $f i64) (result i64) (effects)
  ;; the RHS must be callable; a non-callable RHS is a TypeError
  (if (i32.eqz (call $is_function (local.get $f)))
    (then (call $throw_type (cstring "TypeError") (cstring "Right-hand side of 'instanceof' is not callable")) (return (call $v_false))))
  ;; bound function: instanceof follows [[BoundTargetFunction]] → x instanceof target
  (if (i32.eq (i32.load (call $val_payload (local.get $f))) (i32.const 1448232540))
    (then (return (call $vm_instanceof (local.get $x) (i64.load (i32.add (call $val_payload (local.get $f)) (i32.const 24)))))))
  (if (i32.or (call $is_array (local.get $x)) (call $is_function (local.get $x))) (then (return (call $js_instanceof (local.get $x) (local.get $f)))))  ;; arrays/functions → general path
  (if (i32.eqz (call $is_object (local.get $x))) (then (return (call $v_false))))
  (let $fp i32 (call $val_payload (local.get $f)))
  (if (i32.ne (i32.load (local.get $fp)) (i32.const 1448232526))
    (then (return (call $js_instanceof (local.get $x) (local.get $f)))))  ;; native ctor
  (let $proto i64 (i64.load (i32.add (local.get $fp) (i32.const 16))))
  (if (i32.eqz (call $is_object (local.get $proto))) (then (return (call $v_false))))
  (let $protoScope i32 (call $val_payload (local.get $proto)))
  (let $p i32 (call $scope_parent (call $val_payload (local.get $x))))
  (block $brk (loop $cont
    (br_if $brk (i32.eqz (local.get $p)))
    (if (i32.eq (local.get $p) (local.get $protoScope)) (then (return (call $v_true))))
    (set! $p (call $scope_parent (local.get $p)))
    (br $cont)))
  (call $v_false))

(func $vm_instanceof (param $x i64) (param $f i64) (result i64) (effects)
  ;; a custom [Symbol.hasInstance] method on the RHS takes precedence (works even
  ;; when the RHS isn't itself callable)
  (if (i32.or (call $is_object (local.get $f)) (i32.or (call $is_function (local.get $f)) (call $is_array (local.get $f))))
    (then
      (let $hinst i64 (call $get_prop (local.get $f) (call $make_symbol (cstring "@@hasInstance") (cstring "Symbol.hasInstance"))))
      (if (call $is_function (local.get $hinst))
        (then
          (let $hiav i32 (call $heap_alloc (i32.const 8)))
          (i64.store (local.get $hiav) (local.get $x))
          (return (call $mk_bool (call $truthy (call $call_val (local.get $hinst) (i32.const 1) (local.get $hiav) (local.get $f)))))))))
  (call $ordinary_has_instance (local.get $x) (local.get $f)))

;; infer .name for an anonymous VM-fn value from a property key (string/number →
;; ToString; symbol → "[desc]" or "" if no description), optional prefix ("get "/
;; "set "/0). No-ops on named fns, non-VM fns, and non-functions.
(func $vm_infer_name (param $fnval i64) (param $keyval i64) (param $prefix i32) (effects)
  (if (i32.eqz (call $is_function (local.get $fnval))) (then (return)))
  (let $fp i32 (call $val_payload (local.get $fnval)))
  (if (i32.eqz (i32.and (i32.ge_s (i32.load (local.get $fp)) (i32.const 1448232526)) (i32.le_s (i32.load (local.get $fp)) (i32.const 1448232528)))) (then (return)))
  (let $noff i32 (i32.add (i32.add (local.get $fp) (i32.const 28)) (i32.mul (i32.load (i32.add (local.get $fp) (i32.const 8))) (i32.const 4))))
  (if (i32.load (local.get $noff)) (then (return)))  ;; already named
  (let $kn i32 (if i32 (call $is_symbol (local.get $keyval))
    (then (if i32 (i32.eqz (call $str_len (call $sym_desc_str (local.get $keyval))))
      (then (cstring ""))
      (else (call $str_concat (cstring "[") (call $str_concat (call $sym_desc_str (local.get $keyval)) (cstring "]"))))))
    (else (call $to_str (local.get $keyval)))))
  (i32.store (local.get $noff) (if i32 (local.get $prefix) (then (call $str_concat (local.get $prefix) (local.get $kn))) (else (local.get $kn)))))

;; apply a flat field-inits array [name, thunk-or-undefined, ...] to a target object:
;; for each, the value is thunk.call(target) (or the undefined sentinel) → own prop.
;; Used for per-instance fields (target=instance) and static fields (target=constructor).
(func $vm_apply_fields (param $thisobj i64) (param $fiv i64) (effects)
  (if (i32.eqz (call $is_array (local.get $fiv))) (then (return)))
  (let $fa i32 (call $val_payload (local.get $fiv)))
  (let $fln i32 (call $arr_len (local.get $fa)))
  (let $fi i32 (i32.const 0))
  (block $fe (loop $fl
    (br_if $fe (i32.ge_s (i32.add (local.get $fi) (i32.const 1)) (local.get $fln)))
    (let $fname i64 (call $arr_get (local.get $fa) (local.get $fi)))
    (let $fthunk i64 (call $arr_get (local.get $fa) (i32.add (local.get $fi) (i32.const 1))))
    ;; a static initialization block (sentinel name) just RUNS for side effects (this=ctor),
    ;; no property assignment. (NEST the guard: i32.and evaluates both, and val_payload on a
    ;; non-string fname — e.g. a computed numeric key — would deref garbage.)
    (let $fisblock i32 (i32.const 0))
    (if (call $is_string (local.get $fname))
      (then (if (call $str_eq (call $val_payload (local.get $fname)) (cstring "@@staticblock")) (then (set! $fisblock (i32.const 1))))))
    (if (local.get $fisblock)
      (then (drop (call $call_val (local.get $fthunk) (i32.const 0) (call $heap_alloc (i32.const 8)) (local.get $thisobj))))
      (else
        (call $set_prop (local.get $thisobj) (local.get $fname)
          (if i64 (call $is_function (local.get $fthunk))
            (then (call $call_val (local.get $fthunk) (i32.const 0) (call $heap_alloc (i32.const 8)) (local.get $thisobj)))
            (else (local.get $fthunk))))))  ;; undefined sentinel → undefined
    (if (call $err) (then (return)))
    (set! $fi (i32.add (local.get $fi) (i32.const 2)))
    (br $fl)))
  )
;; per-instance fields: read the prototype's @@fieldinits and apply to the instance.
(func $vm_run_field_inits (param $thisobj i64) (param $protoval i64) (effects)
  (if (i32.eqz (call $is_object (local.get $protoval))) (then (return)))
  (let $fislot i32 (call $scope_find_local (call $val_payload (local.get $protoval)) (cstring "@@fieldinits")))
  (if (local.get $fislot) (then (call $vm_apply_fields (local.get $thisobj) (i64.load (local.get $fislot))))))

;; run from the context's saved (ip, sp) until the next YIELD or HALT.
;; YIELD → returns the yielded value, state saved for the next call (done=0).
;; HALT  → sets done=1, returns the final top-of-stack value (or undefined).
;; This is the mechanism the re-scan evaluator structurally cannot provide.
(func $vm_step (param $ctx i32) (param $resumeval i64) (result i64) (effects)
  (let $code i32 (i32.load (local.get $ctx)))
  (let $stack i32 (i32.load (i32.add (local.get $ctx) (i32.const 8))))
  (let $ip i32 (i32.load (i32.add (local.get $ctx) (i32.const 4))))
  (let $sp i32 (i32.load (i32.add (local.get $ctx) (i32.const 12))))
  (let $scope i32 (i32.load (i32.add (local.get $ctx) (i32.const 20))))
  (let $frame i32 (i32.load (i32.add (local.get $ctx) (i32.const 24))))
  (let $gscope i32 (i32.load (i32.add (local.get $ctx) (i32.const 28))))
  (let $handler i32 (i32.load (i32.add (local.get $ctx) (i32.const 32))))  ;; try/catch handler chain
  (i32.store (i32.const 204) (local.get $gscope))  ;; active VM globals, for the native->VM callback bridge
  ;; resuming after AWAIT: push the resolved value so the await-expression yields it
  (if (i32.load (i32.add (local.get $ctx) (i32.const 36)))
    (then
      (i32.store (i32.add (local.get $ctx) (i32.const 36)) (i32.const 0))
      (i64.store (i32.add (local.get $stack) (local.get $sp)) (local.get $resumeval))
      (set! $sp (i32.add (local.get $sp) (i32.const 8)))))
  (loop $disp
    ;; a native (assert, get_prop on null, throw_type, …) raised an error via the
    ;; engine err flag — convert it into a VM exception (unwind to handler / halt)
    (if (call $err)
      (then
        (let $exc i64 (call $err_val))
        (call $set_err (i32.const 0))
        (if (i32.eqz (local.get $handler))  ;; uncaught → re-raise to the host and halt
          (then (call $set_err (i32.const 1)) (call $set_err_val (local.get $exc))
                (i32.store (i32.add (local.get $ctx) (i32.const 16)) (i32.const 1)) (return (local.get $exc))))
        (set! $frame (i32.load (i32.add (local.get $handler) (i32.const 8))))
        (set! $sp (i32.load (i32.add (local.get $handler) (i32.const 12))))
        (set! $scope (i32.load (i32.add (local.get $handler) (i32.const 16))))
        (set! $ip (i32.load (local.get $handler)))
        (call $scope_define (local.get $scope) (i32.load (i32.add (local.get $handler) (i32.const 4))) (local.get $exc))
        (set! $handler (i32.load (i32.add (local.get $handler) (i32.const 20))))
        (br $disp)))
    (let $op i32 (i32.load (i32.add (local.get $code) (local.get $ip))))
    (set! $ip (i32.add (local.get $ip) (i32.const 4)))
    (if (i32.eq (local.get $op) (i32.const 0))  ;; HALT
      (then
        (i32.store (i32.add (local.get $ctx) (i32.const 16)) (i32.const 1))
        (i32.store (i32.add (local.get $ctx) (i32.const 4)) (local.get $ip))
        (i32.store (i32.add (local.get $ctx) (i32.const 12)) (local.get $sp))
        (i32.store (i32.add (local.get $ctx) (i32.const 20)) (local.get $scope))
        (i32.store (i32.add (local.get $ctx) (i32.const 24)) (local.get $frame))
        (i32.store (i32.add (local.get $ctx) (i32.const 32)) (local.get $handler))
        (return (if i64 (i32.gt_s (local.get $sp) (i32.const 0))
                  (then (i64.load (i32.add (local.get $stack) (i32.sub (local.get $sp) (i32.const 8)))))
                  (else (call $v_undef))))))
    (if (i32.eq (local.get $op) (i32.const 77))  ;; GENPRO_SUSPEND — suspend after eager param prologue; resume pushes nothing
      (then
        (i32.store (i32.add (local.get $ctx) (i32.const 4)) (local.get $ip))
        (i32.store (i32.add (local.get $ctx) (i32.const 12)) (local.get $sp))
        (i32.store (i32.add (local.get $ctx) (i32.const 20)) (local.get $scope))
        (i32.store (i32.add (local.get $ctx) (i32.const 24)) (local.get $frame))
        (i32.store (i32.add (local.get $ctx) (i32.const 32)) (local.get $handler))
        (i32.store (i32.add (local.get $ctx) (i32.const 36)) (i32.const 0))  ;; resume pushes nothing
        (return (call $v_undef))))
    (if (i32.eq (local.get $op) (i32.const 7))  ;; YIELD — suspend; resume pushes the .next(v) argument
      (then
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
        (i32.store (i32.add (local.get $ctx) (i32.const 4)) (local.get $ip))
        (i32.store (i32.add (local.get $ctx) (i32.const 12)) (local.get $sp))
        (i32.store (i32.add (local.get $ctx) (i32.const 20)) (local.get $scope))
        (i32.store (i32.add (local.get $ctx) (i32.const 24)) (local.get $frame))
        (i32.store (i32.add (local.get $ctx) (i32.const 32)) (local.get $handler))
        (i32.store (i32.add (local.get $ctx) (i32.const 36)) (i32.const 1))  ;; resume pushes the value (yield expression result)
        (return (i64.load (i32.add (local.get $stack) (local.get $sp))))))
    (if (i32.eq (local.get $op) (i32.const 50))  ;; AWAIT — suspend, resume pushes the resolved value
      (then
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
        (i32.store (i32.add (local.get $ctx) (i32.const 4)) (local.get $ip))
        (i32.store (i32.add (local.get $ctx) (i32.const 12)) (local.get $sp))
        (i32.store (i32.add (local.get $ctx) (i32.const 20)) (local.get $scope))
        (i32.store (i32.add (local.get $ctx) (i32.const 24)) (local.get $frame))
        (i32.store (i32.add (local.get $ctx) (i32.const 32)) (local.get $handler))
        (i32.store (i32.add (local.get $ctx) (i32.const 36)) (i32.const 1))  ;; next resume pushes the value
        (return (i64.load (i32.add (local.get $stack) (local.get $sp))))))
    (if (i32.eq (local.get $op) (i32.const 48))  ;; PUSHHANDLER catchIp, varname
      (then
        (let $h i32 (call $heap_alloc (i32.const 24)))
        (i32.store (local.get $h) (i32.load (i32.add (local.get $code) (local.get $ip))))                       ;; catch ip
        (i32.store (i32.add (local.get $h) (i32.const 4)) (i32.load (i32.add (local.get $code) (i32.add (local.get $ip) (i32.const 4)))))  ;; catch var name
        (i32.store (i32.add (local.get $h) (i32.const 8)) (local.get $frame))
        (i32.store (i32.add (local.get $h) (i32.const 12)) (local.get $sp))
        (i32.store (i32.add (local.get $h) (i32.const 16)) (local.get $scope))
        (i32.store (i32.add (local.get $h) (i32.const 20)) (local.get $handler))  ;; previous handler
        (set! $handler (local.get $h))
        (set! $ip (i32.add (local.get $ip) (i32.const 8)))
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 49))  ;; POPHANDLER (try body completed normally)
      (then (set! $handler (i32.load (i32.add (local.get $handler) (i32.const 20)))) (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 47))  ;; THROW
      (then
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
