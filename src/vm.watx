      (i32.store (i32.const 240) (i32.add (i32.load (i32.const 240)) (i32.const 1)))
      (i32.store (i32.const 940) (i32.const 1))
      (i32.store (i32.const 956) (i32.const 0))
      (call $vm_c_unary (local.get $code))
      (i32.store (i32.const 240) (i32.sub (i32.load (i32.const 240)) (i32.const 1)))
      (call $vm_emit_op (local.get $code) (i32.const 58)) (return)))  ;; TYPEOF
  (if (i32.and (i32.eq (local.get $k) (i32.const 3)) (call $tok_is_kw (cstring "void")))  ;; void expr → undefined
    (then (call $next_token) (i32.store (i32.const 940) (i32.const 1)) (i32.store (i32.const 956) (i32.const 0)) (call $vm_c_unary (local.get $code))
          (call $vm_emit_op (local.get $code) (i32.const 11))  ;; POP operand
          (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef)) (return)))
  (if (i32.and (i32.eq (local.get $k) (i32.const 3)) (call $tok_is_kw (cstring "delete")))  ;; delete obj.prop / obj[k]
    (then (call $next_token) (call $vm_c_delete_operand (local.get $code)) (i32.store (i32.const 956) (i32.const 0)) (return)))  ;; a delete UnaryExpression is not an assignment target
