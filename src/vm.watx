;; ** exponentiation (right-assoc, binds tighter than unary; left is postfix)
(func $vm_c_pow (param $code i32) (effects)
  (call $vm_c_postfix (local.get $code))
  (if (i32.eq (call $tok_kind) (i32.const 51))  ;; **
    (then
      (call $next_token)
      (call $vm_c_unary (local.get $code))  ;; right operand may have a unary prefix; right-assoc via unary→pow
      (call $vm_emit_op (local.get $code) (i32.const 43)))))  ;; POW

;; unary prefix:  - + ! ~   (binds looser than member/call/**, tighter than * /)
(func $vm_c_unary (param $code i32) (effects)
