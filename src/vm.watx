      (block $tb (loop $tl
        (br_if $tb (i32.ge_s (local.get $i) (local.get $nlp)))
        (br_if $tb (i32.ne (call $tok_kind) (i32.const 16)))
        (call $next_token) (set! $i (i32.add (local.get $i) (i32.const 1))) (br $tl)))
      ;; all cover-parens matched, the private access is the outermost op, and nothing continues it
      (if (i32.and (i32.eq (local.get $i) (local.get $nlp)) (local.get $lastpriv))
        (then
          (let $nx i32 (call $tok_kind))
          (if (i32.eqz (i32.or (i32.eq (local.get $nx) (i32.const 23)) (i32.or (i32.eq (local.get $nx) (i32.const 19))
                (i32.or (i32.eq (local.get $nx) (i32.const 15)) (i32.eq (local.get $nx) (i32.const 53))))))
            (then (set! $ok (i32.const 1))))))))
  (call $cursor_restore (local.get $save))
  (local.get $ok))

;; compile a `delete` operand: evaluate the base, and turn the FINAL member
;; access into a DELETE (op 70). Non-final accesses compile as normal GETs.
(func $vm_c_delete_operand (param $code i32) (effects)
  ;; `delete <PrivateName-final reference>` (possibly cover-parenthesised) is a SyntaxError.
  (if (call $vm_delete_priv_check)
    (then (i32.store (i32.const 400) (i32.const 1))
          (call $throw_type (cstring "SyntaxError") (cstring "private member cannot be deleted")) (return)))
  ;; delete of a non-reference unary expression (void/typeof/delete/!/~/+/-/++/--) →
  ;; evaluate, discard the value, and return true (it is not a Reference).
  (if (i32.or (i32.and (i32.eq (call $tok_kind) (i32.const 3)) (i32.or (call $tok_is_kw (cstring "void")) (i32.or (call $tok_is_kw (cstring "typeof")) (call $tok_is_kw (cstring "delete")))))
        (i32.or (i32.eq (call $tok_kind) (i32.const 33)) (i32.or (i32.eq (call $tok_kind) (i32.const 47))   ;; ! ~
          (i32.or (i32.eq (call $tok_kind) (i32.const 10)) (i32.or (i32.eq (call $tok_kind) (i32.const 11))  ;; + -
            (i32.or (i32.eq (call $tok_kind) (i32.const 38)) (i32.eq (call $tok_kind) (i32.const 39))))))))  ;; ++ --
    (then
      (call $vm_c_unary (local.get $code))
      (call $vm_emit_op (local.get $code) (i32.const 11))  ;; POP value
      (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_bool (i32.const 1)))  ;; non-reference → true
      (return)))
  ;; bare identifier (a plain non-keyword identifier, no member access) → DELETEVAR
  (if (i32.and (i32.eq (call $tok_kind) (i32.const 3))
        (i32.eqz (i32.or (call $tok_is_kw (cstring "new")) (i32.or (call $tok_is_kw (cstring "function")) (i32.or (call $tok_is_kw (cstring "class"))
          (i32.or (call $tok_is_kw (cstring "this")) (i32.or (call $tok_is_kw (cstring "super")) (i32.or (call $tok_is_kw (cstring "true")) (i32.or (call $tok_is_kw (cstring "false")) (call $tok_is_kw (cstring "null")))))))))))
    (then
      (call $look_save)
      (let $din i32 (call $ident_name)) (call $next_token)
      ;; not '.'/'['/'('/tagged-template → a bare identifier reference → DELETEVAR. A following
      ;; '(' (call) or '`' (tagged template) means it's NOT a plain reference (`delete foo()` must
      ;; call foo and yield true) → fall through to the postfix path below.
      (if (i32.eqz (i32.or (i32.eq (call $tok_kind) (i32.const 23)) (i32.or (i32.eq (call $tok_kind) (i32.const 19))
            (i32.or (i32.eq (call $tok_kind) (i32.const 15)) (i32.eq (call $tok_kind) (i32.const 53))))))
        (then
          ;; strict mode: `delete <bare identifier>` (deleting an unqualified variable reference) is a SyntaxError.
          (if (i32.load (i32.const 388)) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Delete of an unqualified identifier in strict mode")) (return)))
          (call $vm_emit_op (local.get $code) (i32.const 95)) (call $vm_emit_op (local.get $code) (local.get $din)) (return)))
      (call $look_restore)))  ;; member access / call follows → fall through to the reference path
  ;; `delete super.name` / `delete super[expr]` — deleting a SuperReference is a runtime ReferenceError
  ;; (spec 13.5.1.2 step 5.a). The expr IS evaluated (GetValue) but NOT ToPropertyKey'd, so a throwing
  ;; toString on the key does NOT run. super property is lexically gated by reg 868 (SyntaxError else).
  (if (i32.and (i32.eq (call $tok_kind) (i32.const 3)) (call $tok_is_kw (cstring "super")))
    (then
      (if (i32.eqz (i32.load (i32.const 868)))
        (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "'super' keyword unexpected here")) (return)))
      (call $next_token)  ;; consume 'super'
      ;; GetThisBinding first (spec MakeSuperPropertyReference step 2) — reading `this` throws a
      ;; ReferenceError when it is still uninitialized (derived ctor before super()), BEFORE the key expr.
      (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (cstring "this")) (call $vm_emit_op (local.get $code) (i32.const 11))  ;; LOADVAR this; POP
      (if (i32.eq (call $tok_kind) (i32.const 23))  ;; .name
        (then (call $next_token) (drop (call $ident_name)) (call $next_token))
        (else (if (i32.eq (call $tok_kind) (i32.const 19))  ;; [expr] — evaluate the key for its side effects, then discard
          (then (call $next_token) (call $vm_c_expr (local.get $code)) (call $vm_emit_op (local.get $code) (i32.const 11)) (call $next_token))
          (else (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "'super' keyword unexpected here")) (return)))))
      (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (cstring "ReferenceError"))
      (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_str (cstring "Cannot delete a super property")))
      (call $vm_emit_op (local.get $code) (i32.const 46)) (call $vm_emit_op (local.get $code) (i32.const 1))  ;; NEW ReferenceError(msg)
      (call $vm_emit_op (local.get $code) (i32.const 47))  ;; THROW
      (return)))
  (call $vm_c_primary (local.get $code))
  (block $e (loop $l
    (let $k i32 (call $tok_kind))
    (if (i32.eq (local.get $k) (i32.const 23))  ;; '.' member
      (then
        (call $next_token)
        (let $key i32 (call $ident_name)) (call $next_token)
        (let $nk i32 (call $tok_kind))
        (if (i32.or (i32.eq (local.get $nk) (i32.const 23)) (i32.or (i32.eq (local.get $nk) (i32.const 19)) (i32.eq (local.get $nk) (i32.const 15))))
          (then (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (local.get $key)) (br $l))  ;; GETPROP (member/call follows)
          (else
            (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_str (local.get $key)))
            (call $vm_emit_op (local.get $code) (i32.const 70))  ;; DELETE
            (if (i32.load (i32.const 388)) (then (call $vm_emit_op (local.get $code) (i32.const 84))))  ;; strict: non-config delete → TypeError
            (br $e)))))
    (if (i32.eq (local.get $k) (i32.const 19))  ;; '[' index
      (then
        (call $next_token)
        (call $vm_c_expr (local.get $code))
        (call $next_token)  ;; ']'
        (let $nk2 i32 (call $tok_kind))
        (if (i32.or (i32.eq (local.get $nk2) (i32.const 23)) (i32.or (i32.eq (local.get $nk2) (i32.const 19)) (i32.eq (local.get $nk2) (i32.const 15))))
          (then (call $vm_emit_op (local.get $code) (i32.const 31)) (br $l))  ;; GETIDX (member/call follows)
          (else (call $vm_emit_op (local.get $code) (i32.const 70))
                (if (i32.load (i32.const 388)) (then (call $vm_emit_op (local.get $code) (i32.const 84))))  ;; strict: non-config delete → TypeError
                (br $e)))))  ;; DELETE
    (if (i32.eq (local.get $k) (i32.const 15))  ;; '(' call → evaluate the call; its result is a value, not a reference
      (then (call $vm_c_call_tail (local.get $code)) (br $l)))
    ;; not a member access → bare delete: discard value, result is true
    (call $vm_emit_op (local.get $code) (i32.const 11))  ;; POP
    (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_bool (i32.const 1)))
    (br $e))))

(func $vm_c_mul (param $code i32) (effects)
  (call $vm_c_unary (local.get $code))
  (block $e (loop $l
    (let $k i32 (call $tok_kind))
    (br_if $e (i32.eqz (i32.or (i32.eq (local.get $k) (i32.const 12)) (i32.or (i32.eq (local.get $k) (i32.const 13)) (i32.eq (local.get $k) (i32.const 14))))))
    (call $next_token) (i32.store (i32.const 956) (i32.const 0))
    (call $vm_c_unary (local.get $code))
    (call $vm_emit_op (local.get $code)
      (if i32 (i32.eq (local.get $k) (i32.const 12)) (then (i32.const 4))
      (else (if i32 (i32.eq (local.get $k) (i32.const 13)) (then (i32.const 5)) (else (i32.const 22))))))  ;; * / %
    (br $l))))

(func $vm_c_add (param $code i32) (effects)
  (call $vm_c_mul (local.get $code))
  (block $e (loop $l
    (let $k i32 (call $tok_kind))
    (br_if $e (i32.eqz (i32.or (i32.eq (local.get $k) (i32.const 10)) (i32.eq (local.get $k) (i32.const 11)))))
    (call $next_token) (i32.store (i32.const 956) (i32.const 0))
    (call $vm_c_mul (local.get $code))
    (call $vm_emit_op (local.get $code) (if i32 (i32.eq (local.get $k) (i32.const 10)) (then (i32.const 2)) (else (i32.const 3))))
    (br $l))))

;; bit shifts:  << 48  >> 49  >>> 50  → opcodes 40..42 (between additive and relational)
(func $vm_c_shift (param $code i32) (effects)
  (call $vm_c_add (local.get $code))
  (block $e (loop $l
    (let $k i32 (call $tok_kind))
    (br_if $e (i32.eqz (i32.or (i32.eq (local.get $k) (i32.const 48)) (i32.or (i32.eq (local.get $k) (i32.const 49)) (i32.eq (local.get $k) (i32.const 50))))))
    (call $next_token) (i32.store (i32.const 956) (i32.const 0))
    (call $vm_c_add (local.get $code))
    (call $vm_emit_op (local.get $code)
      (if i32 (i32.eq (local.get $k) (i32.const 48)) (then (i32.const 40))
      (else (if i32 (i32.eq (local.get $k) (i32.const 49)) (then (i32.const 41)) (else (i32.const 42))))))
    (br $l))))

;; relational:  < 29  > 30  <= 31  >= 32  instanceof  in  → opcodes 14..17/59/60
;; (RelationalExpression binds TIGHTER than EqualityExpression: `a in b !== c` is
;; `(a in b) !== c`, not `((a in b) !== c) …`).
(func $vm_c_rel (param $code i32) (effects)
  (call $vm_c_shift (local.get $code))
  (block $e (loop $l
    (let $k i32 (call $tok_kind))
    ;; keyword operators:  x instanceof C   |   k in obj   (relational precedence)
    (if (i32.eq (local.get $k) (i32.const 3))
      (then
        (if (call $tok_is_kw (cstring "instanceof"))
          (then (call $next_token) (i32.store (i32.const 956) (i32.const 0)) (call $vm_c_shift (local.get $code)) (call $vm_emit_op (local.get $code) (i32.const 59)) (br $l)))
        (if (call $tok_is_kw (cstring "in"))
          (then (call $next_token) (i32.store (i32.const 956) (i32.const 0)) (call $vm_c_shift (local.get $code)) (call $vm_emit_op (local.get $code) (i32.const 60)) (br $l)))))
    ;; < 29 > 30 <= 31 >= 32
    (br_if $e (i32.eqz (i32.or (i32.eq (local.get $k) (i32.const 29)) (i32.or (i32.eq (local.get $k) (i32.const 30))
      (i32.or (i32.eq (local.get $k) (i32.const 31)) (i32.eq (local.get $k) (i32.const 32)))))))
    (call $next_token) (i32.store (i32.const 956) (i32.const 0))
    (call $vm_c_shift (local.get $code))
    (call $vm_emit_op (local.get $code)
      (if i32 (i32.eq (local.get $k) (i32.const 29)) (then (i32.const 14))
      (else (if i32 (i32.eq (local.get $k) (i32.const 30)) (then (i32.const 15))
      (else (if i32 (i32.eq (local.get $k) (i32.const 31)) (then (i32.const 16)) (else (i32.const 17))))))))
    (br $l))))

;; equality:  === 26  !== 28  == 25  != 27  → opcodes 18/24/25/26 (looser than relational)
(func $vm_c_cmp (param $code i32) (effects)
  (call $vm_c_rel (local.get $code))
  (block $e (loop $l
    (let $k i32 (call $tok_kind))
    (br_if $e (i32.eqz (i32.or (i32.eq (local.get $k) (i32.const 26)) (i32.or (i32.eq (local.get $k) (i32.const 28))
      (i32.or (i32.eq (local.get $k) (i32.const 25)) (i32.eq (local.get $k) (i32.const 27)))))))
    (call $next_token) (i32.store (i32.const 956) (i32.const 0))
    (call $vm_c_rel (local.get $code))
    (call $vm_emit_op (local.get $code)
      (if i32 (i32.eq (local.get $k) (i32.const 26)) (then (i32.const 18))
      (else (if i32 (i32.eq (local.get $k) (i32.const 28)) (then (i32.const 24))
      (else (if i32 (i32.eq (local.get $k) (i32.const 25)) (then (i32.const 25)) (else (i32.const 26))))))))
    (br $l))))

;; bitwise &  ^  |  (between equality and logical-and; & tightest, | loosest)
(func $vm_c_bitand (param $code i32) (effects)
  (call $vm_c_cmp (local.get $code))
  (block $e (loop $l
    (br_if $e (i32.ne (call $tok_kind) (i32.const 44)))  ;; &
    (call $next_token) (i32.store (i32.const 956) (i32.const 0)) (call $vm_c_cmp (local.get $code))
    (call $vm_emit_op (local.get $code) (i32.const 37))  ;; BAND
    (br $l))))
(func $vm_c_bitxor (param $code i32) (effects)
  (call $vm_c_bitand (local.get $code))
  (block $e (loop $l
    (br_if $e (i32.ne (call $tok_kind) (i32.const 46)))  ;; ^
    (call $next_token) (i32.store (i32.const 956) (i32.const 0)) (call $vm_c_bitand (local.get $code))
    (call $vm_emit_op (local.get $code) (i32.const 39))  ;; BXOR
    (br $l))))
(func $vm_c_bitor (param $code i32) (effects)
  (call $vm_c_bitxor (local.get $code))
  (block $e (loop $l
    (br_if $e (i32.ne (call $tok_kind) (i32.const 45)))  ;; |
    (call $next_token) (i32.store (i32.const 956) (i32.const 0)) (call $vm_c_bitxor (local.get $code))
    (call $vm_emit_op (local.get $code) (i32.const 38))  ;; BOR
    (br $l))))

;; logical AND (&&, kind 34): short-circuit via JMPF_PEEK (keep falsy operand)
(func $vm_c_and (param $code i32) (effects)
  (call $vm_c_bitor (local.get $code))
  (let $patches i32 (call $heap_alloc (i32.const 256)))
  (let $np i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ne (call $tok_kind) (i32.const 34)))
    (call $next_token)
    (i32.store (i32.add (local.get $patches) (i32.mul (local.get $np) (i32.const 4))) (call $vm_emit_jump (local.get $code) (i32.const 27)))  ;; JMPF_PEEK
    (set! $np (i32.add (local.get $np) (i32.const 1)))
    (call $vm_emit_op (local.get $code) (i32.const 11))  ;; POP (discard truthy left)
    (i32.store (i32.const 956) (i32.const 0))
    (call $vm_c_bitor (local.get $code))  ;; && RHS is a BitwiseORExpression (| ^ & below it), NOT just a comparison
    (br $l)))
  (let $i i32 (i32.const 0))
  (block $pe (loop $pl
    (br_if $pe (i32.ge_s (local.get $i) (local.get $np)))
    (call $vm_patch (local.get $code) (i32.load (i32.add (local.get $patches) (i32.mul (local.get $i) (i32.const 4)))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $pl)))
