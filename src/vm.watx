;; ═══════════════════════════════════════════════════════════════
;; vm.watx — Phase 2: bytecode/threaded virtual machine (foundation)
;;
;; The re-scan evaluator keeps a call's execution state on the WASM call
;; stack, so it can never be snapshotted — which is exactly why generators,
;; async/await, and tail-call optimization are impossible there.
;;
;; This VM reifies execution state in LINEAR MEMORY: an instruction pointer
;; into a compiled bytecode array, plus an explicit operand stack. Because
;; that state is data, a future YIELD opcode can save (ip, sp) and return,
;; and resume by restoring them — the prerequisite for generators/async.
;; Tail calls become frame elision once call frames live in memory too.
;;
;; Milestone 1: compile + run arithmetic, validating the dispatch loop and
;; the in-memory operand stack. The compiler reuses the existing lexer, so
;; there is one front-end (as the design intended). Threaded dispatch via
;; call_indirect / return_call_indirect is a later perf step; the
;; suspend/resume property comes from in-memory state, not the dispatch form.
;;
;; Opcodes (one i32 word each; PUSH is followed by an 8-byte i64 JSValue):
;;   0 HALT   1 PUSH   2 ADD   3 SUB   4 MUL   5 DIV   6 NEG
;; ═══════════════════════════════════════════════════════════════

;; emit cursor (byte offset into the code buffer under construction) — reg 200
(func $vm_emit_cursor (result i32) (effects) (i32.load (i32.const 200)))
(func $vm_set_emit_cursor (param $c i32) (effects) (i32.store (i32.const 200) (local.get $c)))

(func $vm_emit_op (param $code i32) (param $op i32) (effects)
  (i32.store (i32.add (local.get $code) (call $vm_emit_cursor)) (local.get $op))
  (call $vm_set_emit_cursor (i32.add (call $vm_emit_cursor) (i32.const 4))))

(func $vm_emit_val (param $code i32) (param $v i64) (effects)
  (i64.store (i32.add (local.get $code) (call $vm_emit_cursor)) (local.get $v))
  (call $vm_set_emit_cursor (i32.add (call $vm_emit_cursor) (i32.const 8))))

;; ── compiler: source → bytecode (precedence-climbing, reuses the lexer) ──
(func $vm_c_primary (param $code i32) (effects)
  (if (i32.eq (call $tok_kind) (i32.const 1))  ;; NUM literal
    (then
      (call $vm_emit_op (local.get $code) (i32.const 1))      ;; PUSH
      (call $vm_emit_val (local.get $code) (call $num (call $tok_num)))
      (call $next_token)
      (return)))
  (if (i32.eq (call $tok_kind) (i32.const 11))  ;; unary -
    (then
      (call $next_token)
      (call $vm_c_primary (local.get $code))
      (call $vm_emit_op (local.get $code) (i32.const 6))      ;; NEG
      (return)))
  (if (i32.eq (call $tok_kind) (i32.const 15))  ;; ( expr )
    (then
      (call $next_token)
      (call $vm_c_add (local.get $code))
      (call $next_token)                                       ;; consume ')'
      (return))))

(func $vm_c_mul (param $code i32) (effects)
  (call $vm_c_primary (local.get $code))
  (block $e (loop $l
    (let $k i32 (call $tok_kind))
    (br_if $e (i32.eqz (i32.or (i32.eq (local.get $k) (i32.const 12)) (i32.eq (local.get $k) (i32.const 13)))))
    (call $next_token)
    (call $vm_c_primary (local.get $code))
    (call $vm_emit_op (local.get $code) (if i32 (i32.eq (local.get $k) (i32.const 12)) (then (i32.const 4)) (else (i32.const 5))))
    (br $l))))

(func $vm_c_add (param $code i32) (effects)
  (call $vm_c_mul (local.get $code))
  (block $e (loop $l
    (let $k i32 (call $tok_kind))
    (br_if $e (i32.eqz (i32.or (i32.eq (local.get $k) (i32.const 10)) (i32.eq (local.get $k) (i32.const 11)))))
    (call $next_token)
    (call $vm_c_mul (local.get $code))
    (call $vm_emit_op (local.get $code) (if i32 (i32.eq (local.get $k) (i32.const 10)) (then (i32.const 2)) (else (i32.const 3))))
    (br $l))))

;; compile a single arithmetic expression, HALT-terminated
(func $vm_compile (param $ptr i32) (param $len i32) (result i32) (effects)
  (call $set_src (local.get $ptr) (local.get $len))
  (call $lex_init)
  (call $next_token)
  (let $code i32 (call $heap_alloc (i32.const 8192)))
  (call $vm_set_emit_cursor (i32.const 0))
  (call $vm_c_add (local.get $code))
  (call $vm_emit_op (local.get $code) (i32.const 0))  ;; HALT
  (local.get $code))

;; compile a ';'-separated list of expressions, YIELDing each — a stand-in for a
;; generator body, to exercise suspend/resume. Layout: [expr YIELD]* HALT
(func $vm_compile_gen (param $ptr i32) (param $len i32) (result i32) (effects)
  (call $set_src (local.get $ptr) (local.get $len))
  (call $lex_init)
  (call $next_token)
  (let $code i32 (call $heap_alloc (i32.const 8192)))
  (call $vm_set_emit_cursor (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.eq (call $tok_kind) (i32.const 0)))  ;; EOF
    (call $vm_c_add (local.get $code))
    (call $vm_emit_op (local.get $code) (i32.const 7))  ;; YIELD
    (br_if $e (i32.ne (call $tok_kind) (i32.const 21)))  ;; ';'
    (call $next_token)
    (br $l)))
  (call $vm_emit_op (local.get $code) (i32.const 0))  ;; HALT
  (local.get $code))

;; ── resumable VM context — execution state reified in memory ──
;; layout: @0 code, @4 ip, @8 stack, @12 sp, @16 done
(func $vm_new (param $code i32) (result i32) (effects)
  (let $ctx i32 (call $heap_alloc (i32.const 24)))
  (i32.store (local.get $ctx) (local.get $code))
  (i32.store (i32.add (local.get $ctx) (i32.const 4)) (i32.const 0))           ;; ip
  (i32.store (i32.add (local.get $ctx) (i32.const 8)) (call $heap_alloc (i32.const 8192)))  ;; operand stack
  (i32.store (i32.add (local.get $ctx) (i32.const 12)) (i32.const 0))          ;; sp
  (i32.store (i32.add (local.get $ctx) (i32.const 16)) (i32.const 0))          ;; done
  (local.get $ctx))

(func $vm_done (param $ctx i32) (result i32) (effects) (i32.load (i32.add (local.get $ctx) (i32.const 16))))

;; run from the context's saved (ip, sp) until the next YIELD or HALT.
;; YIELD → returns the yielded value, state saved for the next call (done=0).
;; HALT  → sets done=1, returns the final top-of-stack value (or undefined).
;; This is the mechanism the re-scan evaluator structurally cannot provide.
(func $vm_step (param $ctx i32) (result i64) (effects)
  (let $code i32 (i32.load (local.get $ctx)))
  (let $stack i32 (i32.load (i32.add (local.get $ctx) (i32.const 8))))
  (let $ip i32 (i32.load (i32.add (local.get $ctx) (i32.const 4))))
  (let $sp i32 (i32.load (i32.add (local.get $ctx) (i32.const 12))))
  (loop $disp
    (let $op i32 (i32.load (i32.add (local.get $code) (local.get $ip))))
    (set! $ip (i32.add (local.get $ip) (i32.const 4)))
    (if (i32.eq (local.get $op) (i32.const 0))  ;; HALT
      (then
        (i32.store (i32.add (local.get $ctx) (i32.const 16)) (i32.const 1))
        (i32.store (i32.add (local.get $ctx) (i32.const 4)) (local.get $ip))
        (i32.store (i32.add (local.get $ctx) (i32.const 12)) (local.get $sp))
        (return (if i64 (i32.gt_s (local.get $sp) (i32.const 0))
                  (then (i64.load (i32.add (local.get $stack) (i32.sub (local.get $sp) (i32.const 8)))))
                  (else (call $v_undef))))))
    (if (i32.eq (local.get $op) (i32.const 7))  ;; YIELD — suspend
      (then
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
        (i32.store (i32.add (local.get $ctx) (i32.const 4)) (local.get $ip))
        (i32.store (i32.add (local.get $ctx) (i32.const 12)) (local.get $sp))
        (return (i64.load (i32.add (local.get $stack) (local.get $sp))))))
    (if (i32.eq (local.get $op) (i32.const 1))  ;; PUSH imm
      (then
        (i64.store (i32.add (local.get $stack) (local.get $sp)) (i64.load (i32.add (local.get $code) (local.get $ip))))
        (set! $ip (i32.add (local.get $ip) (i32.const 8)))
        (set! $sp (i32.add (local.get $sp) (i32.const 8)))
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 6))  ;; NEG
      (then
        (let $t i32 (i32.sub (local.get $sp) (i32.const 8)))
        (i64.store (i32.add (local.get $stack) (local.get $t))
                   (call $num (f64.neg (call $tonum_raw (i64.load (i32.add (local.get $stack) (local.get $t)))))))
        (br $disp)))
    ;; binary: pop b, then a
    (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
    (let $b f64 (call $tonum_raw (i64.load (i32.add (local.get $stack) (local.get $sp)))))
    (let $a f64 (call $tonum_raw (i64.load (i32.add (local.get $stack) (i32.sub (local.get $sp) (i32.const 8))))))
    (let $r f64 (f64.const 0))
    (if (i32.eq (local.get $op) (i32.const 2)) (then (set! $r (f64.add (local.get $a) (local.get $b)))))
    (if (i32.eq (local.get $op) (i32.const 3)) (then (set! $r (f64.sub (local.get $a) (local.get $b)))))
    (if (i32.eq (local.get $op) (i32.const 4)) (then (set! $r (f64.mul (local.get $a) (local.get $b)))))
    (if (i32.eq (local.get $op) (i32.const 5)) (then (set! $r (f64.div (local.get $a) (local.get $b)))))
    (i64.store (i32.add (local.get $stack) (i32.sub (local.get $sp) (i32.const 8))) (call $num (local.get $r)))
    (br $disp))
  (call $v_undef))  ;; unreachable (loop always returns)

;; entry: compile then run a single expression to HALT, returning the number
(func $eval_vm (param $ptr i32) (param $len i32) (result f64) (effects)
  (call $tonum_raw (call $vm_step (call $vm_new (call $vm_compile (local.get $ptr) (local.get $len))))))

;; generator demo: start a ';'-separated yield-list; gen_next pulls each value
(func $vm_gen_start (param $ptr i32) (param $len i32) (result i32) (effects)
  (call $vm_new (call $vm_compile_gen (local.get $ptr) (local.get $len))))
(func $vm_gen_next (param $ctx i32) (result f64) (effects)
  (call $tonum_raw (call $vm_step (local.get $ctx))))
