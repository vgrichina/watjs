  (i32.store (i32.const 868) (local.get $savesuperhome))  ;; restore enclosing super-property-allowed flag
  (i32.store (i32.const 884) (local.get $savesupercall))  ;; restore enclosing super()-call-allowed flag
  (i32.store (i32.const 320) (local.get $savefin))  ;; restore enclosing fn's finally depth
  (i32.store (i32.const 372) (local.get $savehc)) (i32.store (i32.const 376) (local.get $savehb))  ;; restore enclosing hoist list
  (i32.store (i32.const 388) (local.get $savestrict))  ;; restore enclosing strictness
  ;; a DERIVED class ctor (classf==2) that reaches the implicit end-return must have called super()
  ;; — else `this` was never initialized → ReferenceError (CHECKSUPER op 108).
  (if (i32.eq (local.get $classf) (i32.const 2)) (then (call $vm_emit_op (local.get $code) (i32.const 108))))
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef))
  (call $vm_emit_op (local.get $code) (i32.const 20))  ;; default RET undefined
  (call $vm_patch (local.get $code) (local.get $pj))
  (let $fn i32 (call $heap_alloc (i32.add (i32.const 52) (i32.mul (local.get $np) (i32.const 4)))))  ;; @16 proto (i64), @24 closureScope, @28 params, @(28+np*4) name, @(32+np*4) flags, @(36+np*4) .length, @(40+np*4) srcPtr, @(44+np*4) srcLen, @(48+np*4) own-prop scope
  (let $isasync i32 (local.get $asyncf))
  (let $isgen i32 (local.get $genf))
  (i32.store (local.get $fn) (if i32 (local.get $isgen) (then (i32.const 1448232527))
    (else (if i32 (local.get $isasync) (then (i32.const 1448232528)) (else (i32.const 1448232526))))))  ;; GEN / ASYNC / NORMAL
  (i32.store (i32.add (local.get $fn) (i32.const 4)) (local.get $entry))
  (i32.store (i32.add (local.get $fn) (i32.const 8)) (local.get $np))
  (i32.store (i32.add (local.get $fn) (i32.const 12)) (local.get $code))
  (i64.store (i32.add (local.get $fn) (i32.const 16)) (call $v_hole))  ;; prototype (set by class compilation)
  (i32.store (i32.add (local.get $fn) (i32.const 24)) (i32.const 0))    ;; closureScope (filled at runtime by CLOSURE)
  (let $ci i32 (i32.const 0))
  (block $ce (loop $cl
    (br_if $ce (i32.ge_s (local.get $ci) (local.get $np)))
    (i32.store (i32.add (i32.add (local.get $fn) (i32.const 28)) (i32.mul (local.get $ci) (i32.const 4)))
               (i32.load (i32.add (local.get $params) (i32.mul (local.get $ci) (i32.const 4)))))
    (set! $ci (i32.add (local.get $ci) (i32.const 1)))
    (br $cl)))
  ;; non-simple parameter list (rest param, any default initializer, or a destructuring pattern)
  ;; → bit4. Such a function gets an UNMAPPED arguments object even in sloppy mode (spec:
  ;; IsSimpleParameterList false).
  (let $nonsimple i32 (i32.ge_s (local.get $restidx) (i32.const 0)))
  (let $nsi i32 (i32.const 0))
  (block $nse (loop $nsl
    (br_if $nse (i32.ge_s (local.get $nsi) (local.get $np)))
    (if (i32.or (i32.ne (i32.load (i32.add (local.get $pdef) (i32.mul (local.get $nsi) (i32.const 4)))) (i32.const 0))
                (i32.ne (i32.load (i32.add (local.get $ppat) (i32.mul (local.get $nsi) (i32.const 4)))) (i32.const 0)))
      (then (set! $nonsimple (i32.const 1)) (br $nse)))
    (set! $nsi (i32.add (local.get $nsi) (i32.const 1)))
    (br $nsl)))
  ;; .name: the declared name (named fn decl/expr), or 0 → "" until inferred
  (i32.store (i32.add (i32.add (local.get $fn) (i32.const 28)) (i32.mul (local.get $np) (i32.const 4))) (local.get $selfname))
  (i32.store (i32.add (i32.add (local.get $fn) (i32.const 32)) (i32.mul (local.get $np) (i32.const 4)))
    (i32.or (i32.or (i32.or (i32.or (if i32 (local.get $thisstrict) (then (i32.const 4)) (else (i32.const 0)))  ;; bit2 strict
            (if i32 (local.get $classf) (then (i32.const 8)) (else (i32.const 0))))  ;; bit3 class constructor (no plain call)
            (if i32 (i32.and (local.get $noproto) (i32.eqz (local.get $genf))) (then (i32.const 64)) (else (i32.const 0))))  ;; bit6 method/accessor → no .prototype (generator methods keep theirs)
            (if i32 (i32.and (local.get $genf) (local.get $asyncf)) (then (i32.const 128)) (else (i32.const 0))))  ;; bit7 async generator (its result object's next/return/throw return promises)
            (if i32 (local.get $nonsimple) (then (i32.const 16)) (else (i32.const 0)))))  ;; bit4 non-simple params → unmapped arguments
  ;; .length = ExpectedArgumentCount: params before the first one with a default or the rest param
  (let $explen i32 (local.get $np))
  (let $eli i32 (i32.const 0))
  (block $ele (loop $ell
    (br_if $ele (i32.ge_s (local.get $eli) (local.get $np)))
    ;; $pdef may be 0 (null, no defaults array — e.g. a parenless single-ident arrow `x => …`); guard the load,
    ;; else i32.load(0) reads garbage at memory[0] and wrongly clamps .length to 0.
    (if (i32.or (i32.and (i32.ne (local.get $pdef) (i32.const 0)) (i32.ne (i32.load (i32.add (local.get $pdef) (i32.mul (local.get $eli) (i32.const 4)))) (i32.const 0))) (i32.eq (local.get $eli) (local.get $restidx)))
      (then (set! $explen (local.get $eli)) (br $ele)))
    (set! $eli (i32.add (local.get $eli) (i32.const 1)))
    (br $ell)))
  (i32.store (i32.add (i32.add (local.get $fn) (i32.const 36)) (i32.mul (local.get $np) (i32.const 4))) (local.get $explen))
  ;; source span @(40+np*4) ptr, @(44+np*4) len — for Function.prototype.toString (0 ptr ⇒ native form)
  (if (local.get $fnsrcstart)
    (then
      (i32.store (i32.add (i32.add (local.get $fn) (i32.const 40)) (i32.mul (local.get $np) (i32.const 4))) (i32.add (i32.load (i32.const 4)) (i32.sub (local.get $fnsrcstart) (i32.const 1))))  ;; SRC_base + (start-1)
      (i32.store (i32.add (i32.add (local.get $fn) (i32.const 44)) (i32.mul (local.get $np) (i32.const 4))) (i32.sub (i32.load (i32.const 696)) (i32.sub (local.get $fnsrcstart) (i32.const 1)))))  ;; end - start
    (else (i32.store (i32.add (i32.add (local.get $fn) (i32.const 40)) (i32.mul (local.get $np) (i32.const 4))) (i32.const 0))))
  ;; named function: CLOSURE_NAMED binds the name to the function inside its own
  ;; body (recursive named function expressions); anonymous: plain CLOSURE.
  (if (local.get $selfname)
    (then (call $vm_emit_op (local.get $code) (i32.const 64)) (call $vm_emit_op (local.get $code) (local.get $fn)) (call $vm_emit_op (local.get $code) (local.get $selfname)))  ;; CLOSURE_NAMED
    (else (call $vm_emit_op (local.get $code) (i32.const 61)) (call $vm_emit_op (local.get $code) (local.get $fn))))  ;; CLOSURE
  (i32.store (i32.const 680) (local.get $litstart)) (i32.store (i32.const 684) (call $vm_emit_cursor)))  ;; record fn-literal span [680,684] for name-inference

;; emit a PUSH of an empty (no-op) VM function — used for a class with no constructor
(func $vm_emit_empty_fn (param $code i32) (effects)
  (let $pj i32 (call $vm_emit_jump (local.get $code) (i32.const 12)))
  (let $entry i32 (call $vm_emit_cursor))
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef))
  (call $vm_emit_op (local.get $code) (i32.const 20))  ;; RET undefined
  (call $vm_patch (local.get $code) (local.get $pj))
  (let $fn i32 (call $heap_alloc (i32.const 52)))  ;; @28 name, @32 flags, @36 .length (ExpectedArgumentCount); @48 own-prop scope (statics)
  (i32.store (local.get $fn) (i32.const 1448232526))
  (i32.store (i32.add (local.get $fn) (i32.const 4)) (local.get $entry))
  (i32.store (i32.add (local.get $fn) (i32.const 8)) (i32.const 0))
  (i32.store (i32.add (local.get $fn) (i32.const 12)) (local.get $code))
  (i64.store (i32.add (local.get $fn) (i32.const 16)) (call $v_hole))
  (i32.store (i32.add (local.get $fn) (i32.const 24)) (i32.const 0))    ;; closureScope (0 → gscope fallback)
  (i32.store (i32.add (local.get $fn) (i32.const 28)) (i32.const 0))    ;; name ""
  (i32.store (i32.add (local.get $fn) (i32.const 32)) (i32.const 8))    ;; bit3 = class constructor (synthetic, no plain call)
  (i32.store (i32.add (local.get $fn) (i32.const 36)) (i32.const 0))    ;; .length = 0
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_fn (local.get $fn))))

;; emit a PUSH of a synthetic DERIVED constructor — runs `super()` (no forwarded args) then returns
;; covers `class B extends A {}` so `new B()` invokes A's constructor with this=instance
(func $vm_emit_derived_ctor (param $code i32) (effects)
  (let $pj i32 (call $vm_emit_jump (local.get $code) (i32.const 12)))
  (let $entry i32 (call $vm_emit_cursor))
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (cstring "@@newo"))   ;; receiver = the (uninitialized) object; `this` is TDZ here
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (cstring "@@homeproto"))  ;; this ctor's home prototype (lexical level)
  (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (cstring "@@super"))  ;; parent ctor (home.@@super, not this.@@super)
  ;; a default derived constructor is `constructor(...args){ super(...args) }` — forward
  ;; the received arguments to the parent rather than calling super() with none.
  (call $vm_emit_op (local.get $code) (i32.const 29)) (call $vm_emit_op (local.get $code) (i32.const 0))  ;; NEWARRAY 0
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (cstring "arguments"))  ;; LOADVAR arguments
  (call $vm_emit_op (local.get $code) (i32.const 53))  ;; SPREAD arguments into the args array
  (call $vm_emit_op (local.get $code) (i32.const 103))  ;; SUPERCALLSPREAD
  (call $vm_emit_op (local.get $code) (i32.const 112))  ;; RUNFIELDS: bind this + fields after super()
  (call $vm_emit_op (local.get $code) (i32.const 11))  ;; POP super result
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef))
  (call $vm_emit_op (local.get $code) (i32.const 20))  ;; RET undefined
  (call $vm_patch (local.get $code) (local.get $pj))
  (let $fn i32 (call $heap_alloc (i32.const 52)))  ;; +own-prop scope @48 (statics)
  (i32.store (local.get $fn) (i32.const 1448232526))
  (i32.store (i32.add (local.get $fn) (i32.const 4)) (local.get $entry))
  (i32.store (i32.add (local.get $fn) (i32.const 8)) (i32.const 0))
  (i32.store (i32.add (local.get $fn) (i32.const 12)) (local.get $code))
  (i64.store (i32.add (local.get $fn) (i32.const 16)) (call $v_hole))
  (i32.store (i32.add (local.get $fn) (i32.const 24)) (i32.const 0))
  (i32.store (i32.add (local.get $fn) (i32.const 28)) (i32.const 0))
  (i32.store (i32.add (local.get $fn) (i32.const 32)) (i32.const 8))    ;; bit3 = class constructor
  (i32.store (i32.add (local.get $fn) (i32.const 36)) (i32.const 0))    ;; .length = 0
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_fn (local.get $fn))))

;; emit a CLOSURE for a class field initializer: function(){ return <init> }.
;; cursor must be at the init expression. Captures the class-def scope (CLOSURE),
;; runs with `this` = the instance (non-arrow). Leaves the closure on the stack.
;; a static-initialization block: a 0-param thunk whose body is the `{ ... }` block
;; (cursor at '{'), returning undefined. Run with this=ctor at class definition.
(func $vm_emit_block_thunk (param $code i32) (effects)
  (let $bpj i32 (call $vm_emit_jump (local.get $code) (i32.const 12)))  ;; JMP over body
  (let $bentry i32 (call $vm_emit_cursor))
  (let $btsuperhome i32 (i32.load (i32.const 868)))  ;; a static-init block has a [[HomeObject]] → super property access allowed, but super() is NOT
  (let $btsupercall i32 (i32.load (i32.const 884)))
  (i32.store (i32.const 868) (i32.const 1)) (i32.store (i32.const 884) (i32.const 0))
  ;; a ClassStaticBlock is NOT a generator/async context (so yield/await are reserved, not operators) and
  ;; forbids return/arguments — reset reg 672 (generator) / reg 896 (async), set reg 912 (in-static-block).
  (let $btgen i32 (i32.load (i32.const 672)))
  (let $btasync i32 (i32.load (i32.const 896)))
  (let $btsb i32 (i32.load (i32.const 912)))
  (let $btargs i32 (i32.load (i32.const 916)))
  (let $btinfn i32 (i32.load (i32.const 920)))  ;; a static block is not a function body — `return` forbidden (also caught by reg 912)
  (let $btnt i32 (i32.load (i32.const 1008)))  ;; new.target IS allowed in a class static block (evaluates to undefined)
  (i32.store (i32.const 672) (i32.const 0)) (i32.store (i32.const 896) (i32.const 0)) (i32.store (i32.const 912) (i32.const 1)) (i32.store (i32.const 916) (i32.const 1)) (i32.store (i32.const 920) (i32.const 0)) (i32.store (i32.const 1008) (i32.const 1))
  (call $vm_c_stmt (local.get $code))  ;; the `{ ... }` block
  (i32.store (i32.const 672) (local.get $btgen)) (i32.store (i32.const 896) (local.get $btasync)) (i32.store (i32.const 912) (local.get $btsb)) (i32.store (i32.const 916) (local.get $btargs)) (i32.store (i32.const 920) (local.get $btinfn)) (i32.store (i32.const 1008) (local.get $btnt))
  (i32.store (i32.const 868) (local.get $btsuperhome)) (i32.store (i32.const 884) (local.get $btsupercall))
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef))  ;; PUSH undefined (no value)
  (call $vm_emit_op (local.get $code) (i32.const 20))  ;; RET
  (call $vm_patch (local.get $code) (local.get $bpj))
  (let $bfn i32 (call $heap_alloc (i32.const 52)))  ;; +own-prop scope @48 (statics)
  (i32.store (local.get $bfn) (i32.const 1448232526))
  (i32.store (i32.add (local.get $bfn) (i32.const 4)) (local.get $bentry))
  (i32.store (i32.add (local.get $bfn) (i32.const 8)) (i32.const 0))     ;; np
  (i32.store (i32.add (local.get $bfn) (i32.const 12)) (local.get $code))
  (i64.store (i32.add (local.get $bfn) (i32.const 16)) (call $v_hole))  ;; proto
  (i32.store (i32.add (local.get $bfn) (i32.const 24)) (i32.const 0))    ;; closureScope (CLOSURE fills at runtime)
  (i32.store (i32.add (local.get $bfn) (i32.const 28)) (i32.const 0))    ;; name
  (i32.store (i32.add (local.get $bfn) (i32.const 32)) (i32.const 0))    ;; flags 0 (own `this`)
  (i32.store (i32.add (local.get $bfn) (i32.const 36)) (i32.const 0))    ;; .length = 0
  (call $vm_emit_op (local.get $code) (i32.const 61)) (call $vm_emit_op (local.get $code) (local.get $bfn)))  ;; CLOSURE

(func $vm_emit_field_thunk (param $code i32) (param $fieldname i32) (effects)  ;; $fieldname (cstring, 0=computed/none): NamedEvaluation of an anon-fn initializer
  (let $pj i32 (call $vm_emit_jump (local.get $code) (i32.const 12)))  ;; JMP over body
  (let $entry i32 (call $vm_emit_cursor))
  (let $ftsuperhome i32 (i32.load (i32.const 868)))  ;; a class field initializer has a [[HomeObject]] → super property access allowed, but super() is NOT
  (let $ftsupercall i32 (i32.load (i32.const 884)))
  (i32.store (i32.const 868) (i32.const 1)) (i32.store (i32.const 884) (i32.const 0))
  ;; a class field initializer may not reference `arguments` (reg 916), even via a nested arrow (arrows
  ;; inherit; a nested regular function resets it in vm_c_fnbody since it has its own `arguments`).
  (let $ftargs i32 (i32.load (i32.const 916)))
  (i32.store (i32.const 916) (i32.const 1))
  (let $ftnt i32 (i32.load (i32.const 1008)))  ;; a field initializer allows new.target (evaluated during construction)
  (i32.store (i32.const 1008) (i32.const 1))
  ;; a field initializer `x = <AssignmentExpression>` requires a value — `class C{ x = ; }` → SyntaxError
  (if (i32.or (i32.eq (call $tok_kind) (i32.const 21)) (i32.or (i32.eq (call $tok_kind) (i32.const 18)) (i32.or (i32.eq (call $tok_kind) (i32.const 22)) (i32.eq (call $tok_kind) (i32.const 0)))))
    (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "class field initializer requires a value")) (return)))
  (let $ftafs i32 (call $vm_emit_cursor))  ;; span start for anon-fn NamedEvaluation
  (call $vm_c_expr (local.get $code))  ;; compile init expr → value
  ;; ClassFieldDefinitionEvaluation: if the initializer IS an anonymous function/arrow/class, its
  ;; .name is the field name (`static f = ()=>1` → f.name === "f"; `#p = ()=>1` → "#p"). Computed
  ;; keys pass $fieldname 0 (name derives from the runtime key — handled separately, if at all).
  (if (i32.and (i32.ne (local.get $fieldname) (i32.const 0)) (call $vm_is_anon_fn_def (local.get $ftafs)))  ;; booleanize $fieldname first — it's a pointer, so a raw i32.and with the 0/1 predicate is bitwise-wrong
    (then (call $vm_emit_op (local.get $code) (i32.const 72)) (call $vm_emit_op (local.get $code) (local.get $fieldname))))
  (i32.store (i32.const 916) (local.get $ftargs))
  (i32.store (i32.const 1008) (local.get $ftnt))
  (i32.store (i32.const 868) (local.get $ftsuperhome)) (i32.store (i32.const 884) (local.get $ftsupercall))
  (call $vm_emit_op (local.get $code) (i32.const 20))  ;; RET (returns TOS)
  (call $vm_patch (local.get $code) (local.get $pj))
  (let $fn i32 (call $heap_alloc (i32.const 52)))  ;; +own-prop scope @48 (statics)
  (i32.store (local.get $fn) (i32.const 1448232526))
  (i32.store (i32.add (local.get $fn) (i32.const 4)) (local.get $entry))
  (i32.store (i32.add (local.get $fn) (i32.const 8)) (i32.const 0))     ;; np
  (i32.store (i32.add (local.get $fn) (i32.const 12)) (local.get $code))
  (i64.store (i32.add (local.get $fn) (i32.const 16)) (call $v_hole))  ;; proto
  (i32.store (i32.add (local.get $fn) (i32.const 24)) (i32.const 0))    ;; closureScope (CLOSURE fills at runtime)
  (i32.store (i32.add (local.get $fn) (i32.const 28)) (i32.const 0))    ;; name
  (i32.store (i32.add (local.get $fn) (i32.const 32)) (i32.const 0))    ;; flags 0 (non-arrow → own `this`)
  (i32.store (i32.add (local.get $fn) (i32.const 36)) (i32.const 0))    ;; .length = 0
  (call $vm_emit_op (local.get $code) (i32.const 61)) (call $vm_emit_op (local.get $code) (local.get $fn)))  ;; CLOSURE → runtime closure capturing class-def scope

;; Compile a destructuring pattern (cursor at '[' or '{') that binds from the
;; value already stored in variable $srcTmp. Single-level array/object patterns
;; with element/property defaults and array rest (matching var-destructuring);
;; a nested array/object target recurses through a fresh temp. Leaves the cursor
;; just past the closing ']' / '}'. Emits STOREVAR for each bound name.
;; skip a balanced bracket group ([ ] / { } / ( )) starting at the current opener.
(func $vm_skip_balanced (effects)
  (let $d i32 (i32.const 0))
  (block $e (loop $l
    (let $k i32 (call $tok_kind))
    (br_if $e (i32.eqz (local.get $k)))  ;; EOF guard
    (if (i32.or (i32.eq (local.get $k) (i32.const 19)) (i32.or (i32.eq (local.get $k) (i32.const 17)) (i32.eq (local.get $k) (i32.const 15))))
      (then (set! $d (i32.add (local.get $d) (i32.const 1)))))
    (if (i32.or (i32.eq (local.get $k) (i32.const 20)) (i32.or (i32.eq (local.get $k) (i32.const 18)) (i32.eq (local.get $k) (i32.const 16))))
      (then (set! $d (i32.sub (local.get $d) (i32.const 1)))
            (if (i32.eqz (local.get $d)) (then (call $next_token) (br $e)))))
    (call $next_token) (br $l))))

;; ForIn/OfHeadEvaluation TDZ: scan the destructuring pattern at the cursor (on '[' / '{') and emit
;; `PUSH v_tdz; LEXDEFINIT id` for every BINDING identifier — array elements, object shorthand and
;; post-':' targets, '...rest' — while SKIPPING property keys (ident followed by ':'), computed keys
;; ('[expr]:' in object key position), and default-value expressions (after '='). A per-depth container
;; stack (0=array, 1=object-expecting-key, 2=object-expecting-value) disambiguates. Cursor NOT restored
;; (the caller saves/restores). Used to put a let/const ForBinding's names in TDZ during head eval.
(func $vm_emit_pattern_tdz (param $code i32) (effects)
  (let $stk i32 (call $heap_alloc (i32.const 256)))  ;; 1 byte per open container (max nesting 256)
  (let $sp i32 (i32.const 0))
  (block $done (loop $lp
    (let $k i32 (call $tok_kind))
    (br_if $done (i32.eqz (local.get $k)))  ;; EOF safety
    ;; '{' → open object (expecting a key)
    (if (i32.eq (local.get $k) (i32.const 17))
      (then (i32.store8 (i32.add (local.get $stk) (local.get $sp)) (i32.const 1)) (set! $sp (i32.add (local.get $sp) (i32.const 1))) (call $next_token) (br $lp)))
    ;; '[' → a computed key (object, expecting key) or an array-pattern open
    (if (i32.eq (local.get $k) (i32.const 19))
      (then
        (if (i32.and (i32.gt_s (local.get $sp) (i32.const 0)) (i32.eq (i32.load8_u (i32.add (local.get $stk) (i32.sub (local.get $sp) (i32.const 1)))) (i32.const 1)))
          (then (call $vm_skip_balanced) (i32.store8 (i32.add (local.get $stk) (i32.sub (local.get $sp) (i32.const 1))) (i32.const 2)) (br $lp))  ;; computed key → skip, now expect the value/target
          (else (i32.store8 (i32.add (local.get $stk) (local.get $sp)) (i32.const 0)) (set! $sp (i32.add (local.get $sp) (i32.const 1))) (call $next_token) (br $lp)))))
    ;; ']' / '}' → close a container (done when the top-level pattern closes)
    (if (i32.or (i32.eq (local.get $k) (i32.const 20)) (i32.eq (local.get $k) (i32.const 18)))
      (then (set! $sp (i32.sub (local.get $sp) (i32.const 1))) (br_if $done (i32.le_s (local.get $sp) (i32.const 0))) (call $next_token) (br $lp)))
    ;; ':' → now expecting the value/target
    (if (i32.eq (local.get $k) (i32.const 37))
      (then (if (i32.gt_s (local.get $sp) (i32.const 0)) (then (i32.store8 (i32.add (local.get $stk) (i32.sub (local.get $sp) (i32.const 1))) (i32.const 2)))) (call $next_token) (br $lp)))
    ;; ',' → in an object, the next property starts with a key
    (if (i32.eq (local.get $k) (i32.const 22))
      (then (if (i32.gt_s (local.get $sp) (i32.const 0)) (then (if (i32.ne (i32.load8_u (i32.add (local.get $stk) (i32.sub (local.get $sp) (i32.const 1)))) (i32.const 0)) (then (i32.store8 (i32.add (local.get $stk) (i32.sub (local.get $sp) (i32.const 1))) (i32.const 1)))))) (call $next_token) (br $lp)))
    ;; '=' → skip the default-value expression up to a top-level ',' or the container close
    (if (i32.eq (local.get $k) (i32.const 24))
      (then
        (call $next_token)
        (let $dd i32 (i32.const 0))
        (block $de (loop $dl
          (let $dk i32 (call $tok_kind))
          (br_if $de (i32.eqz (local.get $dk)))
          (if (i32.or (i32.eq (local.get $dk) (i32.const 15)) (i32.or (i32.eq (local.get $dk) (i32.const 17)) (i32.eq (local.get $dk) (i32.const 19))))
            (then (set! $dd (i32.add (local.get $dd) (i32.const 1))) (call $next_token) (br $dl)))
          (if (i32.or (i32.eq (local.get $dk) (i32.const 16)) (i32.or (i32.eq (local.get $dk) (i32.const 18)) (i32.eq (local.get $dk) (i32.const 20))))
            (then (br_if $de (i32.le_s (local.get $dd) (i32.const 0))) (set! $dd (i32.sub (local.get $dd) (i32.const 1))) (call $next_token) (br $dl)))  ;; a closer at depth 0 belongs to the pattern
          (br_if $de (i32.and (i32.eq (local.get $dk) (i32.const 22)) (i32.le_s (local.get $dd) (i32.const 0))))  ;; a top-level ',' ends the default
          (call $next_token) (br $dl)))
        (br $lp)))
    ;; identifier → a property KEY (object-expecting-key, followed by ':') or a BINDING
    (if (i32.eq (local.get $k) (i32.const 3))
      (then
        (let $nm i32 (call $ident_name))
        (let $wasobjkey i32 (i32.and (i32.gt_s (local.get $sp) (i32.const 0)) (i32.eq (i32.load8_u (i32.add (local.get $stk) (i32.sub (local.get $sp) (i32.const 1)))) (i32.const 1))))
        (call $next_token)
        (if (i32.and (local.get $wasobjkey) (i32.eq (call $tok_kind) (i32.const 37)))
          (then)  ;; property key (`name:` …) — not a binding; the ':' handler switches to value position
          (else (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_tdz)) (call $vm_emit_op (local.get $code) (i32.const 114)) (call $vm_emit_op (local.get $code) (local.get $nm))))  ;; LEXDEFINIT nm = v_tdz
        (br $lp)))
    ;; anything else ('...', string/number-literal key, etc.) — advance
    (call $next_token) (br $lp))))

;; After a fast-path assignment statement (NAME = / op= / ||= / …), consume any trailing
;; `, AssignmentExpression` comma-operator continuation (`a=1, b=2`), emitting SETCOMPLETION for each so
;; the LAST element is the statement completion (spec comma semantics). The caller then eats the ';'.
;; Without this the fast path abandons `, b=2`, which mis-scopes it in a single-statement context.
(func $vm_emit_stmt_comma_tail (param $code i32) (effects)
  (block $e (loop $l
    (br_if $e (i32.ne (call $tok_kind) (i32.const 22)))  ;; not ',' → done
    (call $next_token)  ;; consume ','
    (call $vm_c_expr (local.get $code))  ;; next AssignmentExpression → [v]
    (call $vm_emit_op (local.get $code) (i32.const 71))  ;; SETCOMPLETION (pop → completion; last wins)
    (br $l))))

;; CreatePerIterationEnvironment for a regular-`for` let/const head: snapshot the current values of all
;; `count` head names, pop the current loop scope (closures created in it keep it), push a fresh scope, and
;; re-bind each name to its snapshot. Values are LOADVAR'd in order (stack [v0..vN-1]) then re-bound in
;; REVERSE (LIFO). const → DEFCONST, let → LEXDEFINIT.
(func $vm_emit_periter_copy (param $code i32) (param $names i32) (param $count i32) (param $isconst i32) (effects)
  (let $i i32 (i32.const 0))
  (block $le (loop $ll
    (br_if $le (i32.ge_s (local.get $i) (local.get $count)))
    (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (i32.load (i32.add (local.get $names) (i32.mul (local.get $i) (i32.const 4)))))  ;; LOADVAR name[i]
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $ll)))
  (call $vm_emit_op (local.get $code) (i32.const 94))  ;; LEAVEWITH (pop the current iteration's scope)
  (call $vm_emit_op (local.get $code) (i32.const 113)) (call $vm_emit_op (local.get $code) (i32.const 0))  ;; ENTERSCOPE 0 (fresh)
  (set! $i (i32.sub (local.get $count) (i32.const 1)))
  (block $de (loop $dl
    (br_if $de (i32.lt_s (local.get $i) (i32.const 0)))
    (call $vm_emit_op (local.get $code) (if i32 (local.get $isconst) (then (i32.const 79)) (else (i32.const 114)))) (call $vm_emit_op (local.get $code) (i32.load (i32.add (local.get $names) (i32.mul (local.get $i) (i32.const 4)))))  ;; DEFCONST/LEXDEFINIT name[i] (pops its snapshot)
    (set! $i (i32.sub (local.get $i) (i32.const 1))) (br $dl))))

;; A nested pattern element/property may carry a `= default` AFTER its closing
;; bracket. We must apply the default to the temp BEFORE destructuring it, so we
;; peek past the balanced pattern, emit the default-application onto $nt first,
;; then rewind and recurse. Cursor enters at the pattern opener.
(func $vm_c_nested_with_default (param $code i32) (param $nt i32) (effects)
  (let $ps i32 (call $cursor_save))  ;; at the '[' / '{'
  (call $vm_skip_balanced)           ;; advance past the matching closer
  ;; an optional chain applied to the pattern (`[{…}?.y = 42]`) makes it a member expression on an object/
  ;; array LITERAL, which is not a valid assignment target → SyntaxError.
  (if (i32.eq (call $tok_kind) (i32.const 55))
    (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Optional chain is not a valid assignment target")) (return)))
  (let $hd i32 (i32.eq (call $tok_kind) (i32.const 24)))  ;; '=' default follows?
  (let $rs i32 (i32.const 0))
  (if (local.get $hd)
    (then
      (call $next_token)  ;; consume '='
      (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $nt))  ;; LOADVAR nt
      (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef))
      (call $vm_emit_op (local.get $code) (i32.const 18))  ;; STRICTEQ
      (let $sk i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))  ;; JMPF → value present, skip default
      (call $vm_c_expr (local.get $code))  ;; eval default
      (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $nt))  ;; STOREVAR nt
      (call $vm_patch (local.get $code) (local.get $sk))
      (set! $rs (call $cursor_save))))  ;; position after the default expr
  (call $cursor_restore (local.get $ps))  ;; rewind to pattern opener
  (call $vm_c_destructure_param (local.get $code) (local.get $nt))  ;; destructure (consumes pattern)
  (if (local.get $hd) (then (call $cursor_restore (local.get $rs)))))  ;; skip past the default we pre-parsed

;; destructuring-ASSIGNMENT expression: `[pat] = RHS` or `({pat} = RHS)`.
;; Detect via lookahead (a '=' immediately after the balanced pattern), emit the
;; assignment via vm_c_destructure_param, and leave the RHS value on the stack
;; (a destructuring assignment evaluates to its RHS). Returns 1 if handled (cursor
;; consumed), 0 if not a destructuring assignment (cursor unchanged).
(func $vm_c_dstr_assign_expr (param $code i32) (result i32) (effects)
  (if (i32.eq (call $tok_kind) (i32.const 19))  ;; '[' array pattern
    (then
      (let $ps i32 (call $cursor_save))
      (call $vm_skip_balanced)  ;; past matching ']'
      (let $isda i32 (i32.eq (call $tok_kind) (i32.const 24)))  ;; '=' follows?
      (call $cursor_restore (local.get $ps))  ;; rewind to '['
      (if (local.get $isda)
        (then
          (let $ps2 i32 (call $cursor_save))   ;; at '['
          (call $vm_skip_balanced)
          (call $next_token)  ;; consume '='
          (call $vm_c_expr (local.get $code))  ;; RHS → [val]
          (let $tmp i32 (call $vm_tmpname))
          (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $tmp))  ;; STOREVAR tmp
          (let $rs i32 (call $cursor_save))    ;; after RHS
          (call $cursor_restore (local.get $ps2))  ;; back to '['
          (let $savemode1 i32 (i32.load (i32.const 676)))  ;; assignment-destructuring mode (leaf targets assign, not bind)
          (i32.store (i32.const 676) (i32.const 1))
          (call $vm_c_destructure_param (local.get $code) (local.get $tmp))
          (i32.store (i32.const 676) (local.get $savemode1))
          (call $cursor_restore (local.get $rs))   ;; skip past RHS
          (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $tmp))  ;; LOADVAR → value
          (return (i32.const 1))))
      (return (i32.const 0))))
  (if (i32.eq (call $tok_kind) (i32.const 17))  ;; '{' bare object pattern (expr position): {pat}=RHS (cover grammar)
    (then
      (let $ps i32 (call $cursor_save))
      (call $vm_skip_balanced)  ;; past matching '}'
      (let $isda i32 (i32.eq (call $tok_kind) (i32.const 24)))  ;; '=' follows?
      (call $cursor_restore (local.get $ps))  ;; rewind to '{'
      (if (local.get $isda)
        (then
          (let $ps2 i32 (call $cursor_save))   ;; at '{'
          (call $vm_skip_balanced)
          (call $next_token)  ;; consume '='
          (call $vm_c_expr (local.get $code))  ;; RHS → [val]
          (let $tmp i32 (call $vm_tmpname))
          (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $tmp))  ;; STOREVAR tmp
          (let $rs i32 (call $cursor_save))    ;; after RHS
          (call $cursor_restore (local.get $ps2))  ;; back to '{'
          (let $savemode3 i32 (i32.load (i32.const 676)))  ;; assignment-destructuring mode
          (i32.store (i32.const 676) (i32.const 1))
          (call $vm_c_destructure_param (local.get $code) (local.get $tmp))
          (i32.store (i32.const 676) (local.get $savemode3))
          (call $cursor_restore (local.get $rs))   ;; skip past RHS
          (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $tmp))  ;; LOADVAR → value
          (return (i32.const 1))))
      (return (i32.const 0))))
  (if (i32.eq (call $tok_kind) (i32.const 15))  ;; '(' — maybe ({pat} = RHS)
    (then
      (let $ps i32 (call $cursor_save))
      ;; arrow guard: ( ... ) => is an arrow param list, NOT a parenthesized
      ;; destructuring assignment — bail so the arrow path handles it.
      (call $vm_skip_balanced)  ;; past matching ')' (cursor is at '(')
      (let $isarr i32 (i32.eq (call $tok_kind) (i32.const 52)))  ;; '=>' follows?
      (call $cursor_restore (local.get $ps))
      (if (local.get $isarr) (then (return (i32.const 0))))
      (call $next_token)  ;; '('
      (if (i32.ne (call $tok_kind) (i32.const 17))  ;; inner must be '{'
        (then (call $cursor_restore (local.get $ps)) (return (i32.const 0))))
      (call $vm_skip_balanced)  ;; past matching '}'
      (let $isda i32 (i32.eq (call $tok_kind) (i32.const 24)))  ;; '=' follows?
      (call $cursor_restore (local.get $ps))  ;; rewind to '('
      (if (local.get $isda)
        (then
          (call $next_token)  ;; consume '('
          (let $ps2 i32 (call $cursor_save))   ;; at '{'
          (call $vm_skip_balanced)
          (call $next_token)  ;; consume '='
          (call $vm_c_expr (local.get $code))  ;; RHS → [val] (stops at ')')
          (let $tmp i32 (call $vm_tmpname))
          (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $tmp))  ;; STOREVAR tmp
          (let $rs i32 (call $cursor_save))    ;; at ')'
          (call $cursor_restore (local.get $ps2))  ;; back to '{'
          (let $savemode2 i32 (i32.load (i32.const 676)))  ;; assignment-destructuring mode
          (i32.store (i32.const 676) (i32.const 1))
          (call $vm_c_destructure_param (local.get $code) (local.get $tmp))
          (i32.store (i32.const 676) (local.get $savemode2))
          (call $cursor_restore (local.get $rs))   ;; back to ')'
          (call $next_token)  ;; consume ')'
          (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $tmp))  ;; LOADVAR → value
          (return (i32.const 1))))
      (return (i32.const 0))))
  (i32.const 0))

;; emit: fetch one element from iterator var $itnm (done flag var $dnm, scratch result var $rnm),
;; leaving the value (or undefined past end) on the stack. Implements IteratorStep+IteratorValue.
(func $vm_emit_iter_step (param $code i32) (param $itnm i32) (param $dnm i32) (param $rnm i32) (effects)
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $dnm))  ;; LOADVAR done
  (let $j1 i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))  ;; JMPF → not done
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef))  ;; already done → undefined
  (let $j2 i32 (call $vm_emit_jump (local.get $code) (i32.const 12)))  ;; JMP end
  (call $vm_patch (local.get $code) (local.get $j1))  ;; not done:
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_bool (i32.const 1))) (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $dnm))  ;; done=true (so a next()-throw leaves us "done" → no IteratorClose)
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $itnm))  ;; LOADVAR it
  (call $vm_emit_op (local.get $code) (i32.const 32))  ;; DUP
  (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (cstring "next"))  ;; GETPROP next
  (call $vm_emit_op (local.get $code) (i32.const 33)) (call $vm_emit_op (local.get $code) (i32.const 0))  ;; CALLM 0 → r
  (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $rnm))  ;; STOREVAR r
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $rnm))  ;; LOADVAR r
  (call $vm_emit_op (local.get $code) (i32.const 121))  ;; REQUIREITERRESULT: next() result must be an Object (else TypeError, not an OOB read of .done)
  (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (cstring "done"))  ;; GETPROP done
  (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $dnm))  ;; STOREVAR done
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $dnm))  ;; LOADVAR done
  (let $j3 i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))  ;; JMPF → have value
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef))  ;; done now → undefined
  (let $j4 i32 (call $vm_emit_jump (local.get $code) (i32.const 12)))  ;; JMP end
  (call $vm_patch (local.get $code) (local.get $j3))  ;; have value:
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $rnm))  ;; LOADVAR r
  (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (cstring "value"))  ;; GETPROP value
  (call $vm_patch (local.get $code) (local.get $j2))
  (call $vm_patch (local.get $code) (local.get $j4)))

;; emit: collect the iterator's remaining values into a fresh array (for ...rest), leaving it on the stack
(func $vm_emit_iter_rest (param $code i32) (param $itnm i32) (param $dnm i32) (param $rnm i32) (effects)
  (let $rtt i32 (call $vm_tmpname))
  (call $vm_emit_op (local.get $code) (i32.const 29)) (call $vm_emit_op (local.get $code) (i32.const 0))  ;; NEWARRAY 0
  (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $rtt))  ;; STOREVAR rest
  (let $top i32 (call $vm_emit_cursor))
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $dnm)) (call $vm_emit_op (local.get $code) (i32.const 23))  ;; LOADVAR done; NOT
  (let $jend i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))  ;; JMPF → end (done)
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_bool (i32.const 1))) (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $dnm))  ;; done=true before next() (next-throw → done)
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $itnm))  ;; LOADVAR it
  (call $vm_emit_op (local.get $code) (i32.const 32))  ;; DUP
  (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (cstring "next"))  ;; GETPROP next
  (call $vm_emit_op (local.get $code) (i32.const 33)) (call $vm_emit_op (local.get $code) (i32.const 0))  ;; CALLM 0
  (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $rnm))  ;; STOREVAR r
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $rnm))
  (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (cstring "done"))
  (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $dnm))  ;; done = r.done
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $dnm)) (call $vm_emit_op (local.get $code) (i32.const 23))  ;; LOADVAR done; NOT
  (let $jpush i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))  ;; JMPF → skip push (done now)
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $rtt))  ;; LOADVAR rest
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $rnm))
  (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (cstring "value"))  ;; r.value
  (call $vm_emit_op (local.get $code) (i32.const 52))  ;; APPEND → [rest]
  (call $vm_emit_op (local.get $code) (i32.const 11))  ;; POP
  (call $vm_patch (local.get $code) (local.get $jpush))
  (call $vm_emit_op (local.get $code) (i32.const 12)) (call $vm_emit_op (local.get $code) (local.get $top))  ;; JMP loop
  (call $vm_patch (local.get $code) (local.get $jend))
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $rtt)))  ;; leave rest array

;; member-target assignment in destructuring (assignment form): value is in @@dval,
;; base identifier ($base) already read, cursor at first '.'/'['. Navigate the member
;; chain, then assign @@dval to the final target (applying a trailing `= default`).
(func $vm_c_dstr_assign_member (param $code i32) (param $base i32) (effects)
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $base))  ;; LOADVAR base → [obj]
  (let $tkind i32 (i32.const 0))  ;; 0 = .prop (key in $tkey), 1 = [idx] (key on stack)
  (let $tkey i32 (i32.const 0))
  (block $te (loop $tl
    (if (i32.eq (call $tok_kind) (i32.const 23))  ;; '.'
      (then
        (call $next_token)
        (let $k i32 (call $ident_name)) (call $next_token)
        (if (i32.or (i32.eq (call $tok_kind) (i32.const 23)) (i32.eq (call $tok_kind) (i32.const 19)))
          (then (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (local.get $k)))  ;; GETPROP navigate
          (else (set! $tkind (i32.const 0)) (set! $tkey (local.get $k)) (br $te))))
      (else
        (call $next_token) (call $vm_c_expr (local.get $code)) (call $next_token)  ;; '[' expr ']' → [obj, key]
        (if (i32.or (i32.eq (call $tok_kind) (i32.const 23)) (i32.eq (call $tok_kind) (i32.const 19)))
          (then (call $vm_emit_op (local.get $code) (i32.const 31)))  ;; GETIDX navigate
          (else (set! $tkind (i32.const 1)) (br $te)))))
    (br $tl)))
  (if (i32.eq (call $tok_kind) (i32.const 24))  ;; trailing `= default`
    (then
      (call $next_token)
      (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (cstring "@@dval"))
      (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef)) (call $vm_emit_op (local.get $code) (i32.const 18))  ;; STRICTEQ
      (let $dsk i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))  ;; JMPF → present
      (call $vm_c_expr (local.get $code))
      (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (cstring "@@dval"))
      (call $vm_patch (local.get $code) (local.get $dsk))))
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (cstring "@@dval"))  ;; LOADVAR value
  (if (i32.eq (local.get $tkind) (i32.const 0))
    (then (call $vm_emit_op (local.get $code) (i32.const 34)) (call $vm_emit_op (local.get $code) (local.get $tkey)))  ;; SETPROP
    (else (call $vm_emit_op (local.get $code) (i32.const 35))))  ;; SETIDX
  (call $vm_emit_op (local.get $code) (i32.const 11)))  ;; POP result

;; store a destructuring LEAF identifier target. reg 676 distinguishes the form:
;; 3 = const lexical binding (`for (const [x] of …)`) → DEFCONST in the current (per-iteration) scope;
;; 2 = let/catch lexical binding → LEXDEFINIT in the current scope; 1 = assignment destructuring
;; (`[x]=…`) → assign up the chain (strict: ReferenceError if undeclared; sloppy: implicit global);
;; 0 = var binding (`var [x]=…`) → define-in-nearest-var-scope (DEFINIT).
(func $vm_emit_dstr_store (param $code i32) (param $name i32) (effects)
  (if (i32.eq (i32.load (i32.const 676)) (i32.const 3))
    (then (call $vm_emit_op (local.get $code) (i32.const 79)) (call $vm_emit_op (local.get $code) (local.get $name)))  ;; const lexical binding: DEFCONST (non-writable) in the current scope
  (else (if (i32.eq (i32.load (i32.const 676)) (i32.const 2))
    (then (call $vm_emit_op (local.get $code) (i32.const 114)) (call $vm_emit_op (local.get $code) (local.get $name)))  ;; lexical binding (catch param / let): LEXDEFINIT binds in the CURRENT (declarative) scope, not the var scope
    (else (if (i32.load (i32.const 676))
      (then (call $vm_emit_op (local.get $code) (if i32 (i32.load (i32.const 388)) (then (i32.const 80)) (else (i32.const 85)))) (call $vm_emit_op (local.get $code) (local.get $name)))
      (else (call $vm_emit_op (local.get $code) (i32.const 89)) (call $vm_emit_op (local.get $code) (local.get $name)))))))))  ;; declarator mode: DEFINIT binds via the nearest var scope

;; A destructuring leaf identifier may not be a reserved word: always-reserved (`{if}`, `[function]`)
;; in any mode, or eval/arguments/strict-reserved under strict mode. NOTE the caller must gate this on the
;; leaf NOT being a member-target base — in an assignment pattern `[this.x]=y` / `[eval.x]=y`, the base
;; (`this`/`super`/`eval`/…) is a valid reference, not a binding, so the reserved/strict checks must be
;; skipped (detected by a following '.'/'[' token). Returns 1 (and raises) on a violation.
(func $dstr_leaf_reserved (param $name i32) (result i32) (effects)
  (if (call $is_reserved_word (local.get $name))
    (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Unexpected reserved word in binding")) (return (i32.const 1))))
  (call $vm_strict_lhs_check (local.get $name)))

(func $vm_c_destructure_param (param $code i32) (param $srcTmp i32) (effects)
  (if (i32.eq (call $tok_kind) (i32.const 19))  ;; [ array pattern ] — via iterator protocol
    (then
      (call $next_token)  ;; consume [
      (let $itnm i32 (call $vm_tmpname))
      (let $dnm i32 (call $vm_tmpname))
      (let $rnm i32 (call $vm_tmpname))
      (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $srcTmp))  ;; LOADVAR src
      (call $vm_emit_op (local.get $code) (i32.const 45))  ;; GETITER
      (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $itnm))  ;; STOREVAR it
      (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_bool (i32.const 0)))  ;; PUSH false
      (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $dnm))  ;; STOREVAR done=false
      ;; handler around the bindings: on abrupt completion (binding/default throws), IteratorClose then re-throw
      (call $vm_emit_op (local.get $code) (i32.const 48))  ;; PUSHHANDLER
      (let $dhloc i32 (call $vm_emit_cursor)) (call $vm_emit_op (local.get $code) (i32.const 0))  ;; catchIp placeholder
      (call $vm_emit_op (local.get $code) (cstring "@@dexc"))
      (call $vm_emit_op (local.get $code) (i32.const 0))  ;; runOnReturn=0 (iterator-close, not a finally)
      (let $i i32 (i32.const 0))
      (block $ae (loop $al
        (br_if $ae (i32.eq (call $tok_kind) (i32.const 20)))  ;; ]
        (if (i32.eq (call $tok_kind) (i32.const 22))  ;; elision: advance the iterator, discard
          (then
            (call $vm_emit_iter_step (local.get $code) (local.get $itnm) (local.get $dnm) (local.get $rnm))
            (call $vm_emit_op (local.get $code) (i32.const 11))  ;; POP
            (set! $i (i32.add (local.get $i) (i32.const 1))) (call $next_token) (br $al)))
        (let $isrest i32 (i32.eq (call $tok_kind) (i32.const 54)))
        (if (local.get $isrest) (then (call $next_token)))
        ;; fetch the element value onto the stack (iterator protocol)
        (if (local.get $isrest)
          (then (call $vm_emit_iter_rest (local.get $code) (local.get $itnm) (local.get $dnm) (local.get $rnm)))  ;; ...rest → array of remaining
          (else (call $vm_emit_iter_step (local.get $code) (local.get $itnm) (local.get $dnm) (local.get $rnm))))  ;; next element
        ;; nested pattern target → store to a fresh temp, recurse
        (if (i32.or (i32.eq (call $tok_kind) (i32.const 19)) (i32.eq (call $tok_kind) (i32.const 17)))
          (then
            (let $nt i32 (call $vm_tmpname))
            (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $nt))  ;; STOREVAR nt
            (if (local.get $isrest)
              (then
                ;; a BindingRestElement may NOT carry a default initializer (`[...[x] = []]` is a SyntaxError)
                (let $rps i32 (call $cursor_save))
                (call $vm_skip_balanced)
                (if (i32.eq (call $tok_kind) (i32.const 24)) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "rest element may not have a default initializer")) (return)))
                (call $cursor_restore (local.get $rps))
                (call $vm_c_destructure_param (local.get $code) (local.get $nt)))
              (else (call $vm_c_nested_with_default (local.get $code) (local.get $nt)))))
          (else
            (let $nm i32 (call $ident_name)) (call $next_token)
            ;; an optional chain is never a valid assignment target: `[a?.b] = …` is a SyntaxError.
            (if (i32.eq (call $tok_kind) (i32.const 55))
              (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Optional chain is not a valid assignment target")) (return)))
            (if (i32.eqz (i32.or (i32.eq (call $tok_kind) (i32.const 23)) (i32.eq (call $tok_kind) (i32.const 19)))) (then (if (call $dstr_leaf_reserved (local.get $nm)) (then (return)))))  ;; reserved/strict array-element leaf (skip a member-target base; nested ifs — i32.and is not short-circuit)
            ;; a simple BindingRestElement (`...x`) also may not have a default (`[...x = 1]`)
            (if (i32.and (local.get $isrest) (i32.eq (call $tok_kind) (i32.const 24)))
              (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "rest element may not have a default initializer")) (return)))
            (if (i32.or (i32.eq (call $tok_kind) (i32.const 23)) (i32.eq (call $tok_kind) (i32.const 19)))  ;; member target a.b / a[i] (assignment form)
              (then (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (cstring "@@dval")) (call $vm_c_dstr_assign_member (local.get $code) (local.get $nm)))
              (else
            ;; element default (value === undefined ? default : value)
            (if (i32.and (i32.eqz (local.get $isrest)) (i32.eq (call $tok_kind) (i32.const 24)))
              (then
                (call $next_token)
                (call $vm_emit_op (local.get $code) (i32.const 32)) (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef)) (call $vm_emit_op (local.get $code) (i32.const 18))
                (let $sk i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))  ;; JMPF → value present
                (call $vm_emit_op (local.get $code) (i32.const 11))  ;; POP undefined
                (let $afs i32 (call $vm_emit_cursor))
                (call $vm_c_expr (local.get $code))  ;; default (assignment-level: stops at ',')
                (if (call $vm_is_anon_fn_def (local.get $afs))  ;; anon fn default → name = binding
                  (then (call $vm_emit_op (local.get $code) (i32.const 72)) (call $vm_emit_op (local.get $code) (local.get $nm))))
                (call $vm_patch (local.get $code) (local.get $sk))))
            (call $vm_emit_dstr_store (local.get $code) (local.get $nm))))))  ;; store array-element target (binding/assignment)
        (set! $i (i32.add (local.get $i) (i32.const 1)))
        ;; a BindingRestElement must be the LAST element: `[...x, y]` / `[...x,]` are SyntaxErrors.
        (if (local.get $isrest)
          (then
            (if (i32.eq (call $tok_kind) (i32.const 20)) (then (br $ae)))  ;; ']' → well-formed, rest is last
            (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "rest element must be last in a destructuring pattern")) (return)))
        (br_if $ae (i32.eqz (call $eat (i32.const 22))))
        (br $al)))
      (call $vm_emit_op (local.get $code) (i32.const 49))  ;; POPHANDLER (normal completion)
      ;; IteratorClose on normal completion if the iterator isn't done (no rest exhausted it)
      (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $dnm)) (call $vm_emit_op (local.get $code) (i32.const 23))  ;; LOADVAR done; NOT
      (let $cdj i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))  ;; JMPF → skip (done)
      (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $itnm))  ;; LOADVAR it
      (call $vm_emit_op (local.get $code) (i32.const 74))  ;; CLOSEITER
      (call $vm_patch (local.get $code) (local.get $cdj))
      (let $dskip i32 (call $vm_emit_jump (local.get $code) (i32.const 12)))  ;; JMP → past the throw handler
      ;; throw handler: close the iterator (unless done — a next()-throw doesn't close), re-throw original
      (i32.store (i32.add (local.get $code) (local.get $dhloc)) (call $vm_emit_cursor))  ;; catchIp = here
      (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $dnm)) (call $vm_emit_op (local.get $code) (i32.const 23))  ;; LOADVAR done; NOT
      (let $dnc i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))  ;; JMPF → skip close (done)
      (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $itnm))  ;; LOADVAR it
      (call $vm_emit_op (local.get $code) (i32.const 75))  ;; CLOSEITER-suppress
      (call $vm_patch (local.get $code) (local.get $dnc))
      (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (cstring "@@dexc"))  ;; LOADVAR @@dexc
      (call $vm_emit_op (local.get $code) (i32.const 47))  ;; THROW
      (call $vm_patch (local.get $code) (local.get $dskip))
      ;; the pattern must close with ']' here; a leftover token (`[a b]` — a missing comma between
      ;; elements) is a SyntaxError rather than being silently consumed as the closer.
      (if (i32.ne (call $tok_kind) (i32.const 20))
        (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Unexpected token in array destructuring pattern; expected ']'")) (return)))
      (call $next_token)))  ;; consume ]
  (if (i32.eq (call $tok_kind) (i32.const 17))  ;; { object pattern }
    (then
      (call $next_token)  ;; consume {
      ;; RequireObjectCoercible(src) — an object pattern (even empty `{}`) throws on null/undefined
      (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $srcTmp))  ;; LOADVAR src
      (call $vm_emit_op (local.get $code) (i32.const 92))  ;; REQUIRECOERCIBLE
      ;; runtime exclusion list for ...rest (so computed keys can be added too)
      (let $exclT i32 (call $vm_tmpname))
      (call $vm_emit_op (local.get $code) (i32.const 29)) (call $vm_emit_op (local.get $code) (i32.const 0))  ;; NEWARRAY 0
      (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $exclT))  ;; STOREVAR exclT
      (block $oe (loop $ol
        (br_if $oe (i32.eq (call $tok_kind) (i32.const 18)))  ;; }
        ;; a MethodDefinition is not a valid ObjectAssignmentPattern property: `{ *g(){} }` (generator),
        ;; `{ m(){} }`, `{ get x(){} }`, `{ set x(v){} }` are all SyntaxErrors (checked here + at the key below).
        (if (i32.eq (call $tok_kind) (i32.const 12))  ;; '*' → generator method
          (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "A method is not a valid destructuring pattern property")) (return)))
        (if (i32.eq (call $tok_kind) (i32.const 54))  ;; ...rest — bind remaining own enumerable props
          (then
            (call $next_token)
            (let $restnm i32 (call $ident_name)) (call $next_token)
            (if (i32.eqz (i32.or (i32.eq (call $tok_kind) (i32.const 23)) (i32.eq (call $tok_kind) (i32.const 19)))) (then (if (call $dstr_leaf_reserved (local.get $restnm)) (then (return)))))  ;; reserved/strict rest target (skip a member-target base)
            ;; a member target (...a.b / ...a[i]) — computing the rest object emits no tokens, so the
            ;; current token still marks the member navigation for vm_c_dstr_assign_member
            (let $restmem i32 (i32.or (i32.eq (call $tok_kind) (i32.const 23)) (i32.eq (call $tok_kind) (i32.const 19))))
            (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_native (i32.const 301) (cstring "")))  ;; PUSH objRest
            (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $srcTmp))  ;; LOADVAR src
            (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $exclT))  ;; LOADVAR exclT (runtime exclusion list)
            (call $vm_emit_op (local.get $code) (i32.const 19)) (call $vm_emit_op (local.get $code) (i32.const 2))  ;; CALL 2
            (if (local.get $restmem)
              (then (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (cstring "@@dval")) (call $vm_c_dstr_assign_member (local.get $code) (local.get $restnm)))  ;; ...a.b / ...a[i]
              (else (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $restnm))))  ;; STOREVAR rest (identifier)
            ;; a BindingRestProperty must be LAST and may not have a trailing comma: `{...a, b}` / `{...a,}` are SyntaxErrors.
            (if (i32.ne (call $tok_kind) (i32.const 18))
              (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "rest element must be last in an object pattern")) (return)))
            (br $oe)))
        ;; computed key:  { [keyExpr]: target [= default] }
        (if (i32.eq (call $tok_kind) (i32.const 19))  ;; '['
          (then
            (call $next_token)  ;; consume '['
            (call $vm_c_expr (local.get $code))  ;; keyExpr → [keyVal]
            (drop (call $eat (i32.const 20)))  ;; ']'
            (let $ckt i32 (call $vm_tmpname))
            (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $ckt))  ;; STOREVAR ckt
            ;; add the computed key to the ...rest exclusion list (objRest to_prop_key's it)
            (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $exclT))  ;; LOADVAR exclT
            (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $ckt))  ;; LOADVAR ckt
            (call $vm_emit_op (local.get $code) (i32.const 52)) (call $vm_emit_op (local.get $code) (i32.const 11))  ;; APPEND; POP
            (drop (call $eat (i32.const 37)))  ;; ':'
            (let $cnested i32 (i32.or (i32.eq (call $tok_kind) (i32.const 19)) (i32.eq (call $tok_kind) (i32.const 17))))
            (let $cbind i32 (i32.const 0))
            (if (i32.eqz (local.get $cnested)) (then (set! $cbind (call $ident_name)) (call $next_token) (if (i32.eqz (i32.or (i32.eq (call $tok_kind) (i32.const 23)) (i32.eq (call $tok_kind) (i32.const 19)))) (then (if (call $dstr_leaf_reserved (local.get $cbind)) (then (return)))))))  ;; reserved/strict computed-key leaf (skip a member-target base)
            ;; fetch src[keyVal]
            (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $srcTmp))  ;; LOADVAR src
            (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $ckt))  ;; LOADVAR ckt
            (call $vm_emit_op (local.get $code) (i32.const 31))  ;; GETIDX → [value]
            (if (local.get $cnested)
              (then
                (let $cont2 i32 (call $vm_tmpname))
                (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $cont2))
                (call $vm_c_nested_with_default (local.get $code) (local.get $cont2)))
              (else
                (if (i32.eq (call $tok_kind) (i32.const 24))  ;; = default
                  (then
                    (call $next_token)
                    (call $vm_emit_op (local.get $code) (i32.const 32)) (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef)) (call $vm_emit_op (local.get $code) (i32.const 18))
                    (let $csk i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))
                    (call $vm_emit_op (local.get $code) (i32.const 11))
                    (let $afs i32 (call $vm_emit_cursor))
                    (call $vm_c_expr (local.get $code))
                    (if (call $vm_is_anon_fn_def (local.get $afs))
                      (then (call $vm_emit_op (local.get $code) (i32.const 72)) (call $vm_emit_op (local.get $code) (local.get $cbind))))
                    (call $vm_patch (local.get $code) (local.get $csk))))
                (call $vm_emit_dstr_store (local.get $code) (local.get $cbind))))  ;; store computed-key target
            (br_if $oe (i32.eqz (call $eat (i32.const 22))))
            (br $ol)))
        (let $key i32 (call $ident_name))
        ;; a PrivateName may not be an object-pattern property key: `const {#x: y} = obj` is a SyntaxError.
        (if (i32.and (i32.eq (call $tok_kind) (i32.const 3)) (i32.eq (call $str_byte (local.get $key) (i32.const 0)) (i32.const 35)))
          (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Private names are not allowed in object destructuring patterns")) (return)))
        (call $next_token)
        ;; `{ m(){} }` — a '(' after the key is a MethodDefinition, not a valid pattern property.
        (if (i32.eq (call $tok_kind) (i32.const 15))
          (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "A method is not a valid destructuring pattern property")) (return)))
        ;; `{ get x(){} }` / `{ set x(v){} }` — a `get`/`set` key NOT followed by a valid property continuation
        ;; (`:` rename, `,`/`}` shorthand, `=` shorthand-default) is an accessor MethodDefinition → SyntaxError.
        (if (i32.and (i32.or (call $str_eq (local.get $key) (cstring "get")) (call $str_eq (local.get $key) (cstring "set")))
              (i32.eqz (i32.or (i32.eq (call $tok_kind) (i32.const 37)) (i32.or (i32.eq (call $tok_kind) (i32.const 22)) (i32.or (i32.eq (call $tok_kind) (i32.const 18)) (i32.eq (call $tok_kind) (i32.const 24)))))))
          (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "An accessor is not a valid destructuring pattern property")) (return)))
        (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $exclT))  ;; LOADVAR exclT
        (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_str (local.get $key)))  ;; PUSH key
        (call $vm_emit_op (local.get $code) (i32.const 52)) (call $vm_emit_op (local.get $code) (i32.const 11))  ;; APPEND; POP
        (let $bind i32 (local.get $key))
        (let $nested i32 (i32.const 0))
        (let $omem i32 (i32.const 0))  ;; member target (assignment form): key: o.y
        (if (i32.eq (call $tok_kind) (i32.const 37))  ;; key: target
          (then
            (call $next_token)
            (if (i32.or (i32.eq (call $tok_kind) (i32.const 19)) (i32.eq (call $tok_kind) (i32.const 17)))
              (then (set! $nested (i32.const 1)))
              (else (set! $bind (call $ident_name)) (call $next_token)
                    ;; an optional chain is never a valid assignment target: `{k: a?.b} = …` is a SyntaxError.
                    (if (i32.eq (call $tok_kind) (i32.const 55))
                      (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Optional chain is not a valid assignment target")) (return)))
                    (if (i32.eqz (i32.or (i32.eq (call $tok_kind) (i32.const 23)) (i32.eq (call $tok_kind) (i32.const 19)))) (then (if (call $dstr_leaf_reserved (local.get $bind)) (then (return)))))  ;; reserved/strict rename target (skip a member-target base)
                    (if (i32.or (i32.eq (call $tok_kind) (i32.const 23)) (i32.eq (call $tok_kind) (i32.const 19))) (then (set! $omem (i32.const 1))))))))
        ;; shorthand `{static}` (no `:`) binds the KEY itself → strict: eval/arguments/strict-reserved leaf
        (if (i32.and (i32.eqz (local.get $nested)) (i32.eqz (local.get $omem))) (then (if (call $dstr_leaf_reserved (local.get $bind)) (then (return)))))  ;; shorthand `{if}`/`{static}` binding (skip a `key: base.member` target)
        ;; fetch srcTmp[key]
        (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $srcTmp))
        (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (local.get $key))  ;; GETPROP key
        (if (local.get $nested)
          (then
            (let $ont i32 (call $vm_tmpname))
            (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $ont))
            (call $vm_c_nested_with_default (local.get $code) (local.get $ont)))
          (else (if (local.get $omem)
            (then  ;; member target: value → @@dval, navigate + assign
              (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (cstring "@@dval"))
              (call $vm_c_dstr_assign_member (local.get $code) (local.get $bind)))
            (else
            (if (i32.eq (call $tok_kind) (i32.const 24))  ;; = default
              (then
                (call $next_token)
                (call $vm_emit_op (local.get $code) (i32.const 32)) (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef)) (call $vm_emit_op (local.get $code) (i32.const 18))
                (let $osk i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))
                (call $vm_emit_op (local.get $code) (i32.const 11))
                (let $afs i32 (call $vm_emit_cursor))
                (call $vm_c_expr (local.get $code))
                (if (call $vm_is_anon_fn_def (local.get $afs))
                  (then (call $vm_emit_op (local.get $code) (i32.const 72)) (call $vm_emit_op (local.get $code) (local.get $bind))))
                (call $vm_patch (local.get $code) (local.get $osk))))
            (call $vm_emit_dstr_store (local.get $code) (local.get $bind))))))  ;; store object-prop target
        (br_if $oe (i32.eqz (call $eat (i32.const 22))))
        (br $ol)))
      ;; the pattern must close with '}' here; a leftover token (`{a b}` — a missing comma between
      ;; properties) is a SyntaxError rather than being silently consumed as the closer.
      (if (i32.ne (call $tok_kind) (i32.const 18))
        (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Unexpected token in object destructuring pattern; expected '}'")) (return)))
      (call $next_token))))  ;; consume }

;; function declaration/expression: cursor at 'function'. Returns name ptr (0 if anonymous).
(func $vm_c_function (param $code i32) (result i32) (effects)
  ;; fn source start = offset of 'function' (+1 sentinel) UNLESS a caller already set it (e.g. the
  ;; 'async' keyword position for `async function`), so the span includes any leading modifier.
  (if (i32.eqz (i32.load (i32.const 700))) (then (i32.store (i32.const 700) (i32.add (call $tok_start) (i32.const 1)))))
  (call $next_token)  ;; 'function'
  (if (i32.eq (call $tok_kind) (i32.const 12)) (then (i32.store (i32.const 236) (i32.const 1)) (call $next_token)))  ;; function*
  (let $fname i32 (i32.const 0))
  (if (i32.eq (call $tok_kind) (i32.const 3)) (then (set! $fname (call $ident_name)) (call $next_token)))  ;; optional name
  ;; a ReservedWord may not be a function name (`function if(){}`) — in any context (decl or expr).
  ;; (yield/await are contextual and excluded from $is_reserved_word, so they are not rejected here.)
  (if (local.get $fname)
    (then
      (if (call $is_reserved_word (local.get $fname)) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Unexpected reserved word as function name")) (return (i32.const 0))))
      ;; strict enclosing code: the BindingIdentifier may not be `eval`/`arguments` (`"use strict"; function eval(){}`)
      ;; nor a strict-reserved word (`function interface(){}` / `function static(){}`).
      (if (i32.and (i32.load (i32.const 388)) (i32.or (i32.or (call $str_eq (local.get $fname) (cstring "eval")) (call $str_eq (local.get $fname) (cstring "arguments"))) (call $is_strict_reserved (local.get $fname))))
        (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "invalid function name in strict mode")) (return (i32.const 0))))))
  ;; after the (optional) name, a function's ParameterList must open with '(' (`function f g(){}` /
  ;; `function f.g(){}` → SyntaxError). Anonymous expressions land here with tok already at '('.
  (if (i32.ne (call $tok_kind) (i32.const 15))
    (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Expected '(' in function definition")) (return (i32.const 0))))
  (call $vm_c_fnbody (local.get $code) (local.get $fname))
  (local.get $fname))

;; parse `( a, b = d, ...rest )` from cursor at '(' through ')'. Fills names into
;; $params and default-expr cursors (0 = none) into $pdef; the rest index → reg
;; 260 (-1 if none). Returns the parameter count. Shared by arrow functions.
;; Read-only scan of a param list `( … )` (cursor AT '('): returns 1 iff the list is NON-SIMPLE
;; (has a destructuring pattern / default / rest) AND its BoundNames contain a duplicate — a SyntaxError
;; (`function f([a,a]){}`, `function f({a,a}){}`, `function f([a],a){}`, `([a,a])=>`). Simple lists return
;; 0 here (a sloppy `function(a,a)` dup is legal; strict/arrow simple dups are caught elsewhere). Cursor
;; is restored. Distinguishes object-pattern keys/computed-keys/default-values from binding leaves.
(func $vm_param_dup_scan (result i32) (effects)
  (let $save i32 (call $cursor_save))
  (let $names i32 (call $heap_alloc (i32.const 4096)))
  (let $n i32 (i32.const 0))
  (let $nonsimple i32 (i32.const 0))
  (let $dup i32 (i32.const 0))
  (let $ctx i32 (call $heap_alloc (i32.const 256)))  ;; per-depth: 1 = object pattern, 0 = array/param-list
  (let $depth i32 (i32.const 0))
  (i32.store8 (local.get $ctx) (i32.const 0))  ;; top level = list
  (call $next_token)  ;; '('
  (block $done (loop $lp
    (let $k i32 (call $tok_kind))
    (br_if $done (i32.eqz (local.get $k)))  ;; EOF
    (if (i32.and (i32.eq (local.get $k) (i32.const 16)) (i32.eqz (local.get $depth))) (then (br $done)))  ;; ')' at depth 0
    (if (i32.eq (local.get $k) (i32.const 17))  ;; '{' → object pattern
      (then (set! $nonsimple (i32.const 1)) (set! $depth (i32.add (local.get $depth) (i32.const 1))) (if (i32.lt_s (local.get $depth) (i32.const 255)) (then (i32.store8 (i32.add (local.get $ctx) (local.get $depth)) (i32.const 1)))) (call $next_token) (br $lp)))
    (if (i32.eq (local.get $k) (i32.const 19))  ;; '['
      (then
        (if (i32.and (i32.lt_s (local.get $depth) (i32.const 255)) (i32.load8_u (i32.add (local.get $ctx) (local.get $depth))))
          (then (call $vm_skip_balanced) (br $lp))  ;; computed key inside an object pattern → skip its contents (references, not bindings)
          (else (set! $nonsimple (i32.const 1)) (set! $depth (i32.add (local.get $depth) (i32.const 1))) (if (i32.lt_s (local.get $depth) (i32.const 255)) (then (i32.store8 (i32.add (local.get $ctx) (local.get $depth)) (i32.const 0)))) (call $next_token) (br $lp)))))  ;; array pattern
    (if (i32.or (i32.eq (local.get $k) (i32.const 18)) (i32.eq (local.get $k) (i32.const 20)))  ;; '}' / ']'
      (then (if (i32.gt_s (local.get $depth) (i32.const 0)) (then (set! $depth (i32.sub (local.get $depth) (i32.const 1))))) (call $next_token) (br $lp)))
    (if (i32.eq (local.get $k) (i32.const 24))  ;; '=' default → skip the balanced default expression
      (then
        (set! $nonsimple (i32.const 1)) (call $next_token)
        (let $dd i32 (i32.const 0))
        (block $de (loop $dl
          (let $dk i32 (call $tok_kind))
          (br_if $de (i32.eqz (local.get $dk)))
          (if (i32.or (i32.eq (local.get $dk) (i32.const 15)) (i32.or (i32.eq (local.get $dk) (i32.const 17)) (i32.eq (local.get $dk) (i32.const 19)))) (then (set! $dd (i32.add (local.get $dd) (i32.const 1))) (call $next_token) (br $dl)))
          (if (i32.or (i32.eq (local.get $dk) (i32.const 16)) (i32.or (i32.eq (local.get $dk) (i32.const 18)) (i32.eq (local.get $dk) (i32.const 20))))
            (then (if (i32.eqz (local.get $dd)) (then (br $de)) (else (set! $dd (i32.sub (local.get $dd) (i32.const 1))) (call $next_token) (br $dl)))))  ;; closer at depth 0 = pattern's own closer, leave it
          (if (i32.and (i32.eq (local.get $dk) (i32.const 22)) (i32.eqz (local.get $dd))) (then (br $de)))  ;; ',' at depth 0 ends the default
          (call $next_token) (br $dl)))
        (br $lp)))
    (if (i32.eq (local.get $k) (i32.const 54)) (then (set! $nonsimple (i32.const 1)) (call $next_token) (br $lp)))  ;; '...' rest → next ident is a binding
    (if (i32.eq (local.get $k) (i32.const 3))  ;; identifier
      (then
        (let $nm i32 (call $ident_name)) (call $next_token)
        ;; object-pattern property key `IDENT :` → not a binding (the target follows the ':')
        (if (i32.and (i32.and (i32.lt_s (local.get $depth) (i32.const 255)) (i32.load8_u (i32.add (local.get $ctx) (local.get $depth)))) (i32.eq (call $tok_kind) (i32.const 37)))
          (then (call $next_token) (br $lp)))  ;; consume ':'
        ;; a binding leaf
        (if (call $dup_has (local.get $names) (local.get $n) (local.get $nm)) (then (set! $dup (i32.const 1)) (br $done)))
        (if (i32.lt_s (local.get $n) (i32.const 1024)) (then (i32.store (i32.add (local.get $names) (i32.mul (local.get $n) (i32.const 4))) (local.get $nm)) (set! $n (i32.add (local.get $n) (i32.const 1)))))
        (br $lp)))
    (call $next_token) (br $lp)))  ;; ',' or anything else
  (call $cursor_restore (local.get $save))
  (i32.and (local.get $dup) (local.get $nonsimple)))

(func $vm_c_paramlist (param $params i32) (param $pdef i32) (param $ppat i32) (result i32) (effects)
  ;; Early Error: a non-simple (or arrow) parameter list's BoundNames must be unique.
  (if (call $vm_param_dup_scan) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Duplicate parameter name not allowed in this context"))))
  (call $next_token)  ;; '('
  (i32.store (i32.const 260) (i32.const -1))  ;; restidx
  (let $np i32 (i32.const 0))
  (if (i32.ne (call $tok_kind) (i32.const 16))
    (then (block $pe (loop $pl
      (if (i32.eq (call $tok_kind) (i32.const 54)) (then (i32.store (i32.const 260) (local.get $np)) (call $next_token)))  ;; ...rest
      (i32.store (i32.add (local.get $ppat) (i32.mul (local.get $np) (i32.const 4))) (i32.const 0))
      (if (i32.or (i32.eq (call $tok_kind) (i32.const 19)) (i32.eq (call $tok_kind) (i32.const 17)))  ;; [ or { destructuring param
        (then
          (i32.store (i32.add (local.get $ppat) (i32.mul (local.get $np) (i32.const 4))) (call $cursor_save))
          (i32.store (i32.add (local.get $params) (i32.mul (local.get $np) (i32.const 4))) (call $vm_tmpname))
          (let $psd i32 (i32.const 0))
          (block $pske (loop $pskl
            (let $pk i32 (call $tok_kind))
            (br_if $pske (i32.eq (local.get $pk) (i32.const 0)))
            (if (i32.or (i32.eq (local.get $pk) (i32.const 19)) (i32.or (i32.eq (local.get $pk) (i32.const 17)) (i32.eq (local.get $pk) (i32.const 15)))) (then (set! $psd (i32.add (local.get $psd) (i32.const 1)))))
            (if (i32.or (i32.eq (local.get $pk) (i32.const 20)) (i32.or (i32.eq (local.get $pk) (i32.const 18)) (i32.eq (local.get $pk) (i32.const 16))))
              (then (set! $psd (i32.sub (local.get $psd) (i32.const 1))) (if (i32.eqz (local.get $psd)) (then (call $next_token) (br $pske)))))
            (call $next_token) (br $pskl))))
        (else
          (i32.store (i32.add (local.get $params) (i32.mul (local.get $np) (i32.const 4))) (call $ident_name))
          ;; a ReservedWord may not be a parameter name (`function f(if){}` / arrow / method params).
          (if (call $is_reserved_word (i32.load (i32.add (local.get $params) (i32.mul (local.get $np) (i32.const 4)))))
            (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Unexpected reserved word in binding")) (return (local.get $np))))
          (call $next_token)))
      (i32.store (i32.add (local.get $pdef) (i32.mul (local.get $np) (i32.const 4))) (i32.const 0))
      (if (i32.and (i32.eq (i32.load (i32.const 260)) (local.get $np)) (i32.eq (call $tok_kind) (i32.const 24)))  ;; rest param may not have a default
        (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "rest parameter may not have a default initializer")) (return (local.get $np))))
      (if (i32.eq (call $tok_kind) (i32.const 24))  ;; = default — record cursor, skip the expr
        (then
          (call $next_token)
          (i32.store (i32.add (local.get $pdef) (i32.mul (local.get $np) (i32.const 4))) (call $cursor_save))
          (let $dd i32 (i32.const 0))
          (block $dse (loop $dsl
            (let $dk i32 (call $tok_kind))
            (br_if $dse (i32.eq (local.get $dk) (i32.const 0)))
            (if (i32.or (i32.eq (local.get $dk) (i32.const 15)) (i32.or (i32.eq (local.get $dk) (i32.const 19)) (i32.eq (local.get $dk) (i32.const 17)))) (then (set! $dd (i32.add (local.get $dd) (i32.const 1)))))
            (if (i32.and (i32.eqz (local.get $dd)) (i32.eq (local.get $dk) (i32.const 16))) (then (br $dse)))
            (if (i32.or (i32.eq (local.get $dk) (i32.const 16)) (i32.or (i32.eq (local.get $dk) (i32.const 20)) (i32.eq (local.get $dk) (i32.const 18)))) (then (set! $dd (i32.sub (local.get $dd) (i32.const 1)))))
            (if (i32.and (i32.eqz (local.get $dd)) (i32.eq (local.get $dk) (i32.const 22))) (then (br $dse)))
            (call $next_token) (br $dsl)))))
      (if (i32.and (i32.eq (i32.load (i32.const 260)) (local.get $np)) (i32.eq (call $tok_kind) (i32.const 22)))  ;; rest param must be last
        (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "rest parameter must be last")) (return (local.get $np))))
      (set! $np (i32.add (local.get $np) (i32.const 1)))
      (br_if $pe (i32.eqz (call $eat (i32.const 22))))  ;; no comma → done
      (br_if $pe (i32.eq (call $tok_kind) (i32.const 16)))  ;; trailing comma before ')'
      (br $pl)))))
  (call $next_token)  ;; ')'
  (local.get $np))

;; arrow function: cursor at '=>'; params already collected ($params[$np], with
;; default cursors in $pdef [0=none], rest index $restidx [-1=none]). Emits the
;; default/rest prologue then the body (block → explicit return, expr → implicit).
(func $vm_c_arrow (param $code i32) (param $params i32) (param $np i32) (param $pdef i32) (param $restidx i32) (param $ppat i32) (effects)
  (let $arrsrcstart i32 (i32.load (i32.const 700)))  ;; source start sentinel (set by caller; 0=none)
  (i32.store (i32.const 700) (i32.const 0))
  ;; ArrowFormalParameters are UniqueFormalParameters: a duplicate parameter name is always a SyntaxError.
  (let $adi i32 (i32.const 0))
  (block $ade (loop $adl
    (br_if $ade (i32.ge_s (local.get $adi) (local.get $np)))
    (let $adn i32 (i32.load (i32.add (local.get $params) (i32.mul (local.get $adi) (i32.const 4)))))
    ;; a strict arrow's parameter may not be named `eval`/`arguments` (nor `yield`/`await` in the
    ;; respective contexts) — same BindingIdentifier restriction as ordinary function params.
    (if (call $vm_strict_lhs_check (local.get $adn)) (then (return)))
    (let $adj i32 (i32.add (local.get $adi) (i32.const 1)))
    (block $ade2 (loop $adl2
      (br_if $ade2 (i32.ge_s (local.get $adj) (local.get $np)))
      (if (call $str_eq (local.get $adn) (i32.load (i32.add (local.get $params) (i32.mul (local.get $adj) (i32.const 4)))))
        (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Duplicate parameter name not allowed")) (return)))
      (set! $adj (i32.add (local.get $adj) (i32.const 1))) (br $adl2)))
    (set! $adi (i32.add (local.get $adi) (i32.const 1))) (br $adl)))
  ;; capture the async flag (reg 232, consumed later at fn-struct build) and set reg 896 so `await` is the
  ;; operator inside an async arrow body/default-params. A non-async arrow inside an async fn keeps the
  ;; enclosing value (arrows inherit await-context) — but here we always overwrite: an async arrow → 1, and
  ;; a non-async arrow gets the enclosing 896 iff 232==0. So OR the enclosing value in for the non-async case.
  (let $arrasync i32 (i32.load (i32.const 232)))
  (i32.store (i32.const 232) (i32.const 0))  ;; clear now (before the body) so a nested fn/arrow doesn't inherit or consume our flag; our async-ness is held in $arrasync
  (let $arrsaveinasync i32 (i32.load (i32.const 896)))
  (i32.store (i32.const 896) (i32.or (local.get $arrasync) (local.get $arrsaveinasync)))
  (let $arrsavesb i32 (i32.load (i32.const 912)))  ;; an arrow body has its own return; not the static block itself
  (i32.store (i32.const 912) (i32.const 0))
  (let $arrsaveinfn i32 (i32.load (i32.const 920)))  ;; an arrow body allows `return`
  (i32.store (i32.const 920) (i32.const 1))
  ;; an arrow is a function boundary for break/continue/labels too (see vm_c_fnbody): isolate the loop
  ;; context and raise the label-find floor so `l: for(;;){ ()=>{ continue l; } }` is a SyntaxError, not a trap.
  (let $arrlblfloor i32 (i32.load (i32.const 932)))
  (let $arrlbldepth i32 (i32.load (i32.const 228)))
  (let $arrbrkl i32 (i32.load (i32.const 208))) (let $arrcontl i32 (i32.load (i32.const 216)))
  (let $arrcurlbl i32 (i32.load (i32.const 248))) (let $arrpendlbl i32 (i32.load (i32.const 244)))
  (let $arrlpfin i32 (i32.load (i32.const 360)))
  (i32.store (i32.const 932) (local.get $arrlbldepth))
  (i32.store (i32.const 208) (i32.const 0)) (i32.store (i32.const 216) (i32.const 0))
  (i32.store (i32.const 248) (i32.const 0)) (i32.store (i32.const 244) (i32.const 0)) (i32.store (i32.const 360) (i32.const 0))
  (call $next_token)  ;; '=>'
  (let $litstart i32 (call $vm_emit_cursor))  ;; arrow-literal emit span start (IsAnonymousFunctionDefinition)
  (let $pj i32 (call $vm_emit_jump (local.get $code) (i32.const 12)))  ;; JMP over body
  (let $entry i32 (call $vm_emit_cursor))
  (let $bodycur i32 (call $cursor_save))
  ;; default-parameter prologue: left-to-right TDZ initialization (see $vm_emit_default_params).
  ;; an arrow INHERITS the generator param `yield`-reservation (reg 960 bit0) — a nested `() => yield`
  ;; inside a generator's parameter default is still forbidden (arrows are never generators themselves).
  (if (call $vm_params_nonsimple (local.get $pdef) (local.get $ppat) (local.get $np) (local.get $restidx))
    (then (call $vm_emit_op (local.get $code) (i32.const 127))))  ;; MARKPARAMSCOPE (non-simple arrow params — see vm_c_fnbody)
  (if (local.get $pdef)
    (then (call $vm_emit_default_params (local.get $code) (local.get $params) (local.get $pdef) (local.get $ppat) (local.get $np) (local.get $restidx))))
  ;; rest-parameter prologue
  (if (i32.ge_s (local.get $restidx) (i32.const 0))
    (then
      (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (cstring "arguments"))
      (call $vm_emit_op (local.get $code) (i32.const 32))
      (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (cstring "slice"))
      (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $num (f64.convert_i32_s (local.get $restidx))))
      (call $vm_emit_op (local.get $code) (i32.const 33)) (call $vm_emit_op (local.get $code) (i32.const 1))
      (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (i32.load (i32.add (local.get $params) (i32.mul (local.get $restidx) (i32.const 4)))))))
  ;; destructuring-parameter prologue (ppat may be 0 for single-ident arrows)
  (if (local.get $ppat)
    (then
      (let $pti i32 (i32.const 0))
      (block $pte (loop $ptl
        (br_if $pte (i32.ge_s (local.get $pti) (local.get $np)))
        (if (i32.load (i32.add (local.get $ppat) (i32.mul (local.get $pti) (i32.const 4))))
          (then
            (call $cursor_restore (i32.load (i32.add (local.get $ppat) (i32.mul (local.get $pti) (i32.const 4)))))
            (call $vm_c_destructure_param (local.get $code) (i32.load (i32.add (local.get $params) (i32.mul (local.get $pti) (i32.const 4)))))))
        (set! $pti (i32.add (local.get $pti) (i32.const 1)))
        (br $ptl)))))
  (call $cursor_restore (local.get $bodycur))
  (let $arrsave i32 (i32.load (i32.const 388)))
  (let $arrstrict i32 (local.get $arrsave))  ;; inherited strictness (an arrow can also carry its own "use strict")
  (if (i32.eq (call $tok_kind) (i32.const 17))  ;; block body
    (then
      ;; Early Error: an arrow body's top-level lexical name may not duplicate a parameter (`(a)=>{ let a; }`).
      (call $vm_param_body_check (local.get $params) (local.get $np))
      (if (call $err) (then (return)))
      ;; scan the directive prologue for "use strict" (mirrors vm_c_fnbody)
      (let $arrbc i32 (call $cursor_save))
      (let $aownstrict i32 (i32.const 0))
      (call $next_token)  ;; '{'
      (block $ape (loop $apl
        (br_if $ape (i32.ne (call $tok_kind) (i32.const 2)))
        (let $aisus i32 (i32.and (i32.eq (call $tok_len) (i32.const 10)) (call $str_eq (call $decode_str (i32.add (call $src) (call $tok_start)) (call $tok_len)) (cstring "use strict"))))  ;; source text exactly `use strict`, no escapes/LC (see vm_c_fnbody)
        (call $next_token)
        (br_if $ape (i32.eqz (i32.or (call $nl_before)
          (i32.or (i32.eq (call $tok_kind) (i32.const 21)) (i32.or (i32.eq (call $tok_kind) (i32.const 18))
          (i32.or (i32.eq (call $tok_kind) (i32.const 0)) (i32.eq (call $tok_kind) (i32.const 2))))))))
        (if (local.get $aisus) (then (set! $arrstrict (i32.const 1)) (set! $aownstrict (i32.const 1))))
        (if (i32.eq (call $tok_kind) (i32.const 21)) (then (call $next_token)))
        (br $apl)))
      (call $cursor_restore (local.get $arrbc))
      ;; a non-simple arrow parameter list may not accompany a body "use strict" directive
      (if (local.get $aownstrict)
        (then
          (let $ansimple i32 (i32.ge_s (local.get $restidx) (i32.const 0)))
          (let $ansi i32 (i32.const 0))
          (block $anse (loop $ansl
            (br_if $anse (i32.ge_s (local.get $ansi) (local.get $np)))
            (if (i32.or (i32.and (i32.ne (local.get $pdef) (i32.const 0)) (i32.ne (i32.load (i32.add (local.get $pdef) (i32.mul (local.get $ansi) (i32.const 4)))) (i32.const 0)))
                        (i32.and (i32.ne (local.get $ppat) (i32.const 0)) (i32.ne (i32.load (i32.add (local.get $ppat) (i32.mul (local.get $ansi) (i32.const 4)))) (i32.const 0))))
              (then (set! $ansimple (i32.const 1)) (br $anse)))
            (set! $ansi (i32.add (local.get $ansi) (i32.const 1))) (br $ansl)))
          (if (local.get $ansimple) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Illegal 'use strict' directive in function with non-simple parameter list")) (return)))))
      (i32.store (i32.const 388) (local.get $arrstrict))
      ;; non-simple arrow param list → separate body variable environment (see vm_c_fnbody)
      (let $arns i32 (i32.ge_s (local.get $restidx) (i32.const 0)))
      (if (i32.eqz (local.get $arns))
        (then (let $arnsi i32 (i32.const 0))
          (block $arnse (loop $arnsl
            (br_if $arnse (i32.ge_s (local.get $arnsi) (local.get $np)))
            (if (i32.or (i32.and (i32.ne (local.get $pdef) (i32.const 0)) (i32.ne (i32.load (i32.add (local.get $pdef) (i32.mul (local.get $arnsi) (i32.const 4)))) (i32.const 0)))
                        (i32.and (i32.ne (local.get $ppat) (i32.const 0)) (i32.ne (i32.load (i32.add (local.get $ppat) (i32.mul (local.get $arnsi) (i32.const 4)))) (i32.const 0))))
              (then (set! $arns (i32.const 1)) (br $arnse)))
            (set! $arnsi (i32.add (local.get $arnsi) (i32.const 1))) (br $arnsl)))))
      (if (local.get $arns) (then (call $vm_emit_op (local.get $code) (i32.const 126))))  ;; ENTERVARSCOPE
      (call $vm_hoist_vars_p (local.get $code) (if i32 (local.get $arns) (then (local.get $params)) (else (i32.const 0))) (if i32 (local.get $arns) (then (local.get $np)) (else (i32.const 0))))  ;; hoist the arrow body's `var` decls (cursor is at the body '{')
      (call $vm_c_stmt (local.get $code))
      (i32.store (i32.const 388) (local.get $arrsave))  ;; restore strictness for the enclosing scope
      (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef))
      (call $vm_emit_op (local.get $code) (i32.const 20)))  ;; default RET undefined
    (else  ;; expression body → implicit return
      (call $vm_c_expr (local.get $code))
      (call $vm_emit_op (local.get $code) (i32.const 20))))  ;; RET value
  (i32.store (i32.const 896) (local.get $arrsaveinasync))  ;; restore enclosing in-async-body flag
  (i32.store (i32.const 912) (local.get $arrsavesb))  ;; restore in-static-block flag
  (i32.store (i32.const 920) (local.get $arrsaveinfn))  ;; restore in-function-body flag
  (i32.store (i32.const 932) (local.get $arrlblfloor))  ;; restore break/continue/label context
  (i32.store (i32.const 228) (local.get $arrlbldepth))
  (i32.store (i32.const 208) (local.get $arrbrkl)) (i32.store (i32.const 216) (local.get $arrcontl))
  (i32.store (i32.const 248) (local.get $arrcurlbl)) (i32.store (i32.const 244) (local.get $arrpendlbl))
  (i32.store (i32.const 360) (local.get $arrlpfin))
  (call $vm_patch (local.get $code) (local.get $pj))
  (let $fn i32 (call $heap_alloc (i32.add (i32.const 52) (i32.mul (local.get $np) (i32.const 4)))))  ;; @(28+np*4) name, @(32+np*4) flags, @(36+np*4) .length, @(40+np*4) srcPtr (0=native form), @(44+np*4) srcLen, @(48+np*4) own-prop scope
  (i32.store (local.get $fn) (if i32 (local.get $arrasync) (then (i32.const 1448232528)) (else (i32.const 1448232526))))  ;; ASYNC if flagged (captured before body — reg 232 may have been consumed by a nested closure), else NORMAL
  (i32.store (i32.const 232) (i32.const 0))  ;; keep reg 232 cleared for the enclosing scope
  (i32.store (i32.add (local.get $fn) (i32.const 4)) (local.get $entry))
  (i32.store (i32.add (local.get $fn) (i32.const 8)) (local.get $np))
  (i32.store (i32.add (local.get $fn) (i32.const 12)) (local.get $code))
  (i64.store (i32.add (local.get $fn) (i32.const 16)) (call $v_hole))
  (i32.store (i32.add (local.get $fn) (i32.const 24)) (i32.const 0))    ;; closureScope (filled at runtime by CLOSURE)
  (let $ci i32 (i32.const 0))
  (block $ce (loop $cl
    (br_if $ce (i32.ge_s (local.get $ci) (local.get $np)))
    (i32.store (i32.add (i32.add (local.get $fn) (i32.const 28)) (i32.mul (local.get $ci) (i32.const 4)))
               (i32.load (i32.add (local.get $params) (i32.mul (local.get $ci) (i32.const 4)))))
    (set! $ci (i32.add (local.get $ci) (i32.const 1)))
    (br $cl)))
  (i32.store (i32.add (i32.add (local.get $fn) (i32.const 28)) (i32.mul (local.get $np) (i32.const 4))) (i32.const 0))  ;; anonymous (.name "" until inferred)
  ;; flags: bit1 = arrow (always — `this` resolves lexically); bit0 = skip own
  ;; `arguments` (only when no rest param, since the rest prologue reads arguments.slice).
  (i32.store (i32.add (i32.add (local.get $fn) (i32.const 32)) (i32.mul (local.get $np) (i32.const 4)))
    (i32.or (i32.or (i32.const 2) (if i32 (i32.lt_s (local.get $restidx) (i32.const 0)) (then (i32.const 1)) (else (i32.const 0))))
            (if i32 (local.get $arrstrict) (then (i32.const 4)) (else (i32.const 0)))))  ;; bit2 strict
  ;; .length = ExpectedArgumentCount (params before the first default or the rest param)
  (let $explen i32 (local.get $np))
  (let $eli i32 (i32.const 0))
  (block $ele (loop $ell
    (br_if $ele (i32.ge_s (local.get $eli) (local.get $np)))
    ;; $pdef may be 0 (null, no defaults array — e.g. a parenless single-ident arrow `x => …`); guard the load,
    ;; else i32.load(0) reads garbage at memory[0] and wrongly clamps .length to 0.
    (if (i32.or (i32.and (i32.ne (local.get $pdef) (i32.const 0)) (i32.ne (i32.load (i32.add (local.get $pdef) (i32.mul (local.get $eli) (i32.const 4)))) (i32.const 0))) (i32.eq (local.get $eli) (local.get $restidx)))
      (then (set! $explen (local.get $eli)) (br $ele)))
    (set! $eli (i32.add (local.get $eli) (i32.const 1)))
    (br $ell)))
  (i32.store (i32.add (i32.add (local.get $fn) (i32.const 36)) (i32.mul (local.get $np) (i32.const 4))) (local.get $explen))
  ;; source span: caller-set start (sentinel) + end = last consumed token (mem 696)
  (if (local.get $arrsrcstart)
    (then
      (i32.store (i32.add (i32.add (local.get $fn) (i32.const 40)) (i32.mul (local.get $np) (i32.const 4))) (i32.add (i32.load (i32.const 4)) (i32.sub (local.get $arrsrcstart) (i32.const 1))))
      (i32.store (i32.add (i32.add (local.get $fn) (i32.const 44)) (i32.mul (local.get $np) (i32.const 4))) (i32.sub (i32.load (i32.const 696)) (i32.sub (local.get $arrsrcstart) (i32.const 1)))))
    (else (i32.store (i32.add (i32.add (local.get $fn) (i32.const 40)) (i32.mul (local.get $np) (i32.const 4))) (i32.const 0))))
  (call $vm_emit_op (local.get $code) (i32.const 61)) (call $vm_emit_op (local.get $code) (local.get $fn))  ;; CLOSURE (capture defining scope)
  (i32.store (i32.const 956) (i32.const 0))  ;; an ArrowFunction is not an assignment target (`() => {} = 1`)
  (i32.store (i32.const 680) (local.get $litstart)) (i32.store (i32.const 684) (call $vm_emit_cursor)))  ;; record arrow-literal span [680,684] for name-inference

;; class declaration/expression. Cursor at 'class'. Builds the prototype object,
;; the constructor, and methods (static members stored on the prototype for now).
;; isExpr=1 leaves the class value on the operand stack; isExpr=0 (declaration)
;; STOREVARs it under the class name.
;; Add a private element (name, kind 1=field/method 2=get 3=set, st=static) to the class-body private
;; set and enforce the ClassBody duplicate rule: a PrivateBoundIdentifier may not repeat UNLESS it is
;; exactly one getter + one setter with matching static-ness. Returns the new count, or -1 on a
;; SyntaxError. enc bits: 1=solid(field/method) 2=has-get 4=has-set 8=get-static 16=set-static.
(func $priv_dup_add (param $names i32) (param $encs i32) (param $n i32) (param $name i32) (param $kind i32) (param $st i32) (result i32) (effects)
  (let $i i32 (i32.const 0))
  (let $idx i32 (i32.const -1))
  (block $b (loop $l
    (br_if $b (i32.ge_s (local.get $i) (local.get $n)))
    (if (call $str_eq (i32.load (i32.add (local.get $names) (i32.mul (local.get $i) (i32.const 4)))) (local.get $name)) (then (set! $idx (local.get $i)) (br $b)))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
  (if (i32.lt_s (local.get $idx) (i32.const 0))
    (then
      (let $e i32 (if i32 (i32.eq (local.get $kind) (i32.const 1)) (then (i32.const 1))
                     (else (if i32 (i32.eq (local.get $kind) (i32.const 2)) (then (i32.or (i32.const 2) (i32.shl (local.get $st) (i32.const 3)))) (else (i32.or (i32.const 4) (i32.shl (local.get $st) (i32.const 4))))))))
      (if (i32.lt_s (local.get $n) (i32.const 1024)) (then (i32.store (i32.add (local.get $names) (i32.mul (local.get $n) (i32.const 4))) (local.get $name)) (i32.store (i32.add (local.get $encs) (i32.mul (local.get $n) (i32.const 4))) (local.get $e))))
      (return (i32.add (local.get $n) (i32.const 1)))))
  (let $e i32 (i32.load (i32.add (local.get $encs) (i32.mul (local.get $idx) (i32.const 4)))))
  (if (i32.and (local.get $e) (i32.const 1)) (then (return (i32.const -1))))  ;; existing solid → any duplicate errors
  (if (i32.eq (local.get $kind) (i32.const 1)) (then (return (i32.const -1))))  ;; new solid on an existing entry
  (if (i32.eq (local.get $kind) (i32.const 2))
    (then
      (if (i32.and (local.get $e) (i32.const 2)) (then (return (i32.const -1))))  ;; already a getter
      (if (i32.and (local.get $e) (i32.const 4)) (then (if (i32.ne (i32.and (i32.shr_u (local.get $e) (i32.const 4)) (i32.const 1)) (local.get $st)) (then (return (i32.const -1))))))
      (i32.store (i32.add (local.get $encs) (i32.mul (local.get $idx) (i32.const 4))) (i32.or (local.get $e) (i32.or (i32.const 2) (i32.shl (local.get $st) (i32.const 3)))))
      (return (local.get $n))))
  (if (i32.and (local.get $e) (i32.const 4)) (then (return (i32.const -1))))  ;; already a setter
  (if (i32.and (local.get $e) (i32.const 2)) (then (if (i32.ne (i32.and (i32.shr_u (local.get $e) (i32.const 3)) (i32.const 1)) (local.get $st)) (then (return (i32.const -1))))))
  (i32.store (i32.add (local.get $encs) (i32.mul (local.get $idx) (i32.const 4))) (i32.or (local.get $e) (i32.or (i32.const 4) (i32.shl (local.get $st) (i32.const 4)))))
  (local.get $n))

;; Early Error: the PrivateBoundIdentifiers of a ClassBody must have no duplicates (get/set pair excepted).
;; Token pre-scan from the first element (cursor just past the class-body '{') to the matching '}'. At the
;; class-body's own brace depth (0), a '#name' NOT preceded by '.' is an element key (a '.#x' access only
;; ever appears in a method body/field initializer, and a field-init access is '.'-prefixed). get/set/static
;; prefix flags are tracked and reset at each ';' and whenever a nested body/params close back to depth 0.
(func $vm_class_priv_dup_check (effects)
  (let $save i32 (call $cursor_save))
  (let $names i32 (call $heap_alloc (i32.const 4096)))
  (let $encs i32 (call $heap_alloc (i32.const 4096)))
  (let $n i32 (i32.const 0))
  (let $depth i32 (i32.const 0))
  (let $pstatic i32 (i32.const 0))
  (let $pget i32 (i32.const 0))
  (let $pset i32 (i32.const 0))
  (let $pgen i32 (i32.const 0))
  (let $pasync i32 (i32.const 0))
  (let $ctorcnt i32 (i32.const 0))
  (let $atkey i32 (i32.const 1))  ;; at a position where a ClassElement key is expected (element start / after a prefix)
  (let $infield i32 (i32.const 0))  ;; inside a field initializer expression ('=' seen, ';'/ASI not yet)
  (let $prev i32 (i32.const 0))
  (block $done (loop $lp
    (let $k i32 (call $tok_kind))
    (br_if $done (i32.eqz (local.get $k)))
    (if (i32.and (i32.eq (local.get $k) (i32.const 18)) (i32.eqz (local.get $depth))) (then (br $done)))  ;; the class body '}'
    (if (i32.or (i32.eq (local.get $k) (i32.const 15)) (i32.or (i32.eq (local.get $k) (i32.const 17)) (i32.eq (local.get $k) (i32.const 19))))
      (then (set! $depth (i32.add (local.get $depth) (i32.const 1))) (set! $prev (local.get $k)) (call $next_token) (br $lp)))
    (if (i32.or (i32.eq (local.get $k) (i32.const 16)) (i32.or (i32.eq (local.get $k) (i32.const 18)) (i32.eq (local.get $k) (i32.const 20))))
      (then (set! $depth (i32.sub (local.get $depth) (i32.const 1)))
        ;; a method body / static-block '}' closing to depth 0 ends the element — but NOT a '}' that closes
        ;; an object/block literal inside a field initializer (still mid-expression until ';'/ASI).
        (if (i32.and (i32.eqz (local.get $depth)) (i32.and (i32.eq (local.get $k) (i32.const 18)) (i32.eqz (local.get $infield))))
          (then (set! $pstatic (i32.const 0)) (set! $pget (i32.const 0)) (set! $pset (i32.const 0)) (set! $pgen (i32.const 0)) (set! $pasync (i32.const 0)) (set! $atkey (i32.const 1))))
        (set! $prev (local.get $k)) (call $next_token) (br $lp)))
    (if (i32.gt_s (local.get $depth) (i32.const 0)) (then (set! $prev (local.get $k)) (call $next_token) (br $lp)))
    ;; ASI: a newline in a field initializer, before an identifier that could begin a new element, ends it.
    (if (i32.and (local.get $infield) (i32.and (call $nl_before) (i32.eq (local.get $k) (i32.const 3))))
      (then (set! $infield (i32.const 0)) (set! $atkey (i32.const 1))))
    (if (i32.eq (local.get $k) (i32.const 21)) (then (set! $infield (i32.const 0)) (set! $pstatic (i32.const 0)) (set! $pget (i32.const 0)) (set! $pset (i32.const 0)) (set! $pgen (i32.const 0)) (set! $pasync (i32.const 0)) (set! $atkey (i32.const 1)) (set! $prev (local.get $k)) (call $next_token) (br $lp)))  ;; ';'
    (if (i32.eq (local.get $k) (i32.const 24)) (then (set! $atkey (i32.const 0)) (set! $infield (i32.const 1)) (set! $prev (local.get $k)) (call $next_token) (br $lp)))  ;; field '=' initializer (a default-param '=' is at depth>0)
    (if (i32.eq (local.get $k) (i32.const 12)) (then (if (local.get $atkey) (then (set! $pgen (i32.const 1)))) (set! $prev (local.get $k)) (call $next_token) (br $lp)))  ;; '*' generator method
    (if (i32.eq (local.get $k) (i32.const 3))
      (then
        (if (local.get $atkey)
          (then
            ;; a private element key (kind-3 token starting with '#')
            (if (i32.eq (call $str_byte (call $ident_name) (i32.const 0)) (i32.const 35))
              (then
                (if (call $str_eq (call $ident_name) (cstring "#constructor"))
                  (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Classes may not have a private field named #constructor")) (br $done)))
                (let $kind i32 (if i32 (local.get $pget) (then (i32.const 2)) (else (if i32 (local.get $pset) (then (i32.const 3)) (else (i32.const 1))))))
                (let $r i32 (call $priv_dup_add (local.get $names) (local.get $encs) (local.get $n) (call $ident_name) (local.get $kind) (local.get $pstatic)))
                (if (i32.lt_s (local.get $r) (i32.const 0)) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Duplicate private name")) (br $done)))
                (set! $n (local.get $r))
                (set! $pstatic (i32.const 0)) (set! $pget (i32.const 0)) (set! $pset (i32.const 0)) (set! $pgen (i32.const 0)) (set! $pasync (i32.const 0))
                ;; after the key: a method '(' or field '=' continues this element (atkey=0); anything else
                ;; means a bare field with no initializer whose element ends now → the next token is a new key.
                (call $look_save) (call $next_token) (let $pk1 i32 (call $tok_kind)) (let $pnl1 i32 (call $nl_before)) (call $look_restore)
                ;; a bare field followed on the SAME line by another identifier key needs a ';' separator.
                (if (i32.and (i32.eqz (i32.or (i32.eq (local.get $pk1) (i32.const 15)) (i32.eq (local.get $pk1) (i32.const 24)))) (i32.and (i32.eq (local.get $pk1) (i32.const 3)) (i32.eqz (local.get $pnl1))))
                  (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Unexpected identifier; expected ';' between class elements")) (br $done)))
                (set! $atkey (i32.eqz (i32.or (i32.eq (local.get $pk1) (i32.const 15)) (i32.eq (local.get $pk1) (i32.const 24)))))
                (set! $prev (local.get $k)) (call $next_token) (br $lp)))
            ;; prefix modifiers keep the key-expected position
            (if (call $tok_is_kw (cstring "static")) (then (set! $pstatic (i32.const 1)) (set! $prev (local.get $k)) (call $next_token) (br $lp)))
            (if (call $tok_is_kw (cstring "get")) (then (set! $pget (i32.const 1)) (set! $prev (local.get $k)) (call $next_token) (br $lp)))
            (if (call $tok_is_kw (cstring "set")) (then (set! $pset (i32.const 1)) (set! $prev (local.get $k)) (call $next_token) (br $lp)))
            (if (call $tok_is_kw (cstring "async")) (then (set! $pasync (i32.const 1)) (set! $prev (local.get $k)) (call $next_token) (br $lp)))
            (if (call $tok_is_kw (cstring "accessor")) (then (set! $prev (local.get $k)) (call $next_token) (br $lp)))  ;; auto-accessor modifier (keeps key-expected position)
            ;; a public plain-method `constructor` (no static/get/set/*/async) may occur at most once
            (if (i32.and (call $str_eq (call $ident_name) (cstring "constructor"))
                  (i32.eqz (i32.or (local.get $pstatic) (i32.or (local.get $pget) (i32.or (local.get $pset) (i32.or (local.get $pgen) (local.get $pasync)))))))
              (then
                (call $look_save) (call $next_token) (let $nk i32 (call $tok_kind)) (call $look_restore)
                (if (i32.eq (local.get $nk) (i32.const 15))  ;; followed by '(' → a constructor method
                  (then (set! $ctorcnt (i32.add (local.get $ctorcnt) (i32.const 1)))
                    (if (i32.ge_s (local.get $ctorcnt) (i32.const 2)) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "A class may only have one constructor")) (br $done)))))))
            ;; a non-static `constructor` may not be a getter/setter/generator/async method
            (if (i32.and (call $str_eq (call $ident_name) (cstring "constructor"))
                  (i32.and (i32.eqz (local.get $pstatic)) (i32.or (local.get $pget) (i32.or (local.get $pset) (i32.or (local.get $pgen) (local.get $pasync))))))
              (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Class constructor may not be an accessor, generator, or async method")) (br $done)))
            ;; a static class element may not be named `prototype`
            (if (i32.and (local.get $pstatic) (call $str_eq (call $ident_name) (cstring "prototype")))
              (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Classes may not have a static property named 'prototype'")) (br $done)))
            ;; any other identifier is a (public) key → a method '(' / field '=' continues the element,
            ;; else it is a bare field and the next token begins a new element.
            (call $look_save) (call $next_token) (let $pk2 i32 (call $tok_kind)) (let $pnl2 i32 (call $nl_before)) (call $look_restore)
            (if (i32.and (i32.eqz (i32.or (i32.eq (local.get $pk2) (i32.const 15)) (i32.eq (local.get $pk2) (i32.const 24)))) (i32.and (i32.eq (local.get $pk2) (i32.const 3)) (i32.eqz (local.get $pnl2))))
              (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Unexpected identifier; expected ';' between class elements")) (br $done)))
            (set! $atkey (i32.eqz (i32.or (i32.eq (local.get $pk2) (i32.const 15)) (i32.eq (local.get $pk2) (i32.const 24)))))
            (set! $prev (local.get $k)) (call $next_token) (br $lp)))
        (set! $prev (local.get $k)) (call $next_token) (br $lp)))
    (set! $atkey (i32.const 0)) (set! $prev (local.get $k)) (call $next_token) (br $lp)))
  ;; publish this class's declared private names into the global visible-set stack (reg 904 buffer /
  ;; reg 908 count) so the reference-validation pass and any nested class can see them. The caller
  ;; (vm_c_class) saved reg 908 before this call and restores it after the body → a scoped push.
  (if (i32.eqz (i32.load (i32.const 904))) (then (i32.store (i32.const 904) (call $heap_alloc (i32.const 32768)))))
  (let $gi i32 (i32.const 0))
  (block $ge (loop $gl
    (br_if $ge (i32.ge_s (local.get $gi) (local.get $n)))
    (let $gc i32 (i32.load (i32.const 908)))
    (if (i32.lt_s (local.get $gc) (i32.const 8192))
      (then (i32.store (i32.add (i32.load (i32.const 904)) (i32.mul (local.get $gc) (i32.const 4))) (i32.load (i32.add (local.get $names) (i32.mul (local.get $gi) (i32.const 4)))))
            (i32.store (i32.const 908) (i32.add (local.get $gc) (i32.const 1)))))
    (set! $gi (i32.add (local.get $gi) (i32.const 1))) (br $gl)))
  (call $cursor_restore (local.get $save)))

;; Skip one whole class from the cursor (positioned at the `class` keyword) — its optional name, its
;; heritage (which may itself contain nested `class {}` / `function(){}` bodies), and its balanced body.
;; Leaves the cursor just past the class body's closing '}'. Used by the private-name reference scans to
;; step over a nested class (validated by its own pass). `pend` counts heritage class/function bodies
;; still to consume before the real class body '{' at bracket-depth 0.
(func $skip_one_class (effects)
  (call $next_token)  ;; 'class'
  (let $sd i32 (i32.const 0))
  (let $pend i32 (i32.const 0))
  (block $cbe (loop $cbl
    (let $t i32 (call $tok_kind))
    (br_if $cbe (i32.eqz (local.get $t)))
    (if (i32.or (i32.eq (local.get $t) (i32.const 15)) (i32.eq (local.get $t) (i32.const 19))) (then (set! $sd (i32.add (local.get $sd) (i32.const 1)))))
    (if (i32.or (i32.eq (local.get $t) (i32.const 16)) (i32.eq (local.get $t) (i32.const 20))) (then (set! $sd (i32.sub (local.get $sd) (i32.const 1)))))
    (if (i32.and (i32.eqz (local.get $sd)) (i32.and (i32.eq (local.get $t) (i32.const 3)) (i32.or (call $tok_is_kw (cstring "class")) (call $tok_is_kw (cstring "function")))))
      (then (set! $pend (i32.add (local.get $pend) (i32.const 1))) (call $next_token) (br $cbl)))
    (if (i32.and (i32.eq (local.get $t) (i32.const 17)) (i32.eqz (local.get $sd)))
      (then
        (if (i32.gt_s (local.get $pend) (i32.const 0))
          (then  ;; a heritage class/function body — skip it balanced, keep looking for the real body
            (set! $pend (i32.sub (local.get $pend) (i32.const 1)))
            (let $b i32 (i32.const 1)) (call $next_token)
            (block $sbe (loop $sbl
              (let $u i32 (call $tok_kind))
              (br_if $sbe (i32.eqz (local.get $u)))
              (if (i32.eq (local.get $u) (i32.const 17)) (then (set! $b (i32.add (local.get $b) (i32.const 1)))))
              (if (i32.eq (local.get $u) (i32.const 18)) (then (set! $b (i32.sub (local.get $b) (i32.const 1))) (if (i32.eqz (local.get $b)) (then (call $next_token) (br $sbe)))))
              (call $next_token) (br $sbl)))
            (br $cbl))
          (else (call $next_token) (br $cbe)))))  ;; the real class body '{' — consume and go skip it
    (call $next_token) (br $cbl)))
  (let $bd i32 (i32.const 1))
  (block $bbe (loop $bbl
    (let $t i32 (call $tok_kind))
    (br_if $bbe (i32.eqz (local.get $t)))
    (if (i32.eq (local.get $t) (i32.const 17)) (then (set! $bd (i32.add (local.get $bd) (i32.const 1)))))
    (if (i32.eq (local.get $t) (i32.const 18)) (then (set! $bd (i32.sub (local.get $bd) (i32.const 1))) (if (i32.eqz (local.get $bd)) (then (call $next_token) (br $bbe)))))
    (call $next_token) (br $bbl))))

;; Early Error (AllPrivateIdentifiersValid): every '#name' reference in the class body must resolve to a
;; declared private name — of this class or an enclosing one (the global visible set, reg 904/908). Token
;; scan from the first element (cursor just past '{') to the matching '}'; nested class bodies are skipped
;; (their references are validated by their own pass against the accumulated set). A '#name' key is itself
;; in the set, so declarations pass trivially; only an undeclared reference fails. Cursor restored.
(func $vm_class_priv_ref_check (effects)
  (let $save i32 (call $cursor_save))
  (let $buf i32 (i32.load (i32.const 904)))
  (let $cnt i32 (i32.load (i32.const 908)))
  (let $depth i32 (i32.const 0))
  (block $done (loop $lp
    (let $k i32 (call $tok_kind))
    (br_if $done (i32.eqz (local.get $k)))
    (if (i32.and (i32.eq (local.get $k) (i32.const 18)) (i32.eqz (local.get $depth))) (then (br $done)))  ;; the class body '}'
    ;; a nested class → skip its whole body (its own ref pass validates it with the fuller set)
    (if (i32.and (i32.eq (local.get $k) (i32.const 3)) (call $tok_is_kw (cstring "class")))
      (then (call $skip_one_class) (br $lp)))
    (if (i32.or (i32.eq (local.get $k) (i32.const 15)) (i32.or (i32.eq (local.get $k) (i32.const 17)) (i32.eq (local.get $k) (i32.const 19))))
      (then (set! $depth (i32.add (local.get $depth) (i32.const 1))) (call $next_token) (br $lp)))
    (if (i32.or (i32.eq (local.get $k) (i32.const 16)) (i32.or (i32.eq (local.get $k) (i32.const 18)) (i32.eq (local.get $k) (i32.const 20))))
      (then (set! $depth (i32.sub (local.get $depth) (i32.const 1))) (call $next_token) (br $lp)))
    ;; a '#name' token (key or reference) must be in the visible set
    (if (i32.and (i32.eq (local.get $k) (i32.const 3)) (i32.eq (call $str_byte (call $ident_name) (i32.const 0)) (i32.const 35)))
      (then
        (if (i32.eqz (call $dup_has (local.get $buf) (local.get $cnt) (call $ident_name)))
          (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Private field must be declared in an enclosing class")) (br $done)))))
    (call $next_token) (br $lp)))
  (call $cursor_restore (local.get $save)))

;; Early Error: a '#name' reference that is NOT lexically inside a class body is always invalid (the
;; visible private-name set there is empty). Scan the whole program source, skipping every class body
;; (each is validated by its own per-class pass); any '#name' found outside → SyntaxError. Self-contained
;; lexer setup (the caller re-initialises the cursor afterwards for the hoist pass).
(func $vm_toplevel_priv_check (param $ptr i32) (param $len i32) (effects)
  (call $set_src (local.get $ptr) (local.get $len))
  (call $lex_init)
  (call $set_pos (call $hashbang_len))
  (call $next_token)
  (block $done (loop $lp
    (let $k i32 (call $tok_kind))
    (br_if $done (i32.eqz (local.get $k)))
    (if (i32.and (i32.eq (local.get $k) (i32.const 3)) (call $tok_is_kw (cstring "class")))
      (then (call $skip_one_class) (br $lp)))
    (if (i32.and (i32.eq (local.get $k) (i32.const 3)) (i32.eq (call $str_byte (call $ident_name) (i32.const 0)) (i32.const 35)))
      (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Private field must be declared in an enclosing class")) (br $done)))
    (call $next_token) (br $lp))))

(func $vm_c_class (param $code i32) (param $isExpr i32) (effects)
  (call $next_token)  ;; 'class'
  ;; a class definition (heritage + body: constructor, methods, accessors, field initializers,
  ;; static blocks) is ALWAYS strict-mode code. Force reg 388 = strict for the whole class so
  ;; every member's vm_c_fnbody inherits it; restore the enclosing strictness on exit.
  (let $clssave i32 (i32.load (i32.const 388)))
  (i32.store (i32.const 388) (i32.const 1))
  (let $clsname i32 (i32.const 0))  ;; optional (anonymous class expression)
  (if (i32.and (i32.eq (call $tok_kind) (i32.const 3)) (i32.eqz (call $tok_is_kw (cstring "extends"))))
    (then (set! $clsname (call $ident_name)) (call $next_token)))
  ;; a ReservedWord may not be a class name (`class if {}`) — in any context.
  (if (local.get $clsname) (then (if (call $is_reserved_word (local.get $clsname)) (then (i32.store (i32.const 388) (local.get $clssave)) (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Unexpected reserved word as class name")) (return)))))
  ;; a class definition is ALWAYS strict, so its BindingIdentifier may not be a strict-reserved word
  ;; (`class yield {}`, `class implements {}`, `class static {}`) nor eval/arguments.
  (if (local.get $clsname)
    (then (if (i32.or (call $is_strict_reserved (local.get $clsname)) (i32.or (call $str_eq (local.get $clsname) (cstring "eval")) (call $str_eq (local.get $clsname) (cstring "arguments"))))
      (then (i32.store (i32.const 388) (local.get $clssave)) (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Unexpected strict-mode reserved word as class name")) (return)))))
  ;; a ClassDeclaration (statement position, not an expression) requires a BindingIdentifier —
  ;; `class {}` / `class extends X {}` are only valid as ClassExpressions.
  (if (i32.and (i32.eqz (local.get $isExpr)) (i32.eqz (local.get $clsname)))
    (then (i32.store (i32.const 388) (local.get $clssave)) (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Class declaration must have a name")) (return)))
  (let $litstart i32 (call $vm_emit_cursor))  ;; class-literal emit span start (IsAnonymousFunctionDefinition)
  (let $protoT i32 (call $vm_tmpname))
  (let $ctorT i32 (call $vm_tmpname))
  (let $superT i32 (i32.const 0))
  ;; a NAMED class has an inner immutable binding of its own name, scoped to the class body, that
  ;; methods / static blocks / field initializers reference. Push the class scope BEFORE the ClassHeritage
  ;; and bind the name in TDZ (v_tdz) — the ClassHeritage is evaluated inside the class scope where the name
  ;; is uninitialized, so `class C extends C {}` (or a hoisted outer `C`) is a ReferenceError. The ctor is
  ;; assigned into it (initializing the TDZ) before static initializers run; the scope is popped after
  ;; (method/field closures keep it alive). Anonymous classes skip it.
  (if (local.get $clsname)
    (then (call $vm_emit_op (local.get $code) (i32.const 113)) (call $vm_emit_op (local.get $code) (local.get $clsname))  ;; ENTERSCOPE clsname
          (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_tdz))
          (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $clsname))))  ;; clsname = TDZ until the ctor is built
  (if (call $tok_is_kw (cstring "extends"))
    (then
      (call $next_token)
      (set! $superT (call $vm_tmpname))
      (i32.store (i32.const 984) (i32.const 1))  ;; ClassHeritage is a LeftHandSideExpression → reject a top-level arrow
      (call $vm_c_postfix (local.get $code))
      (i32.store (i32.const 984) (i32.const 0))
      (if (call $err) (then (i32.store (i32.const 388) (local.get $clssave)) (return)))
      (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $superT))))
  ;; a ClassTail requires a ClassBody `{ … }` (`class C extends X` / `class C extends {}` with no body → SyntaxError).
  (if (i32.ne (call $tok_kind) (i32.const 17)) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Expected '{' for class body")) (i32.store (i32.const 388) (local.get $clssave)) (return)))
  (call $next_token)  ;; '{'
  (let $privsave i32 (i32.load (i32.const 908)))  ;; visible-private-name stack depth to restore on class exit
  (call $vm_class_priv_dup_check)  ;; Early Error: duplicate PrivateBoundIdentifiers (also pushes this class's names)
  (if (call $err) (then (i32.store (i32.const 388) (local.get $clssave)) (i32.store (i32.const 908) (local.get $privsave)) (return)))
  (call $vm_class_priv_ref_check)  ;; Early Error: every '#name' reference resolves to a visible private name
  (if (call $err) (then (i32.store (i32.const 388) (local.get $clssave)) (i32.store (i32.const 908) (local.get $privsave)) (return)))
  (call $vm_emit_op (local.get $code) (i32.const 36)) (call $vm_emit_op (local.get $code) (i32.const 0))  ;; NEWOBJ 0 → empty proto
  (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $protoT))
  ;; reserve `constructor` as the FIRST own key of the prototype (spec: MakeConstructor defines
  ;; proto.constructor before ClassElementEvaluation adds the methods) — SETPROTO fills its value +
  ;; attributes later, updating this entry in place so getOwnPropertyNames lists it before the methods.
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $protoT))
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_str (cstring "constructor")))
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef))
  (call $vm_emit_op (local.get $code) (i32.const 101))  ;; DEFDATA_OWN → proto.constructor = undefined (placeholder)
  (call $vm_emit_op (local.get $code) (i32.const 11))   ;; POP proto
  ;; per-instance field initializers: a flat array [name1, thunk1, ...] stored on the
  ;; proto as @@fieldinits and replayed by NEW/NEWSPREAD onto each instance.
  (let $fieldsT i32 (call $vm_tmpname))
  (call $vm_emit_op (local.get $code) (i32.const 29)) (call $vm_emit_op (local.get $code) (i32.const 0))  ;; NEWARRAY 0 (instance fields)
  (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $fieldsT))
  (let $staticT i32 (call $vm_tmpname))
  (call $vm_emit_op (local.get $code) (i32.const 29)) (call $vm_emit_op (local.get $code) (i32.const 0))  ;; NEWARRAY 0 (static fields)
  (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $staticT))
  (let $hasstatic i32 (i32.const 0))  ;; any static FIELD seen? (only then emit APPLYSTATIC, so SETPROTO stays the last op for name inference)
  ;; static METHODS/accessors are deferred into this [kind,key,fn,...] triples array and
  ;; applied to the CONSTRUCTOR (not the prototype) after it is built — the ctor value isn't
  ;; available during the member loop (it may textually follow). kind: 0=method,1=get,2=set.
  (let $smethT i32 (call $vm_tmpname))
  (call $vm_emit_op (local.get $code) (i32.const 29)) (call $vm_emit_op (local.get $code) (i32.const 0))  ;; NEWARRAY 0 (static methods)
  (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $smethT))
  (let $hassmeth i32 (i32.const 0))  ;; any static METHOD/accessor seen? (only then emit APPLYSMETHS)
  (if (local.get $superT)
    (then
      (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $protoT))
      (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $superT))
      (call $vm_emit_op (local.get $code) (i32.const 57))  ;; EXTEND → [proto]
      (call $vm_emit_op (local.get $code) (i32.const 11))))
  (let $hasctor i32 (i32.const 0))
  (block $cme (loop $cml
    (br_if $cme (i32.eq (call $tok_kind) (i32.const 18)))  ;; '}'
    (br_if $cme (i32.eq (call $tok_kind) (i32.const 0)))
    (if (call $eat (i32.const 21)) (then (br $cml)))  ;; stray ';' between members
    ;; leading modifiers: `static`, then `async`, then `*` (generator). `async *` is an async
    ;; generator method; `async` alone is an async method (both parsed below).
    (let $isgen i32 (i32.const 0))
    (let $isasync i32 (i32.const 0))
    (let $isstatic i32 (i32.const 0))
    (let $memberstart i32 (i32.const 0))  ;; source start of the method definition (after `static`, incl. get/set/async/*)
    (if (call $str_eq (call $ident_name) (cstring "static"))  ;; `static` modifier (unless member named "static")
      (then
        (let $stc i32 (call $cursor_save))
        (call $next_token)
        (if (i32.or (i32.eq (call $tok_kind) (i32.const 15)) (i32.or (i32.eq (call $tok_kind) (i32.const 24)) (i32.or (i32.eq (call $tok_kind) (i32.const 18)) (i32.eq (call $tok_kind) (i32.const 21)))))  ;; `(` `=` `}` `;` after `static` → it's a member NAMED "static", not the modifier
          (then (call $cursor_restore (local.get $stc)))
          (else (set! $isstatic (i32.const 1))))))  ;; confirmed `static` modifier
    ;; static initialization block: `static { ... }` → append [@@staticblock, blockThunk] to staticT
    (if (i32.and (local.get $isstatic) (i32.eq (call $tok_kind) (i32.const 17)))
      (then
        (set! $hasstatic (i32.const 1))
        (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $staticT))  ;; LOADVAR staticT
        (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_str (cstring "@@staticblock")))  ;; PUSH sentinel name
        (call $vm_emit_op (local.get $code) (i32.const 52))  ;; APPEND name
        (call $vm_emit_block_thunk (local.get $code))  ;; → blockThunk on stack
        (call $vm_emit_op (local.get $code) (i32.const 52))  ;; APPEND thunk
