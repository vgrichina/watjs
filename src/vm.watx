    (if (i32.eq (local.get $op) (i32.const 87))  ;; DEFMETH_KEY — [obj, key, fn] → non-enum {W,C} method, infer name from key
      (then
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
        (let $mkfn i64 (i64.load (i32.add (local.get $stack) (local.get $sp))))
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
        (let $mkk i64 (i64.load (i32.add (local.get $stack) (local.get $sp))))
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
        (let $mkobj i64 (i64.load (i32.add (local.get $stack) (local.get $sp))))
        (call $vm_infer_name (local.get $mkfn) (local.get $mkk) (i32.const 0))
        (if (call $is_object (local.get $mkobj))
          (then (call $scope_define_attr (call $val_payload (local.get $mkobj)) (call $to_prop_key (local.get $mkk)) (local.get $mkfn) (i32.const 12))))  ;; W|C, non-enumerable
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 88))  ;; APPLYSTATIC — [ctor, staticArray] → run static field inits on the ctor (this=ctor)
      (then
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
        (let $asarr i64 (i64.load (i32.add (local.get $stack) (local.get $sp))))
        (let $asctor i64 (i64.load (i32.add (local.get $stack) (i32.sub (local.get $sp) (i32.const 8)))))  ;; left in place
        (call $vm_apply_fields (local.get $asctor) (local.get $asarr))
        (br $disp)))
    (if (i32.or (i32.eq (local.get $op) (i32.const 74)) (i32.eq (local.get $op) (i32.const 75)))  ;; CLOSEITER: 74 normal/break (IteratorClose) / 75 throw-completion (suppress return's own error)
      (then
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
        (let $itv i64 (i64.load (i32.add (local.get $stack) (local.get $sp))))
        (if (call $is_object (local.get $itv))
          (then
            (if (i32.eq (local.get $op) (i32.const 75))
              (then  ;; throw-completion: the original exception always wins — call return() but ignore its result/errors
                (let $cierr i32 (call $err))
                (let $retv75 i64 (call $get_prop (local.get $itv) (call $mk_str (cstring "return"))))
                (if (call $is_function (local.get $retv75))
                  (then (drop (call $call_val (local.get $retv75) (i32.const 0) (call $heap_alloc (i32.const 8)) (local.get $itv)))))
                (call $set_err (local.get $cierr)))
              (else  ;; normal/break completion: full IteratorClose
                (let $retv74 i64 (call $get_prop (local.get $itv) (call $mk_str (cstring "return"))))
                (if (call $err) (then (br $disp)))  ;; GetMethod threw (e.g. a getter) → propagate
                (if (i32.eqz (i32.or (call $is_undefined (local.get $retv74)) (call $is_null (local.get $retv74))))  ;; return present (not null/undefined)
                  (then
                    (if (i32.eqz (call $is_function (local.get $retv74)))  ;; present but not callable → TypeError (GetMethod)
                      (then (call $throw_type (cstring "TypeError") (cstring "iterator return is not a function")) (br $disp)))
                    (let $cres i64 (call $call_val (local.get $retv74) (i32.const 0) (call $heap_alloc (i32.const 8)) (local.get $itv)))
                    (if (call $err) (then (br $disp)))  ;; return() threw → propagate
                    (if (i32.eqz (i32.or (call $is_object (local.get $cres)) (i32.or (call $is_array (local.get $cres)) (call $is_function (local.get $cres)))))
                      (then (call $throw_type (cstring "TypeError") (cstring "iterator return() returned a non-object")) (br $disp)))))))))
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 35))  ;; SETIDX — [obj, key, val]
      (then
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
        (let $v i64 (i64.load (i32.add (local.get $stack) (local.get $sp))))
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
        (let $key i64 (i64.load (i32.add (local.get $stack) (local.get $sp))))
        (let $t i32 (i32.sub (local.get $sp) (i32.const 8)))
        (call $set_prop (i64.load (i32.add (local.get $stack) (local.get $t))) (local.get $key) (local.get $v))
        (i64.store (i32.add (local.get $stack) (local.get $t)) (local.get $v))
        (br $disp)))
    ;; object-literal property definers — [obj, key, val] → define on obj, leave [obj]
    (if (i32.or (i32.eq (local.get $op) (i32.const 65)) (i32.or (i32.eq (local.get $op) (i32.const 66)) (i32.eq (local.get $op) (i32.const 67))))  ;; DEFDATA/DEFGET/DEFSET
      (then
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
        (let $dv i64 (i64.load (i32.add (local.get $stack) (local.get $sp))))
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
        (let $dk i64 (i64.load (i32.add (local.get $stack) (local.get $sp))))
        (let $dobj i64 (i64.load (i32.add (local.get $stack) (i32.sub (local.get $sp) (i32.const 8)))))  ;; left in place
        ;; computed-key name inference (no-op for literal keys, already named)
        (call $vm_infer_name (local.get $dv) (local.get $dk)
          (if i32 (i32.eq (local.get $op) (i32.const 65)) (then (i32.const 0))
            (else (if i32 (i32.eq (local.get $op) (i32.const 66)) (then (cstring "get ")) (else (cstring "set "))))))
        (if (i32.eq (local.get $op) (i32.const 65))
          (then (call $set_prop (local.get $dobj) (local.get $dk) (local.get $dv)))                                  ;; DEFDATA
          (else (call $scope_set_accessor (call $val_payload (local.get $dobj)) (call $to_prop_key (local.get $dk)) (i32.eq (local.get $op) (i32.const 66)) (local.get $dv))))  ;; DEFGET(66)/DEFSET(67) — to_prop_key so a SYMBOL key → "@@sym:…" matches get/set_prop
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 36))  ;; NEWOBJ n (operand) — n (key,val) pairs on top
      (then
        (let $on i32 (i32.load (i32.add (local.get $code) (local.get $ip))))
        (set! $ip (i32.add (local.get $ip) (i32.const 4)))
        (let $obj i32 (call $obj_new (i32.add (local.get $on) (i32.const 2))))
        (let $base i32 (i32.sub (local.get $sp) (i32.mul (local.get $on) (i32.const 16))))  ;; each pair = 16 bytes
        (let $oi i32 (i32.const 0))
        (block $noe (loop $nol
          (br_if $noe (i32.ge_s (local.get $oi) (local.get $on)))
          (let $slot i32 (i32.add (local.get $base) (i32.mul (local.get $oi) (i32.const 16))))
          (call $scope_define (local.get $obj)
            (call $to_str (i64.load (i32.add (local.get $stack) (local.get $slot))))           ;; key
            (i64.load (i32.add (local.get $stack) (i32.add (local.get $slot) (i32.const 8)))))  ;; value
          (set! $oi (i32.add (local.get $oi) (i32.const 1)))
          (br $nol)))
        (set! $sp (local.get $base))
        (i64.store (i32.add (local.get $stack) (local.get $sp)) (call $mk_obj (local.get $obj)))
        (set! $sp (i32.add (local.get $sp) (i32.const 8)))
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 12))  ;; JMP (operand: target)
      (then (set! $ip (i32.load (i32.add (local.get $code) (local.get $ip)))) (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 13))  ;; JMPF (operand: target) — pops
      (then
        (let $tgt i32 (i32.load (i32.add (local.get $code) (local.get $ip))))
        (set! $ip (i32.add (local.get $ip) (i32.const 4)))
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
        (if (i32.eqz (call $truthy (i64.load (i32.add (local.get $stack) (local.get $sp))))) (then (set! $ip (local.get $tgt))))
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 27))  ;; JMPF_PEEK — jump if top falsy, keep it (for &&)
      (then
        (let $tgt i32 (i32.load (i32.add (local.get $code) (local.get $ip))))
        (set! $ip (i32.add (local.get $ip) (i32.const 4)))
        (if (i32.eqz (call $truthy (i64.load (i32.add (local.get $stack) (i32.sub (local.get $sp) (i32.const 8)))))) (then (set! $ip (local.get $tgt))))
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 28))  ;; JMPT_PEEK — jump if top truthy, keep it (for ||)
      (then
        (let $tgt i32 (i32.load (i32.add (local.get $code) (local.get $ip))))
        (set! $ip (i32.add (local.get $ip) (i32.const 4)))
        (if (call $truthy (i64.load (i32.add (local.get $stack) (i32.sub (local.get $sp) (i32.const 8))))) (then (set! $ip (local.get $tgt))))
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 68))  ;; JMP_NN — jump if top is NOT null/undefined, keep it (for ??)
      (then
        (let $tgt i32 (i32.load (i32.add (local.get $code) (local.get $ip))))
        (set! $ip (i32.add (local.get $ip) (i32.const 4)))
        (let $nv i64 (i64.load (i32.add (local.get $stack) (i32.sub (local.get $sp) (i32.const 8)))))
        (if (i32.eqz (i32.or (call $is_null (local.get $nv)) (call $is_undefined (local.get $nv)))) (then (set! $ip (local.get $tgt))))
        (br $disp)))
    (if (i32.or (i32.and (i32.ge_s (local.get $op) (i32.const 14)) (i32.le_s (local.get $op) (i32.const 18)))
                (i32.and (i32.ge_s (local.get $op) (i32.const 24)) (i32.le_s (local.get $op) (i32.const 26))))  ;; comparisons + eq/neq
      (then
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
        (let $cb i64 (i64.load (i32.add (local.get $stack) (local.get $sp))))
        (let $ca i64 (i64.load (i32.add (local.get $stack) (i32.sub (local.get $sp) (i32.const 8)))))
        (let $cr i32 (i32.const 0))
        ;; relational comparisons via js_less (returns 0 false / 1 true / 2 NaN).
        ;;  a<b: less(a,b)==1   a>b: less(b,a)==1
        ;;  a<=b: less(b,a)==0  a>=b: less(a,b)==0   (NaN ⇒ all four false)
        (if (i32.eq (local.get $op) (i32.const 14)) (then (set! $cr (i32.eq (call $js_less (local.get $ca) (local.get $cb)) (i32.const 1)))))
        (if (i32.eq (local.get $op) (i32.const 15)) (then (set! $cr (i32.eq (call $js_less (local.get $cb) (local.get $ca)) (i32.const 1)))))
        (if (i32.eq (local.get $op) (i32.const 16)) (then (set! $cr (i32.eq (call $js_less (local.get $cb) (local.get $ca)) (i32.const 0)))))
        (if (i32.eq (local.get $op) (i32.const 17)) (then (set! $cr (i32.eq (call $js_less (local.get $ca) (local.get $cb)) (i32.const 0)))))
        (if (i32.eq (local.get $op) (i32.const 18)) (then (set! $cr (call $strict_eq (local.get $ca) (local.get $cb)))))
        (if (i32.eq (local.get $op) (i32.const 24)) (then (set! $cr (i32.eqz (call $strict_eq (local.get $ca) (local.get $cb))))))  ;; !==
        (if (i32.eq (local.get $op) (i32.const 25)) (then (set! $cr (call $loose_eq (local.get $ca) (local.get $cb)))))           ;; ==
        (if (i32.eq (local.get $op) (i32.const 26)) (then (set! $cr (i32.eqz (call $loose_eq (local.get $ca) (local.get $cb))))))  ;; !=
        (i64.store (i32.add (local.get $stack) (i32.sub (local.get $sp) (i32.const 8))) (call $mk_bool (local.get $cr)))
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 44))  ;; BNOT (unary ~)
      (then
        (let $t i32 (i32.sub (local.get $sp) (i32.const 8)))
        (i64.store (i32.add (local.get $stack) (local.get $t))
                   (call $num (f64.convert_i32_s (i32.xor (call $to_int32 (i64.load (i32.add (local.get $stack) (local.get $t)))) (i32.const -1)))))
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 45))  ;; GETITER — replace top with its iterator
      (then
