  ;; A CoalesceExpression may NOT be combined with `||` or `&&` without parentheses
  ;; (`a ?? b || c`, `a || b ?? c`, `a && b ?? c` are SyntaxErrors).
  (let $npat i32 (call $heap_alloc (i32.const 256)))
  (let $nn i32 (i32.const 0))
  (block $ne (loop $nl
    (br_if $ne (i32.ne (call $tok_kind) (i32.const 56)))
    (if (i32.or (i32.gt_s (local.get $np) (i32.const 0)) (local.get $anyand))  ;; left mixed `||`/`&&` with `??`
      (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Cannot use '??' unparenthesized within '||'/'&&' expression")) (return)))
    (call $next_token)
    (i32.store (i32.add (local.get $npat) (i32.mul (local.get $nn) (i32.const 4))) (call $vm_emit_jump (local.get $code) (i32.const 68)))  ;; JMP_NN (keep non-nullish left)
    (set! $nn (i32.add (local.get $nn) (i32.const 1)))
    (call $vm_emit_op (local.get $code) (i32.const 11))  ;; POP nullish left
    (i32.store (i32.const 956) (i32.const 0))
    (call $vm_c_and (local.get $code))
    (if (i32.load (i32.const 944))  ;; the ?? operand used `&&` → `a ?? b && c`
      (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Cannot use '??' unparenthesized within '&&' expression")) (return)))
    (br $nl)))
