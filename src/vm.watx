                (if (i32.or (i32.eq (i32.load (i32.add (local.get $code) (i32.sub (call $vm_emit_cursor) (i32.const 8)))) (i32.const 61)) (i32.eq (i32.load (i32.add (local.get $code) (i32.sub (call $vm_emit_cursor) (i32.const 4)))) (i32.const 51)))
                  (then (call $vm_emit_op (local.get $code) (i32.const 72)) (call $vm_emit_op (local.get $code) (local.get $nm))))
                (call $vm_emit_op (local.get $code) (if i32 (local.get $isconst) (then (i32.const 79)) (else (i32.const 89)))) (call $vm_emit_op (local.get $code) (local.get $nm)))  ;; DEFCONST (const) / DEFINIT (var/let): define in the CURRENT scope
