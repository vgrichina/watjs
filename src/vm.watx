        (if (i32.or (i32.eq (local.get $nk) (i32.const 23)) (i32.eq (local.get $nk) (i32.const 19)))
          (then (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (local.get $key)) (br $l))  ;; GETPROP
          (else
            (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_str (local.get $key)))
            (call $vm_emit_op (local.get $code) (i32.const 70))  ;; DELETE
            (if (i32.load (i32.const 388)) (then (call $vm_emit_op (local.get $code) (i32.const 84))))  ;; strict: non-config delete → TypeError
            (br $e)))))
    (if (i32.eq (local.get $k) (i32.const 19))  ;; '[' index
      (then
