        (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (if i32 (local.get $isstatic) (then (local.get $staticT)) (else (local.get $fieldsT))))  ;; LOADVAR target array
        (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_str (local.get $mn)))  ;; PUSH name
        (call $vm_emit_op (local.get $code) (i32.const 52))  ;; APPEND name
        (if (i32.eq (call $tok_kind) (i32.const 24))  ;; = initializer
          (then (call $next_token) (call $vm_emit_field_thunk (local.get $code)))
          (else (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef))))  ;; no init → undefined sentinel
        (call $vm_emit_op (local.get $code) (i32.const 52))  ;; APPEND thunk/undef
        (call $vm_emit_op (local.get $code) (i32.const 11))  ;; POP array
        (drop (call $eat (i32.const 21))))  ;; optional ';'
      (else (if (call $str_eq (local.get $mn) (cstring "constructor"))
        (then
