          (return)))
      ;; a bare keyword-literal (`++this`, `++true`, `++null`) is not a valid target; a member on it
      ;; (`++this.x`) already took the member path above, so reaching here means it stands alone.
      (if (i32.or (call $str_eq (local.get $pvn) (cstring "this")) (i32.or (call $str_eq (local.get $pvn) (cstring "true")) (i32.or (call $str_eq (local.get $pvn) (cstring "false")) (call $str_eq (local.get $pvn) (cstring "null")))))
        (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Invalid operand for increment/decrement")) (return)))
      ;; bare identifier target — strict mode: `++eval` / `--arguments` targets eval/arguments (invalid).
      (if (call $vm_strict_lhs_check (local.get $pvn)) (then (return)))
      ;; Reference-record caching (see compound-assignment): resolve `pvn` ONCE; REFSET leaves the new value.
      (call $vm_emit_op (local.get $code) (i32.const 122)) (call $vm_emit_op (local.get $code) (local.get $pvn))  ;; RESOLVEREF → [ref]
      (call $vm_emit_op (local.get $code) (i32.const 123)) (call $vm_emit_op (local.get $code) (local.get $pvn))  ;; REFGET → [ref, val]
      (call $vm_emit_op (local.get $code) (i32.const 97))  ;; TONUMERIC (BigInt preserved) → [ref, old]
      (call $vm_emit_op (local.get $code) (local.get $pop))  ;; INC/DEC → [ref, new]
      (call $vm_emit_op (local.get $code) (i32.const 124)) (call $vm_emit_op (local.get $code) (local.get $pvn)) (call $vm_emit_op (local.get $code) (i32.load (i32.const 388)))  ;; REFSET → [new] (result)
      (i32.store (i32.const 956) (i32.const 0))  ;; an UpdateExpression (++x) is not an assignment target
      (return)))
  (if (i32.eq (local.get $k) (i32.const 11))  ;; -
    (then (call $next_token) (i32.store (i32.const 940) (i32.const 1)) (i32.store (i32.const 956) (i32.const 0)) (call $vm_c_unary (local.get $code)) (call $vm_emit_op (local.get $code) (i32.const 6)) (return)))
  (if (i32.eq (local.get $k) (i32.const 10))  ;; + (numeric coercion)
    (then (call $next_token) (i32.store (i32.const 940) (i32.const 1)) (i32.store (i32.const 956) (i32.const 0)) (call $vm_c_unary (local.get $code)) (call $vm_emit_op (local.get $code) (i32.const 63)) (return)))  ;; TONUM
  (if (i32.eq (local.get $k) (i32.const 33))  ;; !
    (then (call $next_token) (i32.store (i32.const 940) (i32.const 1)) (i32.store (i32.const 956) (i32.const 0)) (call $vm_c_unary (local.get $code)) (call $vm_emit_op (local.get $code) (i32.const 23)) (return)))
  (if (i32.eq (local.get $k) (i32.const 47))  ;; ~
    (then (call $next_token) (i32.store (i32.const 940) (i32.const 1)) (i32.store (i32.const 956) (i32.const 0)) (call $vm_c_unary (local.get $code)) (call $vm_emit_op (local.get $code) (i32.const 44)) (return)))
  (if (i32.and (i32.and (i32.eq (local.get $k) (i32.const 3)) (i32.load (i32.const 896))) (call $tok_is_kw (cstring "await")))  ;; await expr (only in an async body; else `await` is an identifier)
    (then
