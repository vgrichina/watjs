      (i32.or (i32.eq (local.get $k) (i32.const 31)) (i32.or (i32.eq (local.get $k) (i32.const 32))
      (i32.or (i32.eq (local.get $k) (i32.const 26)) (i32.or (i32.eq (local.get $k) (i32.const 28))
      (i32.or (i32.eq (local.get $k) (i32.const 25)) (i32.eq (local.get $k) (i32.const 27)))))))))))
