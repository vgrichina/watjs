          (call $vm_patch_conts (local.get $code) (call $vm_emit_cursor))
          ;; CreatePerIterationEnvironment (before the update): a `for (let i…, j…)` gets FRESH bindings each
          ;; iteration so body closures capture per-iteration values. Both normal fall-through and `continue`
          ;; reach here: snapshot all head names → pop the loop scope → push a fresh one → rebind; the update
          ;; then runs in (and mutates) the fresh scope. All-simple let/const heads (single or multi).
          (if (local.get $fdocopy)
