      ;; Emit the object, walk the access chain, and do read-modify-write on the LAST access.
      (if (i32.or (i32.eq (call $tok_kind) (i32.const 23)) (i32.eq (call $tok_kind) (i32.const 19)))  ;; '.' / '['
        (then
          (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $pvn))  ;; LOADVAR obj
          (block $pme (loop $pml
            (if (i32.eq (call $tok_kind) (i32.const 23))  ;; '.' key
              (then
                (call $next_token)
                (let $pk i32 (call $ident_name)) (call $next_token)
                (if (i32.or (i32.eq (call $tok_kind) (i32.const 23)) (i32.eq (call $tok_kind) (i32.const 19)))  ;; more chain → plain GETPROP
                  (then (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (local.get $pk)) (br $pml))
                  (else  ;; LAST access → RMW, result = new value
                    (call $vm_emit_op (local.get $code) (i32.const 32))  ;; DUP obj
                    (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (local.get $pk))  ;; GETPROP old
                    (call $vm_emit_op (local.get $code) (i32.const 97))  ;; TONUMERIC
                    (call $vm_emit_op (local.get $code) (local.get $pop))  ;; INC/DEC → new
                    (call $vm_emit_op (local.get $code) (if i32 (i32.load (i32.const 388)) (then (i32.const 82)) (else (i32.const 34)))) (call $vm_emit_op (local.get $code) (local.get $pk))  ;; SETPROP → [new]
                    (br $pme))))
