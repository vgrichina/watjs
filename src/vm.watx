            (br_if $pske (i32.eq (local.get $pk) (i32.const 0)))
            (if (i32.or (i32.eq (local.get $pk) (i32.const 19)) (i32.or (i32.eq (local.get $pk) (i32.const 17)) (i32.eq (local.get $pk) (i32.const 15)))) (then (set! $psd (i32.add (local.get $psd) (i32.const 1)))))
            (if (i32.or (i32.eq (local.get $pk) (i32.const 20)) (i32.or (i32.eq (local.get $pk) (i32.const 18)) (i32.eq (local.get $pk) (i32.const 16))))
