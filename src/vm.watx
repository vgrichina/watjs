                  (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "An accessor may not be a generator")) (return)))
                (if (i32.and (i32.or (call $str_eq (local.get $oki) (cstring "get")) (call $str_eq (local.get $oki) (cstring "set")))
                             (i32.or (i32.eq (call $tok_kind) (i32.const 3)) (i32.or (i32.eq (call $tok_kind) (i32.const 2)) (i32.or (i32.eq (call $tok_kind) (i32.const 1)) (i32.eq (call $tok_kind) (i32.const 19))))))  ;; get/set NAME(){} | get/set "str"/NUM | get/set [computed](){}
                  (then
