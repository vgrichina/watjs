        (i32.or (i32.eq (call $tok_kind) (i32.const 33)) (i32.or (i32.eq (call $tok_kind) (i32.const 47))   ;; ! ~
          (i32.or (i32.eq (call $tok_kind) (i32.const 10)) (i32.or (i32.eq (call $tok_kind) (i32.const 11))  ;; + -
            (i32.or (i32.eq (call $tok_kind) (i32.const 38)) (i32.eq (call $tok_kind) (i32.const 39))))))))  ;; ++ --
    (then
      (call $vm_c_unary (local.get $code))
      (call $vm_emit_op (local.get $code) (i32.const 11))  ;; POP value
      (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_bool (i32.const 1)))  ;; non-reference → true
      (return)))
  ;; bare identifier (a plain non-keyword identifier, no member access) → DELETEVAR
  (if (i32.and (i32.eq (call $tok_kind) (i32.const 3))
        (i32.eqz (i32.or (call $tok_is_kw (cstring "new")) (i32.or (call $tok_is_kw (cstring "function")) (i32.or (call $tok_is_kw (cstring "class"))
          (i32.or (call $tok_is_kw (cstring "this")) (i32.or (call $tok_is_kw (cstring "super")) (i32.or (call $tok_is_kw (cstring "true")) (i32.or (call $tok_is_kw (cstring "false")) (call $tok_is_kw (cstring "null")))))))))))
    (then
      (call $look_save)
      (let $din i32 (call $ident_name)) (call $next_token)
      (if (i32.eqz (i32.or (i32.eq (call $tok_kind) (i32.const 23)) (i32.eq (call $tok_kind) (i32.const 19))))  ;; not '.'/'[' → bare identifier delete
        (then (call $vm_emit_op (local.get $code) (i32.const 95)) (call $vm_emit_op (local.get $code) (local.get $din)) (return)))
