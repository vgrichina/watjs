                (if (i32.ne (call $tok_kind) (i32.const 16))
                  (then (block $oce (loop $ocl (call $vm_c_expr (local.get $code)) (set! $oca (i32.add (local.get $oca) (i32.const 1))) (br_if $oce (i32.eqz (call $eat (i32.const 22)))) (br $ocl)))))
                (call $next_token)
                (call $vm_emit_op (local.get $code) (i32.const 33)) (call $vm_emit_op (local.get $code) (local.get $oca)))  ;; CALLM
              (else (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (local.get $ock))))))))  ;; GETPROP (+2 close ?.( wrapper)
        (br $l)))
    (br $e)))
