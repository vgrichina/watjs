;; ═══════════════════════════════════════════════════════════════
;; vm.watx — Phase 2: bytecode/threaded virtual machine (foundation)
;;
;; The re-scan evaluator keeps a call's execution state on the WASM call
;; stack, so it can never be snapshotted — which is exactly why generators,
;; async/await, and tail-call optimization are impossible there.
;;
;; This VM reifies execution state in LINEAR MEMORY: an instruction pointer
;; into a compiled bytecode array, plus an explicit operand stack. Because
;; that state is data, a future YIELD opcode can save (ip, sp) and return,
;; and resume by restoring them — the prerequisite for generators/async.
;; Tail calls become frame elision once call frames live in memory too.
;;
;; Milestone 1: compile + run arithmetic, validating the dispatch loop and
;; the in-memory operand stack. The compiler reuses the existing lexer, so
;; there is one front-end (as the design intended). Threaded dispatch via
;; call_indirect / return_call_indirect is a later perf step; the
;; suspend/resume property comes from in-memory state, not the dispatch form.
;;
;; Opcodes (one i32 word each; PUSH is followed by an 8-byte i64 JSValue):
;;   0 HALT   1 PUSH   2 ADD   3 SUB   4 MUL   5 DIV   6 NEG
;; ═══════════════════════════════════════════════════════════════

;; emit cursor (byte offset into the code buffer under construction) — reg 200
(func $vm_emit_cursor (result i32) (effects) (i32.load (i32.const 200)))
(func $vm_set_emit_cursor (param $c i32) (effects) (i32.store (i32.const 200) (local.get $c)))

(func $vm_emit_op (param $code i32) (param $op i32) (effects)
  (i32.store (i32.add (local.get $code) (call $vm_emit_cursor)) (local.get $op))
  (call $vm_set_emit_cursor (i32.add (call $vm_emit_cursor) (i32.const 4))))

(func $vm_emit_val (param $code i32) (param $v i64) (effects)
  (i64.store (i32.add (local.get $code) (call $vm_emit_cursor)) (local.get $v))
  (call $vm_set_emit_cursor (i32.add (call $vm_emit_cursor) (i32.const 8))))

;; emit a jump op with a placeholder target; returns the patch location (byte offset)
(func $vm_emit_jump (param $code i32) (param $op i32) (result i32) (effects)
  (call $vm_emit_op (local.get $code) (local.get $op))
  (let $loc i32 (call $vm_emit_cursor))
  (call $vm_emit_op (local.get $code) (i32.const 0))  ;; placeholder
  (local.get $loc))
(func $vm_patch (param $code i32) (param $loc i32) (effects)  ;; patch placeholder to current cursor
  (i32.store (i32.add (local.get $code) (local.get $loc)) (call $vm_emit_cursor)))

;; loop-context for break/continue: reg 208 break-list ptr, 212 break count,
;; 216 continue-list ptr, 220 continue count. Saved/restored around each loop.
(func $vm_loop_enter (result i32) (effects)
  (let $save i32 (call $heap_alloc (i32.const 16)))
  (i32.store (local.get $save) (i32.load (i32.const 208)))
  (i32.store (i32.add (local.get $save) (i32.const 4)) (i32.load (i32.const 212)))
  (i32.store (i32.add (local.get $save) (i32.const 8)) (i32.load (i32.const 216)))
  (i32.store (i32.add (local.get $save) (i32.const 12)) (i32.load (i32.const 220)))
  (i32.store (i32.const 208) (call $heap_alloc (i32.const 1024))) (i32.store (i32.const 212) (i32.const 0))
  (i32.store (i32.const 216) (call $heap_alloc (i32.const 1024))) (i32.store (i32.const 220) (i32.const 0))
  (local.get $save))
(func $vm_loop_exit (param $save i32) (effects)
  (i32.store (i32.const 208) (i32.load (local.get $save)))
  (i32.store (i32.const 212) (i32.load (i32.add (local.get $save) (i32.const 4))))
  (i32.store (i32.const 216) (i32.load (i32.add (local.get $save) (i32.const 8))))
  (i32.store (i32.const 220) (i32.load (i32.add (local.get $save) (i32.const 12)))))
;; patch every jump recorded in (listreg, countreg) to point at $target
(func $vm_patch_list (param $listreg i32) (param $countreg i32) (param $code i32) (param $target i32) (effects)
  (let $list i32 (i32.load (local.get $listreg)))
  (let $n i32 (i32.load (local.get $countreg)))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    (i32.store (i32.add (local.get $code) (i32.load (i32.add (local.get $list) (i32.mul (local.get $i) (i32.const 4))))) (local.get $target))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l))))

;; ── compiler: source → bytecode (precedence-climbing, reuses the lexer) ──
(func $vm_c_primary (param $code i32) (effects)
  (if (i32.eq (call $tok_kind) (i32.const 1))  ;; NUM literal
    (then
      (call $vm_emit_op (local.get $code) (i32.const 1))      ;; PUSH
      (call $vm_emit_val (local.get $code) (call $num (call $tok_num)))
      (call $next_token)
      (return)))
  (if (i32.eq (call $tok_kind) (i32.const 2))  ;; string literal
    (then
      (call $vm_emit_op (local.get $code) (i32.const 1))      ;; PUSH
      (call $vm_emit_val (local.get $code) (call $mk_str (call $decode_str (i32.add (call $src) (call $tok_start)) (call $tok_len))))
      (call $next_token)
      (return)))
  (if (i32.eq (call $tok_kind) (i32.const 11))  ;; unary -
    (then
      (call $next_token)
      (call $vm_c_primary (local.get $code))
      (call $vm_emit_op (local.get $code) (i32.const 6))      ;; NEG
      (return)))
  (if (i32.eq (call $tok_kind) (i32.const 33))  ;; unary !
    (then
      (call $next_token)
      (call $vm_c_primary (local.get $code))
      (call $vm_emit_op (local.get $code) (i32.const 23))     ;; NOT
      (return)))
  (if (i32.eq (call $tok_kind) (i32.const 47))  ;; unary ~
    (then
      (call $next_token)
      (call $vm_c_primary (local.get $code))
      (call $vm_emit_op (local.get $code) (i32.const 44))     ;; BNOT
      (return)))
  (if (i32.eq (call $tok_kind) (i32.const 15))  ;; ( expr )
    (then
      (call $next_token)
      (call $vm_c_expr (local.get $code))
      (call $next_token)                                       ;; consume ')'
      (return)))
  (if (i32.eq (call $tok_kind) (i32.const 3))  ;; identifier / true / false / function-expression
    (then
      (if (call $tok_is_kw (cstring "function"))  ;; function expression → pushes the fn value
        (then (drop (call $vm_c_function (local.get $code))) (return)))
      (if (call $tok_is_kw (cstring "true"))
        (then (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_bool (i32.const 1))) (call $next_token) (return)))
      (if (call $tok_is_kw (cstring "false"))
        (then (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_bool (i32.const 0))) (call $next_token) (return)))
      (let $vn i32 (call $ident_name)) (call $next_token)
      (if (i32.or (i32.eq (call $tok_kind) (i32.const 38)) (i32.eq (call $tok_kind) (i32.const 39)))  ;; postfix i++ / i--
        (then
          (let $iop i32 (if i32 (i32.eq (call $tok_kind) (i32.const 38)) (then (i32.const 2)) (else (i32.const 3))))  ;; ADD/SUB
          (call $next_token)
          (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $vn))  ;; LOADVAR
          (call $vm_emit_op (local.get $code) (i32.const 32))  ;; DUP (old value)
          (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $num (f64.const 1)))
          (call $vm_emit_op (local.get $code) (local.get $iop))
          (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $vn))  ;; STOREVAR → leaves old
          (return)))
      (call $vm_emit_op (local.get $code) (i32.const 8))        ;; LOADVAR
      (call $vm_emit_op (local.get $code) (local.get $vn))
      (return)))
  (if (i32.eq (call $tok_kind) (i32.const 19))  ;; array literal [ ... ]
    (then
      (call $next_token)
      (let $n i32 (i32.const 0))
      (if (i32.ne (call $tok_kind) (i32.const 20))
        (then (block $ae (loop $al
          (call $vm_c_expr (local.get $code))
          (set! $n (i32.add (local.get $n) (i32.const 1)))
          (br_if $ae (i32.eqz (call $eat (i32.const 22))))
          (br $al)))))
      (call $next_token)  ;; ']'
      (call $vm_emit_op (local.get $code) (i32.const 29)) (call $vm_emit_op (local.get $code) (local.get $n))  ;; NEWARRAY n
      (return)))
  (if (i32.eq (call $tok_kind) (i32.const 17))  ;; object literal { k: v, ... }
    (then
      (call $next_token)
      (let $on i32 (i32.const 0))
      (if (i32.ne (call $tok_kind) (i32.const 18))
        (then (block $oe (loop $ol
          ;; key: identifier or string literal → push as a string
          (let $ok i32 (if i32 (i32.eq (call $tok_kind) (i32.const 2))
                          (then (call $decode_str (i32.add (call $src) (call $tok_start)) (call $tok_len)))
                          (else (call $ident_name))))
          (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_str (local.get $ok)))
          (call $next_token)
          (call $next_token)  ;; ':'
          (call $vm_c_expr (local.get $code))  ;; value
          (set! $on (i32.add (local.get $on) (i32.const 1)))
          (br_if $oe (i32.eqz (call $eat (i32.const 22))))
          (br $ol)))))
      (call $next_token)  ;; '}'
      (call $vm_emit_op (local.get $code) (i32.const 36)) (call $vm_emit_op (local.get $code) (local.get $on))  ;; NEWOBJ n (key,val pairs)
      (return))))

;; postfix: primary followed by  (args) | [index] | .member  (chainable)
(func $vm_c_postfix (param $code i32) (effects)
  (call $vm_c_primary (local.get $code))
  (block $e (loop $l
    (let $k i32 (call $tok_kind))
    (if (i32.eq (local.get $k) (i32.const 15))  ;; '(' call
      (then
        (call $next_token)
        (let $argc i32 (i32.const 0))
        (if (i32.ne (call $tok_kind) (i32.const 16))
          (then (block $ce (loop $cl
            (call $vm_c_expr (local.get $code))
            (set! $argc (i32.add (local.get $argc) (i32.const 1)))
            (br_if $ce (i32.eqz (call $eat (i32.const 22))))
            (br $cl)))))
        (call $next_token)  ;; ')'
        (call $vm_emit_op (local.get $code) (i32.const 19)) (call $vm_emit_op (local.get $code) (local.get $argc))  ;; CALL
        (br $l)))
    (if (i32.eq (local.get $k) (i32.const 19))  ;; '[' index
      (then
        (call $next_token)
        (call $vm_c_expr (local.get $code))
        (call $next_token)  ;; ']'
        (if (i32.eq (call $tok_kind) (i32.const 24))  ;; arr[i] = v
          (then
            (call $next_token)
            (call $vm_c_expr (local.get $code))
            (call $vm_emit_op (local.get $code) (i32.const 35))  ;; SETIDX
            (br $e)))
        (call $vm_emit_op (local.get $code) (i32.const 31))  ;; GETIDX
        (br $l)))
    (if (i32.eq (local.get $k) (i32.const 23))  ;; '.' member
      (then
        (call $next_token)
        (let $key i32 (call $ident_name)) (call $next_token)
        (if (i32.eq (call $tok_kind) (i32.const 24))  ;; obj.key = v
          (then
            (call $next_token)
            (call $vm_c_expr (local.get $code))
            (call $vm_emit_op (local.get $code) (i32.const 34)) (call $vm_emit_op (local.get $code) (local.get $key))  ;; SETPROP
            (br $e)))
        (if (i32.eq (call $tok_kind) (i32.const 15))  ;; method call: obj.key(args)
          (then
            (call $vm_emit_op (local.get $code) (i32.const 32))                                      ;; DUP receiver
            (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (local.get $key))  ;; GETPROP → [obj, method]
            (call $next_token)  ;; '('
            (let $margc i32 (i32.const 0))
            (if (i32.ne (call $tok_kind) (i32.const 16))
              (then (block $me (loop $ml
                (call $vm_c_expr (local.get $code))
                (set! $margc (i32.add (local.get $margc) (i32.const 1)))
                (br_if $me (i32.eqz (call $eat (i32.const 22))))
                (br $ml)))))
            (call $next_token)  ;; ')'
            (call $vm_emit_op (local.get $code) (i32.const 33)) (call $vm_emit_op (local.get $code) (local.get $margc)))  ;; CALLM
          (else
            (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (local.get $key))))  ;; GETPROP
        (br $l)))
    (br $e))))

;; ** exponentiation (right-assoc, binds tighter than * / %)
(func $vm_c_pow (param $code i32) (effects)
  (call $vm_c_postfix (local.get $code))
  (if (i32.eq (call $tok_kind) (i32.const 51))  ;; **
    (then
      (call $next_token)
      (call $vm_c_pow (local.get $code))  ;; right-associative
      (call $vm_emit_op (local.get $code) (i32.const 43)))))  ;; POW

(func $vm_c_mul (param $code i32) (effects)
  (call $vm_c_pow (local.get $code))
  (block $e (loop $l
    (let $k i32 (call $tok_kind))
    (br_if $e (i32.eqz (i32.or (i32.eq (local.get $k) (i32.const 12)) (i32.or (i32.eq (local.get $k) (i32.const 13)) (i32.eq (local.get $k) (i32.const 14))))))
    (call $next_token)
    (call $vm_c_pow (local.get $code))
    (call $vm_emit_op (local.get $code)
      (if i32 (i32.eq (local.get $k) (i32.const 12)) (then (i32.const 4))
      (else (if i32 (i32.eq (local.get $k) (i32.const 13)) (then (i32.const 5)) (else (i32.const 22))))))  ;; * / %
    (br $l))))

(func $vm_c_add (param $code i32) (effects)
  (call $vm_c_mul (local.get $code))
  (block $e (loop $l
    (let $k i32 (call $tok_kind))
    (br_if $e (i32.eqz (i32.or (i32.eq (local.get $k) (i32.const 10)) (i32.eq (local.get $k) (i32.const 11)))))
    (call $next_token)
    (call $vm_c_mul (local.get $code))
    (call $vm_emit_op (local.get $code) (if i32 (i32.eq (local.get $k) (i32.const 10)) (then (i32.const 2)) (else (i32.const 3))))
    (br $l))))

;; bit shifts:  << 48  >> 49  >>> 50  → opcodes 40..42 (between additive and relational)
(func $vm_c_shift (param $code i32) (effects)
  (call $vm_c_add (local.get $code))
  (block $e (loop $l
    (let $k i32 (call $tok_kind))
    (br_if $e (i32.eqz (i32.or (i32.eq (local.get $k) (i32.const 48)) (i32.or (i32.eq (local.get $k) (i32.const 49)) (i32.eq (local.get $k) (i32.const 50))))))
    (call $next_token)
    (call $vm_c_add (local.get $code))
    (call $vm_emit_op (local.get $code)
      (if i32 (i32.eq (local.get $k) (i32.const 48)) (then (i32.const 40))
      (else (if i32 (i32.eq (local.get $k) (i32.const 49)) (then (i32.const 41)) (else (i32.const 42))))))
    (br $l))))

;; relational / equality:  < 29  > 30  <= 31  >= 32  === 26  → opcodes 14..18
(func $vm_c_cmp (param $code i32) (effects)
  (call $vm_c_shift (local.get $code))
  (block $e (loop $l
    (let $k i32 (call $tok_kind))
    ;; < 29 > 30 <= 31 >= 32 === 26 !== 28 == 25 != 27
    (br_if $e (i32.eqz (i32.or (i32.eq (local.get $k) (i32.const 29)) (i32.or (i32.eq (local.get $k) (i32.const 30))
      (i32.or (i32.eq (local.get $k) (i32.const 31)) (i32.or (i32.eq (local.get $k) (i32.const 32))
      (i32.or (i32.eq (local.get $k) (i32.const 26)) (i32.or (i32.eq (local.get $k) (i32.const 28))
      (i32.or (i32.eq (local.get $k) (i32.const 25)) (i32.eq (local.get $k) (i32.const 27)))))))))))
    (call $next_token)
    (call $vm_c_shift (local.get $code))
    (call $vm_emit_op (local.get $code)
      (if i32 (i32.eq (local.get $k) (i32.const 29)) (then (i32.const 14))
      (else (if i32 (i32.eq (local.get $k) (i32.const 30)) (then (i32.const 15))
      (else (if i32 (i32.eq (local.get $k) (i32.const 31)) (then (i32.const 16))
      (else (if i32 (i32.eq (local.get $k) (i32.const 32)) (then (i32.const 17))
      (else (if i32 (i32.eq (local.get $k) (i32.const 26)) (then (i32.const 18))
      (else (if i32 (i32.eq (local.get $k) (i32.const 28)) (then (i32.const 24))
      (else (if i32 (i32.eq (local.get $k) (i32.const 25)) (then (i32.const 25)) (else (i32.const 26))))))))))))))))
    (br $l))))

;; bitwise &  ^  |  (between equality and logical-and; & tightest, | loosest)
(func $vm_c_bitand (param $code i32) (effects)
  (call $vm_c_cmp (local.get $code))
  (block $e (loop $l
    (br_if $e (i32.ne (call $tok_kind) (i32.const 44)))  ;; &
    (call $next_token) (call $vm_c_cmp (local.get $code))
    (call $vm_emit_op (local.get $code) (i32.const 37))  ;; BAND
    (br $l))))
(func $vm_c_bitxor (param $code i32) (effects)
  (call $vm_c_bitand (local.get $code))
  (block $e (loop $l
    (br_if $e (i32.ne (call $tok_kind) (i32.const 46)))  ;; ^
    (call $next_token) (call $vm_c_bitand (local.get $code))
    (call $vm_emit_op (local.get $code) (i32.const 39))  ;; BXOR
    (br $l))))
(func $vm_c_bitor (param $code i32) (effects)
  (call $vm_c_bitxor (local.get $code))
  (block $e (loop $l
    (br_if $e (i32.ne (call $tok_kind) (i32.const 45)))  ;; |
    (call $next_token) (call $vm_c_bitxor (local.get $code))
    (call $vm_emit_op (local.get $code) (i32.const 38))  ;; BOR
    (br $l))))

;; logical AND (&&, kind 34): short-circuit via JMPF_PEEK (keep falsy operand)
(func $vm_c_and (param $code i32) (effects)
  (call $vm_c_bitor (local.get $code))
  (let $patches i32 (call $heap_alloc (i32.const 256)))
  (let $np i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ne (call $tok_kind) (i32.const 34)))
    (call $next_token)
    (i32.store (i32.add (local.get $patches) (i32.mul (local.get $np) (i32.const 4))) (call $vm_emit_jump (local.get $code) (i32.const 27)))  ;; JMPF_PEEK
    (set! $np (i32.add (local.get $np) (i32.const 1)))
    (call $vm_emit_op (local.get $code) (i32.const 11))  ;; POP (discard truthy left)
    (call $vm_c_cmp (local.get $code))
    (br $l)))
  (let $i i32 (i32.const 0))
  (block $pe (loop $pl
    (br_if $pe (i32.ge_s (local.get $i) (local.get $np)))
    (call $vm_patch (local.get $code) (i32.load (i32.add (local.get $patches) (i32.mul (local.get $i) (i32.const 4)))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $pl))))

;; logical OR (||, kind 35): short-circuit via JMPT_PEEK (keep truthy operand)
(func $vm_c_or (param $code i32) (effects)
  (call $vm_c_and (local.get $code))
  (let $patches i32 (call $heap_alloc (i32.const 256)))
  (let $np i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ne (call $tok_kind) (i32.const 35)))
    (call $next_token)
    (i32.store (i32.add (local.get $patches) (i32.mul (local.get $np) (i32.const 4))) (call $vm_emit_jump (local.get $code) (i32.const 28)))  ;; JMPT_PEEK
    (set! $np (i32.add (local.get $np) (i32.const 1)))
    (call $vm_emit_op (local.get $code) (i32.const 11))  ;; POP (discard falsy left)
    (call $vm_c_and (local.get $code))
    (br $l)))
  (let $i i32 (i32.const 0))
  (block $pe (loop $pl
    (br_if $pe (i32.ge_s (local.get $i) (local.get $np)))
    (call $vm_patch (local.get $code) (i32.load (i32.add (local.get $patches) (i32.mul (local.get $i) (i32.const 4)))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $pl))))

;; conditional  c ? t : e  (lowest precedence, right-assoc)
(func $vm_c_expr (param $code i32) (effects)
  (call $vm_c_or (local.get $code))
  (if (i32.eq (call $tok_kind) (i32.const 36))  ;; '?'
    (then
      (call $next_token)
      (let $p1 i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))  ;; JMPF → else
      (call $vm_c_expr (local.get $code))                                   ;; then branch
      (let $p2 i32 (call $vm_emit_jump (local.get $code) (i32.const 12)))  ;; JMP → end
      (call $vm_patch (local.get $code) (local.get $p1))
      (call $next_token)  ;; ':'
      (call $vm_c_expr (local.get $code))                                   ;; else branch
      (call $vm_patch (local.get $code) (local.get $p2)))))

;; compile a function (declaration or expression): cursor at 'function'.
;; Emits the body inline (JMP over it) + a PUSH of the resulting VM-fn value.
;; Returns the function's name ptr (0 if anonymous).
(func $vm_c_function (param $code i32) (result i32) (effects)
  (call $next_token)  ;; 'function'
  (let $fname i32 (i32.const 0))
  (if (i32.eq (call $tok_kind) (i32.const 3)) (then (set! $fname (call $ident_name)) (call $next_token)))  ;; optional name
  (call $next_token)  ;; '('
  (let $params i32 (call $heap_alloc (i32.const 256)))
  (let $np i32 (i32.const 0))
  (if (i32.ne (call $tok_kind) (i32.const 16))
    (then (block $pe (loop $pl
      (i32.store (i32.add (local.get $params) (i32.mul (local.get $np) (i32.const 4))) (call $ident_name))
      (call $next_token)
      (set! $np (i32.add (local.get $np) (i32.const 1)))
      (br_if $pe (i32.eqz (call $eat (i32.const 22))))
      (br $pl)))))
  (call $next_token)  ;; ')'
  (let $pj i32 (call $vm_emit_jump (local.get $code) (i32.const 12)))  ;; JMP over body
  (let $entry i32 (call $vm_emit_cursor))
  (call $vm_c_stmt (local.get $code))  ;; body block
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef))
  (call $vm_emit_op (local.get $code) (i32.const 20))  ;; default RET undefined
  (call $vm_patch (local.get $code) (local.get $pj))
  (let $fn i32 (call $heap_alloc (i32.add (i32.const 16) (i32.mul (local.get $np) (i32.const 4)))))
  (i32.store (local.get $fn) (i32.const 1448232526))  ;; VM_MAGIC
  (i32.store (i32.add (local.get $fn) (i32.const 4)) (local.get $entry))
  (i32.store (i32.add (local.get $fn) (i32.const 8)) (local.get $np))
  (i32.store (i32.add (local.get $fn) (i32.const 12)) (local.get $code))
  (let $ci i32 (i32.const 0))
  (block $ce (loop $cl
    (br_if $ce (i32.ge_s (local.get $ci) (local.get $np)))
    (i32.store (i32.add (i32.add (local.get $fn) (i32.const 16)) (i32.mul (local.get $ci) (i32.const 4)))
               (i32.load (i32.add (local.get $params) (i32.mul (local.get $ci) (i32.const 4)))))
    (set! $ci (i32.add (local.get $ci) (i32.const 1)))
    (br $cl)))
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_fn (local.get $fn)))  ;; PUSH fn
  (local.get $fname))

;; statement compiler — emits bytecode (control flow via jumps, not re-scanning)
(func $vm_c_stmt (param $code i32) (effects)
  ;; block { ... }
  (if (i32.eq (call $tok_kind) (i32.const 17))
    (then
      (call $next_token)
      (block $be (loop $bl
        (br_if $be (i32.eq (call $tok_kind) (i32.const 18)))  ;; '}'
        (br_if $be (i32.eq (call $tok_kind) (i32.const 0)))
        (call $vm_c_stmt (local.get $code))
        (br $bl)))
      (call $next_token)  ;; consume '}'
      (return)))
  (if (i32.eq (call $tok_kind) (i32.const 3))
    (then
      ;; function NAME ( params ) { body }   (declaration)
      (if (call $tok_is_kw (cstring "function"))
        (then
          (let $fnm i32 (call $vm_c_function (local.get $code)))  ;; emits PUSH fn
          (if (local.get $fnm)
            (then (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $fnm)))  ;; STOREVAR
            (else (call $vm_emit_op (local.get $code) (i32.const 11))))  ;; POP
          (return)))
      ;; return [expr] ;   (tail call peephole: trailing CALL → TAILCALL)
      (if (call $tok_is_kw (cstring "return"))
        (then
          (call $next_token)
          (if (i32.or (i32.eq (call $tok_kind) (i32.const 21)) (i32.or (i32.eq (call $tok_kind) (i32.const 18)) (i32.eq (call $tok_kind) (i32.const 0))))
            (then
              (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef))
              (call $vm_emit_op (local.get $code) (i32.const 20))
              (drop (call $eat (i32.const 21)))
              (return)))
          (call $vm_c_expr (local.get $code))
          (if (i32.eq (i32.load (i32.add (local.get $code) (i32.sub (call $vm_emit_cursor) (i32.const 8)))) (i32.const 19))  ;; ends in CALL?
            (then (i32.store (i32.add (local.get $code) (i32.sub (call $vm_emit_cursor) (i32.const 8))) (i32.const 21)))  ;; → TAILCALL
            (else (call $vm_emit_op (local.get $code) (i32.const 20))))  ;; RET
          (drop (call $eat (i32.const 21)))
          (return)))
      ;; var NAME = expr ;   /   NAME = expr ;
      (if (call $tok_is_kw (cstring "var"))
        (then
          (call $next_token)
          (let $nm i32 (call $ident_name)) (call $next_token)
          (call $next_token)  ;; '='
          (call $vm_c_expr (local.get $code))
          (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $nm))  ;; STOREVAR
          (drop (call $eat (i32.const 21)))
          (return)))
      (if (call $tok_is_kw (cstring "break"))
        (then
          (call $next_token)
          (if (i32.load (i32.const 208))  ;; inside a loop
            (then
              (i32.store (i32.add (i32.load (i32.const 208)) (i32.mul (i32.load (i32.const 212)) (i32.const 4))) (call $vm_emit_jump (local.get $code) (i32.const 12)))
              (i32.store (i32.const 212) (i32.add (i32.load (i32.const 212)) (i32.const 1)))))
          (drop (call $eat (i32.const 21)))
          (return)))
      (if (call $tok_is_kw (cstring "continue"))
        (then
          (call $next_token)
          (if (i32.load (i32.const 216))
            (then
              (i32.store (i32.add (i32.load (i32.const 216)) (i32.mul (i32.load (i32.const 220)) (i32.const 4))) (call $vm_emit_jump (local.get $code) (i32.const 12)))
              (i32.store (i32.const 220) (i32.add (i32.load (i32.const 220)) (i32.const 1)))))
          (drop (call $eat (i32.const 21)))
          (return)))
      (if (call $tok_is_kw (cstring "print"))
        (then
          (call $next_token)
          (let $paren i32 (i32.eq (call $tok_kind) (i32.const 15)))
          (if (local.get $paren) (then (call $next_token)))
          (call $vm_c_expr (local.get $code))
          (if (local.get $paren) (then (call $next_token)))  ;; ')'
          (call $vm_emit_op (local.get $code) (i32.const 10))  ;; PRINT
          (drop (call $eat (i32.const 21)))
          (return)))
      (if (call $tok_is_kw (cstring "if"))
        (then
          (call $next_token) (call $next_token)  ;; 'if' '('
          (call $vm_c_expr (local.get $code))
          (call $next_token)  ;; ')'
          (let $p1 i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))  ;; JMPF → else/end
          (call $vm_c_stmt (local.get $code))
          (if (i32.and (i32.eq (call $tok_kind) (i32.const 3)) (call $tok_is_kw (cstring "else")))
            (then
              (let $p2 i32 (call $vm_emit_jump (local.get $code) (i32.const 12)))  ;; JMP over else
              (call $vm_patch (local.get $code) (local.get $p1))
              (call $next_token)  ;; 'else'
              (call $vm_c_stmt (local.get $code))
              (call $vm_patch (local.get $code) (local.get $p2)))
            (else (call $vm_patch (local.get $code) (local.get $p1))))
          (return)))
      (if (call $tok_is_kw (cstring "while"))
        (then
          (call $next_token) (call $next_token)  ;; 'while' '('
          (let $lsave i32 (call $vm_loop_enter))
          (let $top i32 (call $vm_emit_cursor))
          (call $vm_c_expr (local.get $code))
          (call $next_token)  ;; ')'
          (let $pw i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))  ;; JMPF → end
          (call $vm_c_stmt (local.get $code))
          (call $vm_patch_list (i32.const 216) (i32.const 220) (local.get $code) (local.get $top))  ;; continue → top
          (call $vm_emit_op (local.get $code) (i32.const 12)) (call $vm_emit_op (local.get $code) (local.get $top))  ;; JMP top
          (call $vm_patch (local.get $code) (local.get $pw))
          (call $vm_patch_list (i32.const 208) (i32.const 212) (local.get $code) (call $vm_emit_cursor))  ;; break → end
          (call $vm_loop_exit (local.get $lsave))
          (return)))
      (if (call $tok_is_kw (cstring "for"))  ;; for ( init ; cond ; update ) body
        (then
          (call $next_token) (call $next_token)  ;; 'for' '('
          (let $flsave i32 (call $vm_loop_enter))
          ;; init (consumes up to ';')
          (if (i32.ne (call $tok_kind) (i32.const 21))
            (then
              (if (call $tok_is_kw (cstring "var"))
                (then
                  (call $next_token) (let $fin i32 (call $ident_name)) (call $next_token) (call $next_token)  ;; var NAME =
                  (call $vm_c_expr (local.get $code))
                  (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $fin)))
                (else
                  (call $look_save)
                  (let $fin2 i32 (call $ident_name)) (call $next_token)
                  (if (i32.eq (call $tok_kind) (i32.const 24))
                    (then (call $next_token) (call $vm_c_expr (local.get $code))
                          (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $fin2)))
                    (else (call $look_restore) (call $vm_c_expr (local.get $code)) (call $vm_emit_op (local.get $code) (i32.const 11))))))))
          (call $expect (i32.const 21) (cstring "expected ;"))
          (let $ftop i32 (call $vm_emit_cursor))
          (if (i32.ne (call $tok_kind) (i32.const 21))
            (then (call $vm_c_expr (local.get $code)))
            (else (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_bool (i32.const 1)))))
          (call $expect (i32.const 21) (cstring "expected ;"))
          (let $fpend i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))  ;; JMPF → end
          ;; save update-clause cursor, skip its tokens to the ')'
          (let $fupd i32 (call $cursor_save))
          (let $fdepth i32 (i32.const 0))
          (block $fse (loop $fsl
            (br_if $fse (i32.eq (call $tok_kind) (i32.const 0)))
            (if (i32.eq (call $tok_kind) (i32.const 15)) (then (set! $fdepth (i32.add (local.get $fdepth) (i32.const 1)))))
            (if (i32.eq (call $tok_kind) (i32.const 16))
              (then (br_if $fse (i32.eqz (local.get $fdepth))) (set! $fdepth (i32.sub (local.get $fdepth) (i32.const 1)))))
            (call $next_token)
            (br $fsl)))
          (call $next_token)  ;; ')'
          (call $vm_c_stmt (local.get $code))  ;; body
          (let $fpost i32 (call $cursor_save))
          ;; continue → the update clause (compiled next)
          (call $vm_patch_list (i32.const 216) (i32.const 220) (local.get $code) (call $vm_emit_cursor))
          ;; re-scan + compile the update, then loop
          (call $cursor_restore (local.get $fupd))
          (if (i32.ne (call $tok_kind) (i32.const 16))
            (then (call $vm_c_expr (local.get $code)) (call $vm_emit_op (local.get $code) (i32.const 11))))  ;; update; POP
          (call $vm_emit_op (local.get $code) (i32.const 12)) (call $vm_emit_op (local.get $code) (local.get $ftop))  ;; JMP top
          (call $vm_patch (local.get $code) (local.get $fpend))
          (call $vm_patch_list (i32.const 208) (i32.const 212) (local.get $code) (call $vm_emit_cursor))  ;; break → end
          (call $cursor_restore (local.get $fpost))  ;; lexer resumes after the body
          (call $vm_loop_exit (local.get $flsave))
          (return)))
      ;; assignment:  NAME = expr ;   |  NAME op= expr ;
      (call $look_save)
      (let $an i32 (call $ident_name)) (call $next_token)
      (if (i32.eq (call $tok_kind) (i32.const 24))  ;; '='
        (then
          (call $next_token)
          (call $vm_c_expr (local.get $code))
          (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $an))  ;; STOREVAR
          (drop (call $eat (i32.const 21)))
          (return)))
      (if (i32.and (i32.ge_s (call $tok_kind) (i32.const 40)) (i32.le_s (call $tok_kind) (i32.const 43)))  ;; += -= *= /=
        (then
          (let $cop i32 (if i32 (i32.eq (call $tok_kind) (i32.const 40)) (then (i32.const 2))   ;; ADD
                          (else (if i32 (i32.eq (call $tok_kind) (i32.const 41)) (then (i32.const 3))   ;; SUB
                          (else (if i32 (i32.eq (call $tok_kind) (i32.const 42)) (then (i32.const 4)) (else (i32.const 5))))))))  ;; MUL/DIV
          (call $next_token)
          (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $an))  ;; LOADVAR
          (call $vm_c_expr (local.get $code))                                                                       ;; RHS
          (call $vm_emit_op (local.get $code) (local.get $cop))
          (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $an))  ;; STOREVAR
          (drop (call $eat (i32.const 21)))
          (return)))
      (call $look_restore)))
  ;; expression statement
  (call $vm_c_expr (local.get $code))
  (call $vm_emit_op (local.get $code) (i32.const 11))  ;; POP
  (drop (call $eat (i32.const 21))))

;; compile a whole program (statement list) → HALT-terminated bytecode
(func $vm_compile_prog (param $ptr i32) (param $len i32) (result i32) (effects)
  (call $set_src (local.get $ptr) (local.get $len))
  (call $lex_init)
  (call $next_token)
  (i32.store (i32.const 208) (i32.const 0)) (i32.store (i32.const 216) (i32.const 0))  ;; no enclosing loop
  (let $code i32 (call $heap_alloc (i32.const 65536)))
  (call $vm_set_emit_cursor (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.eq (call $tok_kind) (i32.const 0)))
    (br_if $e (call $err))
    (call $vm_c_stmt (local.get $code))
    (br $l)))
  (call $vm_emit_op (local.get $code) (i32.const 0))  ;; HALT
  (local.get $code))

;; compile a single arithmetic expression, HALT-terminated
(func $vm_compile (param $ptr i32) (param $len i32) (result i32) (effects)
  (call $set_src (local.get $ptr) (local.get $len))
  (call $lex_init)
  (call $next_token)
  (let $code i32 (call $heap_alloc (i32.const 8192)))
  (call $vm_set_emit_cursor (i32.const 0))
  (call $vm_c_add (local.get $code))
  (call $vm_emit_op (local.get $code) (i32.const 0))  ;; HALT
  (local.get $code))

;; compile a ';'-separated list of expressions, YIELDing each — a stand-in for a
;; generator body, to exercise suspend/resume. Layout: [expr YIELD]* HALT
(func $vm_compile_gen (param $ptr i32) (param $len i32) (result i32) (effects)
  (call $set_src (local.get $ptr) (local.get $len))
  (call $lex_init)
  (call $next_token)
  (let $code i32 (call $heap_alloc (i32.const 8192)))
  (call $vm_set_emit_cursor (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.eq (call $tok_kind) (i32.const 0)))  ;; EOF
    (call $vm_c_add (local.get $code))
    (call $vm_emit_op (local.get $code) (i32.const 7))  ;; YIELD
    (br_if $e (i32.ne (call $tok_kind) (i32.const 21)))  ;; ';'
    (call $next_token)
    (br $l)))
  (call $vm_emit_op (local.get $code) (i32.const 0))  ;; HALT
  (local.get $code))

;; ── resumable VM context — execution state reified in memory ──
;; layout: @0 code, @4 ip, @8 stack, @12 sp, @16 done, @20 scope (current),
;;         @24 curframe (in-memory call-frame chain), @28 gscope (globals)
(func $vm_new (param $code i32) (result i32) (effects)
  (let $ctx i32 (call $heap_alloc (i32.const 32)))
  (let $gs i32 (call $scope_new (i32.const 0) (i32.const 256)))
  (call $setup_globals (local.get $gs))  ;; builtins, prototypes, Math, etc.
  (i32.store (local.get $ctx) (local.get $code))
  (i32.store (i32.add (local.get $ctx) (i32.const 4)) (i32.const 0))           ;; ip
  (i32.store (i32.add (local.get $ctx) (i32.const 8)) (call $heap_alloc (i32.const 65536)))  ;; operand stack
  (i32.store (i32.add (local.get $ctx) (i32.const 12)) (i32.const 0))          ;; sp
  (i32.store (i32.add (local.get $ctx) (i32.const 16)) (i32.const 0))          ;; done
  (i32.store (i32.add (local.get $ctx) (i32.const 20)) (local.get $gs))        ;; current scope = globals
  (i32.store (i32.add (local.get $ctx) (i32.const 24)) (i32.const 0))          ;; no active frame
  (i32.store (i32.add (local.get $ctx) (i32.const 28)) (local.get $gs))        ;; global scope (closure parent)
  (local.get $ctx))

(func $vm_done (param $ctx i32) (result i32) (effects) (i32.load (i32.add (local.get $ctx) (i32.const 16))))

;; run from the context's saved (ip, sp) until the next YIELD or HALT.
;; YIELD → returns the yielded value, state saved for the next call (done=0).
;; HALT  → sets done=1, returns the final top-of-stack value (or undefined).
;; This is the mechanism the re-scan evaluator structurally cannot provide.
(func $vm_step (param $ctx i32) (result i64) (effects)
  (let $code i32 (i32.load (local.get $ctx)))
  (let $stack i32 (i32.load (i32.add (local.get $ctx) (i32.const 8))))
  (let $ip i32 (i32.load (i32.add (local.get $ctx) (i32.const 4))))
  (let $sp i32 (i32.load (i32.add (local.get $ctx) (i32.const 12))))
  (let $scope i32 (i32.load (i32.add (local.get $ctx) (i32.const 20))))
  (let $frame i32 (i32.load (i32.add (local.get $ctx) (i32.const 24))))
  (let $gscope i32 (i32.load (i32.add (local.get $ctx) (i32.const 28))))
  (i32.store (i32.const 204) (local.get $gscope))  ;; active VM globals, for the native->VM callback bridge
  (loop $disp
    (let $op i32 (i32.load (i32.add (local.get $code) (local.get $ip))))
    (set! $ip (i32.add (local.get $ip) (i32.const 4)))
    (if (i32.eq (local.get $op) (i32.const 0))  ;; HALT
      (then
        (i32.store (i32.add (local.get $ctx) (i32.const 16)) (i32.const 1))
        (i32.store (i32.add (local.get $ctx) (i32.const 4)) (local.get $ip))
        (i32.store (i32.add (local.get $ctx) (i32.const 12)) (local.get $sp))
        (i32.store (i32.add (local.get $ctx) (i32.const 20)) (local.get $scope))
        (i32.store (i32.add (local.get $ctx) (i32.const 24)) (local.get $frame))
        (return (if i64 (i32.gt_s (local.get $sp) (i32.const 0))
                  (then (i64.load (i32.add (local.get $stack) (i32.sub (local.get $sp) (i32.const 8)))))
                  (else (call $v_undef))))))
    (if (i32.eq (local.get $op) (i32.const 7))  ;; YIELD — suspend
      (then
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
        (i32.store (i32.add (local.get $ctx) (i32.const 4)) (local.get $ip))
        (i32.store (i32.add (local.get $ctx) (i32.const 12)) (local.get $sp))
        (i32.store (i32.add (local.get $ctx) (i32.const 20)) (local.get $scope))
        (i32.store (i32.add (local.get $ctx) (i32.const 24)) (local.get $frame))
        (return (i64.load (i32.add (local.get $stack) (local.get $sp))))))
    (if (i32.eq (local.get $op) (i32.const 32))  ;; DUP top
      (then
        (i64.store (i32.add (local.get $stack) (local.get $sp)) (i64.load (i32.add (local.get $stack) (i32.sub (local.get $sp) (i32.const 8)))))
        (set! $sp (i32.add (local.get $sp) (i32.const 8)))
        (br $disp)))
    (if (i32.or (i32.eq (local.get $op) (i32.const 19)) (i32.or (i32.eq (local.get $op) (i32.const 21)) (i32.eq (local.get $op) (i32.const 33))))  ;; CALL / TAILCALL / CALLM
      (then
        (let $argc i32 (i32.load (i32.add (local.get $code) (local.get $ip))))
        (set! $ip (i32.add (local.get $ip) (i32.const 4)))
        (let $isM i32 (i32.eq (local.get $op) (i32.const 33)))  ;; method call → receiver is below the callee
        (let $cbase i32 (i32.sub (local.get $sp) (i32.mul (i32.add (local.get $argc) (i32.const 1)) (i32.const 8))))  ;; callee slot
        (let $rbase i32 (if i32 (local.get $isM) (then (i32.sub (local.get $cbase) (i32.const 8))) (else (local.get $cbase))))  ;; result base
        (let $cfn i32 (call $val_payload (i64.load (i32.add (local.get $stack) (local.get $cbase)))))
        (if (i32.ne (i32.load (local.get $cfn)) (i32.const 1448232526))  ;; not a VM-fn → native built-in
          (then
            (let $thisv i64 (if i64 (local.get $isM) (then (i64.load (i32.add (local.get $stack) (local.get $rbase)))) (else (call $v_undef))))
            (let $res i64 (call $call_native (i32.load (local.get $cfn)) (local.get $argc) (i32.add (local.get $stack) (i32.add (local.get $cbase) (i32.const 8))) (local.get $thisv)))
            (set! $sp (local.get $rbase))
            (i64.store (i32.add (local.get $stack) (local.get $sp)) (local.get $res))
            (set! $sp (i32.add (local.get $sp) (i32.const 8)))
            (br $disp)))
        (let $centry i32 (i32.load (i32.add (local.get $cfn) (i32.const 4))))
        (let $cnp i32 (i32.load (i32.add (local.get $cfn) (i32.const 8))))
        ;; TAILCALL reuses the current frame's scope → O(1)-space tail recursion
        (let $cns i32 (if i32 (i32.eq (local.get $op) (i32.const 21))
                        (then (local.get $scope))
                        (else (call $scope_new (local.get $gscope) (i32.add (local.get $cnp) (i32.const 4))))))
        (if (i32.eq (local.get $op) (i32.const 21)) (then (i32.store (i32.add (local.get $cns) (i32.const 4)) (i32.const 0))))
        (let $pi i32 (i32.const 0))
        (block $pe (loop $pl
          (br_if $pe (i32.ge_s (local.get $pi) (local.get $cnp)))
          (call $scope_define (local.get $cns) (i32.load (i32.add (i32.add (local.get $cfn) (i32.const 16)) (i32.mul (local.get $pi) (i32.const 4))))
            (if i64 (i32.lt_s (local.get $pi) (local.get $argc))
              (then (i64.load (i32.add (local.get $stack) (i32.add (local.get $cbase) (i32.mul (i32.add (local.get $pi) (i32.const 1)) (i32.const 8))))))
              (else (call $v_undef))))
          (set! $pi (i32.add (local.get $pi) (i32.const 1)))
          (br $pl)))
        (if (i32.eq (local.get $op) (i32.const 21))  ;; TAILCALL: reuse current frame
          (then (set! $sp (i32.load (i32.add (local.get $frame) (i32.const 12)))))
          (else  ;; CALL / CALLM: push a new frame; result base drops callee (+ receiver)
            (let $fr i32 (call $heap_alloc (i32.const 16)))
            (i32.store (local.get $fr) (local.get $ip))
            (i32.store (i32.add (local.get $fr) (i32.const 4)) (local.get $frame))
            (i32.store (i32.add (local.get $fr) (i32.const 8)) (local.get $scope))
            (i32.store (i32.add (local.get $fr) (i32.const 12)) (local.get $rbase))
            (set! $frame (local.get $fr))
            (set! $sp (local.get $rbase))))
        (set! $scope (local.get $cns))
        (set! $ip (local.get $centry))
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 20))  ;; RET
      (then
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
        (let $rv i64 (i64.load (i32.add (local.get $stack) (local.get $sp))))
        (if (i32.eqz (local.get $frame))  ;; top-level return → halt
          (then
            (i32.store (i32.add (local.get $ctx) (i32.const 16)) (i32.const 1))
            (return (local.get $rv))))
        (set! $ip (i32.load (local.get $frame)))
        (set! $scope (i32.load (i32.add (local.get $frame) (i32.const 8))))
        (let $rb i32 (i32.load (i32.add (local.get $frame) (i32.const 12))))
        (set! $frame (i32.load (i32.add (local.get $frame) (i32.const 4))))
        (i64.store (i32.add (local.get $stack) (local.get $rb)) (local.get $rv))
        (set! $sp (i32.add (local.get $rb) (i32.const 8)))
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 1))  ;; PUSH imm
      (then
        (i64.store (i32.add (local.get $stack) (local.get $sp)) (i64.load (i32.add (local.get $code) (local.get $ip))))
        (set! $ip (i32.add (local.get $ip) (i32.const 8)))
        (set! $sp (i32.add (local.get $sp) (i32.const 8)))
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 6))  ;; NEG
      (then
        (let $t i32 (i32.sub (local.get $sp) (i32.const 8)))
        (i64.store (i32.add (local.get $stack) (local.get $t))
                   (call $num (f64.neg (call $tonum_raw (i64.load (i32.add (local.get $stack) (local.get $t)))))))
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 23))  ;; NOT (unary, in place)
      (then
        (let $t i32 (i32.sub (local.get $sp) (i32.const 8)))
        (i64.store (i32.add (local.get $stack) (local.get $t))
                   (call $mk_bool (i32.eqz (call $truthy (i64.load (i32.add (local.get $stack) (local.get $t)))))))
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 2))  ;; ADD — js_add (string concat + numeric)
      (then
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
        (i64.store (i32.add (local.get $stack) (i32.sub (local.get $sp) (i32.const 8)))
                   (call $js_add (i64.load (i32.add (local.get $stack) (i32.sub (local.get $sp) (i32.const 8))))
                                 (i64.load (i32.add (local.get $stack) (local.get $sp)))))
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 8))  ;; LOADVAR (operand: name ptr)
      (then
        (let $nm i32 (i32.load (i32.add (local.get $code) (local.get $ip))))
        (set! $ip (i32.add (local.get $ip) (i32.const 4)))
        (let $slot i32 (call $scope_find (local.get $scope) (local.get $nm)))
        (i64.store (i32.add (local.get $stack) (local.get $sp))
                   (if i64 (local.get $slot) (then (i64.load (local.get $slot))) (else (call $v_undef))))
        (set! $sp (i32.add (local.get $sp) (i32.const 8)))
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 9))  ;; STOREVAR (operand: name ptr)
      (then
        (let $nm i32 (i32.load (i32.add (local.get $code) (local.get $ip))))
        (set! $ip (i32.add (local.get $ip) (i32.const 4)))
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
        ;; assign up the scope chain (so closures update outer vars); define locally if unbound
        (let $svslot i32 (call $scope_find (local.get $scope) (local.get $nm)))
        (if (local.get $svslot)
          (then (i64.store (local.get $svslot) (i64.load (i32.add (local.get $stack) (local.get $sp)))))
          (else (call $scope_define (local.get $scope) (local.get $nm) (i64.load (i32.add (local.get $stack) (local.get $sp))))))
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 10))  ;; PRINT
      (then
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
        (call $print_str (call $to_str (i64.load (i32.add (local.get $stack) (local.get $sp)))))
        (call $print_str (cstring "\n"))
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 11))  ;; POP
      (then (set! $sp (i32.sub (local.get $sp) (i32.const 8))) (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 29))  ;; NEWARRAY n (operand) — n values on top
      (then
        (let $an i32 (i32.load (i32.add (local.get $code) (local.get $ip))))
        (set! $ip (i32.add (local.get $ip) (i32.const 4)))
        (let $arr i32 (call $arr_new (i32.add (local.get $an) (i32.const 1))))
        (let $base i32 (i32.sub (local.get $sp) (i32.mul (local.get $an) (i32.const 8))))
        (let $ai i32 (i32.const 0))
        (block $ne (loop $nl
          (br_if $ne (i32.ge_s (local.get $ai) (local.get $an)))
          (call $arr_push (local.get $arr) (i64.load (i32.add (local.get $stack) (i32.add (local.get $base) (i32.mul (local.get $ai) (i32.const 8))))))
          (set! $ai (i32.add (local.get $ai) (i32.const 1)))
          (br $nl)))
        (set! $sp (local.get $base))
        (i64.store (i32.add (local.get $stack) (local.get $sp)) (call $mk_arr (local.get $arr)))
        (set! $sp (i32.add (local.get $sp) (i32.const 8)))
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 30))  ;; GETPROP (operand: name ptr)
      (then
        (let $nm i32 (i32.load (i32.add (local.get $code) (local.get $ip))))
        (set! $ip (i32.add (local.get $ip) (i32.const 4)))
        (let $t i32 (i32.sub (local.get $sp) (i32.const 8)))
        (i64.store (i32.add (local.get $stack) (local.get $t))
                   (call $get_prop (i64.load (i32.add (local.get $stack) (local.get $t))) (call $mk_str (local.get $nm))))
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 31))  ;; GETIDX — pop key, pop obj
      (then
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
        (let $key i64 (i64.load (i32.add (local.get $stack) (local.get $sp))))
        (let $t i32 (i32.sub (local.get $sp) (i32.const 8)))
        (i64.store (i32.add (local.get $stack) (local.get $t))
                   (call $get_prop (i64.load (i32.add (local.get $stack) (local.get $t))) (local.get $key)))
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 34))  ;; SETPROP (operand: name) — [obj, val]
      (then
        (let $nm i32 (i32.load (i32.add (local.get $code) (local.get $ip))))
        (set! $ip (i32.add (local.get $ip) (i32.const 4)))
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
        (let $v i64 (i64.load (i32.add (local.get $stack) (local.get $sp))))
        (let $t i32 (i32.sub (local.get $sp) (i32.const 8)))
        (call $set_prop (i64.load (i32.add (local.get $stack) (local.get $t))) (call $mk_str (local.get $nm)) (local.get $v))
        (i64.store (i32.add (local.get $stack) (local.get $t)) (local.get $v))  ;; assignment yields the value
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 35))  ;; SETIDX — [obj, key, val]
      (then
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
        (let $v i64 (i64.load (i32.add (local.get $stack) (local.get $sp))))
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
        (let $key i64 (i64.load (i32.add (local.get $stack) (local.get $sp))))
        (let $t i32 (i32.sub (local.get $sp) (i32.const 8)))
        (call $set_prop (i64.load (i32.add (local.get $stack) (local.get $t))) (local.get $key) (local.get $v))
        (i64.store (i32.add (local.get $stack) (local.get $t)) (local.get $v))
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 36))  ;; NEWOBJ n (operand) — n (key,val) pairs on top
      (then
        (let $on i32 (i32.load (i32.add (local.get $code) (local.get $ip))))
        (set! $ip (i32.add (local.get $ip) (i32.const 4)))
        (let $obj i32 (call $obj_new (i32.add (local.get $on) (i32.const 2))))
        (let $base i32 (i32.sub (local.get $sp) (i32.mul (local.get $on) (i32.const 16))))  ;; each pair = 16 bytes
        (let $oi i32 (i32.const 0))
        (block $noe (loop $nol
          (br_if $noe (i32.ge_s (local.get $oi) (local.get $on)))
          (let $slot i32 (i32.add (local.get $base) (i32.mul (local.get $oi) (i32.const 16))))
          (call $scope_define (local.get $obj)
            (call $to_str (i64.load (i32.add (local.get $stack) (local.get $slot))))           ;; key
            (i64.load (i32.add (local.get $stack) (i32.add (local.get $slot) (i32.const 8)))))  ;; value
          (set! $oi (i32.add (local.get $oi) (i32.const 1)))
          (br $nol)))
        (set! $sp (local.get $base))
        (i64.store (i32.add (local.get $stack) (local.get $sp)) (call $mk_obj (local.get $obj)))
        (set! $sp (i32.add (local.get $sp) (i32.const 8)))
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 12))  ;; JMP (operand: target)
      (then (set! $ip (i32.load (i32.add (local.get $code) (local.get $ip)))) (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 13))  ;; JMPF (operand: target) — pops
      (then
        (let $tgt i32 (i32.load (i32.add (local.get $code) (local.get $ip))))
        (set! $ip (i32.add (local.get $ip) (i32.const 4)))
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
        (if (i32.eqz (call $truthy (i64.load (i32.add (local.get $stack) (local.get $sp))))) (then (set! $ip (local.get $tgt))))
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 27))  ;; JMPF_PEEK — jump if top falsy, keep it (for &&)
      (then
        (let $tgt i32 (i32.load (i32.add (local.get $code) (local.get $ip))))
        (set! $ip (i32.add (local.get $ip) (i32.const 4)))
        (if (i32.eqz (call $truthy (i64.load (i32.add (local.get $stack) (i32.sub (local.get $sp) (i32.const 8)))))) (then (set! $ip (local.get $tgt))))
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 28))  ;; JMPT_PEEK — jump if top truthy, keep it (for ||)
      (then
        (let $tgt i32 (i32.load (i32.add (local.get $code) (local.get $ip))))
        (set! $ip (i32.add (local.get $ip) (i32.const 4)))
        (if (call $truthy (i64.load (i32.add (local.get $stack) (i32.sub (local.get $sp) (i32.const 8))))) (then (set! $ip (local.get $tgt))))
        (br $disp)))
    (if (i32.or (i32.and (i32.ge_s (local.get $op) (i32.const 14)) (i32.le_s (local.get $op) (i32.const 18)))
                (i32.and (i32.ge_s (local.get $op) (i32.const 24)) (i32.le_s (local.get $op) (i32.const 26))))  ;; comparisons + eq/neq
      (then
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
        (let $cb i64 (i64.load (i32.add (local.get $stack) (local.get $sp))))
        (let $ca i64 (i64.load (i32.add (local.get $stack) (i32.sub (local.get $sp) (i32.const 8)))))
        (let $cr i32 (i32.const 0))
        (if (i32.eq (local.get $op) (i32.const 14)) (then (set! $cr (f64.lt (call $tonum_raw (local.get $ca)) (call $tonum_raw (local.get $cb))))))
        (if (i32.eq (local.get $op) (i32.const 15)) (then (set! $cr (f64.gt (call $tonum_raw (local.get $ca)) (call $tonum_raw (local.get $cb))))))
        (if (i32.eq (local.get $op) (i32.const 16)) (then (set! $cr (f64.le (call $tonum_raw (local.get $ca)) (call $tonum_raw (local.get $cb))))))
        (if (i32.eq (local.get $op) (i32.const 17)) (then (set! $cr (f64.ge (call $tonum_raw (local.get $ca)) (call $tonum_raw (local.get $cb))))))
        (if (i32.eq (local.get $op) (i32.const 18)) (then (set! $cr (call $strict_eq (local.get $ca) (local.get $cb)))))
        (if (i32.eq (local.get $op) (i32.const 24)) (then (set! $cr (i32.eqz (call $strict_eq (local.get $ca) (local.get $cb))))))  ;; !==
        (if (i32.eq (local.get $op) (i32.const 25)) (then (set! $cr (call $loose_eq (local.get $ca) (local.get $cb)))))           ;; ==
        (if (i32.eq (local.get $op) (i32.const 26)) (then (set! $cr (i32.eqz (call $loose_eq (local.get $ca) (local.get $cb))))))  ;; !=
        (i64.store (i32.add (local.get $stack) (i32.sub (local.get $sp) (i32.const 8))) (call $mk_bool (local.get $cr)))
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 44))  ;; BNOT (unary ~)
      (then
        (let $t i32 (i32.sub (local.get $sp) (i32.const 8)))
        (i64.store (i32.add (local.get $stack) (local.get $t))
                   (call $num (f64.convert_i32_s (i32.xor (call $to_int32 (i64.load (i32.add (local.get $stack) (local.get $t)))) (i32.const -1)))))
        (br $disp)))
    (if (i32.and (i32.ge_s (local.get $op) (i32.const 37)) (i32.le_s (local.get $op) (i32.const 43)))  ;; & | ^ << >> >>> **
      (then
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
        (let $wb i64 (i64.load (i32.add (local.get $stack) (local.get $sp))))
        (let $wa i64 (i64.load (i32.add (local.get $stack) (i32.sub (local.get $sp) (i32.const 8)))))
        (let $wr i64 (call $v_undef))
        (if (i32.eq (local.get $op) (i32.const 37)) (then (set! $wr (call $num (f64.convert_i32_s (i32.and (call $to_int32 (local.get $wa)) (call $to_int32 (local.get $wb))))))))
        (if (i32.eq (local.get $op) (i32.const 38)) (then (set! $wr (call $num (f64.convert_i32_s (i32.or (call $to_int32 (local.get $wa)) (call $to_int32 (local.get $wb))))))))
        (if (i32.eq (local.get $op) (i32.const 39)) (then (set! $wr (call $num (f64.convert_i32_s (i32.xor (call $to_int32 (local.get $wa)) (call $to_int32 (local.get $wb))))))))
        (if (i32.eq (local.get $op) (i32.const 40)) (then (set! $wr (call $num (f64.convert_i32_s (i32.shl (call $to_int32 (local.get $wa)) (i32.and (call $to_int32 (local.get $wb)) (i32.const 31))))))))
        (if (i32.eq (local.get $op) (i32.const 41)) (then (set! $wr (call $num (f64.convert_i32_s (i32.shr_s (call $to_int32 (local.get $wa)) (i32.and (call $to_int32 (local.get $wb)) (i32.const 31))))))))
        (if (i32.eq (local.get $op) (i32.const 42)) (then (set! $wr (call $num (f64.convert_i32_u (i32.shr_u (call $to_int32 (local.get $wa)) (i32.and (call $to_int32 (local.get $wb)) (i32.const 31))))))))
        (if (i32.eq (local.get $op) (i32.const 43)) (then (set! $wr (call $num (call $f64_pow (call $tonum_raw (local.get $wa)) (call $tonum_raw (local.get $wb)))))))
        (i64.store (i32.add (local.get $stack) (i32.sub (local.get $sp) (i32.const 8))) (local.get $wr))
        (br $disp)))
    ;; binary: pop b, then a
    (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
    (let $b f64 (call $tonum_raw (i64.load (i32.add (local.get $stack) (local.get $sp)))))
    (let $a f64 (call $tonum_raw (i64.load (i32.add (local.get $stack) (i32.sub (local.get $sp) (i32.const 8))))))
    (let $r f64 (f64.const 0))
    (if (i32.eq (local.get $op) (i32.const 3)) (then (set! $r (f64.sub (local.get $a) (local.get $b)))))
    (if (i32.eq (local.get $op) (i32.const 4)) (then (set! $r (f64.mul (local.get $a) (local.get $b)))))
    (if (i32.eq (local.get $op) (i32.const 5)) (then (set! $r (f64.div (local.get $a) (local.get $b)))))
    (if (i32.eq (local.get $op) (i32.const 22)) (then (set! $r (call $fmod (local.get $a) (local.get $b)))))  ;; %
    (i64.store (i32.add (local.get $stack) (i32.sub (local.get $sp) (i32.const 8))) (call $num (local.get $r)))
    (br $disp))
  (call $v_undef))  ;; unreachable (loop always returns)

;; entry: compile then run a single expression to HALT, returning the number
(func $eval_vm (param $ptr i32) (param $len i32) (result f64) (effects)
  (call $tonum_raw (call $vm_step (call $vm_new (call $vm_compile (local.get $ptr) (local.get $len))))))

;; native->VM bridge: invoke a VM-fn (magic-marked struct) from engine code
;; (e.g. Array.prototype.map calling its callback). Runs the function body in a
;; fresh context to completion and returns its result. Enables higher-order
;; built-ins to take VM functions as callbacks.
(func $vm_call_fn (param $fn i32) (param $argc i32) (param $argv i32) (param $thisv i64) (result i64) (effects)
  (let $np i32 (i32.load (i32.add (local.get $fn) (i32.const 8))))
  (let $ns i32 (call $scope_new (i32.load (i32.const 204)) (i32.add (local.get $np) (i32.const 4))))
  (let $i i32 (i32.const 0))
  (block $pe (loop $pl
    (br_if $pe (i32.ge_s (local.get $i) (local.get $np)))
    (call $scope_define (local.get $ns) (i32.load (i32.add (i32.add (local.get $fn) (i32.const 16)) (i32.mul (local.get $i) (i32.const 4))))
      (if i64 (i32.lt_s (local.get $i) (local.get $argc))
        (then (i64.load (i32.add (local.get $argv) (i32.mul (local.get $i) (i32.const 8)))))
        (else (call $v_undef))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $pl)))
  (let $ctx i32 (call $heap_alloc (i32.const 32)))
  (i32.store (local.get $ctx) (i32.load (i32.add (local.get $fn) (i32.const 12))))          ;; code buffer
  (i32.store (i32.add (local.get $ctx) (i32.const 4)) (i32.load (i32.add (local.get $fn) (i32.const 4))))  ;; ip = entry
  (i32.store (i32.add (local.get $ctx) (i32.const 8)) (call $heap_alloc (i32.const 8192)))  ;; own operand stack
  (i32.store (i32.add (local.get $ctx) (i32.const 12)) (i32.const 0))
  (i32.store (i32.add (local.get $ctx) (i32.const 16)) (i32.const 0))
  (i32.store (i32.add (local.get $ctx) (i32.const 20)) (local.get $ns))
  (i32.store (i32.add (local.get $ctx) (i32.const 24)) (i32.const 0))                        ;; frame 0 → RET halts
  (i32.store (i32.add (local.get $ctx) (i32.const 28)) (i32.load (i32.const 204)))
  (let $rv i64 (call $v_undef))
  (block $e (loop $l
    (br_if $e (call $vm_done (local.get $ctx)))
    (set! $rv (call $vm_step (local.get $ctx)))
    (br $l)))
  (local.get $rv))

;; run a whole program on the VM (variables, if/while via jumps, print). Drives
;; vm_step to HALT — real stateful execution, all state in linear memory.
(func $eval_prog (param $ptr i32) (param $len i32) (result i32) (effects)
  (let $ctx i32 (call $vm_new (call $vm_compile_prog (local.get $ptr) (local.get $len))))
  (block $e (loop $l
    (br_if $e (call $vm_done (local.get $ctx)))
    (drop (call $vm_step (local.get $ctx)))
    (br $l)))
  (i32.const 0))

;; generator demo: start a ';'-separated yield-list; gen_next pulls each value
(func $vm_gen_start (param $ptr i32) (param $len i32) (result i32) (effects)
  (call $vm_new (call $vm_compile_gen (local.get $ptr) (local.get $len))))
(func $vm_gen_next (param $ctx i32) (result f64) (effects)
  (call $tonum_raw (call $vm_step (local.get $ctx))))
