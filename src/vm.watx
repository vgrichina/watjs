  ;; stash the field-inits array on the prototype (internal, DontEnum) for NEW to replay
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $protoT))  ;; LOADVAR proto
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $fieldsT))  ;; LOADVAR fieldsT
  (call $vm_emit_op (local.get $code) (i32.const 34)) (call $vm_emit_op (local.get $code) (cstring "@@fieldinits"))  ;; SETPROP
  (call $vm_emit_op (local.get $code) (i32.const 11))  ;; POP
