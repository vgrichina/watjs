  ;; for the last-statement-in-eval / substatement positions where a leftover token is handled elsewhere;
  ;; the reverted attempt failed the local suite. Left as an optional eat (under-parse-tolerant).
  (drop (call $eat (i32.const 21))))

;; compile a whole program (statement list) → HALT-terminated bytecode
;; Hoist `var` declarations: emit `PUSH undefined; STOREVAR name` for each var in
;; the current source (lexer just lex_init'd, no token read yet), so the binding
;; exists before its declaration line — `x; var x = 1;` sees undefined, not a
;; ReferenceError. Nested function bodies are skipped (their vars hoist to them).
;; Single-declarator form, mirroring the re-scan engine's hoist_vars.
;; A statement-position `function name(){}` (paren-depth 0, after start/;/{/})
;; is a DECLARATION → hoist it. Anything else (e.g. `while(function f(){})`,
;; `x = function g(){}`) is a function EXPRESSION → its name must NOT leak, so
;; just skip its body. $pd = paren/bracket depth, $prevk = previous token kind.
(func $vm_hoist (param $code i32) (effects)
  (let $pd i32 (i32.const 0))
  (let $bd i32 (i32.const 0))  ;; brace depth (separate from pd; gates AnnexB clause-fn hoisting to the true top level)
  (let $prevk i32 (i32.const 0))
  (let $prevelse i32 (i32.const 0))  ;; previous significant token was the `else` keyword
  (let $swpend i32 (i32.const 0))    ;; saw `switch` → its next '{' opens a CaseBlock
  (let $swdepth i32 (i32.const -1))  ;; brace depth of the active switch CaseBlock (-1 = none)
  (let $qdepth i32 (i32.const 0))    ;; open ternary '?' count at $swdepth
  (let $prevlabel i32 (i32.const 0)) ;; previous token was a case/default/label ':' at the CaseBlock level
  (call $next_token)
  (block $done (loop $scan
    (let $k i32 (call $tok_kind))
    (br_if $done (i32.eq (local.get $k) (i32.const 0)))
    (let $waslabel i32 (local.get $prevlabel))  ;; one-shot: valid only for the token right after ':'
    (set! $prevlabel (i32.const 0))
    (if (i32.eq (local.get $k) (i32.const 17)) (then (set! $bd (i32.add (local.get $bd) (i32.const 1)))
      (if (local.get $swpend) (then (set! $swdepth (local.get $bd)) (set! $swpend (i32.const 0)) (set! $qdepth (i32.const 0))))))  ;; switch CaseBlock '{'
    (if (i32.and (i32.eq (local.get $k) (i32.const 18)) (i32.gt_s (local.get $bd) (i32.const 0))) (then (set! $bd (i32.sub (local.get $bd) (i32.const 1)))
      (if (i32.lt_s (local.get $bd) (local.get $swdepth)) (then (set! $swdepth (i32.const -1)) (set! $qdepth (i32.const 0))))))  ;; left the CaseBlock
    (if (i32.and (i32.eq (local.get $k) (i32.const 3)) (call $tok_is_kw (cstring "switch"))) (then (if (i32.eqz (local.get $bd)) (then (set! $swpend (i32.const 1))))))  ;; only a TRUE top-level switch hoists its clause fns to global; a switch nested in a block/for/try does not
    (if (i32.and (i32.ge_s (local.get $swdepth) (i32.const 0)) (i32.eq (local.get $bd) (local.get $swdepth)))
      (then
        (if (i32.eq (local.get $k) (i32.const 36)) (then (set! $qdepth (i32.add (local.get $qdepth) (i32.const 1)))))  ;; '?'
        (if (i32.eq (local.get $k) (i32.const 37))  ;; ':'
          (then (if (i32.gt_s (local.get $qdepth) (i32.const 0)) (then (set! $qdepth (i32.sub (local.get $qdepth) (i32.const 1)))) (else (set! $prevlabel (i32.const 1))))))))
    ;; AnnexB B.3.3: a `function` right after a case/default LABEL colon → var-hoist (DEFVAR undefined)
    (if (i32.and (i32.and (i32.ge_s (local.get $swdepth) (i32.const 0)) (i32.eq (local.get $bd) (local.get $swdepth)))
          (i32.and (local.get $waslabel) (i32.and (i32.eq (local.get $k) (i32.const 3)) (call $tok_is_kw (cstring "function")))))
      (then (call $vm_hoist_clause_fn (local.get $code)) (call $next_token) (set! $prevk (i32.const 18)) (set! $prevelse (i32.const 0)) (br $scan)))
    (if (i32.or (i32.eq (local.get $k) (i32.const 15)) (i32.eq (local.get $k) (i32.const 19)))
      (then (set! $pd (i32.add (local.get $pd) (i32.const 1)))))
    (if (i32.and (i32.or (i32.eq (local.get $k) (i32.const 16)) (i32.eq (local.get $k) (i32.const 20))) (i32.gt_s (local.get $pd) (i32.const 0)))
      (then (set! $pd (i32.sub (local.get $pd) (i32.const 1)))))
    (if (i32.eq (local.get $k) (i32.const 3))
      (then
        (if (call $tok_is_kw (cstring "function"))
          (then
            ;; ASI: `function` on a new line after an expression-completing token (number/string/ident/`]`)
            ;; begins a fresh statement → hoistable declaration (`var x = 5\nfunction f(){}`). `)` excluded
            ;; so `if(x)\nfunction f` stays an AnnexB clause (handled in the else branch below).
            (if (i32.and (i32.eqz (local.get $pd)) (i32.or (call $vm_stmt_pos (local.get $prevk))
                  (i32.and (call $nl_before)
                    (i32.or (i32.eq (local.get $prevk) (i32.const 1)) (i32.or (i32.eq (local.get $prevk) (i32.const 2))
                    (i32.or (i32.eq (local.get $prevk) (i32.const 3)) (i32.eq (local.get $prevk) (i32.const 20))))))))
              (then  ;; statement-position function declaration
                (if (i32.eqz (local.get $bd))
                  (then  ;; TRUE top level → value-hoist (function bound to its value at program entry)
                    (let $hfnm i32 (call $vm_c_function (local.get $code)))
                    (if (local.get $hfnm)
                      (then (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $hfnm)))
                      (else (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Function statements require a function name")) (return))))  ;; anonymous FunctionDeclaration

                  (else  ;; block-nested (AnnexB B.3.3): var-scoped binding = undefined at program entry; the
                    ;; block's own execution assigns the function value (Get f before the block sees undefined)
                    (call $vm_hoist_clause_fn (local.get $code)) (call $next_token)))
                (set! $prevk (i32.const 18)) (set! $prevelse (i32.const 0)))
              (else
                (if (i32.and (i32.eqz (local.get $bd)) (i32.and (i32.eqz (local.get $pd)) (i32.or (i32.eq (local.get $prevk) (i32.const 16)) (local.get $prevelse))))
                  (then (call $vm_hoist_clause_fn (local.get $code)))  ;; AnnexB clause fn at true top level → DEFVAR NAME + skip
                  (else (call $hoist_skip_fn)))  ;; expression / block-interior clause fn → skip body (cursor at '}')
                ;; both skip paths leave the cursor ON the fn body's '}', whose matching '{' was consumed
                ;; internally (never seen by this loop) — so advance past it, else the loop mis-decrements $bd.
                (call $next_token) (set! $prevk (i32.const 18)) (set! $prevelse (i32.const 0))))
            (br $scan)))
        (if (call $tok_is_kw (cstring "var"))
          (then
            (call $next_token)
            (if (i32.eq (call $tok_kind) (i32.const 3))
              ;; CreateGlobalVarBinding semantics: define undefined ONLY if absent (DEFVAR),
              ;; so a `var X` hoist never clobbers an already-hoisted `function X` (or an
              ;; earlier var). STOREVAR (unconditional) overwrote the function with undefined.
              ;; Hoist EVERY identifier declarator in the list (`var a, b=1, c`), not just the first —
              ;; else `b=…` before its `var b` runs would create a stray global. (Leaves the list
              ;; terminator unconsumed and br $scan, so the outer loop tracks its brace/paren depth.)
              (then
                (block $phdone (loop $phl
                  (br_if $phdone (i32.ne (call $tok_kind) (i32.const 3)))  ;; pattern / list end → stop
                  (call $vm_emit_op (local.get $code) (i32.const 78)) (call $vm_emit_op (local.get $code) (call $ident_name))  ;; DEFVAR NAME
                  (call $next_token)  ;; consume NAME
                  (if (i32.eq (call $tok_kind) (i32.const 24))  ;; '=' → skip initializer to the next top-level ','
                    (then
                      (call $next_token)
                      (let $phd i32 (i32.const 0))
                      (let $pfst i32 (i32.const 1))  ;; first initializer token — ASI can't apply right after '='
                      (block $psep (loop $psl
                        (let $pik i32 (call $tok_kind))
                        (br_if $phdone (i32.eqz (local.get $pik)))  ;; EOF
                        ;; ASI: a LineTerminator before a non-',' token at depth 0 (past the first) ends the stmt
                        (br_if $phdone (i32.and (i32.eqz (local.get $pfst)) (i32.and (i32.eqz (local.get $phd)) (i32.and (call $nl_before) (i32.ne (local.get $pik) (i32.const 22))))))
                        (set! $pfst (i32.const 0))
                        (if (i32.or (i32.eq (local.get $pik) (i32.const 15)) (i32.or (i32.eq (local.get $pik) (i32.const 19)) (i32.eq (local.get $pik) (i32.const 17))))
                          (then (set! $phd (i32.add (local.get $phd) (i32.const 1))) (call $next_token) (br $psl)))  ;; ( [ {
                        (if (i32.or (i32.eq (local.get $pik) (i32.const 16)) (i32.or (i32.eq (local.get $pik) (i32.const 20)) (i32.eq (local.get $pik) (i32.const 18))))
                          (then (br_if $phdone (i32.eqz (local.get $phd))) (set! $phd (i32.sub (local.get $phd) (i32.const 1))) (call $next_token) (br $psl)))  ;; ) ] } — depth-0 closer ends the stmt
                        (br_if $phdone (i32.and (i32.eqz (local.get $phd)) (i32.eq (local.get $pik) (i32.const 21))))  ;; ';'
                        (if (i32.and (i32.eqz (local.get $phd)) (i32.eq (local.get $pik) (i32.const 22))) (then (call $next_token) (br $psep)))  ;; top-level ','
                        (call $next_token) (br $psl)))
                      (br $phl))
                    (else  ;; no initializer: ',' → next declarator; else the list ends
                      (br_if $phdone (i32.ne (call $tok_kind) (i32.const 22)))
                      (call $next_token) (br $phl)))))
                (br $scan)))))))
    (set! $prevelse (i32.and (i32.eq (local.get $k) (i32.const 3)) (call $tok_is_kw (cstring "else"))))
    (set! $prevk (local.get $k))
    (call $next_token)
    (br $scan))))

(func $vm_compile_prog (param $ptr i32) (param $len i32) (param $prelude i32) (result i32) (effects)
  (i32.store (i32.const 868) (i32.load (i32.const 872))) (i32.store (i32.const 872) (i32.const 0))  ;; super-property allowed for this compile = reg872 (set by a DIRECT eval whose caller has a [[HomeObject]]); default 0
  (i32.store (i32.const 884) (i32.load (i32.const 888))) (i32.store (i32.const 888) (i32.const 0))  ;; super() call allowed for this compile = reg888 (direct eval inside a derived ctor); default 0
  (i32.store (i32.const 208) (i32.const 0)) (i32.store (i32.const 216) (i32.const 0))  ;; no enclosing loop
  (i32.store (i32.const 224) (i32.const 0)) (i32.store (i32.const 232) (i32.const 0))  ;; temp counter, async flag
  (i32.store (i32.const 240) (i32.const 0))  ;; typeof-operand depth
  (i32.store (i32.const 912) (i32.const 0))  ;; in-static-block flag (reset per compile; balanced save/restore otherwise)
  (i32.store (i32.const 920) (i32.const 0))  ;; in-function-body flag: 0 for program/eval code (`return` at top level is a SyntaxError)
  (i32.store (i32.const 972) (i32.const 0))  ;; using-allowed container flag: 0 at the top level of a Script/eval (a `using` there is a SyntaxError; a Block/FunctionBody/for-head sets it to 1)
  (i32.store (i32.const 916) (i32.const 0))  ;; arguments-forbidden flag (static block / field initializer)
  (i32.store (i32.const 244) (i32.const 0)) (i32.store (i32.const 248) (i32.const 0)) (i32.store (i32.const 228) (i32.const 0))  ;; labels: pending, current, depth
  (i32.store (i32.const 932) (i32.const 0))  ;; label-find floor (0 = program top; raised at each function boundary)
  (i32.store (i32.const 940) (i32.const 0))  ;; unary-before-** flag (transient; cleared each vm_c_pow)
  (i32.store (i32.const 252) (call $heap_alloc (i32.const 2800)))  ;; label-entry stack (stride 28 → 100 nested labels)
  (i32.store (i32.const 320) (i32.const 0)) (i32.store (i32.const 772) (call $heap_alloc (i32.const 512)))  ;; finally stack base (moved 340→772: 340 overlapped the i64 Function.prototype @336-343, so nested eval/Function-ctor corrupted Function.prototype)
  (i32.store (i32.const 360) (i32.const 0))  ;; innermost loop's finally-base
  (i32.store (i32.const 372) (i32.const 0)) (i32.store (i32.const 376) (call $heap_alloc (i32.const 1024)))  ;; fn-hoist position list
  (i32.store (i32.const 388) (i32.load (i32.const 892))) (i32.store (i32.const 892) (i32.const 0))  ;; compile-time strict flag: seeded from reg 892 (a DIRECT eval inherits its caller's strictness); 0 for a fresh program
  (i32.store (i32.const 1008) (i32.load (i32.const 1012))) (i32.store (i32.const 1012) (i32.const 0))  ;; new.target-allowed: seeded from reg 1012 (direct eval in a function); 0 for a fresh script → top-level new.target is a SyntaxError
  ;; Size the code buffer to the source: bytecode is bounded by a small multiple
  ;; of source length (densest real case ~5 bytes/char; 16 is a safe ceiling),
  ;; plus a fixed 128 KB base that covers the always-compiled Error prelude. A
  ;; flat 4 MB buffer used to LEAK 4 MB per (nested/repeated) eval — the bump
  ;; allocator ran dry after ~5 evals (memory access out of bounds).
  (let $code i32 (call $heap_alloc (i32.add (i32.mul (local.get $len) (i32.const 16)) (i32.const 131072))))
  (call $vm_set_emit_cursor (i32.const 0))
  ;; the Error-hierarchy prelude is compiled into the same buffer first, so its
  ;; constructors exist (as VM functions) before user code runs (new ReferenceError, etc.).
  ;; ONLY for a fresh top-level program ($prelude=1). A nested eval / Function-ctor ($prelude=0)
  ;; runs in the caller's scope, which already chains to the global prelude bindings — re-running
  ;; it there REDEFINED Error/TypeError/… (breaking `TypeError===TypeError` across an eval) and
  ;; recompiled ~100 lines per call. Skip it for nested eval.
  (if (local.get $prelude)
    (then
      (let $pre i32 (call $prelude_src))
      (call $set_src (i32.add (local.get $pre) (i32.const 4)) (call $str_len (local.get $pre)))
      (call $lex_init)
      (call $next_token)
      (block $pe (loop $pl
        (br_if $pe (i32.eq (call $tok_kind) (i32.const 0)))
        (br_if $pe (call $err))
        (call $vm_c_stmt (local.get $code))
        (br $pl)))))
  ;; program-level "use strict" directive → the whole program (and its functions,
  ;; incl. hoisted ones) is strict. Detect BEFORE vm_hoist so hoisted fns inherit it.
  (call $set_src (local.get $ptr) (local.get $len))
  (call $lex_init)
  (call $set_pos (call $hashbang_len))  ;; skip a leading #! hashbang line
  (call $next_token)
  ;; scan the whole Directive Prologue (not just the first statement) for "use strict".
  (block $ppe (loop $ppl
    (br_if $ppe (i32.ne (call $tok_kind) (i32.const 2)))  ;; not a string literal → prologue ended
    (let $pisus i32 (i32.and (i32.eq (call $tok_len) (i32.const 10)) (call $str_eq (call $decode_str (i32.add (call $src) (call $tok_start)) (call $tok_len)) (cstring "use strict"))))  ;; source text exactly `use strict`, no escapes/LC (see vm_c_fnbody)
    (call $next_token)
    (br_if $ppe (i32.eqz (i32.or (call $nl_before)
      (i32.or (i32.eq (call $tok_kind) (i32.const 21))
      (i32.or (i32.eq (call $tok_kind) (i32.const 18))
      (i32.or (i32.eq (call $tok_kind) (i32.const 0))
              (i32.eq (call $tok_kind) (i32.const 2))))))))
    (if (local.get $pisus) (then (i32.store (i32.const 388) (i32.const 1))))
    (if (i32.eq (call $tok_kind) (i32.const 21)) (then (call $next_token)))
    (br $ppl)))
  ;; Early Error: a '#name' reference outside any class body is invalid (empty private-name scope). Only
  ;; for a fresh top-level program — a nested/direct eval ($prelude=0) may legitimately reference the
  ;; enclosing method's class private names, which this flat scan cannot see.
  (if (local.get $prelude)
    (then
      (call $vm_toplevel_priv_check (local.get $ptr) (local.get $len))
      (if (call $err) (then (return (local.get $code))))))
  ;; hoist the user program's var declarations (define as undefined up front)
  (call $set_src (local.get $ptr) (local.get $len))
  (call $lex_init)
  (call $set_pos (call $hashbang_len))  ;; skip a leading #! hashbang line
  (call $vm_hoist (local.get $code))
  ;; reset the completion register at runtime AFTER the prelude (whose trailing
  ;; expression statements leave a value in mem 288) and BEFORE user code, so a
  ;; user program with no expression statement (e.g. `var x`, ``) completes to undefined.
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef))
  (call $vm_emit_op (local.get $code) (i32.const 71))  ;; SETCOMPLETION undefined
  ;; now compile the user program
  (call $set_src (local.get $ptr) (local.get $len))
  (call $lex_init)
  (call $set_pos (call $hashbang_len))  ;; skip a leading #! hashbang line
  (call $next_token)
  ;; Early Error: the program/eval top-level LexicallyDeclaredNames must have no duplicates and be
  ;; disjoint from the VarDeclaredNames (`let x; let x`, `let x; var x`). Cursor restored by the scan.
  (call $vm_lex_dup_scan (i32.const 0) (i32.const 0) (i32.const 1))
  (if (call $err) (then (return (local.get $code))))
  (block $e (loop $l
    (br_if $e (i32.eq (call $tok_kind) (i32.const 0)))
    (br_if $e (call $err))
    ;; top-level `function name(){}` was already compiled+bound by vm_hoist — skip it
    (if (i32.and (i32.eq (call $tok_kind) (i32.const 3)) (call $tok_is_kw (cstring "function")))
      (then (call $hoist_skip_fn) (call $next_token))
      (else (call $vm_c_stmt (local.get $code))))
    (br $l)))
  (call $vm_emit_op (local.get $code) (i32.const 0))  ;; HALT
  (local.get $code))

;; compile a single arithmetic expression, HALT-terminated
(func $vm_compile (param $ptr i32) (param $len i32) (result i32) (effects)
  (call $set_src (local.get $ptr) (local.get $len))
  (call $lex_init)
  (call $next_token)
  (let $code i32 (call $heap_alloc (i32.const 8192)))
  (call $vm_set_emit_cursor (i32.const 0))
  (call $vm_c_add (local.get $code))
  (call $vm_emit_op (local.get $code) (i32.const 0))  ;; HALT
  (local.get $code))

;; compile a ';'-separated list of expressions, YIELDing each — a stand-in for a
;; generator body, to exercise suspend/resume. Layout: [expr YIELD]* HALT
(func $vm_compile_gen (param $ptr i32) (param $len i32) (result i32) (effects)
  (call $set_src (local.get $ptr) (local.get $len))
  (call $lex_init)
  (call $next_token)
  (let $code i32 (call $heap_alloc (i32.const 8192)))
  (call $vm_set_emit_cursor (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.eq (call $tok_kind) (i32.const 0)))  ;; EOF
    (call $vm_c_add (local.get $code))
    (call $vm_emit_op (local.get $code) (i32.const 7))  ;; YIELD
    (br_if $e (i32.ne (call $tok_kind) (i32.const 21)))  ;; ';'
    (call $next_token)
    (br $l)))
  (call $vm_emit_op (local.get $code) (i32.const 0))  ;; HALT
  (local.get $code))

;; ── resumable VM context — execution state reified in memory ──
;; layout: @0 code, @4 ip, @8 stack, @12 sp, @16 done, @20 scope (current),
;;         @24 curframe (in-memory call-frame chain), @28 gscope (globals)
(func $vm_new (param $code i32) (result i32) (effects)
  (let $ctx i32 (call $heap_alloc (i32.const 48)))
  (let $gs i32 (call $scope_new (i32.const 0) (i32.const 256)))
  (call $setup_globals (local.get $gs))  ;; builtins, prototypes, Math, etc.
  (call $setup_gen_protos)
  (call $scope_define (local.get $gs) (cstring "this") (call $mk_obj (local.get $gs)))  ;; global `this` = the global object
  (i32.store (local.get $ctx) (local.get $code))
  (i32.store (i32.add (local.get $ctx) (i32.const 4)) (i32.const 0))           ;; ip
  (i32.store (i32.add (local.get $ctx) (i32.const 8)) (call $heap_alloc (i32.const 1048576)))  ;; operand stack (1 MB; heap grows on demand)
  (i32.store (i32.add (local.get $ctx) (i32.const 12)) (i32.const 0))          ;; sp
  (i32.store (i32.add (local.get $ctx) (i32.const 16)) (i32.const 0))          ;; done
  (i32.store (i32.add (local.get $ctx) (i32.const 20)) (local.get $gs))        ;; current scope = globals
  (i32.store (i32.add (local.get $ctx) (i32.const 24)) (i32.const 0))          ;; no active frame
  (i32.store (i32.add (local.get $ctx) (i32.const 28)) (local.get $gs))        ;; global scope (closure parent)
  (i32.store (i32.add (local.get $ctx) (i32.const 32)) (i32.const 0))          ;; exception handler chain
  (i32.store (i32.add (local.get $ctx) (i32.const 36)) (i32.const 0))  ;; await resume flag
  (local.get $ctx))

(func $vm_done (param $ctx i32) (result i32) (effects) (i32.load (i32.add (local.get $ctx) (i32.const 16))))

;; A called function's enclosing scope is its captured closureScope (@24), or
;; the provided fallback (global scope) for statically-built fns (class methods,
;; empty constructors) that never ran a CLOSURE op.
(func $vm_fn_parent (param $fn i32) (param $fallback i32) (result i32) (effects)
  (let $cs i32 (i32.load (i32.add (local.get $fn) (i32.const 24))))
  (if i32 (local.get $cs) (then (local.get $cs)) (else (local.get $fallback))))

;; x instanceof F for VM functions: the prototype object is at fn@16, and an
;; instance's scope-parent chain links to it (see the NEW opcode). Native fns
;; (Map/Set/…) fall back to the production js_instanceof.
;; OrdinaryHasInstance(C=f, O=x) — the @@hasInstance-free proto-chain check. Used by
;; the instanceof operator's default path AND by Function.prototype[Symbol.hasInstance]
;; (native 451), so it must NOT consult @@hasInstance (that would recurse).
(func $ordinary_has_instance (param $x i64) (param $f i64) (result i64) (effects)
  ;; the RHS must be callable; a non-callable RHS is a TypeError
  (if (i32.eqz (call $is_function (local.get $f)))
    (then (call $throw_type (cstring "TypeError") (cstring "Right-hand side of 'instanceof' is not callable")) (return (call $v_false))))
  ;; bound function: instanceof follows [[BoundTargetFunction]] → x instanceof target
  (if (i32.eq (i32.load (call $val_payload (local.get $f))) (i32.const 1448232540))
    (then (return (call $vm_instanceof (local.get $x) (i64.load (i32.add (call $val_payload (local.get $f)) (i32.const 24)))))))
  (if (i32.or (call $is_array (local.get $x)) (call $is_function (local.get $x))) (then (return (call $js_instanceof (local.get $x) (local.get $f)))))  ;; arrays/functions → general path
  (if (i32.eqz (call $is_object (local.get $x))) (then (return (call $v_false))))
  (let $fp i32 (call $val_payload (local.get $f)))
  (if (i32.ne (i32.load (local.get $fp)) (i32.const 1448232526))
    (then (return (call $js_instanceof (local.get $x) (local.get $f)))))  ;; native ctor
  (let $proto i64 (call $get_prop (local.get $f) (call $mk_str (cstring "prototype"))))  ;; via [[Get]] (materializes a lazily-created @16, e.g. for Function()-created fns)
  ;; OrdinaryHasInstance: a non-object .prototype is a TypeError (not a false result)
  (if (i32.eqz (i32.or (call $is_object (local.get $proto)) (i32.or (call $is_array (local.get $proto)) (call $is_function (local.get $proto)))))
    (then (call $throw_type (cstring "TypeError") (cstring "Function has non-object prototype in instanceof check")) (return (call $v_false))))
  ;; walk x's [[Prototype]] chain via js_get_prototype (honors @@protoval array/function prototypes,
  ;; null-terminates) comparing each link to F.prototype as a VALUE (so a function/array proto matches).
  (let $ohi_cur i64 (call $js_get_prototype (local.get $x)))
  (block $brk (loop $cont
    (if (call $err) (then (return (call $v_false))))
    (if (i32.or (call $is_null (local.get $ohi_cur)) (call $is_undefined (local.get $ohi_cur))) (then (br $brk)))
    (if (call $strict_eq (local.get $ohi_cur) (local.get $proto)) (then (return (call $v_true))))
    (set! $ohi_cur (call $js_get_prototype (local.get $ohi_cur)))
    (br $cont)))
  (call $v_false))

(func $vm_instanceof (param $x i64) (param $f i64) (result i64) (effects)
  ;; a custom [Symbol.hasInstance] method on the RHS takes precedence (works even
  ;; when the RHS isn't itself callable)
  (if (i32.or (call $is_object (local.get $f)) (i32.or (call $is_function (local.get $f)) (call $is_array (local.get $f))))
    (then
      (let $hinst i64 (call $get_prop (local.get $f) (call $make_symbol (cstring "@@hasInstance") (cstring "Symbol.hasInstance"))))
      (if (call $is_function (local.get $hinst))
        (then
          (let $hiav i32 (call $heap_alloc (i32.const 8)))
          (i64.store (local.get $hiav) (local.get $x))
          (return (call $mk_bool (call $truthy (call $call_val (local.get $hinst) (i32.const 1) (local.get $hiav) (local.get $f)))))))))
  (call $ordinary_has_instance (local.get $x) (local.get $f)))

;; infer .name for an anonymous VM-fn value from a property key (string/number →
;; ToString; symbol → "[desc]" or "" if no description), optional prefix ("get "/
;; "set "/0). No-ops on named fns, non-VM fns, and non-functions.
(func $vm_infer_name (param $fnval i64) (param $keyval i64) (param $prefix i32) (effects)
  (if (i32.eqz (call $is_function (local.get $fnval))) (then (return)))
  (let $fp i32 (call $val_payload (local.get $fnval)))
  (if (i32.eqz (i32.and (i32.ge_s (i32.load (local.get $fp)) (i32.const 1448232526)) (i32.le_s (i32.load (local.get $fp)) (i32.const 1448232528)))) (then (return)))
  (let $noff i32 (i32.add (i32.add (local.get $fp) (i32.const 28)) (i32.mul (i32.load (i32.add (local.get $fp) (i32.const 8))) (i32.const 4))))
  (if (i32.load (local.get $noff)) (then (return)))  ;; already named
  (let $kn i32 (if i32 (call $is_symbol (local.get $keyval))
    (then (if i32 (i32.eqz (call $str_len (call $sym_desc_str (local.get $keyval))))
      (then (cstring ""))
      (else (call $str_concat (cstring "[") (call $str_concat (call $sym_desc_str (local.get $keyval)) (cstring "]"))))))
    (else (call $to_str (local.get $keyval)))))
  (i32.store (local.get $noff) (if i32 (local.get $prefix) (then (call $str_concat (local.get $prefix) (local.get $kn))) (else (local.get $kn)))))

;; apply a flat field-inits array [name, thunk-or-undefined, ...] to a target object:
;; for each, the value is thunk.call(target) (or the undefined sentinel) → own prop.
;; Used for per-instance fields (target=instance) and static fields (target=constructor).
;; CreateDataPropertyOrThrow(thisobj, key, value) for a class field on a plain-object receiver:
;; define an OWN data property {W,E,C} — do NOT invoke an inherited setter, and THROW a TypeError
;; if the object is non-extensible (new key) or already has a non-configurable own key of that name.
;; (Fields on a function/array receiver — static fields, exotic subclasses — stay on set_prop.)
(func $vm_field_define (param $thisobj i64) (param $key i64) (param $value i64) (effects)
  (let $os i32 (call $val_payload (local.get $thisobj)))
  (let $ks i32 (call $to_prop_key (local.get $key)))
  (let $old i32 (call $scope_find_local (local.get $os) (local.get $ks)))
  ;; NOTE: PrivateFieldAdd's "already present → TypeError" (spec step 4) is NOT safely enforceable
  ;; here: private names are keyed by their text ("#x"), so a subclass field `#x` shadowing a base
  ;; `#x` (two DISTINCT private names, both legitimately on the instance) would false-positive
  ;; against the base #x already present (regressed privatefieldget-success-2). Needs per-class
  ;; private-name identity — see [[private-name-reflection-2026-06-20]].
  (if (i32.eqz (local.get $old))
    (then (if (call $scope_find_local (local.get $os) (cstring "@@noext"))  ;; new own prop on a non-extensible object → reject
      (then (call $throw_type (cstring "TypeError") (cstring "Cannot define class field, object is not extensible")) (return))))
    (else (if (i32.eqz (call $entry_configurable (local.get $old)))  ;; redefining a non-configurable own prop to {W,E,C} → reject
      (then (call $throw_type (cstring "TypeError") (cstring "Cannot redefine non-configurable class field")) (return)))))
  (call $scope_define_attr (local.get $os) (local.get $ks) (local.get $value) (i32.const 14)))  ;; {W,E,C}

(func $vm_apply_fields (param $thisobj i64) (param $fiv i64) (effects)
  (if (i32.eqz (call $is_array (local.get $fiv))) (then (return)))
  (let $fa i32 (call $val_payload (local.get $fiv)))
  (let $fln i32 (call $arr_len (local.get $fa)))
  (let $fi i32 (i32.const 0))
  (block $fe (loop $fl
    (br_if $fe (i32.ge_s (i32.add (local.get $fi) (i32.const 1)) (local.get $fln)))
    (let $fname i64 (call $arr_get (local.get $fa) (local.get $fi)))
    (let $fthunk i64 (call $arr_get (local.get $fa) (i32.add (local.get $fi) (i32.const 1))))
    ;; a static initialization block (sentinel name) just RUNS for side effects (this=ctor),
    ;; no property assignment. (NEST the guard: i32.and evaluates both, and val_payload on a
    ;; non-string fname — e.g. a computed numeric key — would deref garbage.)
    (let $fisblock i32 (i32.const 0))
    (if (call $is_string (local.get $fname))
      (then (if (call $str_eq (call $val_payload (local.get $fname)) (cstring "@@staticblock")) (then (set! $fisblock (i32.const 1))))))
    ;; a STATIC field named "prototype" (thisobj is the constructor function) is a
    ;; [[DefineOwnProperty]] against the ctor's non-configurable "prototype" → TypeError.
    (if (call $is_function (local.get $thisobj))
      (then (if (call $is_string (local.get $fname))
        (then (if (call $str_eq (call $val_payload (local.get $fname)) (cstring "prototype"))
          (then (call $throw_type (cstring "TypeError") (cstring "Cannot define a static class field named 'prototype'")) (return)))))))
    (if (local.get $fisblock)
      (then (drop (call $call_val (local.get $fthunk) (i32.const 0) (call $heap_alloc (i32.const 8)) (local.get $thisobj))))
      (else
        ;; run the initializer FIRST (its side effects, e.g. Object.freeze(this), happen before the
        ;; field is installed), then CreateDataPropertyOrThrow. A plain-object receiver uses the
        ;; define path (own {W,E,C}, throws on frozen/non-extensible, ignores an inherited setter);
        ;; a function/array receiver (static field / exotic subclass) keeps [[Set]].
        (let $fval i64 (if i64 (call $is_function (local.get $fthunk))
            (then (call $call_val (local.get $fthunk) (i32.const 0) (call $heap_alloc (i32.const 8)) (local.get $thisobj)))
            (else (local.get $fthunk))))  ;; undefined sentinel → undefined
        (if (call $err) (then (return)))  ;; initializer threw
        (if (call $is_object (local.get $thisobj))
          (then (call $vm_field_define (local.get $thisobj) (local.get $fname) (local.get $fval)))
          (else (call $set_prop (local.get $thisobj) (local.get $fname) (local.get $fval))))))
    (if (call $err) (then (return)))
    (set! $fi (i32.add (local.get $fi) (i32.const 2)))
    (br $fl)))
  )
;; define deferred static methods/accessors on the constructor's own-prop scope. The array
;; is flat triples [kind, key, fn, ...]; kind 0=method (non-enum {W,C} data), 1=getter, 2=setter.
(func $vm_apply_smeths (param $ctor i64) (param $arr i64) (effects)
  (if (i32.eqz (call $is_array (local.get $arr))) (then (return)))
  (let $a i32 (call $val_payload (local.get $arr)))
  (let $n i32 (call $arr_len (local.get $a)))
  (let $sc i32 (call $fn_def_scope (local.get $ctor)))  ;; ctor's own (static) prop scope
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.gt_s (i32.add (local.get $i) (i32.const 3)) (local.get $n)))
    (let $kind i32 (i32.trunc_f64_s (call $to_num (call $arr_get (local.get $a) (local.get $i)))))
    (let $key i64 (call $arr_get (local.get $a) (i32.add (local.get $i) (i32.const 1))))
    (let $fn i64 (call $arr_get (local.get $a) (i32.add (local.get $i) (i32.const 2))))
    (let $pk i32 (call $to_prop_key (local.get $key)))
    ;; a static method/accessor named "prototype" is a [[DefineOwnProperty]] on the ctor's
    ;; non-configurable, non-writable "prototype" — DefinePropertyOrThrow → TypeError.
    (if (call $str_eq (local.get $pk) (cstring "prototype"))
      (then (call $throw_type (cstring "TypeError") (cstring "Cannot redefine the 'prototype' property of a class constructor")) (return)))
    (if (i32.eqz (local.get $kind))
      (then  ;; method: infer name from key (computed); public → {W,C} non-enum, PRIVATE (#name) → read-only (attr 0)
        (call $vm_infer_name (local.get $fn) (local.get $key) (i32.const 0))
        (call $scope_define_attr (local.get $sc) (local.get $pk) (local.get $fn)
          (if i32 (i32.eq (call $str_byte (local.get $pk) (i32.const 0)) (i32.const 35)) (then (i32.const 0)) (else (i32.const 12)))))
      (else  ;; accessor: infer "get "/"set " name, install getter (kind 1) / setter (kind 2)
        (call $vm_infer_name (local.get $fn) (local.get $key) (if i32 (i32.eq (local.get $kind) (i32.const 1)) (then (cstring "get ")) (else (cstring "set "))))
        (call $scope_set_accessor (local.get $sc) (local.get $pk) (i32.eq (local.get $kind) (i32.const 1)) (local.get $fn))
        ;; class static accessor → non-enumerable {E:false,C:true}; force ACC|C (clear the default E bit)
        (let $aslot i32 (call $scope_find_local (local.get $sc) (local.get $pk)))
        (if (local.get $aslot) (then (i32.store (i32.sub (local.get $aslot) (i32.const 4)) (i32.const 5))))))
    (set! $i (i32.add (local.get $i) (i32.const 3)))
    (br $l)))
  )
;; per-instance fields: read the prototype's @@fieldinits and apply to the instance.
;; Walk the prototype chain BASE-FIRST so a subclass instance also gets its
;; superclasses' field initializers (a super() call invokes the parent constructor
;; body but not its field inits), and a subclass field overriding an inherited one
;; runs last and wins.
(func $vm_run_field_inits (param $thisobj i64) (param $protoval i64) (effects)
  (if (i32.eqz (call $is_object (local.get $protoval))) (then (return)))
  (let $parentproto i64 (call $js_get_prototype (local.get $protoval)))
  (if (call $is_object (local.get $parentproto))
    (then (call $vm_run_field_inits (local.get $thisobj) (local.get $parentproto))))
  (let $fislot i32 (call $scope_find_local (call $val_payload (local.get $protoval)) (cstring "@@fieldinits")))
  (if (local.get $fislot) (then (call $vm_apply_fields (local.get $thisobj) (i64.load (local.get $fislot))))))
;; run ONLY this class level's own instance-field initializers (no proto-chain recursion). With the
;; this-TDZ model each class's fields run right after ITS `this` is set — base at ctor entry, derived
;; via the RUNFIELDS op right after super(). Clears reg 640/656 (super-construct / parked newTarget)
;; across the thunks so a field-initializer CALL isn't mis-read as a construct.
(func $vm_run_own_fields (param $thisobj i64) (param $protoval i64) (effects)
  (if (i32.eqz (call $is_object (local.get $protoval))) (then (return)))
  (let $fislot i32 (call $scope_find_local (call $val_payload (local.get $protoval)) (cstring "@@fieldinits")))
  (if (local.get $fislot)
    (then
      (let $sav640 i32 (i32.load (i32.const 640)))
      (let $sav656 i64 (i64.load (i32.const 656)))
      (i32.store (i32.const 640) (i32.const 0))
      (i64.store (i32.const 656) (i64.const 0))
      (call $vm_apply_fields (local.get $thisobj) (i64.load (local.get $fislot)))
      (i32.store (i32.const 640) (local.get $sav640))
      (i64.store (i32.const 656) (local.get $sav656)))))

;; run from the context's saved (ip, sp) until the next YIELD or HALT.
;; YIELD → returns the yielded value, state saved for the next call (done=0).
;; HALT  → sets done=1, returns the final top-of-stack value (or undefined).
;; This is the mechanism the re-scan evaluator structurally cannot provide.
(func $vm_step (param $ctx i32) (param $resumeval i64) (result i64) (effects)
  (let $code i32 (i32.load (local.get $ctx)))
  (let $stack i32 (i32.load (i32.add (local.get $ctx) (i32.const 8))))
  (let $ip i32 (i32.load (i32.add (local.get $ctx) (i32.const 4))))
  (let $sp i32 (i32.load (i32.add (local.get $ctx) (i32.const 12))))
  (let $scope i32 (i32.load (i32.add (local.get $ctx) (i32.const 20))))
  (let $frame i32 (i32.load (i32.add (local.get $ctx) (i32.const 24))))
  (let $gscope i32 (i32.load (i32.add (local.get $ctx) (i32.const 28))))
  (let $handler i32 (i32.load (i32.add (local.get $ctx) (i32.const 32))))  ;; try/catch handler chain
  (i32.store (i32.const 204) (local.get $gscope))  ;; active VM globals, for the native->VM callback bridge
  ;; resuming after AWAIT: push the resolved value so the await-expression yields it
  (if (i32.load (i32.add (local.get $ctx) (i32.const 36)))
    (then
      (i32.store (i32.add (local.get $ctx) (i32.const 36)) (i32.const 0))
      (i64.store (i32.add (local.get $stack) (local.get $sp)) (local.get $resumeval))
      (set! $sp (i32.add (local.get $sp) (i32.const 8)))))
  (loop $disp
    ;; a native (assert, get_prop on null, throw_type, …) raised an error via the
    ;; engine err flag — convert it into a VM exception (unwind to handler / halt)
    (if (call $err)
      (then
        (let $exc i64 (call $err_val))
        (call $set_err (i32.const 0))
        ;; return-completion unwind (gen.return() while suspended in a try): the sentinel
        ;; reg832 carries no catchable value — only try/finally handlers (runOnReturn=1) run
        ;; (the finally body), catch / iterator-close handlers are popped without executing.
        ;; The finally tail re-throws the sentinel, walking outward; when it escapes all
        ;; handlers, vm_gen_return turns it into { value, done:true }.
        (if (i64.eq (local.get $exc) (i64.load (i32.const 832)))
          (then (block $rdone (loop $rskip
            (br_if $rdone (i32.eqz (local.get $handler)))
            (br_if $rdone (i32.load (i32.add (local.get $handler) (i32.const 24))))  ;; runOnReturn → stop, run it
            (set! $handler (i32.load (i32.add (local.get $handler) (i32.const 20))))  ;; skip catch/iter-close
            (br $rskip)))))
        (if (i32.eqz (local.get $handler))  ;; uncaught → re-raise to the host and halt
          (then (call $set_err (i32.const 1)) (call $set_err_val (local.get $exc))
                (i32.store (i32.add (local.get $ctx) (i32.const 16)) (i32.const 1)) (return (local.get $exc))))
        (set! $frame (i32.load (i32.add (local.get $handler) (i32.const 8))))
        (set! $sp (i32.load (i32.add (local.get $handler) (i32.const 12))))
        (set! $scope (i32.load (i32.add (local.get $handler) (i32.const 16))))
        (set! $ip (i32.load (local.get $handler)))
        (call $scope_define (local.get $scope) (i32.load (i32.add (local.get $handler) (i32.const 4))) (local.get $exc))
        (set! $handler (i32.load (i32.add (local.get $handler) (i32.const 20))))
        (br $disp)))
    (let $op i32 (i32.load (i32.add (local.get $code) (local.get $ip))))
    (set! $ip (i32.add (local.get $ip) (i32.const 4)))
    (if (i32.eq (local.get $op) (i32.const 0))  ;; HALT
      (then
        (i32.store (i32.add (local.get $ctx) (i32.const 16)) (i32.const 1))
        (i32.store (i32.add (local.get $ctx) (i32.const 4)) (local.get $ip))
        (i32.store (i32.add (local.get $ctx) (i32.const 12)) (local.get $sp))
        (i32.store (i32.add (local.get $ctx) (i32.const 20)) (local.get $scope))
        (i32.store (i32.add (local.get $ctx) (i32.const 24)) (local.get $frame))
        (i32.store (i32.add (local.get $ctx) (i32.const 32)) (local.get $handler))
        (return (if i64 (i32.gt_s (local.get $sp) (i32.const 0))
                  (then (i64.load (i32.add (local.get $stack) (i32.sub (local.get $sp) (i32.const 8)))))
                  (else (call $v_undef))))))
    (if (i32.eq (local.get $op) (i32.const 77))  ;; GENPRO_SUSPEND — suspend after eager param prologue; resume pushes nothing
      (then
        (i32.store (i32.add (local.get $ctx) (i32.const 4)) (local.get $ip))
        (i32.store (i32.add (local.get $ctx) (i32.const 12)) (local.get $sp))
        (i32.store (i32.add (local.get $ctx) (i32.const 20)) (local.get $scope))
        (i32.store (i32.add (local.get $ctx) (i32.const 24)) (local.get $frame))
        (i32.store (i32.add (local.get $ctx) (i32.const 32)) (local.get $handler))
        (i32.store (i32.add (local.get $ctx) (i32.const 36)) (i32.const 0))  ;; resume pushes nothing
        (i32.store (i32.add (local.get $ctx) (i32.const 40)) (i32.const 0))  ;; not a yield* suspend
        (return (call $v_undef))))
    (if (i32.eq (local.get $op) (i32.const 7))  ;; YIELD — suspend; resume pushes the .next(v) argument
      (then
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
        (i32.store (i32.add (local.get $ctx) (i32.const 4)) (local.get $ip))
        (i32.store (i32.add (local.get $ctx) (i32.const 12)) (local.get $sp))
        (i32.store (i32.add (local.get $ctx) (i32.const 20)) (local.get $scope))
        (i32.store (i32.add (local.get $ctx) (i32.const 24)) (local.get $frame))
        (i32.store (i32.add (local.get $ctx) (i32.const 32)) (local.get $handler))
        (i32.store (i32.add (local.get $ctx) (i32.const 36)) (i32.const 1))  ;; resume pushes the value (yield expression result)
        (i32.store (i32.add (local.get $ctx) (i32.const 40)) (i32.const 0))  ;; not a yield* suspend (a .throw/.return here throws/unwinds)
        (i32.store (i32.const 708) (i32.const 0))  ;; suspend-kind = yield (for the async-generator driver)
        (return (i64.load (i32.add (local.get $stack) (local.get $sp))))))
    (if (i32.eq (local.get $op) (i32.const 104))  ;; YIELDSTAR — like YIELD but marks a yield* delegation point:
      (then                                        ;; .throw()/.return() resume here as data (rkind) rather than throw/unwind
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
        (i32.store (i32.add (local.get $ctx) (i32.const 4)) (local.get $ip))
        (i32.store (i32.add (local.get $ctx) (i32.const 12)) (local.get $sp))
        (i32.store (i32.add (local.get $ctx) (i32.const 20)) (local.get $scope))
        (i32.store (i32.add (local.get $ctx) (i32.const 24)) (local.get $frame))
        (i32.store (i32.add (local.get $ctx) (i32.const 32)) (local.get $handler))
        (i32.store (i32.add (local.get $ctx) (i32.const 36)) (i32.const 1))  ;; resume pushes the value
        (i32.store (i32.add (local.get $ctx) (i32.const 40)) (i32.const 1))  ;; yield* suspend
        (i32.store (i32.const 708) (i32.const 0))  ;; suspend-kind = yield
        (return (i64.load (i32.add (local.get $stack) (local.get $sp))))))
    (if (i32.eq (local.get $op) (i32.const 108))  ;; CHECKSUPER — derived ctor reached its end without super() → ReferenceError
      (then
        (if (i32.eqz (call $scope_find (local.get $scope) (cstring "@@superok")))
          (then (call $throw_type (cstring "ReferenceError") (cstring "Must call super constructor before accessing 'this' or returning from derived constructor"))
                (br $disp)))
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 109))  ;; DERIVEDRETCHECK — validate a derived ctor's `return value` (value on TOS, peeked)
      (then
        (let $drv i64 (i64.load (i32.add (local.get $stack) (i32.sub (local.get $sp) (i32.const 8)))))
        (if (call $is_undefined (local.get $drv))
          (then  ;; `return undefined`/`return;` → result is `this`, which requires super() first
            (if (i32.eqz (call $scope_find (local.get $scope) (cstring "@@superok")))
              (then (call $throw_type (cstring "ReferenceError") (cstring "Must call super constructor in derived class before returning")) (br $disp))))
          (else  ;; a non-undefined, non-object return value from a derived ctor → TypeError
            (if (i32.eqz (i32.or (call $is_object (local.get $drv)) (i32.or (call $is_array (local.get $drv)) (i32.or (call $is_function (local.get $drv)) (call $is_proxy (local.get $drv))))))
              (then (call $throw_type (cstring "TypeError") (cstring "Derived constructors may only return object or undefined")) (br $disp)))))
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 105))  ;; LOADRKIND — push the resume kind (reg836: 0 next / 1 throw / 2 return)
      (then
        (i64.store (i32.add (local.get $stack) (local.get $sp)) (call $num (f64.convert_i32_s (i32.load (i32.const 836)))))
        (set! $sp (i32.add (local.get $sp) (i32.const 8)))
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 107))  ;; LOADACTION — push the yield*-step action (reg840: 0 yield / 1 done-continue / 2 gen-return)
      (then
        (i64.store (i32.add (local.get $stack) (local.get $sp)) (call $num (f64.convert_i32_s (i32.load (i32.const 840)))))
        (set! $sp (i32.add (local.get $sp) (i32.const 8)))
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 106))  ;; YSSTEP — [it, recv, rkind] → one yield* delegation step; pushes value, action→reg840
      (then
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
        (let $ysk i32 (i32.trunc_f64_s (call $to_num (i64.load (i32.add (local.get $stack) (local.get $sp))))))
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
        (let $ysrecv i64 (i64.load (i32.add (local.get $stack) (local.get $sp))))
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
        (let $ysit i64 (i64.load (i32.add (local.get $stack) (local.get $sp))))
        (i64.store (i32.add (local.get $stack) (local.get $sp)) (call $yieldstar_step (local.get $ysit) (local.get $ysrecv) (local.get $ysk)))
        (set! $sp (i32.add (local.get $sp) (i32.const 8)))
        (br $disp)))
    (if (i32.eq (local.get $op) (i32.const 50))  ;; AWAIT — suspend, resume pushes the resolved value
      (then
        (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
        (i32.store (i32.add (local.get $ctx) (i32.const 4)) (local.get $ip))
        (i32.store (i32.add (local.get $ctx) (i32.const 12)) (local.get $sp))
        (i32.store (i32.add (local.get $ctx) (i32.const 20)) (local.get $scope))
        (i32.store (i32.add (local.get $ctx) (i32.const 24)) (local.get $frame))
        (i32.store (i32.add (local.get $ctx) (i32.const 32)) (local.get $handler))
        (i32.store (i32.add (local.get $ctx) (i32.const 36)) (i32.const 1))  ;; next resume pushes the value
        (i32.store (i32.add (local.get $ctx) (i32.const 40)) (i32.const 0))  ;; not a yield* suspend
        (i32.store (i32.const 708) (i32.const 1))  ;; suspend-kind = await (for the async-generator driver)
        (return (i64.load (i32.add (local.get $stack) (local.get $sp))))))
