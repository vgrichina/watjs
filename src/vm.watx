        ;; instance accessor → proto via DEFGET/DEFSET.
        (if (local.get $isstatic)
          (then
            (set! $hassmeth (i32.const 1))
            (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $smethT))  ;; LOADVAR smethT
            (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $num (f64.convert_i32_s (if i32 (local.get $gsi) (then (i32.const 1)) (else (i32.const 2))))))  ;; kind 1=get/2=set
            (call $vm_emit_op (local.get $code) (i32.const 52)))  ;; APPEND kind
          (else (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $protoT))))  ;; LOADVAR proto
        (if (i32.eq (call $tok_kind) (i32.const 19))  ;; [computed] key
          (then (call $next_token) (call $vm_c_expr (local.get $code)) (call $next_token))  ;; '[' expr ']' → key on stack
          (else  ;; literal key: string → decoded; number → canonical ToString; else identifier text
            (set! $ganame (if i32 (i32.eq (call $tok_kind) (i32.const 2)) (then (call $decode_str (i32.add (call $src) (call $tok_start)) (call $tok_len)))
              (else (if i32 (i32.eq (call $tok_kind) (i32.const 1)) (then (call $num_to_str (call $tok_num))) (else (call $ident_name))))))
            (call $next_token)
            (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_str (local.get $ganame)))))  ;; literal key
        (if (local.get $isstatic) (then (call $vm_emit_op (local.get $code) (i32.const 52))))  ;; APPEND key (static)
        (i32.store (i32.const 692) (i32.const 1))  ;; class accessor → no .prototype
        (i32.store (i32.const 700) (i32.add (local.get $memberstart) (i32.const 1)))  ;; class method source span
        (call $vm_c_fnbody (local.get $code) (i32.const 0))  ;; accessor fn → static: [smethT, fn]; instance: [proto, key, fn]
        (if (local.get $ganame)  ;; accessor .name = "get "/"set " + key
          (then (call $vm_emit_op (local.get $code) (i32.const 72)) (call $vm_emit_op (local.get $code) (call $str_concat (if i32 (local.get $gsi) (then (cstring "get ")) (else (cstring "set "))) (local.get $ganame)))))
        (if (local.get $isstatic)
