              (call $vm_emit_op (local.get $code) (i32.const 72)) (call $vm_emit_op (local.get $code) (local.get $mn))  ;; method .name = key
              (call $vm_emit_op (local.get $code) (i32.const 73)) (call $vm_emit_op (local.get $code) (local.get $mn))  ;; DEFMETH (non-enumerable)
              (call $vm_emit_op (local.get $code) (i32.const 11))))))))
