      (then (set! $found (i32.or (local.get $found) (i32.const 4)))))
    (if (i32.and (i32.eq (local.get $depth) (i32.const 1)) (i32.eq (local.get $k) (i32.const 3)))
      (then
        (if (i32.or (call $tok_is_kw (cstring "let")) (i32.or (call $tok_is_kw (cstring "const")) (i32.or (call $tok_is_kw (cstring "class")) (call $tok_is_kw (cstring "using")))))
          (then (set! $found (i32.or (local.get $found) (i32.const 1)))))  ;; bit0: needs a block scope (let/const/class/using — a using-only block still needs its scope for disposal at exit)
        ;; bit1: a possible block-level FunctionDeclaration (function / generator / async function). A
        ;; false positive (function EXPRESSION) only makes the dup check run harmlessly — that check is
        ;; statement-position-aware. Its LexicallyDeclaredNames still need the duplicate early-error scan.
        (if (i32.or (call $tok_is_kw (cstring "function")) (call $tok_is_kw (cstring "async")))
          (then (set! $found (i32.or (local.get $found) (i32.const 2)))))))
    (set! $prevfn (i32.and (i32.eq (local.get $k) (i32.const 3)) (call $tok_is_kw (cstring "function"))))
    (set! $prevasync (i32.and (i32.eq (local.get $k) (i32.const 3)) (call $tok_is_kw (cstring "async"))))
    (call $next_token) (br $l)))
  (call $cursor_restore (local.get $sv))
  (local.get $found))

;; A statement must terminate with a ';' or an ASI-eligible boundary: a LineTerminator before the next
;; token, a '}', or EOF. Consume the ';' when present; otherwise raise a SyntaxError unless ASI applies.
(func $vm_eat_stmt_end (effects)
  (if (i32.eq (call $tok_kind) (i32.const 21))
    (then (call $next_token))
    (else (if (i32.eqz (i32.or (call $nl_before) (i32.or (i32.eq (call $tok_kind) (i32.const 18)) (i32.eq (call $tok_kind) (i32.const 0)))))
      (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Unexpected token; expected ';' or a line break")))))))

;; statement compiler — emits bytecode (control flow via jumps, not re-scanning)
(func $vm_c_stmt (param $code i32) (effects)
  ;; "no lexical declaration here" flag (reg 900): set by the callers that supply a single Statement
  ;; slot (if/else/while/do/for bodies, labelled sub-statement). Read + clear immediately so it governs
  ;; ONLY this statement — a nested block/loop re-arms it for its own body. A let/const/class
  ;; declaration in such a slot is a SyntaxError (it is a StatementListItem, not a Statement).
  (let $nodecl i32 (i32.load (i32.const 900)))
  (i32.store (i32.const 900) (i32.const 0))
  ;; reg 936 = "no FunctionDeclaration here even by AnnexB" — set by loop bodies (while/for/do/for-in/of)
  ;; and `with`, where a plain function is a SyntaxError (unlike an if/else/label slot, which allows the
  ;; sloppy AnnexB function). Read + clear so it governs only this statement.
  (let $nofndecl i32 (i32.load (i32.const 936)))
  (i32.store (i32.const 936) (i32.const 0))
  ;; a single-statement slot (if/else/while/do/for/for-in/for-of body, per reg 900/936) REQUIRES a
  ;; Statement — a closer/EOF here means the body is missing (`for(;false;)`, `if(1)}`) → SyntaxError.
  ;; (An empty `;` body is a valid EmptyStatement, kind 21, and is not caught.)
  (if (i32.and (i32.or (local.get $nodecl) (local.get $nofndecl))
               (i32.or (i32.eqz (call $tok_kind)) (i32.or (i32.eq (call $tok_kind) (i32.const 18)) (i32.or (i32.eq (call $tok_kind) (i32.const 16)) (i32.eq (call $tok_kind) (i32.const 20))))))
    (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Unexpected token: a statement is required here")) (return)))
  ;; `with` is a reserved word in strict mode → early SyntaxError. Sloppy `with` is supported
  ;; (see the `with` handler below + scope_find's with-object delegation).
  (if (i32.and (i32.load (i32.const 388)) (i32.and (i32.eq (call $tok_kind) (i32.const 3)) (call $tok_is_kw (cstring "with"))))
    (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Strict mode code may not include a with statement")) (return)))
  ;; labeled statement:  IDENT : stmt   (the next loop picks up the pending label)
  (if (i32.eq (call $tok_kind) (i32.const 3))
    (then
      (call $look_save)
      (let $lblnm i32 (call $ident_name)) (call $next_token)
      (if (i32.eq (call $tok_kind) (i32.const 37))  ;; ':'
        (then
          ;; a LabelIdentifier may not be `await` in an async body / `yield` in a generator body
          (if (i32.or (i32.and (i32.load (i32.const 896)) (call $str_eq (local.get $lblnm) (cstring "await")))
                      (i32.and (i32.load (i32.const 672)) (call $str_eq (local.get $lblnm) (cstring "yield"))))
            (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "'await'/'yield' is a reserved label identifier here")) (return)))
          ;; a LabelIdentifier may not be a ReservedWord (`finally: ;`, `in: ;`, `typeof: ;`, …)
          (if (call $is_reserved_word (local.get $lblnm))
            (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Unexpected reserved word as label")) (return)))
          ;; nor a strict-reserved word under strict mode (`"use strict"; static: ;`)
          (if (i32.and (i32.load (i32.const 388)) (call $is_strict_reserved (local.get $lblnm)))
            (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Unexpected strict-mode reserved word as label")) (return)))
          ;; a label may not duplicate an ENCLOSING label (ContainsDuplicateLabels) — `L: { L: ; }` is a
          ;; SyntaxError (sibling `L: ; L: ;` is fine — a label's scope is only the statement it labels).
          (if (call $vm_label_find (local.get $lblnm))
            (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "duplicate label")) (return)))
          (call $next_token)
          ;; a LabelledItem that is a FunctionDeclaration is Annex B (sloppy) only, and only for a PLAIN
          ;; function — strict mode and generator function declarations are SyntaxErrors.
          (if (call $tok_is_kw (cstring "function"))
            (then
              ;; the AnnexB B.3.1 labelled-function relaxation does NOT apply when the LabelledStatement is
              ;; itself in a no-function-declaration slot (an iteration/with body, reg 936 → $nofndecl):
              ;; `for (…) L: function f(){}` / `while (…) L1: L2: function f(){}` are SyntaxErrors.
              (if (local.get $nofndecl)
                (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "function declaration not allowed as a labelled iteration-statement body")) (return)))
              (if (i32.load (i32.const 388))
                (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "In strict mode code, functions can only be declared at top level or inside a block")) (return)))
              (call $look_save) (call $next_token)
              (let $lblgen i32 (i32.eq (call $tok_kind) (i32.const 12)))  ;; `function*` → generator
              (call $look_restore)
              (if (local.get $lblgen)
                (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Generator function declarations cannot be labelled")) (return)))))
          (if (i32.or (call $tok_is_kw (cstring "for")) (i32.or (call $tok_is_kw (cstring "while")) (call $tok_is_kw (cstring "do"))))
            (then  ;; labeled loop — the loop consumes the pending label (break/continue both work)
              (i32.store (i32.const 244) (local.get $lblnm))
              (i32.store (i32.const 900) (i32.const 1))  ;; a lexical decl cannot be labelled
              (call $vm_c_stmt (local.get $code))
              (i32.store (i32.const 244) (i32.const 0)))
            (else  ;; labeled non-loop (block/if/switch/…) — `break LABEL` jumps past it
              (let $le i32 (call $vm_label_push (local.get $lblnm) (i32.const 0)))  ;; non-loop labeled statement → isloop=0 (not a valid `continue` target)
              (i32.store (i32.const 900) (i32.const 1))  ;; a lexical decl cannot be labelled
              (if (local.get $nofndecl) (then (i32.store (i32.const 936) (i32.const 1))))  ;; propagate the no-fn-decl slot through nested labels (`L1: L2: function` in a loop body)
              (call $vm_c_stmt (local.get $code))
              (call $vm_patch_entry_list (local.get $le) (i32.const 4) (i32.const 8) (local.get $code) (call $vm_emit_cursor))  ;; break list → here
              (i32.store (i32.const 228) (i32.sub (i32.load (i32.const 228)) (i32.const 1)))))  ;; pop label
          (return))
        (else (call $look_restore)))))
  ;; with (expr) stmt — delegate variable lookups in the body to expr's object.
  (if (call $tok_is_kw (cstring "with"))
    (then
      (call $next_token)  ;; 'with'
      (if (i32.load (i32.const 388))  ;; strict mode: `with` is a SyntaxError
        (then
          (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "'with' statements are not allowed in strict mode"))
          (if (i32.eq (call $tok_kind) (i32.const 15)) (then (call $vm_skip_balanced)))  ;; skip '(...)' so the parser makes progress (result is discarded)
          (return)))
      (if (i32.ne (call $tok_kind) (i32.const 15)) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Expected '(' after 'with'")) (return)))
      (call $next_token)  ;; '('
      (call $vm_c_commaexpr (local.get $code))  ;; object → [obj]  (a full Expression, comma allowed)
      (if (i32.ne (call $tok_kind) (i32.const 16)) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Expected ')' after with object")) (return)))
      (call $next_token)  ;; ')'
      (call $vm_emit_op (local.get $code) (i32.const 93))  ;; ENTERWITH (consumes obj, pushes with-scope)
      (call $vm_finally_push_scope)  ;; break/continue/return through the body must pop the with-scope
      (i32.store (i32.const 900) (i32.const 1)) (i32.store (i32.const 936) (i32.const 1))  ;; with-body is a single Statement — no lexical/async/gen/function decl
      (call $vm_c_stmt (local.get $code))  ;; body
      (call $vm_finally_pop)
      (call $vm_emit_op (local.get $code) (i32.const 94))  ;; LEAVEWITH (normal completion)
      (return)))
  ;; block { ... }
  (if (i32.eq (call $tok_kind) (i32.const 17))
    (then
      ;; a block with a top-level let/const/class needs its own lexical scope so those bindings
      ;; don't clobber/leak to the enclosing scope. Push it (nameless ENTERSCOPE) + register a
      ;; kind-2 scope-pop so break/continue/return/labeled-break through the block pop it too.
      ;; the immediate function-body block is flagged (reg 856): don't give it its own scope.
      (let $isfnbody i32 (i32.load (i32.const 856))) (i32.store (i32.const 856) (i32.const 0))
      ;; a Block is one of the containers in which a `using` declaration is allowed (reg 972).
      (let $blkuok i32 (i32.load (i32.const 972))) (i32.store (i32.const 972) (i32.const 1))
      (let $blkbits i32 (if i32 (local.get $isfnbody) (then (i32.const 0)) (else (call $vm_block_has_lexical))))
      (let $blk i32 (i32.ne (i32.and (local.get $blkbits) (i32.const 5)) (i32.const 0)))  ;; bit0 (let/const/class) OR bit2 (lexical generator/async fn) → needs its own scope
      (if (local.get $blk)
        (then (call $vm_emit_op (local.get $code) (i32.const 113)) (call $vm_emit_op (local.get $code) (i32.const 0)) (call $vm_finally_push_scope)  ;; ENTERSCOPE 0
              (call $vm_hoist_lex (local.get $code))))  ;; pre-declare the block's let/const/class as v_tdz (TDZ before decl)
      (call $next_token)
      ;; Early Error: a block that declares lexical names (incl. block-level function declarations, bit1)
      ;; may not have duplicate LexicallyDeclaredNames or a lexical/var collision (same scan as a switch
      ;; CaseBlock; cursor now just past the block '{'). The scope is only for let/const/class, but the
      ;; duplicate-name early error applies to function declarations too.
      (if (local.get $blkbits) (then (call $vm_switch_dup_check (i32.const 1)) (if (call $err) (then (return)))))
      (block $be (loop $bl
        (br_if $be (i32.eq (call $tok_kind) (i32.const 18)))  ;; '}'
        (br_if $be (i32.eq (call $tok_kind) (i32.const 0)))
        (br_if $be (call $err))  ;; a compile-time SyntaxError stops the parser advancing → break (else infinite loop)
        (call $vm_c_stmt (local.get $code))
        (br $bl)))
      (call $next_token)  ;; consume '}'
      (i32.store (i32.const 972) (local.get $blkuok))  ;; restore the enclosing using-allowed state
      (if (local.get $blk)
        (then (call $vm_finally_pop) (call $vm_emit_op (local.get $code) (i32.const 94))))  ;; LEAVEWITH (normal completion)
      (return)))
  (if (i32.eq (call $tok_kind) (i32.const 3))
    (then
      ;; class NAME { constructor(...){...} method(){...} ... }
      (if (call $tok_is_kw (cstring "class"))
        (then
          (if (local.get $nodecl) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "class declaration not allowed in single-statement context")) (return)))
          (call $vm_c_class (local.get $code) (i32.const 0)) (return)))  ;; class declaration
      ;; async function … (mark the next function declaration async)
      (if (call $tok_is_kw (cstring "async"))
        (then
          (let $sasyncstart i32 (call $tok_start))  ;; 'async' offset for the source span
          (call $look_save)
          (call $next_token)
          ;; `async [no LineTerminator here] function` — a line break makes `async` a bare IdentifierReference
          ;; (its own ExpressionStatement), NOT the start of an async FunctionDeclaration.
          (if (call $tok_is_kw (cstring "function"))
            (then
              (if (call $nl_before)
                (then (call $look_restore))  ;; newline before `function` → `async` is an identifier
                (else (i32.store (i32.const 232) (i32.const 1)) (i32.store (i32.const 700) (i32.add (local.get $sasyncstart) (i32.const 1))))))  ;; fall through to the function-decl branch
            (else (call $look_restore)))))
      ;; function NAME ( params ) { body }   (declaration)
      (if (call $tok_is_kw (cstring "function"))
        (then
          ;; a FunctionDeclaration may NOT be the body of a loop (while/for/do/for-in/of) or `with` —
          ;; not even the AnnexB plain-function form allowed in an if/else/label slot.
          (if (local.get $nofndecl)
            (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "function declaration not allowed in single-statement context")) (return)))
          ;; the AnnexB B.3.4 relaxation (a plain FunctionDeclaration in an if/else/label single-statement
          ;; slot) is SLOPPY-mode only; in strict mode it is a SyntaxError. $nodecl marks the slot, reg 388 strict.
          (if (i32.and (local.get $nodecl) (i32.load (i32.const 388)))
            (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "function declaration not allowed in single-statement context in strict mode")) (return)))
          ;; an async/generator function declaration may not occupy a single-statement slot (no Annex B
          ;; exception, unlike a plain FunctionDeclaration in a sloppy if-body). reg 232 = async (set above).
          (if (local.get $nodecl)
            (then
              (call $look_save) (call $next_token) (let $isgenfn i32 (i32.eq (call $tok_kind) (i32.const 12))) (call $look_restore)
              (if (i32.or (i32.load (i32.const 232)) (local.get $isgenfn))
                (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "async/generator declaration not allowed in single-statement context")) (return)))))
          ;; already hoisted (compiled+bound at the top of this fn body)? skip it.
          (if (call $vm_hoist_contains (call $pos))
            (then (call $vm_skip_fn_decl) (return)))
          (let $fnm i32 (call $vm_c_function (local.get $code)))  ;; emits PUSH fn
          (if (local.get $fnm)
            (then (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $fnm)))  ;; STOREVAR
            ;; a statement-position FunctionDeclaration requires a name (`function(){}` / `function*(){}` /
            ;; `async function(){}` → SyntaxError); only a function EXPRESSION (via primary) may be anonymous.
            (else (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Function statements require a function name")) (return)))
          (return)))
      ;; return [expr] ;   (tail call peephole: trailing CALL → TAILCALL)
      (if (call $tok_is_kw (cstring "return"))
        (then
          ;; `return` is not allowed in a class static block (it is not a function body)
          (if (i32.load (i32.const 912)) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "'return' is not allowed in a class static block")) (return)))
          ;; `return` outside any function body (top-level program / eval code) is a SyntaxError.
          (if (i32.eqz (i32.load (i32.const 920))) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "'return' outside of function")) (return)))
          (call $next_token)
          ;; in a DERIVED class ctor, `return expr` must be Object/undefined (else TypeError) and
          ;; `return undefined`/`return;` requires super() first (else ReferenceError) — DERIVEDRETCHECK (109).
          (let $dctor i32 (i32.load (i32.const 852)))
          (if (i32.or (call $nl_before) (i32.or (i32.eq (call $tok_kind) (i32.const 21)) (i32.or (i32.eq (call $tok_kind) (i32.const 18)) (i32.eq (call $tok_kind) (i32.const 0)))))  ;; ASI: newline after `return` → return;
            (then
              (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef))
              (call $vm_finally_emit_all (local.get $code))  ;; run enclosing finally blocks first
              (if (local.get $dctor) (then (call $vm_emit_op (local.get $code) (i32.const 109))))
              (call $vm_emit_op (local.get $code) (i32.const 20))
              (drop (call $eat (i32.const 21)))
              (return)))
          (call $vm_c_commaexpr (local.get $code))
          ;; with an enclosing finally, the value is computed, the finally(s) run,
          ;; then RET — no tail-call peephole (the finally must run after the call).
          (if (i32.load (i32.const 320))
            (then
              (call $vm_finally_emit_all (local.get $code))
              (if (local.get $dctor) (then (call $vm_emit_op (local.get $code) (i32.const 109))))
              (call $vm_emit_op (local.get $code) (i32.const 20))  ;; RET
              (call $vm_eat_stmt_end)
              (return)))
          (if (local.get $dctor)  ;; derived ctor: validate the return value (no tail-call peephole)
            (then
              (call $vm_emit_op (local.get $code) (i32.const 109))
              (call $vm_emit_op (local.get $code) (i32.const 20))
              (call $vm_eat_stmt_end)
              (return)))
          (if (i32.eq (i32.load (i32.add (local.get $code) (i32.sub (call $vm_emit_cursor) (i32.const 8)))) (i32.const 19))  ;; ends in CALL?
            (then
              (i32.store (i32.add (local.get $code) (i32.sub (call $vm_emit_cursor) (i32.const 8))) (i32.const 21))  ;; → TAILCALL
              ;; Trailing CALL may be guarded by a short-circuit jump (&&/||/?:) patched
              ;; to *after* the call; TAILCALL never falls through, so emit a RET there
              ;; for the short-circuit path to land on (dead on the normal/tail path).
              (call $vm_emit_op (local.get $code) (i32.const 20)))  ;; RET (short-circuit fallthrough)
            (else (call $vm_emit_op (local.get $code) (i32.const 20))))  ;; RET
          (call $vm_eat_stmt_end)
          (return)))
      ;; `await using x = expr;` — an async ClassStaticBlock/function resource declaration. Only in an
      ;; async body (reg 896): `await [no LT] using [no LT] BindingIdentifier`. Compiled like the sync
      ;; `using` (const binding; Symbol.asyncDispose scope-exit disposal is a follow-up).
      (if (i32.and (i32.load (i32.const 896)) (call $tok_is_kw (cstring "await")))
        (then
          (call $look_save) (call $next_token)  ;; past 'await'
          (let $auok i32 (i32.const 0))
          (if (i32.and (i32.eqz (call $nl_before)) (call $tok_is_kw (cstring "using")))
            (then (call $next_token)  ;; past 'using'
              (set! $auok (i32.and (i32.eqz (call $nl_before)) (i32.or (i32.eq (call $tok_kind) (i32.const 17))
                (i32.and (i32.eq (call $tok_kind) (i32.const 3))
                  (i32.eqz (i32.or (call $tok_is_kw (cstring "in")) (i32.or (call $tok_is_kw (cstring "instanceof")) (call $tok_is_kw (cstring "of")))))))))))  ;; `await using {` → declaration attempt (ObjectBindingPattern rejected below)
          (call $look_restore)
          (if (local.get $auok)
            (then
              (if (local.get $nodecl) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "await using declaration not allowed in single-statement context")) (return)))
              ;; like `using`: not allowed in a switch CaseClause (reg 972) — only in a Block/FunctionBody/for-head
              (if (i32.eqz (i32.load (i32.const 972))) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "await using declaration only allowed in a block, function body, or for-head")) (return)))
              (call $next_token) (call $next_token)  ;; consume 'await' 'using'
              (block $aud (loop $aul
                (if (i32.or (i32.eq (call $tok_kind) (i32.const 19)) (i32.eq (call $tok_kind) (i32.const 17)))
                  (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "using declaration binding must be an identifier")) (return)))
                (let $aunm i32 (call $ident_name)) (call $next_token)
                (if (call $vm_strict_lhs_check (local.get $aunm)) (then (return)))
                (if (call $str_eq (local.get $aunm) (cstring "let")) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "'let' is not a valid lexical binding name")) (return)))
                (if (i32.ne (call $tok_kind) (i32.const 24)) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "using declaration requires an initializer")) (return)))
                (call $next_token)
                (let $auafs i32 (call $vm_emit_cursor))  ;; NamedEvaluation for `await using f = function/arrow/class(){}`
                (call $vm_c_expr (local.get $code))
                (if (call $vm_is_anon_fn_def (local.get $auafs)) (then (call $vm_emit_op (local.get $code) (i32.const 72)) (call $vm_emit_op (local.get $code) (local.get $aunm))))
                (call $vm_emit_op (local.get $code) (i32.const 120)) (call $vm_emit_op (local.get $code) (i32.const 1))  ;; CHECKDISPOSE async (validate [Symbol.asyncDispose] / [Symbol.dispose])
