                          ;; `{static}`, `{yield}`) is a SyntaxError under strict mode.
                          (if (call $is_reserved_word (local.get $oki)) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Unexpected reserved word as shorthand property")) (return)))
                          (if (i32.and (i32.load (i32.const 388)) (call $is_strict_reserved (local.get $oki))) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Unexpected strict-mode reserved word as shorthand property")) (return)))
                          (set! $oshort (i32.const 1)) (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $oki))))  ;; shorthand → LOADVAR
                      (if (call $vm_is_anon_fn_def (local.get $afs))  ;; `key: <anon fn>` → .name = key
                        (then (call $vm_emit_op (local.get $code) (i32.const 72)) (call $vm_emit_op (local.get $code) (local.get $oki))))
