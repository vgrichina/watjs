      (let $an i32 (call $ident_name)) (call $next_token)
      (if (i32.or (i32.eq (call $tok_kind) (i32.const 24)) (i32.or (call $is_compound_assign (call $tok_kind)) (i32.or (i32.and (i32.ge_s (call $tok_kind) (i32.const 59)) (i32.le_s (call $tok_kind) (i32.const 61))) (i32.or (i32.eq (call $tok_kind) (i32.const 38)) (i32.eq (call $tok_kind) (i32.const 39))))))  ;; = / op= / ||= / ++ / --
        (then
          ;; a keyword literal (true/false/null) or `this` is not a valid AssignmentTarget — reject before
          ;; the fast-path treats it as an assignable identifier name (`true = 1` / `this += 1`).
          (if (i32.or (call $str_eq (local.get $an) (cstring "true")) (i32.or (call $str_eq (local.get $an) (cstring "false")) (i32.or (call $str_eq (local.get $an) (cstring "null")) (call $str_eq (local.get $an) (cstring "this")))))
            (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "invalid assignment target")) (return)))
          (if (call $vm_strict_lhs_check (local.get $an)) (then (return)))))  ;; strict: eval/arguments target → SyntaxError
      (if (i32.eq (call $tok_kind) (i32.const 24))  ;; '='
        (then
          (call $next_token)
          (let $afs i32 (call $vm_emit_cursor))
          (call $vm_c_expr (local.get $code))
          (if (call $vm_is_anon_fn_def (local.get $afs))  ;; `x = <anon fn>` → x.name = "x"
            (then (call $vm_emit_op (local.get $code) (i32.const 72)) (call $vm_emit_op (local.get $code) (local.get $an))))
          (call $vm_emit_op (local.get $code) (i32.const 32))  ;; DUP → leave the assigned value as the statement completion
          (call $vm_emit_op (local.get $code) (if i32 (i32.load (i32.const 388)) (then (i32.const 80)) (else (i32.const 85)))) (call $vm_emit_op (local.get $code) (local.get $an))  ;; plain assign: strict→80 (ReferenceError if undeclared) / sloppy→85 (implicit global)
          (call $vm_emit_op (local.get $code) (i32.const 71))  ;; SETCOMPLETION (eval/global completion = assigned value)
          (call $vm_emit_stmt_comma_tail (local.get $code))  ;; consume a trailing `, expr` comma continuation
