;; ═══════════════════════════════════════════════════════════════
;; vm.watx — Phase 2: bytecode/threaded virtual machine (foundation)
;;
;; The re-scan evaluator keeps a call's execution state on the WASM call
;; stack, so it can never be snapshotted — which is exactly why generators,
;; async/await, and tail-call optimization are impossible there.
;;
;; This VM reifies execution state in LINEAR MEMORY: an instruction pointer
;; into a compiled bytecode array, plus an explicit operand stack. Because
;; that state is data, a future YIELD opcode can save (ip, sp) and return,
;; and resume by restoring them — the prerequisite for generators/async.
;; Tail calls become frame elision once call frames live in memory too.
;;
;; Milestone 1: compile + run arithmetic, validating the dispatch loop and
;; the in-memory operand stack. The compiler reuses the existing lexer, so
;; there is one front-end (as the design intended). Threaded dispatch via
;; call_indirect / return_call_indirect is a later perf step; the
;; suspend/resume property comes from in-memory state, not the dispatch form.
;;
;; Opcodes (one i32 word each; PUSH is followed by an 8-byte i64 JSValue):
;;   0 HALT   1 PUSH   2 ADD   3 SUB   4 MUL   5 DIV   6 NEG
;; ═══════════════════════════════════════════════════════════════

;; emit cursor (byte offset into the code buffer under construction) — reg 200
(func $vm_emit_cursor (result i32) (effects) (i32.load (i32.const 200)))
(func $vm_set_emit_cursor (param $c i32) (effects) (i32.store (i32.const 200) (local.get $c)))

(func $vm_emit_op (param $code i32) (param $op i32) (effects)
  (i32.store (i32.add (local.get $code) (call $vm_emit_cursor)) (local.get $op))
  (call $vm_set_emit_cursor (i32.add (call $vm_emit_cursor) (i32.const 4))))

(func $vm_emit_val (param $code i32) (param $v i64) (effects)
  (i64.store (i32.add (local.get $code) (call $vm_emit_cursor)) (local.get $v))
  (call $vm_set_emit_cursor (i32.add (call $vm_emit_cursor) (i32.const 8))))

;; emit a jump op with a placeholder target; returns the patch location (byte offset)
(func $vm_emit_jump (param $code i32) (param $op i32) (result i32) (effects)
  (call $vm_emit_op (local.get $code) (local.get $op))
  (let $loc i32 (call $vm_emit_cursor))
  (call $vm_emit_op (local.get $code) (i32.const 0))  ;; placeholder
  (local.get $loc))
(func $vm_patch (param $code i32) (param $loc i32) (effects)  ;; patch placeholder to current cursor
  (i32.store (i32.add (local.get $code) (local.get $loc)) (call $vm_emit_cursor)))

;; loop-context for break/continue: reg 208 break-list ptr, 212 break count,
;; 216 continue-list ptr, 220 continue count. Saved/restored around each loop.
;; ── labeled loops ──  reg 244 = pending label name (for the next loop),
;; 248 = current loop's label entry (0 if unlabeled), 252 = label-stack base,
;; 228 = label-stack depth. Entry: @0 name, @4 breaklist, @8 breakcount,
;; @12 contlist, @16 contcount.
(func $vm_label_push (param $name i32) (result i32) (effects)
  (let $cnt i32 (i32.load (i32.const 228)))
  (let $e i32 (i32.add (i32.load (i32.const 252)) (i32.mul (local.get $cnt) (i32.const 20))))
  (i32.store (local.get $e) (local.get $name))
  (i32.store (i32.add (local.get $e) (i32.const 4)) (call $heap_alloc (i32.const 1024)))
  (i32.store (i32.add (local.get $e) (i32.const 8)) (i32.const 0))
  (i32.store (i32.add (local.get $e) (i32.const 12)) (call $heap_alloc (i32.const 1024)))
  (i32.store (i32.add (local.get $e) (i32.const 16)) (i32.const 0))
  (i32.store (i32.const 228) (i32.add (local.get $cnt) (i32.const 1)))
  (local.get $e))
(func $vm_label_find (param $name i32) (result i32) (effects)
  (let $i i32 (i32.sub (i32.load (i32.const 228)) (i32.const 1)))
  (block $e (loop $l
    (br_if $e (i32.lt_s (local.get $i) (i32.const 0)))
    (let $en i32 (i32.add (i32.load (i32.const 252)) (i32.mul (local.get $i) (i32.const 20))))
    (if (call $str_eq (i32.load (local.get $en)) (local.get $name)) (then (return (local.get $en))))
    (set! $i (i32.sub (local.get $i) (i32.const 1)))
    (br $l)))
  (i32.const 0))
;; append a jump (the just-emitted JMP at `patch`) to a label entry's break(0)/cont(1) list
(func $vm_label_add (param $entry i32) (param $iscont i32) (param $patch i32) (effects)
  (let $loff i32 (if i32 (local.get $iscont) (then (i32.const 12)) (else (i32.const 4))))
  (let $coff i32 (if i32 (local.get $iscont) (then (i32.const 16)) (else (i32.const 8))))
  (let $list i32 (i32.load (i32.add (local.get $entry) (local.get $loff))))
  (let $c i32 (i32.load (i32.add (local.get $entry) (local.get $coff))))
  (i32.store (i32.add (local.get $list) (i32.mul (local.get $c) (i32.const 4))) (local.get $patch))
  (i32.store (i32.add (local.get $entry) (local.get $coff)) (i32.add (local.get $c) (i32.const 1))))

(func $vm_loop_enter (result i32) (effects)
  (let $save i32 (call $heap_alloc (i32.const 24)))
  (i32.store (local.get $save) (i32.load (i32.const 208)))
  (i32.store (i32.add (local.get $save) (i32.const 4)) (i32.load (i32.const 212)))
  (i32.store (i32.add (local.get $save) (i32.const 8)) (i32.load (i32.const 216)))
  (i32.store (i32.add (local.get $save) (i32.const 12)) (i32.load (i32.const 220)))
  (i32.store (i32.add (local.get $save) (i32.const 16)) (i32.load (i32.const 248)))  ;; prev curlabel
  (i32.store (i32.add (local.get $save) (i32.const 20)) (i32.load (i32.const 360)))  ;; prev loop's finally-base
  (i32.store (i32.const 360) (i32.load (i32.const 320)))  ;; this loop's finally-base = current finally depth
  (i32.store (i32.const 208) (call $heap_alloc (i32.const 1024))) (i32.store (i32.const 212) (i32.const 0))
  (i32.store (i32.const 216) (call $heap_alloc (i32.const 1024))) (i32.store (i32.const 220) (i32.const 0))
  ;; this loop's label entry: the pending label (if any), else none
  (i32.store (i32.const 248) (if i32 (i32.load (i32.const 244)) (then (call $vm_label_push (i32.load (i32.const 244)))) (else (i32.const 0))))
  (i32.store (i32.const 244) (i32.const 0))  ;; consume the pending label
  (local.get $save))
(func $vm_loop_exit (param $save i32) (effects)
  (if (i32.load (i32.const 248)) (then (i32.store (i32.const 228) (i32.sub (i32.load (i32.const 228)) (i32.const 1)))))  ;; pop this loop's label
  (i32.store (i32.const 208) (i32.load (local.get $save)))
  (i32.store (i32.const 212) (i32.load (i32.add (local.get $save) (i32.const 4))))
  (i32.store (i32.const 216) (i32.load (i32.add (local.get $save) (i32.const 8))))
  (i32.store (i32.const 220) (i32.load (i32.add (local.get $save) (i32.const 12))))
  (i32.store (i32.const 248) (i32.load (i32.add (local.get $save) (i32.const 16))))  ;; restore curlabel
  (i32.store (i32.const 360) (i32.load (i32.add (local.get $save) (i32.const 20)))))  ;; restore loop finally-base
;; ── finally completion ──  reg 320 = finally-stack depth, 340 = base ptr.
;; Each 4-byte entry = the finally block's '{' cursor (from cursor_save). A
;; `return` inside a try-with-finally must run all enclosing finally blocks first;
;; we re-emit them inline (innermost first) before the RET. Reset to 0 across a
;; nested function body so an inner return doesn't run the outer fn's finallys.
;; Each entry is 8 bytes: [kind:i32][data:i32]. kind 0 = a finally block's '{' source
;; cursor (try/finally). kind 1 = a for-of iterator-close (data = the iterator var name);
;; emitted as LOADVAR + CLOSEITER so `return` through a for-of closes its iterator.
(func $vm_finally_push (param $cur i32) (effects)
  (let $n i32 (i32.load (i32.const 320)))
  (let $e i32 (i32.add (i32.load (i32.const 340)) (i32.mul (local.get $n) (i32.const 8))))
  (i32.store (local.get $e) (i32.const 0))
  (i32.store (i32.add (local.get $e) (i32.const 4)) (local.get $cur))
  (i32.store (i32.const 320) (i32.add (local.get $n) (i32.const 1))))
(func $vm_finally_push_iter (param $itname i32) (effects)
  (let $n i32 (i32.load (i32.const 320)))
  (let $e i32 (i32.add (i32.load (i32.const 340)) (i32.mul (local.get $n) (i32.const 8))))
  (i32.store (local.get $e) (i32.const 1))
  (i32.store (i32.add (local.get $e) (i32.const 4)) (local.get $itname))
  (i32.store (i32.const 320) (i32.add (local.get $n) (i32.const 1))))
(func $vm_finally_pop (effects)
  (i32.store (i32.const 320) (i32.sub (i32.load (i32.const 320)) (i32.const 1))))
;; Re-emit finally blocks inline (innermost first) down to depth $base, before an
;; abrupt completion. While re-emitting entry i the active depth is set to i, so a
;; `return` inside that finally runs only the OUTER finallys (and naturally
;; overrides this completion). `return` uses base 0 (all enclosing finallys);
;; break/continue use the target loop's recorded finally-base (reg 360).
(func $vm_finally_emit_to (param $code i32) (param $base i32) (effects)
  (let $n i32 (i32.load (i32.const 320)))
  (let $i i32 (local.get $n))
  (block $e (loop $l
    (set! $i (i32.sub (local.get $i) (i32.const 1)))
    (br_if $e (i32.lt_s (local.get $i) (local.get $base)))
    (i32.store (i32.const 320) (local.get $i))
    (let $ent i32 (i32.add (i32.load (i32.const 340)) (i32.mul (local.get $i) (i32.const 8))))
    (if (i32.eq (i32.load (local.get $ent)) (i32.const 1))
      (then  ;; iterator close: LOADVAR itname; CLOSEITER (it.return()) — stack-neutral
        (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (i32.load (i32.add (local.get $ent) (i32.const 4))))
        (call $vm_emit_op (local.get $code) (i32.const 74)))
      (else  ;; finally source block
        (let $save i32 (call $cursor_save))
        (call $cursor_restore (i32.load (i32.add (local.get $ent) (i32.const 4))))
        (call $vm_c_stmt (local.get $code))  ;; the finally '{...}' block (stack-neutral)
        (call $cursor_restore (local.get $save))))
    (br $l)))
  (i32.store (i32.const 320) (local.get $n)))
(func $vm_finally_emit_all (param $code i32) (effects)
  (call $vm_finally_emit_to (local.get $code) (i32.const 0)))

;; ── function-declaration hoisting ──  reg 372 = count, 376 = base ptr (4-byte
;; source positions). A pre-scan compiles statement-position `function NAME`
;; declarations at the top of the function/program; the body-compile then SKIPS
;; them (matched by source position) so a redeclare/reassign before the decl line
;; isn't clobbered. Saved/restored across nested function bodies.
(func $vm_hoist_record (param $pos i32) (effects)
  (let $n i32 (i32.load (i32.const 372)))
  (if (i32.lt_s (local.get $n) (i32.const 256))  ;; cap (rare to exceed; silently ignore beyond)
    (then
      (i32.store (i32.add (i32.load (i32.const 376)) (i32.mul (local.get $n) (i32.const 4))) (local.get $pos))
      (i32.store (i32.const 372) (i32.add (local.get $n) (i32.const 1))))))
(func $vm_hoist_contains (param $pos i32) (result i32) (effects)
  (let $n i32 (i32.load (i32.const 372)))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    (if (i32.eq (i32.load (i32.add (i32.load (i32.const 376)) (i32.mul (local.get $i) (i32.const 4)))) (local.get $pos))
      (then (return (i32.const 1))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (i32.const 0))
;; statement-position test: a function declaration follows nothing (start),
;; ';', '{', or '}'  (an expression-position `function` follows '='/'('/','/return…).
(func $vm_stmt_pos (param $prevk i32) (result i32) (effects)
  (i32.or (i32.eqz (local.get $prevk)) (i32.or (i32.eq (local.get $prevk) (i32.const 17))
    (i32.or (i32.eq (local.get $prevk) (i32.const 18)) (i32.eq (local.get $prevk) (i32.const 21))))))
;; Scan the upcoming body for statement-position `function NAME` declarations at
;; depth==decldepth, compile each hoisted (CLOSURE+STOREVAR) and record its pos.
;; decldepth=1 for a function body (cursor at '{'); 0 for the program top level.
(func $vm_hoist_fns (param $code i32) (param $decldepth i32) (effects)
  (let $start i32 (call $cursor_save))
  (let $depth i32 (i32.const 0))
  (let $prevk i32 (i32.const 0))
  (block $he (loop $hl
    (let $k i32 (call $tok_kind))
    (br_if $he (i32.eqz (local.get $k)))  ;; EOF
    (if (i32.or (i32.eq (local.get $k) (i32.const 17)) (i32.or (i32.eq (local.get $k) (i32.const 15)) (i32.eq (local.get $k) (i32.const 19))))
      (then (set! $depth (i32.add (local.get $depth) (i32.const 1))) (set! $prevk (local.get $k)) (call $next_token) (br $hl)))
    (if (i32.or (i32.eq (local.get $k) (i32.const 18)) (i32.or (i32.eq (local.get $k) (i32.const 16)) (i32.eq (local.get $k) (i32.const 20))))
      (then (set! $depth (i32.sub (local.get $depth) (i32.const 1)))
            (br_if $he (i32.lt_s (local.get $depth) (local.get $decldepth)))  ;; body closed
            (set! $prevk (local.get $k)) (call $next_token) (br $hl)))
    (if (i32.and (i32.eq (local.get $depth) (local.get $decldepth))
          (i32.and (i32.eq (local.get $k) (i32.const 3))
            (i32.and (call $tok_is_kw (cstring "function")) (call $vm_stmt_pos (local.get $prevk)))))
      (then
        (call $vm_hoist_record (call $pos))
        (let $fnm i32 (call $vm_c_function (local.get $code)))  ;; emits PUSH fn (consumes the whole decl)
        (if (local.get $fnm)
          (then (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $fnm)))  ;; STOREVAR
          (else (call $vm_emit_op (local.get $code) (i32.const 11))))  ;; POP (anonymous — shouldn't happen for a decl)
        (set! $prevk (i32.const 21))
        (br $hl)))
    (set! $prevk (local.get $k)) (call $next_token) (br $hl)))
  (call $cursor_restore (local.get $start)))
;; skip a `function`/`function*` NAME (params){body} declaration without emitting
;; (used when it was already hoisted). Cursor at 'function'.
(func $vm_skip_fn_decl (effects)
  (call $next_token)  ;; 'function'
  (if (i32.eq (call $tok_kind) (i32.const 12)) (then (call $next_token)))  ;; '*'
  (if (i32.eq (call $tok_kind) (i32.const 3)) (then (call $next_token)))   ;; NAME
  (if (i32.eq (call $tok_kind) (i32.const 15)) (then (call $vm_skip_balanced)))  ;; (params)
  (if (i32.eq (call $tok_kind) (i32.const 17)) (then (call $vm_skip_balanced))))  ;; {body}
;; strict mode: `eval`/`arguments` may not be an assignment/update target (early
;; SyntaxError). Returns 1 (and raises a SyntaxError) if so — caller should return.
(func $vm_strict_lhs_check (param $name i32) (result i32) (effects)
  (if (i32.load (i32.const 388))
    (then (if (i32.or (call $str_eq (local.get $name) (cstring "eval")) (call $str_eq (local.get $name) (cstring "arguments")))
      (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Assignment to eval or arguments is not allowed in strict mode")) (return (i32.const 1))))))
  (i32.const 0))
;; patch unlabeled break/continue lists AND (if the current loop is labeled) the
;; label entry's matching list, all to `target`.
(func $vm_patch_breaks (param $code i32) (param $target i32) (effects)
  (call $vm_patch_list (i32.const 208) (i32.const 212) (local.get $code) (local.get $target))
  (if (i32.load (i32.const 248)) (then (call $vm_patch_entry_list (i32.load (i32.const 248)) (i32.const 4) (i32.const 8) (local.get $code) (local.get $target)))))
(func $vm_patch_conts (param $code i32) (param $target i32) (effects)
  (call $vm_patch_list (i32.const 216) (i32.const 220) (local.get $code) (local.get $target))
  (if (i32.load (i32.const 248)) (then (call $vm_patch_entry_list (i32.load (i32.const 248)) (i32.const 12) (i32.const 16) (local.get $code) (local.get $target)))))
(func $vm_patch_entry_list (param $entry i32) (param $loff i32) (param $coff i32) (param $code i32) (param $target i32) (effects)
  (let $list i32 (i32.load (i32.add (local.get $entry) (local.get $loff))))
  (let $n i32 (i32.load (i32.add (local.get $entry) (local.get $coff))))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    (i32.store (i32.add (local.get $code) (i32.load (i32.add (local.get $list) (i32.mul (local.get $i) (i32.const 4))))) (local.get $target))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l))))
;; patch every jump recorded in (listreg, countreg) to point at $target
(func $vm_patch_list (param $listreg i32) (param $countreg i32) (param $code i32) (param $target i32) (effects)
  (let $list i32 (i32.load (local.get $listreg)))
  (let $n i32 (i32.load (local.get $countreg)))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    (i32.store (i32.add (local.get $code) (i32.load (i32.add (local.get $list) (i32.mul (local.get $i) (i32.const 4))))) (local.get $target))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l))))

;; fresh unique temp variable name "@@t<n>" (for desugaring for-of), reg 224 counter
(func $vm_tmpname (result i32) (effects)
  (let $n i32 (i32.load (i32.const 224)))
  (i32.store (i32.const 224) (i32.add (local.get $n) (i32.const 1)))
  (call $str_concat (cstring "@@t") (call $num_to_str (f64.convert_i32_s (local.get $n)))))

;; coerce a value to an iterator: arrays → values-iterator; objects with
;; @@iterator → call it; objects with .next → themselves (generators included).
;; append the elements of an iterable `srcv` onto array `dst` (for `...spread`):
;; arrays/strings directly, any other object via the iterator protocol (next()).
(func $spread_into (param $dst i32) (param $srcv i64) (effects)
  (if (call $is_array (local.get $srcv))
    (then
      (let $sa i32 (call $val_payload (local.get $srcv)))
      (let $si i32 (i32.const 0))
      (block $ae (loop $al
        (br_if $ae (i32.ge_s (local.get $si) (call $arr_len (local.get $sa))))
        (call $arr_push (local.get $dst) (call $arr_get (local.get $sa) (local.get $si)))
        (set! $si (i32.add (local.get $si) (i32.const 1))) (br $al)))
      (return)))
  (if (call $is_string (local.get $srcv))
    (then
      (let $ssp i32 (call $val_payload (local.get $srcv)))
      (let $sn i32 (call $str_len (local.get $ssp)))
      (let $sci i32 (i32.const 0))
      (block $se (loop $sl
        (br_if $se (i32.ge_s (local.get $sci) (local.get $sn)))
        (call $arr_push (local.get $dst) (call $str_char_at (local.get $ssp) (local.get $sci)))
        (set! $sci (i32.add (local.get $sci) (i32.const 1))) (br $sl)))
      (return)))
  (if (call $is_object (local.get $srcv))
    (then
      (let $it i64 (call $vm_get_iter (local.get $srcv)))
      (let $nf i64 (call $get_prop (local.get $it) (call $mk_str (cstring "next"))))
      (if (call $is_function (local.get $nf))
        (then
          (let $nbuf i32 (call $heap_alloc (i32.const 8)))
          (block $ie (loop $il
            (let $r i64 (call $call_val (local.get $nf) (i32.const 0) (local.get $nbuf) (local.get $it)))
            (br_if $ie (call $err))  ;; next() threw → propagate (was: read done/value off undefined → OOB crash)
            (if (i32.eqz (i32.or (call $is_object (local.get $r)) (i32.or (call $is_array (local.get $r)) (call $is_function (local.get $r)))))
              (then (call $throw_type (cstring "TypeError") (cstring "iterator result is not an object")) (br $ie)))
            (let $rdone i64 (call $get_prop (local.get $r) (call $mk_str (cstring "done"))))
            (br_if $ie (call $err))
            (br_if $ie (call $truthy (local.get $rdone)))
            (let $rval i64 (call $get_prop (local.get $r) (call $mk_str (cstring "value"))))
            (br_if $ie (call $err))
            (call $arr_push (local.get $dst) (local.get $rval))
            (br $il))))))
  (if (i32.eqz (i32.or (call $is_array (local.get $srcv)) (i32.or (call $is_string (local.get $srcv)) (call $is_object (local.get $srcv)))))  ;; primitive (null/undefined/number/…) → not iterable
    (then (call $throw_type (cstring "TypeError") (cstring "is not iterable"))))))

(func $vm_get_iter (param $v i64) (result i64) (effects)
  (if (call $is_array (local.get $v))
    (then (return (call $call_native (i32.const 97) (i32.const 0) (call $heap_alloc (i32.const 8)) (local.get $v)))))
  (if (call $is_string (local.get $v))  ;; string → array of single-char strings, then array iterator
    (then
      (let $sp i32 (call $val_payload (local.get $v)))
      (let $sn i32 (call $str_len (local.get $sp)))
      (let $ca i32 (call $arr_new (local.get $sn)))
      (let $si i32 (i32.const 0))
      (block $se (loop $sl
        (br_if $se (i32.ge_s (local.get $si) (local.get $sn)))
        (call $arr_push (local.get $ca) (call $str_char_at (local.get $sp) (local.get $si)))
        (set! $si (i32.add (local.get $si) (i32.const 1)))
        (br $sl)))
      (return (call $call_native (i32.const 97) (i32.const 0) (call $heap_alloc (i32.const 8)) (call $mk_arr (local.get $ca))))))
  (if (call $is_object (local.get $v))
    (then
      (let $itf i64 (call $get_prop (local.get $v) (call $mk_str (cstring "@@iterator"))))
      (if (call $is_function (local.get $itf)) (then (return (call $call_val (local.get $itf) (i32.const 0) (call $heap_alloc (i32.const 8)) (local.get $v)))))
      (if (call $is_function (call $get_prop (local.get $v) (call $mk_str (cstring "next")))) (then (return (local.get $v))))  ;; already an iterator (generator/manual): has .next
      (call $throw_type (cstring "TypeError") (cstring "is not iterable")) (return (call $v_undef))))  ;; object with neither @@iterator nor next
  (call $throw_type (cstring "TypeError") (cstring "is not iterable")) (call $v_undef))  ;; primitive (null/undefined/number/boolean) — not iterable

;; template literal `text ${expr} more` → build a string: PUSH "" then for each
;; literal chunk / ${expr} part, concatenate (ADD = js_add does ToString).
(func $vm_c_template (param $code i32) (effects)
  (let $tbase i32 (i32.add (call $src) (call $tok_start)))
  (let $tlen i32 (call $tok_len))
  (call $next_token)  ;; consume the template token
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_str (cstring "")))  ;; PUSH ""
  (let $ti i32 (i32.const 0))
  (let $tlit i32 (cstring ""))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $ti) (local.get $tlen)))
    (let $tc i32 (i32.load8_u (i32.add (local.get $tbase) (local.get $ti))))
    (if (i32.and (i32.eq (local.get $tc) (i32.const 36)) (i32.eq (i32.load8_u (i32.add (local.get $tbase) (i32.add (local.get $ti) (i32.const 1)))) (i32.const 123)))
      (then  ;; ${ expr }
        (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_str (local.get $tlit)))  ;; PUSH chunk
        (call $vm_emit_op (local.get $code) (i32.const 2))  ;; ADD
        (set! $tlit (cstring ""))
        (set! $ti (i32.add (local.get $ti) (i32.const 2)))
        (let $tes i32 (local.get $ti))
        (let $tdepth i32 (i32.const 1))
        (block $ee (loop $el
          (br_if $ee (i32.ge_s (local.get $ti) (local.get $tlen)))
          (let $d i32 (i32.load8_u (i32.add (local.get $tbase) (local.get $ti))))
          (if (i32.eq (local.get $d) (i32.const 123)) (then (set! $tdepth (i32.add (local.get $tdepth) (i32.const 1)))))
          (if (i32.eq (local.get $d) (i32.const 125)) (then (set! $tdepth (i32.sub (local.get $tdepth) (i32.const 1))) (br_if $ee (i32.eqz (local.get $tdepth)))))
          (set! $ti (i32.add (local.get $ti) (i32.const 1)))
          (br $el)))
        (let $texpr i32 (call $str_from_src (i32.add (local.get $tbase) (local.get $tes)) (i32.sub (local.get $ti) (local.get $tes))))
        ;; redirect the lexer to the expr substring, compile it, then restore
        (let $tssrc i32 (call $src)) (let $tslen i32 (call $src_len)) (let $tscur i32 (call $cursor_save))
        (call $set_src (i32.add (local.get $texpr) (i32.const 4)) (call $str_len (local.get $texpr)))
        (call $lex_init) (call $next_token)
        (call $vm_c_expr (local.get $code))
        (call $set_src (local.get $tssrc) (local.get $tslen)) (call $cursor_restore (local.get $tscur))
        (call $vm_emit_op (local.get $code) (i32.const 2))  ;; ADD (concat with ToString)
        (set! $ti (i32.add (local.get $ti) (i32.const 1))))  ;; past }
      (else
        (let $tch i32 (local.get $tc))
        (if (i32.eq (local.get $tc) (i32.const 92))  ;; escape
          (then (set! $ti (i32.add (local.get $ti) (i32.const 1))) (set! $tch (call $esc_byte (i32.load8_u (i32.add (local.get $tbase) (local.get $ti)))))))
        (let $cs i32 (call $str_alloc (i32.const 1)))
        (call $str_set_byte (local.get $cs) (i32.const 0) (local.get $tch))
        (set! $tlit (call $str_concat (local.get $tlit) (local.get $cs)))
        (set! $ti (i32.add (local.get $ti) (i32.const 1)))))
    (br $l)))
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_str (local.get $tlit)))  ;; trailing chunk
  (call $vm_emit_op (local.get $code) (i32.const 2)))  ;; ADD

;; tagged template `tag`a${x}b`` — the tag fn is already on the stack. Builds the
;; (compile-time-constant) strings array [a,b] with a .raw copy, then calls
;; tag(strings, ...substitutions). Cooked == raw here (escape handling deferred).
(func $vm_c_tagged_template (param $code i32) (effects)
  (let $tbase i32 (i32.add (call $src) (call $tok_start)))
  (let $tlen i32 (call $tok_len))
  (call $next_token)  ;; consume template token
  (let $cooked i32 (call $arr_new (i32.const 4)))
  (let $raw i32 (call $arr_new (i32.const 4)))
  (let $subs i32 (call $heap_alloc (i32.const 256)))  ;; substitution-expr substrings
  (let $nsub i32 (i32.const 0))
  (let $ti i32 (i32.const 0))
  (let $lit i32 (cstring ""))
  (let $rawlit i32 (cstring ""))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $ti) (local.get $tlen)))
    (let $tc i32 (i32.load8_u (i32.add (local.get $tbase) (local.get $ti))))
    (if (i32.and (i32.eq (local.get $tc) (i32.const 36)) (i32.eq (i32.load8_u (i32.add (local.get $tbase) (i32.add (local.get $ti) (i32.const 1)))) (i32.const 123)))
      (then  ;; ${ expr } — close the current part, capture the expr
        (call $arr_push (local.get $cooked) (call $mk_str (local.get $lit)))
        (call $arr_push (local.get $raw) (call $mk_str (local.get $rawlit)))
        (set! $lit (cstring "")) (set! $rawlit (cstring ""))
        (set! $ti (i32.add (local.get $ti) (i32.const 2)))
        (let $tes i32 (local.get $ti))
        (let $tdepth i32 (i32.const 1))
        (block $ee (loop $el
          (br_if $ee (i32.ge_s (local.get $ti) (local.get $tlen)))
          (let $d i32 (i32.load8_u (i32.add (local.get $tbase) (local.get $ti))))
          (if (i32.eq (local.get $d) (i32.const 123)) (then (set! $tdepth (i32.add (local.get $tdepth) (i32.const 1)))))
          (if (i32.eq (local.get $d) (i32.const 125)) (then (set! $tdepth (i32.sub (local.get $tdepth) (i32.const 1))) (br_if $ee (i32.eqz (local.get $tdepth)))))
          (set! $ti (i32.add (local.get $ti) (i32.const 1)))
          (br $el)))
        (i32.store (i32.add (local.get $subs) (i32.mul (local.get $nsub) (i32.const 4))) (call $str_from_src (i32.add (local.get $tbase) (local.get $tes)) (i32.sub (local.get $ti) (local.get $tes))))
        (set! $nsub (i32.add (local.get $nsub) (i32.const 1)))
        (set! $ti (i32.add (local.get $ti) (i32.const 1))))  ;; past }
      (else
        (if (i32.eq (local.get $tc) (i32.const 92))
          (then  ;; escape: cooked gets esc_byte(next); raw keeps '\' + next verbatim
            (set! $ti (i32.add (local.get $ti) (i32.const 1)))
            (let $nx i32 (i32.load8_u (i32.add (local.get $tbase) (local.get $ti))))
            (let $cs i32 (call $str_alloc (i32.const 1))) (call $str_set_byte (local.get $cs) (i32.const 0) (call $esc_byte (local.get $nx)))
            (set! $lit (call $str_concat (local.get $lit) (local.get $cs)))
            (let $rs i32 (call $str_alloc (i32.const 2))) (call $str_set_byte (local.get $rs) (i32.const 0) (i32.const 92)) (call $str_set_byte (local.get $rs) (i32.const 1) (local.get $nx))
            (set! $rawlit (call $str_concat (local.get $rawlit) (local.get $rs))))
          (else
            (let $cs i32 (call $str_alloc (i32.const 1))) (call $str_set_byte (local.get $cs) (i32.const 0) (local.get $tc))
            (set! $lit (call $str_concat (local.get $lit) (local.get $cs)))
            (set! $rawlit (call $str_concat (local.get $rawlit) (local.get $cs)))))
        (set! $ti (i32.add (local.get $ti) (i32.const 1)))))
    (br $l)))
  (call $arr_push (local.get $cooked) (call $mk_str (local.get $lit)))  ;; trailing part
  (call $arr_push (local.get $raw) (call $mk_str (local.get $rawlit)))
  (call $scope_define (call $arr_props (local.get $cooked)) (cstring "raw") (call $mk_arr (local.get $raw)))
  ;; tag fn is on the stack; push the strings array (arg0) then each substitution
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_arr (local.get $cooked)))
  (let $si i32 (i32.const 0))
  (block $se (loop $sl
    (br_if $se (i32.ge_s (local.get $si) (local.get $nsub)))
    (let $sx i32 (i32.load (i32.add (local.get $subs) (i32.mul (local.get $si) (i32.const 4)))))
    (let $ss i32 (call $src)) (let $sln i32 (call $src_len)) (let $sc i32 (call $cursor_save))
    (call $set_src (i32.add (local.get $sx) (i32.const 4)) (call $str_len (local.get $sx)))
    (call $lex_init) (call $next_token)
    (call $vm_c_expr (local.get $code))
    (call $set_src (local.get $ss) (local.get $sln)) (call $cursor_restore (local.get $sc))
    (set! $si (i32.add (local.get $si) (i32.const 1)))
    (br $sl)))
  (call $vm_emit_op (local.get $code) (i32.const 19)) (call $vm_emit_op (local.get $code) (i32.add (local.get $nsub) (i32.const 1))))  ;; CALL (1 + nsub args)

;; ── compiler: source → bytecode (precedence-climbing, reuses the lexer) ──
(func $vm_c_primary (param $code i32) (effects)
  (if (i32.eq (call $tok_kind) (i32.const 1))  ;; NUM literal
    (then
      (call $vm_emit_op (local.get $code) (i32.const 1))      ;; PUSH
      (if (i32.load (i32.const 304))  ;; BigInt literal (123n)
        (then (call $vm_emit_val (local.get $code) (call $mk_bigint (i64.trunc_f64_s (call $tok_num)))))
        (else (call $vm_emit_val (local.get $code) (call $num (call $tok_num)))))
      (call $next_token)
      (return)))
  (if (i32.eq (call $tok_kind) (i32.const 53))  ;; template literal
    (then (call $vm_c_template (local.get $code)) (return)))
  (if (i32.eq (call $tok_kind) (i32.const 57))  ;; regex literal → new RegExp(pattern, flags)
    (then
      (let $rpat i32 (call $str_from_src (i32.add (call $src) (call $tok_start)) (call $tok_len)))
      (let $rflg i32 (call $str_from_src (i32.add (call $src) (i32.load (i32.const 264))) (i32.load (i32.const 268))))
      (call $next_token)
      (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (cstring "RegExp"))  ;; LOADVAR RegExp
      (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_str (local.get $rpat)))
      (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_str (local.get $rflg)))
      (call $vm_emit_op (local.get $code) (i32.const 46)) (call $vm_emit_op (local.get $code) (i32.const 2))  ;; NEW 2
      (return)))
  (if (i32.eq (call $tok_kind) (i32.const 2))  ;; string literal
    (then
      (call $vm_emit_op (local.get $code) (i32.const 1))      ;; PUSH
      (call $vm_emit_val (local.get $code) (call $mk_str (call $decode_str (i32.add (call $src) (call $tok_start)) (call $tok_len))))
      (call $next_token)
      (return)))
  (if (i32.eq (call $tok_kind) (i32.const 15))  ;; ( ... )  — grouping OR arrow params
    (then
      ;; lookahead: scan to the matching ')'; if it is followed by '=>', this is an arrow
      (let $pc i32 (call $cursor_save))
      (call $next_token)  ;; '('
      (let $pd i32 (i32.const 1))
      (block $pe (loop $pl
        (br_if $pe (i32.eq (call $tok_kind) (i32.const 0)))
        (if (i32.eq (call $tok_kind) (i32.const 15)) (then (set! $pd (i32.add (local.get $pd) (i32.const 1)))))
        (if (i32.eq (call $tok_kind) (i32.const 16)) (then (set! $pd (i32.sub (local.get $pd) (i32.const 1))) (br_if $pe (i32.eqz (local.get $pd)))))
        (call $next_token) (br $pl)))
      (call $next_token)  ;; consume the matching ')'
      (let $isarrow i32 (i32.eq (call $tok_kind) (i32.const 52)))  ;; '=>'
      (call $cursor_restore (local.get $pc))
      (if (local.get $isarrow)
        (then
          (let $ap i32 (call $heap_alloc (i32.const 256)))
          (let $apd i32 (call $heap_alloc (i32.const 256)))
          (let $app i32 (call $heap_alloc (i32.const 256)))
          (let $anp i32 (call $vm_c_paramlist (local.get $ap) (local.get $apd) (local.get $app)))  ;; parses ( … ), restidx → reg 260
          (call $vm_c_arrow (local.get $code) (local.get $ap) (local.get $anp) (local.get $apd) (i32.load (i32.const 260)) (local.get $app))
          (return)))
      (call $next_token)  ;; '(' — plain grouping
      (call $vm_c_commaexpr (local.get $code))
      (call $next_token)                                       ;; consume ')'
      (return)))
  (if (i32.eq (call $tok_kind) (i32.const 3))  ;; identifier / true / false / function-expression
    (then
      (if (call $tok_is_kw (cstring "async"))  ;; async function / async arrow
        (then
          (let $asc i32 (call $cursor_save))
          (call $next_token)  ;; past 'async'
          (if (i32.and (i32.eq (call $tok_kind) (i32.const 3)) (call $tok_is_kw (cstring "function")))
            (then (i32.store (i32.const 232) (i32.const 1)) (drop (call $vm_c_function (local.get $code))) (return)))
          ;; async x => …   |   async ( … ) => …
          (if (i32.eq (call $tok_kind) (i32.const 3))  ;; async IDENT =>
            (then
              (let $aan i32 (call $ident_name)) (call $next_token)
              (if (i32.eq (call $tok_kind) (i32.const 52))
                (then
                  (i32.store (i32.const 232) (i32.const 1))
                  (let $aap i32 (call $heap_alloc (i32.const 8))) (i32.store (local.get $aap) (local.get $aan))
                  (call $vm_c_arrow (local.get $code) (local.get $aap) (i32.const 1) (i32.const 0) (i32.const -1) (i32.const 0)) (return)))))
          (if (i32.eq (call $tok_kind) (i32.const 15))  ;; async ( params ) =>
            (then
              (let $apc i32 (call $cursor_save)) (call $next_token)
              (let $apd i32 (i32.const 1))
              (block $ape (loop $apl
                (br_if $ape (i32.eq (call $tok_kind) (i32.const 0)))
                (if (i32.eq (call $tok_kind) (i32.const 15)) (then (set! $apd (i32.add (local.get $apd) (i32.const 1)))))
                (if (i32.eq (call $tok_kind) (i32.const 16)) (then (set! $apd (i32.sub (local.get $apd) (i32.const 1))) (br_if $ape (i32.eqz (local.get $apd)))))
                (call $next_token) (br $apl)))
              (call $next_token)  ;; ')'
              (if (i32.eq (call $tok_kind) (i32.const 52))  ;; '=>'
                (then
                  (i32.store (i32.const 232) (i32.const 1))
                  (call $cursor_restore (local.get $apc))  ;; back to '(' (vm_c_paramlist consumes it)
                  (let $aap2 i32 (call $heap_alloc (i32.const 256)))
                  (let $aapd i32 (call $heap_alloc (i32.const 256)))
                  (let $aapp i32 (call $heap_alloc (i32.const 256)))
                  (let $aanp i32 (call $vm_c_paramlist (local.get $aap2) (local.get $aapd) (local.get $aapp)))
                  (call $vm_c_arrow (local.get $code) (local.get $aap2) (local.get $aanp) (local.get $aapd) (i32.load (i32.const 260)) (local.get $aapp)) (return)))))
          (call $cursor_restore (local.get $asc))))  ;; "async" is just an identifier
      (if (call $tok_is_kw (cstring "function"))  ;; function expression → pushes the fn value
        (then (drop (call $vm_c_function (local.get $code))) (return)))
      (if (call $tok_is_kw (cstring "class"))  ;; class expression → pushes the class value
        (then (call $vm_c_class (local.get $code) (i32.const 1)) (return)))
      (if (call $tok_is_kw (cstring "super"))  ;; super(args)  |  super.method(args)
        (then
          (call $next_token)
          (if (i32.eq (call $tok_kind) (i32.const 15))  ;; super(...) → call parent ctor with this
            (then
              (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (cstring "this"))   ;; receiver
              (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (cstring "this"))
              (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (cstring "@@super"))  ;; parent ctor
              (call $next_token)
              (let $sargc i32 (i32.const 0))
              (if (i32.ne (call $tok_kind) (i32.const 16))
                (then (block $se (loop $sl (call $vm_c_expr (local.get $code)) (set! $sargc (i32.add (local.get $sargc) (i32.const 1))) (br_if $se (i32.eqz (call $eat (i32.const 22)))) (br $sl)))))
              (call $next_token)  ;; ')'
              (call $vm_emit_op (local.get $code) (i32.const 86)) (call $vm_emit_op (local.get $code) (local.get $sargc))  ;; SUPERCALL (CALLM, exempt from class-ctor-without-new check)
              (return)))
          (if (i32.eq (call $tok_kind) (i32.const 23))  ;; super.method(...)
            (then
              (call $next_token)
              (let $smn i32 (call $ident_name)) (call $next_token)
              (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (cstring "this"))   ;; receiver
              (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (cstring "this"))
              (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (cstring "@@superproto"))
              (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (local.get $smn))  ;; [this, method]
              (call $next_token)  ;; '('
              (let $smargc i32 (i32.const 0))
              (if (i32.ne (call $tok_kind) (i32.const 16))
                (then (block $sme (loop $sml (call $vm_c_expr (local.get $code)) (set! $smargc (i32.add (local.get $smargc) (i32.const 1))) (br_if $sme (i32.eqz (call $eat (i32.const 22)))) (br $sml)))))
              (call $next_token)  ;; ')'
              (call $vm_emit_op (local.get $code) (i32.const 33)) (call $vm_emit_op (local.get $code) (local.get $smargc))  ;; CALLM
              (return)))
          (return)))
      (if (call $tok_is_kw (cstring "new"))  ;; new F(args)  /  new a.b.C(args)  /  new.target
        (then
          (call $next_token)
          (if (i32.eq (call $tok_kind) (i32.const 23))  ;; new.target meta-property
            (then
              (call $next_token)  ;; '.'
              (call $next_token)  ;; 'target'
              (call $vm_emit_op (local.get $code) (i32.const 62)) (call $vm_emit_op (local.get $code) (cstring "@@newtarget"))  ;; soft load (undefined outside a construct)
              (return)))
          (if (i32.eq (call $tok_kind) (i32.const 15))  ;; new (expr)(...) — parenthesized callee
            (then
              (call $next_token)  ;; '('
              (call $vm_c_expr (local.get $code))  ;; callee value on stack
              (call $next_token))  ;; ')'
            (else (if (i32.and (i32.eq (call $tok_kind) (i32.const 3))  ;; plain identifier callee (not a keyword-literal)
                        (i32.eqz (i32.or (call $tok_is_kw (cstring "new"))
                                 (i32.or (call $tok_is_kw (cstring "true"))
                                 (i32.or (call $tok_is_kw (cstring "false"))
                                 (i32.or (call $tok_is_kw (cstring "null"))
                                 (i32.or (call $tok_is_kw (cstring "this"))
                                 (i32.or (call $tok_is_kw (cstring "function")) (call $tok_is_kw (cstring "class"))))))))))
              (then
                (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (call $ident_name))  ;; LOADVAR ctor
                (call $next_token))
              ;; literal / nested-new / true/false/null / fn-expr / other primary → parse it
              ;; (the NEW op's is-function guard then throws TypeError for `new 1`, `new {}`, …)
              (else (call $vm_c_primary (local.get $code))))))
          (block $nme (loop $nml  ;; member path on the constructor (no call)
            (br_if $nme (i32.ne (call $tok_kind) (i32.const 23)))  ;; '.'
            (call $next_token)
            (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (call $ident_name))  ;; GETPROP
            (call $next_token)
            (br $nml)))
          (let $nargc i32 (i32.const 0))
