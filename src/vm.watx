                      ;; shorthand `{__proto__}` is an ordinary own property → DEFDATA_OWN
                      (call $vm_emit_op (local.get $code) (if i32 (local.get $oshort) (then (i32.const 101)) (else (i32.const 65))))))))))))))  ;; DEFDATA/_OWN (+ spread else)
