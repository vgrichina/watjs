    (let $k i32 (call $tok_kind))
    (if (i32.eq (local.get $k) (i32.const 53))  ;; tagged template: fn`...`
      (then
        ;; a tagged template may not appear in an optional chain (`` a?.b`x` `` → SyntaxError)
        (if (i32.gt_s (local.get $ocn) (i32.const 0)) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Tagged template literals may not be used in an optional chain")) (return)))
        (call $vm_c_tagged_template (local.get $code) (i32.const 0)) (i32.store (i32.const 956) (i32.const 0)) (br $l)))  ;; a CallExpression result is not an assignment target
    (if (i32.eq (local.get $k) (i32.const 15))  ;; '(' call
      (then (call $vm_c_call_tail (local.get $code)) (i32.store (i32.const 956) (i32.const 0)) (br $l)))  ;; `f() = 1` → the trailing '=' becomes a SyntaxError in vm_c_expr
    (if (i32.eq (local.get $k) (i32.const 19))  ;; '[' index
