  ;; token was left unconsumed by the ?? loop; reject it here.
  (if (i32.and (i32.gt_s (local.get $nn) (i32.const 0)) (i32.or (i32.eq (call $tok_kind) (i32.const 35)) (i32.eq (call $tok_kind) (i32.const 34))))
    (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Cannot use '??' unparenthesized within '||'/'&&' expression")) (return)))
  (let $ni i32 (i32.const 0))
  (block $npe (loop $npl
    (br_if $npe (i32.ge_s (local.get $ni) (local.get $nn)))
    (call $vm_patch (local.get $code) (i32.load (i32.add (local.get $npat) (i32.mul (local.get $ni) (i32.const 4)))))
    (set! $ni (i32.add (local.get $ni) (i32.const 1)))
    (br $npl))))

;; emit a SYNC yield* delegation loop. Stack on entry: [iterable]; on exit: [yieldStarResult].
;; Drives the inner iterator via the YSSTEP op (native $yieldstar_step) which forwards
;; next/throw/return per the resume kind, and uses YIELDSTAR (op 104) to suspend so a .throw()/
;; .return() into the outer generator is delivered to the inner iterator rather than thrown.
(func $vm_emit_yieldstar_sync (param $code i32) (effects)
  (call $vm_emit_op (local.get $code) (i32.const 45))  ;; GETITER → [it]
  (let $it i32 (call $vm_tmpname))
  (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $it))
  (let $recv i32 (call $vm_tmpname))
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef))
  (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $recv))  ;; recv = undefined
  (let $rkind i32 (call $vm_tmpname))
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $num (f64.const 0)))
  (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $rkind))  ;; rkind = 0 (next)
  (let $yval i32 (call $vm_tmpname))
  (let $top i32 (call $vm_emit_cursor))
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $it))     ;; LOADVAR it
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $recv))   ;; LOADVAR recv
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $rkind))  ;; LOADVAR rkind
  (call $vm_emit_op (local.get $code) (i32.const 106))  ;; YSSTEP → [value]; action → reg840
  (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $yval))   ;; STOREVAR yval
  (call $vm_emit_op (local.get $code) (i32.const 107))  ;; LOADACTION → [action]
  (let $jyield i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))  ;; JMPF (action 0 = falsy) → yield path
  ;; action 1 or 2: distinguish
  (call $vm_emit_op (local.get $code) (i32.const 107))  ;; LOADACTION
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $num (f64.const 2)))
  (call $vm_emit_op (local.get $code) (i32.const 18))   ;; STRICTEQ → [action==2]
  (let $jact1 i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))  ;; JMPF (not 2) → action1 path
  ;; action 2: outer generator returns yval
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $yval))
  (call $vm_emit_op (local.get $code) (i32.const 20))   ;; RET yval
  ;; action 1: yield* completes; result value = yval
  (call $vm_patch (local.get $code) (local.get $jact1))
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $yval))   ;; [yval] = expr result
  (let $jend i32 (call $vm_emit_jump (local.get $code) (i32.const 12)))  ;; JMP → end
  ;; yield path: yield yval, suspend; on resume capture value+kind, loop
  (call $vm_patch (local.get $code) (local.get $jyield))
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $yval))
  (call $vm_emit_op (local.get $code) (i32.const 104))  ;; YIELDSTAR (suspend; resume pushes value)
  (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $recv))   ;; recv = resume value
  (call $vm_emit_op (local.get $code) (i32.const 105))  ;; LOADRKIND → [rkind]
  (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $rkind))  ;; rkind = resume kind
  (call $vm_emit_op (local.get $code) (i32.const 12)) (call $vm_emit_op (local.get $code) (local.get $top))   ;; JMP top
  (call $vm_patch (local.get $code) (local.get $jend)))

;; conditional  c ? t : e  (lowest precedence, right-assoc)
(func $vm_c_expr (param $code i32) (effects)
  ;; assignment is allowed here: this is a fresh AssignmentExpression position, so the
  ;; leftmost simple reference may grab a following '='. A binary/unary operator clears
  ;; reg 956 before parsing its operand, so an operand identifier (`y` in `x - y = 1`)
  ;; will NOT grab the '=' — it propagates here and the end-of-function guard rejects it.
  (i32.store (i32.const 956) (i32.const 1))
  ;; yield expression: `yield [expr]` → resume value is the expression result;
  ;; `yield* E` delegates (result left undefined). yield is the lowest precedence.
  (if (i32.and (i32.load (i32.const 672)) (i32.and (i32.eq (call $tok_kind) (i32.const 3)) (call $tok_is_kw (cstring "yield"))))  ;; yield-expr only inside a generator body; else `yield` is an identifier
    (then
      (call $next_token)
      (if (i32.eq (call $tok_kind) (i32.const 12))  ;; yield* E
        (then
          ;; `yield [no LineTerminator here] *` — a newline between `yield` and the '*' is a SyntaxError.
          (if (call $nl_before) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "No line break allowed before '*' in a yield* expression")) (return)))
          (call $next_token)
          (call $vm_c_expr (local.get $code))
          ;; async generator: delegate over the ASYNC iterator (GETAITER) and await each next() result
          (let $eyaw i32 (i32.load (i32.const 788)))
          (if (i32.eqz (local.get $eyaw)) (then (call $vm_emit_yieldstar_sync (local.get $code)) (return)))  ;; sync yield*: full next/throw/return delegation
          (call $vm_emit_op (local.get $code) (if i32 (local.get $eyaw) (then (i32.const 96)) (else (i32.const 45))))  ;; GETAITER / GETITER → [it]
          (let $eyit i32 (call $vm_tmpname))
          (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $eyit))
          (let $eyr i32 (call $vm_tmpname))
          (let $eytop i32 (call $vm_emit_cursor))
          (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $eyit))
          (call $vm_emit_op (local.get $code) (i32.const 32))
          (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (cstring "next"))
          (call $vm_emit_op (local.get $code) (i32.const 33)) (call $vm_emit_op (local.get $code) (i32.const 0))
          (if (local.get $eyaw) (then (call $vm_emit_op (local.get $code) (i32.const 50))))  ;; AWAIT next() result (it returns a promise)
          (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $eyr))
          (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $eyr))
          (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (cstring "done"))
          (call $vm_emit_op (local.get $code) (i32.const 23))
          (let $eyend i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))
          (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $eyr))
          (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (cstring "value"))
          (call $vm_emit_op (local.get $code) (i32.const 7))  ;; YIELD
          (call $vm_emit_op (local.get $code) (i32.const 11))  ;; POP resume
          (call $vm_emit_op (local.get $code) (i32.const 12)) (call $vm_emit_op (local.get $code) (local.get $eytop))
          (call $vm_patch (local.get $code) (local.get $eyend))
          (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef))  ;; result
          (return)))
      ;; yield [expr] — newline after `yield` (restricted production) or a token that can't start an expr → yield undefined.
      ;; `:` (37) is included: a bare `yield` as a ternary branch (`c ? yield : yield`) must NOT swallow the
      ;; `:` and else-branch as its operand.
      (if (i32.or (call $nl_before) (i32.or (i32.eq (call $tok_kind) (i32.const 21)) (i32.or (i32.eq (call $tok_kind) (i32.const 16))
            (i32.or (i32.eq (call $tok_kind) (i32.const 20)) (i32.or (i32.eq (call $tok_kind) (i32.const 18))
            (i32.or (i32.eq (call $tok_kind) (i32.const 22)) (i32.or (i32.eq (call $tok_kind) (i32.const 37)) (i32.eq (call $tok_kind) (i32.const 0)))))))))
        (then (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef)))  ;; yield undefined
        (else (call $vm_c_expr (local.get $code))))
      (call $vm_emit_op (local.get $code) (i32.const 7))  ;; YIELD → resume value = expression result
      (return)))
  (if (call $vm_c_dstr_assign_expr (local.get $code)) (then (return)))  ;; [pat]=RHS / ({pat}=RHS)
  (call $vm_c_or (local.get $code))
  (if (i32.eq (call $tok_kind) (i32.const 36))  ;; '?'
    (then
      (call $next_token)
      (let $p1 i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))  ;; JMPF → else
      (call $vm_c_expr (local.get $code))                                   ;; then branch
      (let $p2 i32 (call $vm_emit_jump (local.get $code) (i32.const 12)))  ;; JMP → end
      (call $vm_patch (local.get $code) (local.get $p1))
      ;; a ConditionalExpression requires `:` between the two branches (`a ? b` is a SyntaxError).
      (if (i32.ne (call $tok_kind) (i32.const 37))
        (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Expected ':' in conditional expression")) (return)))
      (call $next_token)  ;; ':'
      (call $vm_c_expr (local.get $code))                                   ;; else branch
      (call $vm_patch (local.get $code) (local.get $p2))))
  ;; a non-simple LHS followed by an assignment operator that reached here (the leftmost
  ;; primary refused to grab it because reg 956 was cleared by an operator): `x - y = 1`,
  ;; `+x = 1`, `a | b = c` → early SyntaxError. reg 956 == 1 means the whole expression was
  ;; the leftmost simple reference (e.g. parenthesized `(x) = 2`), which is a valid target.
  (if (i32.and (call $is_assign_op (call $tok_kind)) (i32.eqz (i32.load (i32.const 956))))
    (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Invalid left-hand side in assignment")) (return))))

;; comma operator: a, b, c → evaluate each (discarding all but the last). Only
;; valid where a full expression is allowed (statement, for-clauses, parens) —
;; NOT in argument/element lists, which call vm_c_expr directly.
(func $vm_c_commaexpr (param $code i32) (effects)
  (call $vm_c_expr (local.get $code))
  (block $e (loop $l
    (br_if $e (i32.ne (call $tok_kind) (i32.const 22)))  ;; ','
    (call $vm_emit_op (local.get $code) (i32.const 11))  ;; POP the discarded value
    (call $next_token)
    (call $vm_c_expr (local.get $code))
    (br $l))))

;; compile a function body: cursor at '(' params ')' '{' body '}'. Emits the body
;; Emit the default-parameter prologue with left-to-right TDZ initialization, shared by ordinary
;; functions and arrows. When ANY parameter has a default, each simple parameter's argument is captured
;; to a temp, the parameters are set to the TDZ sentinel, then assigned in order — so a default sees
;; earlier params initialized but the current + later params still in TDZ (`function(x=x)` /
;; `function(x=y,y)` → ReferenceError; `function(a,b=a)` reads a). A default-bearing list is non-simple
;; (unmapped `arguments`), so rebinding is safe. A destructuring param's own default is applied (no TDZ,
;; its names aren't in scope yet); rest + destructuring binding happen in their own later prologues.
;; IsSimpleParameterList is false when the list has any rest / default / destructuring param.
(func $vm_params_nonsimple (param $pdef i32) (param $ppat i32) (param $np i32) (param $restidx i32) (result i32) (effects)
  (if (i32.ge_s (local.get $restidx) (i32.const 0)) (then (return (i32.const 1))))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $np)))
    (if (i32.or (i32.and (i32.ne (local.get $pdef) (i32.const 0)) (i32.ne (i32.load (i32.add (local.get $pdef) (i32.mul (local.get $i) (i32.const 4)))) (i32.const 0)))
                (i32.and (i32.ne (local.get $ppat) (i32.const 0)) (i32.ne (i32.load (i32.add (local.get $ppat) (i32.mul (local.get $i) (i32.const 4)))) (i32.const 0))))
      (then (return (i32.const 1))))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
  (i32.const 0))

(func $vm_emit_default_params (param $code i32) (param $params i32) (param $pdef i32) (param $ppat i32) (param $np i32) (param $restidx i32) (effects)
  (let $ptemp i32 (call $heap_alloc (i32.const 256)))
  ;; $ppat is 0 for a single-ident arrow (no destructuring array) — use a zeroed array (all simple).
  (if (i32.eqz (local.get $ppat))
    (then
      (set! $ppat (call $heap_alloc (i32.const 256)))
      (let $zi i32 (i32.const 0))
      (block $ze (loop $zl (br_if $ze (i32.ge_s (local.get $zi) (i32.const 64)))
        (i32.store (i32.add (local.get $ppat) (i32.mul (local.get $zi) (i32.const 4))) (i32.const 0))
        (set! $zi (i32.add (local.get $zi) (i32.const 1))) (br $zl)))))
  (let $hasdef i32 (i32.const 0))
  (let $hdi i32 (i32.const 0))
  (block $hde (loop $hdl (br_if $hde (i32.ge_s (local.get $hdi) (local.get $np)))
    (if (i32.load (i32.add (local.get $pdef) (i32.mul (local.get $hdi) (i32.const 4)))) (then (set! $hasdef (i32.const 1))))
    (set! $hdi (i32.add (local.get $hdi) (i32.const 1))) (br $hdl)))
  (if (i32.eqz (local.get $hasdef)) (then (return)))
  ;; phase A: temp = arg; param = TDZ  (simple params only)
  (let $cai i32 (i32.const 0))
  (block $cae (loop $cal (br_if $cae (i32.ge_s (local.get $cai) (local.get $np)))
    (if (i32.and (i32.eqz (i32.load (i32.add (local.get $ppat) (i32.mul (local.get $cai) (i32.const 4))))) (i32.ne (local.get $cai) (local.get $restidx)))
      (then
        (let $tn i32 (call $vm_tmpname))
        (i32.store (i32.add (local.get $ptemp) (i32.mul (local.get $cai) (i32.const 4))) (local.get $tn))
        (let $pnm i32 (i32.load (i32.add (local.get $params) (i32.mul (local.get $cai) (i32.const 4)))))
        (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $pnm))
        (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $tn))  ;; temp = arg
        (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_tdz))
        (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $pnm))))  ;; param = TDZ
    (set! $cai (i32.add (local.get $cai) (i32.const 1))) (br $cal)))
  ;; phase B: initialize left-to-right
  (let $cbi i32 (i32.const 0))
  (block $cbe (loop $cbl (br_if $cbe (i32.ge_s (local.get $cbi) (local.get $np)))
    (if (i32.and (i32.eqz (i32.load (i32.add (local.get $ppat) (i32.mul (local.get $cbi) (i32.const 4))))) (i32.ne (local.get $cbi) (local.get $restidx)))
      (then
        (let $pn i32 (i32.load (i32.add (local.get $params) (i32.mul (local.get $cbi) (i32.const 4)))))
        (let $tn2 i32 (i32.load (i32.add (local.get $ptemp) (i32.mul (local.get $cbi) (i32.const 4)))))
        (let $dc i32 (i32.load (i32.add (local.get $pdef) (i32.mul (local.get $cbi) (i32.const 4)))))
        (if (local.get $dc)
          (then
            (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $tn2))
            (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef))
            (call $vm_emit_op (local.get $code) (i32.const 18))  ;; SEQ === undefined
            (let $jsup i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))  ;; JMPF → supplied
            (call $cursor_restore (local.get $dc))
            (call $vm_c_expr (local.get $code))  ;; default expr (current + later params still TDZ)
            (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $pn))
            (let $jd i32 (call $vm_emit_jump (local.get $code) (i32.const 12)))  ;; JMP done
            (call $vm_patch (local.get $code) (local.get $jsup))
            (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $tn2))
            (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $pn))
            (call $vm_patch (local.get $code) (local.get $jd)))
          (else
            (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $tn2))
            (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $pn))))))
    ;; a DESTRUCTURING param's own default (applied without TDZ; its names aren't in scope yet)
    (if (i32.and (i32.load (i32.add (local.get $ppat) (i32.mul (local.get $cbi) (i32.const 4)))) (i32.load (i32.add (local.get $pdef) (i32.mul (local.get $cbi) (i32.const 4)))))
      (then
        (let $dpn i32 (i32.load (i32.add (local.get $params) (i32.mul (local.get $cbi) (i32.const 4)))))
        (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $dpn))
        (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef))
        (call $vm_emit_op (local.get $code) (i32.const 18))
        (let $djsk i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))
        (call $cursor_restore (i32.load (i32.add (local.get $pdef) (i32.mul (local.get $cbi) (i32.const 4)))))
        (call $vm_c_expr (local.get $code))
        (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $dpn))
        (call $vm_patch (local.get $code) (local.get $djsk))))
    (set! $cbi (i32.add (local.get $cbi) (i32.const 1))) (br $cbl))))

;; inline (JMP over it) and a PUSH of the VM-fn value. magic from regs 232 (async)
;; / 236 (generator), both cleared here.
(func $vm_c_fnbody (param $code i32) (param $selfname i32) (effects)
  (let $fnsrcstart i32 (i32.load (i32.const 700)))  ;; source start sentinel (0=none); capture+clear so nested fns don't clobber it
  (i32.store (i32.const 700) (i32.const 0))
  (let $genf i32 (i32.load (i32.const 236)))   ;; capture this fn's gen/async flags before the body can clobber mem
  (let $asyncf i32 (i32.load (i32.const 232)))
  (let $classf i32 (i32.load (i32.const 404)))  ;; this fn is a class constructor (set by vm_c_class)
  (let $noproto i32 (i32.load (i32.const 692)))  ;; reg 692: this fn is a method/accessor (non-constructor → no .prototype)
  (let $acckind i32 (i32.load (i32.const 924)))  ;; reg 924: accessor arity kind (0=none, 1=getter→0 params, 2=setter→exactly 1 non-rest)
  ;; break/continue/label context does NOT cross a function boundary: a `break`/`continue` (labeled or not)
  ;; inside a nested function may not target an enclosing loop/label. Save + reset the loop context (reg
  ;; 208/216 break/continue lists, 248 curlabel, 244 pending, 360 loop-finally-base) and set the label-find
  ;; floor (reg 932) to the current label depth so enclosing labels are invisible. Restored on exit.
  (let $savelblfloor i32 (i32.load (i32.const 932)))
  (let $savelbldepth i32 (i32.load (i32.const 228)))
  (let $savebrkl i32 (i32.load (i32.const 208))) (let $savecontl i32 (i32.load (i32.const 216)))
  (let $savecurlbl i32 (i32.load (i32.const 248))) (let $savependlbl i32 (i32.load (i32.const 244)))
  (let $savelpfin i32 (i32.load (i32.const 360)))
  (i32.store (i32.const 932) (local.get $savelbldepth))
  (i32.store (i32.const 208) (i32.const 0)) (i32.store (i32.const 216) (i32.const 0))
  (i32.store (i32.const 248) (i32.const 0)) (i32.store (i32.const 244) (i32.const 0)) (i32.store (i32.const 360) (i32.const 0))
  (i32.store (i32.const 924) (i32.const 0))
  (i32.store (i32.const 236) (i32.const 0)) (i32.store (i32.const 232) (i32.const 0)) (i32.store (i32.const 404) (i32.const 0)) (i32.store (i32.const 692) (i32.const 0))  ;; clear so nested fns don't inherit
  (let $savefin i32 (i32.load (i32.const 320)))  ;; nested fn: a return runs only THIS fn's finallys
  (i32.store (i32.const 320) (i32.const 0))
  (let $savederctor i32 (i32.load (i32.const 852)))  ;; reg852: compiling a DERIVED ctor body? (return-stmt → DERIVEDRETCHECK)
  (i32.store (i32.const 852) (i32.eq (local.get $classf) (i32.const 2)))
