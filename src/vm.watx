          ;; `async` method modifier — only if a method-name start follows (ident/`*`/`[`/string/
          ;; number) with no LineTerminator; otherwise `async` is an ordinary property key.
          (let $oasync i32 (i32.const 0))
          (if (call $tok_is_kw (cstring "async"))
            (then
              (let $oasc i32 (call $cursor_save))
              (call $next_token)
              (if (i32.and (i32.eqz (call $nl_before)) (i32.or (i32.eq (call $tok_kind) (i32.const 3)) (i32.or (i32.eq (call $tok_kind) (i32.const 12)) (i32.or (i32.eq (call $tok_kind) (i32.const 19)) (i32.or (i32.eq (call $tok_kind) (i32.const 2)) (i32.eq (call $tok_kind) (i32.const 1)))))))
                (then (set! $oasync (i32.const 1)))
                (else (call $cursor_restore (local.get $oasc))))))  ;; `async:`/`async(`/`async,`/`async}` → property named "async"
          (let $ogen i32 (i32.eq (call $tok_kind) (i32.const 12)))  ;; *gen(){} generator method (async `*` → async generator)
          (if (local.get $ogen) (then (call $next_token)))  ;; consume '*'
          (if (i32.eq (call $tok_kind) (i32.const 54))  ;; ...spread → copy source's own props
            (then
              (call $next_token)
              (call $vm_c_expr (local.get $code))  ;; [obj, src]
              (call $vm_emit_op (local.get $code) (i32.const 69)))  ;; OSPREAD → [obj]
          (else (if (i32.eq (call $tok_kind) (i32.const 19))  ;; [computed]: value  |  [computed](){} method
            (then
              (call $next_token) (call $vm_c_expr (local.get $code))  ;; '[' key — a computed PropertyName is an AssignmentExpression (NO comma)
              (if (i32.ne (call $tok_kind) (i32.const 20)) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Expected ']' after computed property name")) (return)))  ;; `{[a,b]:v}` → SyntaxError
              (call $next_token)  ;; ']' → [obj, key]
              (call $vm_emit_op (local.get $code) (i32.const 102))  ;; ToPropertyKey(key) NOW — before the value expr (spec order)
              (if (i32.eq (call $tok_kind) (i32.const 15))  ;; computed method
                (then (i32.store (i32.const 236) (local.get $ogen)) (i32.store (i32.const 232) (local.get $oasync)) (i32.store (i32.const 692) (i32.const 1)) (i32.store (i32.const 700) (i32.add (local.get $opropstart) (i32.const 1))) (call $vm_c_fnbody (local.get $code) (i32.const 0)))  ;; computed method → no .prototype / non-constructable (reg 692); → [obj, key, fn]
                (else (call $next_token) (call $vm_c_expr (local.get $code))))  ;; ': value'
              (call $vm_emit_op (local.get $code) (i32.const 101)))  ;; DEFDATA_OWN — computed key never triggers the __proto__ proto-setter
