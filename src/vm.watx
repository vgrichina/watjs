              (then
                ;; `"__proto__": v` is a [[Prototype]] setter — a second one in the same literal is a SyntaxError.
                (if (call $str_eq (call $decode_str (i32.add (call $src) (call $tok_start)) (call $tok_len)) (cstring "__proto__"))
                  (then (set! $oprotocnt (i32.add (local.get $oprotocnt) (i32.const 1)))
                        (if (i32.gt_s (local.get $oprotocnt) (i32.const 1)) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Duplicate __proto__ fields are not allowed in object literals")) (return)))))
                (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_str (call $decode_str (i32.add (call $src) (call $tok_start)) (call $tok_len))))
