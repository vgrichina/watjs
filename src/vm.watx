          ;; PutValue through the same reference so a `with`-getter's self-delete or a nested eval's
          ;; new binding cannot redirect the write. REFSET leaves the value → SETCOMPLETION (no DUP).
          (call $vm_emit_op (local.get $code) (i32.const 122)) (call $vm_emit_op (local.get $code) (local.get $an))  ;; RESOLVEREF
          (call $vm_emit_op (local.get $code) (i32.const 123)) (call $vm_emit_op (local.get $code) (local.get $an))  ;; REFGET
          (call $vm_c_expr (local.get $code))                                                                       ;; RHS
          (call $vm_emit_op (local.get $code) (local.get $cop))
          (call $vm_emit_op (local.get $code) (i32.const 124)) (call $vm_emit_op (local.get $code) (local.get $an)) (call $vm_emit_op (local.get $code) (i32.load (i32.const 388)))  ;; REFSET → leaves value
          (call $vm_emit_op (local.get $code) (i32.const 71))  ;; SETCOMPLETION
          (call $vm_emit_stmt_comma_tail (local.get $code))  ;; consume a trailing `, expr` comma continuation
          (drop (call $eat (i32.const 21)))
          (return)))
