        (call $vm_c_expr (local.get $code))
        (call $next_token)  ;; ']'
        (let $nk2 i32 (call $tok_kind))
        (if (i32.or (i32.eq (local.get $nk2) (i32.const 23)) (i32.eq (local.get $nk2) (i32.const 19)))
          (then (call $vm_emit_op (local.get $code) (i32.const 31)) (br $l))  ;; GETIDX
          (else (call $vm_emit_op (local.get $code) (i32.const 70))
                (if (i32.load (i32.const 388)) (then (call $vm_emit_op (local.get $code) (i32.const 84))))  ;; strict: non-config delete → TypeError
