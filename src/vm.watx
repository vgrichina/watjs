                  (if (i32.or (i32.eq (local.get $vpk) (i32.const 20)) (i32.or (i32.eq (local.get $vpk) (i32.const 18)) (i32.eq (local.get $vpk) (i32.const 16))))
                    (then (set! $vpsd (i32.sub (local.get $vpsd) (i32.const 1))) (if (i32.eqz (local.get $vpsd)) (then (call $next_token) (br $vpske)))))
                  (call $next_token) (br $vpskl)))
                (call $next_token)  ;; consume '='
                (call $vm_c_expr (local.get $code))  ;; RHS → [val]
                (let $vtmp i32 (call $vm_tmpname))
                (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $vtmp))  ;; STOREVAR vtmp
                (let $vpost i32 (call $cursor_save))  ;; after the RHS
                (call $cursor_restore (local.get $vpatcur))  ;; back to the pattern
                (call $vm_c_destructure_param (local.get $code) (local.get $vtmp))  ;; nested/default/rest/rename
                (call $cursor_restore (local.get $vpost))  ;; resume after the RHS
