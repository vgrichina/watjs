                            (call $vm_emit_op (local.get $code) (i32.const 11))  ;; POP
                            (br $ficl))))
                    (else (call $look_restore) (call $vm_c_commaexpr (local.get $code)) (call $vm_emit_op (local.get $code) (i32.const 11))))))))
          ;; a C-style for head requires exactly two ';' (ASI never applies inside it): `for(;)` / `for()` → SyntaxError
          (if (i32.ne (call $tok_kind) (i32.const 21))
            (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Expected ';' in for-loop header")) (return)))
          (call $next_token)  ;; consume first ';'
          ;; initial CreatePerIterationEnvironment (ForBodyEvaluation step 1): copy the head bindings into a
          ;; fresh scope BEFORE the first test, so closures created in the declaration (`let i=…, f=()=>i`)
          ;; keep the ORIGINAL binding while the loop body works on per-iteration copies. All-simple let/const
          ;; heads only (a destructuring declarator's names aren't tracked → keep isolation-only behavior).
          ;; exclude `using` (its LEAVEWITH-driven disposal must fire ONCE at the end of the for statement,
          ;; not per-iteration — CreatePerIterationEnvironment's copy would dispose it prematurely).
          (let $fdocopy i32 (i32.and (i32.eqz (local.get $forusing)) (i32.and (local.get $forlex) (i32.and (i32.eqz (local.get $fhaspat)) (i32.gt_s (local.get $forlexn) (i32.const 0))))))
          (if (local.get $fdocopy) (then (call $vm_emit_periter_copy (local.get $code) (local.get $forlexb) (local.get $forlexn) (local.get $forconst))))
          (let $ftop i32 (call $vm_emit_cursor))
          (if (i32.ne (call $tok_kind) (i32.const 21))
            (then (call $vm_c_commaexpr (local.get $code)))  ;; the condition is a full Expression (comma allowed: `for(;a,b;)`)
            (else (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_bool (i32.const 1)))))
          (if (i32.ne (call $tok_kind) (i32.const 21))
            (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Expected ';' in for-loop header")) (return)))
          (call $next_token)  ;; consume second ';'
          (let $fpend i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))  ;; JMPF → end
          ;; save update-clause cursor, skip its tokens to the ')'
          (let $fupd i32 (call $cursor_save))
          (let $fdepth i32 (i32.const 0))
          (block $fse (loop $fsl
            (let $utk i32 (call $tok_kind))
            (br_if $fse (i32.eq (local.get $utk) (i32.const 0)))
            ;; a ';' at bracket-depth 0 in the Update clause means a third ';' in the head → `for(;;;)` → SyntaxError
            ;; (otherwise the extra clause is silently dropped and the loop runs forever).
            (if (i32.and (i32.eq (local.get $utk) (i32.const 21)) (i32.eqz (local.get $fdepth)))
              (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Expected ')' in for-loop header")) (return)))
            (if (i32.or (i32.eq (local.get $utk) (i32.const 15)) (i32.or (i32.eq (local.get $utk) (i32.const 17)) (i32.eq (local.get $utk) (i32.const 19)))) (then (set! $fdepth (i32.add (local.get $fdepth) (i32.const 1)))))
            (if (i32.or (i32.eq (local.get $utk) (i32.const 18)) (i32.eq (local.get $utk) (i32.const 20))) (then (set! $fdepth (i32.sub (local.get $fdepth) (i32.const 1)))))  ;; '}' / ']'
            (if (i32.eq (local.get $utk) (i32.const 16))  ;; ')'
              (then (br_if $fse (i32.eqz (local.get $fdepth))) (set! $fdepth (i32.sub (local.get $fdepth) (i32.const 1)))))
            (call $next_token)
            (br $fsl)))
          (call $next_token)  ;; ')'
          (i32.store (i32.const 900) (i32.const 1)) (i32.store (i32.const 936) (i32.const 1))  ;; C-style for body is a single Statement — no lexical/function decl
          ;; Early Error: a C-style for `let`/`const` head binding may not also be a body VarDeclaredName
          ;; (`for (let x=0;;) { var x; }`). Block body only; each recorded head lexical name checked.
          (if (i32.and (local.get $forlex) (i32.eq (call $tok_kind) (i32.const 17)))
            (then
              (let $fci i32 (i32.const 0))
              (block $fce (loop $fcl
                (br_if $fce (i32.ge_s (local.get $fci) (local.get $forlexn)))
                (if (call $var_name_in_block (i32.load (i32.add (local.get $forlexb) (i32.mul (local.get $fci) (i32.const 4)))) (i32.const 0))
                  (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Identifier has already been declared")) (return)))
                (set! $fci (i32.add (local.get $fci) (i32.const 1))) (br $fcl)))))
          (call $vm_c_stmt (local.get $code))  ;; body
          (let $fpost i32 (call $cursor_save))
