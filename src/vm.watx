;; postfix: primary followed by  (args) | [index] | .member  (chainable)
;; compile a call tail: cursor at '(' with the callee value already on the operand stack.
;; Compiles the (spread-aware) argument list and emits CALL/CALLSPREAD. Shared by
;; vm_c_postfix and the delete-operand compiler (so `delete foo()` actually calls foo).
(func $vm_c_call_tail (param $code i32) (effects)
  ;; capture (and consume) the "callee is bare `eval`" compile flag + this call site's super-context
  ;; BEFORE the arguments (which may contain nested eval calls that reset reg 876).
  (let $isdeval i32 (i32.load (i32.const 876)))
  (i32.store (i32.const 876) (i32.const 0))
  ;; direct-eval marker bitfield: bit0=is-direct-eval, bit1=super-property-allowed(reg868), bit2=super()-allowed(reg884)
  (let $devmark i32 (if i32 (local.get $isdeval) (then (i32.or (i32.const 1) (i32.or (if i32 (i32.load (i32.const 868)) (then (i32.const 2)) (else (i32.const 0))) (i32.or (if i32 (i32.load (i32.const 884)) (then (i32.const 4)) (else (i32.const 0))) (i32.or (if i32 (i32.load (i32.const 388)) (then (i32.const 8)) (else (i32.const 0))) (if i32 (i32.load (i32.const 1008)) (then (i32.const 16)) (else (i32.const 0)))))))) (else (i32.const 0))))  ;; bit3 = caller strict; bit4 = caller new.target-allowed (direct eval inherits both)
  (call $next_token)  ;; '('
  (let $spc i32 (call $cursor_save))
  (let $sphas i32 (i32.const 0)) (let $spd i32 (i32.const 0))
  (block $spe (loop $spl
    (br_if $spe (i32.eq (call $tok_kind) (i32.const 0)))
    (if (i32.eq (call $tok_kind) (i32.const 15)) (then (set! $spd (i32.add (local.get $spd) (i32.const 1)))))
    (if (i32.eq (call $tok_kind) (i32.const 16)) (then (br_if $spe (i32.eqz (local.get $spd))) (set! $spd (i32.sub (local.get $spd) (i32.const 1)))))
    (if (i32.and (i32.eq (call $tok_kind) (i32.const 54)) (i32.eqz (local.get $spd))) (then (set! $sphas (i32.const 1))))
    (call $next_token) (br $spl)))
