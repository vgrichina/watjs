          (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "unexpected ']' (empty computed member)")) (return)))
        (call $vm_c_commaexpr (local.get $code))  ;; a computed member key `a[ Expression ]` is a full Expression (comma allowed)
        (call $next_token)  ;; ']'
        (if (i32.eq (call $tok_kind) (i32.const 24))  ;; arr[i] = v
          (then
            (call $next_token)
            (call $vm_c_expr (local.get $code))
            (call $vm_emit_op (local.get $code) (if i32 (i32.load (i32.const 388)) (then (i32.const 83)) (else (i32.const 35))))  ;; SETIDX (strict→83)
            (br $e)))
        (if (i32.and (i32.ge_s (call $tok_kind) (i32.const 59)) (i32.le_s (call $tok_kind) (i32.const 61)))  ;; arr[i] ||= &&= ??= v
          (then
            (let $ijop i32 (if i32 (i32.eq (call $tok_kind) (i32.const 59)) (then (i32.const 28))
                            (else (if i32 (i32.eq (call $tok_kind) (i32.const 60)) (then (i32.const 27)) (else (i32.const 68))))))
            (call $next_token)
            (let $iik i32 (call $vm_tmpname)) (let $iio i32 (call $vm_tmpname))
