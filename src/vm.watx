      (block $spe (loop $spl
        (br_if $spe (i32.ge_s (local.get $spi) (local.get $np)))
        (let $spn i32 (i32.load (i32.add (local.get $params) (i32.mul (local.get $spi) (i32.const 4)))))
        (if (i32.or (call $str_eq (local.get $spn) (cstring "eval")) (call $str_eq (local.get $spn) (cstring "arguments")))
          (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Parameter named eval or arguments not allowed in strict mode"))))
        ;; duplicate parameter name is an early SyntaxError in strict
        (let $spj i32 (i32.add (local.get $spi) (i32.const 1)))
        (block $sde (loop $sdl
          (br_if $sde (i32.ge_s (local.get $spj) (local.get $np)))
          (if (call $str_eq (local.get $spn) (i32.load (i32.add (local.get $params) (i32.mul (local.get $spj) (i32.const 4)))))
            (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Duplicate parameter name not allowed in strict mode"))))
          (set! $spj (i32.add (local.get $spj) (i32.const 1)))
          (br $sdl)))
        (set! $spi (i32.add (local.get $spi) (i32.const 1)))
        (br $spl)))))
  ;; prologue: default-parameter initializers — if param === undefined, assign default
  (let $dpi i32 (i32.const 0))
  (block $dpe (loop $dpl
    (br_if $dpe (i32.ge_s (local.get $dpi) (local.get $np)))
    (if (i32.load (i32.add (local.get $pdef) (i32.mul (local.get $dpi) (i32.const 4))))
      (then
        (let $pname i32 (i32.load (i32.add (local.get $params) (i32.mul (local.get $dpi) (i32.const 4)))))
        (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $pname))  ;; LOADVAR
        (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef))
        (call $vm_emit_op (local.get $code) (i32.const 18))  ;; SEQ (=== undefined)
        (let $dsk i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))  ;; JMPF → skip (already supplied)
        (call $cursor_restore (i32.load (i32.add (local.get $pdef) (i32.mul (local.get $dpi) (i32.const 4)))))
        (call $vm_c_expr (local.get $code))  ;; default expression
        (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $pname))  ;; STOREVAR
        (call $vm_patch (local.get $code) (local.get $dsk))))
    (set! $dpi (i32.add (local.get $dpi) (i32.const 1)))
    (br $dpl)))
  ;; rest parameter: restName = arguments.slice(restidx)
  (if (i32.ge_s (local.get $restidx) (i32.const 0))
    (then
      (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (cstring "arguments"))  ;; LOADVAR arguments
      (call $vm_emit_op (local.get $code) (i32.const 32))  ;; DUP
      (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (cstring "slice"))  ;; GETPROP slice
      (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $num (f64.convert_i32_s (local.get $restidx))))
      (call $vm_emit_op (local.get $code) (i32.const 33)) (call $vm_emit_op (local.get $code) (i32.const 1))  ;; CALLM 1
      (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (i32.load (i32.add (local.get $params) (i32.mul (local.get $restidx) (i32.const 4)))))))  ;; STOREVAR rest
  ;; destructuring-parameter prologue: bind each pattern param from its temp
  ;; (runs after the default prologue, so an absent arg already got its default).
  (let $pti i32 (i32.const 0))
  (block $pte (loop $ptl
    (br_if $pte (i32.ge_s (local.get $pti) (local.get $np)))
    (if (i32.load (i32.add (local.get $ppat) (i32.mul (local.get $pti) (i32.const 4))))
      (then
        (call $cursor_restore (i32.load (i32.add (local.get $ppat) (i32.mul (local.get $pti) (i32.const 4)))))
        (call $vm_c_destructure_param (local.get $code) (i32.load (i32.add (local.get $params) (i32.mul (local.get $pti) (i32.const 4)))))))
    (set! $pti (i32.add (local.get $pti) (i32.const 1)))
    (br $ptl)))
  (call $cursor_restore (local.get $bodycur))  ;; back to the body
  ;; generator: suspend after the param prologue (eager param eval per spec — defaults/
  ;; destructuring run when the generator is CALLED, before the body, throwing on call).
  (if (local.get $genf) (then (call $vm_emit_op (local.get $code) (i32.const 77))))  ;; GENPRO_SUSPEND
  (if (i32.eq (call $tok_kind) (i32.const 17)) (then (call $vm_hoist_fns (local.get $code) (i32.const 1))))  ;; hoist `function NAME` decls (body is a '{...}' block)
  ;; reg 672 = "compiling inside a generator body" — so `yield` is the yield-expression
  ;; only here; in sloppy non-generator code it is a plain identifier. Saved/restored
  ;; across this (possibly nested) function body.
  (let $savegen i32 (i32.load (i32.const 672)))
  (i32.store (i32.const 672) (local.get $genf))
  (call $vm_c_stmt (local.get $code))  ;; body block
  (i32.store (i32.const 672) (local.get $savegen))  ;; restore enclosing generator-context
  (i32.store (i32.const 320) (local.get $savefin))  ;; restore enclosing fn's finally depth
  (i32.store (i32.const 372) (local.get $savehc)) (i32.store (i32.const 376) (local.get $savehb))  ;; restore enclosing hoist list
  (i32.store (i32.const 388) (local.get $savestrict))  ;; restore enclosing strictness
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef))
  (call $vm_emit_op (local.get $code) (i32.const 20))  ;; default RET undefined
  (call $vm_patch (local.get $code) (local.get $pj))
  (let $fn i32 (call $heap_alloc (i32.add (i32.const 36) (i32.mul (local.get $np) (i32.const 4)))))  ;; @16 proto (i64), @24 closureScope, @28 params, @(28+np*4) name, @(32+np*4) arrow flag
  (let $isasync i32 (local.get $asyncf))
  (let $isgen i32 (local.get $genf))
  (i32.store (local.get $fn) (if i32 (local.get $isgen) (then (i32.const 1448232527))
    (else (if i32 (local.get $isasync) (then (i32.const 1448232528)) (else (i32.const 1448232526))))))  ;; GEN / ASYNC / NORMAL
  (i32.store (i32.add (local.get $fn) (i32.const 4)) (local.get $entry))
  (i32.store (i32.add (local.get $fn) (i32.const 8)) (local.get $np))
  (i32.store (i32.add (local.get $fn) (i32.const 12)) (local.get $code))
  (i64.store (i32.add (local.get $fn) (i32.const 16)) (call $v_undef))  ;; prototype (set by class compilation)
  (i32.store (i32.add (local.get $fn) (i32.const 24)) (i32.const 0))    ;; closureScope (filled at runtime by CLOSURE)
  (let $ci i32 (i32.const 0))
  (block $ce (loop $cl
    (br_if $ce (i32.ge_s (local.get $ci) (local.get $np)))
    (i32.store (i32.add (i32.add (local.get $fn) (i32.const 28)) (i32.mul (local.get $ci) (i32.const 4)))
               (i32.load (i32.add (local.get $params) (i32.mul (local.get $ci) (i32.const 4)))))
    (set! $ci (i32.add (local.get $ci) (i32.const 1)))
    (br $cl)))
  ;; .name: the declared name (named fn decl/expr), or 0 → "" until inferred
  (i32.store (i32.add (i32.add (local.get $fn) (i32.const 28)) (i32.mul (local.get $np) (i32.const 4))) (local.get $selfname))
  (i32.store (i32.add (i32.add (local.get $fn) (i32.const 32)) (i32.mul (local.get $np) (i32.const 4)))
    (i32.or (if i32 (local.get $thisstrict) (then (i32.const 4)) (else (i32.const 0)))  ;; bit2 strict
            (if i32 (local.get $classf) (then (i32.const 8)) (else (i32.const 0)))))  ;; bit3 class constructor (no plain call)
  ;; named function: CLOSURE_NAMED binds the name to the function inside its own
  ;; body (recursive named function expressions); anonymous: plain CLOSURE.
  (if (local.get $selfname)
    (then (call $vm_emit_op (local.get $code) (i32.const 64)) (call $vm_emit_op (local.get $code) (local.get $fn)) (call $vm_emit_op (local.get $code) (local.get $selfname)))  ;; CLOSURE_NAMED
    (else (call $vm_emit_op (local.get $code) (i32.const 61)) (call $vm_emit_op (local.get $code) (local.get $fn)))))  ;; CLOSURE

;; emit a PUSH of an empty (no-op) VM function — used for a class with no constructor
(func $vm_emit_empty_fn (param $code i32) (effects)
  (let $pj i32 (call $vm_emit_jump (local.get $code) (i32.const 12)))
  (let $entry i32 (call $vm_emit_cursor))
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef))
  (call $vm_emit_op (local.get $code) (i32.const 20))  ;; RET undefined
  (call $vm_patch (local.get $code) (local.get $pj))
  (let $fn i32 (call $heap_alloc (i32.const 36)))  ;; @28 name, @32 arrow flag
  (i32.store (local.get $fn) (i32.const 1448232526))
  (i32.store (i32.add (local.get $fn) (i32.const 4)) (local.get $entry))
  (i32.store (i32.add (local.get $fn) (i32.const 8)) (i32.const 0))
  (i32.store (i32.add (local.get $fn) (i32.const 12)) (local.get $code))
  (i64.store (i32.add (local.get $fn) (i32.const 16)) (call $v_undef))
  (i32.store (i32.add (local.get $fn) (i32.const 24)) (i32.const 0))    ;; closureScope (0 → gscope fallback)
  (i32.store (i32.add (local.get $fn) (i32.const 28)) (i32.const 0))    ;; name ""
  (i32.store (i32.add (local.get $fn) (i32.const 32)) (i32.const 8))    ;; bit3 = class constructor (synthetic, no plain call)
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_fn (local.get $fn))))

;; emit a PUSH of a synthetic DERIVED constructor — runs `super()` (no forwarded args) then returns
;; covers `class B extends A {}` so `new B()` invokes A's constructor with this=instance
(func $vm_emit_derived_ctor (param $code i32) (effects)
  (let $pj i32 (call $vm_emit_jump (local.get $code) (i32.const 12)))
  (let $entry i32 (call $vm_emit_cursor))
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (cstring "this"))   ;; receiver
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (cstring "this"))
  (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (cstring "@@super"))  ;; parent ctor
  (call $vm_emit_op (local.get $code) (i32.const 86)) (call $vm_emit_op (local.get $code) (i32.const 0))  ;; SUPERCALL, 0 args
  (call $vm_emit_op (local.get $code) (i32.const 11))  ;; POP super result
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef))
  (call $vm_emit_op (local.get $code) (i32.const 20))  ;; RET undefined
  (call $vm_patch (local.get $code) (local.get $pj))
  (let $fn i32 (call $heap_alloc (i32.const 36)))
  (i32.store (local.get $fn) (i32.const 1448232526))
  (i32.store (i32.add (local.get $fn) (i32.const 4)) (local.get $entry))
  (i32.store (i32.add (local.get $fn) (i32.const 8)) (i32.const 0))
  (i32.store (i32.add (local.get $fn) (i32.const 12)) (local.get $code))
  (i64.store (i32.add (local.get $fn) (i32.const 16)) (call $v_undef))
  (i32.store (i32.add (local.get $fn) (i32.const 24)) (i32.const 0))
  (i32.store (i32.add (local.get $fn) (i32.const 28)) (i32.const 0))
  (i32.store (i32.add (local.get $fn) (i32.const 32)) (i32.const 8))    ;; bit3 = class constructor
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_fn (local.get $fn))))

;; emit a CLOSURE for a class field initializer: function(){ return <init> }.
;; cursor must be at the init expression. Captures the class-def scope (CLOSURE),
;; runs with `this` = the instance (non-arrow). Leaves the closure on the stack.
;; a static-initialization block: a 0-param thunk whose body is the `{ ... }` block
;; (cursor at '{'), returning undefined. Run with this=ctor at class definition.
(func $vm_emit_block_thunk (param $code i32) (effects)
  (let $bpj i32 (call $vm_emit_jump (local.get $code) (i32.const 12)))  ;; JMP over body
  (let $bentry i32 (call $vm_emit_cursor))
  (call $vm_c_stmt (local.get $code))  ;; the `{ ... }` block
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef))  ;; PUSH undefined (no value)
  (call $vm_emit_op (local.get $code) (i32.const 20))  ;; RET
  (call $vm_patch (local.get $code) (local.get $bpj))
  (let $bfn i32 (call $heap_alloc (i32.const 36)))
  (i32.store (local.get $bfn) (i32.const 1448232526))
  (i32.store (i32.add (local.get $bfn) (i32.const 4)) (local.get $bentry))
  (i32.store (i32.add (local.get $bfn) (i32.const 8)) (i32.const 0))     ;; np
  (i32.store (i32.add (local.get $bfn) (i32.const 12)) (local.get $code))
  (i64.store (i32.add (local.get $bfn) (i32.const 16)) (call $v_undef))  ;; proto
  (i32.store (i32.add (local.get $bfn) (i32.const 24)) (i32.const 0))    ;; closureScope (CLOSURE fills at runtime)
  (i32.store (i32.add (local.get $bfn) (i32.const 28)) (i32.const 0))    ;; name
  (i32.store (i32.add (local.get $bfn) (i32.const 32)) (i32.const 0))    ;; flags 0 (own `this`)
  (call $vm_emit_op (local.get $code) (i32.const 61)) (call $vm_emit_op (local.get $code) (local.get $bfn)))  ;; CLOSURE

(func $vm_emit_field_thunk (param $code i32) (effects)
  (let $pj i32 (call $vm_emit_jump (local.get $code) (i32.const 12)))  ;; JMP over body
  (let $entry i32 (call $vm_emit_cursor))
  (call $vm_c_expr (local.get $code))  ;; compile init expr → value
  (call $vm_emit_op (local.get $code) (i32.const 20))  ;; RET (returns TOS)
  (call $vm_patch (local.get $code) (local.get $pj))
  (let $fn i32 (call $heap_alloc (i32.const 36)))
  (i32.store (local.get $fn) (i32.const 1448232526))
  (i32.store (i32.add (local.get $fn) (i32.const 4)) (local.get $entry))
  (i32.store (i32.add (local.get $fn) (i32.const 8)) (i32.const 0))     ;; np
  (i32.store (i32.add (local.get $fn) (i32.const 12)) (local.get $code))
  (i64.store (i32.add (local.get $fn) (i32.const 16)) (call $v_undef))  ;; proto
  (i32.store (i32.add (local.get $fn) (i32.const 24)) (i32.const 0))    ;; closureScope (CLOSURE fills at runtime)
  (i32.store (i32.add (local.get $fn) (i32.const 28)) (i32.const 0))    ;; name
  (i32.store (i32.add (local.get $fn) (i32.const 32)) (i32.const 0))    ;; flags 0 (non-arrow → own `this`)
  (call $vm_emit_op (local.get $code) (i32.const 61)) (call $vm_emit_op (local.get $code) (local.get $fn)))  ;; CLOSURE → runtime closure capturing class-def scope

;; Compile a destructuring pattern (cursor at '[' or '{') that binds from the
;; value already stored in variable $srcTmp. Single-level array/object patterns
;; with element/property defaults and array rest (matching var-destructuring);
;; a nested array/object target recurses through a fresh temp. Leaves the cursor
;; just past the closing ']' / '}'. Emits STOREVAR for each bound name.
;; skip a balanced bracket group ([ ] / { } / ( )) starting at the current opener.
(func $vm_skip_balanced (effects)
  (let $d i32 (i32.const 0))
  (block $e (loop $l
    (let $k i32 (call $tok_kind))
    (br_if $e (i32.eqz (local.get $k)))  ;; EOF guard
    (if (i32.or (i32.eq (local.get $k) (i32.const 19)) (i32.or (i32.eq (local.get $k) (i32.const 17)) (i32.eq (local.get $k) (i32.const 15))))
      (then (set! $d (i32.add (local.get $d) (i32.const 1)))))
    (if (i32.or (i32.eq (local.get $k) (i32.const 20)) (i32.or (i32.eq (local.get $k) (i32.const 18)) (i32.eq (local.get $k) (i32.const 16))))
      (then (set! $d (i32.sub (local.get $d) (i32.const 1)))
            (if (i32.eqz (local.get $d)) (then (call $next_token) (br $e)))))
    (call $next_token) (br $l))))

;; A nested pattern element/property may carry a `= default` AFTER its closing
;; bracket. We must apply the default to the temp BEFORE destructuring it, so we
;; peek past the balanced pattern, emit the default-application onto $nt first,
;; then rewind and recurse. Cursor enters at the pattern opener.
(func $vm_c_nested_with_default (param $code i32) (param $nt i32) (effects)
  (let $ps i32 (call $cursor_save))  ;; at the '[' / '{'
  (call $vm_skip_balanced)           ;; advance past the matching closer
  (let $hd i32 (i32.eq (call $tok_kind) (i32.const 24)))  ;; '=' default follows?
  (let $rs i32 (i32.const 0))
  (if (local.get $hd)
    (then
      (call $next_token)  ;; consume '='
      (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $nt))  ;; LOADVAR nt
      (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef))
      (call $vm_emit_op (local.get $code) (i32.const 18))  ;; STRICTEQ
      (let $sk i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))  ;; JMPF → value present, skip default
      (call $vm_c_expr (local.get $code))  ;; eval default
      (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $nt))  ;; STOREVAR nt
      (call $vm_patch (local.get $code) (local.get $sk))
      (set! $rs (call $cursor_save))))  ;; position after the default expr
  (call $cursor_restore (local.get $ps))  ;; rewind to pattern opener
  (call $vm_c_destructure_param (local.get $code) (local.get $nt))  ;; destructure (consumes pattern)
  (if (local.get $hd) (then (call $cursor_restore (local.get $rs)))))  ;; skip past the default we pre-parsed

;; destructuring-ASSIGNMENT expression: `[pat] = RHS` or `({pat} = RHS)`.
;; Detect via lookahead (a '=' immediately after the balanced pattern), emit the
;; assignment via vm_c_destructure_param, and leave the RHS value on the stack
;; (a destructuring assignment evaluates to its RHS). Returns 1 if handled (cursor
;; consumed), 0 if not a destructuring assignment (cursor unchanged).
(func $vm_c_dstr_assign_expr (param $code i32) (result i32) (effects)
  (if (i32.eq (call $tok_kind) (i32.const 19))  ;; '[' array pattern
    (then
      (let $ps i32 (call $cursor_save))
      (call $vm_skip_balanced)  ;; past matching ']'
      (let $isda i32 (i32.eq (call $tok_kind) (i32.const 24)))  ;; '=' follows?
      (call $cursor_restore (local.get $ps))  ;; rewind to '['
      (if (local.get $isda)
        (then
          (let $ps2 i32 (call $cursor_save))   ;; at '['
          (call $vm_skip_balanced)
          (call $next_token)  ;; consume '='
          (call $vm_c_expr (local.get $code))  ;; RHS → [val]
          (let $tmp i32 (call $vm_tmpname))
          (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $tmp))  ;; STOREVAR tmp
          (let $rs i32 (call $cursor_save))    ;; after RHS
          (call $cursor_restore (local.get $ps2))  ;; back to '['
          (let $savemode1 i32 (i32.load (i32.const 676)))  ;; assignment-destructuring mode (leaf targets assign, not bind)
          (i32.store (i32.const 676) (i32.const 1))
          (call $vm_c_destructure_param (local.get $code) (local.get $tmp))
          (i32.store (i32.const 676) (local.get $savemode1))
          (call $cursor_restore (local.get $rs))   ;; skip past RHS
          (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $tmp))  ;; LOADVAR → value
          (return (i32.const 1))))
      (return (i32.const 0))))
  (if (i32.eq (call $tok_kind) (i32.const 17))  ;; '{' bare object pattern (expr position): {pat}=RHS (cover grammar)
    (then
      (let $ps i32 (call $cursor_save))
      (call $vm_skip_balanced)  ;; past matching '}'
      (let $isda i32 (i32.eq (call $tok_kind) (i32.const 24)))  ;; '=' follows?
      (call $cursor_restore (local.get $ps))  ;; rewind to '{'
      (if (local.get $isda)
        (then
          (let $ps2 i32 (call $cursor_save))   ;; at '{'
          (call $vm_skip_balanced)
          (call $next_token)  ;; consume '='
          (call $vm_c_expr (local.get $code))  ;; RHS → [val]
          (let $tmp i32 (call $vm_tmpname))
          (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $tmp))  ;; STOREVAR tmp
          (let $rs i32 (call $cursor_save))    ;; after RHS
          (call $cursor_restore (local.get $ps2))  ;; back to '{'
          (let $savemode3 i32 (i32.load (i32.const 676)))  ;; assignment-destructuring mode
          (i32.store (i32.const 676) (i32.const 1))
          (call $vm_c_destructure_param (local.get $code) (local.get $tmp))
          (i32.store (i32.const 676) (local.get $savemode3))
          (call $cursor_restore (local.get $rs))   ;; skip past RHS
          (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $tmp))  ;; LOADVAR → value
          (return (i32.const 1))))
      (return (i32.const 0))))
  (if (i32.eq (call $tok_kind) (i32.const 15))  ;; '(' — maybe ({pat} = RHS)
    (then
      (let $ps i32 (call $cursor_save))
      (call $next_token)  ;; '('
      (if (i32.ne (call $tok_kind) (i32.const 17))  ;; inner must be '{'
        (then (call $cursor_restore (local.get $ps)) (return (i32.const 0))))
      (call $vm_skip_balanced)  ;; past matching '}'
      (let $isda i32 (i32.eq (call $tok_kind) (i32.const 24)))  ;; '=' follows?
      (call $cursor_restore (local.get $ps))  ;; rewind to '('
      (if (local.get $isda)
        (then
          (call $next_token)  ;; consume '('
          (let $ps2 i32 (call $cursor_save))   ;; at '{'
          (call $vm_skip_balanced)
          (call $next_token)  ;; consume '='
          (call $vm_c_expr (local.get $code))  ;; RHS → [val] (stops at ')')
          (let $tmp i32 (call $vm_tmpname))
          (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $tmp))  ;; STOREVAR tmp
          (let $rs i32 (call $cursor_save))    ;; at ')'
          (call $cursor_restore (local.get $ps2))  ;; back to '{'
          (let $savemode2 i32 (i32.load (i32.const 676)))  ;; assignment-destructuring mode
          (i32.store (i32.const 676) (i32.const 1))
          (call $vm_c_destructure_param (local.get $code) (local.get $tmp))
          (i32.store (i32.const 676) (local.get $savemode2))
          (call $cursor_restore (local.get $rs))   ;; back to ')'
          (call $next_token)  ;; consume ')'
          (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $tmp))  ;; LOADVAR → value
          (return (i32.const 1))))
      (return (i32.const 0))))
  (i32.const 0))

;; emit: fetch one element from iterator var $itnm (done flag var $dnm, scratch result var $rnm),
;; leaving the value (or undefined past end) on the stack. Implements IteratorStep+IteratorValue.
(func $vm_emit_iter_step (param $code i32) (param $itnm i32) (param $dnm i32) (param $rnm i32) (effects)
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $dnm))  ;; LOADVAR done
  (let $j1 i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))  ;; JMPF → not done
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef))  ;; already done → undefined
  (let $j2 i32 (call $vm_emit_jump (local.get $code) (i32.const 12)))  ;; JMP end
  (call $vm_patch (local.get $code) (local.get $j1))  ;; not done:
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_bool (i32.const 1))) (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $dnm))  ;; done=true (so a next()-throw leaves us "done" → no IteratorClose)
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $itnm))  ;; LOADVAR it
  (call $vm_emit_op (local.get $code) (i32.const 32))  ;; DUP
  (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (cstring "next"))  ;; GETPROP next
  (call $vm_emit_op (local.get $code) (i32.const 33)) (call $vm_emit_op (local.get $code) (i32.const 0))  ;; CALLM 0 → r
  (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $rnm))  ;; STOREVAR r
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $rnm))  ;; LOADVAR r
  (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (cstring "done"))  ;; GETPROP done
  (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $dnm))  ;; STOREVAR done
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $dnm))  ;; LOADVAR done
  (let $j3 i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))  ;; JMPF → have value
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef))  ;; done now → undefined
  (let $j4 i32 (call $vm_emit_jump (local.get $code) (i32.const 12)))  ;; JMP end
  (call $vm_patch (local.get $code) (local.get $j3))  ;; have value:
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $rnm))  ;; LOADVAR r
  (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (cstring "value"))  ;; GETPROP value
  (call $vm_patch (local.get $code) (local.get $j2))
  (call $vm_patch (local.get $code) (local.get $j4)))

;; emit: collect the iterator's remaining values into a fresh array (for ...rest), leaving it on the stack
(func $vm_emit_iter_rest (param $code i32) (param $itnm i32) (param $dnm i32) (param $rnm i32) (effects)
  (let $rtt i32 (call $vm_tmpname))
  (call $vm_emit_op (local.get $code) (i32.const 29)) (call $vm_emit_op (local.get $code) (i32.const 0))  ;; NEWARRAY 0
  (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $rtt))  ;; STOREVAR rest
  (let $top i32 (call $vm_emit_cursor))
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $dnm)) (call $vm_emit_op (local.get $code) (i32.const 23))  ;; LOADVAR done; NOT
  (let $jend i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))  ;; JMPF → end (done)
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_bool (i32.const 1))) (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $dnm))  ;; done=true before next() (next-throw → done)
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $itnm))  ;; LOADVAR it
  (call $vm_emit_op (local.get $code) (i32.const 32))  ;; DUP
  (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (cstring "next"))  ;; GETPROP next
  (call $vm_emit_op (local.get $code) (i32.const 33)) (call $vm_emit_op (local.get $code) (i32.const 0))  ;; CALLM 0
  (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $rnm))  ;; STOREVAR r
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $rnm))
  (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (cstring "done"))
  (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $dnm))  ;; done = r.done
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $dnm)) (call $vm_emit_op (local.get $code) (i32.const 23))  ;; LOADVAR done; NOT
  (let $jpush i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))  ;; JMPF → skip push (done now)
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $rtt))  ;; LOADVAR rest
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $rnm))
  (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (cstring "value"))  ;; r.value
  (call $vm_emit_op (local.get $code) (i32.const 52))  ;; APPEND → [rest]
  (call $vm_emit_op (local.get $code) (i32.const 11))  ;; POP
  (call $vm_patch (local.get $code) (local.get $jpush))
  (call $vm_emit_op (local.get $code) (i32.const 12)) (call $vm_emit_op (local.get $code) (local.get $top))  ;; JMP loop
  (call $vm_patch (local.get $code) (local.get $jend))
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $rtt)))  ;; leave rest array

;; member-target assignment in destructuring (assignment form): value is in @@dval,
;; base identifier ($base) already read, cursor at first '.'/'['. Navigate the member
;; chain, then assign @@dval to the final target (applying a trailing `= default`).
(func $vm_c_dstr_assign_member (param $code i32) (param $base i32) (effects)
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $base))  ;; LOADVAR base → [obj]
  (let $tkind i32 (i32.const 0))  ;; 0 = .prop (key in $tkey), 1 = [idx] (key on stack)
  (let $tkey i32 (i32.const 0))
  (block $te (loop $tl
    (if (i32.eq (call $tok_kind) (i32.const 23))  ;; '.'
      (then
        (call $next_token)
        (let $k i32 (call $ident_name)) (call $next_token)
        (if (i32.or (i32.eq (call $tok_kind) (i32.const 23)) (i32.eq (call $tok_kind) (i32.const 19)))
          (then (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (local.get $k)))  ;; GETPROP navigate
          (else (set! $tkind (i32.const 0)) (set! $tkey (local.get $k)) (br $te))))
      (else
        (call $next_token) (call $vm_c_expr (local.get $code)) (call $next_token)  ;; '[' expr ']' → [obj, key]
        (if (i32.or (i32.eq (call $tok_kind) (i32.const 23)) (i32.eq (call $tok_kind) (i32.const 19)))
          (then (call $vm_emit_op (local.get $code) (i32.const 31)))  ;; GETIDX navigate
          (else (set! $tkind (i32.const 1)) (br $te)))))
    (br $tl)))
  (if (i32.eq (call $tok_kind) (i32.const 24))  ;; trailing `= default`
    (then
      (call $next_token)
      (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (cstring "@@dval"))
      (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef)) (call $vm_emit_op (local.get $code) (i32.const 18))  ;; STRICTEQ
      (let $dsk i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))  ;; JMPF → present
      (call $vm_c_expr (local.get $code))
      (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (cstring "@@dval"))
      (call $vm_patch (local.get $code) (local.get $dsk))))
  (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (cstring "@@dval"))  ;; LOADVAR value
  (if (i32.eq (local.get $tkind) (i32.const 0))
    (then (call $vm_emit_op (local.get $code) (i32.const 34)) (call $vm_emit_op (local.get $code) (local.get $tkey)))  ;; SETPROP
    (else (call $vm_emit_op (local.get $code) (i32.const 35))))  ;; SETIDX
  (call $vm_emit_op (local.get $code) (i32.const 11)))  ;; POP result

;; store a destructuring LEAF identifier target. reg 676 distinguishes the form:
;; 1 = assignment destructuring (`[x]=…`) → assign up the chain (strict: ReferenceError
;; if undeclared; sloppy: implicit global); 0 = binding (`var [x]=…`) → define-in-current.
(func $vm_emit_dstr_store (param $code i32) (param $name i32) (effects)
  (if (i32.load (i32.const 676))
    (then (call $vm_emit_op (local.get $code) (if i32 (i32.load (i32.const 388)) (then (i32.const 80)) (else (i32.const 85)))) (call $vm_emit_op (local.get $code) (local.get $name)))
    (else (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $name)))))

(func $vm_c_destructure_param (param $code i32) (param $srcTmp i32) (effects)
  (if (i32.eq (call $tok_kind) (i32.const 19))  ;; [ array pattern ] — via iterator protocol
    (then
      (call $next_token)  ;; consume [
      (let $itnm i32 (call $vm_tmpname))
      (let $dnm i32 (call $vm_tmpname))
      (let $rnm i32 (call $vm_tmpname))
      (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $srcTmp))  ;; LOADVAR src
      (call $vm_emit_op (local.get $code) (i32.const 45))  ;; GETITER
      (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $itnm))  ;; STOREVAR it
      (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_bool (i32.const 0)))  ;; PUSH false
      (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $dnm))  ;; STOREVAR done=false
      ;; handler around the bindings: on abrupt completion (binding/default throws), IteratorClose then re-throw
      (call $vm_emit_op (local.get $code) (i32.const 48))  ;; PUSHHANDLER
      (let $dhloc i32 (call $vm_emit_cursor)) (call $vm_emit_op (local.get $code) (i32.const 0))  ;; catchIp placeholder
      (call $vm_emit_op (local.get $code) (cstring "@@dexc"))
      (let $i i32 (i32.const 0))
      (block $ae (loop $al
        (br_if $ae (i32.eq (call $tok_kind) (i32.const 20)))  ;; ]
        (if (i32.eq (call $tok_kind) (i32.const 22))  ;; elision: advance the iterator, discard
          (then
            (call $vm_emit_iter_step (local.get $code) (local.get $itnm) (local.get $dnm) (local.get $rnm))
            (call $vm_emit_op (local.get $code) (i32.const 11))  ;; POP
            (set! $i (i32.add (local.get $i) (i32.const 1))) (call $next_token) (br $al)))
        (let $isrest i32 (i32.eq (call $tok_kind) (i32.const 54)))
        (if (local.get $isrest) (then (call $next_token)))
        ;; fetch the element value onto the stack (iterator protocol)
        (if (local.get $isrest)
          (then (call $vm_emit_iter_rest (local.get $code) (local.get $itnm) (local.get $dnm) (local.get $rnm)))  ;; ...rest → array of remaining
          (else (call $vm_emit_iter_step (local.get $code) (local.get $itnm) (local.get $dnm) (local.get $rnm))))  ;; next element
        ;; nested pattern target → store to a fresh temp, recurse
        (if (i32.or (i32.eq (call $tok_kind) (i32.const 19)) (i32.eq (call $tok_kind) (i32.const 17)))
          (then
            (let $nt i32 (call $vm_tmpname))
            (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $nt))  ;; STOREVAR nt
            (call $vm_c_nested_with_default (local.get $code) (local.get $nt)))
          (else
            (let $nm i32 (call $ident_name)) (call $next_token)
            (if (i32.or (i32.eq (call $tok_kind) (i32.const 23)) (i32.eq (call $tok_kind) (i32.const 19)))  ;; member target a.b / a[i] (assignment form)
              (then (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (cstring "@@dval")) (call $vm_c_dstr_assign_member (local.get $code) (local.get $nm)))
              (else
            ;; element default (value === undefined ? default : value)
            (if (i32.and (i32.eqz (local.get $isrest)) (i32.eq (call $tok_kind) (i32.const 24)))
              (then
                (call $next_token)
                (call $vm_emit_op (local.get $code) (i32.const 32)) (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef)) (call $vm_emit_op (local.get $code) (i32.const 18))
                (let $sk i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))  ;; JMPF → value present
                (call $vm_emit_op (local.get $code) (i32.const 11))  ;; POP undefined
                (call $vm_c_expr (local.get $code))  ;; default (assignment-level: stops at ',')
                (if (i32.or (i32.eq (i32.load (i32.add (local.get $code) (i32.sub (call $vm_emit_cursor) (i32.const 8)))) (i32.const 61)) (i32.eq (i32.load (i32.add (local.get $code) (i32.sub (call $vm_emit_cursor) (i32.const 4)))) (i32.const 51)))  ;; anon fn default → name = binding
                  (then (call $vm_emit_op (local.get $code) (i32.const 72)) (call $vm_emit_op (local.get $code) (local.get $nm))))
                (call $vm_patch (local.get $code) (local.get $sk))))
            (call $vm_emit_dstr_store (local.get $code) (local.get $nm))))))  ;; store array-element target (binding/assignment)
        (set! $i (i32.add (local.get $i) (i32.const 1)))
        (if (local.get $isrest) (then (br $ae)))  ;; rest is last
        (br_if $ae (i32.eqz (call $eat (i32.const 22))))
        (br $al)))
      (call $vm_emit_op (local.get $code) (i32.const 49))  ;; POPHANDLER (normal completion)
      ;; IteratorClose on normal completion if the iterator isn't done (no rest exhausted it)
      (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $dnm)) (call $vm_emit_op (local.get $code) (i32.const 23))  ;; LOADVAR done; NOT
      (let $cdj i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))  ;; JMPF → skip (done)
      (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $itnm))  ;; LOADVAR it
      (call $vm_emit_op (local.get $code) (i32.const 74))  ;; CLOSEITER
      (call $vm_patch (local.get $code) (local.get $cdj))
      (let $dskip i32 (call $vm_emit_jump (local.get $code) (i32.const 12)))  ;; JMP → past the throw handler
      ;; throw handler: close the iterator (unless done — a next()-throw doesn't close), re-throw original
      (i32.store (i32.add (local.get $code) (local.get $dhloc)) (call $vm_emit_cursor))  ;; catchIp = here
      (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $dnm)) (call $vm_emit_op (local.get $code) (i32.const 23))  ;; LOADVAR done; NOT
      (let $dnc i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))  ;; JMPF → skip close (done)
      (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $itnm))  ;; LOADVAR it
      (call $vm_emit_op (local.get $code) (i32.const 75))  ;; CLOSEITER-suppress
      (call $vm_patch (local.get $code) (local.get $dnc))
      (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (cstring "@@dexc"))  ;; LOADVAR @@dexc
      (call $vm_emit_op (local.get $code) (i32.const 47))  ;; THROW
      (call $vm_patch (local.get $code) (local.get $dskip))
      (call $next_token)))  ;; consume ]
  (if (i32.eq (call $tok_kind) (i32.const 17))  ;; { object pattern }
    (then
      (call $next_token)  ;; consume {
      ;; RequireObjectCoercible(src) — an object pattern (even empty `{}`) throws on null/undefined
      (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $srcTmp))  ;; LOADVAR src
      (call $vm_emit_op (local.get $code) (i32.const 92))  ;; REQUIRECOERCIBLE
      ;; runtime exclusion list for ...rest (so computed keys can be added too)
      (let $exclT i32 (call $vm_tmpname))
      (call $vm_emit_op (local.get $code) (i32.const 29)) (call $vm_emit_op (local.get $code) (i32.const 0))  ;; NEWARRAY 0
      (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $exclT))  ;; STOREVAR exclT
      (block $oe (loop $ol
        (br_if $oe (i32.eq (call $tok_kind) (i32.const 18)))  ;; }
        (if (i32.eq (call $tok_kind) (i32.const 54))  ;; ...rest — bind remaining own enumerable props
          (then
            (call $next_token)
            (let $restnm i32 (call $ident_name)) (call $next_token)
            (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_native (i32.const 301) (cstring "")))  ;; PUSH objRest
            (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $srcTmp))  ;; LOADVAR src
            (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $exclT))  ;; LOADVAR exclT (runtime exclusion list)
            (call $vm_emit_op (local.get $code) (i32.const 19)) (call $vm_emit_op (local.get $code) (i32.const 2))  ;; CALL 2
            (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $restnm))  ;; STOREVAR rest
            (br $oe)))
        ;; computed key:  { [keyExpr]: target [= default] }
        (if (i32.eq (call $tok_kind) (i32.const 19))  ;; '['
          (then
            (call $next_token)  ;; consume '['
            (call $vm_c_expr (local.get $code))  ;; keyExpr → [keyVal]
            (drop (call $eat (i32.const 20)))  ;; ']'
            (let $ckt i32 (call $vm_tmpname))
            (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $ckt))  ;; STOREVAR ckt
            ;; add the computed key to the ...rest exclusion list (objRest to_prop_key's it)
            (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $exclT))  ;; LOADVAR exclT
            (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $ckt))  ;; LOADVAR ckt
            (call $vm_emit_op (local.get $code) (i32.const 52)) (call $vm_emit_op (local.get $code) (i32.const 11))  ;; APPEND; POP
            (drop (call $eat (i32.const 37)))  ;; ':'
            (let $cnested i32 (i32.or (i32.eq (call $tok_kind) (i32.const 19)) (i32.eq (call $tok_kind) (i32.const 17))))
            (let $cbind i32 (i32.const 0))
            (if (i32.eqz (local.get $cnested)) (then (set! $cbind (call $ident_name)) (call $next_token)))
            ;; fetch src[keyVal]
            (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $srcTmp))  ;; LOADVAR src
            (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $ckt))  ;; LOADVAR ckt
            (call $vm_emit_op (local.get $code) (i32.const 31))  ;; GETIDX → [value]
            (if (local.get $cnested)
              (then
                (let $cont2 i32 (call $vm_tmpname))
                (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $cont2))
                (call $vm_c_nested_with_default (local.get $code) (local.get $cont2)))
              (else
                (if (i32.eq (call $tok_kind) (i32.const 24))  ;; = default
                  (then
                    (call $next_token)
                    (call $vm_emit_op (local.get $code) (i32.const 32)) (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef)) (call $vm_emit_op (local.get $code) (i32.const 18))
                    (let $csk i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))
                    (call $vm_emit_op (local.get $code) (i32.const 11))
                    (call $vm_c_expr (local.get $code))
                    (if (i32.or (i32.eq (i32.load (i32.add (local.get $code) (i32.sub (call $vm_emit_cursor) (i32.const 8)))) (i32.const 61)) (i32.eq (i32.load (i32.add (local.get $code) (i32.sub (call $vm_emit_cursor) (i32.const 4)))) (i32.const 51)))
                      (then (call $vm_emit_op (local.get $code) (i32.const 72)) (call $vm_emit_op (local.get $code) (local.get $cbind))))
                    (call $vm_patch (local.get $code) (local.get $csk))))
                (call $vm_emit_dstr_store (local.get $code) (local.get $cbind))))  ;; store computed-key target
            (br_if $oe (i32.eqz (call $eat (i32.const 22))))
            (br $ol)))
        (let $key i32 (call $ident_name)) (call $next_token)
        (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $exclT))  ;; LOADVAR exclT
        (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_str (local.get $key)))  ;; PUSH key
        (call $vm_emit_op (local.get $code) (i32.const 52)) (call $vm_emit_op (local.get $code) (i32.const 11))  ;; APPEND; POP
        (let $bind i32 (local.get $key))
        (let $nested i32 (i32.const 0))
        (let $omem i32 (i32.const 0))  ;; member target (assignment form): key: o.y
        (if (i32.eq (call $tok_kind) (i32.const 37))  ;; key: target
          (then
            (call $next_token)
            (if (i32.or (i32.eq (call $tok_kind) (i32.const 19)) (i32.eq (call $tok_kind) (i32.const 17)))
              (then (set! $nested (i32.const 1)))
              (else (set! $bind (call $ident_name)) (call $next_token)
                    (if (i32.or (i32.eq (call $tok_kind) (i32.const 23)) (i32.eq (call $tok_kind) (i32.const 19))) (then (set! $omem (i32.const 1))))))))
        ;; fetch srcTmp[key]
        (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $srcTmp))
        (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (local.get $key))  ;; GETPROP key
        (if (local.get $nested)
          (then
            (let $ont i32 (call $vm_tmpname))
            (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $ont))
            (call $vm_c_nested_with_default (local.get $code) (local.get $ont)))
          (else (if (local.get $omem)
            (then  ;; member target: value → @@dval, navigate + assign
              (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (cstring "@@dval"))
              (call $vm_c_dstr_assign_member (local.get $code) (local.get $bind)))
            (else
            (if (i32.eq (call $tok_kind) (i32.const 24))  ;; = default
              (then
                (call $next_token)
                (call $vm_emit_op (local.get $code) (i32.const 32)) (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef)) (call $vm_emit_op (local.get $code) (i32.const 18))
                (let $osk i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))
                (call $vm_emit_op (local.get $code) (i32.const 11))
                (call $vm_c_expr (local.get $code))
                (if (i32.or (i32.eq (i32.load (i32.add (local.get $code) (i32.sub (call $vm_emit_cursor) (i32.const 8)))) (i32.const 61)) (i32.eq (i32.load (i32.add (local.get $code) (i32.sub (call $vm_emit_cursor) (i32.const 4)))) (i32.const 51)))
                  (then (call $vm_emit_op (local.get $code) (i32.const 72)) (call $vm_emit_op (local.get $code) (local.get $bind))))
                (call $vm_patch (local.get $code) (local.get $osk))))
            (call $vm_emit_dstr_store (local.get $code) (local.get $bind))))))  ;; store object-prop target
        (br_if $oe (i32.eqz (call $eat (i32.const 22))))
        (br $ol)))
      (call $next_token))))  ;; consume }

;; function declaration/expression: cursor at 'function'. Returns name ptr (0 if anonymous).
(func $vm_c_function (param $code i32) (result i32) (effects)
  (call $next_token)  ;; 'function'
  (if (i32.eq (call $tok_kind) (i32.const 12)) (then (i32.store (i32.const 236) (i32.const 1)) (call $next_token)))  ;; function*
  (let $fname i32 (i32.const 0))
  (if (i32.eq (call $tok_kind) (i32.const 3)) (then (set! $fname (call $ident_name)) (call $next_token)))  ;; optional name
  (call $vm_c_fnbody (local.get $code) (local.get $fname))
  (local.get $fname))

;; parse `( a, b = d, ...rest )` from cursor at '(' through ')'. Fills names into
;; $params and default-expr cursors (0 = none) into $pdef; the rest index → reg
;; 260 (-1 if none). Returns the parameter count. Shared by arrow functions.
(func $vm_c_paramlist (param $params i32) (param $pdef i32) (param $ppat i32) (result i32) (effects)
  (call $next_token)  ;; '('
  (i32.store (i32.const 260) (i32.const -1))  ;; restidx
  (let $np i32 (i32.const 0))
  (if (i32.ne (call $tok_kind) (i32.const 16))
    (then (block $pe (loop $pl
      (if (i32.eq (call $tok_kind) (i32.const 54)) (then (i32.store (i32.const 260) (local.get $np)) (call $next_token)))  ;; ...rest
      (i32.store (i32.add (local.get $ppat) (i32.mul (local.get $np) (i32.const 4))) (i32.const 0))
      (if (i32.or (i32.eq (call $tok_kind) (i32.const 19)) (i32.eq (call $tok_kind) (i32.const 17)))  ;; [ or { destructuring param
        (then
          (i32.store (i32.add (local.get $ppat) (i32.mul (local.get $np) (i32.const 4))) (call $cursor_save))
          (i32.store (i32.add (local.get $params) (i32.mul (local.get $np) (i32.const 4))) (call $vm_tmpname))
          (let $psd i32 (i32.const 0))
          (block $pske (loop $pskl
            (let $pk i32 (call $tok_kind))
            (br_if $pske (i32.eq (local.get $pk) (i32.const 0)))
            (if (i32.or (i32.eq (local.get $pk) (i32.const 19)) (i32.or (i32.eq (local.get $pk) (i32.const 17)) (i32.eq (local.get $pk) (i32.const 15)))) (then (set! $psd (i32.add (local.get $psd) (i32.const 1)))))
            (if (i32.or (i32.eq (local.get $pk) (i32.const 20)) (i32.or (i32.eq (local.get $pk) (i32.const 18)) (i32.eq (local.get $pk) (i32.const 16))))
              (then (set! $psd (i32.sub (local.get $psd) (i32.const 1))) (if (i32.eqz (local.get $psd)) (then (call $next_token) (br $pske)))))
            (call $next_token) (br $pskl))))
        (else
          (i32.store (i32.add (local.get $params) (i32.mul (local.get $np) (i32.const 4))) (call $ident_name))
          (call $next_token)))
      (i32.store (i32.add (local.get $pdef) (i32.mul (local.get $np) (i32.const 4))) (i32.const 0))
      (if (i32.eq (call $tok_kind) (i32.const 24))  ;; = default — record cursor, skip the expr
        (then
          (call $next_token)
          (i32.store (i32.add (local.get $pdef) (i32.mul (local.get $np) (i32.const 4))) (call $cursor_save))
          (let $dd i32 (i32.const 0))
          (block $dse (loop $dsl
            (let $dk i32 (call $tok_kind))
            (br_if $dse (i32.eq (local.get $dk) (i32.const 0)))
            (if (i32.or (i32.eq (local.get $dk) (i32.const 15)) (i32.or (i32.eq (local.get $dk) (i32.const 19)) (i32.eq (local.get $dk) (i32.const 17)))) (then (set! $dd (i32.add (local.get $dd) (i32.const 1)))))
            (if (i32.and (i32.eqz (local.get $dd)) (i32.eq (local.get $dk) (i32.const 16))) (then (br $dse)))
            (if (i32.or (i32.eq (local.get $dk) (i32.const 16)) (i32.or (i32.eq (local.get $dk) (i32.const 20)) (i32.eq (local.get $dk) (i32.const 18)))) (then (set! $dd (i32.sub (local.get $dd) (i32.const 1)))))
            (if (i32.and (i32.eqz (local.get $dd)) (i32.eq (local.get $dk) (i32.const 22))) (then (br $dse)))
            (call $next_token) (br $dsl)))))
      (set! $np (i32.add (local.get $np) (i32.const 1)))
      (br_if $pe (i32.eqz (call $eat (i32.const 22))))  ;; no comma → done
      (br_if $pe (i32.eq (call $tok_kind) (i32.const 16)))  ;; trailing comma before ')'
      (br $pl)))))
  (call $next_token)  ;; ')'
  (local.get $np))

;; arrow function: cursor at '=>'; params already collected ($params[$np], with
;; default cursors in $pdef [0=none], rest index $restidx [-1=none]). Emits the
;; default/rest prologue then the body (block → explicit return, expr → implicit).
(func $vm_c_arrow (param $code i32) (param $params i32) (param $np i32) (param $pdef i32) (param $restidx i32) (param $ppat i32) (effects)
  (call $next_token)  ;; '=>'
  (let $pj i32 (call $vm_emit_jump (local.get $code) (i32.const 12)))  ;; JMP over body
  (let $entry i32 (call $vm_emit_cursor))
  (let $bodycur i32 (call $cursor_save))
  ;; default-parameter prologue
  (if (local.get $pdef)
    (then
      (let $dpi i32 (i32.const 0))
      (block $dpe (loop $dpl
        (br_if $dpe (i32.ge_s (local.get $dpi) (local.get $np)))
        (if (i32.load (i32.add (local.get $pdef) (i32.mul (local.get $dpi) (i32.const 4))))
          (then
            (let $pn i32 (i32.load (i32.add (local.get $params) (i32.mul (local.get $dpi) (i32.const 4)))))
            (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $pn))
            (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef))
            (call $vm_emit_op (local.get $code) (i32.const 18))  ;; SEQ
            (let $sk i32 (call $vm_emit_jump (local.get $code) (i32.const 13)))  ;; JMPF skip
            (call $cursor_restore (i32.load (i32.add (local.get $pdef) (i32.mul (local.get $dpi) (i32.const 4)))))
            (call $vm_c_expr (local.get $code))
            (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $pn))
            (call $vm_patch (local.get $code) (local.get $sk))))
        (set! $dpi (i32.add (local.get $dpi) (i32.const 1)))
        (br $dpl)))))
  ;; rest-parameter prologue
  (if (i32.ge_s (local.get $restidx) (i32.const 0))
    (then
      (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (cstring "arguments"))
      (call $vm_emit_op (local.get $code) (i32.const 32))
      (call $vm_emit_op (local.get $code) (i32.const 30)) (call $vm_emit_op (local.get $code) (cstring "slice"))
      (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $num (f64.convert_i32_s (local.get $restidx))))
      (call $vm_emit_op (local.get $code) (i32.const 33)) (call $vm_emit_op (local.get $code) (i32.const 1))
      (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (i32.load (i32.add (local.get $params) (i32.mul (local.get $restidx) (i32.const 4)))))))
  ;; destructuring-parameter prologue (ppat may be 0 for single-ident arrows)
  (if (local.get $ppat)
    (then
      (let $pti i32 (i32.const 0))
      (block $pte (loop $ptl
        (br_if $pte (i32.ge_s (local.get $pti) (local.get $np)))
        (if (i32.load (i32.add (local.get $ppat) (i32.mul (local.get $pti) (i32.const 4))))
          (then
            (call $cursor_restore (i32.load (i32.add (local.get $ppat) (i32.mul (local.get $pti) (i32.const 4)))))
            (call $vm_c_destructure_param (local.get $code) (i32.load (i32.add (local.get $params) (i32.mul (local.get $pti) (i32.const 4)))))))
        (set! $pti (i32.add (local.get $pti) (i32.const 1)))
        (br $ptl)))))
  (call $cursor_restore (local.get $bodycur))
  (if (i32.eq (call $tok_kind) (i32.const 17))  ;; block body
    (then
      (call $vm_c_stmt (local.get $code))
      (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $v_undef))
      (call $vm_emit_op (local.get $code) (i32.const 20)))  ;; default RET undefined
    (else  ;; expression body → implicit return
      (call $vm_c_expr (local.get $code))
      (call $vm_emit_op (local.get $code) (i32.const 20))))  ;; RET value
  (call $vm_patch (local.get $code) (local.get $pj))
  (let $fn i32 (call $heap_alloc (i32.add (i32.const 36) (i32.mul (local.get $np) (i32.const 4)))))  ;; @(28+np*4) name, @(32+np*4) arrow flag
  (i32.store (local.get $fn) (if i32 (i32.load (i32.const 232)) (then (i32.const 1448232528)) (else (i32.const 1448232526))))  ;; ASYNC if flagged, else NORMAL
  (i32.store (i32.const 232) (i32.const 0))  ;; consume async flag
  (i32.store (i32.add (local.get $fn) (i32.const 4)) (local.get $entry))
  (i32.store (i32.add (local.get $fn) (i32.const 8)) (local.get $np))
  (i32.store (i32.add (local.get $fn) (i32.const 12)) (local.get $code))
  (i64.store (i32.add (local.get $fn) (i32.const 16)) (call $v_undef))
  (i32.store (i32.add (local.get $fn) (i32.const 24)) (i32.const 0))    ;; closureScope (filled at runtime by CLOSURE)
  (let $ci i32 (i32.const 0))
  (block $ce (loop $cl
    (br_if $ce (i32.ge_s (local.get $ci) (local.get $np)))
    (i32.store (i32.add (i32.add (local.get $fn) (i32.const 28)) (i32.mul (local.get $ci) (i32.const 4)))
               (i32.load (i32.add (local.get $params) (i32.mul (local.get $ci) (i32.const 4)))))
    (set! $ci (i32.add (local.get $ci) (i32.const 1)))
    (br $cl)))
  (i32.store (i32.add (i32.add (local.get $fn) (i32.const 28)) (i32.mul (local.get $np) (i32.const 4))) (i32.const 0))  ;; anonymous (.name "" until inferred)
  ;; flags: bit1 = arrow (always — `this` resolves lexically); bit0 = skip own
  ;; `arguments` (only when no rest param, since the rest prologue reads arguments.slice).
  (i32.store (i32.add (i32.add (local.get $fn) (i32.const 32)) (i32.mul (local.get $np) (i32.const 4)))
    (i32.or (i32.const 2) (if i32 (i32.lt_s (local.get $restidx) (i32.const 0)) (then (i32.const 1)) (else (i32.const 0)))))
  (call $vm_emit_op (local.get $code) (i32.const 61)) (call $vm_emit_op (local.get $code) (local.get $fn)))  ;; CLOSURE (capture defining scope)

;; class declaration/expression. Cursor at 'class'. Builds the prototype object,
;; the constructor, and methods (static members stored on the prototype for now).
;; isExpr=1 leaves the class value on the operand stack; isExpr=0 (declaration)
;; STOREVARs it under the class name.
(func $vm_c_class (param $code i32) (param $isExpr i32) (effects)
  (call $next_token)  ;; 'class'
  (let $clsname i32 (i32.const 0))  ;; optional (anonymous class expression)
  (if (i32.and (i32.eq (call $tok_kind) (i32.const 3)) (i32.eqz (call $tok_is_kw (cstring "extends"))))
    (then (set! $clsname (call $ident_name)) (call $next_token)))
  (let $protoT i32 (call $vm_tmpname))
  (let $ctorT i32 (call $vm_tmpname))
  (let $superT i32 (i32.const 0))
  (if (call $tok_is_kw (cstring "extends"))
    (then
      (call $next_token)
      (set! $superT (call $vm_tmpname))
      (call $vm_c_postfix (local.get $code))
      (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $superT))))
  (call $next_token)  ;; '{'
  (call $vm_emit_op (local.get $code) (i32.const 36)) (call $vm_emit_op (local.get $code) (i32.const 0))  ;; NEWOBJ 0 → empty proto
  (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $protoT))
  ;; per-instance field initializers: a flat array [name1, thunk1, ...] stored on the
  ;; proto as @@fieldinits and replayed by NEW/NEWSPREAD onto each instance.
  (let $fieldsT i32 (call $vm_tmpname))
  (call $vm_emit_op (local.get $code) (i32.const 29)) (call $vm_emit_op (local.get $code) (i32.const 0))  ;; NEWARRAY 0 (instance fields)
  (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $fieldsT))
  (let $staticT i32 (call $vm_tmpname))
  (call $vm_emit_op (local.get $code) (i32.const 29)) (call $vm_emit_op (local.get $code) (i32.const 0))  ;; NEWARRAY 0 (static fields)
  (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $staticT))
  (let $hasstatic i32 (i32.const 0))  ;; any static FIELD seen? (only then emit APPLYSTATIC, so SETPROTO stays the last op for name inference)
  (if (local.get $superT)
    (then
      (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $protoT))
      (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $superT))
      (call $vm_emit_op (local.get $code) (i32.const 57))  ;; EXTEND → [proto]
      (call $vm_emit_op (local.get $code) (i32.const 11))))
  (let $hasctor i32 (i32.const 0))
  (block $cme (loop $cml
    (br_if $cme (i32.eq (call $tok_kind) (i32.const 18)))  ;; '}'
    (br_if $cme (i32.eq (call $tok_kind) (i32.const 0)))
    (if (call $eat (i32.const 21)) (then (br $cml)))  ;; stray ';' between members
    ;; leading modifiers: `static` then `*` (generator). `async` is left untouched
    ;; (async methods/generators unsupported — handling them flips accidental passes).
    (let $isgen i32 (i32.const 0))
    (let $isasync i32 (i32.const 0))
    (let $isstatic i32 (i32.const 0))
    (if (call $str_eq (call $ident_name) (cstring "static"))  ;; `static` modifier (unless member named "static")
      (then
        (let $stc i32 (call $cursor_save))
        (call $next_token)
        (if (i32.or (i32.eq (call $tok_kind) (i32.const 15)) (i32.or (i32.eq (call $tok_kind) (i32.const 24)) (i32.eq (call $tok_kind) (i32.const 18))))
          (then (call $cursor_restore (local.get $stc)))
          (else (set! $isstatic (i32.const 1))))))  ;; confirmed `static` modifier
    ;; static initialization block: `static { ... }` → append [@@staticblock, blockThunk] to staticT
    (if (i32.and (local.get $isstatic) (i32.eq (call $tok_kind) (i32.const 17)))
      (then
        (set! $hasstatic (i32.const 1))
        (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $staticT))  ;; LOADVAR staticT
        (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_str (cstring "@@staticblock")))  ;; PUSH sentinel name
        (call $vm_emit_op (local.get $code) (i32.const 52))  ;; APPEND name
        (call $vm_emit_block_thunk (local.get $code))  ;; → blockThunk on stack
        (call $vm_emit_op (local.get $code) (i32.const 52))  ;; APPEND thunk
