                      (then (call $vm_emit_op (local.get $code) (i32.const 72)) (call $vm_emit_op (local.get $code) (call $str_concat (if i32 (local.get $isget) (then (cstring "get ")) (else (cstring "set "))) (local.get $oaname)))))
                    (call $vm_emit_op (local.get $code) (if i32 (local.get $isget) (then (i32.const 66)) (else (i32.const 67)))))  ;; DEFGET / DEFSET
                  (else (if (i32.eq (call $tok_kind) (i32.const 15))  ;; method NAME(){}
                    (then
                      (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_str (local.get $oki)))
                      (i32.store (i32.const 236) (local.get $ogen))  ;; *gen(){} → generator method
                      (i32.store (i32.const 232) (local.get $oasync))  ;; async method / async generator method
                      (i32.store (i32.const 692) (i32.const 1))  ;; method → no .prototype (gated on !generator in fnbody)
                      (i32.store (i32.const 700) (i32.add (local.get $opropstart) (i32.const 1)))
                      (call $vm_c_fnbody (local.get $code) (i32.const 0))
                      (call $vm_emit_op (local.get $code) (i32.const 72)) (call $vm_emit_op (local.get $code) (local.get $oki))  ;; method .name = key
                      (call $vm_emit_op (local.get $code) (i32.const 101)))  ;; DEFDATA_OWN — a method is always an own prop (a `__proto__(){}` method does NOT set the prototype)
                    (else
