  ;; identifier: `function f(await){ return await; }`). A plain fn resets it; nested arrows compile inline
  ;; and inherit. Saved/restored per body so a nested regular fn doesn't clobber the enclosing value.
  (let $saveinasync i32 (i32.load (i32.const 896)))
  (i32.store (i32.const 896) (local.get $asyncf))
  (let $savesb i32 (i32.load (i32.const 912)))  ;; a nested function body is NOT the class static block (return/arguments/await allowed per its own kind)
