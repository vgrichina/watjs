  ;; the ';' fell through to vm_c_commaexpr, whose primary parser pushed a phantom `undefined`
  ;; without consuming the ';', and a following `(…)` (the `;(function(){})()` anti-ASI idiom)
  ;; was then parsed as a CALL of that undefined → spurious "called value is not a function".
  (if (i32.eq (call $tok_kind) (i32.const 21)) (then (call $next_token) (return)))
