                    ;; RequireObjectCoercible(base) after key eval, before ToPropertyKey; key computed once, reused GET+SET.
                    (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $pck))  ;; STOREVAR rawkey → [obj]
                    (call $vm_emit_op (local.get $code) (i32.const 32)) (call $vm_emit_op (local.get $code) (i32.const 92))  ;; DUP; REQUIRECOERCIBLE(base)
                    (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $pck)) (call $vm_emit_op (local.get $code) (i32.const 102)) (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $pck))  ;; @@k = ToPropertyKey(rawkey)
                    (call $vm_emit_op (local.get $code) (i32.const 32))  ;; DUP → [obj,obj]
                    (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $pck))  ;; LOADVAR key → [obj,obj,key]
                    (call $vm_emit_op (local.get $code) (i32.const 31))  ;; GETIDX → [obj, old]
                    (call $vm_emit_op (local.get $code) (i32.const 97))  ;; TONUMERIC
                    (call $vm_emit_op (local.get $code) (local.get $pop))  ;; INC/DEC → [obj, new]
                    (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $pcv))  ;; STOREVAR new → [obj]
                    (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $pck))  ;; LOADVAR key → [obj,key]
                    (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $pcv))  ;; LOADVAR new → [obj,key,new]
                    (call $vm_emit_op (local.get $code) (if i32 (i32.load (i32.const 388)) (then (i32.const 83)) (else (i32.const 35))))  ;; SETIDX → [new]
                    (br $pme)))))))
