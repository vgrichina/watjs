        (if (i32.or (call $is_object (local.get $wb)) (i32.or (call $is_array (local.get $wb)) (call $is_function (local.get $wb))))
          (then (set! $wb (call $to_primitive_h (local.get $wb) (i32.const 1))) (if (call $err) (then (br $disp)))))
        (if (i32.eqz (call $is_bigint (local.get $wb)))
          (then (set! $wb (call $num (call $to_num (local.get $wb)))) (if (call $err) (then (br $disp)))))
        ;; BigInt bitwise/shift/** (both operands must be BigInt; >>> is not allowed)
        (if (i32.or (call $is_bigint (local.get $wa)) (call $is_bigint (local.get $wb)))
          (then
            (if (i32.eqz (i32.and (call $is_bigint (local.get $wa)) (call $is_bigint (local.get $wb))))
              (then (call $throw_type (cstring "TypeError") (cstring "Cannot mix BigInt and other types, use explicit conversions")) (br $disp)))
            (let $wia i64 (call $bigint_val (local.get $wa)))
            (let $wib i64 (call $bigint_val (local.get $wb)))
            (let $wbr i64 (i64.const 0))
            (if (i32.eq (local.get $op) (i32.const 37)) (then (set! $wbr (i64.and (local.get $wia) (local.get $wib)))))
            (if (i32.eq (local.get $op) (i32.const 38)) (then (set! $wbr (i64.or (local.get $wia) (local.get $wib)))))
            (if (i32.eq (local.get $op) (i32.const 39)) (then (set! $wbr (i64.xor (local.get $wia) (local.get $wib)))))
            (if (i32.eq (local.get $op) (i32.const 40)) (then (set! $wbr (i64.shl (local.get $wia) (i64.and (local.get $wib) (i64.const 63))))))
            (if (i32.eq (local.get $op) (i32.const 41)) (then (set! $wbr (i64.shr_s (local.get $wia) (i64.and (local.get $wib) (i64.const 63))))))
            (if (i32.eq (local.get $op) (i32.const 42)) (then (call $throw_type (cstring "TypeError") (cstring "BigInts have no unsigned right shift")) (br $disp)))
            (if (i32.eq (local.get $op) (i32.const 43))  ;; ** by repeated multiply
              (then
                (if (i64.lt_s (local.get $wib) (i64.const 0)) (then (call $throw_type (cstring "RangeError") (cstring "Exponent must be non-negative")) (br $disp)))
                (set! $wbr (i64.const 1))
                (let $we i64 (local.get $wib))
                (block $we0 (loop $wel (br_if $we0 (i64.le_s (local.get $we) (i64.const 0))) (set! $wbr (i64.mul (local.get $wbr) (local.get $wia))) (set! $we (i64.sub (local.get $we) (i64.const 1))) (br $wel)))))
            (i64.store (i32.add (local.get $stack) (i32.sub (local.get $sp) (i32.const 8))) (call $mk_bigint (local.get $wbr)))
            (br $disp)))
        (if (i32.eq (local.get $op) (i32.const 37)) (then (set! $wr (call $num (f64.convert_i32_s (i32.and (call $to_int32 (local.get $wa)) (call $to_int32 (local.get $wb))))))))
        (if (i32.eq (local.get $op) (i32.const 38)) (then (set! $wr (call $num (f64.convert_i32_s (i32.or (call $to_int32 (local.get $wa)) (call $to_int32 (local.get $wb))))))))
        (if (i32.eq (local.get $op) (i32.const 39)) (then (set! $wr (call $num (f64.convert_i32_s (i32.xor (call $to_int32 (local.get $wa)) (call $to_int32 (local.get $wb))))))))
        (if (i32.eq (local.get $op) (i32.const 40)) (then (set! $wr (call $num (f64.convert_i32_s (i32.shl (call $to_int32 (local.get $wa)) (i32.and (call $to_int32 (local.get $wb)) (i32.const 31))))))))
        (if (i32.eq (local.get $op) (i32.const 41)) (then (set! $wr (call $num (f64.convert_i32_s (i32.shr_s (call $to_int32 (local.get $wa)) (i32.and (call $to_int32 (local.get $wb)) (i32.const 31))))))))
        (if (i32.eq (local.get $op) (i32.const 42)) (then (set! $wr (call $num (f64.convert_i32_u (i32.shr_u (call $to_int32 (local.get $wa)) (i32.and (call $to_int32 (local.get $wb)) (i32.const 31))))))))
        (if (i32.eq (local.get $op) (i32.const 43)) (then (set! $wr (call $num (call $f64_pow (call $tonum_raw (local.get $wa)) (call $tonum_raw (local.get $wb)))))))
        (i64.store (i32.add (local.get $stack) (i32.sub (local.get $sp) (i32.const 8))) (local.get $wr))
        (br $disp)))
    ;; binary arithmetic (- * / %): pop b, then a — ToNumber both (bool/string/obj
    ;; coercion). Left operand is coerced FIRST (its valueOf must run before the right's).
    (set! $sp (i32.sub (local.get $sp) (i32.const 8)))
    (let $bav i64 (i64.load (i32.add (local.get $stack) (i32.sub (local.get $sp) (i32.const 8)))))
    (let $bbv i64 (i64.load (i32.add (local.get $stack) (local.get $sp))))
    ;; Full ToNumeric(lhs) THEN ToNumeric(rhs), left-first and ATOMIC per operand
    ;; (ToPrimitive then keep-BigInt-else-ToNumber): a BigInt WRAPPER (Object(1n)) is seen
    ;; as BigInt by the mix-check; and a lhs whose ToNumber throws (Symbol) does so BEFORE
    ;; rhs is coerced (preserves observable evaluation order).
    (if (i32.or (call $is_object (local.get $bav)) (i32.or (call $is_array (local.get $bav)) (call $is_function (local.get $bav))))
      (then (set! $bav (call $to_primitive_h (local.get $bav) (i32.const 1))) (if (call $err) (then (br $disp)))))
    (if (i32.eqz (call $is_bigint (local.get $bav)))
      (then (set! $bav (call $num (call $to_num (local.get $bav)))) (if (call $err) (then (br $disp)))))
    (if (i32.or (call $is_object (local.get $bbv)) (i32.or (call $is_array (local.get $bbv)) (call $is_function (local.get $bbv))))
      (then (set! $bbv (call $to_primitive_h (local.get $bbv) (i32.const 1))) (if (call $err) (then (br $disp)))))
    (if (i32.eqz (call $is_bigint (local.get $bbv)))
      (then (set! $bbv (call $num (call $to_num (local.get $bbv)))) (if (call $err) (then (br $disp)))))
    ;; BigInt arithmetic (both operands must be BigInt)
    (if (i32.or (call $is_bigint (local.get $bav)) (call $is_bigint (local.get $bbv)))
      (then
        (if (i32.eqz (i32.and (call $is_bigint (local.get $bav)) (call $is_bigint (local.get $bbv))))
          (then (call $throw_type (cstring "TypeError") (cstring "Cannot mix BigInt and other types, use explicit conversions")) (br $disp)))
        (let $bia i64 (call $bigint_val (local.get $bav)))
        (let $bib i64 (call $bigint_val (local.get $bbv)))
        (if (i32.and (i32.or (i32.eq (local.get $op) (i32.const 5)) (i32.eq (local.get $op) (i32.const 22))) (i64.eqz (local.get $bib)))
          (then (call $throw_type (cstring "RangeError") (cstring "Division by zero")) (br $disp)))
        (let $bir i64 (i64.const 0))
        (if (i32.eq (local.get $op) (i32.const 3)) (then (set! $bir (i64.sub (local.get $bia) (local.get $bib)))))
        (if (i32.eq (local.get $op) (i32.const 4)) (then (set! $bir (i64.mul (local.get $bia) (local.get $bib)))))
        (if (i32.eq (local.get $op) (i32.const 5)) (then (set! $bir (i64.div_s (local.get $bia) (local.get $bib)))))
        (if (i32.eq (local.get $op) (i32.const 22)) (then (set! $bir (i64.rem_s (local.get $bia) (local.get $bib)))))
        (i64.store (i32.add (local.get $stack) (i32.sub (local.get $sp) (i32.const 8))) (call $mk_bigint (local.get $bir)))
        (br $disp)))
    (let $a f64 (call $to_num (local.get $bav)))
    (let $b f64 (call $to_num (local.get $bbv)))
    (let $r f64 (f64.const 0))
    (if (i32.eq (local.get $op) (i32.const 3)) (then (set! $r (f64.sub (local.get $a) (local.get $b)))))
    (if (i32.eq (local.get $op) (i32.const 4)) (then (set! $r (f64.mul (local.get $a) (local.get $b)))))
    (if (i32.eq (local.get $op) (i32.const 5)) (then (set! $r (f64.div (local.get $a) (local.get $b)))))
    (if (i32.eq (local.get $op) (i32.const 22)) (then (set! $r (call $fmod (local.get $a) (local.get $b)))))  ;; %
    (i64.store (i32.add (local.get $stack) (i32.sub (local.get $sp) (i32.const 8))) (call $num (local.get $r)))
    (br $disp))
  (call $v_undef))  ;; unreachable (loop always returns)

;; entry: compile then run a single expression to HALT, returning the number
(func $eval_vm (param $ptr i32) (param $len i32) (result f64) (effects)
  (call $tonum_raw (call $vm_step (call $vm_new (call $vm_compile (local.get $ptr) (local.get $len))) (call $v_undef))))

;; create a generator object from a function* — a suspended VM context plus a
;; `next` method. Calling gen() does NOT run the body; each gen.next() resumes.
(func $vm_make_generator (param $fn i32) (param $argc i32) (param $argv i32) (param $gscope i32) (param $thisv i64) (result i64) (effects)
  (let $np i32 (i32.load (i32.add (local.get $fn) (i32.const 8))))
  (let $ns i32 (call $scope_new (call $vm_fn_parent (local.get $fn) (local.get $gscope)) (i32.add (local.get $np) (i32.const 5))))
  ;; receiver captured at call time (generator body resumes with the right `this`); OrdinaryCallBindThis
  ;; coerces per strictness (generators are never arrows, so `this` is always bound here).
  (call $scope_define (local.get $ns) (cstring "this") (call $coerce_this (local.get $thisv) (i32.load (i32.add (i32.add (local.get $fn) (i32.const 32)) (i32.mul (local.get $np) (i32.const 4))))))
  (let $i i32 (i32.const 0))
  (block $pe (loop $pl
    (br_if $pe (i32.ge_s (local.get $i) (local.get $np)))
    (call $scope_define (local.get $ns) (i32.load (i32.add (i32.add (local.get $fn) (i32.const 28)) (i32.mul (local.get $i) (i32.const 4))))
      (if i64 (i32.lt_s (local.get $i) (local.get $argc))
        (then (i64.load (i32.add (local.get $argv) (i32.mul (local.get $i) (i32.const 8)))))
        (else (call $v_undef))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $pl)))
  (call $scope_define_attr (local.get $ns) (cstring "arguments") (call $vm_make_arguments_argv (local.get $ns) (local.get $fn) (local.get $argv) (local.get $argc)) (i32.const 10))  ;; generators have their own arguments (never arrows)
  (let $ctx i32 (call $heap_alloc (i32.const 48)))
  (i32.store (local.get $ctx) (i32.load (i32.add (local.get $fn) (i32.const 12))))            ;; code
  (i32.store (i32.add (local.get $ctx) (i32.const 4)) (i32.load (i32.add (local.get $fn) (i32.const 4))))  ;; ip = entry
  (i32.store (i32.add (local.get $ctx) (i32.const 8)) (call $heap_alloc (i32.const 8192)))
  (i32.store (i32.add (local.get $ctx) (i32.const 12)) (i32.const 0))
  (i32.store (i32.add (local.get $ctx) (i32.const 16)) (i32.const 0))                          ;; not done
  (i32.store (i32.add (local.get $ctx) (i32.const 20)) (local.get $ns))
  (i32.store (i32.add (local.get $ctx) (i32.const 24)) (i32.const 0))
  (i32.store (i32.add (local.get $ctx) (i32.const 28)) (local.get $gscope))
  (i32.store (i32.add (local.get $ctx) (i32.const 32)) (i32.const 0))  ;; handler chain
  (i32.store (i32.add (local.get $ctx) (i32.const 36)) (i32.const 0))  ;; await resume flag
  (i32.store (i32.add (local.get $ctx) (i32.const 40)) (i32.const 0))  ;; not at a yield*
  (i32.store (i32.add (local.get $ctx) (i32.const 44)) (i32.const 0))  ;; not executing (re-entrancy guard)
  ;; eager param eval: run the prologue (defaults/destructuring) now, suspending at
  ;; GENPRO_SUSPEND. A throw here sets the err flag, which vm_step returns and the
  ;; calling frame's loop unwinds — i.e. the generator call throws, per spec.
  (drop (call $vm_step (local.get $ctx) (call $v_undef)))
  (let $g i32 (call $obj_new (i32.const 4)))
  (let $isag i32 (i32.and (i32.load (i32.add (i32.add (local.get $fn) (i32.const 32)) (i32.mul (local.get $np) (i32.const 4)))) (i32.const 128)))
  (let $gpr i32 (i32.load (if i32 (local.get $isag) (then (i32.const 796)) (else (i32.const 792)))))
  (if (local.get $gpr) (then (i32.store (local.get $g) (local.get $gpr)))
    (else (if (i32.load (i32.const 488)) (then (i32.store (local.get $g) (i32.load (i32.const 488)))))))
  (call $scope_define (local.get $g) (cstring "@@ctx") (call $num (f64.convert_i32_s (local.get $ctx))))
  ;; next/return/throw are inherited from %GeneratorPrototype% / %AsyncGeneratorPrototype% (not own)
  ;; async generator (fn flag bit7): mark the object so next/return/throw return promises,
  ;; and expose Symbol.asyncIterator → this (native 342 = Iterator.prototype[@@iterator] → this).
  (if (local.get $isag)
    (then
      (call $scope_define (local.get $g) (cstring "@@asyncgen") (call $v_true))
      (call $scope_define_attr (local.get $g) (cstring "@@asyncIterator") (call $mk_native (i32.const 342) (cstring "[Symbol.asyncIterator]")) (i32.const 12))))
  (call $mk_obj (local.get $g)))

;; the @@ctx of a generator object, or 0 + a thrown TypeError if the receiver is not a
;; generator (next/return/throw must reject a foreign `this` instead of trapping on trunc(NaN)).
(func $gen_ctx_or_throw (param $genv i64) (result i32) (effects)
  (if (i32.eqz (call $is_object (local.get $genv)))
    (then (call $throw_type (cstring "TypeError") (cstring "not a generator")) (return (i32.const 0))))
  (let $gcs i32 (call $scope_find_local (call $val_payload (local.get $genv)) (cstring "@@ctx")))
  (if (i32.eqz (local.get $gcs))
    (then (call $throw_type (cstring "TypeError") (cstring "not a generator")) (return (i32.const 0))))
  (i32.trunc_f64_s (call $to_num (i64.load (local.get $gcs)))))

;; CreateDisposableResource for a `using` / `await using` initializer (ERM). Per spec GetDisposeMethod:
;; a nullish value has no dispose (allowed, no-op → returns undefined); any other non-Object throws
;; TypeError; the value must expose a callable [Symbol.dispose] (sync) or [Symbol.asyncDispose] with a
;; [Symbol.dispose] fallback (async), else TypeError. Returns the captured dispose method (called ONCE
;; here per spec), or undefined for a nullish value / on error. hint: 0 = sync-dispose, 1 = async.
(func $vm_check_disposable (param $v i64) (param $isasync i32) (result i64) (effects)
  (if (i32.or (call $is_null (local.get $v)) (call $is_undefined (local.get $v))) (then (return (call $v_undef))))  ;; nullish → no resource
  (if (i32.eqz (i32.or (call $is_object (local.get $v)) (call $is_function (local.get $v))))
    (then (call $throw_type (cstring "TypeError") (cstring "using declaration initializer is not an object")) (return (call $v_undef))))
  (let $m i64 (i64.const 0))
  (if (local.get $isasync)
    (then
      (set! $m (call $get_prop (local.get $v) (call $mk_str (cstring "@@asyncDispose"))))
      (if (call $err) (then (return (call $v_undef))))
      (if (i32.or (call $is_null (local.get $m)) (call $is_undefined (local.get $m)))
        (then  ;; async-dispose absent → fall back to sync [Symbol.dispose]
          (set! $m (call $get_prop (local.get $v) (call $mk_str (cstring "@@dispose"))))
          (if (call $err) (then (return (call $v_undef)))))))
    (else
      (set! $m (call $get_prop (local.get $v) (call $mk_str (cstring "@@dispose"))))
      (if (call $err) (then (return (call $v_undef))))))
  (if (i32.or (call $is_null (local.get $m)) (call $is_undefined (local.get $m)))
    (then (call $throw_type (cstring "TypeError") (cstring "using declaration initializer has no dispose method")) (return (call $v_undef))))
  (if (i32.eqz (call $is_function (local.get $m)))
    (then (call $throw_type (cstring "TypeError") (cstring "using declaration dispose method is not callable")) (return (call $v_undef))))
  (local.get $m))

;; Register a validated sync disposable {value, method} on the runtime scope's "@@usingres" list (a
;; boxed array of alternating value,method pairs in declaration order). Disposed LIFO by $vm_dispose_scope.
(func $vm_register_disposable (param $scope i32) (param $v i64) (param $method i64) (effects)
  (let $slot i32 (call $scope_find_local (local.get $scope) (cstring "@@usingres")))
  (let $ap i32 (i32.const 0))
  (if (local.get $slot)
    (then (set! $ap (call $val_payload (i64.load (local.get $slot)))))
    (else (set! $ap (call $arr_new (i32.const 4))) (call $scope_define (local.get $scope) (cstring "@@usingres") (call $mk_arr (local.get $ap)))))
  (call $arr_push (local.get $ap) (local.get $v))
  (call $arr_push (local.get $ap) (local.get $method)))

;; DisposeResources for a scope being popped: call each sync dispose method in REVERSE (LIFO) order
;; with the resource value as `this`. A throwing dispose sets err → the dispatch loop unwinds (single
;; error propagates as-is; SuppressedError aggregation for multiple errors is a follow-up). The list is
;; cleared so a scope popped via more than one path never double-disposes. (Sync only — async-dispose
;; hint resources are not registered yet, so `await using` disposal is unaffected here.)
(func $vm_dispose_scope (param $scope i32) (effects)
  (let $slot i32 (call $scope_find_local (local.get $scope) (cstring "@@usingres")))
  (if (i32.eqz (local.get $slot)) (then (return)))
  (let $ap i32 (call $val_payload (i64.load (local.get $slot))))
  (let $n i32 (call $arr_len (local.get $ap)))
  (if (i32.eqz (local.get $n)) (then (return)))
  (let $argv i32 (call $heap_alloc (i32.const 8)))
  (let $i i32 (i32.sub (local.get $n) (i32.const 2)))
  (block $de (loop $dl
    (br_if $de (i32.lt_s (local.get $i) (i32.const 0)))
    (let $rv i64 (call $arr_get (local.get $ap) (local.get $i)))
    (let $rm i64 (call $arr_get (local.get $ap) (i32.add (local.get $i) (i32.const 1))))
    (drop (call $call_val (local.get $rm) (i32.const 0) (local.get $argv) (local.get $rv)))
    (br_if $de (call $err))  ;; a dispose threw → propagate (dispatch loop unwinds)
    (set! $i (i32.sub (local.get $i) (i32.const 2)))
    (br $dl)))
  (i32.store (local.get $ap) (i32.const 0)))  ;; clear so a scope popped via multiple paths never double-disposes

;; IteratorClose for a yield* delegation (used when .throw() hits an iterator with no `throw`
;; method): call the iterator's `return` (if any) and verify it returns an Object, else TypeError.
;; (A bespoke close — unlike $iter_close it enforces the result-is-Object invariant per spec.)
(func $yieldstar_close (param $it i64) (effects)
  (let $m i64 (call $get_prop (local.get $it) (call $mk_str (cstring "return"))))
  (if (call $err) (then (return)))
  (if (i32.or (call $is_undefined (local.get $m)) (call $is_null (local.get $m))) (then (return)))
  (if (i32.eqz (call $is_function (local.get $m)))
    (then (call $throw_type (cstring "TypeError") (cstring "iterator return is not a function")) (return)))
  (let $r i64 (call $call_val (local.get $m) (i32.const 0) (call $heap_alloc (i32.const 8)) (local.get $it)))
  (if (call $err) (then (return)))
  (if (i32.eqz (call $is_object (local.get $r)))
    (then (call $throw_type (cstring "TypeError") (cstring "iterator return result is not an object")))))

;; finish a yield* step from an inner iterator-result: validate it's an Object, read done/value,
;; and set reg840 (action). donekind=0 (next/throw): done → action 1 (yield* completes, outer
;; gen continues after). donekind=1 (return): done → action 2 (outer gen returns the value).
;; Not done → action 0 (yield the value, stay in the loop). Returns the value.
(func $yieldstar_finish (param $ir i64) (param $donekind i32) (result i64) (effects)
  (if (call $err) (then (return (call $v_undef))))
  (if (i32.eqz (call $is_object (local.get $ir)))
    (then (call $throw_type (cstring "TypeError") (cstring "iterator result is not an object")) (return (call $v_undef))))
  (let $done i32 (call $truthy (call $get_prop (local.get $ir) (call $mk_str (cstring "done")))))
  (if (call $err) (then (return (call $v_undef))))
  (let $val i64 (call $get_prop (local.get $ir) (call $mk_str (cstring "value"))))
  (if (call $err) (then (return (call $v_undef))))
  (i32.store (i32.const 840)
    (if i32 (local.get $done) (then (if i32 (local.get $donekind) (then (i32.const 2)) (else (i32.const 1)))) (else (i32.const 0))))
  (local.get $val))

;; one step of a sync yield* delegation. rkind: 0 next / 1 throw / 2 return; recv = the value
;; passed in by the resuming .next/.throw/.return. Drives the inner iterator's next/throw/return
;; per the spec (YieldExpression : yield * AssignmentExpression). Sets reg840 (action) and returns
;; the value. Errors surface via the err flag (the YSSTEP op leaves vm_step to unwind them).
(func $yieldstar_step (param $it i64) (param $recv i64) (param $rkind i32) (result i64) (effects)
  (let $args i32 (call $heap_alloc (i32.const 8)))
  (i64.store (local.get $args) (local.get $recv))
  ;; --- next ---
  (if (i32.eqz (local.get $rkind))
    (then
      (let $mn i64 (call $get_prop (local.get $it) (call $mk_str (cstring "next"))))
      (if (call $err) (then (return (call $v_undef))))
      (if (i32.eqz (call $is_function (local.get $mn)))
        (then (call $throw_type (cstring "TypeError") (cstring "iterator.next is not a function")) (return (call $v_undef))))
      (return (call $yieldstar_finish (call $call_val (local.get $mn) (i32.const 1) (local.get $args) (local.get $it)) (i32.const 0)))))
  ;; --- throw ---
  (if (i32.eq (local.get $rkind) (i32.const 1))
    (then
      (let $mt i64 (call $get_prop (local.get $it) (call $mk_str (cstring "throw"))))
      (if (call $err) (then (return (call $v_undef))))
      (if (i32.or (call $is_undefined (local.get $mt)) (call $is_null (local.get $mt)))
        (then  ;; no throw method → IteratorClose then TypeError (NormalCompletion close, abrupt throw)
          (call $yieldstar_close (local.get $it))
          (if (call $err) (then (return (call $v_undef))))
          (call $throw_type (cstring "TypeError") (cstring "iterator has no throw method"))
          (return (call $v_undef))))
      (if (i32.eqz (call $is_function (local.get $mt)))
        (then (call $throw_type (cstring "TypeError") (cstring "iterator.throw is not a function")) (return (call $v_undef))))
      (return (call $yieldstar_finish (call $call_val (local.get $mt) (i32.const 1) (local.get $args) (local.get $it)) (i32.const 0)))))
  ;; --- return ---
  (let $mr i64 (call $get_prop (local.get $it) (call $mk_str (cstring "return"))))
  (if (call $err) (then (return (call $v_undef))))
  (if (i32.or (call $is_undefined (local.get $mr)) (call $is_null (local.get $mr)))
    (then  ;; no return method → outer generator returns recv (Completion(received))
      (i32.store (i32.const 840) (i32.const 2))
      (return (local.get $recv))))
  (if (i32.eqz (call $is_function (local.get $mr)))
    (then (call $throw_type (cstring "TypeError") (cstring "iterator.return is not a function")) (return (call $v_undef))))
  (call $yieldstar_finish (call $call_val (local.get $mr) (i32.const 1) (local.get $args) (local.get $it)) (i32.const 1)))

;; gen.throw(e): resume the generator by THROWING e at the suspension point, so an in-body
;; try/catch (whose handler chain was saved in the ctx at YIELD) can catch it. If uncaught the
;; generator closes and the error propagates to the caller. A completed/suspendedStart gen has
;; no in-body handler → the error just propagates (gen closed).
(func $vm_gen_throw (param $genv i64) (param $errv i64) (result i64) (effects)
  (let $ctx i32 (call $gen_ctx_or_throw (local.get $genv)))
  (if (call $err) (then (return (call $v_undef))))
  (if (i32.load (i32.add (local.get $ctx) (i32.const 44)))  ;; already running → TypeError, complete
    (then (i32.store (i32.add (local.get $ctx) (i32.const 16)) (i32.const 1))
          (call $throw_type (cstring "TypeError") (cstring "generator is already running")) (return (call $v_undef))))
  ;; suspended at a yield* → deliver the throw to the inner iterator (rkind=1, value=errv) and
  ;; resume normally; the loop's YSSTEP handles inner.throw / IteratorClose+TypeError.
  (if (i32.load (i32.add (local.get $ctx) (i32.const 40)))
    (then
      (i32.store (i32.const 836) (i32.const 1))
      (i32.store (i32.add (local.get $ctx) (i32.const 44)) (i32.const 1))
      (let $vt i64 (call $vm_step (local.get $ctx) (local.get $errv)))
      (i32.store (i32.add (local.get $ctx) (i32.const 44)) (i32.const 0))
      (if (call $err) (then (return (call $v_undef))))
      (let $rt i32 (call $obj_new (i32.const 2)))
      (call $scope_define (local.get $rt) (cstring "value") (local.get $vt))
      (call $scope_define (local.get $rt) (cstring "done") (call $mk_bool (call $vm_done (local.get $ctx))))
      (return (call $mk_obj (local.get $rt)))))
  (if (call $vm_done (local.get $ctx))  ;; throwing into a completed generator → re-throw to the caller
    (then (call $set_err (i32.const 1)) (call $set_err_val (local.get $errv)) (return (call $v_undef))))
  (call $set_err (i32.const 1)) (call $set_err_val (local.get $errv))
  (i32.store (i32.add (local.get $ctx) (i32.const 44)) (i32.const 1))
  (let $v i64 (call $vm_step (local.get $ctx) (call $v_undef)))  ;; resume → err unwinds to the saved handler
  (i32.store (i32.add (local.get $ctx) (i32.const 44)) (i32.const 0))
  (if (call $err) (then (return (call $v_undef))))  ;; uncaught → gen closed, propagate to caller
  (let $r i32 (call $obj_new (i32.const 2)))  ;; caught → ran to the next yield / completion
  (call $scope_define (local.get $r) (cstring "value") (local.get $v))
  (call $scope_define (local.get $r) (cstring "done") (call $mk_bool (call $vm_done (local.get $ctx))))
  (call $mk_obj (local.get $r)))

;; gen.return(v): if the generator is suspended inside a try/finally, resume by injecting the
;; return-completion sentinel so the finally body runs (vm_step skips catch/iterator-close
;; handlers for the sentinel; only runOnReturn handlers execute). When the sentinel escapes all
;; handlers — or there was no finally to run — complete with { value:v, done:true }. A finally
;; that itself returns/throws overrides (its abrupt completion is no longer the sentinel).
(func $vm_gen_return (param $genv i64) (param $value i64) (result i64) (effects)
  (let $ctx i32 (call $gen_ctx_or_throw (local.get $genv)))
  (if (call $err) (then (return (call $v_undef))))
  (if (i32.load (i32.add (local.get $ctx) (i32.const 44)))  ;; already running → TypeError, complete
    (then (i32.store (i32.add (local.get $ctx) (i32.const 16)) (i32.const 1))
          (call $throw_type (cstring "TypeError") (cstring "generator is already running")) (return (call $v_undef))))
  ;; suspended at a yield* → deliver return to the inner iterator (rkind=2, value) and resume; the
  ;; loop's YSSTEP calls inner.return and decides yield-again vs complete (per spec done flag).
  (if (i32.load (i32.add (local.get $ctx) (i32.const 40)))
    (then
      (i32.store (i32.const 836) (i32.const 2))
      (i32.store (i32.add (local.get $ctx) (i32.const 44)) (i32.const 1))
      (let $vr i64 (call $vm_step (local.get $ctx) (local.get $value)))
      (i32.store (i32.add (local.get $ctx) (i32.const 44)) (i32.const 0))
      (if (call $err) (then (return (call $v_undef))))
      (let $rr i32 (call $obj_new (i32.const 2)))
      (call $scope_define (local.get $rr) (cstring "value") (local.get $vr))
      (call $scope_define (local.get $rr) (cstring "done") (call $mk_bool (call $vm_done (local.get $ctx))))
      (return (call $mk_obj (local.get $rr)))))
  ;; not suspended in a runOnReturn (try/finally) handler → no finally to run: just close.
  (let $hasfin i32 (i32.const 0))
  (let $h i32 (i32.load (i32.add (local.get $ctx) (i32.const 32))))
  (block $we (loop $wl
    (br_if $we (i32.eqz (local.get $h)))
    (if (i32.load (i32.add (local.get $h) (i32.const 24))) (then (set! $hasfin (i32.const 1)) (br $we)))
    (set! $h (i32.load (i32.add (local.get $h) (i32.const 20))))
    (br $wl)))
  (if (i32.or (call $vm_done (local.get $ctx)) (i32.eqz (local.get $hasfin)))
    (then
      (i32.store (i32.add (local.get $ctx) (i32.const 16)) (i32.const 1))  ;; mark done (no finally to run)
      (let $r0 i32 (call $obj_new (i32.const 2)))
      (call $scope_define (local.get $r0) (cstring "value") (local.get $value))
      (call $scope_define (local.get $r0) (cstring "done") (call $v_true))
      (return (call $mk_obj (local.get $r0)))))
  ;; suspended inside try/finally: throw the sentinel to run the finally(s).
  (call $set_err (i32.const 1)) (call $set_err_val (i64.load (i32.const 832)))
  (i32.store (i32.add (local.get $ctx) (i32.const 44)) (i32.const 1))
  (let $v i64 (call $vm_step (local.get $ctx) (call $v_undef)))
  (i32.store (i32.add (local.get $ctx) (i32.const 44)) (i32.const 0))
  (let $r i32 (call $obj_new (i32.const 2)))
  (if i64 (call $err)
    (then
      (if i64 (i64.eq (call $err_val) (i64.load (i32.const 832)))
        (then  ;; sentinel escaped all finallys → return completes with the original value
          (call $set_err (i32.const 0))
          (i32.store (i32.add (local.get $ctx) (i32.const 16)) (i32.const 1))
          (call $scope_define (local.get $r) (cstring "value") (local.get $value))
          (call $scope_define (local.get $r) (cstring "done") (call $v_true))
          (call $mk_obj (local.get $r)))
        (else (call $v_undef))))  ;; a finally threw a real error → propagate (err stays set)
    (else
      ;; the finally ran a normal return (RET → halts the gen) or yielded (suspended): use the
      ;; gen's actual value/done. A `return X` in finally overrides v with X via the RET path.
      (call $scope_define (local.get $r) (cstring "value") (local.get $v))
      (call $scope_define (local.get $r) (cstring "done") (call $mk_bool (call $vm_done (local.get $ctx))))
      (call $mk_obj (local.get $r)))))

;; gen.next(): resume the generator context, return { value, done }
(func $vm_gen_result (param $genv i64) (param $resumeval i64) (result i64) (effects)
  (let $ctx i32 (call $gen_ctx_or_throw (local.get $genv)))
  (if (call $err) (then (return (call $v_undef))))
  ;; resuming a generator that is currently running its own body → TypeError, and complete it
  (if (i32.load (i32.add (local.get $ctx) (i32.const 44)))
    (then (i32.store (i32.add (local.get $ctx) (i32.const 16)) (i32.const 1))
          (call $throw_type (cstring "TypeError") (cstring "generator is already running")) (return (call $v_undef))))
  (let $r i32 (call $obj_new (i32.const 2)))
  (if (call $vm_done (local.get $ctx))
    (then
      (call $scope_define (local.get $r) (cstring "value") (call $v_undef))
      (call $scope_define (local.get $r) (cstring "done") (call $v_true)))
    (else
      (i32.store (i32.const 836) (i32.const 0))  ;; resume kind = next (for a yield* delegation point)
      (i32.store (i32.add (local.get $ctx) (i32.const 44)) (i32.const 1))  ;; mark executing
      (let $v i64 (call $vm_step (local.get $ctx) (local.get $resumeval)))
      (i32.store (i32.add (local.get $ctx) (i32.const 44)) (i32.const 0))  ;; clear executing
      (call $scope_define (local.get $r) (cstring "value") (local.get $v))
      (call $scope_define (local.get $r) (cstring "done") (call $mk_bool (call $vm_done (local.get $ctx))))))
  (call $mk_obj (local.get $r)))

;; OrdinaryCallBindThis coercion of a `this` value for a non-arrow function.
;; cflags bit2 (4) = strict. Strict: pass through unchanged. Sloppy: null/undefined
;; → the global object, a primitive → its wrapper object (ToObject), object → as-is.
(func $coerce_this (param $thisv i64) (param $cflags i32) (result i64) (effects)
  (if (i32.and (local.get $cflags) (i32.const 4)) (then (return (local.get $thisv))))  ;; strict
  (if (i32.or (call $is_undefined (local.get $thisv)) (call $is_null (local.get $thisv)))
    (then (return (call $mk_obj (i32.load (i32.const 204))))))  ;; sloppy null/undefined → global
  (if (i32.or (call $is_object (local.get $thisv)) (i32.or (call $is_array (local.get $thisv)) (i32.or (call $is_function (local.get $thisv)) (call $is_proxy (local.get $thisv)))))
    (then (return (local.get $thisv))))  ;; already an object
  (call $to_object (local.get $thisv)))  ;; sloppy primitive → wrapper

;; native->VM bridge: invoke a VM-fn (magic-marked struct) from engine code
;; (e.g. Array.prototype.map calling its callback). Runs the function body in a
;; fresh context to completion and returns its result. Enables higher-order
;; built-ins to take VM functions as callbacks.
(func $vm_call_fn (param $fn i32) (param $argc i32) (param $argv i32) (param $thisv i64) (result i64) (effects)
  (let $np i32 (i32.load (i32.add (local.get $fn) (i32.const 8))))
  (let $ns i32 (call $scope_new (call $vm_fn_parent (local.get $fn) (i32.load (i32.const 204))) (i32.add (local.get $np) (i32.const 4))))
  (let $i i32 (i32.const 0))
  (block $pe (loop $pl
    (br_if $pe (i32.ge_s (local.get $i) (local.get $np)))
    (call $scope_define (local.get $ns) (i32.load (i32.add (i32.add (local.get $fn) (i32.const 28)) (i32.mul (local.get $i) (i32.const 4))))
      (if i64 (i32.lt_s (local.get $i) (local.get $argc))
        (then (i64.load (i32.add (local.get $argv) (i32.mul (local.get $i) (i32.const 8)))))
        (else (call $v_undef))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $pl)))
  ;; arrows (flags bit1) bind no own `this`, and arrows w/o rest (bit0) no own
  ;; `arguments` — both resolve lexically through the captured scope.
  (let $vcflags i32 (i32.load (i32.add (i32.add (local.get $fn) (i32.const 32)) (i32.mul (local.get $np) (i32.const 4)))))
  ;; derived class ctor (class bit3 + prototype carries @@super) → `this` is TDZ until super();
  ;; the received object is stashed in @@newo. (i32.and(8,bool) is bitwise → nested ifs.)
  (let $vcderived i32 (i32.const 0))
  (if (i32.and (local.get $vcflags) (i32.const 8))
    (then (let $vcp i64 (i64.load (i32.add (local.get $fn) (i32.const 16))))
      (if (call $is_object (local.get $vcp))
        (then (if (call $scope_find_local (call $val_payload (local.get $vcp)) (cstring "@@super")) (then (set! $vcderived (i32.const 1))))))))
  (if (i32.eqz (i32.and (local.get $vcflags) (i32.const 2)))
    (then (if (local.get $vcderived)
      (then (call $scope_define (local.get $ns) (cstring "this") (call $v_tdz))
            (call $scope_define (local.get $ns) (cstring "@@newo") (local.get $thisv)))
      (else (call $scope_define (local.get $ns) (cstring "this") (call $coerce_this (local.get $thisv) (local.get $vcflags)))))))
  ;; class ctor → bind @@homeproto = this ctor's home prototype (its .prototype, which carries
  ;; @@super) so super() resolves THIS level's parent, not this.@@super (which a multi-level
  ;; C-extends-B-extends-A chain resolves to the outermost @@super → infinite recursion).
  (if (i32.and (local.get $vcflags) (i32.const 8))
    (then (call $scope_define (local.get $ns) (cstring "@@homeproto") (call $get_prop (call $mk_fn (local.get $fn)) (call $mk_str (cstring "prototype"))))))
  ;; base class ctor via the native bridge → run its own fields (vm_run_own_fields clears reg 640/656)
  (if (i32.and (local.get $vcflags) (i32.const 8))
    (then (if (i32.eqz (local.get $vcderived))
      (then (call $vm_run_own_fields (local.get $thisv) (i64.load (i32.add (local.get $fn) (i32.const 16))))))))
  ;; new.target: $vm_construct parks the newTarget in reg 656 (raw 0 = none) just
  ;; before this call; consume it here so `new.target` is bound inside the body
  ;; (a plain call leaves it 0 → new.target resolves lexically/undefined).
  (let $vcnt i64 (i64.load (i32.const 656)))
  (i64.store (i32.const 656) (i64.const 0))
  ;; a class ctor (bit3) reached via a plain call (no parked newTarget) — e.g. a bound
  ;; class ctor called without `new`, since call_bound routes through vm_call_fn and
  ;; bypasses the CALL-op no-new check — must throw, not run the body. (Previously this
  ;; threw only incidentally because super() failed on the bad `this`; now super()
  ;; resolves via @@homeproto regardless, so the check has to be explicit here.)
  (if (i32.and (local.get $vcflags) (i32.const 8))
    (then (if (i64.eqz (local.get $vcnt))
      (then (call $throw_type (cstring "TypeError") (cstring "Class constructor cannot be invoked without 'new'")) (return (call $v_undef))))))
  (if (i32.and (i64.ne (local.get $vcnt) (i64.const 0)) (i32.eqz (i32.and (local.get $vcflags) (i32.const 2))))
    (then (call $scope_define (local.get $ns) (cstring "@@newtarget") (local.get $vcnt))))
  ;; bind `arguments` so callbacks invoked by native methods (forEach/map/sort/…) can use it
  (if (i32.eqz (i32.and (local.get $vcflags) (i32.const 1)))
    (then (call $scope_define_attr (local.get $ns) (cstring "arguments") (call $vm_make_arguments_argv (local.get $ns) (local.get $fn) (local.get $argv) (local.get $argc)) (i32.const 10))))
  (let $ctx i32 (call $heap_alloc (i32.const 48)))
  (i32.store (local.get $ctx) (i32.load (i32.add (local.get $fn) (i32.const 12))))          ;; code buffer
  (i32.store (i32.add (local.get $ctx) (i32.const 4)) (i32.load (i32.add (local.get $fn) (i32.const 4))))  ;; ip = entry
  ;; operand stack from a reuse pool (reg 648 = free-list head). The operand stack is
  ;; NEVER captured by a closure (only the locals scope is), so it's safe to recycle on
  ;; return — this kills the per-call 8KB leak that exhausted the heap (e.g. Array.sort
  ;; with a comparator on >~50 elements). Each free buffer's first word = next-free ptr.
  (let $opst i32 (i32.load (i32.const 648)))
  (if (local.get $opst)
    (then (i32.store (i32.const 648) (i32.load (local.get $opst))))  ;; pop the free-list head
    (else (set! $opst (call $heap_alloc (i32.const 8192)))))         ;; pool empty → fresh
  (i32.store (i32.add (local.get $ctx) (i32.const 8)) (local.get $opst))  ;; own operand stack
  (i32.store (i32.add (local.get $ctx) (i32.const 12)) (i32.const 0))
  (i32.store (i32.add (local.get $ctx) (i32.const 16)) (i32.const 0))
  (i32.store (i32.add (local.get $ctx) (i32.const 20)) (local.get $ns))
  (i32.store (i32.add (local.get $ctx) (i32.const 24)) (i32.const 0))                        ;; frame 0 → RET halts
  (i32.store (i32.add (local.get $ctx) (i32.const 28)) (i32.load (i32.const 204)))
  (i32.store (i32.add (local.get $ctx) (i32.const 32)) (i32.const 0))                        ;; handler chain
  (i32.store (i32.add (local.get $ctx) (i32.const 36)) (i32.const 0))  ;; await resume flag
  (let $rv i64 (call $v_undef))
  (block $e (loop $l
    (br_if $e (call $vm_done (local.get $ctx)))
    (set! $rv (call $vm_step (local.get $ctx) (call $v_undef)))
    (br $l)))
  ;; return the operand-stack buffer to the pool (the run loop has completed; nothing
  ;; references it — the result $rv is a value, the scope is separate)
  (i32.store (local.get $opst) (i32.load (i32.const 648)))
  (i32.store (i32.const 648) (local.get $opst))
  (local.get $rv))

;; ── minimal promises + async/await ──
;; A promise is an object with @@promise + @@pval (resolved value). No timers
;; exist in this engine, so resolution is synchronous; await unwraps the value.
(func $vm_is_promise (param $v i64) (result i32) (effects)
  (if (i32.eqz (call $is_object (local.get $v))) (then (return (i32.const 0))))
  (i32.ne (call $scope_find_local (call $val_payload (local.get $v)) (cstring "@@promise")) (i32.const 0)))
;; promise object: @@promise, @@pstate (0 pending/1 fulfilled/2 rejected), @@pval.
;; Synchronous model (no microtask queue): executors/handlers run eagerly.
(func $mk_promise (param $state i32) (param $val i64) (result i64) (effects)
  (let $o i32 (call $obj_new (i32.const 6)))
  (if (i32.load (i32.const 608)) (then (i32.store (local.get $o) (i32.load (i32.const 608)))))  ;; [[Prototype]] = Promise.prototype
  (call $scope_define (local.get $o) (cstring "@@promise") (call $v_true))
  (call $scope_define (local.get $o) (cstring "@@pstate") (call $num (f64.convert_i32_s (local.get $state))))
  (call $scope_define (local.get $o) (cstring "@@pval") (local.get $val))
  (call $mk_obj (local.get $o)))
(func $promise_state (param $p i64) (result i32) (effects)
  (i32.trunc_f64_s (call $to_num (call $get_prop (local.get $p) (call $mk_str (cstring "@@pstate"))))))
;; Promise.resolve(v): a promise as-is; else a fulfilled promise (adopt a thenable's value)
(func $vm_promise (param $v i64) (result i64) (effects)
  (if (call $vm_is_promise (local.get $v)) (then (return (local.get $v))))
  (call $mk_promise (i32.const 1) (local.get $v)))
;; PromiseResolve(v) — spec-faithful: a native promise as-is; otherwise a fresh promise
;; resolved with v, which ADOPTS a thenable (calls v.then). Used by `await`/for-await so
;; `await thenable` yields its resolved value and `await Promise.reject` rejects. (vm_promise
;; above is the eager fulfill used where assimilation must not happen, e.g. reaction adoption.)
(func $vm_promise_resolve (param $v i64) (result i64) (effects)
  (if (call $vm_is_promise (local.get $v)) (then (return (local.get $v))))
  (let $p i64 (call $mk_promise (i32.const 0) (call $v_undef)))
  (call $promise_resolve_with (local.get $p) (local.get $v))
  (local.get $p))
;; await: a fulfilled promise → its value; a rejected promise → re-throw the reason
(func $vm_await_unwrap (param $v i64) (result i64) (effects)
  (if (call $vm_is_promise (local.get $v))
    (then
      (if (i32.eq (call $promise_state (local.get $v)) (i32.const 2))
        (then (call $set_err (i32.const 1)) (call $set_err_val (call $get_prop (local.get $v) (call $mk_str (cstring "@@pval")))) (return (call $v_undef))))
      (return (call $get_prop (local.get $v) (call $mk_str (cstring "@@pval"))))))
  (local.get $v))
;; run one reaction handler `h` with `val`; on a thrown error → rejected promise,
;; else resolve the handler's result (adopting a returned promise).
(func $promise_run_handler (param $h i64) (param $val i64) (result i64) (effects)
  (let $av i32 (call $heap_alloc (i32.const 8)))
  (i64.store (local.get $av) (local.get $val))
  (let $r i64 (call $call_val (local.get $h) (i32.const 1) (local.get $av) (call $v_undef)))
  (if (call $err) (then (let $e i64 (call $err_val)) (call $set_err (i32.const 0)) (return (call $mk_promise (i32.const 2) (local.get $e)))))
  (call $vm_promise (local.get $r)))
;; promise.then(onF, onR)
(func $promise_then (param $p i64) (param $onF i64) (param $onR i64) (result i64) (effects)
  ;; then/catch require an actual Promise as `this` (else promise_state truncs NaN → trap)
  (if (i32.eqz (call $vm_is_promise (local.get $p)))
    (then (call $throw_type (cstring "TypeError") (cstring "Promise.prototype.then called on incompatible receiver")) (return (call $v_undef))))
  (let $st i32 (call $promise_state (local.get $p)))
  (let $tres i64 (call $mk_promise (i32.const 0) (call $v_undef)))  ;; the .then() result promise
  (if (i32.eq (local.get $st) (i32.const 0))
    (then (call $promise_add_reaction (local.get $p) (local.get $onF) (local.get $onR) (local.get $tres)))  ;; pending → react on settle
    (else  ;; already settled → schedule the handler as a microtask (correct ordering: after sync code)
      (call $job_enqueue
        (if i64 (i32.eq (local.get $st) (i32.const 1)) (then (local.get $onF)) (else (local.get $onR)))
        (call $get_prop (local.get $p) (call $mk_str (cstring "@@pval")))
        (local.get $tres) (local.get $st))))
  (local.get $tres))
;; legacy single-arg then (used by async-return paths)
(func $vm_promise_then (param $pv i64) (param $cb i64) (result i64) (effects)
  (call $promise_then (local.get $pv) (local.get $cb) (call $v_undef)))

;; ── deferred resolution: per-promise reactions, settled synchronously on resolve/reject ──
;; (no microtask queue yet — handlers fire eagerly when the promise transitions, which fixes
;; `new Promise(r=>…later…r(v))` + `.then` registered while pending. Microtask ORDERING and
;; async-fn await-suspension are still TODO.) Reactions live flat in @@reactions:
;; [onFulfilled, onRejected, resultPromise] per registration.
(func $promise_reactions_arr (param $p i64) (result i32) (effects)
  (let $sl i32 (call $scope_find_local (call $val_payload (local.get $p)) (cstring "@@reactions")))
  (if (i32.eqz (local.get $sl)) (then (return (i32.const 0))))
  (call $val_payload (i64.load (local.get $sl))))
(func $promise_add_reaction (param $p i64) (param $onF i64) (param $onR i64) (param $result i64) (effects)
  (let $po i32 (call $val_payload (local.get $p)))
  (let $sl i32 (call $scope_find_local (local.get $po) (cstring "@@reactions")))
  (let $arr i32 (if i32 (local.get $sl) (then (call $val_payload (i64.load (local.get $sl))))
                  (else (let $na i32 (call $arr_new (i32.const 6))) (call $scope_define (local.get $po) (cstring "@@reactions") (call $mk_arr (local.get $na))) (local.get $na))))
  (call $arr_push (local.get $arr) (local.get $onF))
  (call $arr_push (local.get $arr) (local.get $onR))
  (call $arr_push (local.get $arr) (local.get $result)))
;; resolve `result` with the handler output `out` (adopt a promise, else fulfill)
;; ResolvePromise(result, out): same promise → TypeError; an object with a callable `then` →
;; adopt via that then (PromiseResolveThenableJob — honours a custom/overridden then); else
;; fulfill with `out`.
(func $promise_resolve_with (param $result i64) (param $out i64) (effects)
  (if (call $strict_eq (local.get $result) (local.get $out))
    (then (call $promise_settle (local.get $result) (i32.const 2) (call $make_error (cstring "TypeError") (cstring "Chaining cycle detected"))) (return)))
  (if (i32.or (call $is_object (local.get $out)) (i32.or (call $is_array (local.get $out)) (call $is_function (local.get $out))))
    (then
      (let $then i64 (call $get_prop (local.get $out) (call $mk_str (cstring "then"))))
      (if (call $err) (then (let $te i64 (call $err_val)) (call $set_err (i32.const 0)) (call $promise_settle (local.get $result) (i32.const 2) (local.get $te)) (return)))  ;; getting .then threw → reject
      (if (call $is_function (local.get $then))
        (then  ;; out.then(resolve(result), reject(result)) — drives `result` from `out`'s eventual state
          (let $rb i32 (call $heap_alloc (i32.const 16)))
          (i64.store (local.get $rb) (call $promise_bound_settler (i32.const 415) (local.get $result)))
          (i64.store (i32.add (local.get $rb) (i32.const 8)) (call $promise_bound_settler (i32.const 416) (local.get $result)))
          (drop (call $call_val (local.get $then) (i32.const 2) (local.get $rb) (local.get $out)))
          (if (call $err) (then (let $ce i64 (call $err_val)) (call $set_err (i32.const 0)) (call $promise_settle (local.get $result) (i32.const 2) (local.get $ce))))  ;; then threw → reject
          (return)))))
  (call $promise_settle (local.get $result) (i32.const 1) (local.get $out)))
;; transition `p` (if still pending) to state/val and run its registered reactions. No thenable
;; adoption here — resolve paths go through promise_resolve_with; this just fulfils/rejects.
(func $promise_settle (param $p i64) (param $state i32) (param $val i64) (effects)
  (if (i32.ne (call $promise_state (local.get $p)) (i32.const 0)) (then (return)))  ;; resolve/reject is one-shot
  (call $set_prop (local.get $p) (call $mk_str (cstring "@@pstate")) (call $num (f64.convert_i32_s (local.get $state))))
  (call $set_prop (local.get $p) (call $mk_str (cstring "@@pval")) (local.get $val))
  (call $promise_fire_reactions (local.get $p)))
(func $promise_fire_reactions (param $p i64) (effects)
  (let $arr i32 (call $promise_reactions_arr (local.get $p)))
  (if (i32.eqz (local.get $arr)) (then (return)))
  (let $st i32 (call $promise_state (local.get $p)))
  (let $val i64 (call $get_prop (local.get $p) (call $mk_str (cstring "@@pval"))))
  (let $n i32 (call $arr_len (local.get $arr)))
  ;; clear BEFORE running (a handler may add new reactions to a chained promise, not this one)
  (call $scope_define (call $val_payload (local.get $p)) (cstring "@@reactions") (call $mk_arr (call $arr_new (i32.const 1))))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    (let $h i64 (if i64 (i32.eq (local.get $st) (i32.const 1)) (then (call $arr_get (local.get $arr) (local.get $i))) (else (call $arr_get (local.get $arr) (i32.add (local.get $i) (i32.const 1))))))
    (let $result i64 (call $arr_get (local.get $arr) (i32.add (local.get $i) (i32.const 2))))
    (call $job_enqueue (local.get $h) (local.get $val) (local.get $result) (local.get $st))  ;; run as a microtask
    (set! $i (i32.add (local.get $i) (i32.const 3)))
    (br $l))))
;; a native (415 resolve / 416 reject) bound to its promise as `this`
(func $promise_bound_settler (param $nid i32) (param $promise i64) (result i64) (effects)
  (let $bf i32 (call $heap_alloc (i32.const 44)))
  (i32.store (local.get $bf) (i32.const 1448232540))                                  ;; bound magic
  (i32.store (i32.add (local.get $bf) (i32.const 8)) (i32.const 1))                    ;; .length
  ;; name as an own data property "" {W:false,E:false,C:true} — these settlers are anonymous
  ;; built-in functions; spec requires name (and length) to be own properties.
  (let $bps i32 (call $scope_new (i32.const 0) (i32.const 4)))
  (i32.store (i32.add (local.get $bf) (i32.const 12)) (local.get $bps))               ;; props
  (call $scope_define_attr (local.get $bps) (cstring "name") (call $mk_str (cstring "")) (i32.const 4))
  (i64.store (i32.add (local.get $bf) (i32.const 16)) (local.get $promise))           ;; bound this = the promise
  (i64.store (i32.add (local.get $bf) (i32.const 24)) (call $mk_native (local.get $nid) (cstring "")))  ;; target native
  (i32.store (i32.add (local.get $bf) (i32.const 32)) (i32.const 0))                   ;; bargc
  (i32.store (i32.add (local.get $bf) (i32.const 36)) (i32.const 0))                   ;; bargs
  (call $mk_fn (local.get $bf)))

;; call an async function: run its body, driving each await to the resolved
;; value, and return a promise of the body's return value.
;; Build the (mapped) `arguments` object for a call. Indices < min(argc,nparams)
;; alias the call scope's parameter slots (get_prop/set_prop special-case @@as);
;; extra args are plain data props. Has length, @@iterator, and slice.
(func $vm_make_arguments (param $cns i32) (param $cfn i32) (param $stack i32) (param $cbase i32) (param $argc i32) (result i64) (effects)
  (let $ao i32 (call $obj_new (i32.const 8)))
  (let $np i32 (i32.load (i32.add (local.get $cfn) (i32.const 8))))
  (let $anp i32 (if i32 (i32.lt_s (local.get $argc) (local.get $np)) (then (local.get $argc)) (else (local.get $np))))
  ;; strict-mode OR non-simple-param-list functions get an UNMAPPED arguments object: no index
  ;; aliases a parameter (flags bit2 strict | bit4 non-simple). Force @@anp=0 so every arg
  ;; [0,argc) becomes an ordinary {W,E,C} data property.
  (if (i32.and (i32.load (i32.add (local.get $cfn) (i32.add (i32.const 32) (i32.mul (local.get $np) (i32.const 4))))) (i32.const 20))
    (then (set! $anp (i32.const 0))))
  (call $scope_define_attr (local.get $ao) (cstring "length") (call $num (f64.convert_i32_s (local.get $argc))) (i32.const 12))  ;; arguments.length is {W,C} non-enumerable (DontEnum)
  (call $scope_define (local.get $ao) (cstring "@@as") (call $num (f64.convert_i32_s (local.get $cns))))
  (call $scope_define (local.get $ao) (cstring "@@af") (call $num (f64.convert_i32_s (local.get $cfn))))
  (call $scope_define (local.get $ao) (cstring "@@anp") (call $num (f64.convert_i32_s (local.get $anp))))
  (call $scope_define_attr (local.get $ao) (cstring "@@iterator") (i64.load (i32.const 756)) (i32.const 12))  ;; arguments[@@iterator] === %Array.prototype.values% (same object as [][Symbol.iterator]); {W,C} non-enumerable
  (call $scope_define_attr (local.get $ao) (cstring "slice") (call $mk_native (i32.const 142) (cstring "slice")) (i32.const 12))  ;; non-standard helper → at least keep it non-enumerable
  ;; arguments.callee — strict (unmapped): a %ThrowTypeError% accessor {E:f,C:f}; sloppy (mapped):
  ;; the function itself {W:t,E:f,C:t}. (fn flags live at @(32+np*4); bit2 = strict.)
  (if (i32.and (i32.load (i32.add (local.get $cfn) (i32.add (i32.const 32) (i32.mul (local.get $np) (i32.const 4))))) (i32.const 4))
    (then (let $clte i64 (i64.load (i32.const 764)))  ;; the shared %ThrowTypeError% intrinsic (NOT a fresh one — must === fn.caller's getter)
          (call $scope_define_accessor_attr (local.get $ao) (cstring "callee") (local.get $clte) (local.get $clte) (i32.const 0)))
    (else (call $scope_define_attr (local.get $ao) (cstring "callee") (call $mk_fn (local.get $cfn)) (i32.const 12))))
  (let $i i32 (i32.const 0))  ;; ALL args → own data props (mapped indices too, so gOPD/ownKeys/hasOwn see them; [[Get]]/[[Set]] still alias the param for idx<@@anp)
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $argc)))
    (call $scope_define (local.get $ao) (call $num_to_str (f64.convert_i32_s (local.get $i))) (i64.load (i32.add (local.get $stack) (i32.add (local.get $cbase) (i32.mul (i32.add (local.get $i) (i32.const 1)) (i32.const 8))))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (call $mk_obj (local.get $ao)))

;; arguments object for the native-callback call path (vm_call_fn): args live in
;; a flat $argv buffer (not the operand stack). Mapped slots alias $cns params;
;; extras are read straight from $argv.
(func $vm_make_arguments_argv (param $cns i32) (param $cfn i32) (param $argv i32) (param $argc i32) (result i64) (effects)
  (let $ao i32 (call $obj_new (i32.const 8)))
  (let $np i32 (i32.load (i32.add (local.get $cfn) (i32.const 8))))
  (let $anp i32 (if i32 (i32.lt_s (local.get $argc) (local.get $np)) (then (local.get $argc)) (else (local.get $np))))
  ;; strict-mode OR non-simple-param-list functions get an UNMAPPED arguments object: no index
  ;; aliases a parameter (flags bit2 strict | bit4 non-simple). Force @@anp=0 so every arg
  ;; [0,argc) becomes an ordinary {W,E,C} data property.
  (if (i32.and (i32.load (i32.add (local.get $cfn) (i32.add (i32.const 32) (i32.mul (local.get $np) (i32.const 4))))) (i32.const 20))
    (then (set! $anp (i32.const 0))))
  (call $scope_define_attr (local.get $ao) (cstring "length") (call $num (f64.convert_i32_s (local.get $argc))) (i32.const 12))  ;; arguments.length is {W,C} non-enumerable (DontEnum)
  (call $scope_define (local.get $ao) (cstring "@@as") (call $num (f64.convert_i32_s (local.get $cns))))
  (call $scope_define (local.get $ao) (cstring "@@af") (call $num (f64.convert_i32_s (local.get $cfn))))
  (call $scope_define (local.get $ao) (cstring "@@anp") (call $num (f64.convert_i32_s (local.get $anp))))
  (call $scope_define_attr (local.get $ao) (cstring "@@iterator") (i64.load (i32.const 756)) (i32.const 12))  ;; arguments[@@iterator] === %Array.prototype.values% (same object as [][Symbol.iterator]); {W,C} non-enumerable
  (call $scope_define_attr (local.get $ao) (cstring "slice") (call $mk_native (i32.const 142) (cstring "slice")) (i32.const 12))  ;; non-standard helper → at least keep it non-enumerable
  ;; arguments.callee — strict (unmapped): a %ThrowTypeError% accessor {E:f,C:f}; sloppy (mapped):
  ;; the function itself {W:t,E:f,C:t}. (fn flags live at @(32+np*4); bit2 = strict.)
  (if (i32.and (i32.load (i32.add (local.get $cfn) (i32.add (i32.const 32) (i32.mul (local.get $np) (i32.const 4))))) (i32.const 4))
    (then (let $clte i64 (i64.load (i32.const 764)))  ;; the shared %ThrowTypeError% intrinsic (NOT a fresh one — must === fn.caller's getter)
          (call $scope_define_accessor_attr (local.get $ao) (cstring "callee") (local.get $clte) (local.get $clte) (i32.const 0)))
    (else (call $scope_define_attr (local.get $ao) (cstring "callee") (call $mk_fn (local.get $cfn)) (i32.const 12))))
  (let $i i32 (i32.const 0))  ;; ALL args → own data props (see vm_make_arguments)
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $argc)))
    (call $scope_define (local.get $ao) (call $num_to_str (f64.convert_i32_s (local.get $i))) (i64.load (i32.add (local.get $argv) (i32.mul (local.get $i) (i32.const 8)))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (call $mk_obj (local.get $ao)))

;; ── microtask job queue (reg 704 = pending job array; flat [handler,arg,result,state]) ──
;; NOTE reg 704 deliberately — reg 492 is an i64 (spans 492-499, written on every var lookup
;; by scope_find's with-delegation), so 496 collided. 700-720 are free. Reactions/continuations
;; enqueue here and drain AFTER the synchronous script, so .then callbacks run as microtasks
;; (sync code first). Drained in BATCHES (snapshot + clear + process), same final order as
;; one-at-a-time FIFO, no head index.
(func $job_enqueue (param $handler i64) (param $arg i64) (param $result i64) (param $state i32) (effects)
  (let $q i32 (i32.load (i32.const 704)))
  (if (i32.eqz (local.get $q)) (then (set! $q (call $arr_new (i32.const 16))) (i32.store (i32.const 704) (local.get $q))))
  (call $arr_push (local.get $q) (local.get $handler))
  (call $arr_push (local.get $q) (local.get $arg))
  (call $arr_push (local.get $q) (local.get $result))
  (call $arr_push (local.get $q) (call $num (f64.convert_i32_s (local.get $state)))))
(func $job_drain (effects)
  (block $outer (loop $ol
    (let $q i32 (i32.load (i32.const 704)))
    (br_if $outer (i32.eqz (local.get $q)))
    (let $n i32 (call $arr_len (local.get $q)))
    (br_if $outer (i32.eqz (local.get $n)))
    (i32.store (i32.const 704) (i32.const 0))  ;; detach this batch; jobs it enqueues go to a fresh queue
    (let $i i32 (i32.const 0))
    (block $e (loop $l
      (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
      (let $handler i64 (call $arr_get (local.get $q) (local.get $i)))
      (let $arg i64 (call $arr_get (local.get $q) (i32.add (local.get $i) (i32.const 1))))
      (let $result i64 (call $arr_get (local.get $q) (i32.add (local.get $i) (i32.const 2))))
      (let $state i32 (i32.trunc_f64_s (call $to_num (call $arr_get (local.get $q) (i32.add (local.get $i) (i32.const 3))))))
      (if (call $is_function (local.get $handler))
        (then  ;; run handler(arg); resolve the result with its RAW return (resolve_with adopts a
               ;; thenable). Do NOT vm_promise-wrap — that re-adopts forever and OOBs.
          (let $hb i32 (call $heap_alloc (i32.const 8)))
          (i64.store (local.get $hb) (local.get $arg))
          (let $hr i64 (call $call_val (local.get $handler) (i32.const 1) (local.get $hb) (call $v_undef)))
          (if (call $err)
            (then (let $he i64 (call $err_val)) (call $set_err (i32.const 0)) (call $promise_settle (local.get $result) (i32.const 2) (local.get $he)))
            (else (call $promise_resolve_with (local.get $result) (local.get $hr)))))
        (else (call $promise_settle (local.get $result) (local.get $state) (local.get $arg))))
      (set! $i (i32.add (local.get $i) (i32.const 4)))
      (br $l)))
    (br $ol))))

;; Drive an async-function context: one vm_step runs the synchronous chunk to the next await,
;; then ALWAYS suspend — resolve the awaited value to a promise and schedule resumption as a
;; microtask (promise_then), so every await yields. Settles `rp` on completion.
(func $async_drive (param $ctx i32) (param $rp i64) (param $resume0 i64) (effects)
  (let $v i64 (call $vm_step (local.get $ctx) (local.get $resume0)))
  (if (call $vm_done (local.get $ctx))
    (then
      (if (call $err)
        (then (let $ae i64 (call $err_val)) (call $set_err (i32.const 0)) (call $promise_settle (local.get $rp) (i32.const 2) (local.get $ae)))
        (else (call $promise_resolve_with (local.get $rp) (local.get $v))))
      (return)))
  (call $async_register_cont (call $vm_promise_resolve (local.get $v)) (local.get $ctx) (local.get $rp)))
(func $async_register_cont (param $aw i64) (param $ctx i32) (param $rp i64) (effects)
  (let $co i32 (call $obj_new (i32.const 4)))
  (call $scope_define (local.get $co) (cstring "@@actx") (call $num (f64.convert_i32_s (local.get $ctx))))
  (call $scope_define (local.get $co) (cstring "@@arp") (local.get $rp))
  (let $cov i64 (call $mk_obj (local.get $co)))
  (drop (call $promise_then (local.get $aw)
    (call $promise_bound_settler (i32.const 452) (local.get $cov))     ;; onFulfilled → resume with value
    (call $promise_bound_settler (i32.const 453) (local.get $cov)))))  ;; onRejected → resume by throwing

;; ── async generators: drive the body suspending on BOTH await and yield ──
;; The shared YIELD/AWAIT ops both set the resume flag; reg 708 distinguishes them (AWAIT=1,
;; YIELD=0). agen_drive steps the gen ctx: on await it suspends np and resumes via a
;; continuation when the awaited promise settles; on yield it resolves np with {value,done:false};
;; on completion {value,done:true}. np is the .next()/continuation result promise.
(func $agen_result (param $value i64) (param $done i32) (result i64) (effects)
  (let $o i32 (call $obj_new (i32.const 2)))
  (call $scope_define (local.get $o) (cstring "value") (local.get $value))
  (call $scope_define (local.get $o) (cstring "done") (call $mk_bool (local.get $done)))
  (call $mk_obj (local.get $o)))
;; ── AsyncGeneratorEnqueue + drain (spec request queue) ──
;; The agen object O carries @@ctx (vm ctx), a request queue @@agqueue (flat triples
;; [kind,value,np], kind 0=next/1=return/2=throw), a head index @@aghead, and @@agbusy
;; (a request is currently executing). next/return/throw enqueue a request and start the
;; pump only when idle, so a re-entrant call while suspended-on-await just queues.
(func $agen_ctx (param $O i64) (result i32) (effects)
  (i32.trunc_f64_s (call $to_num (i64.load (call $scope_find_local (call $val_payload (local.get $O)) (cstring "@@ctx"))))))
(func $agen_queue (param $O i64) (result i32) (effects)
  (let $qs i32 (call $scope_find_local (call $val_payload (local.get $O)) (cstring "@@agqueue")))
  (if (i32.eqz (local.get $qs))
    (then
      (call $scope_define (call $val_payload (local.get $O)) (cstring "@@agqueue") (call $mk_arr (call $arr_new (i32.const 8))))
      (set! $qs (call $scope_find_local (call $val_payload (local.get $O)) (cstring "@@agqueue")))))
  (call $val_payload (i64.load (local.get $qs))))
(func $agen_head (param $O i64) (result i32) (effects)
  (let $hs i32 (call $scope_find_local (call $val_payload (local.get $O)) (cstring "@@aghead")))
  (if i32 (local.get $hs) (then (i32.trunc_f64_s (call $to_num (i64.load (local.get $hs))))) (else (i32.const 0))))
(func $agen_advance (param $O i64) (effects)
  (call $scope_define (call $val_payload (local.get $O)) (cstring "@@aghead") (call $num (f64.convert_i32_s (i32.add (call $agen_head (local.get $O)) (i32.const 1))))))
(func $agen_busy (param $O i64) (result i32) (effects)
  (let $bs i32 (call $scope_find_local (call $val_payload (local.get $O)) (cstring "@@agbusy")))
  (if i32 (local.get $bs) (then (i32.trunc_f64_s (call $to_num (i64.load (local.get $bs))))) (else (i32.const 0))))
(func $agen_set_busy (param $O i64) (param $b i32) (effects)
  (call $scope_define (call $val_payload (local.get $O)) (cstring "@@agbusy") (call $num (f64.convert_i32_s (local.get $b)))))
(func $agen_front_np (param $O i64) (result i64) (effects)
  (call $arr_get (call $agen_queue (local.get $O)) (i32.add (i32.mul (call $agen_head (local.get $O)) (i32.const 3)) (i32.const 2))))
(func $agen_front_val (param $O i64) (result i64) (effects)  ;; the value arg of the front request (e.g. the .return() value)
  (call $arr_get (call $agen_queue (local.get $O)) (i32.add (i32.mul (call $agen_head (local.get $O)) (i32.const 3)) (i32.const 1))))
;; resolve the front request's promise from a completed step, advance the head. Returns 1 (continue pump).
;; AsyncGeneratorResolve for a return/completion: resolve np with { value: ? Await(value),
;; done:true } — the value is awaited (so .return(promise) yields its resolved value), a
;; rejection rejects np. (vm_promise_resolve adopts a thenable; settler 515 wraps it.)
(func $agen_settle_done (param $np i64) (param $value i64) (effects)
  (let $co i32 (call $obj_new (i32.const 2)))
  (call $scope_define (local.get $co) (cstring "@@arp") (local.get $np))
  (drop (call $promise_then (call $vm_promise_resolve (local.get $value))
    (call $promise_bound_settler (i32.const 515) (call $mk_obj (local.get $co)))   ;; fulfilled → np = {value, done:true}
    (call $promise_bound_settler (i32.const 416) (local.get $np)))))                ;; rejected → reject np with the reason
(func $agen_after_step (param $O i64) (param $v i64) (result i32) (effects)
  (let $ctx i32 (call $agen_ctx (local.get $O)))
  (let $np i64 (call $agen_front_np (local.get $O)))
  (if (call $vm_done (local.get $ctx))
    (then
      (if (call $err)
        (then (let $e i64 (call $err_val)) (call $set_err (i32.const 0))
          ;; return-completion sentinel (a .return() ran its finally to completion) → resolve
          ;; { value: Await(returnValue), done:true }; any other error rejects the promise.
          (if (i64.eq (local.get $e) (i64.load (i32.const 832)))
            (then (call $agen_settle_done (local.get $np) (i64.load (call $scope_find_local (call $val_payload (local.get $O)) (cstring "@@agretval")))))
            (else (call $promise_settle (local.get $np) (i32.const 2) (local.get $e)))))
        (else (call $promise_resolve_with (local.get $np) (call $agen_result (local.get $v) (i32.const 1)))))
      (call $agen_advance (local.get $O))
      (return (i32.const 1))))
  (if (i32.eq (i32.load (i32.const 708)) (i32.const 1))  ;; await → suspend; front stays, resume via continuation
    (then (call $agen_register_cont (call $vm_promise_resolve (local.get $v)) (local.get $O)) (return (i32.const 0))))
  ;; yield → resolve {value, done:false}, advance to the next queued request
  (call $promise_resolve_with (local.get $np) (call $agen_result (local.get $v) (i32.const 0)))
  (call $agen_advance (local.get $O))
  (i32.const 1))
(func $agen_pump (param $O i64) (effects)
  (let $ctx i32 (call $agen_ctx (local.get $O)))
  (block $stop (loop $lp
    (let $q i32 (call $agen_queue (local.get $O)))
    (let $base i32 (i32.mul (call $agen_head (local.get $O)) (i32.const 3)))
    (if (i32.ge_s (local.get $base) (call $arr_len (local.get $q)))  ;; queue drained → idle
      (then (call $agen_set_busy (local.get $O) (i32.const 0)) (br $stop)))
    (let $kind i32 (i32.trunc_f64_s (call $to_num (call $arr_get (local.get $q) (local.get $base)))))
    (let $val i64 (call $arr_get (local.get $q) (i32.add (local.get $base) (i32.const 1))))
    (let $np i64 (call $arr_get (local.get $q) (i32.add (local.get $base) (i32.const 2))))
    (if (call $vm_done (local.get $ctx))  ;; gen already completed → settle without resuming
      (then
        (if (i32.eq (local.get $kind) (i32.const 2))  ;; throw → reject with the reason
          (then (call $promise_settle (local.get $np) (i32.const 2) (local.get $val)))
          (else (if (i32.eq (local.get $kind) (i32.const 1))  ;; return → { value: Await(val), done:true }
            (then (call $agen_settle_done (local.get $np) (local.get $val)))
            (else (call $promise_resolve_with (local.get $np) (call $agen_result (call $v_undef) (i32.const 1)))))))  ;; next on a done gen → {undefined, done:true}
        (call $agen_advance (local.get $O)) (br $lp)))
    (if (i32.eq (local.get $kind) (i32.const 1))  ;; return on a suspended gen
      (then
        ;; suspended inside a try/finally (runOnReturn handler in the chain) → run the finally via
        ;; the return-completion sentinel, then complete (after_step turns the escaped sentinel into
        ;; { value: Await(returnVal), done:true }). Otherwise close immediately (no finally to run).
        (let $rfin i32 (i32.const 0))
        (let $rh i32 (i32.load (i32.add (local.get $ctx) (i32.const 32))))
        (block $rwe (loop $rwl
          (br_if $rwe (i32.eqz (local.get $rh)))
          (if (i32.load (i32.add (local.get $rh) (i32.const 24))) (then (set! $rfin (i32.const 1)) (br $rwe)))
          (set! $rh (i32.load (i32.add (local.get $rh) (i32.const 20))))
          (br $rwl)))
        (if (local.get $rfin)
          (then
            ;; remember the return value across any yield/await inside the finally — by the time the
            ;; sentinel escapes, the queue front may be a later .next() request, so front_val is wrong.
            (call $scope_define (call $val_payload (local.get $O)) (cstring "@@agretval") (local.get $val))
            (call $set_err (i32.const 1)) (call $set_err_val (i64.load (i32.const 832)))
            (let $vr i64 (call $vm_step (local.get $ctx) (call $v_undef)))
            (if (i32.eqz (call $agen_after_step (local.get $O) (local.get $vr))) (then (br $stop)))
            (br $lp))
          (else
            (i32.store (i32.add (local.get $ctx) (i32.const 16)) (i32.const 1))
            (call $agen_settle_done (local.get $np) (local.get $val))
            (call $agen_advance (local.get $O)) (br $lp)))))
    (if (i32.eq (local.get $kind) (i32.const 2))  ;; throw on a suspended gen → resume BY THROWING so an in-body
      (then                                         ;; try/catch (or try/finally) runs; uncaught closes + rejects (via after_step)
        (call $set_err (i32.const 1)) (call $set_err_val (local.get $val))
        (let $vt i64 (call $vm_step (local.get $ctx) (call $v_undef)))
        (if (i32.eqz (call $agen_after_step (local.get $O) (local.get $vt))) (then (br $stop)))
        (br $lp)))
    (let $v i64 (call $vm_step (local.get $ctx) (local.get $val)))  ;; kind 0 (next): resume value = val
    (if (i32.eqz (call $agen_after_step (local.get $O) (local.get $v))) (then (br $stop)))  ;; awaited → stop, resume later
    (br $lp))))
(func $agen_enqueue (param $O i64) (param $kind i32) (param $value i64) (result i64) (effects)
  (let $np i64 (call $mk_promise (i32.const 0) (call $v_undef)))
  (let $q i32 (call $agen_queue (local.get $O)))
  (call $arr_push (local.get $q) (call $num (f64.convert_i32_s (local.get $kind))))
  (call $arr_push (local.get $q) (local.get $value))
  (call $arr_push (local.get $q) (local.get $np))
  (if (i32.eqz (call $agen_busy (local.get $O)))
    (then (call $agen_set_busy (local.get $O) (i32.const 1)) (call $agen_pump (local.get $O))))
  (local.get $np))
(func $agen_register_cont (param $aw i64) (param $O i64) (effects)
  (let $co i32 (call $obj_new (i32.const 2)))
  (call $scope_define (local.get $co) (cstring "@@agen") (local.get $O))
  (let $cov i64 (call $mk_obj (local.get $co)))
  (drop (call $promise_then (local.get $aw)
    (call $promise_bound_settler (i32.const 458) (local.get $cov))     ;; resume with value
    (call $promise_bound_settler (i32.const 459) (local.get $cov)))))  ;; resume by throwing
;; resume a suspended async-generator after its awaited promise settles (errval already set
;; for the reject path), then continue draining the request queue.
(func $agen_resume (param $O i64) (param $resumeval i64) (effects)
  (let $v i64 (call $vm_step (call $agen_ctx (local.get $O)) (local.get $resumeval)))
  (if (call $agen_after_step (local.get $O) (local.get $v)) (then (call $agen_pump (local.get $O)))))

(func $vm_make_async (param $fn i32) (param $argc i32) (param $argv i32) (param $gscope i32) (param $thisv i64) (result i64) (effects)
  (let $np i32 (i32.load (i32.add (local.get $fn) (i32.const 8))))
  (let $ns i32 (call $scope_new (call $vm_fn_parent (local.get $fn) (local.get $gscope)) (i32.add (local.get $np) (i32.const 5))))
  ;; bind receiver `this` (non-arrow async fns/methods); arrows keep lexical `this` via the parent chain.
  ;; OrdinaryCallBindThis: coerce per strictness (sloppy undefined/null → global, primitive → boxed).
  (if (i32.eqz (i32.and (i32.load (i32.add (i32.add (local.get $fn) (i32.const 32)) (i32.mul (local.get $np) (i32.const 4)))) (i32.const 2)))
    (then (call $scope_define (local.get $ns) (cstring "this")
      (call $coerce_this (local.get $thisv) (i32.load (i32.add (i32.add (local.get $fn) (i32.const 32)) (i32.mul (local.get $np) (i32.const 4))))))))
  (let $i i32 (i32.const 0))
  (block $pe (loop $pl
    (br_if $pe (i32.ge_s (local.get $i) (local.get $np)))
    (call $scope_define (local.get $ns) (i32.load (i32.add (i32.add (local.get $fn) (i32.const 28)) (i32.mul (local.get $i) (i32.const 4))))
      (if i64 (i32.lt_s (local.get $i) (local.get $argc))
        (then (i64.load (i32.add (local.get $argv) (i32.mul (local.get $i) (i32.const 8)))))
        (else (call $v_undef))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $pl)))
  ;; a non-arrow async function has its own `arguments` object (mapped/unmapped per the fn flags, like an
  ;; ordinary or generator function); an async arrow inherits `arguments` lexically via the parent chain.
  (if (i32.eqz (i32.and (i32.load (i32.add (i32.add (local.get $fn) (i32.const 32)) (i32.mul (local.get $np) (i32.const 4)))) (i32.const 2)))
    (then (call $scope_define_attr (local.get $ns) (cstring "arguments") (call $vm_make_arguments_argv (local.get $ns) (local.get $fn) (local.get $argv) (local.get $argc)) (i32.const 10))))
  (let $ctx i32 (call $heap_alloc (i32.const 48)))
  (i32.store (local.get $ctx) (i32.load (i32.add (local.get $fn) (i32.const 12))))
  (i32.store (i32.add (local.get $ctx) (i32.const 4)) (i32.load (i32.add (local.get $fn) (i32.const 4))))
  (i32.store (i32.add (local.get $ctx) (i32.const 8)) (call $heap_alloc (i32.const 8192)))
  (i32.store (i32.add (local.get $ctx) (i32.const 12)) (i32.const 0))
  (i32.store (i32.add (local.get $ctx) (i32.const 16)) (i32.const 0))
  (i32.store (i32.add (local.get $ctx) (i32.const 20)) (local.get $ns))
  (i32.store (i32.add (local.get $ctx) (i32.const 24)) (i32.const 0))
  (i32.store (i32.add (local.get $ctx) (i32.const 28)) (local.get $gscope))
  (i32.store (i32.add (local.get $ctx) (i32.const 32)) (i32.const 0))
  (i32.store (i32.add (local.get $ctx) (i32.const 36)) (i32.const 0))
  ;; result promise, created upfront so a suspended await can settle the SAME promise the
  ;; caller holds when the awaited promise resolves later.
  (let $rp i64 (call $mk_promise (i32.const 0) (call $v_undef)))
  (call $async_drive (local.get $ctx) (local.get $rp) (call $v_undef))
  (local.get $rp))

;; run a whole program on the VM (variables, if/while via jumps, print). Drives
;; vm_step to HALT — real stateful execution, all state in linear memory.
(func $eval_prog (param $ptr i32) (param $len i32) (result i32) (effects)
  (call $set_err (i32.const 0))
  (i32.store (i32.const 400) (i32.const 0))  ;; "surfaceable syntax error" flag (set only by intentional early-error detections)
  (i32.store (i32.const 904) (i32.const 0))  ;; private-name visible-set buffer (lazy-alloc; heap was reset)
  (i32.store (i32.const 908) (i32.const 0))  ;; private-name visible-set count
  (i32.store (i32.const 704) (i32.const 0))  ;; fresh microtask queue (heap_reset freed any prior array)
  (let $ctx i32 (call $vm_new (call $vm_compile_prog (local.get $ptr) (local.get $len) (i32.const 1))))  ;; top-level: build the Error prelude
  (if (call $err)
    (then
      ;; Surface ONLY an intentional SyntaxError (reg 400). An incidental compile
      ;; error from unsupported syntax stays silent (returning 1) — surfacing all of
      ;; them would flip ~300 vacuous passes (tests whose syntax we don't parse).
      (if (i32.load (i32.const 400))
        (then
          (let $cev i64 (call $err_val))
          (let $cs i32 (call $to_str (local.get $cev)))
          ;; Intentional early errors are all SyntaxErrors. If the constructor prelude has not
          ;; executed yet at compile time, make_error yields a bare message string with no
          ;; "SyntaxError" name — prepend it so a `negative: type: SyntaxError` harness match holds.
          (if (i32.eqz (call $is_object (local.get $cev)))
            (then (set! $cs (call $str_concat (cstring "SyntaxError: ") (local.get $cs)))))
          (call $host_throw (i32.add (local.get $cs) (i32.const 4)) (call $str_len (local.get $cs)))))
      (return (i32.const 1))))
  (block $e (loop $l
    (br_if $e (call $vm_done (local.get $ctx)))
    (drop (call $vm_step (local.get $ctx) (call $v_undef)))
    (br $l)))
  ;; synchronous uncaught exception → report it (do not drain microtasks for a thrown program)
  (if (call $err)
    (then
      (let $ev i64 (call $err_val))
      (call $set_err (i32.const 0))
      (let $s i32 (call $to_str (local.get $ev)))
      (call $host_throw (i32.add (local.get $s) (i32.const 4)) (call $str_len (local.get $s)))
      (return (i32.const 1))))
  (call $job_drain)  ;; run queued microtasks (.then callbacks, async continuations) after the sync program
  (i32.const 0))

;; native eval(string): compile the source and run it on the VM in the CURRENT
;; scope (direct eval), returning the completion value. Compile-time clobbering of
;; lexer/emit registers is safe — the calling VM is executing bytecode, not lexing.
(func $vm_eval_str (param $s i32) (param $evalcfg i32) (result i64) (effects)  ;; evalcfg=1: eval() code (new global vars configurable/deletable); 0: Script ($262.evalScript) / Function body
  (let $scope i32 (call $cur_scope))
  (let $evdirect i32 (i32.and (i32.load (i32.const 880)) (i32.const 1)))  ;; capture direct-eval bit before reg 880 is zeroed
  (i64.store (i32.const 288) (call $v_undef))  ;; reset completion register
  ;; reg 880 (set by DIRECTEVALMARK just before this call) — bitfield: bit0=direct eval, bit1=caller's
  ;; super-property allowed, bit2=caller's super() allowed. A direct eval inherits the caller's context.
  (i32.store (i32.const 872) (if i32 (i32.and (i32.load (i32.const 880)) (i32.const 2)) (then (i32.const 1)) (else (i32.const 0))))  ;; → reg 868 (super property)
  (i32.store (i32.const 888) (if i32 (i32.and (i32.load (i32.const 880)) (i32.const 4)) (then (i32.const 1)) (else (i32.const 0))))  ;; → reg 884 (super call)
  (i32.store (i32.const 892) (if i32 (i32.and (i32.load (i32.const 880)) (i32.const 8)) (then (i32.const 1)) (else (i32.const 0))))  ;; → reg 388 seed (direct eval inherits caller strict); consumed by vm_compile_prog
  (i32.store (i32.const 1012) (if i32 (i32.and (i32.load (i32.const 880)) (i32.const 16)) (then (i32.const 1)) (else (i32.const 0))))  ;; → reg 1008 seed (direct eval in a function → new.target allowed)
  (i32.store (i32.const 880) (i32.const 0))
  (let $code i32 (call $vm_compile_prog (i32.add (local.get $s) (i32.const 4)) (call $str_len (local.get $s)) (i32.const 0)))  ;; nested eval: reuse the caller's existing prelude bindings
  (if (call $err) (then (return (call $v_undef))))  ;; SyntaxError → propagates
  (let $ctx i32 (call $heap_alloc (i32.const 48)))
  (i32.store (local.get $ctx) (local.get $code))
  (i32.store (i32.add (local.get $ctx) (i32.const 4)) (i32.const 0))
  (i32.store (i32.add (local.get $ctx) (i32.const 8)) (call $heap_alloc (i32.const 262144)))  ;; operand stack (256 KB — nested eval is shallow; was 1 MB and leaked per call)
  (i32.store (i32.add (local.get $ctx) (i32.const 12)) (i32.const 0))
  (i32.store (i32.add (local.get $ctx) (i32.const 16)) (i32.const 0))
  (i32.store (i32.add (local.get $ctx) (i32.const 20)) (local.get $scope))   ;; run in caller's scope
  (i32.store (i32.add (local.get $ctx) (i32.const 24)) (i32.const 0))
  (i32.store (i32.add (local.get $ctx) (i32.const 28)) (local.get $scope))
  (i32.store (i32.add (local.get $ctx) (i32.const 32)) (i32.const 0))
  (i32.store (i32.add (local.get $ctx) (i32.const 36)) (i32.const 0))
  (let $evsave i32 (i32.load (i32.const 996)))
  (i32.store (i32.const 996) (local.get $evalcfg))  ;; only eval() code creates deletable global vars; evalScript/Function do not
  ;; reg 1016 = "sloppy DIRECT eval active": gates the EvalDeclarationInstantiation var/lexical-conflict
  ;; check in DEFVAR. Only a SLOPPY direct eval shares the caller's variable environment; a STRICT eval
  ;; (own varEnv) and an INDIRECT eval (global lexEnv) never collide with the caller's lexical bindings.
  (let $evsave2 i32 (i32.load (i32.const 1016)))
  (i32.store (i32.const 1016) (i32.and (local.get $evdirect) (i32.eqz (i32.load (i32.const 388)))))
  (block $e (loop $l
    (drop (call $vm_step (local.get $ctx) (call $v_undef)))
    (br_if $e (call $vm_done (local.get $ctx)))
    (br $l)))
  (i32.store (i32.const 1016) (local.get $evsave2))
  (i32.store (i32.const 996) (local.get $evsave))
  (call $set_cur_scope (local.get $scope))  ;; vm_step may have left a nested scope active
  (i64.load (i32.const 288)))  ;; completion value

;; generator demo: start a ';'-separated yield-list; gen_next pulls each value
(func $vm_gen_start (param $ptr i32) (param $len i32) (result i32) (effects)
  (call $vm_new (call $vm_compile_gen (local.get $ptr) (local.get $len))))
(func $vm_gen_next (param $ctx i32) (result f64) (effects)
  (call $tonum_raw (call $vm_step (local.get $ctx) (call $v_undef))))
