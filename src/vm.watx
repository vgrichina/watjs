      (return)))
  (if (i32.eq (call $tok_kind) (i32.const 17))  ;; object literal { … }
    (then
      (call $next_token)
      (call $vm_emit_op (local.get $code) (i32.const 36)) (call $vm_emit_op (local.get $code) (i32.const 0))  ;; NEWOBJ 0 → empty obj on stack
      (let $oprotocnt i32 (i32.const 0))  ;; count of `__proto__: v` [[Prototype]]-setting data properties (2+ is a SyntaxError)
      (if (i32.ne (call $tok_kind) (i32.const 18))
        (then (block $oe (loop $ol
          (br_if $oe (i32.eq (call $tok_kind) (i32.const 18)))  ;; trailing comma → '}' ends the literal
          ;; an object literal has no elisions: a leading/doubled comma (`{,}`, `{a:1,,b:2}`) is a SyntaxError.
          (if (i32.eq (call $tok_kind) (i32.const 22))
            (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Unexpected ',' in object literal")) (return)))
