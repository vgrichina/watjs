  (let $oci i32 (i32.const 0))
  (block $ocpe (loop $ocpl
    (br_if $ocpe (i32.ge_s (local.get $oci) (local.get $ocn)))
    (call $vm_patch (local.get $code) (i32.load (i32.add (local.get $ocpat) (i32.mul (local.get $oci) (i32.const 4)))))
    (set! $oci (i32.add (local.get $oci) (i32.const 1)))
    (br $ocpl))))

;; ** exponentiation (right-assoc, binds tighter than unary; left is postfix)
(func $vm_c_pow (param $code i32) (effects)
  ;; reg 940 (set by a unary-prefix handler) marks that this pow's left operand is a UnaryExpression.
  ;; `UnaryExpression ** X` (`-2 ** 2`, `typeof x ** 2`) has no grammar production → SyntaxError.
  (let $powunary i32 (i32.load (i32.const 940)))
  (i32.store (i32.const 940) (i32.const 0))
  (call $vm_c_postfix (local.get $code))
  (if (i32.eq (call $tok_kind) (i32.const 51))  ;; **
    (then
      (if (local.get $powunary)
        (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Unary operator used immediately before exponentiation expression; parenthesis must be used")) (return)))
      (call $next_token) (i32.store (i32.const 956) (i32.const 0))
      (call $vm_c_unary (local.get $code))  ;; right operand may have a unary prefix; right-assoc via unary→pow
      (call $vm_emit_op (local.get $code) (i32.const 43)))))  ;; POW

;; unary prefix:  - + ! ~   (binds looser than member/call/**, tighter than * /)
(func $vm_c_unary (param $code i32) (effects)
  (let $k i32 (call $tok_kind))
  (if (i32.or (i32.eq (local.get $k) (i32.const 38)) (i32.eq (local.get $k) (i32.const 39)))  ;; prefix ++x / --x  (result = new value)
    (then
      (let $pop i32 (if i32 (i32.eq (local.get $k) (i32.const 38)) (then (i32.const 98)) (else (i32.const 99))))  ;; INC/DEC (BigInt-aware)
      (call $next_token)
      (let $pvn i32 (call $ident_name)) (call $next_token)
      ;; prefix `++super.name` / `++super[expr]` (result = new value). super target → SUPERGET/SUPERSET.
      (if (call $str_eq (local.get $pvn) (cstring "super"))
        (then
          (if (i32.eqz (i32.load (i32.const 868)))
            (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "'super' keyword unexpected here")) (return)))
          (let $psk i32 (call $vm_tmpname)) (let $psn i32 (call $vm_tmpname))
          (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (cstring "this")) (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (cstring "this")) (call $vm_emit_op (local.get $code) (i32.const 116))  ;; [recv, superproto]
          (if (i32.eq (call $tok_kind) (i32.const 23))
            (then (call $next_token) (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_str (call $ident_name))) (call $next_token))  ;; '.' name → PUSH key, consume name
            (else (call $next_token) (call $vm_c_commaexpr (local.get $code)) (call $next_token)))  ;; '[' expr ']' → key on stack (full Expression)
          (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $psk))  ;; STOREVAR @@key → [recv, superproto]
          (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $psk))  ;; LOADVAR @@key → [recv, superproto, key]
          (call $vm_emit_op (local.get $code) (i32.const 117)) (call $vm_emit_op (local.get $code) (i32.const 97)) (call $vm_emit_op (local.get $code) (local.get $pop)) (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $psn))  ;; SUPERGET,TONUMERIC,INC/DEC,STOREVAR @@new
          (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (cstring "this")) (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (cstring "this")) (call $vm_emit_op (local.get $code) (i32.const 116)) (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $psk)) (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $psn)) (call $vm_emit_op (local.get $code) (i32.const 119))  ;; re-emit [recv,superproto], LOADVAR key, LOADVAR new, SUPERSET → [new] (prefix yields new)
          (return)))
