                  (if (i32.or (i32.eq (local.get $vpk) (i32.const 20)) (i32.or (i32.eq (local.get $vpk) (i32.const 18)) (i32.eq (local.get $vpk) (i32.const 16))))
                    (then (set! $vpsd (i32.sub (local.get $vpsd) (i32.const 1))) (if (i32.eqz (local.get $vpsd)) (then (call $next_token) (br $vpske)))))
