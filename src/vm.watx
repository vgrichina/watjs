      (call $next_token)
      (let $pvn i32 (call $ident_name)) (call $next_token)
      (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $pvn))  ;; LOADVAR
      (call $vm_emit_op (local.get $code) (i32.const 97))  ;; TONUMERIC (BigInt preserved)
      (call $vm_emit_op (local.get $code) (local.get $pop))  ;; INC/DEC → new value
      (call $vm_emit_op (local.get $code) (i32.const 32))  ;; DUP → new value is the result
      (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $pvn))  ;; STOREVAR
      (return)))
  (if (i32.eq (local.get $k) (i32.const 11))  ;; -
    (then (call $next_token) (call $vm_c_unary (local.get $code)) (call $vm_emit_op (local.get $code) (i32.const 6)) (return)))
  (if (i32.eq (local.get $k) (i32.const 10))  ;; + (numeric coercion)
    (then (call $next_token) (call $vm_c_unary (local.get $code)) (call $vm_emit_op (local.get $code) (i32.const 63)) (return)))  ;; TONUM
  (if (i32.eq (local.get $k) (i32.const 33))  ;; !
    (then (call $next_token) (call $vm_c_unary (local.get $code)) (call $vm_emit_op (local.get $code) (i32.const 23)) (return)))
  (if (i32.eq (local.get $k) (i32.const 47))  ;; ~
    (then (call $next_token) (call $vm_c_unary (local.get $code)) (call $vm_emit_op (local.get $code) (i32.const 44)) (return)))
  (if (i32.and (i32.eq (local.get $k) (i32.const 3)) (call $tok_is_kw (cstring "await")))  ;; await expr
    (then (call $next_token) (call $vm_c_unary (local.get $code)) (call $vm_emit_op (local.get $code) (i32.const 50)) (return)))  ;; AWAIT
