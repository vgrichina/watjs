                    (if (i32.eq (call $tok_kind) (i32.const 19))  ;; [computed] key
                      (then (call $next_token) (call $vm_c_expr (local.get $code)) (call $next_token))  ;; '[' expr ']' → key on stack
                      (else (set! $oaname (if i32 (i32.eq (call $tok_kind) (i32.const 2)) (then (call $decode_str (i32.add (call $src) (call $tok_start)) (call $tok_len))) (else (call $ident_name)))) (call $next_token)
                            (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_str (local.get $oaname)))))
                    (i32.store (i32.const 692) (i32.const 1))  ;; accessor → no .prototype
                    (i32.store (i32.const 924) (if i32 (local.get $isget) (then (i32.const 1)) (else (i32.const 2))))  ;; accessor arity: getter→0 params / setter→1
                    (i32.store (i32.const 700) (i32.add (local.get $opropstart) (i32.const 1)))
                    (call $vm_c_fnbody (local.get $code) (i32.const 0))  ;; pushes the accessor fn
                    (if (call $err) (then (return)))
