;; ═══════════════════════════════════════════════════════════════
;; vm.watx — Phase 2: bytecode/threaded virtual machine (foundation)
;;
;; The re-scan evaluator keeps a call's execution state on the WASM call
;; stack, so it can never be snapshotted — which is exactly why generators,
;; async/await, and tail-call optimization are impossible there.
;;
;; This VM reifies execution state in LINEAR MEMORY: an instruction pointer
;; into a compiled bytecode array, plus an explicit operand stack. Because
;; that state is data, a future YIELD opcode can save (ip, sp) and return,
;; and resume by restoring them — the prerequisite for generators/async.
;; Tail calls become frame elision once call frames live in memory too.
;;
;; Milestone 1: compile + run arithmetic, validating the dispatch loop and
;; the in-memory operand stack. The compiler reuses the existing lexer, so
;; there is one front-end (as the design intended). Threaded dispatch via
;; call_indirect / return_call_indirect is a later perf step; the
;; suspend/resume property comes from in-memory state, not the dispatch form.
;;
;; Opcodes (one i32 word each; PUSH is followed by an 8-byte i64 JSValue):
;;   0 HALT   1 PUSH   2 ADD   3 SUB   4 MUL   5 DIV   6 NEG
;; ═══════════════════════════════════════════════════════════════

;; emit cursor (byte offset into the code buffer under construction) — reg 200
(func $vm_emit_cursor (result i32) (effects) (i32.load (i32.const 200)))
(func $vm_set_emit_cursor (param $c i32) (effects) (i32.store (i32.const 200) (local.get $c)))

(func $vm_emit_op (param $code i32) (param $op i32) (effects)
  (i32.store (i32.add (local.get $code) (call $vm_emit_cursor)) (local.get $op))
  (call $vm_set_emit_cursor (i32.add (call $vm_emit_cursor) (i32.const 4))))

(func $vm_emit_val (param $code i32) (param $v i64) (effects)
  (i64.store (i32.add (local.get $code) (call $vm_emit_cursor)) (local.get $v))
  (call $vm_set_emit_cursor (i32.add (call $vm_emit_cursor) (i32.const 8))))

;; emit a jump op with a placeholder target; returns the patch location (byte offset)
(func $vm_emit_jump (param $code i32) (param $op i32) (result i32) (effects)
  (call $vm_emit_op (local.get $code) (local.get $op))
  (let $loc i32 (call $vm_emit_cursor))
  (call $vm_emit_op (local.get $code) (i32.const 0))  ;; placeholder
  (local.get $loc))
(func $vm_patch (param $code i32) (param $loc i32) (effects)  ;; patch placeholder to current cursor
  (i32.store (i32.add (local.get $code) (local.get $loc)) (call $vm_emit_cursor)))

;; loop-context for break/continue: reg 208 break-list ptr, 212 break count,
;; 216 continue-list ptr, 220 continue count. Saved/restored around each loop.
;; ── labeled loops ──  reg 244 = pending label name (for the next loop),
;; 248 = current loop's label entry (0 if unlabeled), 252 = label-stack base,
;; 228 = label-stack depth. Entry: @0 name, @4 breaklist, @8 breakcount,
;; @12 contlist, @16 contcount.
(func $vm_label_push (param $name i32) (param $isloop i32) (result i32) (effects)
  (let $cnt i32 (i32.load (i32.const 228)))
  (let $e i32 (i32.add (i32.load (i32.const 252)) (i32.mul (local.get $cnt) (i32.const 28))))  ;; entry stride 28 (@20 = finally-base, @24 = isloop)
  (i32.store (local.get $e) (local.get $name))
  (i32.store (i32.add (local.get $e) (i32.const 4)) (call $heap_alloc (i32.const 1024)))
  (i32.store (i32.add (local.get $e) (i32.const 8)) (i32.const 0))
  (i32.store (i32.add (local.get $e) (i32.const 12)) (call $heap_alloc (i32.const 1024)))
  (i32.store (i32.add (local.get $e) (i32.const 16)) (i32.const 0))
  (i32.store (i32.add (local.get $e) (i32.const 20)) (i32.load (i32.const 320)))  ;; finally-base at this label's start → labeled break/continue re-emits finallys/closes/scope-pops down to here
  (i32.store (i32.add (local.get $e) (i32.const 24)) (local.get $isloop))  ;; 1 = labels an iteration statement (valid `continue` target)
  (i32.store (i32.const 228) (i32.add (local.get $cnt) (i32.const 1)))
  (local.get $e))
(func $vm_label_find (param $name i32) (result i32) (effects)
  (let $i i32 (i32.sub (i32.load (i32.const 228)) (i32.const 1)))
  (block $e (loop $l
    (br_if $e (i32.lt_s (local.get $i) (i32.load (i32.const 932))))  ;; stop at the label floor (reg 932): labels of an enclosing function are not visible across a function boundary
    (let $en i32 (i32.add (i32.load (i32.const 252)) (i32.mul (local.get $i) (i32.const 28))))
    (if (call $str_eq (i32.load (local.get $en)) (local.get $name)) (then (return (local.get $en))))
    (set! $i (i32.sub (local.get $i) (i32.const 1)))
    (br $l)))
  (i32.const 0))
;; append a jump (the just-emitted JMP at `patch`) to a label entry's break(0)/cont(1) list
(func $vm_label_add (param $entry i32) (param $iscont i32) (param $patch i32) (effects)
  (let $loff i32 (if i32 (local.get $iscont) (then (i32.const 12)) (else (i32.const 4))))
  (let $coff i32 (if i32 (local.get $iscont) (then (i32.const 16)) (else (i32.const 8))))
  (let $list i32 (i32.load (i32.add (local.get $entry) (local.get $loff))))
  (let $c i32 (i32.load (i32.add (local.get $entry) (local.get $coff))))
  (i32.store (i32.add (local.get $list) (i32.mul (local.get $c) (i32.const 4))) (local.get $patch))
  (i32.store (i32.add (local.get $entry) (local.get $coff)) (i32.add (local.get $c) (i32.const 1))))

(func $vm_loop_enter (result i32) (effects)
  (let $save i32 (call $heap_alloc (i32.const 24)))
  (i32.store (local.get $save) (i32.load (i32.const 208)))
  (i32.store (i32.add (local.get $save) (i32.const 4)) (i32.load (i32.const 212)))
  (i32.store (i32.add (local.get $save) (i32.const 8)) (i32.load (i32.const 216)))
  (i32.store (i32.add (local.get $save) (i32.const 12)) (i32.load (i32.const 220)))
  (i32.store (i32.add (local.get $save) (i32.const 16)) (i32.load (i32.const 248)))  ;; prev curlabel
  (i32.store (i32.add (local.get $save) (i32.const 20)) (i32.load (i32.const 360)))  ;; prev loop's finally-base
  (i32.store (i32.const 360) (i32.load (i32.const 320)))  ;; this loop's finally-base = current finally depth
  (i32.store (i32.const 208) (call $heap_alloc (i32.const 1024))) (i32.store (i32.const 212) (i32.const 0))
  (i32.store (i32.const 216) (call $heap_alloc (i32.const 1024))) (i32.store (i32.const 220) (i32.const 0))
  ;; this loop's label entry: the pending label (if any), else none
  (i32.store (i32.const 248) (if i32 (i32.load (i32.const 244)) (then (call $vm_label_push (i32.load (i32.const 244)) (i32.const 1))) (else (i32.const 0))))  ;; loop label → isloop=1
  (i32.store (i32.const 244) (i32.const 0))  ;; consume the pending label
  (local.get $save))
(func $vm_loop_exit (param $save i32) (effects)
  (if (i32.load (i32.const 248)) (then (i32.store (i32.const 228) (i32.sub (i32.load (i32.const 228)) (i32.const 1)))))  ;; pop this loop's label
  (i32.store (i32.const 208) (i32.load (local.get $save)))
  (i32.store (i32.const 212) (i32.load (i32.add (local.get $save) (i32.const 4))))
  (i32.store (i32.const 216) (i32.load (i32.add (local.get $save) (i32.const 8))))
  (i32.store (i32.const 220) (i32.load (i32.add (local.get $save) (i32.const 12))))
  (i32.store (i32.const 248) (i32.load (i32.add (local.get $save) (i32.const 16))))  ;; restore curlabel
  (i32.store (i32.const 360) (i32.load (i32.add (local.get $save) (i32.const 20)))))  ;; restore loop finally-base
;; ── finally completion ──  reg 320 = finally-stack depth, 340 = base ptr.
;; Each 4-byte entry = the finally block's '{' cursor (from cursor_save). A
;; `return` inside a try-with-finally must run all enclosing finally blocks first;
;; we re-emit them inline (innermost first) before the RET. Reset to 0 across a
;; nested function body so an inner return doesn't run the outer fn's finallys.
;; Each entry is 8 bytes: [kind:i32][data:i32]. kind 0 = a finally block's '{' source
;; cursor (try/finally). kind 1 = a for-of iterator-close (data = the iterator var name);
;; emitted as LOADVAR + CLOSEITER so `return` through a for-of closes its iterator.
(func $vm_finally_push (param $cur i32) (effects)
  (let $n i32 (i32.load (i32.const 320)))
  (let $e i32 (i32.add (i32.load (i32.const 772)) (i32.mul (local.get $n) (i32.const 8))))
  (i32.store (local.get $e) (i32.const 0))
  (i32.store (i32.add (local.get $e) (i32.const 4)) (local.get $cur))
  (i32.store (i32.const 320) (i32.add (local.get $n) (i32.const 1))))
(func $vm_finally_push_iter (param $itname i32) (effects)
  (let $n i32 (i32.load (i32.const 320)))
  (let $e i32 (i32.add (i32.load (i32.const 772)) (i32.mul (local.get $n) (i32.const 8))))
  (i32.store (local.get $e) (i32.const 1))
  (i32.store (i32.add (local.get $e) (i32.const 4)) (local.get $itname))
  (i32.store (i32.const 320) (i32.add (local.get $n) (i32.const 1))))
(func $vm_finally_push_scope (effects)  ;; kind 2 = pop a lexical scope (with-scope / block scope) on abrupt exit
  (let $n i32 (i32.load (i32.const 320)))
  (let $e i32 (i32.add (i32.load (i32.const 772)) (i32.mul (local.get $n) (i32.const 8))))
  (i32.store (local.get $e) (i32.const 2))
  (i32.store (i32.const 320) (i32.add (local.get $n) (i32.const 1))))
(func $vm_finally_pop (effects)
  (i32.store (i32.const 320) (i32.sub (i32.load (i32.const 320)) (i32.const 1))))
;; Re-emit finally blocks inline (innermost first) down to depth $base, before an
;; abrupt completion. While re-emitting entry i the active depth is set to i, so a
;; `return` inside that finally runs only the OUTER finallys (and naturally
;; overrides this completion). `return` uses base 0 (all enclosing finallys);
;; break/continue use the target loop's recorded finally-base (reg 360).
(func $vm_finally_emit_to (param $code i32) (param $base i32) (effects)
  (let $n i32 (i32.load (i32.const 320)))
  (let $i i32 (local.get $n))
  (block $e (loop $l
    (set! $i (i32.sub (local.get $i) (i32.const 1)))
    (br_if $e (i32.lt_s (local.get $i) (local.get $base)))
    (i32.store (i32.const 320) (local.get $i))
    (let $ent i32 (i32.add (i32.load (i32.const 772)) (i32.mul (local.get $i) (i32.const 8))))
    (if (i32.eq (i32.load (local.get $ent)) (i32.const 2))
      (then (call $vm_emit_op (local.get $code) (i32.const 94)))  ;; kind 2: pop a lexical scope (LEAVEWITH) — stack-neutral
    (if (i32.eq (i32.load (local.get $ent)) (i32.const 1))
      (then  ;; iterator close: LOADVAR itname; CLOSEITER (it.return()) — stack-neutral
        (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (i32.load (i32.add (local.get $ent) (i32.const 4))))
        (call $vm_emit_op (local.get $code) (i32.const 74)))
      (else  ;; finally source block
        (let $save i32 (call $cursor_save))
        (call $cursor_restore (i32.load (i32.add (local.get $ent) (i32.const 4))))
        (call $vm_c_stmt (local.get $code))  ;; the finally '{...}' block (stack-neutral)
        (call $cursor_restore (local.get $save)))))
    (br $l)))
  (i32.store (i32.const 320) (local.get $n)))
(func $vm_finally_emit_all (param $code i32) (effects)
  (call $vm_finally_emit_to (local.get $code) (i32.const 0)))

;; ── function-declaration hoisting ──  reg 372 = count, 376 = base ptr (4-byte
;; source positions). A pre-scan compiles statement-position `function NAME`
;; declarations at the top of the function/program; the body-compile then SKIPS
;; them (matched by source position) so a redeclare/reassign before the decl line
;; isn't clobbered. Saved/restored across nested function bodies.
(func $vm_hoist_record (param $pos i32) (effects)
  (let $n i32 (i32.load (i32.const 372)))
  (if (i32.lt_s (local.get $n) (i32.const 256))  ;; cap (rare to exceed; silently ignore beyond)
    (then
      (i32.store (i32.add (i32.load (i32.const 376)) (i32.mul (local.get $n) (i32.const 4))) (local.get $pos))
      (i32.store (i32.const 372) (i32.add (local.get $n) (i32.const 1))))))
(func $vm_hoist_contains (param $pos i32) (result i32) (effects)
  (let $n i32 (i32.load (i32.const 372)))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    (if (i32.eq (i32.load (i32.add (i32.load (i32.const 376)) (i32.mul (local.get $i) (i32.const 4)))) (local.get $pos))
      (then (return (i32.const 1))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (i32.const 0))
;; statement-position test: a function declaration follows nothing (start),
;; ';', '{', or '}'  (an expression-position `function` follows '='/'('/','/return…).
(func $vm_stmt_pos (param $prevk i32) (result i32) (effects)
  (i32.or (i32.eqz (local.get $prevk)) (i32.or (i32.eq (local.get $prevk) (i32.const 17))
    (i32.or (i32.eq (local.get $prevk) (i32.const 18)) (i32.eq (local.get $prevk) (i32.const 21))))))
;; AnnexB B.3.3: a `function NAME` in an IfStatement/loop single-statement clause
;; position (e.g. `if(x) function f(){}` / `if(x); else function f(){}`) creates a
;; VAR/global binding for NAME initialized to `undefined` at instantiation time; the
;; function value is assigned only when the declaration is reached at runtime (which
;; the ordinary decl-in-statement compilation handles via STOREVAR up the chain).
;; Cursor at 'function'. Emit DEFVAR(name); skip the whole decl (cursor left at '}').
(func $vm_hoist_clause_fn (param $code i32) (effects)
  (call $look_save)
  (call $next_token)  ;; past 'function'
  (let $hcgen i32 (i32.eq (call $tok_kind) (i32.const 12)))  ;; '*' → GeneratorDeclaration: LEXICAL (block-scoped), NOT AnnexB var-hoisted
  (if (local.get $hcgen) (then (call $next_token)))
  (if (i32.and (i32.eqz (local.get $hcgen)) (i32.eq (call $tok_kind) (i32.const 3)))
    (then (call $vm_emit_op (local.get $code) (i32.const 78)) (call $vm_emit_op (local.get $code) (call $ident_name))))  ;; DEFVAR NAME (plain FunctionDeclaration only)
  (call $look_restore)  ;; back to 'function'
  (call $hoist_skip_fn))  ;; skip the whole decl body

;; Scan the upcoming body for statement-position `function NAME` declarations at
;; depth==decldepth, compile each hoisted (CLOSURE+STOREVAR) and record its pos.
;; decldepth=1 for a function body (cursor at '{'); 0 for the program top level.
(func $vm_hoist_fns (param $code i32) (param $decldepth i32) (effects)
  (let $start i32 (call $cursor_save))
  (let $depth i32 (i32.const 0))
  (let $prevk i32 (i32.const 0))
  (let $prevelse i32 (i32.const 0))  ;; previous significant token was the `else` keyword
  (let $swpend i32 (i32.const 0))    ;; saw `switch` at decldepth → its next '{' opens a CaseBlock
  (let $swdepth i32 (i32.const -1))  ;; depth of the active function-body-level switch CaseBlock (-1 = none)
  (let $qdepth i32 (i32.const 0))    ;; open '?' (ternary) count at $swdepth — a ':' while >0 is a ternary colon, not a case label
  (let $prevlabel i32 (i32.const 0)) ;; previous token was a case/default/label ':' at the CaseBlock level
  (block $he (loop $hl
    (let $k i32 (call $tok_kind))
    (br_if $he (i32.eqz (local.get $k)))  ;; EOF
    (let $waslabel i32 (local.get $prevlabel))  ;; consume the one-shot label flag (valid only for the token right after ':')
    (set! $prevlabel (i32.const 0))
    (if (i32.or (i32.eq (local.get $k) (i32.const 17)) (i32.or (i32.eq (local.get $k) (i32.const 15)) (i32.eq (local.get $k) (i32.const 19))))
      (then (set! $depth (i32.add (local.get $depth) (i32.const 1)))
            (if (i32.and (local.get $swpend) (i32.eq (local.get $k) (i32.const 17))) (then (set! $swdepth (local.get $depth)) (set! $swpend (i32.const 0)) (set! $qdepth (i32.const 0))))  ;; switch CaseBlock '{'
            (set! $prevk (local.get $k)) (set! $prevelse (i32.const 0)) (call $next_token) (br $hl)))
    (if (i32.or (i32.eq (local.get $k) (i32.const 18)) (i32.or (i32.eq (local.get $k) (i32.const 16)) (i32.eq (local.get $k) (i32.const 20))))
      (then (set! $depth (i32.sub (local.get $depth) (i32.const 1)))
            (if (i32.lt_s (local.get $depth) (local.get $swdepth)) (then (set! $swdepth (i32.const -1)) (set! $qdepth (i32.const 0))))  ;; left the switch CaseBlock
            (br_if $he (i32.lt_s (local.get $depth) (local.get $decldepth)))  ;; body closed
            (set! $prevk (local.get $k)) (set! $prevelse (i32.const 0)) (call $next_token) (br $hl)))
    (if (i32.and (i32.eq (local.get $k) (i32.const 3)) (call $tok_is_kw (cstring "switch")))
      (then (if (i32.eq (local.get $depth) (local.get $decldepth)) (then (set! $swpend (i32.const 1))))))  ;; function-body-level switch
    ;; inside a CaseBlock, track ternary '?' so a case/default label ':' (qdepth==0) is distinguished from a
    ;; ternary ':' — then a `function` right after a LABEL colon is an AnnexB clause declaration.
    (if (i32.and (i32.ge_s (local.get $swdepth) (i32.const 0)) (i32.eq (local.get $depth) (local.get $swdepth)))
      (then
        (if (i32.eq (local.get $k) (i32.const 36)) (then (set! $qdepth (i32.add (local.get $qdepth) (i32.const 1)))))  ;; '?'
        (if (i32.eq (local.get $k) (i32.const 37))  ;; ':'
          (then (if (i32.gt_s (local.get $qdepth) (i32.const 0)) (then (set! $qdepth (i32.sub (local.get $qdepth) (i32.const 1)))) (else (set! $prevlabel (i32.const 1))))))))
    ;; AnnexB B.3.3: a `function` directly in a switch CaseClause/DefaultClause is hoisted to the
    ;; enclosing function like an `if`/`else` clause function ($waslabel = right after a label colon).
    (if (i32.and (i32.and (i32.ge_s (local.get $swdepth) (i32.const 0)) (i32.eq (local.get $depth) (local.get $swdepth)))
          (i32.and (local.get $waslabel)
            (i32.and (i32.eq (local.get $k) (i32.const 3)) (call $tok_is_kw (cstring "function")))))
      (then
        (call $vm_hoist_clause_fn (local.get $code))
        (call $next_token) (set! $prevk (i32.const 18)) (set! $prevelse (i32.const 0))
        (br $hl)))
    (if (i32.and (i32.eq (local.get $depth) (local.get $decldepth))
          (i32.and (i32.eq (local.get $k) (i32.const 3)) (call $tok_is_kw (cstring "function"))))
      (then
        ;; ASI: a `function` on a new line after a token that COMPLETES an expression (number/string/
        ;; identifier/`]`) starts a fresh statement → a hoistable declaration (e.g. `var x = 5\nfunction
        ;; f(){}`). `)` is excluded — `if(x)\nfunction f` is an AnnexB clause, handled in the else branch.
        (if (i32.or (call $vm_stmt_pos (local.get $prevk))
              (i32.and (call $nl_before)
                (i32.or (i32.eq (local.get $prevk) (i32.const 1)) (i32.or (i32.eq (local.get $prevk) (i32.const 2))
                (i32.or (i32.eq (local.get $prevk) (i32.const 3)) (i32.eq (local.get $prevk) (i32.const 20)))))))
          (then  ;; genuine statement-position declaration → value-hoist
            (call $vm_hoist_record (call $pos))
            (let $fnm i32 (call $vm_c_function (local.get $code)))  ;; emits PUSH fn (consumes the whole decl)
            (if (local.get $fnm)
              (then (call $vm_emit_op (local.get $code) (i32.const 9)) (call $vm_emit_op (local.get $code) (local.get $fnm)))  ;; STOREVAR
              (else (call $vm_emit_op (local.get $code) (i32.const 11))))  ;; POP (anonymous — shouldn't happen for a decl)
            (set! $prevk (i32.const 21)) (set! $prevelse (i32.const 0))
            (br $hl))
          (else  ;; AnnexB clause position (`if(x) function f`, `else function f`) → var binding = undefined
            (if (i32.or (i32.eq (local.get $prevk) (i32.const 16)) (local.get $prevelse))
              (then
                (call $vm_hoist_clause_fn (local.get $code))
                ;; clause_fn leaves the cursor ON the fn body's '}', whose matching '{' was consumed
                ;; internally — advance past it so the loop doesn't mis-decrement $depth (which would
                ;; look like the body closed and abort hoisting of any following sibling declarations).
                (call $next_token) (set! $prevk (i32.const 18)) (set! $prevelse (i32.const 0))
                (br $hl)))))))
    (set! $prevelse (i32.and (i32.eq (local.get $k) (i32.const 3)) (call $tok_is_kw (cstring "else"))))
    (set! $prevk (local.get $k)) (call $next_token) (br $hl)))
  (call $cursor_restore (local.get $start)))

;; Hoist `var` declarations in a FUNCTION BODY: emit DEFVAR name=undefined (create-if-absent) at the top of
;; the body for every `var` at any nesting inside THIS function, so a reference before (or unreachable after,
;; e.g. `return v; var v = 1`) its declaration sees `undefined` rather than a ReferenceError. Nested
;; function / arrow bodies are skipped (their vars hoist to them). Single-declarator form (matches vm_hoist's
;; program-level var pass); tracks only '{'/'}' for the body boundary (object literals net out; parens/brackets
;; can't hold a statement-level `var` except via a skipped nested function). Cursor is at the body '{'; restored.
;; is $name one of the $pcount parameter names in the $plist array (of name cstring ptrs)?
(func $vm_param_member (param $name i32) (param $plist i32) (param $pcount i32) (result i32) (effects)
  (if (i32.eqz (local.get $plist)) (then (return (i32.const 0))))
  (let $mi i32 (i32.const 0))
  (block $me (loop $ml
    (br_if $me (i32.ge_s (local.get $mi) (local.get $pcount)))
    (if (call $str_eq (local.get $name) (i32.load (i32.add (local.get $plist) (i32.mul (local.get $mi) (i32.const 4))))) (then (return (i32.const 1))))
    (set! $mi (i32.add (local.get $mi) (i32.const 1))) (br $ml)))
  (i32.const 0))

;; $plist/$pcount: when non-zero, the function has a non-simple parameter list and the body runs in a
;; SEPARATE variable scope (ENTERVARSCOPE) — a `var` whose name is ALSO a parameter must be INITIALIZED
;; to a COPY of the parameter's value (spec FunctionDeclarationInstantiation), so param-default closures
;; (which capture the parameter scope) don't observe body mutations. Emitted as LOADVAR p; DEFINIT p.
(func $vm_hoist_vars_p (param $code i32) (param $plist i32) (param $pcount i32) (effects)
  (let $start i32 (call $cursor_save))
  (call $next_token)  ;; consume the body '{'
  (let $depth i32 (i32.const 0))
  (block $done (loop $lp
    (let $k i32 (call $tok_kind))
    (br_if $done (i32.eqz (local.get $k)))
    ;; a nested function → skip it whole (name/params/body); its vars belong to it
    (if (i32.and (i32.eq (local.get $k) (i32.const 3)) (call $tok_is_kw (cstring "function")))
      (then (call $hoist_skip_fn) (call $next_token) (br $lp)))
    ;; an arrow: '=>' followed by a '{' block body → skip the balanced block (its vars belong to the arrow)
    (if (i32.eq (local.get $k) (i32.const 52))
      (then
        (call $next_token)
        (if (i32.eq (call $tok_kind) (i32.const 17))
          (then
            (let $abd i32 (i32.const 1)) (call $next_token)
            (block $abe (loop $abl
              (let $t i32 (call $tok_kind))
              (br_if $abe (i32.eqz (local.get $t)))
              (if (i32.eq (local.get $t) (i32.const 17)) (then (set! $abd (i32.add (local.get $abd) (i32.const 1)))))
              (if (i32.eq (local.get $t) (i32.const 18)) (then (set! $abd (i32.sub (local.get $abd) (i32.const 1))) (if (i32.eqz (local.get $abd)) (then (call $next_token) (br $abe)))))
              (call $next_token) (br $abl)))))
        (br $lp)))
    (if (i32.eq (local.get $k) (i32.const 17)) (then (set! $depth (i32.add (local.get $depth) (i32.const 1))) (call $next_token) (br $lp)))  ;; '{'
    (if (i32.eq (local.get $k) (i32.const 18))
      (then (br_if $done (i32.eqz (local.get $depth)))  ;; the body's closing '}' → done
            (set! $depth (i32.sub (local.get $depth) (i32.const 1))) (call $next_token) (br $lp)))
    ;; `var NAME[, NAME]*` → DEFVAR name (create-if-absent, undefined) for EVERY identifier declarator in the
    ;; list, not just the first — an un-hoisted 2nd declarator would let `b=2` land on the global before its
    ;; `var b` runs. Identifier declarators only (patterns are not hoisted here, matching the single form).
    (if (i32.and (i32.eq (local.get $k) (i32.const 3)) (call $tok_is_kw (cstring "var")))
      (then
        (call $next_token)  ;; consume 'var'
        (block $vhdone (loop $vhl
          (br_if $vhdone (i32.ne (call $tok_kind) (i32.const 3)))  ;; declarator not an identifier (pattern / list end) → stop
          (let $vhnm i32 (call $ident_name))
          (if (call $vm_param_member (local.get $vhnm) (local.get $plist) (local.get $pcount))
            (then  ;; body var shadows a parameter → copy the parameter's value into the body scope
              (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (local.get $vhnm))    ;; LOADVAR NAME (reads the param via the chain)
              (call $vm_emit_op (local.get $code) (i32.const 89)) (call $vm_emit_op (local.get $code) (local.get $vhnm)))  ;; DEFINIT NAME (define in the body var scope)
            (else (call $vm_emit_op (local.get $code) (i32.const 78)) (call $vm_emit_op (local.get $code) (local.get $vhnm))))  ;; DEFVAR NAME
          (call $next_token)  ;; consume NAME
          (if (i32.eq (call $tok_kind) (i32.const 24))  ;; '=' initializer → skip it to the next TOP-LEVEL ','
            (then
              (call $next_token)  ;; consume '='
              (let $hd i32 (i32.const 0))
              (let $fst i32 (i32.const 1))  ;; first initializer token — ASI can't apply right after '='
              (block $isep (loop $isl
                (let $ik i32 (call $tok_kind))
                (br_if $vhdone (i32.eqz (local.get $ik)))  ;; EOF
                ;; ASI: a LineTerminator before a non-',' token at depth 0 (past the first) ends the statement
                (br_if $vhdone (i32.and (i32.eqz (local.get $fst)) (i32.and (i32.eqz (local.get $hd)) (i32.and (call $nl_before) (i32.ne (local.get $ik) (i32.const 22))))))
                (set! $fst (i32.const 0))
                (if (i32.or (i32.eq (local.get $ik) (i32.const 15)) (i32.or (i32.eq (local.get $ik) (i32.const 19)) (i32.eq (local.get $ik) (i32.const 17))))
                  (then (set! $hd (i32.add (local.get $hd) (i32.const 1))) (call $next_token) (br $isl)))  ;; ( [ {
                (if (i32.or (i32.eq (local.get $ik) (i32.const 16)) (i32.or (i32.eq (local.get $ik) (i32.const 20)) (i32.eq (local.get $ik) (i32.const 18))))
                  (then (br_if $vhdone (i32.eqz (local.get $hd))) (set! $hd (i32.sub (local.get $hd) (i32.const 1))) (call $next_token) (br $isl)))  ;; ) ] } — depth-0 closer ends the stmt
                (br_if $vhdone (i32.and (i32.eqz (local.get $hd)) (i32.eq (local.get $ik) (i32.const 21))))  ;; ';' → end
                (if (i32.and (i32.eqz (local.get $hd)) (i32.eq (local.get $ik) (i32.const 22))) (then (call $next_token) (br $isep)))  ;; top-level ',' → next declarator
                (call $next_token) (br $isl)))
              (br $vhl))  ;; consumed the ',' → hoist the next declarator
            (else  ;; no initializer: ',' → next declarator; anything else (';', '}', ASI, EOF) ends the list
              (br_if $vhdone (i32.ne (call $tok_kind) (i32.const 22)))
              (call $next_token)  ;; consume ','
              (br $vhl)))))
        (br $lp)))
    (call $next_token) (br $lp)))
  (call $cursor_restore (local.get $start)))
;; simple-param-list (or non-function) hoist: no parameter copy, plain DEFVAR for every var.
(func $vm_hoist_vars (param $code i32) (effects)
  (call $vm_hoist_vars_p (local.get $code) (i32.const 0) (i32.const 0)))
;; Does `name` appear as a `var NAME` anywhere in the block at the current cursor ('{'), at any nesting
;; EXCEPT inside a nested function/arrow body (those vars belong to the nested function)? Cursor restored.
;; Used for the for-in/of ForDeclaration-vs-body-VarDeclaredNames early error. Mirrors vm_hoist_vars' skips.
(func $var_name_in_block (param $name i32) (param $noenter i32) (result i32) (effects)
  (let $start i32 (call $cursor_save))
  (let $found i32 (i32.const 0))
  (if (i32.eqz (local.get $noenter)) (then (call $next_token)))  ;; consume the body '{' (unless the cursor is already inside)
  (let $depth i32 (i32.const 0))
  (block $done (loop $lp
    (let $k i32 (call $tok_kind))
    (br_if $done (i32.eqz (local.get $k)))
    (if (i32.and (i32.eq (local.get $k) (i32.const 3)) (call $tok_is_kw (cstring "function")))
      (then (call $hoist_skip_fn) (call $next_token) (br $lp)))  ;; skip nested function whole
    (if (i32.eq (local.get $k) (i32.const 52))  ;; '=>' with a block body → skip the arrow body
      (then
        (call $next_token)
        (if (i32.eq (call $tok_kind) (i32.const 17))
          (then (let $abd i32 (i32.const 1)) (call $next_token)
            (block $abe (loop $abl
              (let $t i32 (call $tok_kind))
              (br_if $abe (i32.eqz (local.get $t)))
              (if (i32.eq (local.get $t) (i32.const 17)) (then (set! $abd (i32.add (local.get $abd) (i32.const 1)))))
              (if (i32.eq (local.get $t) (i32.const 18)) (then (set! $abd (i32.sub (local.get $abd) (i32.const 1))) (if (i32.eqz (local.get $abd)) (then (call $next_token) (br $abe)))))
              (call $next_token) (br $abl)))))
        (br $lp)))
    (if (i32.eq (local.get $k) (i32.const 17)) (then (set! $depth (i32.add (local.get $depth) (i32.const 1))) (call $next_token) (br $lp)))
    (if (i32.eq (local.get $k) (i32.const 18))
      (then (br_if $done (i32.eqz (local.get $depth)))
            (set! $depth (i32.sub (local.get $depth) (i32.const 1))) (call $next_token) (br $lp)))
    (if (i32.and (i32.eq (local.get $k) (i32.const 3)) (call $tok_is_kw (cstring "var")))
      (then (call $next_token)
        (if (i32.and (i32.eq (call $tok_kind) (i32.const 3)) (call $str_eq (call $ident_name) (local.get $name)))
          (then (set! $found (i32.const 1)) (br $done)))
        (br $lp)))
    (call $next_token) (br $lp)))
  (call $cursor_restore (local.get $start))
  (local.get $found))
;; AnnexB B.3.3 for a FUNCTION BODY: emit DEFVAR name=undefined for each function declaration nested in a
;; SUB-block (brace depth ≥ 2 relative to the body's '{'), UNLESS the name is bound by a lexical declaration
;; (let/const/class/catch-param/for-head let-const) in an ENCLOSING block — in that case B.3.3 hoisting is
;; skipped (else it's an early error). The block's own execution assigns the value. Nested function bodies are
;; skipped whole. Cursor must be AT the body's '{'; saved/restored. Tracks an active-lexical-name stack: names
;; are popped when their block closes, so every currently-active name is enclosing (or same-block).
(func $vm_hoist_block_fns (param $code i32) (effects)
  (let $start i32 (call $cursor_save))
  (let $pd i32 (i32.const 0))  ;; paren/bracket depth
  (let $bd i32 (i32.const 0))  ;; brace depth: the body's own '{' = 1, a sub-block = 2+
  (let $prevk i32 (i32.const 0))
  (let $lexn i32 (i32.const 0))  ;; active lexical-name count
  (let $lexnm i32 (call $heap_alloc (i32.const 4096)))   ;; name pointers
  (let $lexlv i32 (call $heap_alloc (i32.const 4096)))   ;; brace level each was declared at
  (block $done (loop $scan
    (let $k i32 (call $tok_kind))
    (br_if $done (i32.eq (local.get $k) (i32.const 0)))
    (if (i32.eq (local.get $k) (i32.const 17)) (then (set! $bd (i32.add (local.get $bd) (i32.const 1)))))
    (if (i32.and (i32.eq (local.get $k) (i32.const 18)) (i32.gt_s (local.get $bd) (i32.const 0)))
      (then
        (block $pe (loop $pl  ;; pop lexical names declared in the block now closing
          (br_if $pe (i32.eqz (local.get $lexn)))
          (br_if $pe (i32.lt_s (i32.load (i32.add (local.get $lexlv) (i32.mul (i32.sub (local.get $lexn) (i32.const 1)) (i32.const 4)))) (local.get $bd)))
          (set! $lexn (i32.sub (local.get $lexn) (i32.const 1))) (br $pl)))
        (set! $bd (i32.sub (local.get $bd) (i32.const 1))) (br_if $done (i32.eqz (local.get $bd)))))
    (if (i32.or (i32.eq (local.get $k) (i32.const 15)) (i32.eq (local.get $k) (i32.const 19)))
      (then (set! $pd (i32.add (local.get $pd) (i32.const 1)))))
    (if (i32.and (i32.or (i32.eq (local.get $k) (i32.const 16)) (i32.eq (local.get $k) (i32.const 20))) (i32.gt_s (local.get $pd) (i32.const 0)))
      (then (set! $pd (i32.sub (local.get $pd) (i32.const 1)))))
    (if (i32.eq (local.get $k) (i32.const 3))
      (then
        (if (call $tok_is_kw (cstring "function"))
          (then
            (let $isstmt i32 (i32.and (i32.eqz (local.get $pd)) (i32.or (call $vm_stmt_pos (local.get $prevk))
              (i32.and (call $nl_before)
                (i32.or (i32.eq (local.get $prevk) (i32.const 1)) (i32.or (i32.eq (local.get $prevk) (i32.const 2))
                (i32.or (i32.eq (local.get $prevk) (i32.const 3)) (i32.eq (local.get $prevk) (i32.const 20)))))))))
            (if (i32.and (local.get $isstmt) (i32.ge_s (local.get $bd) (i32.const 2)))
              (then  ;; block-nested declaration: DEFVAR the name unless it's lexically bound in an enclosing block
                (let $fsave i32 (call $cursor_save))
                (call $next_token) (if (i32.eq (call $tok_kind) (i32.const 12)) (then (call $next_token)))  ;; 'function' '*'?
                (let $fname i32 (if i32 (i32.eq (call $tok_kind) (i32.const 3)) (then (call $ident_name)) (else (i32.const 0))))
                (call $cursor_restore (local.get $fsave))
                (let $blocked i32 (i32.const 0))
                (if (local.get $fname)
                  (then
                    (let $li i32 (i32.const 0))
                    (block $le (loop $ll
                      (br_if $le (i32.ge_s (local.get $li) (local.get $lexn)))
                      (if (call $str_eq (i32.load (i32.add (local.get $lexnm) (i32.mul (local.get $li) (i32.const 4)))) (local.get $fname))
                        (then (set! $blocked (i32.const 1)) (br $le)))
                      (set! $li (i32.add (local.get $li) (i32.const 1))) (br $ll)))))
                (if (i32.eqz (local.get $blocked))
                  (then (call $vm_hoist_clause_fn (local.get $code)))  ;; DEFVAR name + skip body
                  (else (call $hoist_skip_fn))))                       ;; lexically shadowed → skip (no DEFVAR)
              (else (call $hoist_skip_fn)))  ;; body-top-level decl / expression → skip body (no DEFVAR)
            (call $next_token) (set! $prevk (i32.const 18))
            (br $scan)))
        ;; record a lexical binding name at the current brace level (let/const/class simple identifier)
        (if (i32.or (call $tok_is_kw (cstring "let")) (i32.or (call $tok_is_kw (cstring "const")) (call $tok_is_kw (cstring "class"))))
          (then
            (let $lsave i32 (call $cursor_save))
            (call $next_token)
            (if (i32.and (i32.eq (call $tok_kind) (i32.const 3)) (i32.lt_s (local.get $lexn) (i32.const 1024)))
              (then
                (i32.store (i32.add (local.get $lexnm) (i32.mul (local.get $lexn) (i32.const 4))) (call $ident_name))
                (i32.store (i32.add (local.get $lexlv) (i32.mul (local.get $lexn) (i32.const 4))) (local.get $bd))
                (set! $lexn (i32.add (local.get $lexn) (i32.const 1)))))
            (call $cursor_restore (local.get $lsave))))
        ;; catch (param) — collect every identifier in the (possibly destructured) parameter at level bd+1
        ;; (the catch block's scope). CONSUME the param here (don't cursor-restore) so the main loop never
        ;; sees the pattern's '{'/'[' as block braces (which would pop the name prematurely on the pattern '}').
        (if (call $tok_is_kw (cstring "catch"))
          (then
            (call $next_token)  ;; 'catch' → cursor at '(' (or the catch body '{' if the binding is omitted)
            (if (i32.eq (call $tok_kind) (i32.const 15))  ;; '('
              (then
                (call $next_token)  ;; into the param
                (let $cdepth i32 (i32.const 1))
                (block $ce (loop $cl
                  (br_if $ce (i32.eqz (call $tok_kind)))
                  (if (i32.or (i32.eq (call $tok_kind) (i32.const 15)) (i32.or (i32.eq (call $tok_kind) (i32.const 17)) (i32.eq (call $tok_kind) (i32.const 19)))) (then (set! $cdepth (i32.add (local.get $cdepth) (i32.const 1)))))
                  (if (i32.or (i32.eq (call $tok_kind) (i32.const 16)) (i32.or (i32.eq (call $tok_kind) (i32.const 18)) (i32.eq (call $tok_kind) (i32.const 20))))
                    (then (set! $cdepth (i32.sub (local.get $cdepth) (i32.const 1))) (br_if $ce (i32.eqz (local.get $cdepth)))))  ;; cursor left AT the closing ')'
                  (if (i32.and (i32.eq (call $tok_kind) (i32.const 3)) (i32.lt_s (local.get $lexn) (i32.const 1024)))
                    (then
                      (i32.store (i32.add (local.get $lexnm) (i32.mul (local.get $lexn) (i32.const 4))) (call $ident_name))
                      (i32.store (i32.add (local.get $lexlv) (i32.mul (local.get $lexn) (i32.const 4))) (i32.add (local.get $bd) (i32.const 1)))
                      (set! $lexn (i32.add (local.get $lexn) (i32.const 1)))))
                  (call $next_token) (br $cl)))
                (call $next_token)))  ;; consume the ')' → cursor at the catch body '{'
            (set! $prevk (i32.const 16)) (br $scan)))))
    (set! $prevk (local.get $k)) (call $next_token) (br $scan)))
  (call $cursor_restore (local.get $start)))
;; skip a `function`/`function*` NAME (params){body} declaration without emitting
;; (used when it was already hoisted). Cursor at 'function'.
(func $vm_skip_fn_decl (effects)
  (call $next_token)  ;; 'function'
  (if (i32.eq (call $tok_kind) (i32.const 12)) (then (call $next_token)))  ;; '*'
  (if (i32.eq (call $tok_kind) (i32.const 3)) (then (call $next_token)))   ;; NAME
  (if (i32.eq (call $tok_kind) (i32.const 15)) (then (call $vm_skip_balanced)))  ;; (params)
  (if (i32.eq (call $tok_kind) (i32.const 17)) (then (call $vm_skip_balanced))))  ;; {body}
;; strict mode: `eval`/`arguments` may not be an assignment/update target (early
;; SyntaxError). Returns 1 (and raises a SyntaxError) if so — caller should return.
(func $vm_strict_lhs_check (param $name i32) (result i32) (effects)
  ;; `await` may not be a binding identifier inside an async body; `yield` may not inside a generator body
  ;; (reg 896 = in-async-body, reg 672 = in-generator-body). Holds even for a \u-escaped spelling since
  ;; ident_name returns the decoded text.
  (if (i32.and (i32.load (i32.const 896)) (call $str_eq (local.get $name) (cstring "await")))
    (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "'await' is reserved inside an async function")) (return (i32.const 1))))
  (if (i32.and (i32.or (i32.load (i32.const 672)) (i32.load (i32.const 388))) (call $str_eq (local.get $name) (cstring "yield")))
    (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "'yield' is reserved inside a generator or strict-mode code")) (return (i32.const 1))))
  (if (i32.load (i32.const 388))
    (then
      (if (i32.or (call $str_eq (local.get $name) (cstring "eval")) (call $str_eq (local.get $name) (cstring "arguments")))
        (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Assignment to eval or arguments is not allowed in strict mode")) (return (i32.const 1))))
      ;; a strict-reserved word (implements/interface/package/private/protected/public/static/let)
      ;; may not be a BindingIdentifier or the target of an assignment in strict mode.
      (if (call $is_strict_reserved (local.get $name))
        (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Unexpected strict-mode reserved word")) (return (i32.const 1))))))
  (i32.const 0))
;; is `name` one of the ALWAYS-reserved keywords (ReservedWord)? These can never be a BindingIdentifier
;; or LabelIdentifier. `yield`/`await` (contextual) and the strict-only reserved words (let/static/…) are
;; handled at their own sites, so they are intentionally NOT listed here.
(func $is_reserved_word (param $n i32) (result i32) (effects)
  (i32.or (i32.or (i32.or (i32.or (call $str_eq (local.get $n) (cstring "break")) (call $str_eq (local.get $n) (cstring "case")))
                          (i32.or (call $str_eq (local.get $n) (cstring "catch")) (call $str_eq (local.get $n) (cstring "class"))))
                  (i32.or (i32.or (call $str_eq (local.get $n) (cstring "const")) (call $str_eq (local.get $n) (cstring "continue")))
                          (i32.or (call $str_eq (local.get $n) (cstring "debugger")) (call $str_eq (local.get $n) (cstring "default")))))
    (i32.or (i32.or (i32.or (i32.or (call $str_eq (local.get $n) (cstring "delete")) (call $str_eq (local.get $n) (cstring "do")))
                            (i32.or (call $str_eq (local.get $n) (cstring "else")) (call $str_eq (local.get $n) (cstring "enum"))))
                    (i32.or (i32.or (call $str_eq (local.get $n) (cstring "export")) (call $str_eq (local.get $n) (cstring "extends")))
                            (i32.or (call $str_eq (local.get $n) (cstring "false")) (call $str_eq (local.get $n) (cstring "finally")))))
      (i32.or (i32.or (i32.or (i32.or (call $str_eq (local.get $n) (cstring "for")) (call $str_eq (local.get $n) (cstring "function")))
                              (i32.or (call $str_eq (local.get $n) (cstring "if")) (call $str_eq (local.get $n) (cstring "import"))))
                      (i32.or (i32.or (call $str_eq (local.get $n) (cstring "in")) (call $str_eq (local.get $n) (cstring "instanceof")))
                              (i32.or (call $str_eq (local.get $n) (cstring "new")) (call $str_eq (local.get $n) (cstring "null")))))
        (i32.or (i32.or (i32.or (i32.or (call $str_eq (local.get $n) (cstring "return")) (call $str_eq (local.get $n) (cstring "super")))
                                (i32.or (call $str_eq (local.get $n) (cstring "switch")) (call $str_eq (local.get $n) (cstring "this"))))
                        (i32.or (i32.or (call $str_eq (local.get $n) (cstring "throw")) (call $str_eq (local.get $n) (cstring "true")))
                                (i32.or (call $str_eq (local.get $n) (cstring "try")) (call $str_eq (local.get $n) (cstring "typeof")))))
          (i32.or (i32.or (call $str_eq (local.get $n) (cstring "var")) (call $str_eq (local.get $n) (cstring "void")))
                  (i32.or (call $str_eq (local.get $n) (cstring "while")) (call $str_eq (local.get $n) (cstring "with")))))))))
;; strict-mode-only reserved words (valid identifiers in sloppy code): a BindingIdentifier /
;; IdentifierReference spelled as one of these is a SyntaxError under strict mode. `yield` is included
;; (always reserved in strict, and in a generator regardless — callers gate on context as needed).
(func $is_strict_reserved (param $n i32) (result i32) (effects)
  (i32.or (i32.or (i32.or (call $str_eq (local.get $n) (cstring "implements")) (call $str_eq (local.get $n) (cstring "interface")))
                  (i32.or (call $str_eq (local.get $n) (cstring "package")) (call $str_eq (local.get $n) (cstring "private"))))
          (i32.or (i32.or (i32.or (call $str_eq (local.get $n) (cstring "protected")) (call $str_eq (local.get $n) (cstring "public")))
                          (i32.or (call $str_eq (local.get $n) (cstring "static")) (call $str_eq (local.get $n) (cstring "let"))))
                  (call $str_eq (local.get $n) (cstring "yield")))))
;; patch unlabeled break/continue lists AND (if the current loop is labeled) the
;; label entry's matching list, all to `target`.
(func $vm_patch_breaks (param $code i32) (param $target i32) (effects)
  (call $vm_patch_list (i32.const 208) (i32.const 212) (local.get $code) (local.get $target))
  (if (i32.load (i32.const 248)) (then (call $vm_patch_entry_list (i32.load (i32.const 248)) (i32.const 4) (i32.const 8) (local.get $code) (local.get $target)))))
(func $vm_patch_conts (param $code i32) (param $target i32) (effects)
  (call $vm_patch_list (i32.const 216) (i32.const 220) (local.get $code) (local.get $target))
  (if (i32.load (i32.const 248)) (then (call $vm_patch_entry_list (i32.load (i32.const 248)) (i32.const 12) (i32.const 16) (local.get $code) (local.get $target)))))
(func $vm_patch_entry_list (param $entry i32) (param $loff i32) (param $coff i32) (param $code i32) (param $target i32) (effects)
  (let $list i32 (i32.load (i32.add (local.get $entry) (local.get $loff))))
  (let $n i32 (i32.load (i32.add (local.get $entry) (local.get $coff))))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    (i32.store (i32.add (local.get $code) (i32.load (i32.add (local.get $list) (i32.mul (local.get $i) (i32.const 4))))) (local.get $target))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l))))
;; patch every jump recorded in (listreg, countreg) to point at $target
(func $vm_patch_list (param $listreg i32) (param $countreg i32) (param $code i32) (param $target i32) (effects)
  (let $list i32 (i32.load (local.get $listreg)))
  (let $n i32 (i32.load (local.get $countreg)))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    (i32.store (i32.add (local.get $code) (i32.load (i32.add (local.get $list) (i32.mul (local.get $i) (i32.const 4))))) (local.get $target))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l))))

;; fresh unique temp variable name "@@t<n>" (for desugaring for-of), reg 224 counter
(func $vm_tmpname (result i32) (effects)
  (let $n i32 (i32.load (i32.const 224)))
  (i32.store (i32.const 224) (i32.add (local.get $n) (i32.const 1)))
  (call $str_concat (cstring "@@t") (call $num_to_str (f64.convert_i32_s (local.get $n)))))

;; coerce a value to an iterator: arrays → values-iterator; objects with
;; @@iterator → call it; objects with .next → themselves (generators included).
;; append the elements of an iterable `srcv` onto array `dst` (for `...spread`):
;; arrays/strings directly, any other object via the iterator protocol (next()).
(func $spread_into (param $dst i32) (param $srcv i64) (effects)
  ;; arrays go through the iterator protocol (below) so an overridden
  ;; Array.prototype[Symbol.iterator] is honored, matching $vm_get_iter.
  (if (call $is_string (local.get $srcv))
    (then
      (let $ssp i32 (call $val_payload (local.get $srcv)))
      (let $sn i32 (call $str_len (local.get $ssp)))
      (let $sci i32 (i32.const 0))
      (block $se (loop $sl  ;; iterate by CODE POINT (spec String iterator), not by UTF-8 byte
        (br_if $se (i32.ge_s (local.get $sci) (local.get $sn)))
        (call $arr_push (local.get $dst) (call $str_cp_at (local.get $ssp) (local.get $sci)))
        (set! $sci (i32.add (local.get $sci) (call $str_cp_len (call $str_byte (local.get $ssp) (local.get $sci))))) (br $sl)))
      (return)))
  (if (i32.or (call $is_array (local.get $srcv)) (call $is_object (local.get $srcv)))
    (then
      (let $it i64 (call $vm_get_iter (local.get $srcv)))
      (if (call $err) (then (return)))  ;; @@iterator threw / missing
      ;; GetIterator: the [Symbol.iterator]() result must be an Object, else TypeError (was: silently
      ;; skipped because a non-object iterator has no callable `next` → empty spread instead of a throw).
      (if (i32.eqz (i32.or (call $is_object (local.get $it)) (call $is_function (local.get $it))))
        (then (call $throw_type (cstring "TypeError") (cstring "iterator is not an object")) (return)))
      (let $nf i64 (call $get_prop (local.get $it) (call $mk_str (cstring "next"))))
      (if (call $err) (then (return)))
      (if (i32.eqz (call $is_function (local.get $nf)))
        (then (call $throw_type (cstring "TypeError") (cstring "iterator.next is not a function")) (return)))
      (if (call $is_function (local.get $nf))
        (then
          (let $nbuf i32 (call $heap_alloc (i32.const 8)))
          (block $ie (loop $il
            (let $r i64 (call $call_val (local.get $nf) (i32.const 0) (local.get $nbuf) (local.get $it)))
            (br_if $ie (call $err))  ;; next() threw → propagate (was: read done/value off undefined → OOB crash)
            (if (i32.eqz (i32.or (call $is_object (local.get $r)) (i32.or (call $is_array (local.get $r)) (call $is_function (local.get $r)))))
              (then (call $throw_type (cstring "TypeError") (cstring "iterator result is not an object")) (br $ie)))
            (let $rdone i64 (call $get_prop (local.get $r) (call $mk_str (cstring "done"))))
            (br_if $ie (call $err))
            (br_if $ie (call $truthy (local.get $rdone)))
            (let $rval i64 (call $get_prop (local.get $r) (call $mk_str (cstring "value"))))
            (br_if $ie (call $err))
            (call $arr_push (local.get $dst) (local.get $rval))
            (br $il))))))
  (if (i32.eqz (i32.or (call $is_array (local.get $srcv)) (i32.or (call $is_string (local.get $srcv)) (call $is_object (local.get $srcv)))))  ;; primitive (null/undefined/number/…) → not iterable
    (then (call $throw_type (cstring "TypeError") (cstring "is not iterable"))))))

(func $vm_get_iter (param $v i64) (result i64) (effects)
  (if (call $is_array (local.get $v))
    (then
      ;; GetIterator: call the array's @@iterator (honors an overridden Array.prototype[Symbol.iterator]).
      ;; If it has been deleted or replaced with a non-callable, GetIterator throws TypeError — there is
      ;; NO fall-back to the built-in array iterator (a deleted Array.prototype[Symbol.iterator] is observable).
      (let $aitf i64 (call $get_prop (local.get $v) (call $mk_str (cstring "@@iterator"))))
      (if (call $err) (then (return (call $v_undef))))
      (if (call $is_function (local.get $aitf))
        (then (return (call $call_val (local.get $aitf) (i32.const 0) (call $heap_alloc (i32.const 8)) (local.get $v)))))
      (call $throw_type (cstring "TypeError") (cstring "is not iterable")) (return (call $v_undef))))
  (if (call $is_string (local.get $v))  ;; string → array of single-char strings, then array iterator
    (then
      (let $sp i32 (call $val_payload (local.get $v)))
      (let $sn i32 (call $str_len (local.get $sp)))
      (let $ca i32 (call $arr_new (local.get $sn)))
      (let $si i32 (i32.const 0))
      (block $se (loop $sl  ;; iterate by CODE POINT (spec String iterator), not by UTF-8 byte
        (br_if $se (i32.ge_s (local.get $si) (local.get $sn)))
        (call $arr_push (local.get $ca) (call $str_cp_at (local.get $sp) (local.get $si)))
        (set! $si (i32.add (local.get $si) (call $str_cp_len (call $str_byte (local.get $sp) (local.get $si)))))
        (br $sl)))
      (return (call $call_native (i32.const 97) (i32.const 0) (call $heap_alloc (i32.const 8)) (call $mk_arr (local.get $ca))))))
  (if (call $is_object (local.get $v))
    (then
      (let $itf i64 (call $get_prop (local.get $v) (call $mk_str (cstring "@@iterator"))))
      (if (call $is_function (local.get $itf)) (then (return (call $call_val (local.get $itf) (i32.const 0) (call $heap_alloc (i32.const 8)) (local.get $v)))))
      (if (call $is_function (call $get_prop (local.get $v) (call $mk_str (cstring "next")))) (then (return (local.get $v))))  ;; already an iterator (generator/manual): has .next
      (call $throw_type (cstring "TypeError") (cstring "is not iterable")) (return (call $v_undef))))  ;; object with neither @@iterator nor next
  (call $throw_type (cstring "TypeError") (cstring "is not iterable")) (call $v_undef))  ;; primitive (null/undefined/number/boolean) — not iterable

;; GetIterator(v, async): @@asyncIterator() if present, else fall back to the sync iterator
;; (its next() results are awaited by the for-await loop — approximates CreateAsyncFromSyncIterator).
(func $vm_get_async_iter (param $v i64) (result i64) (effects)
  (if (i32.or (call $is_object (local.get $v)) (i32.or (call $is_array (local.get $v)) (call $is_function (local.get $v))))
    (then
      (let $aif i64 (call $get_prop (local.get $v) (call $mk_str (cstring "@@asyncIterator"))))
      (if (call $err) (then (return (call $v_undef))))
      (if (call $is_function (local.get $aif))
        (then (return (call $call_val (local.get $aif) (i32.const 0) (call $heap_alloc (i32.const 8)) (local.get $v)))))
      ;; GetMethod: @@asyncIterator present but not callable (and not null/undefined) → TypeError
      (if (i32.eqz (i32.or (call $is_undefined (local.get $aif)) (call $is_null (local.get $aif))))
        (then (call $throw_type (cstring "TypeError") (cstring "[Symbol.asyncIterator] is not a function")) (return (call $v_undef))))))
  (call $vm_get_iter (local.get $v)))

;; Template raw-value line-terminator normalization (TRV): <CR> and <CRLF> both
;; become a single <LF>. Returns a fresh Str of the normalized bytes.
(func $tmpl_norm (param $src i32) (param $len i32) (result i32) (effects)
  (let $p i32 (call $str_alloc (local.get $len)))
  (let $i i32 (i32.const 0))
  (let $o i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $len)))
    (let $c i32 (i32.load8_u (i32.add (local.get $src) (local.get $i))))
    (if (i32.eq (local.get $c) (i32.const 13))  ;; CR (and CRLF) → LF
      (then
        (call $str_set_byte (local.get $p) (local.get $o) (i32.const 10))
        (set! $o (i32.add (local.get $o) (i32.const 1)))
        (if (i32.and (i32.lt_s (i32.add (local.get $i) (i32.const 1)) (local.get $len))
                     (i32.eq (i32.load8_u (i32.add (local.get $src) (i32.add (local.get $i) (i32.const 1)))) (i32.const 10)))
          (then (set! $i (i32.add (local.get $i) (i32.const 1)))))  ;; eat LF of CRLF
        (set! $i (i32.add (local.get $i) (i32.const 1)))
        (br $l)))
    (call $str_set_byte (local.get $p) (local.get $o) (local.get $c))
    (set! $o (i32.add (local.get $o) (i32.const 1)))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (i32.store (local.get $p) (local.get $o))
  (local.get $p))

;; Template cooked value: line-normalize the raw segment, then decode escapes.
(func $tmpl_cook (param $src i32) (param $len i32) (result i32) (effects)
  (let $n i32 (call $tmpl_norm (local.get $src) (local.get $len)))
  (call $decode_str (i32.add (local.get $n) (i32.const 4)) (call $str_len (local.get $n))))

;; A raw template segment has an INVALID escape (→ TaggedTemplate cooked = undefined) when it contains:
;; \x not followed by 2 hex; \u not followed by 4 hex or {hex+} with codepoint <= 0x10FFFF; \0 followed
;; by a decimal digit (legacy octal); or \1-\9 (\8/\9 and legacy octal). Returns 1 if invalid.
(func $tmpl_bad_escape (param $src i32) (param $len i32) (param $allowlegacy i32) (result i32) (effects)
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $len)))
    (if (i32.eq (i32.load8_u (i32.add (local.get $src) (local.get $i))) (i32.const 92))  ;; backslash
      (then
        (set! $i (i32.add (local.get $i) (i32.const 1)))
        (br_if $e (i32.ge_s (local.get $i) (local.get $len)))
        (let $d i32 (i32.load8_u (i32.add (local.get $src) (local.get $i))))
        ;; \x → exactly 2 hex digits
        (if (i32.eq (local.get $d) (i32.const 120))
          (then
            (if (i32.ge_s (i32.add (local.get $i) (i32.const 2)) (local.get $len)) (then (return (i32.const 1))))
            (if (i32.lt_s (call $hexval (i32.load8_u (i32.add (local.get $src) (i32.add (local.get $i) (i32.const 1))))) (i32.const 0)) (then (return (i32.const 1))))
            (if (i32.lt_s (call $hexval (i32.load8_u (i32.add (local.get $src) (i32.add (local.get $i) (i32.const 2))))) (i32.const 0)) (then (return (i32.const 1))))))
        ;; \u → 4 hex, or {hex+} with value <= 0x10FFFF
        (if (i32.eq (local.get $d) (i32.const 117))
          (then
            (if (i32.ge_s (i32.add (local.get $i) (i32.const 1)) (local.get $len)) (then (return (i32.const 1))))
            (if (i32.eq (i32.load8_u (i32.add (local.get $src) (i32.add (local.get $i) (i32.const 1)))) (i32.const 123))  ;; '{'
              (then  ;; \u{ hex+ }
                (let $j i32 (i32.add (local.get $i) (i32.const 2)))
                (let $cp i32 (i32.const 0)) (let $ndig i32 (i32.const 0))
                (block $ue (loop $ul
                  (br_if $ue (i32.ge_s (local.get $j) (local.get $len)))
                  (let $uc i32 (i32.load8_u (i32.add (local.get $src) (local.get $j))))
                  (if (i32.eq (local.get $uc) (i32.const 125)) (then (br $ue)))  ;; '}'
                  (let $hv i32 (call $hexval (local.get $uc)))
                  (if (i32.lt_s (local.get $hv) (i32.const 0)) (then (return (i32.const 1))))  ;; non-hex before '}'
                  (set! $cp (i32.add (i32.mul (local.get $cp) (i32.const 16)) (local.get $hv)))
                  (set! $ndig (i32.add (local.get $ndig) (i32.const 1)))
                  (if (i32.gt_s (local.get $cp) (i32.const 1114111)) (then (return (i32.const 1))))  ;; > 0x10FFFF
                  (set! $j (i32.add (local.get $j) (i32.const 1))) (br $ul)))
                (if (i32.eqz (local.get $ndig)) (then (return (i32.const 1))))  ;; \u{} empty
                (if (i32.ge_s (local.get $j) (local.get $len)) (then (return (i32.const 1)))))  ;; no closing '}'
              (else  ;; \uHHHH — exactly 4 hex
                (if (i32.ge_s (i32.add (local.get $i) (i32.const 4)) (local.get $len)) (then (return (i32.const 1))))
                (if (i32.lt_s (call $hexval (i32.load8_u (i32.add (local.get $src) (i32.add (local.get $i) (i32.const 1))))) (i32.const 0)) (then (return (i32.const 1))))
                (if (i32.lt_s (call $hexval (i32.load8_u (i32.add (local.get $src) (i32.add (local.get $i) (i32.const 2))))) (i32.const 0)) (then (return (i32.const 1))))
                (if (i32.lt_s (call $hexval (i32.load8_u (i32.add (local.get $src) (i32.add (local.get $i) (i32.const 3))))) (i32.const 0)) (then (return (i32.const 1))))
                (if (i32.lt_s (call $hexval (i32.load8_u (i32.add (local.get $src) (i32.add (local.get $i) (i32.const 4))))) (i32.const 0)) (then (return (i32.const 1))))))))
        ;; legacy octal / non-octal-decimal escapes (\0+digit, \1-\9) — always invalid in templates, but
        ;; allowed in a sloppy STRING literal (strict rejects them separately via mem 928): gate on $allowlegacy.
        (if (i32.eqz (local.get $allowlegacy))
          (then
            ;; \0 followed by a decimal digit → legacy octal (invalid)
            (if (i32.eq (local.get $d) (i32.const 48))
              (then (if (i32.and (i32.lt_s (i32.add (local.get $i) (i32.const 1)) (local.get $len)) (call $is_digit (i32.load8_u (i32.add (local.get $src) (i32.add (local.get $i) (i32.const 1)))))) (then (return (i32.const 1))))))
            ;; \1-\9 → invalid (\8/\9 always, \1-\7 legacy octal)
            (if (i32.and (i32.ge_s (local.get $d) (i32.const 49)) (i32.le_s (local.get $d) (i32.const 57))) (then (return (i32.const 1))))))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (i32.const 0))

;; template literal `text ${expr} more` → build a string: PUSH "" then for each
;; literal chunk / ${expr} part, concatenate (ADD = js_add does ToString).
(func $vm_c_template (param $code i32) (effects)
  (let $tbase i32 (i32.add (call $src) (call $tok_start)))
  (let $tlen i32 (call $tok_len))
  (call $next_token)  ;; consume the template token
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_str (cstring "")))  ;; PUSH ""
  (let $ti i32 (i32.const 0))
  (let $tseg i32 (i32.const 0))  ;; raw start of the current literal segment
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $ti) (local.get $tlen)))
    (let $tc i32 (i32.load8_u (i32.add (local.get $tbase) (local.get $ti))))
    ;; `\X` escapes the next byte — skip both so an escaped `\${` / `` \` `` is not a boundary
    ;; (the actual escape decoding is done segment-wise by $decode_str below).
    (if (i32.eq (local.get $tc) (i32.const 92))
      (then (set! $ti (i32.add (local.get $ti) (i32.const 2))) (br $l)))
    (if (i32.and (i32.eq (local.get $tc) (i32.const 36)) (i32.eq (i32.load8_u (i32.add (local.get $tbase) (i32.add (local.get $ti) (i32.const 1)))) (i32.const 123)))
      (then  ;; ${ expr }
        ;; decode + push the cooked literal segment [tseg, ti). An untagged template with an invalid
        ;; escape (\x/\u malformed, legacy octal, \8/\9) is a SyntaxError (only tagged templates get undefined).
        (if (call $tmpl_bad_escape (i32.add (local.get $tbase) (local.get $tseg)) (i32.sub (local.get $ti) (local.get $tseg)) (i32.const 0))
          (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Invalid escape sequence in template literal")) (return)))
        (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_str (call $tmpl_cook (i32.add (local.get $tbase) (local.get $tseg)) (i32.sub (local.get $ti) (local.get $tseg)))))
        (call $vm_emit_op (local.get $code) (i32.const 2))  ;; ADD
        (set! $ti (i32.add (local.get $ti) (i32.const 2)))
        (let $tes i32 (local.get $ti))
        (let $tdepth i32 (i32.const 1))
        (block $ee (loop $el
          (br_if $ee (i32.ge_s (local.get $ti) (local.get $tlen)))
          (let $d i32 (i32.load8_u (i32.add (local.get $tbase) (local.get $ti))))
          (if (i32.eq (local.get $d) (i32.const 123)) (then (set! $tdepth (i32.add (local.get $tdepth) (i32.const 1)))))
          (if (i32.eq (local.get $d) (i32.const 125)) (then (set! $tdepth (i32.sub (local.get $tdepth) (i32.const 1))) (br_if $ee (i32.eqz (local.get $tdepth)))))
          (set! $ti (i32.add (local.get $ti) (i32.const 1)))
          (br $el)))
        (let $texpr i32 (call $str_from_src (i32.add (local.get $tbase) (local.get $tes)) (i32.sub (local.get $ti) (local.get $tes))))
        ;; redirect the lexer to the expr substring, compile it, then restore
        (let $tssrc i32 (call $src)) (let $tslen i32 (call $src_len)) (let $tscur i32 (call $cursor_save))
        (call $set_src (i32.add (local.get $texpr) (i32.const 4)) (call $str_len (local.get $texpr)))
        (call $lex_init) (call $next_token)
        (call $vm_c_commaexpr (local.get $code))  ;; a template substitution `${ Expression }` is a full Expression (comma allowed)
        (call $set_src (local.get $tssrc) (local.get $tslen)) (call $cursor_restore (local.get $tscur))
        (call $vm_emit_op (local.get $code) (i32.const 115))  ;; TOSTR: template substitution is ToString (string-hint), NOT `+`/default-hint
        (call $vm_emit_op (local.get $code) (i32.const 2))  ;; ADD (string + string → concat)
        (set! $ti (i32.add (local.get $ti) (i32.const 1)))  ;; past }
        (set! $tseg (local.get $ti)))  ;; next segment starts after }
      (else
        (set! $ti (i32.add (local.get $ti) (i32.const 1)))))
    (br $l)))
  (if (call $tmpl_bad_escape (i32.add (local.get $tbase) (local.get $tseg)) (i32.sub (local.get $tlen) (local.get $tseg)) (i32.const 0))
    (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Invalid escape sequence in template literal")) (return)))
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_str (call $tmpl_cook (i32.add (local.get $tbase) (local.get $tseg)) (i32.sub (local.get $tlen) (local.get $tseg)))))  ;; trailing chunk
  (call $vm_emit_op (local.get $code) (i32.const 2)))  ;; ADD

;; tagged template `tag`a${x}b`` — the tag fn is already on the stack. Builds the
;; (compile-time-constant) strings array [a,b] with a .raw copy, then calls
;; tag(strings, ...substitutions). Cooked == raw here (escape handling deferred).
(func $vm_c_tagged_template (param $code i32) (param $ismethod i32) (effects)
  (let $tbase i32 (i32.add (call $src) (call $tok_start)))
  (let $tlen i32 (call $tok_len))
  (call $next_token)  ;; consume template token
  (let $cooked i32 (call $arr_new (i32.const 4)))
  (let $raw i32 (call $arr_new (i32.const 4)))
  (let $subs i32 (call $heap_alloc (i32.const 256)))  ;; substitution-expr substrings
  (let $nsub i32 (i32.const 0))
  (let $ti i32 (i32.const 0))
  (let $tseg i32 (i32.const 0))  ;; raw start of the current literal segment
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $ti) (local.get $tlen)))
    (let $tc i32 (i32.load8_u (i32.add (local.get $tbase) (local.get $ti))))
    ;; `\X` escapes the next byte — skip both so an escaped `\${` is not a boundary
    ;; (cooked decoding is done segment-wise by $decode_str; raw keeps bytes verbatim).
    (if (i32.eq (local.get $tc) (i32.const 92))
      (then (set! $ti (i32.add (local.get $ti) (i32.const 2))) (br $l)))
    (if (i32.and (i32.eq (local.get $tc) (i32.const 36)) (i32.eq (i32.load8_u (i32.add (local.get $tbase) (i32.add (local.get $ti) (i32.const 1)))) (i32.const 123)))
      (then  ;; ${ expr } — close the current part, capture the expr
        (call $arr_push (local.get $cooked) (if i64 (call $tmpl_bad_escape (i32.add (local.get $tbase) (local.get $tseg)) (i32.sub (local.get $ti) (local.get $tseg)) (i32.const 0)) (then (call $v_undef)) (else (call $mk_str (call $tmpl_cook (i32.add (local.get $tbase) (local.get $tseg)) (i32.sub (local.get $ti) (local.get $tseg)))))))  ;; invalid escape → cooked = undefined
        (call $arr_push (local.get $raw) (call $mk_str (call $tmpl_norm (i32.add (local.get $tbase) (local.get $tseg)) (i32.sub (local.get $ti) (local.get $tseg)))))
        (set! $ti (i32.add (local.get $ti) (i32.const 2)))
        (let $tes i32 (local.get $ti))
        (let $tdepth i32 (i32.const 1))
        (block $ee (loop $el
          (br_if $ee (i32.ge_s (local.get $ti) (local.get $tlen)))
          (let $d i32 (i32.load8_u (i32.add (local.get $tbase) (local.get $ti))))
          (if (i32.eq (local.get $d) (i32.const 123)) (then (set! $tdepth (i32.add (local.get $tdepth) (i32.const 1)))))
          (if (i32.eq (local.get $d) (i32.const 125)) (then (set! $tdepth (i32.sub (local.get $tdepth) (i32.const 1))) (br_if $ee (i32.eqz (local.get $tdepth)))))
          (set! $ti (i32.add (local.get $ti) (i32.const 1)))
          (br $el)))
        (i32.store (i32.add (local.get $subs) (i32.mul (local.get $nsub) (i32.const 4))) (call $str_from_src (i32.add (local.get $tbase) (local.get $tes)) (i32.sub (local.get $ti) (local.get $tes))))
        (set! $nsub (i32.add (local.get $nsub) (i32.const 1)))
        (set! $ti (i32.add (local.get $ti) (i32.const 1)))  ;; past }
        (set! $tseg (local.get $ti)))  ;; next segment starts after }
      (else
        (set! $ti (i32.add (local.get $ti) (i32.const 1)))))
    (br $l)))
  (call $arr_push (local.get $cooked) (if i64 (call $tmpl_bad_escape (i32.add (local.get $tbase) (local.get $tseg)) (i32.sub (local.get $tlen) (local.get $tseg)) (i32.const 0)) (then (call $v_undef)) (else (call $mk_str (call $tmpl_cook (i32.add (local.get $tbase) (local.get $tseg)) (i32.sub (local.get $tlen) (local.get $tseg)))))))  ;; trailing part (invalid escape → undefined)
  (call $arr_push (local.get $raw) (call $mk_str (call $tmpl_norm (i32.add (local.get $tbase) (local.get $tseg)) (i32.sub (local.get $tlen) (local.get $tseg)))))
  ;; the raw array is frozen (indices non-writable/non-configurable via @@frozen, length locked)
  (call $scope_define_attr (call $arr_props (local.get $raw)) (cstring "@@frozen") (call $v_true) (i32.const 0))
  (call $scope_define_attr (call $arr_props (local.get $raw)) (cstring "@@noext") (call $v_true) (i32.const 0))
  ;; template object's `raw` prop: non-enumerable, non-writable, non-configurable
  (call $scope_define_attr (call $arr_props (local.get $cooked)) (cstring "raw") (call $mk_arr (local.get $raw)) (i32.const 0))
  ;; the template (cooked) object is frozen too (indices enumerable but non-writable/non-configurable)
  (call $scope_define_attr (call $arr_props (local.get $cooked)) (cstring "@@frozen") (call $v_true) (i32.const 0))
  (call $scope_define_attr (call $arr_props (local.get $cooked)) (cstring "@@noext") (call $v_true) (i32.const 0))
  ;; tag fn is on the stack; push the strings array (arg0) then each substitution
  (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_arr (local.get $cooked)))
  (let $si i32 (i32.const 0))
  (block $se (loop $sl
    (br_if $se (i32.ge_s (local.get $si) (local.get $nsub)))
    (let $sx i32 (i32.load (i32.add (local.get $subs) (i32.mul (local.get $si) (i32.const 4)))))
    (let $ss i32 (call $src)) (let $sln i32 (call $src_len)) (let $sc i32 (call $cursor_save))
    (call $set_src (i32.add (local.get $sx) (i32.const 4)) (call $str_len (local.get $sx)))
    (call $lex_init) (call $next_token)
    (call $vm_c_expr (local.get $code))
    (call $set_src (local.get $ss) (local.get $sln)) (call $cursor_restore (local.get $sc))
    (set! $si (i32.add (local.get $si) (i32.const 1)))
    (br $sl)))
  ;; CALLM (33) when the tag is a member expression (obj.fn`…` → this=obj), else CALL (19); same argc
  ;; = strings array + nsub substitutions (CALLM additionally pops the receiver already under the tag fn).
  (call $vm_emit_op (local.get $code) (if i32 (local.get $ismethod) (then (i32.const 33)) (else (i32.const 19)))) (call $vm_emit_op (local.get $code) (i32.add (local.get $nsub) (i32.const 1))))

;; IsAnonymousFunctionDefinition: true iff the just-compiled initializer (which
;; began emitting at $start, ending at the current cursor) was EXACTLY one
;; function/arrow/class literal — modulo transparent parens, which emit nothing.
;; The literal compilers record their emit span in regs [680,684] (outermost wins
;; under nesting). `(0, fn)` / `a || fn` / `fn.bind()` all emit ops before/after
;; the literal, so the span won't equal [start, cursor]. Stale regs are safe: a
;; non-literal initializer always advances the cursor past any prior 684.
(func $vm_is_anon_fn_def (param $start i32) (result i32)
  (i32.and (i32.eq (i32.load (i32.const 680)) (local.get $start))
           (i32.eq (i32.load (i32.const 684)) (call $vm_emit_cursor))))

;; compound-assignment operator tokens (NAME/member op= expr): += -= *= /= (40-43),
;; **= (58), %= &= |= ^= <<= >>= >>>= (62-68). NOT the logical ||= &&= ??= (59-61).
(func $is_compound_assign (param $tok i32) (result i32)
  (i32.or (i32.and (i32.ge_s (local.get $tok) (i32.const 40)) (i32.le_s (local.get $tok) (i32.const 43)))
    (i32.or (i32.eq (local.get $tok) (i32.const 58))
            (i32.and (i32.ge_s (local.get $tok) (i32.const 62)) (i32.le_s (local.get $tok) (i32.const 68))))))
;; any assignment operator: `=` (24), compound-assign (+=, …), or logical-assign (||= &&= ??=, 59-61).
;; used to reject a following assignment after a primary that is not a valid AssignmentTarget (literals).
(func $is_assign_op (param $tok i32) (result i32)
  (i32.or (i32.eq (local.get $tok) (i32.const 24))
    (i32.or (call $is_compound_assign (local.get $tok))
            (i32.and (i32.ge_s (local.get $tok) (i32.const 59)) (i32.le_s (local.get $tok) (i32.const 61))))))
;; map a compound-assign token to the VM binary op it applies (ADD2 SUB3 MUL4 DIV5 MOD22
;; AND37 OR38 XOR39 SHL40 SHR41 USHR42 POW43)
(func $compound_cop (param $tok i32) (result i32)
  (if (i32.eq (local.get $tok) (i32.const 40)) (then (return (i32.const 2))))   ;; += → ADD
  (if (i32.eq (local.get $tok) (i32.const 41)) (then (return (i32.const 3))))   ;; -= → SUB
  (if (i32.eq (local.get $tok) (i32.const 42)) (then (return (i32.const 4))))   ;; *= → MUL
  (if (i32.eq (local.get $tok) (i32.const 43)) (then (return (i32.const 5))))   ;; /= → DIV
  (if (i32.eq (local.get $tok) (i32.const 58)) (then (return (i32.const 43))))  ;; **= → POW
  (if (i32.eq (local.get $tok) (i32.const 62)) (then (return (i32.const 22))))  ;; %= → MOD
  (if (i32.eq (local.get $tok) (i32.const 63)) (then (return (i32.const 37))))  ;; &= → AND
  (if (i32.eq (local.get $tok) (i32.const 64)) (then (return (i32.const 38))))  ;; |= → OR
  (if (i32.eq (local.get $tok) (i32.const 65)) (then (return (i32.const 39))))  ;; ^= → XOR
  (if (i32.eq (local.get $tok) (i32.const 66)) (then (return (i32.const 40))))  ;; <<= → SHL
  (if (i32.eq (local.get $tok) (i32.const 67)) (then (return (i32.const 41))))  ;; >>= → SHR
  (i32.const 42))  ;; 68 >>>= → USHR

;; Reference-record caching for identifier compound-assignment (`x op= v`). Resolve the
;; binding EXACTLY ONCE, returning a heap record (16 bytes) [kind:i32 @0][scopePtr:i32 @4]
;; [withObj:i64 @8]. kind 0 = ordinary scope slot (scopePtr owns it), 1 = `with` object
;; (withObj), 2 = unresolvable (compound-assign GetValue → ReferenceError; never PutValue'd).
;; Mirrors $scope_find's chain walk (incl. `with` HasProperty via with_find_slot).
(func $vm_resolve_ref (param $scope i32) (param $name i32) (result i32) (effects)
  (let $rec i32 (call $heap_alloc (i32.const 16)))
  (i32.store (local.get $rec) (i32.const 2))  ;; default: unresolvable
  (i32.store (i32.add (local.get $rec) (i32.const 4)) (i32.const 0))
  (let $cur i32 (local.get $scope))
  (block $brk (loop $cont
    (br_if $brk (i32.eqz (local.get $cur)))
    (if (call $scope_find_local (local.get $cur) (local.get $name))
      (then (i32.store (local.get $rec) (i32.const 0)) (i32.store (i32.add (local.get $rec) (i32.const 4)) (local.get $cur)) (br $brk)))
    (let $wo i64 (call $scope_withobj (local.get $cur)))
    (if (i64.ne (local.get $wo) (i64.const 0))
      (then
        (let $ws i32 (call $with_find_slot (local.get $wo) (local.get $name)))
        (br_if $brk (call $err))  ;; proxy has-trap threw → stop (err propagates; caller treats as abrupt)
        (if (local.get $ws) (then (i32.store (local.get $rec) (i32.const 1)) (i64.store (i32.add (local.get $rec) (i32.const 8)) (local.get $wo)) (br $brk)))))
    (set! $cur (call $scope_parent (local.get $cur)))
    (br $cont)))
  (local.get $rec))

;; f64 → i64 with saturation (no trap): NaN → 0, out-of-range clamps to i64 min/max.
;; Used where an f64 (possibly beyond i64) is converted to our i64-limited BigInt.
(func $f64_sat_i64 (param $x f64) (result i64)
  (if i64 (f64.ne (local.get $x) (local.get $x)) (then (i64.const 0))  ;; NaN
    (else (if i64 (f64.ge (local.get $x) (f64.const 9223372036854775808.0)) (then (i64.const 9223372036854775807))  ;; >= 2^63
      (else (if i64 (f64.lt (local.get $x) (f64.const -9223372036854775808.0)) (then (i64.const -9223372036854775808))  ;; < -2^63
        (else (i64.trunc_f64_s (local.get $x)))))))))

;; Read-only scan: is the token sequence at the cursor a simple AssignmentTarget — a
;; possibly-parenthesized identifier or member-access chain, with no operators, calls,
;; literals, or `this`? Consumes the target's tokens (does NOT emit); the caller checks
;; whether the cursor then sits exactly on the wrapping ')'. Returns 1 if a simple target
;; was consumed, 0 otherwise. Distinguishes `(x)=1` / `(o.a)=1` / `(a[i])=1` (valid) from
;; `(a+b)=1` / `(f())=1` / `(this)=1` / `(a,b)=1` (SyntaxError).
(func $scan_lhs_target (result i32) (effects)
  (let $k i32 (call $tok_kind))
  (if (i32.eq (local.get $k) (i32.const 15))  ;; '(' → nested parenthesized target
    (then
      (call $next_token)
      (if (i32.eqz (call $scan_lhs_target)) (then (return (i32.const 0))))
      (if (i32.ne (call $tok_kind) (i32.const 16)) (then (return (i32.const 0))))  ;; expect ')'
      (call $next_token))
    (else
      (if (i32.ne (local.get $k) (i32.const 3)) (then (return (i32.const 0))))  ;; not an identifier
      ;; `this` / `true` / `false` / `null` / `super` are not simple assignment targets
      (if (i32.or (call $tok_is_kw (cstring "this")) (i32.or (call $tok_is_kw (cstring "true"))
            (i32.or (call $tok_is_kw (cstring "false")) (i32.or (call $tok_is_kw (cstring "null")) (call $tok_is_kw (cstring "super"))))))
        (then (return (i32.const 0))))
      (call $next_token)))
  ;; member tail: `.name` | `[ … ]` (a following '(' is a call → non-simple)
  (block $done (loop $l
    (let $k2 i32 (call $tok_kind))
    (if (i32.eq (local.get $k2) (i32.const 23))  ;; '.'
      (then (call $next_token)
            (if (i32.ne (call $tok_kind) (i32.const 3)) (then (return (i32.const 0))))
            (call $next_token) (br $l)))
    (if (i32.eq (local.get $k2) (i32.const 19))  ;; '[' … ']'
      (then (call $vm_skip_balanced) (br $l)))
    (if (i32.eq (local.get $k2) (i32.const 15))  ;; '(' → call
      (then (return (i32.const 0))))
    (br $done)))
  (i32.const 1))

;; ── compiler: source → bytecode (precedence-climbing, reuses the lexer) ──
(func $vm_c_primary (param $code i32) (effects)
  ;; class-heritage context (reg 984): the extends clause is a LeftHandSideExpression, so a top-level
  ;; ArrowFunction (`extends () => {}`, `extends x => x`) is an early SyntaxError. Read+clear on entry so
  ;; only the OUTERMOST primary (the heritage itself) is guarded — a parenthesized `(()=>{})` or an arrow
  ;; nested in a call argument re-enters with the flag cleared and is fine.
  (let $heritnoarrow i32 (i32.load (i32.const 984))) (i32.store (i32.const 984) (i32.const 0))
  (if (i32.eq (call $tok_kind) (i32.const 1))  ;; NUM literal
    (then
      ;; strict mode: a LegacyOctalIntegerLiteral (`010`) or NonOctalDecimalIntegerLiteral (`08`) is a
      ;; SyntaxError (flagged by the lexer at mem 928). Read while the number is still the current token.
      (if (i32.and (i32.load (i32.const 388)) (i32.load (i32.const 928)))
        (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Octal literals are not allowed in strict mode")) (return)))
      (call $vm_emit_op (local.get $code) (i32.const 1))      ;; PUSH
      (if (i32.load (i32.const 304))  ;; BigInt literal (123n)
        (then (call $vm_emit_val (local.get $code) (call $mk_bigint (i64.load (i32.const 744)))))  ;; exact i64 from the lexer (mem 744), not via f64 (which loses bits past 2^53)
        (else (call $vm_emit_val (local.get $code) (call $num (call $tok_num)))))
      (call $next_token)
      ;; a numeric literal is not a valid AssignmentTarget: `1 = x` / `1 += x` is a SyntaxError.
      (if (call $is_assign_op (call $tok_kind))
        (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "invalid assignment target")) (return)))
      (return)))
  (if (i32.eq (call $tok_kind) (i32.const 53))  ;; template literal
    (then (call $vm_c_template (local.get $code)) (i32.store (i32.const 956) (i32.const 0)) (return)))  ;; a TemplateLiteral is not an assignment target
  (if (i32.eq (call $tok_kind) (i32.const 57))  ;; regex literal → new RegExp(pattern, flags)
    (then
      (let $rpat i32 (call $str_from_src (i32.add (call $src) (call $tok_start)) (call $tok_len)))
      (let $rflg i32 (call $str_from_src (i32.add (call $src) (i32.load (i32.const 264))) (i32.load (i32.const 268))))
      (call $next_token)
      (call $vm_emit_op (local.get $code) (i32.const 8)) (call $vm_emit_op (local.get $code) (cstring "RegExp"))  ;; LOADVAR RegExp
      (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_str (local.get $rpat)))
      (call $vm_emit_op (local.get $code) (i32.const 1)) (call $vm_emit_val (local.get $code) (call $mk_str (local.get $rflg)))
      (call $vm_emit_op (local.get $code) (i32.const 46)) (call $vm_emit_op (local.get $code) (i32.const 2))  ;; NEW 2
      (i32.store (i32.const 956) (i32.const 0))  ;; a RegularExpressionLiteral is not an assignment target
      (return)))
  (if (i32.eq (call $tok_kind) (i32.const 2))  ;; string literal
    (then
      ;; strict mode: a LegacyOctalEscapeSequence (`"\1"`, `"\07"`) or NonOctalDecimalEscapeSequence
      ;; (`"\8"`) is a SyntaxError (lexer flag at mem 928; read before next_token clobbers it).
      (if (i32.and (i32.load (i32.const 388)) (i32.load (i32.const 928)))
        (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Octal escape sequences are not allowed in strict mode")) (return)))
      ;; a malformed `\x`/`\u` escape (`"\xG"`, `"\u{}"`, `"\u{110000}"`) is ALWAYS a SyntaxError (both
      ;; modes); legacy octal is allowed here (allowlegacy=1) since sloppy strings permit it.
      (if (call $tmpl_bad_escape (i32.add (call $src) (call $tok_start)) (call $tok_len) (i32.const 1))
        (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Invalid hexadecimal or Unicode escape sequence")) (return)))
      (call $vm_emit_op (local.get $code) (i32.const 1))      ;; PUSH
      (call $vm_emit_val (local.get $code) (call $mk_str (call $decode_str (i32.add (call $src) (call $tok_start)) (call $tok_len))))
      (call $next_token)
      ;; a string literal is not a valid AssignmentTarget: `"x" = y` is a SyntaxError.
      (if (call $is_assign_op (call $tok_kind))
        (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "invalid assignment target")) (return)))
      (return)))
  (if (i32.eq (call $tok_kind) (i32.const 15))  ;; ( ... )  — grouping OR arrow params
    (then
      ;; lookahead: scan to the matching ')'; if it is followed by '=>', this is an arrow
      (let $parenstart i32 (call $tok_start))  ;; '(' offset (for a parenthesized arrow's source span)
      (let $pc i32 (call $cursor_save))
      (call $next_token)  ;; '('
      (let $pd i32 (i32.const 1))
      (block $pe (loop $pl
        (br_if $pe (i32.eq (call $tok_kind) (i32.const 0)))
        (if (i32.eq (call $tok_kind) (i32.const 15)) (then (set! $pd (i32.add (local.get $pd) (i32.const 1)))))
        (if (i32.eq (call $tok_kind) (i32.const 16)) (then (set! $pd (i32.sub (local.get $pd) (i32.const 1))) (br_if $pe (i32.eqz (local.get $pd)))))
        (call $next_token) (br $pl)))
      (call $next_token)  ;; consume the matching ')'
      (let $isarrow i32 (i32.eq (call $tok_kind) (i32.const 52)))  ;; '=>'
      (let $arrownl i32 (i32.and (local.get $isarrow) (call $nl_before)))  ;; ArrowParameters [no LineTerminator here] => : `(a)\n=> a` is a SyntaxError
      (call $cursor_restore (local.get $pc))
      (if (local.get $arrownl) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "No line break allowed before '=>'")) (return)))
      (if (local.get $isarrow)
        (then
          (if (local.get $heritnoarrow) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "class heritage may not be an arrow function")) (return)))
          (let $ap i32 (call $heap_alloc (i32.const 256)))
          (let $apd i32 (call $heap_alloc (i32.const 256)))
          (let $app i32 (call $heap_alloc (i32.const 256)))
          (let $anp i32 (call $vm_c_paramlist (local.get $ap) (local.get $apd) (local.get $app)))  ;; parses ( … ), restidx → reg 260
          (i32.store (i32.const 700) (i32.add (local.get $parenstart) (i32.const 1)))  ;; arrow source span starts at '('
          (call $vm_c_arrow (local.get $code) (local.get $ap) (local.get $anp) (local.get $apd) (i32.load (i32.const 260)) (local.get $app))
          (return)))
      (call $next_token)  ;; '(' — plain grouping
      (let $grpemit i32 (call $vm_emit_cursor))  ;; emit pos BEFORE the inner (for the (ident)=RHS rewind)
      (call $vm_c_commaexpr (local.get $code))
      (call $next_token)                                       ;; consume ')'
      ;; `( … ) = RHS`: a ParenthesizedExpression is a valid AssignmentTarget only when it
      ;; wraps a simple reference. `(a+b)=1` / `(f())=1` / `(this)=1` → SyntaxError. Re-scan the
      ;; inner ($pc still holds the '(' position; cursor is now at the assign-op) to classify it.
      (if (call $is_assign_op (call $tok_kind))
        (then
          (let $asc i32 (call $cursor_save))
