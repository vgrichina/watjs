;; compile a `delete` operand: evaluate the base, and turn the FINAL member
;; access into a DELETE (op 70). Non-final accesses compile as normal GETs.
(func $vm_c_delete_operand (param $code i32) (effects)
  ;; delete of a non-reference unary expression (void/typeof/delete/!/~/+/-/++/--) →
  ;; evaluate, discard the value, and return true (it is not a Reference).
