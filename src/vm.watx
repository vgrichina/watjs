    (if (i32.or (i32.eq (local.get $op) (i32.const 19)) (i32.or (i32.eq (local.get $op) (i32.const 21)) (i32.or (i32.eq (local.get $op) (i32.const 33)) (i32.eq (local.get $op) (i32.const 86)))))  ;; CALL / TAILCALL / CALLM / SUPERCALL
      (then
