        (i32.store (i32.add (local.get $ctx) (i32.const 12)) (local.get $sp))
        (i32.store (i32.add (local.get $ctx) (i32.const 20)) (local.get $scope))
        (i32.store (i32.add (local.get $ctx) (i32.const 24)) (local.get $frame))
        (i32.store (i32.add (local.get $ctx) (i32.const 32)) (local.get $handler))
        (i32.store (i32.add (local.get $ctx) (i32.const 36)) (i32.const 1))  ;; resume pushes the value (yield expression result)
        (i32.store (i32.add (local.get $ctx) (i32.const 40)) (i32.const 0))  ;; not a yield* suspend (a .throw/.return here throws/unwinds)
