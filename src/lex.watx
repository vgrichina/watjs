;; ═══════════════════════════════════════════════════════════════
;; lex.watx — tokenizer
;;
;; Produces one token at a time, advancing POS. State in registers:
;;   TOK_KIND (20), TOK_START (24), TOK_LEN (28), TOK_NUM (32:f64)
;;
;; Token kinds:
;;   0 EOF  1 NUM  2 STR  3 IDENT
;;   operators/punct: see constants below (each its own kind)
;; ═══════════════════════════════════════════════════════════════

;; --- token register accessors ---
(func $tok_kind (result i32) (effects) (i32.load (i32.const 20)))
(func $tok_start (result i32) (effects) (i32.load (i32.const 24)))
(func $tok_len (result i32) (effects) (i32.load (i32.const 28)))
(func $tok_num (result f64) (effects) (f64.load (i32.const 32)))
(func $set_tok (param $k i32) (param $s i32) (param $l i32) (effects)
  (i32.store (i32.const 20) (local.get $k))
  (i32.store (i32.const 24) (local.get $s))
  (i32.store (i32.const 28) (local.get $l)))
(func $pos (result i32) (effects) (i32.load (i32.const 12)))
(func $set_pos (param $p i32) (effects) (i32.store (i32.const 12) (local.get $p)))

(func $lex_init (effects) (call $set_pos (i32.const 0)))

;; --- cursor save/restore (for loops / function re-scan) ---
;; A cursor buffer is 24 bytes: POS, TOK_KIND, TOK_START, TOK_LEN (i32), TOK_NUM (f64@16).
(func $cursor_store (param $b i32) (effects)
  (i32.store (local.get $b) (call $pos))
  (i32.store (i32.add (local.get $b) (i32.const 4)) (call $tok_kind))
  (i32.store (i32.add (local.get $b) (i32.const 8)) (call $tok_start))
  (i32.store (i32.add (local.get $b) (i32.const 12)) (call $tok_len))
  (f64.store (i32.add (local.get $b) (i32.const 16)) (call $tok_num)))

;; heap-allocated save (persists across iterations; for loop cursors)
(func $cursor_save (result i32) (effects)
  (let $b i32 (call $heap_alloc (i32.const 24)))
  (call $cursor_store (local.get $b))
  (local.get $b))

;; transient single-token lookahead via a fixed buffer at address 64
(func $look_save (effects) (call $cursor_store (i32.const 64)))
(func $look_restore (effects) (call $cursor_restore (i32.const 64)))

(func $cursor_restore (param $b i32) (effects)
  (call $set_pos (i32.load (local.get $b)))
  (call $set_tok (i32.load (i32.add (local.get $b) (i32.const 4)))
                 (i32.load (i32.add (local.get $b) (i32.const 8)))
                 (i32.load (i32.add (local.get $b) (i32.const 12))))
  (f64.store (i32.const 32) (f64.load (i32.add (local.get $b) (i32.const 16)))))

;; byte at src+pos+offset, or -1 past end
(func $ch_at (param $off i32) (result i32) (effects)
  (let $i i32 (i32.add (call $pos) (local.get $off)))
  (if i32 (i32.ge_s (local.get $i) (call $src_len))
    (then (i32.const -1))
    (else (i32.load8_u (i32.add (call $src) (local.get $i))))))

(func $is_space (param $c i32) (result i32) (effects)
  (i32.or (i32.eq (local.get $c) (i32.const 32))   ;; space
    (i32.or (i32.eq (local.get $c) (i32.const 9))   ;; \t
      (i32.or (i32.eq (local.get $c) (i32.const 10))  ;; \n
        (i32.or (i32.eq (local.get $c) (i32.const 13))  ;; \r
          (i32.or (i32.eq (local.get $c) (i32.const 11))  ;; \v
                  (i32.eq (local.get $c) (i32.const 12))))))))  ;; \f

(func $is_digit (param $c i32) (result i32) (effects)
  (i32.and (i32.ge_s (local.get $c) (i32.const 48)) (i32.le_s (local.get $c) (i32.const 57))))

(func $is_alpha (param $c i32) (result i32) (effects)
  (i32.or
    (i32.and (i32.ge_s (local.get $c) (i32.const 65)) (i32.le_s (local.get $c) (i32.const 90)))   ;; A-Z
    (i32.or
      (i32.and (i32.ge_s (local.get $c) (i32.const 97)) (i32.le_s (local.get $c) (i32.const 122))) ;; a-z
      (i32.or (i32.eq (local.get $c) (i32.const 95))      ;; _
              (i32.eq (local.get $c) (i32.const 36))))))  ;; $

(func $is_alnum (param $c i32) (result i32) (effects)
  (i32.or (call $is_alpha (local.get $c)) (call $is_digit (local.get $c))))

;; Skip whitespace and // line / /* block comments.
(func $skip_trivia (effects)
  (block $done
    (loop $again
      (let $c i32 (call $ch_at (i32.const 0)))
      (if (call $is_space (local.get $c))
        (then (call $set_pos (i32.add (call $pos) (i32.const 1))) (br $again)))
      ;; multibyte Unicode whitespace: NBSP (C2 A0), LS/PS (E2 80 A8/A9), BOM (EF BB BF)
      (if (i32.and (i32.eq (local.get $c) (i32.const 194)) (i32.eq (call $ch_at (i32.const 1)) (i32.const 160)))
        (then (call $set_pos (i32.add (call $pos) (i32.const 2))) (br $again)))
      (if (i32.and (i32.eq (local.get $c) (i32.const 226))
            (i32.and (i32.eq (call $ch_at (i32.const 1)) (i32.const 128))
              (i32.or (i32.eq (call $ch_at (i32.const 2)) (i32.const 168)) (i32.eq (call $ch_at (i32.const 2)) (i32.const 169)))))
        (then (call $set_pos (i32.add (call $pos) (i32.const 3))) (br $again)))
      (if (i32.and (i32.eq (local.get $c) (i32.const 239))
            (i32.and (i32.eq (call $ch_at (i32.const 1)) (i32.const 187)) (i32.eq (call $ch_at (i32.const 2)) (i32.const 191))))
        (then (call $set_pos (i32.add (call $pos) (i32.const 3))) (br $again)))
      ;; // line comment
      (if (i32.and (i32.eq (local.get $c) (i32.const 47)) (i32.eq (call $ch_at (i32.const 1)) (i32.const 47)))
        (then
          (block $eol (loop $sl
            (let $d i32 (call $ch_at (i32.const 0)))
            (br_if $eol (i32.eq (local.get $d) (i32.const -1)))
            (br_if $eol (i32.eq (local.get $d) (i32.const 10)))
            (call $set_pos (i32.add (call $pos) (i32.const 1)))
            (br $sl)))
          (br $again)))
      ;; /* block comment */
      (if (i32.and (i32.eq (local.get $c) (i32.const 47)) (i32.eq (call $ch_at (i32.const 1)) (i32.const 42)))
        (then
          (call $set_pos (i32.add (call $pos) (i32.const 2)))
          (block $endc (loop $bl
            (let $d i32 (call $ch_at (i32.const 0)))
            (br_if $endc (i32.eq (local.get $d) (i32.const -1)))
            (if (i32.and (i32.eq (local.get $d) (i32.const 42)) (i32.eq (call $ch_at (i32.const 1)) (i32.const 47)))
              (then (call $set_pos (i32.add (call $pos) (i32.const 2))) (br $endc)))
            (call $set_pos (i32.add (call $pos) (i32.const 1)))
            (br $bl)))
          (br $again)))
      (br $done))))

;; Lex a number starting at POS. Sets TOK_KIND=1, TOK_NUM, advances POS.
(func $lex_number (effects)
  (let $start i32 (call $pos))
  (let $val f64 (f64.const 0))
  ;; hex / binary / octal literals: 0x.. 0b.. 0o..
  (if (i32.eq (call $ch_at (i32.const 0)) (i32.const 48))  ;; leading '0'
    (then
      (let $p1 i32 (call $ch_at (i32.const 1)))
      (if (i32.or (i32.eq (local.get $p1) (i32.const 120)) (i32.eq (local.get $p1) (i32.const 88)))  ;; x/X
        (then (call $lex_radix (i32.const 16)) (return)))
      (if (i32.or (i32.eq (local.get $p1) (i32.const 98)) (i32.eq (local.get $p1) (i32.const 66)))   ;; b/B
        (then (call $lex_radix (i32.const 2)) (return)))
      (if (i32.or (i32.eq (local.get $p1) (i32.const 111)) (i32.eq (local.get $p1) (i32.const 79)))  ;; o/O
        (then (call $lex_radix (i32.const 8)) (return)))))
  ;; accurate mantissa+exponent accumulation (matches $str_to_num): collect up
  ;; to 17 significant digits into an i64, tracking a decimal exponent, then
  ;; combine with one exact multiply/divide when in range.
  (let $mant i64 (i64.const 0))
  (let $nd i32 (i32.const 0))
  (let $exp i32 (i32.const 0))
  (let $dot i32 (i32.const 0))
  (block $ie (loop $il
    (let $c i32 (call $ch_at (i32.const 0)))
    (if (i32.eq (local.get $c) (i32.const 46))  ;; '.'
      (then
        (if (local.get $dot) (then (br $ie)))
        (set! $dot (i32.const 1)) (call $set_pos (i32.add (call $pos) (i32.const 1))) (br $il)))
    (if (i32.eq (local.get $c) (i32.const 95))  ;; '_' numeric separator → skip
      (then (call $set_pos (i32.add (call $pos) (i32.const 1))) (br $il)))
    (br_if $ie (i32.eqz (call $is_digit (local.get $c))))
    (if (i32.lt_s (local.get $nd) (i32.const 17))
      (then
        (set! $mant (i64.add (i64.mul (local.get $mant) (i64.const 10)) (i64.extend_i32_s (i32.sub (local.get $c) (i32.const 48)))))
        (set! $nd (i32.add (local.get $nd) (i32.const 1)))
        (if (local.get $dot) (then (set! $exp (i32.sub (local.get $exp) (i32.const 1))))))
      (else
        (if (i32.eqz (local.get $dot)) (then (set! $exp (i32.add (local.get $exp) (i32.const 1)))))))
    (call $set_pos (i32.add (call $pos) (i32.const 1)))
    (br $il)))
  ;; exponent
  (let $c0 i32 (call $ch_at (i32.const 0)))
  (if (i32.or (i32.eq (local.get $c0) (i32.const 101)) (i32.eq (local.get $c0) (i32.const 69)))  ;; e/E
    (then
      (call $set_pos (i32.add (call $pos) (i32.const 1)))
      (let $esign i32 (i32.const 1))
      (let $ec i32 (call $ch_at (i32.const 0)))
      (if (i32.eq (local.get $ec) (i32.const 43)) (then (call $set_pos (i32.add (call $pos) (i32.const 1)))))
      (if (i32.eq (local.get $ec) (i32.const 45)) (then (set! $esign (i32.const -1)) (call $set_pos (i32.add (call $pos) (i32.const 1)))))
      (let $en i32 (i32.const 0))
      (block $ee (loop $el
        (let $c i32 (call $ch_at (i32.const 0)))
        (br_if $ee (i32.eqz (call $is_digit (local.get $c))))
        (set! $en (i32.add (i32.mul (local.get $en) (i32.const 10)) (i32.sub (local.get $c) (i32.const 48))))
        (call $set_pos (i32.add (call $pos) (i32.const 1)))
        (br $el)))
      (set! $exp (i32.add (local.get $exp) (i32.mul (local.get $esign) (local.get $en))))))
  ;; combine
  (set! $val (f64.convert_i64_s (local.get $mant)))
  (if (i32.ne (local.get $exp) (i32.const 0))
    (then
      (if (i32.and (i32.le_s (local.get $nd) (i32.const 15)) (i32.and (i32.ge_s (local.get $exp) (i32.const -22)) (i32.le_s (local.get $exp) (i32.const 22))))
        (then
          (if (i32.gt_s (local.get $exp) (i32.const 0))
            (then (set! $val (f64.mul (local.get $val) (call $pow10 (f64.convert_i32_s (local.get $exp))))))
            (else (set! $val (f64.div (local.get $val) (call $pow10 (f64.convert_i32_s (i32.sub (i32.const 0) (local.get $exp)))))))))
        (else
          ;; out of exact range: step by *10 / /10 (keeps denormals representable)
          (let $k i32 (if i32 (i32.lt_s (local.get $exp) (i32.const 0)) (then (i32.sub (i32.const 0) (local.get $exp))) (else (local.get $exp))))
          (let $neg i32 (i32.lt_s (local.get $exp) (i32.const 0)))
          (let $ei i32 (i32.const 0))
          (block $xe (loop $xl
            (br_if $xe (i32.ge_s (local.get $ei) (local.get $k)))
            (set! $val (if f64 (local.get $neg) (then (f64.div (local.get $val) (f64.const 10))) (else (f64.mul (local.get $val) (f64.const 10)))))
            (set! $ei (i32.add (local.get $ei) (i32.const 1)))
            (br $xl)))))))
  (f64.store (i32.const 32) (local.get $val))
  ;; trailing 'n' → BigInt literal (flag at mem 304, read by the number-literal compiler)
  (if (i32.eq (call $ch_at (i32.const 0)) (i32.const 110))
    (then (i32.store (i32.const 304) (i32.const 1)) (call $set_pos (i32.add (call $pos) (i32.const 1))))
    (else (i32.store (i32.const 304) (i32.const 0))))
  (call $set_tok (i32.const 1) (local.get $start) (i32.sub (call $pos) (local.get $start))))

;; Lex a radix literal (16/8/2). Assumes cursor at the leading '0'; consumes
;; the prefix and digits, sets TOK_KIND=1, TOK_NUM.
(func $lex_radix (param $radix i32) (effects)
  (let $start i32 (call $pos))
  (call $set_pos (i32.add (call $pos) (i32.const 2)))  ;; skip 0x/0b/0o
  (let $val f64 (f64.const 0))
  (block $de (loop $dl
    (let $c i32 (call $ch_at (i32.const 0)))
    (let $d i32 (i32.const -1))
    (if (i32.and (i32.ge_s (local.get $c) (i32.const 48)) (i32.le_s (local.get $c) (i32.const 57)))
      (then (set! $d (i32.sub (local.get $c) (i32.const 48)))))                       ;; 0-9
    (if (i32.and (i32.ge_s (local.get $c) (i32.const 97)) (i32.le_s (local.get $c) (i32.const 102)))
      (then (set! $d (i32.add (i32.sub (local.get $c) (i32.const 97)) (i32.const 10)))))  ;; a-f
    (if (i32.and (i32.ge_s (local.get $c) (i32.const 65)) (i32.le_s (local.get $c) (i32.const 70)))
      (then (set! $d (i32.add (i32.sub (local.get $c) (i32.const 65)) (i32.const 10)))))  ;; A-F
    (br_if $de (i32.or (i32.lt_s (local.get $d) (i32.const 0)) (i32.ge_s (local.get $d) (local.get $radix))))
    (set! $val (f64.add (f64.mul (local.get $val) (f64.convert_i32_s (local.get $radix))) (f64.convert_i32_s (local.get $d))))
    (call $set_pos (i32.add (call $pos) (i32.const 1)))
    (br $dl)))
  (f64.store (i32.const 32) (local.get $val))
  (if (i32.eq (call $ch_at (i32.const 0)) (i32.const 110))  ;; 0xFFn etc.
    (then (i32.store (i32.const 304) (i32.const 1)) (call $set_pos (i32.add (call $pos) (i32.const 1))))
    (else (i32.store (i32.const 304) (i32.const 0))))
  (call $set_tok (i32.const 1) (local.get $start) (i32.sub (call $pos) (local.get $start))))

;; 10^e for integer-ish e (handles +/-), by repeated mult.
(func $pow10 (param $e f64) (result f64) (effects)
  (let $n i32 (i32.trunc_f64_s (call $abs64 (local.get $e))))
  (let $r f64 (f64.const 1))
  (let $i i32 (i32.const 0))
  (block $be (loop $bl
    (br_if $be (i32.ge_s (local.get $i) (local.get $n)))
    (set! $r (f64.mul (local.get $r) (f64.const 10)))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $bl)))
  (if f64 (f64.lt (local.get $e) (f64.const 0))
    (then (f64.div (f64.const 1) (local.get $r)))
    (else (local.get $r))))

(func $abs64 (param $x f64) (result f64) (effects) (f64.abs (local.get $x)))

;; Lex an identifier/keyword. Sets TOK_KIND=3, TOK_START, TOK_LEN.
(func $lex_ident (effects)
  (let $start i32 (call $pos))
  (block $ie (loop $il
    (br_if $ie (i32.eqz (call $is_alnum (call $ch_at (i32.const 0)))))
    (call $set_pos (i32.add (call $pos) (i32.const 1)))
    (br $il)))
  (call $set_tok (i32.const 3) (local.get $start) (i32.sub (call $pos) (local.get $start))))

;; Lex a string literal. TOK_KIND=2, TOK_START/TOK_LEN = raw content (no escapes yet).
(func $lex_string (param $quote i32) (effects)
  (call $set_pos (i32.add (call $pos) (i32.const 1)))  ;; skip opening quote
  (let $start i32 (call $pos))
  (block $se (loop $sl
    (let $c i32 (call $ch_at (i32.const 0)))
    (br_if $se (i32.eq (local.get $c) (i32.const -1)))
    (br_if $se (i32.eq (local.get $c) (local.get $quote)))
    ;; skip escaped char (so \" \\ etc. don't end the string)
    (if (i32.eq (local.get $c) (i32.const 92)) (then (call $set_pos (i32.add (call $pos) (i32.const 1)))))
    (call $set_pos (i32.add (call $pos) (i32.const 1)))
    (br $sl)))
  (call $set_tok (i32.const 2) (local.get $start) (i32.sub (call $pos) (local.get $start)))
  (call $set_pos (i32.add (call $pos) (i32.const 1))))  ;; skip closing quote

;; hex digit value, or -1
(func $hexval (param $c i32) (result i32) (effects)
  (if (i32.and (i32.ge_s (local.get $c) (i32.const 48)) (i32.le_s (local.get $c) (i32.const 57))) (then (return (i32.sub (local.get $c) (i32.const 48)))))
  (if (i32.and (i32.ge_s (local.get $c) (i32.const 97)) (i32.le_s (local.get $c) (i32.const 102))) (then (return (i32.add (i32.sub (local.get $c) (i32.const 97)) (i32.const 10)))))
  (if (i32.and (i32.ge_s (local.get $c) (i32.const 65)) (i32.le_s (local.get $c) (i32.const 70))) (then (return (i32.add (i32.sub (local.get $c) (i32.const 65)) (i32.const 10)))))
  (i32.const -1))

;; Decode a raw string-literal body [src,len) (between quotes) into a heap Str,
;; processing escapes: \n \t \r \b \f \v \0 \\ \" \' \` \/ \xHH \uHHHH.
(func $decode_str (param $src i32) (param $len i32) (result i32) (effects)
  (let $p i32 (call $str_alloc (local.get $len)))   ;; upper bound (escapes shrink)
  (let $i i32 (i32.const 0))
  (let $o i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $len)))
    (let $c i32 (i32.load8_u (i32.add (local.get $src) (local.get $i))))
    (if (i32.and (i32.eq (local.get $c) (i32.const 92)) (i32.lt_s (i32.add (local.get $i) (i32.const 1)) (local.get $len)))
      (then
        (set! $i (i32.add (local.get $i) (i32.const 1)))
        (let $n i32 (i32.load8_u (i32.add (local.get $src) (local.get $i))))
        (if (i32.eq (local.get $n) (i32.const 117))  ;; \uHHHH
          (then
            (let $cp i32 (i32.const 0))
            (let $j i32 (i32.const 0))
            (block $he (loop $hl
              (br_if $he (i32.ge_s (local.get $j) (i32.const 4)))
              (let $h i32 (call $hexval (i32.load8_u (i32.add (local.get $src) (i32.add (local.get $i) (i32.const 1))))))
              (br_if $he (i32.lt_s (local.get $h) (i32.const 0)))
              (set! $cp (i32.add (i32.mul (local.get $cp) (i32.const 16)) (local.get $h)))
              (set! $i (i32.add (local.get $i) (i32.const 1)))
              (set! $j (i32.add (local.get $j) (i32.const 1)))
              (br $hl)))
            (set! $o (call $utf8_emit (local.get $p) (local.get $o) (local.get $cp))))
          (else (if (i32.eq (local.get $n) (i32.const 120))  ;; \xHH
            (then
              (let $h1 i32 (call $hexval (i32.load8_u (i32.add (local.get $src) (i32.add (local.get $i) (i32.const 1))))))
              (let $h2 i32 (call $hexval (i32.load8_u (i32.add (local.get $src) (i32.add (local.get $i) (i32.const 2))))))
              (call $str_set_byte (local.get $p) (local.get $o) (i32.add (i32.mul (local.get $h1) (i32.const 16)) (local.get $h2)))
              (set! $o (i32.add (local.get $o) (i32.const 1)))
              (set! $i (i32.add (local.get $i) (i32.const 2))))
            (else
              (call $str_set_byte (local.get $p) (local.get $o) (call $esc_byte (local.get $n)))
              (set! $o (i32.add (local.get $o) (i32.const 1))))))))
      (else
        (call $str_set_byte (local.get $p) (local.get $o) (local.get $c))
        (set! $o (i32.add (local.get $o) (i32.const 1)))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (i32.store (local.get $p) (local.get $o))  ;; fix actual length
  (local.get $p))

;; single-char escape -> byte
(func $esc_byte (param $n i32) (result i32) (effects)
  (if (i32.eq (local.get $n) (i32.const 110)) (then (return (i32.const 10))))  ;; n
  (if (i32.eq (local.get $n) (i32.const 116)) (then (return (i32.const 9))))   ;; t
  (if (i32.eq (local.get $n) (i32.const 114)) (then (return (i32.const 13))))  ;; r
  (if (i32.eq (local.get $n) (i32.const 98))  (then (return (i32.const 8))))   ;; b
  (if (i32.eq (local.get $n) (i32.const 102)) (then (return (i32.const 12))))  ;; f
  (if (i32.eq (local.get $n) (i32.const 118)) (then (return (i32.const 11))))  ;; v
  (if (i32.eq (local.get $n) (i32.const 48))  (then (return (i32.const 0))))   ;; 0
  (local.get $n))  ;; \\ \" \' \` \/ and others → literal

;; emit codepoint as UTF-8 into Str p at offset o; returns new offset
(func $utf8_emit (param $p i32) (param $o i32) (param $cp i32) (result i32) (effects)
  (if (i32.lt_s (local.get $cp) (i32.const 128))
    (then (call $str_set_byte (local.get $p) (local.get $o) (local.get $cp)) (return (i32.add (local.get $o) (i32.const 1)))))
  (if (i32.lt_s (local.get $cp) (i32.const 2048))
    (then
      (call $str_set_byte (local.get $p) (local.get $o) (i32.or (i32.const 192) (i32.shr_u (local.get $cp) (i32.const 6))))
      (call $str_set_byte (local.get $p) (i32.add (local.get $o) (i32.const 1)) (i32.or (i32.const 128) (i32.and (local.get $cp) (i32.const 63))))
      (return (i32.add (local.get $o) (i32.const 2)))))
  (call $str_set_byte (local.get $p) (local.get $o) (i32.or (i32.const 224) (i32.shr_u (local.get $cp) (i32.const 12))))
  (call $str_set_byte (local.get $p) (i32.add (local.get $o) (i32.const 1)) (i32.or (i32.const 128) (i32.and (i32.shr_u (local.get $cp) (i32.const 6)) (i32.const 63))))
  (call $str_set_byte (local.get $p) (i32.add (local.get $o) (i32.const 2)) (i32.or (i32.const 128) (i32.and (local.get $cp) (i32.const 63))))
  (i32.add (local.get $o) (i32.const 3)))

;; Lex a template literal `...${..}...`. TOK_KIND=53, TOK_START/TOK_LEN = raw
;; content between backticks (including the ${...} parts; parsed later).
(func $lex_template (effects)
  (call $set_pos (i32.add (call $pos) (i32.const 1)))  ;; skip opening `
  (let $start i32 (call $pos))
  (block $se (loop $sl
    (let $c i32 (call $ch_at (i32.const 0)))
    (br_if $se (i32.eq (local.get $c) (i32.const -1)))
    (br_if $se (i32.eq (local.get $c) (i32.const 96)))  ;; closing `
    (if (i32.eq (local.get $c) (i32.const 92)) (then (call $set_pos (i32.add (call $pos) (i32.const 1)))))  ;; skip escaped
    (call $set_pos (i32.add (call $pos) (i32.const 1)))
    (br $sl)))
  (call $set_tok (i32.const 53) (local.get $start) (i32.sub (call $pos) (local.get $start)))
  (call $set_pos (i32.add (call $pos) (i32.const 1))))  ;; skip closing `

;; helper: emit a single/double-char operator token of kind $k spanning $n chars
(func $op_tok (param $k i32) (param $n i32) (effects)
  (call $set_tok (local.get $k) (call $pos) (local.get $n))
  (call $set_pos (i32.add (call $pos) (local.get $n))))

;; Is the previous token's identifier one after which `/` begins a regex?
(func $is_regex_kw (param $s i32) (param $l i32) (result i32) (effects)
  (let $w i32 (call $str_from_src (i32.add (call $src) (local.get $s)) (local.get $l)))
  (i32.or (call $str_eq (local.get $w) (cstring "return"))
  (i32.or (call $str_eq (local.get $w) (cstring "typeof"))
  (i32.or (call $str_eq (local.get $w) (cstring "instanceof"))
  (i32.or (call $str_eq (local.get $w) (cstring "in"))
  (i32.or (call $str_eq (local.get $w) (cstring "of"))
  (i32.or (call $str_eq (local.get $w) (cstring "new"))
  (i32.or (call $str_eq (local.get $w) (cstring "delete"))
  (i32.or (call $str_eq (local.get $w) (cstring "void"))
  (i32.or (call $str_eq (local.get $w) (cstring "do"))
  (i32.or (call $str_eq (local.get $w) (cstring "else"))
  (i32.or (call $str_eq (local.get $w) (cstring "yield"))
  (i32.or (call $str_eq (local.get $w) (cstring "await"))
  (i32.or (call $str_eq (local.get $w) (cstring "case"))
          (call $str_eq (local.get $w) (cstring "throw"))))))))))))))))

;; Can a '/' at the current position begin a regex literal? (true unless the
;; previous token produced a value.)
(func $regex_allowed (param $prevk i32) (param $prevs i32) (param $prevl i32) (result i32) (effects)
  (if i32 (i32.or (i32.eq (local.get $prevk) (i32.const 1)) (i32.or (i32.eq (local.get $prevk) (i32.const 2))
          (i32.or (i32.eq (local.get $prevk) (i32.const 16)) (i32.or (i32.eq (local.get $prevk) (i32.const 20))
          (i32.or (i32.eq (local.get $prevk) (i32.const 53)) (i32.eq (local.get $prevk) (i32.const 57)))))))
    (then (i32.const 0))
    (else (if i32 (i32.eq (local.get $prevk) (i32.const 3))
            (then (call $is_regex_kw (local.get $prevs) (local.get $prevl)))
            (else (i32.const 1))))))

;; Lex a regex literal /pattern/flags. Cursor at '/'. TOK_KIND=57, TOK_START/LEN
;; = pattern; flag range → regs 264/268.
(func $lex_regex (effects)
  (let $start i32 (call $pos))
  (call $set_pos (i32.add (local.get $start) (i32.const 1)))  ;; skip '/'
  (let $inclass i32 (i32.const 0))
  (block $e (loop $l
    (let $ch i32 (call $ch_at (i32.const 0)))
    (br_if $e (i32.eq (local.get $ch) (i32.const -1)))
    (if (i32.eq (local.get $ch) (i32.const 92)) (then (call $set_pos (i32.add (call $pos) (i32.const 2))) (br $l)))  ;; '\' escape
    (if (i32.eq (local.get $ch) (i32.const 91)) (then (set! $inclass (i32.const 1))))  ;; '['
    (if (i32.eq (local.get $ch) (i32.const 93)) (then (set! $inclass (i32.const 0))))  ;; ']'
    (if (i32.and (i32.eq (local.get $ch) (i32.const 47)) (i32.eqz (local.get $inclass))) (then (br $e)))  ;; unescaped '/'
    (call $set_pos (i32.add (call $pos) (i32.const 1)))
    (br $l)))
  (let $patlen i32 (i32.sub (call $pos) (i32.add (local.get $start) (i32.const 1))))
  (call $set_pos (i32.add (call $pos) (i32.const 1)))  ;; skip closing '/'
  (let $flagstart i32 (call $pos))
  (block $fe (loop $fl (br_if $fe (i32.eqz (call $is_alpha (call $ch_at (i32.const 0))))) (call $set_pos (i32.add (call $pos) (i32.const 1))) (br $fl)))
  (i32.store (i32.const 264) (local.get $flagstart))
  (i32.store (i32.const 268) (i32.sub (call $pos) (local.get $flagstart)))
  (call $set_tok (i32.const 57) (i32.add (local.get $start) (i32.const 1)) (local.get $patlen)))

;; Read the next token into the TOK_* registers.
(func $next_token (effects)
  (let $prevk i32 (call $tok_kind))
  (let $prevs i32 (call $tok_start))
  (let $prevl i32 (call $tok_len))
  (call $skip_trivia)
  (let $c i32 (call $ch_at (i32.const 0)))
  (let $c1 i32 (call $ch_at (i32.const 1)))
  (let $c2 i32 (call $ch_at (i32.const 2)))
  (if (i32.eq (local.get $c) (i32.const -1)) (then (call $set_tok (i32.const 0) (call $pos) (i32.const 0)) (return)))
  (if (call $is_digit (local.get $c)) (then (call $lex_number) (return)))
  (if (i32.and (i32.eq (local.get $c) (i32.const 46)) (call $is_digit (local.get $c1)))
    (then (call $lex_number) (return)))  ;; .5
  (if (call $is_alpha (local.get $c)) (then (call $lex_ident) (return)))
  (if (i32.or (i32.eq (local.get $c) (i32.const 34)) (i32.eq (local.get $c) (i32.const 39)))
    (then (call $lex_string (local.get $c)) (return)))  ;; " or '
  (if (i32.eq (local.get $c) (i32.const 96)) (then (call $lex_template) (return)))  ;; `template`

  ;; 3-char: === !== >>>
  (if (i32.and (i32.eq (local.get $c) (i32.const 61)) (i32.and (i32.eq (local.get $c1) (i32.const 61)) (i32.eq (local.get $c2) (i32.const 61))))
    (then (call $op_tok (i32.const 26) (i32.const 3)) (return)))
  (if (i32.and (i32.eq (local.get $c) (i32.const 33)) (i32.and (i32.eq (local.get $c1) (i32.const 61)) (i32.eq (local.get $c2) (i32.const 61))))
    (then (call $op_tok (i32.const 28) (i32.const 3)) (return)))
  (if (i32.and (i32.eq (local.get $c) (i32.const 62)) (i32.and (i32.eq (local.get $c1) (i32.const 62)) (i32.eq (local.get $c2) (i32.const 62))))
    (then (call $op_tok (i32.const 50) (i32.const 3)) (return)))  ;; >>>
  (if (i32.and (i32.eq (local.get $c) (i32.const 46)) (i32.and (i32.eq (local.get $c1) (i32.const 46)) (i32.eq (local.get $c2) (i32.const 46))))
    (then (call $op_tok (i32.const 54) (i32.const 3)) (return)))  ;; ... (spread/rest)

  ;; regex literal: '/' in expression position (before /= and / division)
  (if (i32.and (i32.eq (local.get $c) (i32.const 47)) (call $regex_allowed (local.get $prevk) (local.get $prevs) (local.get $prevl)))
    (then (call $lex_regex) (return)))

  ;; 3-char compound assignment: **= ||= &&= ??=  (checked before 2-char forms)
  (if (i32.and (i32.eq (local.get $c) (i32.const 42)) (i32.and (i32.eq (local.get $c1) (i32.const 42)) (i32.eq (call $ch_at (i32.const 2)) (i32.const 61))))
    (then (call $op_tok (i32.const 58) (i32.const 3)) (return)))  ;; **=
  (if (i32.and (i32.eq (local.get $c) (i32.const 124)) (i32.and (i32.eq (local.get $c1) (i32.const 124)) (i32.eq (call $ch_at (i32.const 2)) (i32.const 61))))
    (then (call $op_tok (i32.const 59) (i32.const 3)) (return)))  ;; ||=
  (if (i32.and (i32.eq (local.get $c) (i32.const 38)) (i32.and (i32.eq (local.get $c1) (i32.const 38)) (i32.eq (call $ch_at (i32.const 2)) (i32.const 61))))
    (then (call $op_tok (i32.const 60) (i32.const 3)) (return)))  ;; &&=
  (if (i32.and (i32.eq (local.get $c) (i32.const 63)) (i32.and (i32.eq (local.get $c1) (i32.const 63)) (i32.eq (call $ch_at (i32.const 2)) (i32.const 61))))
    (then (call $op_tok (i32.const 61) (i32.const 3)) (return)))  ;; ??=

  ;; 2-char: ++ -- += -= *= /= == != <= >= && ||
  (if (i32.and (i32.eq (local.get $c) (i32.const 43)) (i32.eq (local.get $c1) (i32.const 43)))
    (then (call $op_tok (i32.const 38) (i32.const 2)) (return)))  ;; ++
  (if (i32.and (i32.eq (local.get $c) (i32.const 45)) (i32.eq (local.get $c1) (i32.const 45)))
    (then (call $op_tok (i32.const 39) (i32.const 2)) (return)))  ;; --
  (if (i32.and (i32.eq (local.get $c) (i32.const 43)) (i32.eq (local.get $c1) (i32.const 61)))
    (then (call $op_tok (i32.const 40) (i32.const 2)) (return)))  ;; +=
  (if (i32.and (i32.eq (local.get $c) (i32.const 45)) (i32.eq (local.get $c1) (i32.const 61)))
    (then (call $op_tok (i32.const 41) (i32.const 2)) (return)))  ;; -=
  (if (i32.and (i32.eq (local.get $c) (i32.const 42)) (i32.eq (local.get $c1) (i32.const 42)))
    (then (call $op_tok (i32.const 51) (i32.const 2)) (return)))  ;; **
  (if (i32.and (i32.eq (local.get $c) (i32.const 42)) (i32.eq (local.get $c1) (i32.const 61)))
    (then (call $op_tok (i32.const 42) (i32.const 2)) (return)))  ;; *=
  (if (i32.and (i32.eq (local.get $c) (i32.const 47)) (i32.eq (local.get $c1) (i32.const 61)))
    (then (call $op_tok (i32.const 43) (i32.const 2)) (return)))  ;; /=
  (if (i32.and (i32.eq (local.get $c) (i32.const 61)) (i32.eq (local.get $c1) (i32.const 62)))
    (then (call $op_tok (i32.const 52) (i32.const 2)) (return)))  ;; =>
  (if (i32.and (i32.eq (local.get $c) (i32.const 61)) (i32.eq (local.get $c1) (i32.const 61)))
    (then (call $op_tok (i32.const 25) (i32.const 2)) (return)))
  (if (i32.and (i32.eq (local.get $c) (i32.const 33)) (i32.eq (local.get $c1) (i32.const 61)))
    (then (call $op_tok (i32.const 27) (i32.const 2)) (return)))
  (if (i32.and (i32.eq (local.get $c) (i32.const 60)) (i32.eq (local.get $c1) (i32.const 61)))
    (then (call $op_tok (i32.const 31) (i32.const 2)) (return)))
  (if (i32.and (i32.eq (local.get $c) (i32.const 62)) (i32.eq (local.get $c1) (i32.const 61)))
    (then (call $op_tok (i32.const 32) (i32.const 2)) (return)))
  (if (i32.and (i32.eq (local.get $c) (i32.const 38)) (i32.eq (local.get $c1) (i32.const 38)))
    (then (call $op_tok (i32.const 34) (i32.const 2)) (return)))
  (if (i32.and (i32.eq (local.get $c) (i32.const 124)) (i32.eq (local.get $c1) (i32.const 124)))
    (then (call $op_tok (i32.const 35) (i32.const 2)) (return)))
  (if (i32.and (i32.eq (local.get $c) (i32.const 60)) (i32.eq (local.get $c1) (i32.const 60)))
    (then (call $op_tok (i32.const 48) (i32.const 2)) (return)))  ;; <<
  (if (i32.and (i32.eq (local.get $c) (i32.const 62)) (i32.eq (local.get $c1) (i32.const 62)))
    (then (call $op_tok (i32.const 49) (i32.const 2)) (return)))  ;; >>

  ;; 1-char punctuation/operators
  (if (i32.eq (local.get $c) (i32.const 38)) (then (call $op_tok (i32.const 44) (i32.const 1)) (return)))   ;; &
  (if (i32.eq (local.get $c) (i32.const 124)) (then (call $op_tok (i32.const 45) (i32.const 1)) (return)))  ;; |
  (if (i32.eq (local.get $c) (i32.const 94)) (then (call $op_tok (i32.const 46) (i32.const 1)) (return)))   ;; ^
  (if (i32.eq (local.get $c) (i32.const 126)) (then (call $op_tok (i32.const 47) (i32.const 1)) (return)))  ;; ~
  (if (i32.eq (local.get $c) (i32.const 43)) (then (call $op_tok (i32.const 10) (i32.const 1)) (return)))
  (if (i32.eq (local.get $c) (i32.const 45)) (then (call $op_tok (i32.const 11) (i32.const 1)) (return)))
  (if (i32.eq (local.get $c) (i32.const 42)) (then (call $op_tok (i32.const 12) (i32.const 1)) (return)))
  (if (i32.eq (local.get $c) (i32.const 47)) (then (call $op_tok (i32.const 13) (i32.const 1)) (return)))
  (if (i32.eq (local.get $c) (i32.const 37)) (then (call $op_tok (i32.const 14) (i32.const 1)) (return)))
  (if (i32.eq (local.get $c) (i32.const 40)) (then (call $op_tok (i32.const 15) (i32.const 1)) (return)))
  (if (i32.eq (local.get $c) (i32.const 41)) (then (call $op_tok (i32.const 16) (i32.const 1)) (return)))
  (if (i32.eq (local.get $c) (i32.const 123)) (then (call $op_tok (i32.const 17) (i32.const 1)) (return)))
  (if (i32.eq (local.get $c) (i32.const 125)) (then (call $op_tok (i32.const 18) (i32.const 1)) (return)))
  (if (i32.eq (local.get $c) (i32.const 91)) (then (call $op_tok (i32.const 19) (i32.const 1)) (return)))
  (if (i32.eq (local.get $c) (i32.const 93)) (then (call $op_tok (i32.const 20) (i32.const 1)) (return)))
  (if (i32.eq (local.get $c) (i32.const 59)) (then (call $op_tok (i32.const 21) (i32.const 1)) (return)))
  (if (i32.eq (local.get $c) (i32.const 44)) (then (call $op_tok (i32.const 22) (i32.const 1)) (return)))
  (if (i32.eq (local.get $c) (i32.const 46)) (then (call $op_tok (i32.const 23) (i32.const 1)) (return)))
  (if (i32.eq (local.get $c) (i32.const 61)) (then (call $op_tok (i32.const 24) (i32.const 1)) (return)))
  (if (i32.eq (local.get $c) (i32.const 60)) (then (call $op_tok (i32.const 29) (i32.const 1)) (return)))
  (if (i32.eq (local.get $c) (i32.const 62)) (then (call $op_tok (i32.const 30) (i32.const 1)) (return)))
  (if (i32.eq (local.get $c) (i32.const 33)) (then (call $op_tok (i32.const 33) (i32.const 1)) (return)))
  (if (i32.and (i32.eq (local.get $c) (i32.const 63)) (i32.eq (local.get $c1) (i32.const 63)))
    (then (call $op_tok (i32.const 56) (i32.const 2)) (return)))  ;; ??
  (if (i32.and (i32.eq (local.get $c) (i32.const 63)) (i32.eq (local.get $c1) (i32.const 46)))
    (then (call $op_tok (i32.const 55) (i32.const 2)) (return)))  ;; ?.
  (if (i32.eq (local.get $c) (i32.const 63)) (then (call $op_tok (i32.const 36) (i32.const 1)) (return)))
  (if (i32.eq (local.get $c) (i32.const 58)) (then (call $op_tok (i32.const 37) (i32.const 1)) (return)))
  ;; unknown char — emit EOF to stop (parser will error)
  (call $set_tok (i32.const 0) (call $pos) (i32.const 0)))

;; Does the current IDENT token equal the given cstring?
(func $tok_is_kw (param $cstr i32) (result i32) (effects)
  (if i32 (i32.ne (call $tok_kind) (i32.const 3))
    (then (i32.const 0))
    (else
      (let $n i32 (call $str_len (local.get $cstr)))
      (if i32 (i32.ne (local.get $n) (call $tok_len))
        (then (i32.const 0))
        (else
          (let $i i32 (i32.const 0))
          (let $ok i32 (i32.const 1))
          (block $brk (loop $cont
            (br_if $brk (i32.ge_s (local.get $i) (local.get $n)))
            (if (i32.ne (i32.load8_u (i32.add (i32.add (call $src) (call $tok_start)) (local.get $i)))
                        (call $str_byte (local.get $cstr) (local.get $i)))
              (then (set! $ok (i32.const 0)) (br $brk)))
            (set! $i (i32.add (local.get $i) (i32.const 1)))
            (br $cont)))
          (local.get $ok))))))
