;; ═══════════════════════════════════════════════════════════════
;; lex.watx — tokenizer
;;
;; Produces one token at a time, advancing POS. State in registers:
;;   TOK_KIND (20), TOK_START (24), TOK_LEN (28), TOK_NUM (32:f64)
;;
;; Token kinds:
;;   0 EOF  1 NUM  2 STR  3 IDENT
;;   operators/punct: see constants below (each its own kind)
;; ═══════════════════════════════════════════════════════════════

;; --- token register accessors ---
(func $tok_kind (result i32) (effects) (i32.load (i32.const 20)))
(func $tok_start (result i32) (effects) (i32.load (i32.const 24)))
(func $tok_len (result i32) (effects) (i32.load (i32.const 28)))
(func $tok_num (result f64) (effects) (f64.load (i32.const 32)))
(func $set_tok (param $k i32) (param $s i32) (param $l i32) (effects)
  (i32.store (i32.const 20) (local.get $k))
  (i32.store (i32.const 24) (local.get $s))
  (i32.store (i32.const 28) (local.get $l)))
(func $pos (result i32) (effects) (i32.load (i32.const 12)))
(func $set_pos (param $p i32) (effects) (i32.store (i32.const 12) (local.get $p)))

(func $lex_init (effects) (call $set_pos (i32.const 0)))

;; HashbangComment: a `#!` at byte 0 of the source (Script grammar only) is a single-line comment.
;; Returns the byte offset just past the `#!…` line (the line terminator is left for the lexer's
;; whitespace skip), or 0 when the source does not begin with the LITERAL bytes `#!` — so a preceding
;; space/comment or an escaped `#`/`!` is NOT a hashbang and stays a SyntaxError.
(func $hashbang_len (result i32) (effects)
  (let $s i32 (i32.load (i32.const 4)))  ;; SRC base
  (let $n i32 (i32.load (i32.const 8)))  ;; SRC length
  (if (i32.lt_s (local.get $n) (i32.const 2)) (then (return (i32.const 0))))
  (if (i32.eqz (i32.and (i32.eq (i32.load8_u (local.get $s)) (i32.const 35)) (i32.eq (i32.load8_u (i32.add (local.get $s) (i32.const 1))) (i32.const 33)))) (then (return (i32.const 0))))
  (let $i i32 (i32.const 2))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    (let $c i32 (i32.load8_u (i32.add (local.get $s) (local.get $i))))
    (br_if $e (i32.or (i32.eq (local.get $c) (i32.const 10)) (i32.eq (local.get $c) (i32.const 13))))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
  (local.get $i))

;; --- cursor save/restore (for loops / function re-scan) ---
;; A cursor buffer is 40 bytes: POS, TOK_KIND, TOK_START, TOK_LEN (i32), TOK_NUM (f64@16),
;; BIGINT_FLAG (i32@24), BIGINT_VAL (i64@32). The bigint flag (mem 304) AND its exact value
;; (mem 744) are per-token derived state read at EMIT time — without saving BOTH, a lookahead
;; that re-lexes a later `123n` leaves them set, so e.g. f(0, 99n) mis-types arg0 as a BigInt,
;; and `f(1n < 2n)` emits both operands as the last-lexed value (→ 2n<2n=false).
(func $cursor_store (param $b i32) (effects)
  (i32.store (local.get $b) (call $pos))
  (i32.store (i32.add (local.get $b) (i32.const 4)) (call $tok_kind))
  (i32.store (i32.add (local.get $b) (i32.const 8)) (call $tok_start))
  (i32.store (i32.add (local.get $b) (i32.const 12)) (call $tok_len))
  (f64.store (i32.add (local.get $b) (i32.const 16)) (call $tok_num))
  (i32.store (i32.add (local.get $b) (i32.const 24)) (i32.load (i32.const 304)))
  (i32.store (i32.add (local.get $b) (i32.const 28)) (i32.load (i32.const 928)))  ;; legacy-octal / non-octal-decimal flag
  (i64.store (i32.add (local.get $b) (i32.const 32)) (i64.load (i32.const 744))))

;; heap-allocated save (persists across iterations; for loop cursors)
(func $cursor_save (result i32) (effects)
  (let $b i32 (call $heap_alloc (i32.const 40)))
  (call $cursor_store (local.get $b))
  (local.get $b))

;; transient single-token lookahead via a fixed buffer at address 64
(func $look_save (effects) (call $cursor_store (i32.const 64)))
(func $look_restore (effects) (call $cursor_restore (i32.const 64)))

(func $cursor_restore (param $b i32) (effects)
  (call $set_pos (i32.load (local.get $b)))
  (call $set_tok (i32.load (i32.add (local.get $b) (i32.const 4)))
                 (i32.load (i32.add (local.get $b) (i32.const 8)))
                 (i32.load (i32.add (local.get $b) (i32.const 12))))
  (f64.store (i32.const 32) (f64.load (i32.add (local.get $b) (i32.const 16))))
  (i32.store (i32.const 304) (i32.load (i32.add (local.get $b) (i32.const 24))))
  (i32.store (i32.const 928) (i32.load (i32.add (local.get $b) (i32.const 28))))  ;; legacy-octal / non-octal-decimal flag
  (i64.store (i32.const 744) (i64.load (i32.add (local.get $b) (i32.const 32)))))

;; byte at src+pos+offset, or -1 past end
(func $ch_at (param $off i32) (result i32) (effects)
  (let $i i32 (i32.add (call $pos) (local.get $off)))
  (if i32 (i32.ge_s (local.get $i) (call $src_len))
    (then (i32.const -1))
    (else (i32.load8_u (i32.add (call $src) (local.get $i))))))

(func $is_space (param $c i32) (result i32) (effects)
  (i32.or (i32.eq (local.get $c) (i32.const 32))   ;; space
    (i32.or (i32.eq (local.get $c) (i32.const 9))   ;; \t
      (i32.or (i32.eq (local.get $c) (i32.const 10))  ;; \n
        (i32.or (i32.eq (local.get $c) (i32.const 13))  ;; \r
          (i32.or (i32.eq (local.get $c) (i32.const 11))  ;; \v
                  (i32.eq (local.get $c) (i32.const 12))))))))  ;; \f

(func $is_digit (param $c i32) (result i32) (effects)
  (i32.and (i32.ge_s (local.get $c) (i32.const 48)) (i32.le_s (local.get $c) (i32.const 57))))

(func $is_alpha (param $c i32) (result i32) (effects)
  (i32.or
    (i32.and (i32.ge_s (local.get $c) (i32.const 65)) (i32.le_s (local.get $c) (i32.const 90)))   ;; A-Z
    (i32.or
      (i32.and (i32.ge_s (local.get $c) (i32.const 97)) (i32.le_s (local.get $c) (i32.const 122))) ;; a-z
      (i32.or (i32.eq (local.get $c) (i32.const 95))      ;; _
              (i32.eq (local.get $c) (i32.const 36))))))  ;; $

(func $is_alnum (param $c i32) (result i32) (effects)
  (i32.or (call $is_alpha (local.get $c)) (call $is_digit (local.get $c))))

;; byte length (2 or 3) of a multibyte Unicode WhiteSpace / LineTerminator at the current position,
;; else 0. Covers NBSP U+00A0, U+1680, U+2000-200A/2028/2029/202F/205F, U+3000, BOM U+FEFF. Used both
;; to skip trivia AND to STOP an identifier scan (these share UTF-8 lead bytes with ident chars like ℘).
(func $uni_ws_len (result i32) (effects)
  (let $c i32 (call $ch_at (i32.const 0)))
  (let $c1 i32 (call $ch_at (i32.const 1)))
  (let $c2 i32 (call $ch_at (i32.const 2)))
  (if (i32.and (i32.eq (local.get $c) (i32.const 194)) (i32.eq (local.get $c1) (i32.const 160))) (then (return (i32.const 2))))  ;; C2 A0
  (if (i32.and (i32.eq (local.get $c) (i32.const 225)) (i32.and (i32.eq (local.get $c1) (i32.const 154)) (i32.eq (local.get $c2) (i32.const 128)))) (then (return (i32.const 3))))  ;; E1 9A 80  U+1680
  (if (i32.and (i32.eq (local.get $c) (i32.const 226)) (i32.eq (local.get $c1) (i32.const 128)))
    (then (if (i32.or (i32.and (i32.ge_s (local.get $c2) (i32.const 128)) (i32.le_s (local.get $c2) (i32.const 138))) (i32.or (i32.eq (local.get $c2) (i32.const 168)) (i32.or (i32.eq (local.get $c2) (i32.const 169)) (i32.eq (local.get $c2) (i32.const 175))))) (then (return (i32.const 3))))))  ;; E2 80 80..8A/A8/A9/AF
  (if (i32.and (i32.eq (local.get $c) (i32.const 226)) (i32.and (i32.eq (local.get $c1) (i32.const 129)) (i32.eq (local.get $c2) (i32.const 159)))) (then (return (i32.const 3))))  ;; E2 81 9F  U+205F
  (if (i32.and (i32.eq (local.get $c) (i32.const 227)) (i32.and (i32.eq (local.get $c1) (i32.const 128)) (i32.eq (local.get $c2) (i32.const 128)))) (then (return (i32.const 3))))  ;; E3 80 80  U+3000
  (if (i32.and (i32.eq (local.get $c) (i32.const 239)) (i32.and (i32.eq (local.get $c1) (i32.const 187)) (i32.eq (local.get $c2) (i32.const 191)))) (then (return (i32.const 3))))  ;; EF BB BF  BOM
  (i32.const 0))

;; Skip whitespace and // line / /* block comments.
(func $skip_trivia (effects)
  ;; track whether the current position is at the start of a line (only whitespace / comments / a
  ;; LineTerminator precede it since the last token). Governs the Annex B `-->` HTMLCloseComment: `-->` is
  ;; a single-line comment only at line start. At input start (pos 0) the first line counts as line-start.
  (let $ls i32 (i32.eqz (call $pos)))
  (block $done
    (loop $again
      (let $c i32 (call $ch_at (i32.const 0)))
      (if (call $is_space (local.get $c))
        (then (if (i32.or (i32.eq (local.get $c) (i32.const 10)) (i32.eq (local.get $c) (i32.const 13))) (then (set! $ls (i32.const 1))))  ;; \n /\r → line start
              (call $set_pos (i32.add (call $pos) (i32.const 1))) (br $again)))
      ;; multibyte Unicode whitespace / LineTerminator (NBSP, U+1680, U+2000-200A/2028/2029/202F/205F,
      ;; U+3000, BOM) — one helper covers them all
      (let $wl i32 (call $uni_ws_len))
      (if (i32.gt_s (local.get $wl) (i32.const 0))
        (then
          ;; U+2028 LINE SEPARATOR / U+2029 PARAGRAPH SEPARATOR (E2 80 A8/A9) are LineTerminators → line start
          (if (i32.and (i32.eq (local.get $c) (i32.const 226)) (i32.and (i32.eq (call $ch_at (i32.const 1)) (i32.const 128)) (i32.or (i32.eq (call $ch_at (i32.const 2)) (i32.const 168)) (i32.eq (call $ch_at (i32.const 2)) (i32.const 169)))))
            (then (set! $ls (i32.const 1))))
          (call $set_pos (i32.add (call $pos) (local.get $wl))) (br $again)))
      ;; Annex B B.1.3 `<!--` SingleLineHTMLOpenComment — always a comment-to-end-of-line.
      (if (i32.and (i32.and (i32.eq (local.get $c) (i32.const 60)) (i32.eq (call $ch_at (i32.const 1)) (i32.const 33)))
            (i32.and (i32.eq (call $ch_at (i32.const 2)) (i32.const 45)) (i32.eq (call $ch_at (i32.const 3)) (i32.const 45))))
        (then
          (block $he (loop $hl
            (let $d i32 (call $ch_at (i32.const 0)))
            (br_if $he (i32.eq (local.get $d) (i32.const -1)))
            (br_if $he (i32.or (i32.eq (local.get $d) (i32.const 10)) (i32.eq (local.get $d) (i32.const 13))))
            (call $set_pos (i32.add (call $pos) (i32.const 1))) (br $hl)))
          (br $again)))
      ;; Annex B B.1.3 `-->` SingleLineHTMLCloseComment — a comment-to-end-of-line only at line start.
      (if (i32.and (local.get $ls) (i32.and (i32.and (i32.eq (local.get $c) (i32.const 45)) (i32.eq (call $ch_at (i32.const 1)) (i32.const 45))) (i32.eq (call $ch_at (i32.const 2)) (i32.const 62))))
        (then
          (block $ce2 (loop $cl2
            (let $d i32 (call $ch_at (i32.const 0)))
            (br_if $ce2 (i32.eq (local.get $d) (i32.const -1)))
            (br_if $ce2 (i32.or (i32.eq (local.get $d) (i32.const 10)) (i32.eq (local.get $d) (i32.const 13))))
            (call $set_pos (i32.add (call $pos) (i32.const 1))) (br $cl2)))
          (br $again)))
      ;; // line comment
      (if (i32.and (i32.eq (local.get $c) (i32.const 47)) (i32.eq (call $ch_at (i32.const 1)) (i32.const 47)))
        (then
          (block $eol (loop $sl
            (let $d i32 (call $ch_at (i32.const 0)))
            (br_if $eol (i32.eq (local.get $d) (i32.const -1)))
            (br_if $eol (i32.eq (local.get $d) (i32.const 10)))
            (call $set_pos (i32.add (call $pos) (i32.const 1)))
            (br $sl)))
          (br $again)))
      ;; /* block comment */
      (if (i32.and (i32.eq (local.get $c) (i32.const 47)) (i32.eq (call $ch_at (i32.const 1)) (i32.const 42)))
        (then
          (call $set_pos (i32.add (call $pos) (i32.const 2)))
          (block $endc (loop $bl
            (let $d i32 (call $ch_at (i32.const 0)))
            (br_if $endc (i32.eq (local.get $d) (i32.const -1)))
            (if (i32.and (i32.eq (local.get $d) (i32.const 42)) (i32.eq (call $ch_at (i32.const 1)) (i32.const 47)))
              (then (call $set_pos (i32.add (call $pos) (i32.const 2))) (br $endc)))
            ;; a MultiLineComment that contains a LineTerminator keeps the following `-->` at line-start
            (if (i32.or (i32.eq (local.get $d) (i32.const 10)) (i32.eq (local.get $d) (i32.const 13))) (then (set! $ls (i32.const 1))))
            (call $set_pos (i32.add (call $pos) (i32.const 1)))
            (br $bl)))
          (br $again)))
      (br $done))))

;; Lex a number starting at POS. Sets TOK_KIND=1, TOK_NUM, advances POS.
;; Early Error: a NumericLiteral may not be immediately followed by an IdentifierStart or a DecimalDigit
;; (`3abc`, `0b12`, `0x1g`, `1n2`). Throw when the char right after the literal starts an identifier/digit.
(func $num_boundary_check (effects)
  (let $c i32 (call $ch_at (i32.const 0)))
  (if (i32.or (call $is_digit (local.get $c)) (i32.or (call $is_alpha (local.get $c))
        (i32.and (i32.ge_s (local.get $c) (i32.const 128)) (i32.eqz (call $uni_ws_len)))))
    (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Identifier directly after numeric literal")))))

(func $lex_number (effects)
  (let $start i32 (call $pos))
  (i32.store (i32.const 928) (i32.const 0))  ;; clear the legacy-octal / non-octal-decimal flag (set below only for `0`+digit)
  (let $val f64 (f64.const 0))
  ;; hex / binary / octal literals: 0x.. 0b.. 0o..
  (if (i32.eq (call $ch_at (i32.const 0)) (i32.const 48))  ;; leading '0'
    (then
      (let $p1 i32 (call $ch_at (i32.const 1)))
      (if (i32.or (i32.eq (local.get $p1) (i32.const 120)) (i32.eq (local.get $p1) (i32.const 88)))  ;; x/X
        (then (call $lex_radix (i32.const 16)) (return)))
      (if (i32.or (i32.eq (local.get $p1) (i32.const 98)) (i32.eq (local.get $p1) (i32.const 66)))   ;; b/B
        (then (call $lex_radix (i32.const 2)) (return)))
      (if (i32.or (i32.eq (local.get $p1) (i32.const 111)) (i32.eq (local.get $p1) (i32.const 79)))  ;; o/O
        (then (call $lex_radix (i32.const 8)) (return)))
      ;; Annex B: `0` immediately followed by a decimal digit is a LegacyOctalIntegerLiteral (all digits
      ;; 0-7 → octal value) or a NonOctalDecimalIntegerLiteral (contains 8/9 → decimal value). Both are
      ;; sloppy-only — flag them (mem 928) so the number-literal compiler rejects them in strict mode.
      (if (call $is_digit (local.get $p1))
        (then
          ;; scan the leading digit run to decide octal vs non-octal-decimal (any 8/9 or a following '.'/'e' → decimal)
          (let $q i32 (i32.const 1)) (let $alloct i32 (i32.const 1))
          (block $se (loop $sl
            (let $dc i32 (call $ch_at (local.get $q)))
            (br_if $se (i32.eqz (call $is_digit (local.get $dc))))
            (if (i32.gt_s (local.get $dc) (i32.const 55)) (then (set! $alloct (i32.const 0))))  ;; '8' or '9'
            (set! $q (i32.add (local.get $q) (i32.const 1))) (br $sl)))
          (let $after i32 (call $ch_at (local.get $q)))
          (if (i32.or (i32.eq (local.get $after) (i32.const 46)) (i32.or (i32.eq (local.get $after) (i32.const 101)) (i32.eq (local.get $after) (i32.const 69))))
            (then (set! $alloct (i32.const 0))))  ;; a '.'/'e'/'E' tail → not a pure octal integer → decimal value
          (i32.store (i32.const 928) (i32.const 1))  ;; legacy form (strict-rejected)
          (if (local.get $alloct)
            (then  ;; pure LegacyOctalIntegerLiteral → accumulate base-8 value
              (call $set_pos (i32.add (call $pos) (i32.const 1)))  ;; skip leading '0'
              (let $ov i64 (i64.const 0))
              (block $oe (loop $ol
                (let $oc i32 (call $ch_at (i32.const 0)))
                (br_if $oe (i32.eqz (call $is_digit (local.get $oc))))
                (set! $ov (i64.add (i64.mul (local.get $ov) (i64.const 8)) (i64.extend_i32_s (i32.sub (local.get $oc) (i32.const 48)))))
                (call $set_pos (i32.add (call $pos) (i32.const 1))) (br $ol)))
              (f64.store (i32.const 32) (f64.convert_i64_s (local.get $ov)))
              (i64.store (i32.const 744) (local.get $ov))
              (i32.store (i32.const 304) (i32.const 0))  ;; not a BigInt literal
              (call $set_tok (i32.const 1) (local.get $start) (i32.sub (call $pos) (local.get $start)))
              (call $num_boundary_check)
              (return)))))))
  ;; accurate mantissa+exponent accumulation (matches $str_to_num): collect up
  ;; to 17 significant digits into an i64, tracking a decimal exponent, then
  ;; combine with one exact multiply/divide when in range.
  (let $mant i64 (i64.const 0))
  (let $ival i64 (i64.const 0))  ;; exact integer accumulation for a BigInt literal (no f64 precision loss)
  (let $nd i32 (i32.const 0))
  (let $exp i32 (i32.const 0))
  (let $dot i32 (i32.const 0))
  (block $ie (loop $il
    (let $c i32 (call $ch_at (i32.const 0)))
    (if (i32.eq (local.get $c) (i32.const 46))  ;; '.'
      (then
        (if (local.get $dot) (then (br $ie)))
        (set! $dot (i32.const 1)) (call $set_pos (i32.add (call $pos) (i32.const 1))) (br $il)))
    (if (i32.eq (local.get $c) (i32.const 95))  ;; '_' numeric separator: valid ONLY strictly between two digits
      (then
        ;; error if: prev is not a digit (leading/double/after-'.') OR next is not a digit (trailing/before-'.'/'e')
        ;; OR the literal is a legacy octal/nonoctal form (`08_1`) OR it directly follows a leading `0` (`0_7`).
        (if (i32.or (i32.eqz (call $is_digit (call $ch_at (i32.const -1))))
              (i32.or (i32.eqz (call $is_digit (call $ch_at (i32.const 1))))
                (i32.or (i32.load (i32.const 928))
                  (i32.and (i32.eq (call $pos) (i32.add (local.get $start) (i32.const 1))) (i32.eq (call $ch_at (i32.const -1)) (i32.const 48))))))
          (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Numeric separators are not allowed here")) (return)))
        (call $set_pos (i32.add (call $pos) (i32.const 1))) (br $il)))
    (br_if $ie (i32.eqz (call $is_digit (local.get $c))))
    (if (i32.eqz (local.get $dot))  ;; integer digits → exact i64 (BigInt path); saturate at i64-max to match BigInt(str)'s f64_sat
      (then
        (if (i64.gt_u (local.get $ival) (i64.div_u (i64.sub (i64.const 9223372036854775807) (i64.extend_i32_s (i32.sub (local.get $c) (i32.const 48)))) (i64.const 10)))
          (then (set! $ival (i64.const 9223372036854775807)))
          (else (set! $ival (i64.add (i64.mul (local.get $ival) (i64.const 10)) (i64.extend_i32_s (i32.sub (local.get $c) (i32.const 48)))))))))
    (if (i32.lt_s (local.get $nd) (i32.const 17))
      (then
        (set! $mant (i64.add (i64.mul (local.get $mant) (i64.const 10)) (i64.extend_i32_s (i32.sub (local.get $c) (i32.const 48)))))
        (set! $nd (i32.add (local.get $nd) (i32.const 1)))
        (if (local.get $dot) (then (set! $exp (i32.sub (local.get $exp) (i32.const 1))))))
      (else
        (if (i32.eqz (local.get $dot)) (then (set! $exp (i32.add (local.get $exp) (i32.const 1)))))))
    (call $set_pos (i32.add (call $pos) (i32.const 1)))
    (br $il)))
  ;; exponent
  (let $c0 i32 (call $ch_at (i32.const 0)))
  (if (i32.or (i32.eq (local.get $c0) (i32.const 101)) (i32.eq (local.get $c0) (i32.const 69)))  ;; e/E
    (then
      (call $set_pos (i32.add (call $pos) (i32.const 1)))
      (let $esign i32 (i32.const 1))
      (let $ec i32 (call $ch_at (i32.const 0)))
      (if (i32.eq (local.get $ec) (i32.const 43)) (then (call $set_pos (i32.add (call $pos) (i32.const 1)))))
      (if (i32.eq (local.get $ec) (i32.const 45)) (then (set! $esign (i32.const -1)) (call $set_pos (i32.add (call $pos) (i32.const 1)))))
      (let $en i32 (i32.const 0))
      (let $endig i32 (i32.const 0))  ;; exponent digit count (0 → `1e`/`1e+` empty exponent = SyntaxError)
      (block $ee (loop $el
        (let $c i32 (call $ch_at (i32.const 0)))
        (if (i32.eq (local.get $c) (i32.const 95))  ;; '_' numeric separator in the exponent: only between two digits
          (then
            (if (i32.or (i32.eqz (call $is_digit (call $ch_at (i32.const -1)))) (i32.eqz (call $is_digit (call $ch_at (i32.const 1)))))
              (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Numeric separators are not allowed here")) (return)))
            (call $set_pos (i32.add (call $pos) (i32.const 1))) (br $el)))
        (br_if $ee (i32.eqz (call $is_digit (local.get $c))))
        (set! $endig (i32.add (local.get $endig) (i32.const 1)))
        (set! $en (i32.add (i32.mul (local.get $en) (i32.const 10)) (i32.sub (local.get $c) (i32.const 48))))
        (call $set_pos (i32.add (call $pos) (i32.const 1)))
        (br $el)))
      (if (i32.eqz (local.get $endig)) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Missing exponent digits in numeric literal")) (return)))  ;; `1e`, `1e+`
      (set! $exp (i32.add (local.get $exp) (i32.mul (local.get $esign) (local.get $en))))))
  ;; combine
  (set! $val (f64.convert_i64_s (local.get $mant)))
  (if (i32.ne (local.get $exp) (i32.const 0))
    (then
      (if (i32.and (i32.le_s (local.get $nd) (i32.const 15)) (i32.and (i32.ge_s (local.get $exp) (i32.const -22)) (i32.le_s (local.get $exp) (i32.const 22))))
        (then
          (if (i32.gt_s (local.get $exp) (i32.const 0))
            (then (set! $val (f64.mul (local.get $val) (call $pow10 (f64.convert_i32_s (local.get $exp))))))
            (else (set! $val (f64.div (local.get $val) (call $pow10 (f64.convert_i32_s (i32.sub (i32.const 0) (local.get $exp)))))))))
        (else
          ;; out of exact range: step by *10 / /10 (keeps denormals representable)
          (let $k i32 (if i32 (i32.lt_s (local.get $exp) (i32.const 0)) (then (i32.sub (i32.const 0) (local.get $exp))) (else (local.get $exp))))
          (let $neg i32 (i32.lt_s (local.get $exp) (i32.const 0)))
          (let $ei i32 (i32.const 0))
          (block $xe (loop $xl
            (br_if $xe (i32.ge_s (local.get $ei) (local.get $k)))
            (set! $val (if f64 (local.get $neg) (then (f64.div (local.get $val) (f64.const 10))) (else (f64.mul (local.get $val) (f64.const 10)))))
            (set! $ei (i32.add (local.get $ei) (i32.const 1)))
            (br $xl)))))))
  (f64.store (i32.const 32) (local.get $val))
  (i64.store (i32.const 744) (local.get $ival))  ;; exact integer value for the BigInt-literal path
  ;; trailing 'n' → BigInt literal (flag at mem 304, read by the number-literal compiler)
  (if (i32.eq (call $ch_at (i32.const 0)) (i32.const 110))
    (then
      ;; a BigInt literal is an integer — a '.' ($dot) or exponent ($c0 == e/E) before 'n' is a SyntaxError
      ;; (`1.5n`, `1e5n`, `.5n`).
      (if (i32.or (local.get $dot) (i32.or (i32.eq (local.get $c0) (i32.const 101)) (i32.eq (local.get $c0) (i32.const 69))))
        (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Invalid BigInt literal (no decimal point or exponent allowed)")) (return)))
      (i32.store (i32.const 304) (i32.const 1)) (call $set_pos (i32.add (call $pos) (i32.const 1))))
    (else (i32.store (i32.const 304) (i32.const 0))))
  (call $set_tok (i32.const 1) (local.get $start) (i32.sub (call $pos) (local.get $start)))
  (call $num_boundary_check))

;; Lex a radix literal (16/8/2). Assumes cursor at the leading '0'; consumes
;; the prefix and digits, sets TOK_KIND=1, TOK_NUM.
(func $lex_radix (param $radix i32) (effects)
  (let $start i32 (call $pos))
  (call $set_pos (i32.add (call $pos) (i32.const 2)))  ;; skip 0x/0b/0o
  (let $val f64 (f64.const 0))
  (let $ival i64 (i64.const 0))  ;; exact integer accumulation for a BigInt literal (no f64 precision loss)
  (let $ndig i32 (i32.const 0))  ;; radix-digit count (0 → `0x`/`0b`/`0o` with no digits = SyntaxError)
  (let $prevus i32 (i32.const 0))  ;; previous char was a '_' numeric separator
  (block $de (loop $dl
    (let $c i32 (call $ch_at (i32.const 0)))
    (if (i32.eq (local.get $c) (i32.const 95))  ;; '_' numeric separator: must sit between two digits
      (then
        (if (i32.or (i32.eqz (local.get $ndig)) (local.get $prevus))  ;; `0x_`/`__` → invalid separator
          (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Numeric separator '_' is not allowed here")) (return)))
        (set! $prevus (i32.const 1)) (call $set_pos (i32.add (call $pos) (i32.const 1))) (br $dl)))
    (let $d i32 (i32.const -1))
    (if (i32.and (i32.ge_s (local.get $c) (i32.const 48)) (i32.le_s (local.get $c) (i32.const 57)))
      (then (set! $d (i32.sub (local.get $c) (i32.const 48)))))                       ;; 0-9
    (if (i32.and (i32.ge_s (local.get $c) (i32.const 97)) (i32.le_s (local.get $c) (i32.const 102)))
      (then (set! $d (i32.add (i32.sub (local.get $c) (i32.const 97)) (i32.const 10)))))  ;; a-f
    (if (i32.and (i32.ge_s (local.get $c) (i32.const 65)) (i32.le_s (local.get $c) (i32.const 70)))
      (then (set! $d (i32.add (i32.sub (local.get $c) (i32.const 65)) (i32.const 10)))))  ;; A-F
    (br_if $de (i32.or (i32.lt_s (local.get $d) (i32.const 0)) (i32.ge_s (local.get $d) (local.get $radix))))
    (set! $ndig (i32.add (local.get $ndig) (i32.const 1))) (set! $prevus (i32.const 0))
    (set! $val (f64.add (f64.mul (local.get $val) (f64.convert_i32_s (local.get $radix))) (f64.convert_i32_s (local.get $d))))
    (if (i64.gt_u (local.get $ival) (i64.div_u (i64.sub (i64.const 9223372036854775807) (i64.extend_i32_s (local.get $d))) (i64.extend_i32_s (local.get $radix))))
      (then (set! $ival (i64.const 9223372036854775807)))
      (else (set! $ival (i64.add (i64.mul (local.get $ival) (i64.extend_i32_s (local.get $radix))) (i64.extend_i32_s (local.get $d))))))
    (call $set_pos (i32.add (call $pos) (i32.const 1)))
    (br $dl)))
  (if (local.get $prevus) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Numeric separator '_' is not allowed at the end")) (return)))  ;; `0x1_`
  (if (i32.eqz (local.get $ndig)) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Missing digits after '0x'/'0b'/'0o' prefix")) (return)))  ;; `0x`/`0b`/`0o`
  (f64.store (i32.const 32) (local.get $val))
  (i64.store (i32.const 744) (local.get $ival))  ;; exact integer value for the BigInt-literal path
  (if (i32.eq (call $ch_at (i32.const 0)) (i32.const 110))  ;; 0xFFn etc.
    (then (i32.store (i32.const 304) (i32.const 1)) (call $set_pos (i32.add (call $pos) (i32.const 1))))
    (else (i32.store (i32.const 304) (i32.const 0))))
  (call $set_tok (i32.const 1) (local.get $start) (i32.sub (call $pos) (local.get $start)))
  (call $num_boundary_check))

;; 10^e for integer-ish e (handles +/-), by repeated mult.
(func $pow10 (param $e f64) (result f64) (effects)
  (let $n i32 (i32.trunc_f64_s (call $abs64 (local.get $e))))
  (let $r f64 (f64.const 1))
  (let $i i32 (i32.const 0))
  (block $be (loop $bl
    (br_if $be (i32.ge_s (local.get $i) (local.get $n)))
    (set! $r (f64.mul (local.get $r) (f64.const 10)))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $bl)))
  (if f64 (f64.lt (local.get $e) (f64.const 0))
    (then (f64.div (f64.const 1) (local.get $r)))
    (else (local.get $r))))

(func $abs64 (param $x f64) (result f64) (effects) (f64.abs (local.get $x)))

;; Lex an identifier/keyword. Sets TOK_KIND=3, TOK_START, TOK_LEN.
(func $lex_ident (effects)
  (let $start i32 (call $pos))
  (if (i32.eq (call $ch_at (i32.const 0)) (i32.const 35)) (then (call $set_pos (i32.add (call $pos) (i32.const 1)))))  ;; private name #x → include the '#'
  (block $ie (loop $il
    ;; a \uHHHH or \u{H+} unicode escape is part of the identifier (IdentifierName)
    (if (i32.and (i32.eq (call $ch_at (i32.const 0)) (i32.const 92)) (i32.eq (call $ch_at (i32.const 1)) (i32.const 117)))
      (then
        (call $set_pos (i32.add (call $pos) (i32.const 2)))  ;; skip "\u"
        (let $idcp i32 (i32.const -1))  ;; decoded codepoint (for identifier-validity check)
        (if (i32.eq (call $ch_at (i32.const 0)) (i32.const 123))  ;; \u{ … }
          (then
            (set! $idcp (i32.const 0))
            (block $ce (loop $cl
              (br_if $ce (i32.eq (call $ch_at (i32.const 0)) (i32.const -1)))
              (br_if $ce (i32.eq (call $ch_at (i32.const 0)) (i32.const 125)))  ;; '}'
              (set! $idcp (i32.add (i32.mul (local.get $idcp) (i32.const 16)) (call $hexval (call $ch_at (i32.const 0)))))
              (call $set_pos (i32.add (call $pos) (i32.const 1))) (br $cl)))
            (call $set_pos (i32.add (call $pos) (i32.const 1))))  ;; skip '}'
          (else
            (set! $idcp (i32.add (i32.add (i32.mul (call $hexval (call $ch_at (i32.const 0))) (i32.const 4096)) (i32.mul (call $hexval (call $ch_at (i32.const 1))) (i32.const 256)))
                                 (i32.add (i32.mul (call $hexval (call $ch_at (i32.const 2))) (i32.const 16)) (call $hexval (call $ch_at (i32.const 3))))))
            (call $set_pos (i32.add (call $pos) (i32.const 4)))))  ;; 4 hex digits
        ;; an IdentifierName unicode escape must decode to a valid identifier character. An ASCII escape
        ;; that isn't [A-Za-z0-9_$] (e.g. `#` = '#', which cannot spell the PrivateName '#' token) is
        ;; a SyntaxError. (Non-ASCII validity needs Unicode ID tables — accepted here as before.)
        (if (i32.and (i32.ge_s (local.get $idcp) (i32.const 0)) (i32.lt_s (local.get $idcp) (i32.const 128)))
          (then (if (i32.eqz (i32.or (call $is_alnum (local.get $idcp)) (i32.or (i32.eq (local.get $idcp) (i32.const 95)) (i32.eq (local.get $idcp) (i32.const 36)))))
            (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Invalid Unicode escape in identifier")) (return)))))
        (br $il)))
    (let $ic i32 (call $ch_at (i32.const 0)))
    ;; identifier-continue: ASCII alnum, OR any non-ASCII UTF-8 byte that isn't Unicode whitespace/LT
    (br_if $ie (i32.eqz (i32.or (call $is_alnum (local.get $ic)) (i32.and (i32.ge_s (local.get $ic) (i32.const 128)) (i32.eqz (call $uni_ws_len))))))
    (call $set_pos (i32.add (call $pos) (i32.const 1)))
    (br $il)))
  (call $set_tok (i32.const 3) (local.get $start) (i32.sub (call $pos) (local.get $start))))

;; Lex a string literal. TOK_KIND=2, TOK_START/TOK_LEN = raw content (no escapes yet).
(func $lex_string (param $quote i32) (effects)
  (call $set_pos (i32.add (call $pos) (i32.const 1)))  ;; skip opening quote
  (let $start i32 (call $pos))
  (i32.store (i32.const 928) (i32.const 0))  ;; clear the legacy-octal-escape flag (set below if a \octal / \8 / \9 escape appears)
  (block $se (loop $sl
    (let $c i32 (call $ch_at (i32.const 0)))
    (br_if $se (i32.eq (local.get $c) (i32.const -1)))
    (br_if $se (i32.eq (local.get $c) (local.get $quote)))
    ;; skip escaped char (so \" \\ etc. don't end the string)
    (if (i32.eq (local.get $c) (i32.const 92))
      (then
        ;; LegacyOctalEscapeSequence (\1-\7, or \0 followed by a digit) / NonOctalDecimalEscapeSequence
        ;; (\8, \9) — allowed in sloppy strings, a SyntaxError in strict (flagged at mem 928).
        (let $e i32 (call $ch_at (i32.const 1)))
        (if (i32.or (i32.and (i32.ge_s (local.get $e) (i32.const 49)) (i32.le_s (local.get $e) (i32.const 55)))  ;; '1'..'7'
              (i32.or (i32.and (i32.ge_s (local.get $e) (i32.const 56)) (i32.le_s (local.get $e) (i32.const 57)))  ;; '8' '9'
                (i32.and (i32.eq (local.get $e) (i32.const 48)) (call $is_digit (call $ch_at (i32.const 2))))))  ;; '0' + digit
          (then (i32.store (i32.const 928) (i32.const 1))))
        (call $set_pos (i32.add (call $pos) (i32.const 1)))))
    (call $set_pos (i32.add (call $pos) (i32.const 1)))
    (br $sl)))
  (call $set_tok (i32.const 2) (local.get $start) (i32.sub (call $pos) (local.get $start)))
  (call $set_pos (i32.add (call $pos) (i32.const 1))))  ;; skip closing quote

;; hex digit value, or -1
(func $hexval (param $c i32) (result i32) (effects)
  (if (i32.and (i32.ge_s (local.get $c) (i32.const 48)) (i32.le_s (local.get $c) (i32.const 57))) (then (return (i32.sub (local.get $c) (i32.const 48)))))
  (if (i32.and (i32.ge_s (local.get $c) (i32.const 97)) (i32.le_s (local.get $c) (i32.const 102))) (then (return (i32.add (i32.sub (local.get $c) (i32.const 97)) (i32.const 10)))))
  (if (i32.and (i32.ge_s (local.get $c) (i32.const 65)) (i32.le_s (local.get $c) (i32.const 70))) (then (return (i32.add (i32.sub (local.get $c) (i32.const 65)) (i32.const 10)))))
  (i32.const -1))

;; digit value for radix 2..36: 0-9 → 0..9, A-Z/a-z → 10..35, else -1.
(func $digit36 (param $c i32) (result i32) (effects)
  (if (i32.and (i32.ge_s (local.get $c) (i32.const 48)) (i32.le_s (local.get $c) (i32.const 57))) (then (return (i32.sub (local.get $c) (i32.const 48)))))
  (if (i32.and (i32.ge_s (local.get $c) (i32.const 97)) (i32.le_s (local.get $c) (i32.const 122))) (then (return (i32.add (i32.sub (local.get $c) (i32.const 97)) (i32.const 10)))))
  (if (i32.and (i32.ge_s (local.get $c) (i32.const 65)) (i32.le_s (local.get $c) (i32.const 90))) (then (return (i32.add (i32.sub (local.get $c) (i32.const 65)) (i32.const 10)))))
  (i32.const -1))

;; Decode a raw string-literal body [src,len) (between quotes) into a heap Str,
;; processing escapes: \n \t \r \b \f \v \0 \\ \" \' \` \/ \xHH \uHHHH.
(func $decode_str (param $src i32) (param $len i32) (result i32) (effects)
  (let $p i32 (call $str_alloc (local.get $len)))   ;; upper bound (escapes shrink)
  (let $i i32 (i32.const 0))
  (let $o i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $len)))
    (let $c i32 (i32.load8_u (i32.add (local.get $src) (local.get $i))))
    (if (i32.and (i32.eq (local.get $c) (i32.const 92)) (i32.lt_s (i32.add (local.get $i) (i32.const 1)) (local.get $len)))
      (then
        (set! $i (i32.add (local.get $i) (i32.const 1)))
        (let $n i32 (i32.load8_u (i32.add (local.get $src) (local.get $i))))
        ;; LineContinuation: `\` followed by a LineTerminator produces nothing.
        ;; LF, CR (and CRLF: consume the trailing LF), and U+2028/U+2029 (E2 80 A8/A9).
        (if (i32.eq (local.get $n) (i32.const 10))  ;; \ LF
          (then (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
        (if (i32.eq (local.get $n) (i32.const 13))  ;; \ CR  (or CRLF)
          (then
            (if (i32.and (i32.lt_s (i32.add (local.get $i) (i32.const 1)) (local.get $len))
                         (i32.eq (i32.load8_u (i32.add (local.get $src) (i32.add (local.get $i) (i32.const 1)))) (i32.const 10)))
              (then (set! $i (i32.add (local.get $i) (i32.const 1)))))  ;; eat LF of CRLF
            (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
        (if (i32.and (i32.eq (local.get $n) (i32.const 226))  ;; \ U+2028 / U+2029  (E2 80 A8/A9)
                     (i32.and (i32.eq (i32.load8_u (i32.add (local.get $src) (i32.add (local.get $i) (i32.const 1)))) (i32.const 128))
                              (i32.or (i32.eq (i32.load8_u (i32.add (local.get $src) (i32.add (local.get $i) (i32.const 2)))) (i32.const 168))
                                      (i32.eq (i32.load8_u (i32.add (local.get $src) (i32.add (local.get $i) (i32.const 2)))) (i32.const 169)))))
          (then (set! $i (i32.add (local.get $i) (i32.const 3))) (br $l)))
        (if (i32.eq (local.get $n) (i32.const 117))  ;; \uHHHH  or  \u{H+}
          (then
            (let $cp i32 (i32.const 0))
            (if (i32.eq (i32.load8_u (i32.add (local.get $src) (i32.add (local.get $i) (i32.const 1)))) (i32.const 123))  ;; \u{ … }
              (then
                (set! $i (i32.add (local.get $i) (i32.const 1)))  ;; advance onto '{'
                (block $ce (loop $cl
                  (let $hc i32 (call $hexval (i32.load8_u (i32.add (local.get $src) (i32.add (local.get $i) (i32.const 1))))))
                  (br_if $ce (i32.lt_s (local.get $hc) (i32.const 0)))  ;; non-hex (the '}') ends it
                  (set! $cp (i32.add (i32.mul (local.get $cp) (i32.const 16)) (local.get $hc)))
                  (set! $i (i32.add (local.get $i) (i32.const 1)))
                  (br $cl)))
                (set! $i (i32.add (local.get $i) (i32.const 1))))  ;; advance onto '}'
              (else
                (let $j i32 (i32.const 0))
                (block $he (loop $hl
                  (br_if $he (i32.ge_s (local.get $j) (i32.const 4)))
                  (let $h i32 (call $hexval (i32.load8_u (i32.add (local.get $src) (i32.add (local.get $i) (i32.const 1))))))
                  (br_if $he (i32.lt_s (local.get $h) (i32.const 0)))
                  (set! $cp (i32.add (i32.mul (local.get $cp) (i32.const 16)) (local.get $h)))
                  (set! $i (i32.add (local.get $i) (i32.const 1)))
                  (set! $j (i32.add (local.get $j) (i32.const 1)))
                  (br $hl)))))
            (set! $o (call $utf8_emit (local.get $p) (local.get $o) (local.get $cp))))
          (else (if (i32.eq (local.get $n) (i32.const 120))  ;; \xHH
            (then
              (let $h1 i32 (call $hexval (i32.load8_u (i32.add (local.get $src) (i32.add (local.get $i) (i32.const 1))))))
              (let $h2 i32 (call $hexval (i32.load8_u (i32.add (local.get $src) (i32.add (local.get $i) (i32.const 2))))))
              ;; \xHH is the code point U+00HH — emit as UTF-8 (C2 A0 for \xA0, not a lone 0xA0)
              ;; so chars >= 0x80 are valid UTF-8 (trim/charCodeAt/compare see them correctly), matching \u.
              (set! $o (call $utf8_emit (local.get $p) (local.get $o) (i32.add (i32.mul (local.get $h1) (i32.const 16)) (local.get $h2))))
              (set! $i (i32.add (local.get $i) (i32.const 2))))
            (else (if (i32.and (i32.ge_s (local.get $n) (i32.const 48)) (i32.le_s (local.get $n) (i32.const 55)))  ;; \octal (0-7): LegacyOctalEscapeSequence (sloppy; strict rejects earlier)
              (then
                ;; value = 1-3 octal digits, capped at 255: a leading 0-3 allows 2 more digits, 4-7 allows 1 more.
                (let $ov i32 (i32.sub (local.get $n) (i32.const 48)))
                (let $maxmore i32 (if i32 (i32.le_s (local.get $ov) (i32.const 3)) (then (i32.const 2)) (else (i32.const 1))))
                (let $km i32 (i32.const 0))
                (block $oe2 (loop $ol2
                  (br_if $oe2 (i32.ge_s (local.get $km) (local.get $maxmore)))
                  (br_if $oe2 (i32.ge_s (i32.add (local.get $i) (i32.const 1)) (local.get $len)))
                  (let $nc i32 (i32.load8_u (i32.add (local.get $src) (i32.add (local.get $i) (i32.const 1)))))
                  (br_if $oe2 (i32.or (i32.lt_s (local.get $nc) (i32.const 48)) (i32.gt_s (local.get $nc) (i32.const 55))))
                  (set! $ov (i32.add (i32.mul (local.get $ov) (i32.const 8)) (i32.sub (local.get $nc) (i32.const 48))))
                  (set! $i (i32.add (local.get $i) (i32.const 1)))
                  (set! $km (i32.add (local.get $km) (i32.const 1)))
                  (br $ol2)))
                (set! $o (call $utf8_emit (local.get $p) (local.get $o) (local.get $ov))))
              (else
                (call $str_set_byte (local.get $p) (local.get $o) (call $esc_byte (local.get $n)))
                (set! $o (i32.add (local.get $o) (i32.const 1))))))))))
      (else
        (call $str_set_byte (local.get $p) (local.get $o) (local.get $c))
        (set! $o (i32.add (local.get $o) (i32.const 1)))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (i32.store (local.get $p) (local.get $o))  ;; fix actual length
  (local.get $p))

;; single-char escape -> byte
(func $esc_byte (param $n i32) (result i32) (effects)
  (if (i32.eq (local.get $n) (i32.const 110)) (then (return (i32.const 10))))  ;; n
  (if (i32.eq (local.get $n) (i32.const 116)) (then (return (i32.const 9))))   ;; t
  (if (i32.eq (local.get $n) (i32.const 114)) (then (return (i32.const 13))))  ;; r
  (if (i32.eq (local.get $n) (i32.const 98))  (then (return (i32.const 8))))   ;; b
  (if (i32.eq (local.get $n) (i32.const 102)) (then (return (i32.const 12))))  ;; f
  (if (i32.eq (local.get $n) (i32.const 118)) (then (return (i32.const 11))))  ;; v
  (if (i32.eq (local.get $n) (i32.const 48))  (then (return (i32.const 0))))   ;; 0
  (local.get $n))  ;; \\ \" \' \` \/ and others → literal

;; emit codepoint as UTF-8 into Str p at offset o; returns new offset
(func $utf8_emit (param $p i32) (param $o i32) (param $cp i32) (result i32) (effects)
  (if (i32.lt_s (local.get $cp) (i32.const 128))
    (then (call $str_set_byte (local.get $p) (local.get $o) (local.get $cp)) (return (i32.add (local.get $o) (i32.const 1)))))
  (if (i32.lt_s (local.get $cp) (i32.const 2048))
    (then
      (call $str_set_byte (local.get $p) (local.get $o) (i32.or (i32.const 192) (i32.shr_u (local.get $cp) (i32.const 6))))
      (call $str_set_byte (local.get $p) (i32.add (local.get $o) (i32.const 1)) (i32.or (i32.const 128) (i32.and (local.get $cp) (i32.const 63))))
      (return (i32.add (local.get $o) (i32.const 2)))))
  (call $str_set_byte (local.get $p) (local.get $o) (i32.or (i32.const 224) (i32.shr_u (local.get $cp) (i32.const 12))))
  (call $str_set_byte (local.get $p) (i32.add (local.get $o) (i32.const 1)) (i32.or (i32.const 128) (i32.and (i32.shr_u (local.get $cp) (i32.const 6)) (i32.const 63))))
  (call $str_set_byte (local.get $p) (i32.add (local.get $o) (i32.const 2)) (i32.or (i32.const 128) (i32.and (local.get $cp) (i32.const 63))))
  (i32.add (local.get $o) (i32.const 3)))

;; skip a ${ ... } substitution (pos is just after the `${`); advance past the
;; matching `}`, correctly tracking nested braces, strings, and nested templates.
(func $skip_template_expr (effects)
  (let $bd i32 (i32.const 1))
  (let $prev i32 (i32.const 0))  ;; last significant char (0=start); decides `/` regex-vs-division
  (block $e (loop $l
    (let $c i32 (call $ch_at (i32.const 0)))
    (br_if $e (i32.eq (local.get $c) (i32.const -1)))
    (if (i32.eq (local.get $c) (i32.const 123)) (then (set! $bd (i32.add (local.get $bd) (i32.const 1))) (call $set_pos (i32.add (call $pos) (i32.const 1))) (set! $prev (i32.const 123)) (br $l)))  ;; {
    (if (i32.eq (local.get $c) (i32.const 125))  ;; }
      (then
        (set! $bd (i32.sub (local.get $bd) (i32.const 1)))
        (call $set_pos (i32.add (call $pos) (i32.const 1)))
        (if (i32.eqz (local.get $bd)) (then (br $e)))
        (set! $prev (i32.const 125))
        (br $l)))
    (if (i32.eq (local.get $c) (i32.const 96)) (then (call $set_pos (i32.add (call $pos) (i32.const 1))) (call $skip_template) (set! $prev (i32.const 41)) (br $l)))  ;; nested template (value)
    (if (i32.or (i32.eq (local.get $c) (i32.const 34)) (i32.eq (local.get $c) (i32.const 39)))  ;; "string" / 'string'
      (then
        (let $q i32 (local.get $c))
        (call $set_pos (i32.add (call $pos) (i32.const 1)))
        (block $qe (loop $ql
          (let $sc i32 (call $ch_at (i32.const 0)))
          (br_if $qe (i32.eq (local.get $sc) (i32.const -1)))
          (br_if $qe (i32.eq (local.get $sc) (local.get $q)))
          (if (i32.eq (local.get $sc) (i32.const 92)) (then (call $set_pos (i32.add (call $pos) (i32.const 1)))))
          (call $set_pos (i32.add (call $pos) (i32.const 1))) (br $ql)))
        (call $set_pos (i32.add (call $pos) (i32.const 1)))  ;; closing quote
        (set! $prev (i32.const 41))  ;; a string is a value → following `/` is division
        (br $l)))
    (if (i32.eq (local.get $c) (i32.const 47))  ;; '/'  — comment, regex literal, or division
      (then
        (let $c1 i32 (call $ch_at (i32.const 1)))
        (if (i32.eq (local.get $c1) (i32.const 47))  ;; // line comment
          (then
            (block $lce (loop $lcl
              (let $lc i32 (call $ch_at (i32.const 0)))
              (br_if $lce (i32.or (i32.eq (local.get $lc) (i32.const -1)) (i32.or (i32.eq (local.get $lc) (i32.const 10)) (i32.eq (local.get $lc) (i32.const 13)))))
              (call $set_pos (i32.add (call $pos) (i32.const 1))) (br $lcl)))
            (br $l)))
        (if (i32.eq (local.get $c1) (i32.const 42))  ;; /* block comment */
          (then
            (call $set_pos (i32.add (call $pos) (i32.const 2)))
            (block $bce (loop $bcl
              (let $bc i32 (call $ch_at (i32.const 0)))
              (br_if $bce (i32.eq (local.get $bc) (i32.const -1)))
              (if (i32.and (i32.eq (local.get $bc) (i32.const 42)) (i32.eq (call $ch_at (i32.const 1)) (i32.const 47))) (then (call $set_pos (i32.add (call $pos) (i32.const 2))) (br $bce)))
              (call $set_pos (i32.add (call $pos) (i32.const 1))) (br $bcl)))
            (br $l)))
        ;; regex vs division: regex UNLESS the previous significant char can end an expression
        ;; (alnum / _ / $ / ) / ] ). A regex literal may contain quotes/braces that must NOT be
        ;; treated as string/brace tokens — skip it as a unit (respecting [char classes] and \escapes).
        (if (i32.eqz (i32.or (call $is_alnum (local.get $prev))
                       (i32.or (i32.eq (local.get $prev) (i32.const 41)) (i32.eq (local.get $prev) (i32.const 93)))))  ;; ) ]
          (then  ;; regex literal
            (call $set_pos (i32.add (call $pos) (i32.const 1)))  ;; past '/'
            (let $incls i32 (i32.const 0))
            (block $rxe (loop $rxl
              (let $rc i32 (call $ch_at (i32.const 0)))
              (br_if $rxe (i32.eq (local.get $rc) (i32.const -1)))
              (if (i32.eq (local.get $rc) (i32.const 92)) (then (call $set_pos (i32.add (call $pos) (i32.const 2))) (br $rxl)))  ;; \escape → skip 2
              (if (i32.eq (local.get $rc) (i32.const 91)) (then (set! $incls (i32.const 1))))  ;; [
              (if (i32.eq (local.get $rc) (i32.const 93)) (then (set! $incls (i32.const 0))))  ;; ]
              (if (i32.and (i32.eq (local.get $rc) (i32.const 47)) (i32.eqz (local.get $incls))) (then (call $set_pos (i32.add (call $pos) (i32.const 1))) (br $rxe)))  ;; closing /
              (call $set_pos (i32.add (call $pos) (i32.const 1))) (br $rxl)))
            (block $rfe (loop $rfl (br_if $rfe (i32.eqz (call $is_alpha (call $ch_at (i32.const 0))))) (call $set_pos (i32.add (call $pos) (i32.const 1))) (br $rfl)))  ;; flags
            (set! $prev (i32.const 41))  ;; regex is a value
            (br $l))
          (else (call $set_pos (i32.add (call $pos) (i32.const 1))) (set! $prev (i32.const 47)) (br $l)))))  ;; division
    ;; any other char: advance; track it as the previous significant char if not whitespace
    (if (i32.eqz (i32.or (i32.eq (local.get $c) (i32.const 32)) (i32.or (i32.eq (local.get $c) (i32.const 9)) (i32.or (i32.eq (local.get $c) (i32.const 10)) (i32.eq (local.get $c) (i32.const 13))))))
      (then (set! $prev (local.get $c))))
    (call $set_pos (i32.add (call $pos) (i32.const 1)))
    (br $l))))

;; skip a template body: pos is just after the opening `; advance past the closing `
(func $skip_template (effects)
  (block $se (loop $sl
    (let $c i32 (call $ch_at (i32.const 0)))
    (br_if $se (i32.eq (local.get $c) (i32.const -1)))
    (if (i32.eq (local.get $c) (i32.const 96)) (then (call $set_pos (i32.add (call $pos) (i32.const 1))) (br $se)))  ;; closing `
    (if (i32.eq (local.get $c) (i32.const 92)) (then (call $set_pos (i32.add (call $pos) (i32.const 2))) (br $sl)))  ;; escape: skip 2
    (if (i32.and (i32.eq (local.get $c) (i32.const 36)) (i32.eq (call $ch_at (i32.const 1)) (i32.const 123)))  ;; ${
      (then (call $set_pos (i32.add (call $pos) (i32.const 2))) (call $skip_template_expr) (br $sl)))
    (call $set_pos (i32.add (call $pos) (i32.const 1)))
    (br $sl))))

;; Lex a template literal `...${..}...`. TOK_KIND=53, TOK_START/TOK_LEN = raw
;; content between backticks (including the ${...} parts; parsed later).
(func $lex_template (effects)
  (call $set_pos (i32.add (call $pos) (i32.const 1)))  ;; skip opening `
  (let $start i32 (call $pos))
  (block $se (loop $sl
    (let $c i32 (call $ch_at (i32.const 0)))
    (br_if $se (i32.eq (local.get $c) (i32.const -1)))
    (br_if $se (i32.eq (local.get $c) (i32.const 96)))  ;; closing `
    (if (i32.eq (local.get $c) (i32.const 92)) (then (call $set_pos (i32.add (call $pos) (i32.const 2))) (br $sl)))  ;; skip escaped (\ + next)
    (if (i32.and (i32.eq (local.get $c) (i32.const 36)) (i32.eq (call $ch_at (i32.const 1)) (i32.const 123)))  ;; ${ → skip the whole substitution (handles nested templates/braces/strings)
      (then (call $set_pos (i32.add (call $pos) (i32.const 2))) (call $skip_template_expr) (br $sl)))
    (call $set_pos (i32.add (call $pos) (i32.const 1)))
    (br $sl)))
  ;; the loop ended on the closing '`' (96) or ran off the end — an unterminated template (`` `abc ``,
  ;; `` `${1} `` with no closing backtick) is a SyntaxError, not a silently-truncated literal.
  (if (i32.ne (call $ch_at (i32.const 0)) (i32.const 96))
    (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Unterminated template literal")) (return)))
  (call $set_tok (i32.const 53) (local.get $start) (i32.sub (call $pos) (local.get $start)))
  (call $set_pos (i32.add (call $pos) (i32.const 1))))  ;; skip closing `

;; helper: emit a single/double-char operator token of kind $k spanning $n chars
(func $op_tok (param $k i32) (param $n i32) (effects)
  (call $set_tok (local.get $k) (call $pos) (local.get $n))
  (call $set_pos (i32.add (call $pos) (local.get $n))))

;; Is the previous token's identifier one after which `/` begins a regex?
(func $is_regex_kw (param $s i32) (param $l i32) (result i32) (effects)
  (let $w i32 (call $str_from_src (i32.add (call $src) (local.get $s)) (local.get $l)))
  (i32.or (call $str_eq (local.get $w) (cstring "return"))
  (i32.or (call $str_eq (local.get $w) (cstring "typeof"))
  (i32.or (call $str_eq (local.get $w) (cstring "instanceof"))
  (i32.or (call $str_eq (local.get $w) (cstring "in"))
  (i32.or (call $str_eq (local.get $w) (cstring "of"))
  (i32.or (call $str_eq (local.get $w) (cstring "new"))
  (i32.or (call $str_eq (local.get $w) (cstring "delete"))
  (i32.or (call $str_eq (local.get $w) (cstring "void"))
  (i32.or (call $str_eq (local.get $w) (cstring "do"))
  (i32.or (call $str_eq (local.get $w) (cstring "else"))
  (i32.or (call $str_eq (local.get $w) (cstring "yield"))
  (i32.or (call $str_eq (local.get $w) (cstring "await"))
  (i32.or (call $str_eq (local.get $w) (cstring "case"))
          (call $str_eq (local.get $w) (cstring "throw"))))))))))))))))

;; Can a '/' at the current position begin a regex literal? (true unless the
;; previous token produced a value.)
(func $regex_allowed (param $prevk i32) (param $prevs i32) (param $prevl i32) (result i32) (effects)
  (if i32 (i32.or (i32.eq (local.get $prevk) (i32.const 1)) (i32.or (i32.eq (local.get $prevk) (i32.const 2))
          (i32.or (i32.eq (local.get $prevk) (i32.const 16)) (i32.or (i32.eq (local.get $prevk) (i32.const 20))
          (i32.or (i32.eq (local.get $prevk) (i32.const 53)) (i32.eq (local.get $prevk) (i32.const 57)))))))
    (then (i32.const 0))
    (else (if i32 (i32.eq (local.get $prevk) (i32.const 3))
            (then (call $is_regex_kw (local.get $prevs) (local.get $prevl)))
            (else (i32.const 1))))))

;; Lex a regex literal /pattern/flags. Cursor at '/'. TOK_KIND=57, TOK_START/LEN
;; = pattern; flag range → regs 264/268.
(func $lex_regex (effects)
  (let $start i32 (call $pos))
  (call $set_pos (i32.add (local.get $start) (i32.const 1)))  ;; skip '/'
  (let $inclass i32 (i32.const 0))
  (block $e (loop $l
    (let $ch i32 (call $ch_at (i32.const 0)))
    (br_if $e (i32.eq (local.get $ch) (i32.const -1)))
    ;; a LineTerminator (LF/CR; LS/PS handled by the  /  lead byte check below) may not
    ;; appear in a RegularExpressionLiteral — SyntaxError (RegularExpressionNonTerminator).
    (if (i32.or (i32.eq (local.get $ch) (i32.const 10)) (i32.eq (local.get $ch) (i32.const 13)))
      (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Unterminated regular expression literal")) (br $e)))
    (if (i32.and (i32.eq (local.get $ch) (i32.const 226))  ;; LS/PS lead byte E2 80 A8/A9
          (i32.and (i32.eq (call $ch_at (i32.const 1)) (i32.const 128))
            (i32.or (i32.eq (call $ch_at (i32.const 2)) (i32.const 168)) (i32.eq (call $ch_at (i32.const 2)) (i32.const 169)))))
      (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Unterminated regular expression literal")) (br $e)))
    (if (i32.eq (local.get $ch) (i32.const 92))  ;; '\' escape — a RegularExpressionBackslashSequence may not contain a LineTerminator
      (then
        (if (i32.or (i32.eq (call $ch_at (i32.const 1)) (i32.const 10)) (i32.eq (call $ch_at (i32.const 1)) (i32.const 13)))
          (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Unterminated regular expression literal")) (br $e)))
        (if (i32.and (i32.eq (call $ch_at (i32.const 1)) (i32.const 226))  ;; LS/PS after '\'
              (i32.and (i32.eq (call $ch_at (i32.const 2)) (i32.const 128))
                (i32.or (i32.eq (call $ch_at (i32.const 3)) (i32.const 168)) (i32.eq (call $ch_at (i32.const 3)) (i32.const 169)))))
          (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Unterminated regular expression literal")) (br $e)))
        (call $set_pos (i32.add (call $pos) (i32.const 2))) (br $l)))  ;; '\' escape
    (if (i32.eq (local.get $ch) (i32.const 91)) (then (set! $inclass (i32.const 1))))  ;; '['
    (if (i32.eq (local.get $ch) (i32.const 93)) (then (set! $inclass (i32.const 0))))  ;; ']'
    (if (i32.and (i32.eq (local.get $ch) (i32.const 47)) (i32.eqz (local.get $inclass))) (then (br $e)))  ;; unescaped '/'
    (call $set_pos (i32.add (call $pos) (i32.const 1)))
    (br $l)))
  (let $patlen i32 (i32.sub (call $pos) (i32.add (local.get $start) (i32.const 1))))
  (call $set_pos (i32.add (call $pos) (i32.const 1)))  ;; skip closing '/'
  (let $flagstart i32 (call $pos))
  (block $fe (loop $fl (br_if $fe (i32.eqz (call $is_alpha (call $ch_at (i32.const 0))))) (call $set_pos (i32.add (call $pos) (i32.const 1))) (br $fl)))
  (i32.store (i32.const 264) (local.get $flagstart))
  (i32.store (i32.const 268) (i32.sub (call $pos) (local.get $flagstart)))
  (call $set_tok (i32.const 57) (i32.add (local.get $start) (i32.const 1)) (local.get $patlen)))

;; Read the next token into the TOK_* registers.
;; was there a LineTerminator in the trivia skipped before the CURRENT token?
;; (reg 688; set by next_token). Used for ASI restricted productions
;; (return/throw/break/continue + postfix ++/-- + yield no-LineTerminator-here).
(func $nl_before (result i32) (effects) (i32.load (i32.const 688)))
(func $range_has_nl (param $from i32) (param $to i32) (result i32) (effects)
  (let $i i32 (local.get $from))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $to)))
    (let $b i32 (i32.load8_u (i32.add (call $src) (local.get $i))))
    (if (i32.or (i32.eq (local.get $b) (i32.const 10)) (i32.eq (local.get $b) (i32.const 13))) (then (return (i32.const 1))))  ;; \n \r
    (if (i32.and (i32.eq (local.get $b) (i32.const 226))  ;; LS/PS: E2 80 A8/A9
          (i32.and (i32.lt_s (i32.add (local.get $i) (i32.const 2)) (local.get $to))
            (i32.and (i32.eq (i32.load8_u (i32.add (call $src) (i32.add (local.get $i) (i32.const 1)))) (i32.const 128))
              (i32.or (i32.eq (i32.load8_u (i32.add (call $src) (i32.add (local.get $i) (i32.const 2)))) (i32.const 168))
                      (i32.eq (i32.load8_u (i32.add (call $src) (i32.add (local.get $i) (i32.const 2)))) (i32.const 169))))))
      (then (return (i32.const 1))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (i32.const 0))

(func $next_token (effects)
  (let $prevk i32 (call $tok_kind))
  (let $prevs i32 (call $tok_start))
  (let $prevl i32 (call $tok_len))
  (i32.store (i32.const 696) (i32.add (local.get $prevs) (local.get $prevl)))  ;; end offset of the token we're leaving (for fn source spans)
  (let $nlpb i32 (call $pos))
  (call $skip_trivia)
  (i32.store (i32.const 688) (call $range_has_nl (local.get $nlpb) (call $pos)))  ;; record LineTerminator-before-token
  (let $c i32 (call $ch_at (i32.const 0)))
  (let $c1 i32 (call $ch_at (i32.const 1)))
  (let $c2 i32 (call $ch_at (i32.const 2)))
  (if (i32.eq (local.get $c) (i32.const -1)) (then (call $set_tok (i32.const 0) (call $pos) (i32.const 0)) (return)))
  (if (call $is_digit (local.get $c)) (then (call $lex_number) (return)))
  (if (i32.and (i32.eq (local.get $c) (i32.const 46)) (call $is_digit (local.get $c1)))
    (then (call $lex_number) (return)))  ;; .5
  (if (i32.and (i32.eq (local.get $c) (i32.const 92)) (i32.eq (local.get $c1) (i32.const 117)))
    (then (call $lex_ident) (return)))  ;; \u… → identifier starting with a unicode escape
  (if (i32.or (call $is_alpha (local.get $c)) (i32.and (i32.ge_s (local.get $c) (i32.const 128)) (i32.eqz (call $uni_ws_len)))) (then (call $lex_ident) (return)))  ;; ASCII ident-start or a non-ASCII, non-whitespace UTF-8 byte
  (if (i32.and (i32.eq (local.get $c) (i32.const 35)) (i32.or (call $is_alpha (local.get $c1)) (i32.or (i32.ge_s (local.get $c1) (i32.const 128)) (i32.eq (local.get $c1) (i32.const 92))))) (then (call $lex_ident) (return)))  ;; #privateName (incl. #\uHHHH escaped) → a single NAME token
  ;; `#` must begin a PrivateIdentifier; an ASCII non-identifier follower (not `\` escape, not a >127
