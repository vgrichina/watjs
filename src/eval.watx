  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    (if (call $arr_has (local.get $arr) (local.get $i)) (then (call $arr_push (local.get $out) (call $arr_get (local.get $arr) (local.get $i)))))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
