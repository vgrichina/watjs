    (then (let $qg i64 (call $get_prop (local.get $raw) (call $mk_str (cstring "get"))))
      (if (i32.eqz (i32.or (call $is_undefined (local.get $qg)) (call $is_function (local.get $qg))))
        (then (call $throw_type (cstring "TypeError") (cstring "Getter must be a function")) (return (call $v_undef))))))
  (if (local.get $qHasSet)
    (then (let $qs i64 (call $get_prop (local.get $raw) (call $mk_str (cstring "set"))))
      (if (i32.eqz (i32.or (call $is_undefined (local.get $qs)) (call $is_function (local.get $qs))))
        (then (call $throw_type (cstring "TypeError") (cstring "Setter must be a function")) (return (call $v_undef))))))
  ;; CompletePropertyDescriptor → normalized descriptor object
  (let $qIsAcc i32 (i32.or (local.get $qHasGet) (local.get $qHasSet)))
  (let $qConf i32 (call $truthy (call $get_prop (local.get $raw) (call $mk_str (cstring "configurable")))))
  (let $norm i32 (call $obj_new (i32.const 4)))
  (if (local.get $qIsAcc)
    (then
      (call $scope_define (local.get $norm) (cstring "get") (if i64 (local.get $qHasGet) (then (call $get_prop (local.get $raw) (call $mk_str (cstring "get")))) (else (call $v_undef))))
      (call $scope_define (local.get $norm) (cstring "set") (if i64 (local.get $qHasSet) (then (call $get_prop (local.get $raw) (call $mk_str (cstring "set")))) (else (call $v_undef)))))
    (else
      (call $scope_define (local.get $norm) (cstring "value") (if i64 (local.get $qHasVal) (then (call $get_prop (local.get $raw) (call $mk_str (cstring "value")))) (else (call $v_undef))))
      (call $scope_define (local.get $norm) (cstring "writable") (call $mk_bool (i32.and (local.get $qHasWr) (call $truthy (call $get_prop (local.get $raw) (call $mk_str (cstring "writable")))))))))
  (call $scope_define (local.get $norm) (cstring "enumerable") (call $mk_bool (call $truthy (call $get_prop (local.get $raw) (call $mk_str (cstring "enumerable"))))))
  (call $scope_define (local.get $norm) (cstring "configurable") (call $mk_bool (local.get $qConf)))
  ;; steps 17-18: IsCompatiblePropertyDescriptor(extensible, resultDesc, targetDesc). When the target
  ;; property is non-configurable, the trap cannot report it as configurable (nor flip its enumerable
  ;; flag) — the invariant that keeps a non-configurable property's shape stable through a Proxy.
  (if (i32.eqz (call $is_undefined (local.get $tdesc)))
    (then (if (i32.eqz (call $truthy (call $get_prop (local.get $tdesc) (call $mk_str (cstring "configurable")))))
      (then
        (if (local.get $qConf)
          (then (call $throw_type (cstring "TypeError") (cstring "proxy getOwnPropertyDescriptor: cannot report a non-configurable property as configurable")) (return (call $v_undef))))
        (if (i32.ne (call $truthy (call $get_prop (call $mk_obj (local.get $norm)) (call $mk_str (cstring "enumerable")))) (call $truthy (call $get_prop (local.get $tdesc) (call $mk_str (cstring "enumerable")))))
          (then (call $throw_type (cstring "TypeError") (cstring "proxy getOwnPropertyDescriptor: cannot change the enumerable attribute of a non-configurable property")) (return (call $v_undef))))))))
  ;; step 19: resultDesc non-configurable
  (if (i32.eqz (local.get $qConf))
    (then
      (if (call $is_undefined (local.get $tdesc))
        (then (call $throw_type (cstring "TypeError") (cstring "proxy getOwnPropertyDescriptor: cannot report a non-existent property as non-configurable")) (return (call $v_undef))))
      (if (call $truthy (call $get_prop (local.get $tdesc) (call $mk_str (cstring "configurable"))))
        (then (call $throw_type (cstring "TypeError") (cstring "proxy getOwnPropertyDescriptor: cannot report a configurable property as non-configurable")) (return (call $v_undef))))
      ;; 19b: data result, writable false, target writable true
      (if (i32.eqz (local.get $qIsAcc))
        (then
          (if (i32.eqz (call $truthy (call $get_prop (call $mk_obj (local.get $norm)) (call $mk_str (cstring "writable")))))
            (then
              (if (call $truthy (call $js_in (call $mk_str (cstring "writable")) (local.get $tdesc)))
                (then (if (call $truthy (call $get_prop (local.get $tdesc) (call $mk_str (cstring "writable"))))
                  (then (call $throw_type (cstring "TypeError") (cstring "proxy getOwnPropertyDescriptor: cannot report a writable property as non-writable non-configurable")) (return (call $v_undef)))))))))) ))
  (call $mk_obj (local.get $norm)))

;; replace every '"' (byte 34) in a string with the 6-byte entity &quot; (Annex B CreateHTML)
(func $html_escape_quotes (param $s i32) (result i32) (effects)
  (let $n i32 (call $str_len (local.get $s)))
  (let $out i32 (cstring ""))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    (let $c i32 (call $str_byte (local.get $s) (local.get $i)))
    (if (i32.eq (local.get $c) (i32.const 34))
      (then (set! $out (call $str_concat (local.get $out) (cstring "&quot;"))))
      (else
        (let $ch i32 (call $str_alloc (i32.const 1)))
        (call $str_set_byte (local.get $ch) (i32.const 0) (local.get $c))
        (set! $out (call $str_concat (local.get $out) (local.get $ch)))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (local.get $out))

;; Annex B.2.2 CreateHTML(thisv, tag, attribute, value): "<tag[ attr=\"escaped\"]>S</tag>".
;; $attr/$val ignored when $hasattr=0. Returns the HTML string value (or throws on null/undefined this).
(func $create_html (param $thisv i64) (param $tag i32) (param $attr i32) (param $hasattr i32) (param $val i64) (result i64) (effects)
  (if (i32.or (call $is_undefined (local.get $thisv)) (call $is_null (local.get $thisv)))
    (then (call $throw_type (cstring "TypeError") (cstring "String.prototype HTML method called on null or undefined")) (return (call $v_undef))))
  (let $s i32 (call $to_str (local.get $thisv)))
  (if (call $err) (then (return (call $v_undef))))
  (let $r i32 (call $str_concat (cstring "<") (local.get $tag)))
  (if (local.get $hasattr)
    (then
      (let $vs i32 (call $to_str (local.get $val)))
      (if (call $err) (then (return (call $v_undef))))
      (set! $vs (call $html_escape_quotes (local.get $vs)))
      (set! $r (call $str_concat (local.get $r) (cstring " ")))
      (set! $r (call $str_concat (local.get $r) (local.get $attr)))
      (set! $r (call $str_concat (local.get $r) (cstring "=\"")))
      (set! $r (call $str_concat (local.get $r) (local.get $vs)))
      (set! $r (call $str_concat (local.get $r) (cstring "\"")))))
  (set! $r (call $str_concat (local.get $r) (cstring ">")))
  (set! $r (call $str_concat (local.get $r) (local.get $s)))
  (set! $r (call $str_concat (local.get $r) (cstring "</")))
  (set! $r (call $str_concat (local.get $r) (local.get $tag)))
  (set! $r (call $str_concat (local.get $r) (cstring ">")))
  (call $mk_str (local.get $r)))

;; "\xHH" (two lowercase hex digits) for a byte
(func $re_hex_x (param $b i32) (result i32) (effects)
  (let $p i32 (call $str_alloc (i32.const 4)))
  (call $str_set_byte (local.get $p) (i32.const 0) (i32.const 92))   ;; '\'
  (call $str_set_byte (local.get $p) (i32.const 1) (i32.const 120))  ;; 'x'
  (call $str_set_byte (local.get $p) (i32.const 2) (call $json_hexd (i32.and (i32.shr_u (local.get $b) (i32.const 4)) (i32.const 15))))
  (call $str_set_byte (local.get $p) (i32.const 3) (call $json_hexd (i32.and (local.get $b) (i32.const 15))))
  (local.get $p))

;; a one-byte string holding byte $b
(func $re_byte_str (param $b i32) (result i32) (effects)
  (let $p i32 (call $str_alloc (i32.const 1)))
  (call $str_set_byte (local.get $p) (i32.const 0) (local.get $b))
  (local.get $p))

;; RegExp SyntaxCharacter (^ $ \ . * + ? ( ) [ ] { } |) or '/' (U+002F)
(func $re_is_syntax (param $b i32) (result i32) (effects)
  (if (i32.or (i32.eq (local.get $b) (i32.const 94)) (i32.or (i32.eq (local.get $b) (i32.const 36)) (i32.or (i32.eq (local.get $b) (i32.const 92)) (i32.or (i32.eq (local.get $b) (i32.const 46)) (i32.eq (local.get $b) (i32.const 42)))))) (then (return (i32.const 1))))
  (if (i32.or (i32.eq (local.get $b) (i32.const 43)) (i32.or (i32.eq (local.get $b) (i32.const 63)) (i32.or (i32.eq (local.get $b) (i32.const 40)) (i32.or (i32.eq (local.get $b) (i32.const 41)) (i32.eq (local.get $b) (i32.const 91)))))) (then (return (i32.const 1))))
  (if (i32.or (i32.eq (local.get $b) (i32.const 93)) (i32.or (i32.eq (local.get $b) (i32.const 123)) (i32.or (i32.eq (local.get $b) (i32.const 125)) (i32.or (i32.eq (local.get $b) (i32.const 124)) (i32.eq (local.get $b) (i32.const 47)))))) (then (return (i32.const 1))))
  (i32.const 0))

;; ES2025 RegExp.escape "other punctuators": , - = < > # & ! % : ; @ ~ ' ` " and SPACE
(func $re_is_otherpunct (param $b i32) (result i32) (effects)
  (if (i32.or (i32.eq (local.get $b) (i32.const 44)) (i32.or (i32.eq (local.get $b) (i32.const 45)) (i32.or (i32.eq (local.get $b) (i32.const 61)) (i32.or (i32.eq (local.get $b) (i32.const 60)) (i32.eq (local.get $b) (i32.const 62)))))) (then (return (i32.const 1))))
  (if (i32.or (i32.eq (local.get $b) (i32.const 35)) (i32.or (i32.eq (local.get $b) (i32.const 38)) (i32.or (i32.eq (local.get $b) (i32.const 33)) (i32.or (i32.eq (local.get $b) (i32.const 37)) (i32.eq (local.get $b) (i32.const 58)))))) (then (return (i32.const 1))))
  (if (i32.or (i32.eq (local.get $b) (i32.const 59)) (i32.or (i32.eq (local.get $b) (i32.const 64)) (i32.or (i32.eq (local.get $b) (i32.const 126)) (i32.or (i32.eq (local.get $b) (i32.const 39)) (i32.eq (local.get $b) (i32.const 96)))))) (then (return (i32.const 1))))
  (if (i32.or (i32.eq (local.get $b) (i32.const 34)) (i32.eq (local.get $b) (i32.const 32))) (then (return (i32.const 1))))
  (i32.const 0))

;; RegExp.escape(S) (ES2025). Byte-wise (ASCII-correct; non-ASCII passes through raw
;; since this engine's strings are bytes, not UTF-16 code units).
(func $regexp_escape (param $argc i32) (param $argv i32) (result i64) (effects)
  (let $a0 i64 (call $argn (local.get $argv) (local.get $argc) (i32.const 0)))
  (if (i32.eqz (call $is_string (local.get $a0)))
    (then (call $throw_type (cstring "TypeError") (cstring "RegExp.escape: argument must be a string")) (return (call $v_undef))))
  (let $s i32 (call $val_payload (local.get $a0)))
  (let $n i32 (call $str_len (local.get $s)))
  (let $out i32 (cstring ""))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    (let $b i32 (call $str_byte (local.get $s) (local.get $i)))
    (let $piece i32 (i32.const 0))
    ;; first code point that is ASCII alphanumeric → \xHH (so it can't begin an identifier)
    (if (i32.and (i32.eqz (local.get $i))
                 (i32.or (i32.and (i32.ge_s (local.get $b) (i32.const 48)) (i32.le_s (local.get $b) (i32.const 57)))
                 (i32.or (i32.and (i32.ge_s (local.get $b) (i32.const 65)) (i32.le_s (local.get $b) (i32.const 90)))
                         (i32.and (i32.ge_s (local.get $b) (i32.const 97)) (i32.le_s (local.get $b) (i32.const 122))))))
      (then (set! $piece (call $re_hex_x (local.get $b))))
      (else
        (if (call $re_is_syntax (local.get $b))
          (then (set! $piece (call $str_concat (cstring "\\") (call $re_byte_str (local.get $b)))))
          (else
            (if (i32.eq (local.get $b) (i32.const 9))  (then (set! $piece (cstring "\\t"))))
            (if (i32.eq (local.get $b) (i32.const 10)) (then (set! $piece (cstring "\\n"))))
            (if (i32.eq (local.get $b) (i32.const 11)) (then (set! $piece (cstring "\\v"))))
            (if (i32.eq (local.get $b) (i32.const 12)) (then (set! $piece (cstring "\\f"))))
            (if (i32.eq (local.get $b) (i32.const 13)) (then (set! $piece (cstring "\\r"))))
            (if (i32.and (i32.eqz (local.get $piece)) (call $re_is_otherpunct (local.get $b)))
              (then (set! $piece (call $re_hex_x (local.get $b)))))
            (if (i32.eqz (local.get $piece)) (then (set! $piece (call $re_byte_str (local.get $b)))))))))
    (set! $out (call $str_concat (local.get $out) (local.get $piece)))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (call $mk_str (local.get $out)))

;; RegExp.prototype.compile(pattern, flags) (Annex B) — re-initialize this regex in place.
(func $regexp_compile (param $thisv i64) (param $argc i32) (param $argv i32) (result i64) (effects)
  (if (i32.eqz (call $is_object (local.get $thisv)))
    (then (call $throw_type (cstring "TypeError") (cstring "RegExp.prototype.compile called on non-object")) (return (call $v_undef))))
  (if (i32.eqz (call $scope_find_local (call $val_payload (local.get $thisv)) (cstring "__re_src__")))
    (then (call $throw_type (cstring "TypeError") (cstring "RegExp.prototype.compile called on a non-RegExp")) (return (call $v_undef))))
  (let $pa0 i64 (call $argn (local.get $argv) (local.get $argc) (i32.const 0)))
  (let $pat i32 (cstring ""))
  (let $flg i32 (cstring ""))
  (if (call $is_regexp (local.get $pa0))
    (then
      (if (i32.and (i32.ge_s (local.get $argc) (i32.const 2)) (i32.eqz (call $is_undefined (call $argn (local.get $argv) (local.get $argc) (i32.const 1)))))
        (then (call $throw_type (cstring "TypeError") (cstring "cannot supply flags when constructing one RegExp from another")) (return (call $v_undef))))
      (set! $pat (call $re_pat_of (local.get $pa0)))
      (let $fsl i32 (call $scope_find_local (call $val_payload (local.get $pa0)) (cstring "__re_flags__")))
      (if (local.get $fsl) (then (let $fsv i64 (i64.load (local.get $fsl))) (if (call $is_string (local.get $fsv)) (then (set! $flg (call $val_payload (local.get $fsv))))))))
    (else
      (if (i32.eqz (i32.or (i32.lt_s (local.get $argc) (i32.const 1)) (call $is_undefined (local.get $pa0))))
        (then (set! $pat (call $to_str (local.get $pa0)))))
      (if (call $err) (then (return (call $v_undef))))
      (if (i32.and (i32.ge_s (local.get $argc) (i32.const 2)) (i32.eqz (call $is_undefined (call $argn (local.get $argv) (local.get $argc) (i32.const 1)))))
        (then (set! $flg (call $to_str (call $argn (local.get $argv) (local.get $argc) (i32.const 1))))))
      (if (call $err) (then (return (call $v_undef))))))
  ;; validate flags: only d/g/i/m/s/u/v/y, no duplicates → SyntaxError
  (let $fl i32 (call $str_len (local.get $flg)))
  (let $fi i32 (i32.const 0))
  (let $fseen i32 (i32.const 0))
  (block $fve (loop $fvl
    (br_if $fve (i32.ge_s (local.get $fi) (local.get $fl)))
    (let $fc i32 (call $str_byte (local.get $flg) (local.get $fi)))
    (let $fbit i32 (i32.const 0))
    (if (i32.eq (local.get $fc) (i32.const 103)) (then (set! $fbit (i32.const 1))))
    (if (i32.eq (local.get $fc) (i32.const 105)) (then (set! $fbit (i32.const 2))))
    (if (i32.eq (local.get $fc) (i32.const 109)) (then (set! $fbit (i32.const 4))))
    (if (i32.eq (local.get $fc) (i32.const 115)) (then (set! $fbit (i32.const 8))))
    (if (i32.eq (local.get $fc) (i32.const 117)) (then (set! $fbit (i32.const 16))))
    (if (i32.eq (local.get $fc) (i32.const 121)) (then (set! $fbit (i32.const 32))))
    (if (i32.eq (local.get $fc) (i32.const 100)) (then (set! $fbit (i32.const 64))))
    (if (i32.eq (local.get $fc) (i32.const 118)) (then (set! $fbit (i32.const 128))))
    (if (i32.or (i32.eqz (local.get $fbit)) (i32.and (local.get $fseen) (local.get $fbit)))
      (then (call $throw_type (cstring "SyntaxError") (cstring "Invalid regular expression flags")) (return (call $v_undef))))
    (set! $fseen (i32.or (local.get $fseen) (local.get $fbit)))
    (set! $fi (i32.add (local.get $fi) (i32.const 1)))
    (br $fvl)))
  ;; re-initialize the regex object in place + reset lastIndex
  (let $rs i32 (call $val_payload (local.get $thisv)))
  (call $scope_define_attr (local.get $rs) (cstring "__re_src__") (call $mk_str (local.get $pat)) (i32.const 0))
  (call $scope_define_attr (local.get $rs) (cstring "__re_flags__") (call $mk_str (local.get $flg)) (i32.const 0))
  (call $scope_define_attr (local.get $rs) (cstring "lastIndex") (call $num (f64.const 0)) (i32.const 8))
  (local.get $thisv))

;; Promise.withResolvers() (this = C). NewPromiseCapability(C): construct C with a
;; SpeciesConstructor(O, %Promise%): C = O.constructor (undefined → %Promise%); S = C[@@species]
;; (null/undefined → %Promise%); S must be a constructor. Returns the constructor (or %Promise%
;; reg844), or sets err + returns undef on a non-object constructor / non-constructor species.
(func $promise_species_ctor (param $O i64) (result i64) (effects)
  (let $C i64 (call $get_prop (local.get $O) (call $mk_str (cstring "constructor"))))
  (if (call $err) (then (return (call $v_undef))))
  (if (call $is_undefined (local.get $C)) (then (return (i64.load (i32.const 844)))))
  (if (i32.eqz (i32.or (call $is_object (local.get $C)) (call $is_function (local.get $C))))
    (then (call $throw_type (cstring "TypeError") (cstring "SpeciesConstructor: constructor is not an object")) (return (call $v_undef))))
  (let $S i64 (call $get_prop (local.get $C) (call $mk_str (cstring "@@species"))))
  (if (call $err) (then (return (call $v_undef))))
  (if (i32.or (call $is_undefined (local.get $S)) (call $is_null (local.get $S))) (then (return (i64.load (i32.const 844)))))
  (if (call $is_constructor (local.get $S)) (then (return (local.get $S))))
  (call $throw_type (cstring "TypeError") (cstring "SpeciesConstructor: species is not a constructor"))
  (call $v_undef))

;; capabilities executor (native 475) that captures resolve/reject, then return
;; { promise, resolve, reject }.
(func $promise_with_resolvers (param $thisv i64) (result i64) (effects)
  (if (i32.eqz (call $is_constructor (local.get $thisv)))
    (then (call $throw_type (cstring "TypeError") (cstring "Promise.withResolvers called on a non-constructor")) (return (call $v_undef))))
  (let $capo i32 (call $obj_new (i32.const 6)))
  (let $capv i64 (call $mk_obj (local.get $capo)))
  (let $wrex i64 (call $promise_bound_settler (i32.const 475) (local.get $capv)))  ;; capabilities executor bound to capv
  (i32.store (i32.add (call $val_payload (local.get $wrex)) (i32.const 8)) (i32.const 2))  ;; GetCapabilitiesExecutor.length = 2 (resolve, reject)
  (let $wrbuf i32 (call $heap_alloc (i32.const 8)))
  (i64.store (local.get $wrbuf) (local.get $wrex))
  (let $wrprom i64 (call $vm_construct (local.get $thisv) (i32.const 1) (local.get $wrbuf) (local.get $thisv)))
  (if (call $err) (then (return (call $v_undef))))
  (let $wrres i64 (call $get_prop (local.get $capv) (call $mk_str (cstring "@@resolve"))))
  (let $wrrej i64 (call $get_prop (local.get $capv) (call $mk_str (cstring "@@reject"))))
  (if (i32.or (i32.eqz (call $is_function (local.get $wrres))) (i32.eqz (call $is_function (local.get $wrrej))))
    (then (call $throw_type (cstring "TypeError") (cstring "Promise.withResolvers: resolve/reject is not callable")) (return (call $v_undef))))
  (let $wro i32 (call $obj_new (i32.const 6)))
  (call $scope_define (local.get $wro) (cstring "promise") (local.get $wrprom))
  (call $scope_define (local.get $wro) (cstring "resolve") (local.get $wrres))
  (call $scope_define (local.get $wro) (cstring "reject") (local.get $wrrej))
  (call $mk_obj (local.get $wro)))

;; combinator result finalization: for the default %Promise% the internal native result promise `p`
;; IS the result; for a custom constructor C the result is `cap`.[[Promise]] (a C instance), so pipe
;; the internal promise's settlement into cap.[[Resolve]]/[[Reject]] and return cap's promise.
(func $promise_comb_finalize (param $p i64) (param $custom i32) (param $cap i64) (result i64) (effects)
  (if (i32.eqz (local.get $custom)) (then (return (local.get $p))))
  (drop (call $promise_then (local.get $p)
    (call $get_prop (local.get $cap) (call $mk_str (cstring "resolve")))
    (call $get_prop (local.get $cap) (call $mk_str (cstring "reject")))))
  (call $get_prop (local.get $cap) (call $mk_str (cstring "promise"))))

;; dispatch the Annex B.2.2 HTML methods (ids 460-472) to CreateHTML
(func $call_html_method (param $id i32) (param $argc i32) (param $argv i32) (param $thisv i64) (result i64) (effects)
  (let $hv i64 (call $argn (local.get $argv) (local.get $argc) (i32.const 0)))
