      (if (i32.eq (local.get $id) (i32.const 27))  ;; includes(x[, fromIndex]) — SameValueZero (matches NaN)
        (then
          (if (i32.eqz (local.get $n)) (then (return (call $v_false))))  ;; len 0 → false BEFORE coercing fromIndex (spec)
          (let $i i32 (if i32 (i32.ge_s (local.get $argc) (i32.const 2)) (then (call $to_int_idx (call $to_num (call $argn (local.get $argv) (local.get $argc) (i32.const 1))))) (else (i32.const 0))))
          (if (i32.lt_s (local.get $i) (i32.const 0)) (then (set! $i (i32.add (local.get $n) (local.get $i))) (if (i32.lt_s (local.get $i) (i32.const 0)) (then (set! $i (i32.const 0))))))
          (let $a0nan i32 (i32.and (call $is_number (local.get $a0)) (f64.ne (call $tonum_raw (local.get $a0)) (call $tonum_raw (local.get $a0)))))
          (block $ie (loop $il
            (br_if $ie (i32.ge_s (local.get $i) (local.get $n)))
            ;; includes [[Get]]s EVERY index 0..len-1 (never HasProperty-skips). A generic array-like
            ;; OBJECT (incl. a Proxy) must be read live via get_prop so its get trap/getters fire on each
            ;; index; a real array or TypedArray uses dense_get (snapshot / live-element).
            (let $iel i64 (if i64 (call $is_object (local.get $thisv))
              (then (if i64 (call $scope_find_local (call $val_payload (local.get $thisv)) (cstring "@@taelem"))
                (then (call $dense_get (local.get $thisv) (local.get $arr) (local.get $i)))
                (else (call $get_prop (local.get $thisv) (call $num (f64.convert_i32_s (local.get $i)))))))
              (else (call $dense_get (local.get $thisv) (local.get $arr) (local.get $i)))))
            (if (i32.or (call $strict_eq (local.get $iel) (local.get $a0))
                        (i32.and (local.get $a0nan) (i32.and (call $is_number (local.get $iel)) (f64.ne (call $tonum_raw (local.get $iel)) (call $tonum_raw (local.get $iel))))))
              (then (return (call $v_true))))
