  (if (f64.lt (local.get $x) (f64.const 0)) (then (return (f64.div (f64.const 0) (f64.const 0)))))  ;; <0 → NaN
  (if (f64.eq (local.get $x) (f64.const 0)) (then (return (f64.div (f64.const -1) (f64.const 0)))))  ;; ±0 → -Inf
