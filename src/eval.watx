          (if (i32.eqz (i32.or (call $is_object (local.get $cres)) (i32.or (call $is_array (local.get $cres)) (call $is_function (local.get $cres)))))
            (then (call $throw_type (cstring "TypeError") (cstring "proxy [[Construct]] must return an object")) (return (call $v_undef))))
          (return (local.get $cres)))
