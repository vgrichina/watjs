  (set! $p (f64.add (f64.mul (local.get $p) (local.get $t2)) (f64.const 0.09090909090909091)))  ;; 1/11
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $t2)) (f64.const 0.1111111111111111)))   ;; 1/9
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $t2)) (f64.const 0.14285714285714285)))  ;; 1/7
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $t2)) (f64.const 0.2)))                   ;; 1/5
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $t2)) (f64.const 0.3333333333333333)))    ;; 1/3
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $t2)) (f64.const 1)))
