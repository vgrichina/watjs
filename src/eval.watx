  ;; via own_enum_keys); booleans/numbers/bigints/symbols box so the wrapper's
  ;; prototype chain (Boolean/Number/… .prototype) is enumerated.
  (let $cur i64 (local.get $v))
  (if (i32.or (call $is_number (local.get $v)) (i32.or (call $is_boolean (local.get $v)) (i32.or (call $is_bigint (local.get $v)) (call $is_symbol (local.get $v)))))
    (then (set! $cur (call $to_object (local.get $v)))))
  (block $done (loop $up
    (br_if $done (i32.eqz (i32.or (call $is_object (local.get $cur))
      (i32.or (call $is_array (local.get $cur))
        (i32.or (call $is_string (local.get $cur)) (call $is_proxy (local.get $cur)))))))
    ;; yield this level's enumerable own keys that weren't shadowed lower down
    (let $ek i32 (call $own_enum_keys (local.get $cur) (i32.const 0)))
    (let $en i32 (call $arr_len (local.get $ek)))
    (let $i i32 (i32.const 0))
    (block $e1 (loop $l1
      (br_if $e1 (i32.ge_s (local.get $i) (local.get $en)))
      (let $kv i64 (call $arr_get (local.get $ek) (local.get $i)))
      (if (i32.eqz (call $scope_find_local (local.get $seen) (call $val_payload (local.get $kv))))
        (then (call $arr_push (local.get $result) (local.get $kv))))
      (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l1)))
    ;; mark ALL own keys (incl. non-enumerable) as seen → shadow higher levels
    (let $ak i32 (call $own_enum_keys (local.get $cur) (i32.const 1)))
    (let $an i32 (call $arr_len (local.get $ak)))
    (set! $i (i32.const 0))
    (block $e2 (loop $l2
      (br_if $e2 (i32.ge_s (local.get $i) (local.get $an)))
      (call $scope_define (local.get $seen) (call $val_payload (call $arr_get (local.get $ak) (local.get $i))) (call $v_true))
      (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l2)))
    (set! $cur (call $js_get_prototype (local.get $cur)))
    (br $up)))
  (local.get $result))

;; ── function calls & native builtins ──

(func $argn (param $argv i32) (param $argc i32) (param $i i32) (result i64) (effects)
  (if i64 (i32.lt_s (local.get $i) (local.get $argc))
    (then (i64.load (i32.add (local.get $argv) (i32.mul (local.get $i) (i32.const 8)))))
    (else (call $v_undef))))

;; days since the Unix epoch for a civil date (Howard Hinnant's algorithm).
;; y full year, m 1..12, d 1..31.
(func $days_from_civil (param $y i64) (param $m i64) (param $d i64) (result i64) (effects)
  (if (i64.le_s (local.get $m) (i64.const 2)) (then (set! $y (i64.sub (local.get $y) (i64.const 1)))))
  (let $era i64 (i64.div_s (if i64 (i64.ge_s (local.get $y) (i64.const 0)) (then (local.get $y)) (else (i64.sub (local.get $y) (i64.const 399)))) (i64.const 400)))
  (let $yoe i64 (i64.sub (local.get $y) (i64.mul (local.get $era) (i64.const 400))))
  (let $doy i64 (i64.add (i64.div_s (i64.add (i64.mul (i64.const 153) (i64.add (local.get $m) (if i64 (i64.gt_s (local.get $m) (i64.const 2)) (then (i64.const -3)) (else (i64.const 9))))) (i64.const 2)) (i64.const 5)) (i64.sub (local.get $d) (i64.const 1))))
  (let $doe i64 (i64.add (i64.sub (i64.add (i64.mul (local.get $yoe) (i64.const 365)) (i64.div_s (local.get $yoe) (i64.const 4))) (i64.div_s (local.get $yoe) (i64.const 100))) (local.get $doy)))
  (i64.sub (i64.add (i64.mul (local.get $era) (i64.const 146097)) (local.get $doe)) (i64.const 719468)))

;; ToInteger → i32 without trapping: NaN→0, ±Infinity/huge clamp to the i32
;; range, otherwise truncate toward zero. Used for length/index/count arguments
;; (i32.trunc_f64_s traps on NaN or out-of-i32-range floats).
(func $to_int_idx (param $v f64) (result i32) (effects)
  (if (f64.ne (local.get $v) (local.get $v)) (then (return (i32.const 0))))
  (if (f64.ge (local.get $v) (f64.const 2147483647)) (then (return (i32.const 2147483647))))
  (if (f64.le (local.get $v) (f64.const -2147483648)) (then (return (i32.const -2147483648))))
  (i32.trunc_f64_s (local.get $v)))

;; a plain Array of `len` holes.
(func $plain_array (param $len i32) (result i64) (effects)
  (let $pa i32 (call $arr_new (i32.add (local.get $len) (i32.const 1))))
  (call $arr_set_length (local.get $pa) (local.get $len))
  (call $mk_arr (local.get $pa)))

;; ArraySpeciesCreate(originalArray, length): the result-array constructor used by
;; map/filter/slice/splice/concat. Default (non-array source, no @@species, or the
;; species IS Array) → a plain Array; a custom constructor[@@species] is [[Construct]]
;; ed with [length]; a non-constructor species → TypeError.
(func $array_species_create (param $o i64) (param $len i32) (result i64) (effects)
  (if (i32.eqz (call $is_array (local.get $o))) (then (return (call $plain_array (local.get $len)))))
  (let $sctor i64 (call $get_prop (local.get $o) (call $mk_str (cstring "constructor"))))
  (if (call $err) (then (return (call $v_undef))))
  (let $sspec i64 (call $v_undef))
  (if (i32.or (call $is_object (local.get $sctor)) (i32.or (call $is_function (local.get $sctor)) (call $is_array (local.get $sctor))))
    (then (set! $sspec (call $get_prop (local.get $sctor) (call $make_symbol (cstring "@@species") (cstring "Symbol.species"))))
      (if (call $err) (then (return (call $v_undef))))))
  (if (i32.or (call $is_undefined (local.get $sspec)) (call $is_null (local.get $sspec)))
    (then (return (call $plain_array (local.get $len)))))
  ;; the default Array constructor → plain array (skip the construct on the hot path)
  (let $aslot i32 (call $scope_find_local (i32.load (i32.const 152)) (cstring "Array")))
  (if (local.get $aslot)
    (then (if (call $strict_eq (local.get $sspec) (i64.load (local.get $aslot))) (then (return (call $plain_array (local.get $len)))))))
  (if (i32.eqz (call $is_constructor (local.get $sspec)))
    (then (call $throw_type (cstring "TypeError") (cstring "Array species is not a constructor")) (return (call $v_undef))))
  (let $sab i32 (call $heap_alloc (i32.const 8)))
  (i64.store (local.get $sab) (call $num (f64.convert_i32_s (local.get $len))))
  (call $vm_construct (local.get $sspec) (i32.const 1) (local.get $sab) (local.get $sspec)))

;; SpeciesConstructor(O, defaultConstructor): C=Get(O,"constructor"); undefined→default;
;; non-object→TypeError; S=Get(C,@@species); undefined/null→default; IsConstructor(S)→S; else TypeError.
(func $species_constructor (param $o i64) (param $default i64) (result i64) (effects)
  (let $spc i64 (call $get_prop (local.get $o) (call $mk_str (cstring "constructor"))))
  (if (call $err) (then (return (call $v_undef))))
  (if (call $is_undefined (local.get $spc)) (then (return (local.get $default))))
  (if (i32.eqz (i32.or (call $is_object (local.get $spc)) (i32.or (call $is_function (local.get $spc)) (call $is_array (local.get $spc)))))
    (then (call $throw_type (cstring "TypeError") (cstring "constructor is not an object")) (return (call $v_undef))))
  (let $sps i64 (call $get_prop (local.get $spc) (call $make_symbol (cstring "@@species") (cstring "Symbol.species"))))
  (if (call $err) (then (return (call $v_undef))))
  (if (i32.or (call $is_undefined (local.get $sps)) (call $is_null (local.get $sps))) (then (return (local.get $default))))
  (if (call $is_constructor (local.get $sps)) (then (return (local.get $sps))))
  (call $throw_type (cstring "TypeError") (cstring "@@species is not a constructor")) (call $v_undef))

;; CreateDataProperty(target, idx, val) for a species result (array or any object).
(func $cdp (param $target i64) (param $idx i32) (param $val i64) (effects)
  (if (call $is_array (local.get $target))
    (then (call $arr_set (call $val_payload (local.get $target)) (local.get $idx) (local.get $val)))
    (else (call $set_prop (local.get $target) (call $num (f64.convert_i32_s (local.get $idx))) (local.get $val)))))

;; Append one concat item to result `A` starting at index `n`; returns the next
;; index. Spreads the item if IsConcatSpreadable (an array, or an object whose
;; @@isConcatSpreadable is truthy) defining present indices via CreateDataProperty
;; (holes stay absent), else defines it as one element.
(func $concat_append (param $A i64) (param $n i32) (param $item i64) (result i32) (effects)
  (let $spread i32 (i32.const 0))
  (if (i32.or (call $is_object (local.get $item)) (call $is_array (local.get $item)))
    (then
      (let $s i64 (call $get_prop (local.get $item) (call $make_symbol (cstring "@@isConcatSpreadable") (cstring "Symbol.isConcatSpreadable"))))
      (if (call $is_undefined (local.get $s))
        (then (set! $spread (call $is_array (local.get $item))))
        (else (set! $spread (call $truthy (local.get $s)))))))
  (if (local.get $spread)
    (then
      (let $clen i32 (call $alike_len (local.get $item)))
      (let $cj i32 (i32.const 0))
      (block $cce (loop $ccl (br_if $cce (i32.ge_s (local.get $cj) (local.get $clen)))
        (if (call $truthy (call $js_in (call $num (f64.convert_i32_s (local.get $cj))) (local.get $item)))
          (then (call $cdp (local.get $A) (local.get $n) (call $get_prop (local.get $item) (call $num (f64.convert_i32_s (local.get $cj)))))))
        (br_if $cce (call $err))
        (set! $n (i32.add (local.get $n) (i32.const 1)))
        (set! $cj (i32.add (local.get $cj) (i32.const 1))) (br $ccl))))
    (else (call $cdp (local.get $A) (local.get $n) (local.get $item)) (set! $n (i32.add (local.get $n) (i32.const 1)))))
  (local.get $n))

;; element get/set for the in-place array methods (fill/copyWithin/reverse): a real
;; array hits the dense store, a generic array-like object goes through get/set_prop
;; on the receiver (the dense `$arr` is a throwaway copy for non-arrays).
(func $amut_get (param $thisv i64) (param $arr i32) (param $i i32) (result i64) (effects)
  (if i64 (call $is_array (local.get $thisv))
    (then (call $arr_get (local.get $arr) (local.get $i)))
    (else (call $get_prop (local.get $thisv) (call $num (f64.convert_i32_s (local.get $i)))))))
(func $amut_set (param $thisv i64) (param $arr i32) (param $i i32) (param $v i64) (effects)
  (if (call $is_array (local.get $thisv))
    (then (call $arr_set (local.get $arr) (local.get $i) (local.get $v)))
    (else (call $set_prop (local.get $thisv) (call $num (f64.convert_i32_s (local.get $i))) (local.get $v)))))

;; DeletePropertyOrThrow(O, idx) for the generic splice on an object receiver.
(func $splice_delete (param $thisv i64) (param $idx i32) (effects)
  (if (call $is_object (local.get $thisv))
    (then (drop (call $scope_delete (call $val_payload (local.get $thisv)) (call $num_to_str (f64.convert_i32_s (local.get $idx))))))))

;; Array.prototype.splice on a generic array-like OBJECT receiver: reads/writes the
;; receiver's indices + length (the dense path would mutate a throwaway copy).
;; Returns the array of removed elements. Indices fit i32 for realistic receivers.
(func $splice_generic (param $thisv i64) (param $argv i32) (param $argc i32) (result i64) (effects)
  (let $gsl i32 (call $alike_len (local.get $thisv)))
  (let $gss i32 (call $to_int_idx (call $to_num (call $argn (local.get $argv) (local.get $argc) (i32.const 0)))))
  (if (i32.lt_s (local.get $gss) (i32.const 0)) (then (set! $gss (i32.add (local.get $gsl) (local.get $gss))) (if (i32.lt_s (local.get $gss) (i32.const 0)) (then (set! $gss (i32.const 0))))))
  (if (i32.gt_s (local.get $gss) (local.get $gsl)) (then (set! $gss (local.get $gsl))))
  (let $gdc i32 (i32.const 0))
  (if (i32.eq (local.get $argc) (i32.const 1)) (then (set! $gdc (i32.sub (local.get $gsl) (local.get $gss)))))
  (if (i32.ge_s (local.get $argc) (i32.const 2))
    (then (set! $gdc (call $to_int_idx (call $to_num (call $argn (local.get $argv) (local.get $argc) (i32.const 1)))))
      (if (i32.lt_s (local.get $gdc) (i32.const 0)) (then (set! $gdc (i32.const 0))))
      (if (i32.gt_s (local.get $gdc) (i32.sub (local.get $gsl) (local.get $gss))) (then (set! $gdc (i32.sub (local.get $gsl) (local.get $gss)))))))
  (let $gic i32 (if i32 (i32.ge_s (local.get $argc) (i32.const 2)) (then (i32.sub (local.get $argc) (i32.const 2))) (else (i32.const 0))))
  (let $gsa i32 (call $arr_new (i32.const 8)))
  (let $gk i32 (i32.const 0))
  (block $gae (loop $gal (br_if $gae (i32.ge_s (local.get $gk) (local.get $gdc)))
    (let $gf i32 (i32.add (local.get $gss) (local.get $gk)))
    (if (call $truthy (call $js_in (call $num (f64.convert_i32_s (local.get $gf))) (local.get $thisv)))
      (then (call $arr_set (local.get $gsa) (local.get $gk) (call $get_prop (local.get $thisv) (call $num (f64.convert_i32_s (local.get $gf)))))))
    (set! $gk (i32.add (local.get $gk) (i32.const 1))) (br $gal)))
  (i32.store (local.get $gsa) (local.get $gdc))  ;; removed.length = deleteCount (holes ok)
  (if (i32.lt_s (local.get $gic) (local.get $gdc))
    (then  ;; shrink: shift the tail down, then delete the now-vacant slots
      (set! $gk (local.get $gss))
      (block $gse (loop $gsl2 (br_if $gse (i32.ge_s (local.get $gk) (i32.sub (local.get $gsl) (local.get $gdc))))
        (let $gf2 i32 (i32.add (local.get $gk) (local.get $gdc)))
        (let $gt i32 (i32.add (local.get $gk) (local.get $gic)))
        (if (call $truthy (call $js_in (call $num (f64.convert_i32_s (local.get $gf2))) (local.get $thisv)))
          (then (call $set_prop (local.get $thisv) (call $num (f64.convert_i32_s (local.get $gt))) (call $get_prop (local.get $thisv) (call $num (f64.convert_i32_s (local.get $gf2))))))
          (else (call $splice_delete (local.get $thisv) (local.get $gt))))
        (set! $gk (i32.add (local.get $gk) (i32.const 1))) (br $gsl2)))
      (set! $gk (local.get $gsl))
      (block $gte (loop $gtl (br_if $gte (i32.le_s (local.get $gk) (i32.add (i32.sub (local.get $gsl) (local.get $gdc)) (local.get $gic))))
        (call $splice_delete (local.get $thisv) (i32.sub (local.get $gk) (i32.const 1)))
        (set! $gk (i32.sub (local.get $gk) (i32.const 1))) (br $gtl)))))
  (if (i32.gt_s (local.get $gic) (local.get $gdc))
    (then  ;; grow: shift the tail up from the end
      (set! $gk (i32.sub (local.get $gsl) (local.get $gdc)))
      (block $gue (loop $gul (br_if $gue (i32.le_s (local.get $gk) (local.get $gss)))
        (let $gf3 i32 (i32.sub (i32.add (local.get $gk) (local.get $gdc)) (i32.const 1)))
        (let $gt3 i32 (i32.sub (i32.add (local.get $gk) (local.get $gic)) (i32.const 1)))
        (if (call $truthy (call $js_in (call $num (f64.convert_i32_s (local.get $gf3))) (local.get $thisv)))
          (then (call $set_prop (local.get $thisv) (call $num (f64.convert_i32_s (local.get $gt3))) (call $get_prop (local.get $thisv) (call $num (f64.convert_i32_s (local.get $gf3))))))
          (else (call $splice_delete (local.get $thisv) (local.get $gt3))))
        (set! $gk (i32.sub (local.get $gk) (i32.const 1))) (br $gul)))))
  (set! $gk (i32.const 0))
  (block $gie (loop $gil (br_if $gie (i32.ge_s (local.get $gk) (local.get $gic)))
    (call $set_prop (local.get $thisv) (call $num (f64.convert_i32_s (i32.add (local.get $gss) (local.get $gk)))) (call $argn (local.get $argv) (local.get $argc) (i32.add (local.get $gk) (i32.const 2))))
    (set! $gk (i32.add (local.get $gk) (i32.const 1))) (br $gil)))
  (call $set_length_throwing (local.get $thisv) (f64.convert_i32_s (i32.add (i32.sub (local.get $gsl) (local.get $gdc)) (local.get $gic))))
  (call $mk_arr (local.get $gsa)))

;; ToLength of an array-like's `length` as f64 (0 if NaN/negative; capped at 2^53-1).
;; Used by the generic array-like mutators to detect the 2^53-1 integer limit and
;; to address indices beyond the i32 range without overflow/looping.
(func $alike_len_f64 (param $thisv i64) (result f64) (effects)
  (let $l f64 (call $to_num (call $get_prop (local.get $thisv) (call $mk_str (cstring "length")))))
  (if (f64.ne (local.get $l) (local.get $l)) (then (return (f64.const 0))))  ;; NaN
  (if (f64.le (local.get $l) (f64.const 0)) (then (return (f64.const 0))))
  (let $t f64 (f64.floor (local.get $l)))
  (if (f64.gt (local.get $t) (f64.const 9007199254740991)) (then (return (f64.const 9007199254740991))))
  (local.get $t))

;; Set the receiver's `length` to `valf`, throwing a TypeError if it can't be
;; written (spec mutators call Set(O,"length",..,Throw=true)). A non-object
;; receiver (string/primitive) and a non-writable own length both throw.
(func $set_length_throwing (param $thisv i64) (param $valf f64) (effects)
  (if (call $is_array (local.get $thisv))  ;; a real array's length is writable (unless frozen, which set_prop handles)
    (then (call $set_prop (local.get $thisv) (call $mk_str (cstring "length")) (call $num (local.get $valf))) (return)))
  (if (i32.eqz (call $is_object (local.get $thisv)))
    (then (call $throw_type (cstring "TypeError") (cstring "Cannot assign to read only property 'length'")) (return)))
  (let $sl i32 (call $scope_find_local (call $val_payload (local.get $thisv)) (cstring "length")))
  (if (local.get $sl)
    (then (if (i32.eqz (call $entry_writable (local.get $sl)))
      (then (call $throw_type (cstring "TypeError") (cstring "Cannot assign to read only property 'length'")) (return)))))
  (call $set_prop (local.get $thisv) (call $mk_str (cstring "length")) (call $num (local.get $valf))))

;; ToLength of an array-like's `length` (0 if absent/negative), clamped to i32.
(func $alike_len (param $thisv i64) (result i32) (effects)
  (if (call $is_array (local.get $thisv)) (then (return (call $arr_len (call $val_payload (local.get $thisv))))))
  (let $l i32 (call $to_int_idx (call $to_num (call $get_prop (local.get $thisv) (call $mk_str (cstring "length"))))))
  (if i32 (i32.lt_s (local.get $l) (i32.const 0)) (then (i32.const 0)) (else (local.get $l))))

;; View any value as a real array for the generic Array.prototype methods: a
;; real array is returned as-is (so mutators still mutate it); an array-like
;; object is materialized into a fresh array by reading length + indexed props
;; (capped to avoid OOM on huge lengths). Callbacks still receive the original
;; `this`, so e.g. Array.prototype.filter.call(Math, cb) sees Math as the 3rd arg.
(func $alike_arr (param $thisv i64) (result i32) (effects)
  (if (call $is_array (local.get $thisv)) (then (return (call $val_payload (local.get $thisv)))))
  (let $len i32 (call $alike_len (local.get $thisv)))
  ;; cap materialization (each index also allocates a key string); 1M overflowed
  ;; the heap on Infinity/huge `length` array-likes (OOB). 64K covers realistic
  ;; array-likes and lets huge-length sparse tests early-exit instead of crashing.
  (if (i32.gt_s (local.get $len) (i32.const 65536)) (then (set! $len (i32.const 65536))))
  (let $tmp i32 (call $arr_new (i32.add (local.get $len) (i32.const 1))))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $len)))
    ;; absent index (HasProperty false) → store a hole so iteration methods skip it,
    ;; matching real-array hole semantics for map/forEach/filter/some/every/reduce/…
    (if (call $truthy (call $js_in (call $num (f64.convert_i32_s (local.get $i))) (local.get $thisv)))
      (then (call $arr_set (local.get $tmp) (local.get $i) (call $get_prop (local.get $thisv) (call $num (f64.convert_i32_s (local.get $i))))))
      (else (call $arr_set (local.get $tmp) (local.get $i) (call $v_hole))))
    (br_if $e (call $err))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
  (i32.store (local.get $tmp) (local.get $len))  ;; preserve the full length even if the tail is absent
  (local.get $tmp))

;; safe to i64.trunc_f64_s? (finite and within i64 range — trunc traps otherwise)
(func $f64_safe_i64 (param $v f64) (result i32) (effects)
  (i32.and (f64.eq (local.get $v) (local.get $v))
    (i32.and (f64.lt (local.get $v) (f64.const 9.2e18)) (f64.gt (local.get $v) (f64.const -9.2e18)))))

;; epoch-ms from date components (UTC). month is 0-based per JS.
(func $date_make (param $y i64) (param $mo i64) (param $d i64) (param $h i64) (param $mi i64) (param $s i64) (param $ms i64) (result f64) (effects)
  ;; MakeDay: normalize month into [0,11], carrying into the year (Euclidean: floor div).
  (let $mq i64 (i64.div_s (local.get $mo) (i64.const 12)))
  (let $mr i64 (i64.rem_s (local.get $mo) (i64.const 12)))
  (if (i64.lt_s (local.get $mr) (i64.const 0)) (then (set! $mr (i64.add (local.get $mr) (i64.const 12))) (set! $mq (i64.sub (local.get $mq) (i64.const 1)))))
  (set! $y (i64.add (local.get $y) (local.get $mq)))
  (set! $mo (local.get $mr))
  (let $days i64 (call $days_from_civil (local.get $y) (i64.add (local.get $mo) (i64.const 1)) (local.get $d)))
  (let $dmr f64 (f64.convert_i64_s (i64.add (i64.add (i64.add (i64.add (i64.mul (local.get $days) (i64.const 86400000)) (i64.mul (local.get $h) (i64.const 3600000))) (i64.mul (local.get $mi) (i64.const 60000))) (i64.mul (local.get $s) (i64.const 1000))) (local.get $ms))))
  (if (i32.or (f64.ne (local.get $dmr) (local.get $dmr)) (f64.gt (f64.abs (local.get $dmr)) (f64.const 8640000000000000))) (then (return (f64.div (f64.const 0) (f64.const 0)))))
  (local.get $dmr))

;; extract a UTC date/time field from epoch ms. field: 0 year, 1 month(0-based),
;; 2 date, 3 weekday, 4 hours, 5 minutes, 6 seconds, 7 ms.
(func $date_field (param $msf f64) (param $field i32) (result i32) (effects)
  (let $ms i64 (i64.trunc_f64_s (local.get $msf)))
  (let $day i64 (i64.div_s (local.get $ms) (i64.const 86400000)))
  (if (i32.and (i64.lt_s (local.get $ms) (i64.const 0)) (i64.ne (local.get $ms) (i64.mul (local.get $day) (i64.const 86400000))))
    (then (set! $day (i64.sub (local.get $day) (i64.const 1)))))
  (let $tod i64 (i64.sub (local.get $ms) (i64.mul (local.get $day) (i64.const 86400000))))
  (if (i32.eq (local.get $field) (i32.const 4)) (then (return (i32.wrap_i64 (i64.div_s (local.get $tod) (i64.const 3600000))))))
  (if (i32.eq (local.get $field) (i32.const 5)) (then (return (i32.wrap_i64 (i64.rem_s (i64.div_s (local.get $tod) (i64.const 60000)) (i64.const 60))))))
  (if (i32.eq (local.get $field) (i32.const 6)) (then (return (i32.wrap_i64 (i64.rem_s (i64.div_s (local.get $tod) (i64.const 1000)) (i64.const 60))))))
  (if (i32.eq (local.get $field) (i32.const 7)) (then (return (i32.wrap_i64 (i64.rem_s (local.get $tod) (i64.const 1000))))))
  (if (i32.eq (local.get $field) (i32.const 3)) (then (return (i32.wrap_i64 (i64.rem_s (i64.add (i64.rem_s (i64.add (local.get $day) (i64.const 4)) (i64.const 7)) (i64.const 7)) (i64.const 7))))))
  ;; civil_from_days
  (let $z i64 (i64.add (local.get $day) (i64.const 719468)))
  (let $era i64 (i64.div_s (if i64 (i64.ge_s (local.get $z) (i64.const 0)) (then (local.get $z)) (else (i64.sub (local.get $z) (i64.const 146096)))) (i64.const 146097)))
  (let $doe i64 (i64.sub (local.get $z) (i64.mul (local.get $era) (i64.const 146097))))
  (let $yoe i64 (i64.div_s (i64.sub (i64.add (i64.sub (local.get $doe) (i64.div_s (local.get $doe) (i64.const 1460))) (i64.div_s (local.get $doe) (i64.const 36524))) (i64.div_s (local.get $doe) (i64.const 146096))) (i64.const 365)))
  (let $yy i64 (i64.add (local.get $yoe) (i64.mul (local.get $era) (i64.const 400))))
  (let $doy i64 (i64.sub (local.get $doe) (i64.add (i64.sub (i64.mul (i64.const 365) (local.get $yoe)) (i64.div_s (local.get $yoe) (i64.const 100))) (i64.div_s (local.get $yoe) (i64.const 4)))))
  (let $mp i64 (i64.div_s (i64.add (i64.mul (i64.const 5) (local.get $doy)) (i64.const 2)) (i64.const 153)))
  (let $dd i64 (i64.add (i64.sub (local.get $doy) (i64.div_s (i64.add (i64.mul (i64.const 153) (local.get $mp)) (i64.const 2)) (i64.const 5))) (i64.const 1)))
  (let $mm i64 (if i64 (i64.lt_s (local.get $mp) (i64.const 10)) (then (i64.add (local.get $mp) (i64.const 3))) (else (i64.sub (local.get $mp) (i64.const 9)))))
  (if (i64.le_s (local.get $mm) (i64.const 2)) (then (set! $yy (i64.add (local.get $yy) (i64.const 1)))))
  (if (i32.eq (local.get $field) (i32.const 0)) (then (return (i32.wrap_i64 (local.get $yy)))))
  (if (i32.eq (local.get $field) (i32.const 1)) (then (return (i32.wrap_i64 (i64.sub (local.get $mm) (i64.const 1))))))
  (return (i32.wrap_i64 (local.get $dd))))

;; TypedArray element types: 0 int8,1 uint8,2 uint8clamped,3 int16,4 uint16,
;; 5 int32,6 uint32,7 float32,8 float64.
(func $ta_bpe (param $elem i32) (result i32) (effects)
  (if i32 (i32.le_s (local.get $elem) (i32.const 2)) (then (i32.const 1))
    (else (if i32 (i32.le_s (local.get $elem) (i32.const 4)) (then (i32.const 2))
    (else (if i32 (i32.ge_s (local.get $elem) (i32.const 8)) (then (i32.const 8)) (else (i32.const 4))))))))  ;; 8 Float64, 9 BigInt64, 10 BigUint64 = 8 bytes

;; read element idx (as f64) from a typed-array byte buffer.
(func $ta_read (param $buf i32) (param $idx i32) (param $elem i32) (result f64) (effects)
  (let $a i32 (i32.add (local.get $buf) (i32.mul (local.get $idx) (call $ta_bpe (local.get $elem)))))
  (if f64 (i32.eq (local.get $elem) (i32.const 0)) (then (f64.convert_i32_s (i32.load8_s (local.get $a))))
  (else (if f64 (i32.or (i32.eq (local.get $elem) (i32.const 1)) (i32.eq (local.get $elem) (i32.const 2))) (then (f64.convert_i32_u (i32.load8_u (local.get $a))))
  (else (if f64 (i32.eq (local.get $elem) (i32.const 3)) (then (f64.convert_i32_s (i32.load16_s (local.get $a))))
  (else (if f64 (i32.eq (local.get $elem) (i32.const 4)) (then (f64.convert_i32_u (i32.load16_u (local.get $a))))
  (else (if f64 (i32.eq (local.get $elem) (i32.const 5)) (then (f64.convert_i32_s (i32.load (local.get $a))))
  (else (if f64 (i32.eq (local.get $elem) (i32.const 6)) (then (f64.convert_i32_u (i32.load (local.get $a))))
  (else (if f64 (i32.eq (local.get $elem) (i32.const 7)) (then (f64.promote_f32 (f32.load (local.get $a))))
  (else (f64.load (local.get $a)))))))))))))))))

;; write f64 value to element idx of a typed-array byte buffer (ToInt for int types).
(func $ta_write (param $buf i32) (param $idx i32) (param $elem i32) (param $val f64) (effects)
  (let $a i32 (i32.add (local.get $buf) (i32.mul (local.get $idx) (call $ta_bpe (local.get $elem)))))
  (if (i32.eq (local.get $elem) (i32.const 8)) (then (f64.store (local.get $a) (local.get $val)) (return)))
  (if (i32.eq (local.get $elem) (i32.const 7)) (then (f32.store (local.get $a) (f32.demote_f64 (local.get $val))) (return)))
  (if (i32.eq (local.get $elem) (i32.const 2))  ;; uint8clamped: clamp 0..255
    (then
      (let $cv f64 (local.get $val))
      (if (f64.ne (local.get $cv) (local.get $cv)) (then (set! $cv (f64.const 0))))
      (if (f64.lt (local.get $cv) (f64.const 0)) (then (set! $cv (f64.const 0))))
      (if (f64.gt (local.get $cv) (f64.const 255)) (then (set! $cv (f64.const 255))))
      (i32.store8 (local.get $a) (i32.trunc_f64_s (f64.nearest (local.get $cv)))) (return)))
  (let $iv i32 (call $to_int32 (call $num (local.get $val))))  ;; ToInt32 (handles NaN/Inf/wrap)
  (if (i32.le_s (local.get $elem) (i32.const 1)) (then (i32.store8 (local.get $a) (local.get $iv)) (return)))
  (if (i32.le_s (local.get $elem) (i32.const 4)) (then (i32.store16 (local.get $a) (local.get $iv)) (return)))
  (i32.store (local.get $a) (local.get $iv)))

;; read element idx as a JS value: BigInt64/BigUint64 (elem 9/10) → BigInt, else Number
(func $ta_read_val (param $buf i32) (param $idx i32) (param $elem i32) (result i64) (effects)
  (if i64 (i32.ge_s (local.get $elem) (i32.const 9))
    (then (call $mk_bigint (i64.load (i32.add (local.get $buf) (i32.mul (local.get $idx) (i32.const 8))))))
    (else (call $num (call $ta_read (local.get $buf) (local.get $idx) (local.get $elem))))))
;; store a JS value into element idx: BigInt64/BigUint64 require a BigInt (ToBigInt),
;; else ToNumber. Sets $err on a bad BigInt coercion.
(func $ta_store_val (param $buf i32) (param $idx i32) (param $elem i32) (param $val i64) (effects)
  (if (i32.ge_s (local.get $elem) (i32.const 9))
    (then
      (if (i32.eqz (call $is_bigint (local.get $val)))
        (then (call $throw_type (cstring "TypeError") (cstring "Cannot convert value to a BigInt")) (return)))
      (i64.store (i32.add (local.get $buf) (i32.mul (local.get $idx) (i32.const 8))) (call $bigint_val (local.get $val)))
      (return)))
  (call $ta_write (local.get $buf) (local.get $idx) (local.get $elem) (call $to_num (local.get $val))))

;; DataView element-code for a getter/setter index k (Int8,Uint8,Int16,Uint16,Int32,Uint32,Float32,Float64)
(func $dv_elem (param $k i32) (result i32) (effects)
  (if i32 (i32.le_s (local.get $k) (i32.const 1)) (then (local.get $k))  ;; 0 Int8, 1 Uint8
    (else (i32.add (local.get $k) (i32.const 1)))))  ;; 2→3 Int16, 3→4 Uint16, 4→5 Int32, 5→6 Uint32, 6→7 Float32, 7→8 Float64
;; read an `elem`-typed value at byte pointer `src`, honoring little/big endian.
;; wasm is little-endian; for big-endian, reverse the bytes through scratch @520.
(func $dv_read (param $src i32) (param $elem i32) (param $little i32) (result f64) (effects)
  (let $bpe i32 (call $ta_bpe (local.get $elem)))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $bpe)))
    (i32.store8 (i32.add (i32.const 520) (local.get $i))
      (i32.load8_u (i32.add (local.get $src) (if i32 (local.get $little) (then (local.get $i)) (else (i32.sub (i32.sub (local.get $bpe) (i32.const 1)) (local.get $i)))))))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
  (call $ta_read (i32.const 520) (i32.const 0) (local.get $elem)))
;; write an `elem`-typed value to byte pointer `dst`, honoring endianness.
(func $dv_write (param $dst i32) (param $elem i32) (param $little i32) (param $val f64) (effects)
  (let $bpe i32 (call $ta_bpe (local.get $elem)))
  (call $ta_write (i32.const 520) (i32.const 0) (local.get $elem) (local.get $val))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $bpe)))
    (i32.store8 (i32.add (local.get $dst) (if i32 (local.get $little) (then (local.get $i)) (else (i32.sub (i32.sub (local.get $bpe) (i32.const 1)) (local.get $i)))))
      (i32.load8_u (i32.add (i32.const 520) (local.get $i))))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l))))

;; read 8 bytes at `src` as i64, honoring endianness (via scratch @520)
(func $dv_read_i64 (param $src i32) (param $little i32) (result i64) (effects)
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (i32.const 8)))
    (i32.store8 (i32.add (i32.const 520) (local.get $i))
      (i32.load8_u (i32.add (local.get $src) (if i32 (local.get $little) (then (local.get $i)) (else (i32.sub (i32.const 7) (local.get $i)))))))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
  (i64.load (i32.const 520)))
;; write i64 `val` to 8 bytes at `dst`, honoring endianness
(func $dv_write_i64 (param $dst i32) (param $little i32) (param $val i64) (effects)
  (i64.store (i32.const 520) (local.get $val))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (i32.const 8)))
    (i32.store8 (i32.add (local.get $dst) (if i32 (local.get $little) (then (local.get $i)) (else (i32.sub (i32.const 7) (local.get $i)))))
      (i32.load8_u (i32.add (i32.const 520) (local.get $i))))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l))))

;; ToIndex(v): ToIntegerOrInfinity; <0 or >2^53-1 → RangeError (sets $err, returns 0)
(func $to_index (param $v i64) (result i32) (effects)
  (let $d f64 (call $to_num (local.get $v)))
  (if (call $err) (then (return (i32.const 0))))
  (if (f64.ne (local.get $d) (local.get $d)) (then (return (i32.const 0))))  ;; NaN → 0
  (set! $d (f64.trunc (local.get $d)))
  (if (f64.lt (local.get $d) (f64.const 0))
    (then (call $throw_type (cstring "RangeError") (cstring "index out of range")) (return (i32.const 0))))
  (if (f64.gt (local.get $d) (f64.const 9007199254740991))
    (then (call $throw_type (cstring "RangeError") (cstring "index out of range")) (return (i32.const 0))))
  (if (f64.ge (local.get $d) (f64.const 2147483647)) (then (return (i32.const 2147483647))))
  (i32.trunc_f64_s (local.get $d)))

