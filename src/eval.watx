(func $native_arity (param $id i32) (result i32) (effects)
  (if (i32.or (i32.eq (local.get $id) (i32.const 513)) (i32.eq (local.get $id) (i32.const 514))) (then (return (i32.const 1))))
  (if (i32.or (i32.eq (local.get $id) (i32.const 150)) (i32.or (i32.eq (local.get $id) (i32.const 420)) (i32.eq (local.get $id) (i32.const 421)))) (then (return (i32.const 1))))  ;; Generator/AsyncGenerator .next/.return/.throw — length 1
  (if (i32.or (i32.eq (local.get $id) (i32.const 516)) (i32.or (i32.eq (local.get $id) (i32.const 517)) (i32.eq (local.get $id) (i32.const 518)))) (then (return (i32.const 1))))  ;; AsyncGeneratorPrototype next/return/throw — length 1
