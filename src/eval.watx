      (let $marg i64 (call $argn (local.get $argv) (local.get $argc) (i32.const 0)))
      (if (i32.eqz (i32.or (call $is_null (local.get $marg)) (call $is_undefined (local.get $marg))))
        (then
          (let $madder i64 (call $get_prop (local.get $mov) (call $mk_str (cstring "set"))))  ;; honors a subclass override
          (if (call $err) (then (return (call $v_undef))))
          (if (i32.eqz (call $is_function (local.get $madder)))
            (then (call $throw_type (cstring "TypeError") (cstring "Map: 'set' is not callable")) (return (call $v_undef))))
          (let $mitf i64 (call $get_prop (local.get $marg) (call $mk_str (cstring "@@iterator"))))
          (if (call $err) (then (return (call $v_undef))))
          (if (i32.eqz (call $is_function (local.get $mitf)))
            (then (call $throw_type (cstring "TypeError") (cstring "Map argument is not iterable")) (return (call $v_undef))))
          (let $mit i64 (call $call_val (local.get $mitf) (i32.const 0) (call $heap_alloc (i32.const 8)) (local.get $marg)))
          (if (call $err) (then (return (call $v_undef))))
          (let $mnf i64 (call $get_prop (local.get $mit) (call $mk_str (cstring "next"))))
          (if (call $err) (then (return (call $v_undef))))
          (let $mbuf i32 (call $heap_alloc (i32.const 16)))
          (block $mce (loop $mcl
            (let $mr i64 (call $call_val (local.get $mnf) (i32.const 0) (local.get $mbuf) (local.get $mit)))
            (if (call $err) (then (return (call $v_undef))))  ;; next() threw → no close
            (if (i32.eqz (i32.or (call $is_object (local.get $mr)) (i32.or (call $is_array (local.get $mr)) (call $is_function (local.get $mr)))))
              (then (call $throw_type (cstring "TypeError") (cstring "iterator result is not an object")) (return (call $v_undef))))
            (br_if $mce (call $truthy (call $get_prop (local.get $mr) (call $mk_str (cstring "done")))))
            (if (call $err) (then (return (call $v_undef))))
            (let $mpair i64 (call $get_prop (local.get $mr) (call $mk_str (cstring "value"))))
            (if (call $err) (then (return (call $v_undef))))
