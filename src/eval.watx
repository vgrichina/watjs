      (call $scope_define (local.get $r) (cstring "writable") (call $mk_bool (call $entry_writable (local.get $slot))))))
  (call $scope_define (local.get $r) (cstring "enumerable") (call $mk_bool (call $entry_enumerable (local.get $slot))))
  (call $scope_define (local.get $r) (cstring "configurable") (call $mk_bool (call $entry_configurable (local.get $slot))))
  (call $mk_obj (local.get $r)))

;; native dispatch by id (1 = print, 2 = assert)
(func $call_native (param $id i32) (param $argc i32) (param $argv i32) (param $thisv i64) (result i64) (effects)
  (if (i32.eq (local.get $id) (i32.const 1))  ;; print (console.log style)
    (then
      (let $i i32 (i32.const 0))
      (block $e (loop $c
        (br_if $e (i32.ge_s (local.get $i) (local.get $argc)))
        (if (i32.gt_s (local.get $i) (i32.const 0)) (then (call $print_str (cstring " "))))
        (call $print_str (call $to_str (call $argn (local.get $argv) (local.get $argc) (local.get $i))))
        (set! $i (i32.add (local.get $i) (i32.const 1)))
