;; x ** y for integer y (repeated multiply); fractional y -> NaN (no transcendentals)
;; ── transcendental math (polynomial approximations + range reduction) ──
;; Accurate enough for special-value/metadata tests and ordinary use; not
;; guaranteed correctly-rounded to the last ULP.

;; e^x. Range-reduce x = k*ln2 + r, e^x = 2^k * e^r, e^r via degree-8 Taylor.
(func $m_exp (param $x f64) (result f64) (effects)
  (if (f64.ne (local.get $x) (local.get $x)) (then (return (local.get $x))))            ;; NaN
  (if (f64.gt (local.get $x) (f64.const 709.782712893384)) (then (return (f64.div (f64.const 1) (f64.const 0)))))   ;; +Inf
  (if (f64.lt (local.get $x) (f64.const -745.1332191019412)) (then (return (f64.const 0))))                          ;; +0
  (let $k f64 (f64.nearest (f64.div (local.get $x) (f64.const 0.6931471805599453))))
  ;; 2-part ln2 (fdlibm): ln2_hi has zero low bits so k*ln2_hi is exact; ln2_lo carries the rest
  (let $r f64 (f64.sub (f64.sub (local.get $x) (f64.mul (local.get $k) (f64.const 6.93147180369123816490e-01))) (f64.mul (local.get $k) (f64.const 1.90821492927058770002e-10))))
  (let $p f64 (f64.const 1.6059043836821613e-10))  ;; 1/13!
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $r)) (f64.const 2.08767569878681e-09)))     ;; 1/12!
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $r)) (f64.const 2.505210838544172e-08)))    ;; 1/11!
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $r)) (f64.const 2.755731922398589e-07)))    ;; 1/10!
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $r)) (f64.const 2.7557319223985893e-06)))   ;; 1/9!
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $r)) (f64.const 2.48015873015873e-05)))     ;; 1/8!
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $r)) (f64.const 1.984126984126984e-04)))
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $r)) (f64.const 1.388888888888889e-03)))
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $r)) (f64.const 8.333333333333333e-03)))
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $r)) (f64.const 4.1666666666666664e-02)))
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $r)) (f64.const 0.16666666666666666)))
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $r)) (f64.const 0.5)))
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $r)) (f64.const 1)))
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $r)) (f64.const 1)))
  (f64.mul (local.get $p) (call $f64_pow (f64.const 2) (local.get $k))))

;; cube root, correctly rounded for perfect cubes. Seed via exp(log|x|/3), then two
;; Newton-Raphson iterations y = (2y + a/y²)/3 (converges quadratically → exact f64).
(func $m_cbrt (param $x f64) (result f64) (effects)
  (if (f64.ne (local.get $x) (local.get $x)) (then (return (local.get $x))))  ;; NaN
  (if (f64.eq (local.get $x) (f64.const 0)) (then (return (local.get $x))))   ;; ±0
  (let $a f64 (f64.abs (local.get $x)))
  (if (f64.eq (local.get $a) (f64.div (f64.const 1) (f64.const 0))) (then (return (local.get $x))))  ;; ±Inf
  (let $y f64 (call $m_exp (f64.div (call $m_log (local.get $a)) (f64.const 3))))
  (set! $y (f64.div (f64.add (f64.mul (f64.const 2) (local.get $y)) (f64.div (local.get $a) (f64.mul (local.get $y) (local.get $y)))) (f64.const 3)))
  (set! $y (f64.div (f64.add (f64.mul (f64.const 2) (local.get $y)) (f64.div (local.get $a) (f64.mul (local.get $y) (local.get $y)))) (f64.const 3)))
  (f64.copysign (local.get $y) (local.get $x)))

;; ln(x). x = m*2^e with m in [1,2); ln(x) = e*ln2 + ln(m) via atanh series.
(func $m_log (param $x f64) (result f64) (effects)
  (if (f64.ne (local.get $x) (local.get $x)) (then (return (local.get $x))))            ;; NaN
  (if (f64.lt (local.get $x) (f64.const 0)) (then (return (f64.div (f64.const 0) (f64.const 0)))))  ;; <0 → NaN
  (if (f64.eq (local.get $x) (f64.const 0)) (then (return (f64.div (f64.const -1) (f64.const 0)))))  ;; ±0 → -Inf
  (if (f64.eq (local.get $x) (f64.div (f64.const 1) (f64.const 0))) (then (return (local.get $x))))  ;; +Inf
  (let $e f64 (f64.const 0))
  (let $m f64 (local.get $x))
  (block $d1 (loop $l1 (br_if $d1 (f64.lt (local.get $m) (f64.const 2))) (set! $m (f64.mul (local.get $m) (f64.const 0.5))) (set! $e (f64.add (local.get $e) (f64.const 1))) (br $l1)))
  (block $d2 (loop $l2 (br_if $d2 (f64.ge (local.get $m) (f64.const 1))) (set! $m (f64.mul (local.get $m) (f64.const 2))) (set! $e (f64.sub (local.get $e) (f64.const 1))) (br $l2)))
  ;; center m on [1/√2, √2) so t=(m-1)/(m+1) stays in [-0.172, 0.172] (atanh series converges fast)
  (if (f64.gt (local.get $m) (f64.const 1.4142135623730951))
    (then (set! $m (f64.mul (local.get $m) (f64.const 0.5))) (set! $e (f64.add (local.get $e) (f64.const 1)))))
  (let $t f64 (f64.div (f64.sub (local.get $m) (f64.const 1)) (f64.add (local.get $m) (f64.const 1))))
  (let $t2 f64 (f64.mul (local.get $t) (local.get $t)))
  (let $p f64 (f64.const 0.058823529411764705))  ;; 1/17
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $t2)) (f64.const 0.06666666666666667)))  ;; 1/15
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $t2)) (f64.const 0.07692307692307693)))  ;; 1/13
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $t2)) (f64.const 0.09090909090909091)))  ;; 1/11
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $t2)) (f64.const 0.1111111111111111)))   ;; 1/9
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $t2)) (f64.const 0.14285714285714285)))  ;; 1/7
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $t2)) (f64.const 0.2)))                   ;; 1/5
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $t2)) (f64.const 0.3333333333333333)))    ;; 1/3
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $t2)) (f64.const 1)))
  ;; 2-part ln2 so e*ln2 stays accurate for large |e|
  (f64.add (f64.add (f64.mul (local.get $e) (f64.const 6.93147180369123816490e-01)) (f64.mul (local.get $e) (f64.const 1.90821492927058770002e-10))) (f64.mul (f64.const 2) (f64.mul (local.get $t) (local.get $p)))))

;; sin(r)/cos(r) for small r via Taylor (used after quadrant reduction).
(func $m_sin_small (param $r f64) (result f64) (effects)
  (let $r2 f64 (f64.mul (local.get $r) (local.get $r)))
  (let $p f64 (f64.const -2.5052108385441720e-08))  ;; -1/11!
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $r2)) (f64.const 2.7557319223985893e-06)))  ;; 1/9!
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $r2)) (f64.const -1.9841269841269841e-04))) ;; -1/7!
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $r2)) (f64.const 8.333333333333333e-03)))   ;; 1/5!
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $r2)) (f64.const -0.16666666666666666)))    ;; -1/3!
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $r2)) (f64.const 1)))
  (f64.mul (local.get $r) (local.get $p)))
(func $m_cos_small (param $r f64) (result f64) (effects)
  (let $r2 f64 (f64.mul (local.get $r) (local.get $r)))
  (let $p f64 (f64.const 2.08767569878681e-09))    ;; 1/12!
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $r2)) (f64.const -2.7557319223985893e-07))) ;; -1/10!
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $r2)) (f64.const 2.48015873015873e-05)))    ;; 1/8!
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $r2)) (f64.const -1.388888888888889e-03)))  ;; -1/6!
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $r2)) (f64.const 4.1666666666666664e-02)))  ;; 1/4!
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $r2)) (f64.const -0.5)))                     ;; -1/2!
  (f64.add (f64.mul (local.get $p) (local.get $r2)) (f64.const 1)))

;; sin/cos with quadrant range reduction (n = round(x/(π/2)), r in [-π/4,π/4]).
(func $m_sin (param $x f64) (result f64) (effects)
  (if (f64.ne (local.get $x) (local.get $x)) (then (return (local.get $x))))
  (if (f64.eq (f64.abs (local.get $x)) (f64.div (f64.const 1) (f64.const 0))) (then (return (f64.div (f64.const 0) (f64.const 0)))))  ;; ±Inf → NaN
  (let $n f64 (f64.nearest (f64.div (local.get $x) (f64.const 1.5707963267948966))))
  (let $r f64 (f64.sub (local.get $x) (f64.mul (local.get $n) (f64.const 1.5707963267948966))))
  (let $q i64 (i64.and (i64.trunc_f64_s (local.get $n)) (i64.const 3)))
  (if (i64.lt_s (local.get $q) (i64.const 0)) (then (set! $q (i64.add (local.get $q) (i64.const 4)))))
  (if (i64.eq (local.get $q) (i64.const 0)) (then (return (call $m_sin_small (local.get $r)))))
  (if (i64.eq (local.get $q) (i64.const 1)) (then (return (call $m_cos_small (local.get $r)))))
  (if (i64.eq (local.get $q) (i64.const 2)) (then (return (f64.neg (call $m_sin_small (local.get $r))))))
  (f64.neg (call $m_cos_small (local.get $r))))
(func $m_cos (param $x f64) (result f64) (effects)
  (if (f64.ne (local.get $x) (local.get $x)) (then (return (local.get $x))))
  (if (f64.eq (f64.abs (local.get $x)) (f64.div (f64.const 1) (f64.const 0))) (then (return (f64.div (f64.const 0) (f64.const 0)))))
  (let $n f64 (f64.nearest (f64.div (local.get $x) (f64.const 1.5707963267948966))))
  (let $r f64 (f64.sub (local.get $x) (f64.mul (local.get $n) (f64.const 1.5707963267948966))))
  (let $q i64 (i64.and (i64.trunc_f64_s (local.get $n)) (i64.const 3)))
  (if (i64.lt_s (local.get $q) (i64.const 0)) (then (set! $q (i64.add (local.get $q) (i64.const 4)))))
  (if (i64.eq (local.get $q) (i64.const 0)) (then (return (call $m_cos_small (local.get $r)))))
  (if (i64.eq (local.get $q) (i64.const 1)) (then (return (f64.neg (call $m_sin_small (local.get $r))))))
  (if (i64.eq (local.get $q) (i64.const 2)) (then (return (f64.neg (call $m_cos_small (local.get $r))))))
  (call $m_sin_small (local.get $r)))

;; atan(x). |x|>1 → π/2 - atan(1/x); small |x| via series with one reduction step.
(func $m_atan (param $x f64) (result f64) (effects)
  (if (f64.ne (local.get $x) (local.get $x)) (then (return (local.get $x))))
  (if (f64.eq (local.get $x) (f64.div (f64.const 1) (f64.const 0))) (then (return (f64.const 1.5707963267948966))))   ;; +Inf → π/2
  (if (f64.eq (local.get $x) (f64.div (f64.const -1) (f64.const 0))) (then (return (f64.const -1.5707963267948966))))  ;; -Inf → -π/2
  (let $neg i32 (f64.lt (local.get $x) (f64.const 0)))
  (let $a f64 (f64.abs (local.get $x)))
  (let $inv i32 (f64.gt (local.get $a) (f64.const 1)))
  (if (local.get $inv) (then (set! $a (f64.div (f64.const 1) (local.get $a)))))
  ;; reduce a in [0,1] further: atan(a) = π/6 + atan((a*√3-1)/(a+√3)) when a>tan(π/12)
  (let $off f64 (f64.const 0))
  (if (f64.gt (local.get $a) (f64.const 0.2679491924311227))  ;; tan(15°)
    (then
      (set! $off (f64.const 0.5235987755982988))  ;; π/6
      (set! $a (f64.div (f64.sub (f64.mul (local.get $a) (f64.const 1.7320508075688772)) (f64.const 1)) (f64.add (local.get $a) (f64.const 1.7320508075688772))))))
  (let $a2 f64 (f64.mul (local.get $a) (local.get $a)))
  (let $p f64 (f64.const 0.06666666666666667))   ;; 1/15
  (set! $p (f64.sub (f64.const 0.07692307692307693) (f64.mul (local.get $p) (local.get $a2))))  ;; 1/13 - ...
  (set! $p (f64.sub (f64.const 0.09090909090909091) (f64.mul (local.get $p) (local.get $a2))))  ;; 1/11
  (set! $p (f64.sub (f64.const 0.1111111111111111) (f64.mul (local.get $p) (local.get $a2))))   ;; 1/9
  (set! $p (f64.sub (f64.const 0.14285714285714285) (f64.mul (local.get $p) (local.get $a2))))  ;; 1/7
  (set! $p (f64.sub (f64.const 0.2) (f64.mul (local.get $p) (local.get $a2))))                   ;; 1/5
  (set! $p (f64.sub (f64.const 0.3333333333333333) (f64.mul (local.get $p) (local.get $a2))))    ;; 1/3
  (set! $p (f64.sub (f64.const 1) (f64.mul (local.get $p) (local.get $a2))))
  (let $res f64 (f64.add (local.get $off) (f64.mul (local.get $a) (local.get $p))))
  (if (local.get $inv) (then (set! $res (f64.sub (f64.const 1.5707963267948966) (local.get $res)))))
  (if (local.get $neg) (then (set! $res (f64.neg (local.get $res)))))
  (local.get $res))

(func $f64_pow (param $x f64) (param $y f64) (result f64) (effects)
  ;; x**0 == 1 (incl NaN/Inf base)
  (if (f64.eq (local.get $y) (f64.const 0)) (then (return (f64.const 1))))
  ;; NaN exponent → NaN; NaN base with non-zero exponent → NaN
  (if (f64.ne (local.get $y) (local.get $y)) (then (return (f64.div (f64.const 0) (f64.const 0)))))
  (if (f64.ne (local.get $x) (local.get $x)) (then (return (f64.div (f64.const 0) (f64.const 0)))))
  ;; ±Infinity exponent → limit behavior: |x|>1 → (y>0?Inf:0); |x|<1 → (y>0?0:Inf);
  ;; |x|==1 → NaN (1^±Inf and (-1)^±Inf are NaN).
  (if (f64.eq (f64.abs (local.get $y)) (f64.div (f64.const 1) (f64.const 0)))
    (then
      (let $ax0 f64 (f64.abs (local.get $x)))
      (return (if f64 (f64.gt (local.get $ax0) (f64.const 1))
        (then (if f64 (f64.gt (local.get $y) (f64.const 0)) (then (f64.div (f64.const 1) (f64.const 0))) (else (f64.const 0))))
        (else (if f64 (f64.lt (local.get $ax0) (f64.const 1))
          (then (if f64 (f64.gt (local.get $y) (f64.const 0)) (then (f64.const 0)) (else (f64.div (f64.const 1) (f64.const 0)))))
          (else (f64.div (f64.const 0) (f64.const 0)))))))))
  ;; -Infinity base with a FINITE exponent: magnitude is +Inf (y>0) / +0 (y<0),
  ;; and the sign is negative iff y is an odd integer. (+Infinity base falls through
  ;; to exp/log or the multiply loop, both of which give the right answer.)
  (if (f64.eq (local.get $x) (f64.neg (f64.div (f64.const 1) (f64.const 0))))
    (then
      (let $imag f64 (if f64 (f64.gt (local.get $y) (f64.const 0)) (then (f64.div (f64.const 1) (f64.const 0))) (else (f64.const 0))))
      (let $iodd i32 (i32.and (f64.eq (local.get $y) (f64.trunc (local.get $y))) (f64.ne (f64.sub (f64.abs (local.get $y)) (f64.mul (f64.const 2) (f64.trunc (f64.div (f64.abs (local.get $y)) (f64.const 2))))) (f64.const 0))))
      (return (if f64 (local.get $iodd) (then (f64.neg (local.get $imag))) (else (local.get $imag))))))
  ;; finite NON-integer exponent (or an integer too large for the multiply loop):
  ;; |x|^y = exp(y·log|x|). A negative base needs an integer exponent (else NaN).
  ;; Critically, never i32.trunc an Inf/huge value (it traps).
  (if (i32.or (f64.ne (local.get $y) (f64.trunc (local.get $y))) (f64.ge (f64.abs (local.get $y)) (f64.const 1073741824)))
    (then
      (if (f64.eq (local.get $x) (f64.const 0))  ;; ±0 base: y>0 → +0, y<0 → +Inf
        (then (return (if f64 (f64.gt (local.get $y) (f64.const 0)) (then (f64.const 0)) (else (f64.div (f64.const 1) (f64.const 0)))))))
      (if (f64.gt (local.get $x) (f64.const 0))
        (then (return (call $m_exp (f64.mul (local.get $y) (call $m_log (local.get $x)))))))
      (if (f64.ne (local.get $y) (f64.trunc (local.get $y)))
        (then (return (f64.div (f64.const 0) (f64.const 0)))))  ;; negative base, non-integer exponent → NaN
      (let $pmag f64 (call $m_exp (f64.mul (local.get $y) (call $m_log (f64.neg (local.get $x))))))  ;; |x|^y
      (return (if f64 (f64.eq (f64.sub (f64.abs (local.get $y)) (f64.mul (f64.const 2) (f64.trunc (f64.div (f64.abs (local.get $y)) (f64.const 2))))) (f64.const 0))
        (then (local.get $pmag)) (else (f64.neg (local.get $pmag)))))))  ;; sign by parity of the integer exponent
  (let $n i32 (i32.trunc_f64_s (f64.abs (local.get $y))))
  (let $r f64 (f64.const 1))
  (let $i i32 (i32.const 0))
  (block $brk (loop $cont
    (br_if $brk (i32.ge_s (local.get $i) (local.get $n)))
    (set! $r (f64.mul (local.get $r) (local.get $x)))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $cont)))
  (if f64 (f64.lt (local.get $y) (f64.const 0)) (then (f64.div (f64.const 1) (local.get $r))) (else (local.get $r))))

;; create a standalone native function value (for attaching as a property)
