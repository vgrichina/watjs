;; relational compare: kind 29 < , 30 > , 31 <= , 32 >=

;; push every own key string of a property scope into $out (enumerable only,
;; unless $allNames); skips @@ internal/symbol keys.
(func $push_scope_keys (param $out i32) (param $sc i32) (param $allNames i32) (effects)
  (if (i32.eqz (local.get $sc)) (then (return)))
  (let $cnt i32 (call $scope_count (local.get $sc)))
  ;; spec OwnPropertyKeys order: integer-index keys ascending, THEN string keys in
  ;; insertion order. Pass 1 emits integer indices ascending (min-find, n is small).
  (let $last i32 (i32.const -1))
  (block $p1e (loop $p1l
    (let $best i32 (i32.const -1))
    (let $bestkey i32 (i32.const 0))
    (let $j i32 (i32.const 0))
    (block $se (loop $sl
      (br_if $se (i32.ge_s (local.get $j) (local.get $cnt)))
      (let $e i32 (call $scope_entry (local.get $sc) (local.get $j)))
      (let $kp i32 (i32.load (local.get $e)))
      (let $idx i32 (call $str_array_index (local.get $kp)))
      (if (i32.and (i32.ge_s (local.get $idx) (i32.const 0))
            (i32.and (i32.gt_s (local.get $idx) (local.get $last))
                     (i32.or (i32.eq (local.get $best) (i32.const -1)) (i32.lt_s (local.get $idx) (local.get $best)))))
        (then
          (if (i32.or (local.get $allNames) (i32.ne (call $entry_enumerable (i32.add (local.get $e) (i32.const 8))) (i32.const 0)))
            (then (set! $best (local.get $idx)) (set! $bestkey (local.get $kp))))))
      (set! $j (i32.add (local.get $j) (i32.const 1))) (br $sl)))
    (br_if $p1e (i32.eq (local.get $best) (i32.const -1)))
    (call $arr_push (local.get $out) (call $mk_str (local.get $bestkey)))
    (set! $last (local.get $best))
    (br $p1l)))
  ;; pass 2: non-integer string keys in insertion order
  (let $i i32 (i32.const 0))
  (block $ke (loop $kl
    (br_if $ke (i32.ge_s (local.get $i) (local.get $cnt)))
    (let $e2 i32 (call $scope_entry (local.get $sc) (local.get $i)))
    (let $kp2 i32 (i32.load (local.get $e2)))
    (if (i32.and (i32.lt_s (call $str_array_index (local.get $kp2)) (i32.const 0))
          (i32.and (i32.eqz (call $is_internal_key (local.get $kp2)))
            (i32.or (local.get $allNames) (i32.ne (call $entry_enumerable (i32.add (local.get $e2) (i32.const 8))) (i32.const 0)))))
      (then (call $arr_push (local.get $out) (call $mk_str (local.get $kp2)))))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $kl))))

;; membership test by SameValue over a key array
(func $key_in_arr (param $arr i32) (param $k i64) (result i32) (effects)
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (call $arr_len (local.get $arr))))
    (if (call $strict_eq (local.get $k) (call $arr_get (local.get $arr) (local.get $i))) (then (return (i32.const 1))))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
  (i32.const 0))

;; Proxy [[OwnPropertyKeys]] with a present trap: CreateListFromArrayLike with
;; key-type + duplicate validation, then the non-configurable / non-extensible
;; invariants. Returns the validated key array (i32); throws a TypeError otherwise.
(func $proxy_own_keys (param $px i64) (param $trap i64) (result i32) (effects)
  (let $tgt i64 (call $proxy_target (local.get $px)))
  (let $rawv i64 (call $call_val (local.get $trap) (i32.const 1) (call $argv1 (local.get $tgt)) (call $proxy_handler (local.get $px))))
  (if (call $err) (then (return (call $arr_new (i32.const 1)))))
  (if (i32.eqz (i32.or (call $is_object (local.get $rawv)) (i32.or (call $is_array (local.get $rawv)) (call $is_function (local.get $rawv)))))
    (then (call $throw_type (cstring "TypeError") (cstring "proxy ownKeys: trap result must be an object")) (return (call $arr_new (i32.const 1)))))
  (let $lenf f64 (call $to_num (call $get_prop (local.get $rawv) (call $mk_str (cstring "length")))))
  (if (call $err) (then (return (call $arr_new (i32.const 1)))))
  (let $n i32 (if i32 (f64.ge (local.get $lenf) (f64.const 0)) (then (i32.trunc_f64_s (local.get $lenf))) (else (i32.const 0))))
  (let $keys i32 (call $arr_new (i32.const 8)))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    (let $el i64 (call $get_prop (local.get $rawv) (call $num (f64.convert_i32_s (local.get $i)))))
    (if (call $err) (then (return (call $arr_new (i32.const 1)))))
    (if (i32.eqz (i32.or (call $is_string (local.get $el)) (call $is_symbol (local.get $el))))
      (then (call $throw_type (cstring "TypeError") (cstring "proxy ownKeys: trap result must contain only String and Symbol keys")) (return (call $arr_new (i32.const 1)))))
    (if (call $key_in_arr (local.get $keys) (local.get $el))
      (then (call $throw_type (cstring "TypeError") (cstring "proxy ownKeys: trap result must not contain duplicate keys")) (return (call $arr_new (i32.const 1)))))
    (call $arr_push (local.get $keys) (local.get $el))
