    (block $ce (loop $cl (br_if $ce (i32.ge_s (local.get $ci) (local.get $n))) (call $arr_set (local.get $arr) (local.get $ci) (call $arr_get (local.get $tmp) (local.get $ci))) (set! $ci (i32.add (local.get $ci) (i32.const 1))) (br $cl)))
    (set! $width (i32.mul (local.get $width) (i32.const 2)))
