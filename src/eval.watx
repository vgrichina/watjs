                (let $bp i32 (i32.or (call $is_bigint (local.get $b)) (i32.or (call $is_number (local.get $b)) (i32.or (call $is_string (local.get $b)) (call $is_boolean (local.get $b))))))
                (if i32 (i32.and (call $is_bigint (local.get $a)) (call $is_bigint (local.get $b)))
