  (i32.const 1))

;; own enumerable (or all, if $allNames) key strings of any value → fresh array.
;; Arrays yield "0".."len-1" then their @12 named-property keys.
(func $own_enum_keys (param $a i64) (param $allNames i32) (result i32) (effects)
  (let $out i32 (call $arr_new (i32.const 16)))
  ;; Proxy: [[OwnPropertyKeys]] via the ownKeys trap (validated) or the target's full key list. For
  ;; getOwnPropertyNames (allNames) return them as-is; for Object.keys/for-in, EnumerableOwnPropertyNames
  ;; calls the proxy's [[GetOwnProperty]] (the gOPD trap — observable) on each STRING key and keeps only
  ;; the enumerable ones. Previously all keys were returned unfiltered and the gOPD trap was never fired.
  (if (call $is_proxy (local.get $a))
    (then
      (let $okt i64 (call $proxy_trap (local.get $a) (cstring "ownKeys")))
      (if (call $err) (then (return (local.get $out))))
      (let $pkeys i32 (if i32 (call $is_function (local.get $okt))
        (then (call $proxy_own_keys (local.get $a) (local.get $okt)))
        (else (call $own_enum_keys (call $proxy_target (local.get $a)) (i32.const 1)))))  ;; all own names of the target
      (if (call $err) (then (return (local.get $out))))
      (if (local.get $allNames) (then (return (local.get $pkeys))))
      (let $pxi i32 (i32.const 0))
      (let $pxdb i32 (call $heap_alloc (i32.const 16)))
      (block $pxe (loop $pxl
        (br_if $pxe (i32.ge_s (local.get $pxi) (call $arr_len (local.get $pkeys))))
        (let $pxk i64 (call $arr_get (local.get $pkeys) (local.get $pxi)))
        (if (call $is_string (local.get $pxk))  ;; Object.keys/for-in ignore Symbol keys
          (then
            (i64.store (local.get $pxdb) (local.get $a))
            (i64.store (i32.add (local.get $pxdb) (i32.const 8)) (local.get $pxk))
            (let $pxd i64 (call $call_native (i32.const 156) (i32.const 2) (local.get $pxdb) (call $v_undef)))  ;; [[GetOwnProperty]] (gOPD trap)
            (if (call $err) (then (return (local.get $out))))
            (if (i32.eqz (call $is_undefined (local.get $pxd)))
              (then (if (call $truthy (call $get_prop (local.get $pxd) (call $mk_str (cstring "enumerable"))))
                (then (call $arr_push (local.get $out) (local.get $pxk))))))))
        (set! $pxi (i32.add (local.get $pxi) (i32.const 1))) (br $pxl)))
      (return (local.get $out))))
  (if (call $is_array (local.get $a))
    (then
      (let $aa i32 (call $val_payload (local.get $a)))
      (let $an i32 (call $arr_len (local.get $aa)))
      (let $ai i32 (i32.const 0))
      (block $ie (loop $il
        (br_if $ie (i32.ge_s (local.get $ai) (local.get $an)))
        ;; raw dense presence only — a deopted index reads as a hole here and is
        ;; emitted (with its real enumerable bit) by push_scope_keys over @12 below,
        ;; so it isn't double-counted.
        (if (i32.eqz (call $is_hole (i64.load (call $arr_slot (local.get $aa) (local.get $ai)))))
          (then (call $arr_push (local.get $out) (call $mk_str (call $num_to_str (f64.convert_i32_s (local.get $ai)))))))
        (set! $ai (i32.add (local.get $ai) (i32.const 1))) (br $il)))
      ;; `length` is a non-enumerable own prop — getOwnPropertyNames includes it
      ;; (after the indices), Object.keys/for-in (allNames=0) don't.
      (if (local.get $allNames) (then (call $arr_push (local.get $out) (call $mk_str (cstring "length")))))
      (call $push_scope_keys (local.get $out) (i32.load (i32.add (local.get $aa) (i32.const 12))) (local.get $allNames))
      (return (local.get $out))))
  (if (call $is_string (local.get $a))  ;; string: index chars (enumerable) then length (allNames only)
    (then
      (let $sp i32 (call $val_payload (local.get $a)))
      (let $sn i32 (call $str_len (local.get $sp)))
      (let $si i32 (i32.const 0))
      (block $ske (loop $skl
        (br_if $ske (i32.ge_s (local.get $si) (local.get $sn)))
        (call $arr_push (local.get $out) (call $mk_str (call $num_to_str (f64.convert_i32_s (local.get $si)))))
        (set! $si (i32.add (local.get $si) (i32.const 1))) (br $skl)))
      (if (local.get $allNames) (then (call $arr_push (local.get $out) (call $mk_str (cstring "length")))))
      (return (local.get $out))))
  (if (call $is_object (local.get $a))
    (then
      ;; TypedArray exotic [[OwnPropertyKeys]]: the canonical integer indices [0, length) in ascending
      ;; order FIRST (they live in the byte buffer, not the scope), then the scope's string/symbol keys.
      ;; (nested if — NOT i32.and — since scope_find_local would deref a non-object payload otherwise.)
      (if (i32.ne (call $scope_find_local (call $val_payload (local.get $a)) (cstring "@@taelem")) (i32.const 0))
        (then
          ;; a detached or out-of-bounds view has no in-bounds elements → no integer-index keys
          (let $talen i32 (if i32 (i32.or (call $ta_is_detached (local.get $a)) (call $ta_is_oob (local.get $a))) (then (i32.const 0)) (else (call $ta_live_len (local.get $a)))))
          (let $tai i32 (i32.const 0))
          (block $tae (loop $tal
            (br_if $tae (i32.ge_s (local.get $tai) (local.get $talen)))
            (call $arr_push (local.get $out) (call $mk_str (call $num_to_str (f64.convert_i32_s (local.get $tai)))))
            (set! $tai (i32.add (local.get $tai) (i32.const 1))) (br $tal)))))
      (call $push_scope_keys (local.get $out) (call $val_payload (local.get $a)) (local.get $allNames))))
  ;; functions can carry own enumerable props (fn.a=1, defineProperty): VM functions
  ;; keep them in the @(48+np*4) own-prop scope, natives in @12 fn_props.
  (if (call $is_function (local.get $a))
    (then
      (let $fp i32 (call $val_payload (local.get $a)))
      (let $fsc i32 (if i32 (i32.and (i32.ge_s (i32.load (local.get $fp)) (i32.const 1448232526)) (i32.le_s (i32.load (local.get $fp)) (i32.const 1448232528)))
        (then (call $fn_ownsc_peek (local.get $fp)))
        (else (i32.load (i32.add (local.get $fp) (i32.const 12))))))
      ;; getOwnPropertyNames includes the non-enumerable synthetic own keys length, name, prototype
      ;; (spec order: length, name, then own props, with prototype after name). Only in allNames mode,
      ;; and only when not already present as a defineProperty'd entry in the scope (avoid duplicates).
      (if (local.get $allNames)
        (then
          (if (i32.and (call $fn_own (local.get $fp) (cstring "length")) (i32.eqz (if i32 (local.get $fsc) (then (call $scope_find_local (local.get $fsc) (cstring "length"))) (else (i32.const 0)))))
            (then (call $arr_push (local.get $out) (call $mk_str (cstring "length")))))
          (if (i32.and (call $fn_own (local.get $fp) (cstring "name")) (i32.eqz (if i32 (local.get $fsc) (then (call $scope_find_local (local.get $fsc) (cstring "name"))) (else (i32.const 0)))))
            (then (call $arr_push (local.get $out) (call $mk_str (cstring "name")))))
          (if (i32.and (call $fn_own (local.get $fp) (cstring "prototype")) (i32.eqz (if i32 (local.get $fsc) (then (call $scope_find_local (local.get $fsc) (cstring "prototype"))) (else (i32.const 0)))))
            (then (call $arr_push (local.get $out) (call $mk_str (cstring "prototype")))))))
      (if (local.get $fsc) (then (call $push_scope_keys (local.get $out) (local.get $fsc) (local.get $allNames))))))
  (local.get $out))

;; for-in enumeration (EnumerateObjectProperties): own + INHERITED enumerable
;; string keys, walking the [[Prototype]] chain. A key already visited at a lower
;; level — enumerable OR not — shadows the same key higher up (so a non-enumerable
;; own prop hides an inherited enumerable one). Returns an Array of string-key values.
(func $for_in_keys (param $v i64) (result i32) (effects)
  (let $result i32 (call $arr_new (i32.const 16)))
  (let $seen i32 (call $scope_new (i32.const 0) (i32.const 16)))
  ;; ToObject for non-string primitives (a string keeps its index-char enumeration
  ;; via own_enum_keys); booleans/numbers/bigints/symbols box so the wrapper's
  ;; prototype chain (Boolean/Number/… .prototype) is enumerated.
  (let $cur i64 (local.get $v))
  (if (i32.or (call $is_number (local.get $v)) (i32.or (call $is_boolean (local.get $v)) (i32.or (call $is_bigint (local.get $v)) (call $is_symbol (local.get $v)))))
    (then (set! $cur (call $to_object (local.get $v)))))
  (block $done (loop $up
    (br_if $done (i32.eqz (i32.or (call $is_object (local.get $cur))
      (i32.or (call $is_array (local.get $cur))
        (i32.or (call $is_function (local.get $cur))
          (i32.or (call $is_string (local.get $cur)) (call $is_proxy (local.get $cur))))))))
    ;; yield this level's enumerable own keys that weren't shadowed lower down
    (let $ek i32 (call $own_enum_keys (local.get $cur) (i32.const 0)))
    (let $en i32 (call $arr_len (local.get $ek)))
    (let $i i32 (i32.const 0))
    (block $e1 (loop $l1
      (br_if $e1 (i32.ge_s (local.get $i) (local.get $en)))
      (let $kv i64 (call $arr_get (local.get $ek) (local.get $i)))
      (if (i32.eqz (call $scope_find_local (local.get $seen) (call $val_payload (local.get $kv))))
        (then (call $arr_push (local.get $result) (local.get $kv))))
      (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l1)))
    ;; mark ALL own keys (incl. non-enumerable) as seen → shadow higher levels
    (let $ak i32 (call $own_enum_keys (local.get $cur) (i32.const 1)))
    (let $an i32 (call $arr_len (local.get $ak)))
    (set! $i (i32.const 0))
    (block $e2 (loop $l2
      (br_if $e2 (i32.ge_s (local.get $i) (local.get $an)))
      (call $scope_define (local.get $seen) (call $val_payload (call $arr_get (local.get $ak) (local.get $i))) (call $v_true))
      (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l2)))
    (set! $cur (call $js_get_prototype (local.get $cur)))
    (br $up)))
  (local.get $result))

;; ── function calls & native builtins ──

(func $argn (param $argv i32) (param $argc i32) (param $i i32) (result i64) (effects)
  (if i64 (i32.lt_s (local.get $i) (local.get $argc))
    (then (i64.load (i32.add (local.get $argv) (i32.mul (local.get $i) (i32.const 8)))))
    (else (call $v_undef))))

;; days since the Unix epoch for a civil date (Howard Hinnant's algorithm).
;; y full year, m 1..12, d 1..31.
(func $days_from_civil (param $y i64) (param $m i64) (param $d i64) (result i64) (effects)
  (if (i64.le_s (local.get $m) (i64.const 2)) (then (set! $y (i64.sub (local.get $y) (i64.const 1)))))
  (let $era i64 (i64.div_s (if i64 (i64.ge_s (local.get $y) (i64.const 0)) (then (local.get $y)) (else (i64.sub (local.get $y) (i64.const 399)))) (i64.const 400)))
  (let $yoe i64 (i64.sub (local.get $y) (i64.mul (local.get $era) (i64.const 400))))
  (let $doy i64 (i64.add (i64.div_s (i64.add (i64.mul (i64.const 153) (i64.add (local.get $m) (if i64 (i64.gt_s (local.get $m) (i64.const 2)) (then (i64.const -3)) (else (i64.const 9))))) (i64.const 2)) (i64.const 5)) (i64.sub (local.get $d) (i64.const 1))))
  (let $doe i64 (i64.add (i64.sub (i64.add (i64.mul (local.get $yoe) (i64.const 365)) (i64.div_s (local.get $yoe) (i64.const 4))) (i64.div_s (local.get $yoe) (i64.const 100))) (local.get $doy)))
  (i64.sub (i64.add (i64.mul (local.get $era) (i64.const 146097)) (local.get $doe)) (i64.const 719468)))

;; ToInteger → i32 without trapping: NaN→0, ±Infinity/huge clamp to the i32
;; range, otherwise truncate toward zero. Used for length/index/count arguments
;; (i32.trunc_f64_s traps on NaN or out-of-i32-range floats).
(func $to_int_idx (param $v f64) (result i32) (effects)
  (if (f64.ne (local.get $v) (local.get $v)) (then (return (i32.const 0))))
  (if (f64.ge (local.get $v) (f64.const 2147483647)) (then (return (i32.const 2147483647))))
  (if (f64.le (local.get $v) (f64.const -2147483648)) (then (return (i32.const -2147483648))))
  (i32.trunc_f64_s (local.get $v)))

;; a plain Array of `len` holes.
(func $plain_array (param $len i32) (result i64) (effects)
  (let $pa i32 (call $arr_new (i32.add (local.get $len) (i32.const 1))))
  (call $arr_set_length (local.get $pa) (local.get $len))
  (call $mk_arr (local.get $pa)))

;; ArraySpeciesCreate(originalArray, length): the result-array constructor used by
;; map/filter/slice/splice/concat. Default (non-array source, no @@species, or the
;; species IS Array) → a plain Array; a custom constructor[@@species] is [[Construct]]
;; ed with [length]; a non-constructor species → TypeError.
(func $array_species_create (param $o i64) (param $len i32) (result i64) (effects)
  (if (i32.eqz (call $is_array (local.get $o))) (then (return (call $plain_array (local.get $len)))))
  (let $sctor i64 (call $get_prop (local.get $o) (call $mk_str (cstring "constructor"))))
  (if (call $err) (then (return (call $v_undef))))
  ;; a `constructor` that is neither undefined nor an Object (null/number/string/…) is not a
  ;; constructor → ArraySpeciesCreate throws a TypeError. (undefined → the default Array path.)
  (if (i32.and (i32.eqz (call $is_undefined (local.get $sctor)))
        (i32.eqz (i32.or (call $is_object (local.get $sctor)) (i32.or (call $is_function (local.get $sctor)) (call $is_array (local.get $sctor))))))
    (then (call $throw_type (cstring "TypeError") (cstring "Array constructor is not a constructor")) (return (call $v_undef))))
  (let $sspec i64 (call $v_undef))
  (if (i32.or (call $is_object (local.get $sctor)) (i32.or (call $is_function (local.get $sctor)) (call $is_array (local.get $sctor))))
    (then (set! $sspec (call $get_prop (local.get $sctor) (call $make_symbol (cstring "@@species") (cstring "Symbol.species"))))
      (if (call $err) (then (return (call $v_undef))))))
  (if (i32.or (call $is_undefined (local.get $sspec)) (call $is_null (local.get $sspec)))
    (then (return (call $plain_array (local.get $len)))))
  ;; the default Array constructor → plain array (skip the construct on the hot path)
  (let $aslot i32 (call $scope_find_local (i32.load (i32.const 152)) (cstring "Array")))
  (if (local.get $aslot)
    (then (if (call $strict_eq (local.get $sspec) (i64.load (local.get $aslot))) (then (return (call $plain_array (local.get $len)))))))
  (if (i32.eqz (call $is_constructor (local.get $sspec)))
    (then (call $throw_type (cstring "TypeError") (cstring "Array species is not a constructor")) (return (call $v_undef))))
  (let $sab i32 (call $heap_alloc (i32.const 8)))
  (i64.store (local.get $sab) (call $num (f64.convert_i32_s (local.get $len))))
  (call $vm_construct (local.get $sspec) (i32.const 1) (local.get $sab) (local.get $sspec)))

;; SpeciesConstructor(O, defaultConstructor): C=Get(O,"constructor"); undefined→default;
;; non-object→TypeError; S=Get(C,@@species); undefined/null→default; IsConstructor(S)→S; else TypeError.
(func $species_constructor (param $o i64) (param $default i64) (result i64) (effects)
  (let $spc i64 (call $get_prop (local.get $o) (call $mk_str (cstring "constructor"))))
  (if (call $err) (then (return (call $v_undef))))
  (if (call $is_undefined (local.get $spc)) (then (return (local.get $default))))
  (if (i32.eqz (i32.or (call $is_object (local.get $spc)) (i32.or (call $is_function (local.get $spc)) (call $is_array (local.get $spc)))))
    (then (call $throw_type (cstring "TypeError") (cstring "constructor is not an object")) (return (call $v_undef))))
  (let $sps i64 (call $get_prop (local.get $spc) (call $make_symbol (cstring "@@species") (cstring "Symbol.species"))))
  (if (call $err) (then (return (call $v_undef))))
  (if (i32.or (call $is_undefined (local.get $sps)) (call $is_null (local.get $sps))) (then (return (local.get $default))))
  (if (call $is_constructor (local.get $sps)) (then (return (local.get $sps))))
  (call $throw_type (cstring "TypeError") (cstring "@@species is not a constructor")) (call $v_undef))

;; CreateDataProperty(target, idx, val) for a species result (array or any object).
(func $cdp (param $target i64) (param $idx i32) (param $val i64) (effects)
  (if (call $is_array (local.get $target))
    (then (call $arr_set (call $val_payload (local.get $target)) (local.get $idx) (local.get $val)))
    (else (call $set_prop (local.get $target) (call $num (f64.convert_i32_s (local.get $idx))) (local.get $val)))))

;; CreateDataPropertyOrThrow(target, idx, val): define an OWN {W,E,C} data property via
;; [[DefineOwnProperty]] (bypasses inherited setters; throws on non-extensible / non-configurable).
;; For Array.of/Array.from with a custom constructor result. Sets $err on failure.
(func $cdp_throw (param $target i64) (param $idx i32) (param $val i64) (effects)
  (if (call $is_array (local.get $target))
    (then
      (let $cta i32 (call $val_payload (local.get $target)))
      ;; CreateDataProperty of a NEW index on a non-extensible array (@@noext) fails → throw
      (if (i32.eqz (call $arr_has (local.get $cta) (local.get $idx)))
        (then (let $ctp i32 (i32.load (i32.add (local.get $cta) (i32.const 12))))
          (if (local.get $ctp)
            (then (if (call $scope_find_local (local.get $ctp) (cstring "@@noext"))
              (then (call $throw_type (cstring "TypeError") (cstring "Cannot define property, object is not extensible")) (return)))))))
      (call $arr_set (local.get $cta) (local.get $idx) (local.get $val)) (return)))
  ;; a Proxy target: [[DefineOwnProperty]] must invoke the defineProperty trap (and propagate its
  ;; throw) — route through Reflect.defineProperty (native 206), not the ordinary-object fast path.
  (if (call $is_proxy (local.get $target))
    (then
      (let $cpd i64 (call $mk_obj (call $obj_new (i32.const 8))))
      (call $set_prop (local.get $cpd) (call $mk_str (cstring "value")) (local.get $val))
      (call $set_prop (local.get $cpd) (call $mk_str (cstring "writable")) (call $mk_bool (i32.const 1)))
      (call $set_prop (local.get $cpd) (call $mk_str (cstring "enumerable")) (call $mk_bool (i32.const 1)))
      (call $set_prop (local.get $cpd) (call $mk_str (cstring "configurable")) (call $mk_bool (i32.const 1)))
      (let $cpb i32 (call $heap_alloc (i32.const 24)))
      (i64.store (local.get $cpb) (local.get $target))
      (i64.store (i32.add (local.get $cpb) (i32.const 8)) (call $mk_str (call $num_to_str (f64.convert_i32_s (local.get $idx)))))
      (i64.store (i32.add (local.get $cpb) (i32.const 16)) (local.get $cpd))
      (drop (call $call_native (i32.const 206) (i32.const 3) (local.get $cpb) (call $v_undef)))
      (return)))
  (if (i32.or (call $is_object (local.get $target)) (call $is_function (local.get $target)))
    (then
      (let $cdsc i32 (call $val_payload (local.get $target)))
      (let $cdks i32 (call $num_to_str (f64.convert_i32_s (local.get $idx))))
      (let $cdslot i32 (call $scope_find_local (local.get $cdsc) (local.get $cdks)))
      (if (local.get $cdslot)
        (then  ;; existing own property — CreateDataProperty fails if it isn't configurable
          (if (i32.eqz (call $entry_configurable (local.get $cdslot)))
            (then (call $throw_type (cstring "TypeError") (cstring "Cannot redefine non-configurable property")) (return))))
        (else  ;; fresh property — fails if the object is non-extensible
          (if (call $scope_find_local (local.get $cdsc) (cstring "@@noext"))
            (then (call $throw_type (cstring "TypeError") (cstring "Cannot add property to a non-extensible object")) (return)))))
      (call $scope_define_attr (local.get $cdsc) (local.get $cdks) (local.get $val) (i32.const 14))  ;; {W,E,C}
      (return)))
  ;; proxy / other → best-effort [[Set]]
  (call $set_prop (local.get $target) (call $num (f64.convert_i32_s (local.get $idx))) (local.get $val)))

;; Read element $i of the receiver for a copying method (toReversed/with/toSorted/toSpliced).
;; Spec reads each source element via [[Get]] exactly ONCE. For a REAL array, `$arr` (the
;; alike_arr result) is the array payload itself, unread — so we must [[Get]] $thisv directly
;; (this inherits Array.prototype[i] for holes / OOB-after-length-shrink). For an array-LIKE
;; object, alike_arr ALREADY materialized every index via [[Get]] (firing getters in order),
;; so re-reading $thisv would DOUBLE-fire the getters and corrupt the observable read order —
;; instead read the already-materialized value from $arr. Sets $err if a real-array getter throws.
(func $copy_read (param $thisv i64) (param $arr i32) (param $i i32) (result i64)
  (if i64 (call $is_array (local.get $thisv))
    (then (call $get_prop (local.get $thisv) (call $num (f64.convert_i32_s (local.get $i)))))
    (else (call $arr_get (local.get $arr) (local.get $i)))))

;; HasProperty(O, i) for a dense-iterating array method (forEach/map/filter/reduce/
;; indexOf/…): present in the dense store, or — for a REAL-array receiver — inherited
;; from the prototype chain (Array.prototype[i]). The object array-like path already
;; materialized inherited indices into `arr` (js_in-gated in alike_arr), so its arr_has
;; is authoritative; gating the proto walk on is_array keeps the object path unchanged
;; and preserves the dense fast path for the common (unpolluted-prototype) case.
(func $dense_visit (param $thisv i64) (param $arr i32) (param $i i32) (result i32) (effects)
  ;; a TypedArray receiver: HasProperty(i) is a LIVE, resize-aware bounds check ([[HasProperty]]
  ;; is called each iteration per spec, so a resize inside the callback shrinks the visited range),
  ;; not the start-of-call snapshot. is_object gates the scope walk (i32.and is not short-circuit).
  ;; EXCEPTION — a DETACHED buffer: fall back to the start-of-call snapshot so a TA-native method
  ;; (map/filter, which delegate here) still visits every original index (Get yields undefined); only
  ;; a mid-iteration RESIZE shrinks the visited range.
  (if (call $is_object (local.get $thisv))
    (then (if (call $scope_find_local (call $val_payload (local.get $thisv)) (cstring "@@taelem"))
      (then
        (if (call $ta_is_detached (local.get $thisv)) (then (return (call $arr_has (local.get $arr) (local.get $i)))))
        (return (i32.lt_s (local.get $i) (call $ta_live_len (local.get $thisv))))))))
  (if (call $arr_has (local.get $arr) (local.get $i)) (then (return (i32.const 1))))
  (if (call $is_array (local.get $thisv))
    (then (return (call $truthy (call $js_in (call $num (f64.convert_i32_s (local.get $i))) (local.get $thisv))))))
  (i32.const 0))
;; the element value for a visited index: the dense element if present (fast path),
;; else — for a real array — the inherited value via [[Get]] on the prototype chain.
(func $dense_get (param $thisv i64) (param $arr i32) (param $i i32) (result i64) (effects)
  ;; a TypedArray receiver: read the element LIVE via [[Get]] (undefined past a mid-iteration shrink),
  ;; not from the start-of-call snapshot. is_object gates the scope walk (i32.and is not short-circuit).
  ;; EXCEPTION — a DETACHED buffer: fall back to the start-of-call snapshot (baseline behavior) so
  ;; HasProperty-style methods (indexOf/lastIndexOf) don't spuriously match a live `undefined`; only a
  ;; mid-iteration RESIZE reads live.
  (if (call $is_object (local.get $thisv))
    (then (if (call $scope_find_local (call $val_payload (local.get $thisv)) (cstring "@@taelem"))
      (then
        (if (call $ta_is_detached (local.get $thisv)) (then (return (call $arr_get (local.get $arr) (local.get $i)))))
        (return (call $get_prop (local.get $thisv) (call $num (f64.convert_i32_s (local.get $i)))))))))
  (if i64 (call $arr_has (local.get $arr) (local.get $i))
    (then (call $arr_get (local.get $arr) (local.get $i)))
    (else (if i64 (call $is_array (local.get $thisv))
      (then (call $get_prop (local.get $thisv) (call $num (f64.convert_i32_s (local.get $i)))))
      (else (call $arr_get (local.get $arr) (local.get $i)))))))

;; CopyDataProperties from a PROXY source (object spread `{...proxy}` / rest, Object.assign): spec
;; [[OwnPropertyKeys]] (ownKeys trap, in trap order incl. symbols), then per key [[GetOwnProperty]]
;; (gopd trap) and copy ONLY present + enumerable (and not in the exclusion list) via [[Get]]→[[Set]].
;; $excl = an exclusion-keys array payload for object-rest (0 = none). Propagates abrupt throws.
(func $copy_props_from_proxy (param $target i64) (param $src i64) (param $excl i32) (effects)
  (let $pkeys i32 (call $own_enum_keys (local.get $src) (i32.const 1)))  ;; ownKeys trap (validated)
  (if (call $err) (then (return)))
  (let $pi i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $pi) (call $arr_len (local.get $pkeys))))
    (let $pkey i64 (call $arr_get (local.get $pkeys) (local.get $pi)))
    ;; skip an excluded key (object-rest: the already-destructured property names)
    (if (local.get $excl)
      (then
