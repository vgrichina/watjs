;; Map/Set/ES2024-set-methods/WeakMap/WeakSet (120-136, 310-316, 320-328) — extracted
;; from call_native to keep that function under the compiler recursion limit.
;; create an array iterator (kind=values) over $arrval, then re-parent it to $protoreg's object
;; (e.g. %MapIteratorPrototype% reg 728 / %SetIteratorPrototype% reg 732) for the spec @@toStringTag.
(func $coll_iter (param $arrval i64) (param $protoreg i32) (result i64) (effects)
  (let $it i64 (call $call_native (i32.const 97) (i32.const 0) (call $heap_alloc (i32.const 8)) (local.get $arrval)))
  (if (i32.load (local.get $protoreg)) (then (i32.store (call $val_payload (local.get $it)) (i32.load (local.get $protoreg)))))
  (local.get $it))

;; count non-tombstone (non-hole) slots of a Map/Set backing array (@@mk/@@sk).
;; delete/clear leave tombstones (v_hole) in place so live iterators keep valid cursors.
(func $coll_count (param $arr i32) (result i32) (effects)
  (let $n i32 (call $arr_len (local.get $arr)))
  (let $i i32 (i32.const 0)) (let $c i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    (if (call $arr_has (local.get $arr) (local.get $i)) (then (set! $c (i32.add (local.get $c) (i32.const 1)))))  ;; arr_has=0 for a tombstone (raw hole slot); arr_get would normalize it to undefined
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
