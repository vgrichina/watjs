    (then
      (if (call $is_undefined (local.get $tdesc)) (then (return (call $v_undef))))
      (if (i32.eqz (call $truthy (call $get_prop (local.get $tdesc) (call $mk_str (cstring "configurable")))))
        (then (call $throw_type (cstring "TypeError") (cstring "proxy getOwnPropertyDescriptor: cannot report a non-configurable property as non-existent")) (return (call $v_undef))))
