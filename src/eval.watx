          (call $arr_flatten (local.get $fsrc) (local.get $fAv) (local.get $fdepth) (local.get $fidx))
          (if (call $err) (then (return (call $v_undef))))
          (return (local.get $fAv))))
      (if (i32.or (i32.eq (local.get $id) (i32.const 33)) (i32.eq (local.get $id) (i32.const 34)))  ;; findLast / findLastIndex
        (then
          (let $fli i32 (i32.sub (local.get $n) (i32.const 1)))
