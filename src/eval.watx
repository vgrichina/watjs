  (if (i32.eq (local.get $id) (i32.const 6))  ;; Boolean(x)
    (then (return (call $mk_bool (call $truthy (call $argn (local.get $argv) (local.get $argc) (i32.const 0)))))))
  (if (i32.eq (local.get $id) (i32.const 7))  ;; isNaN(x)
    (then (let $d f64 (call $to_num (call $argn (local.get $argv) (local.get $argc) (i32.const 0))))
