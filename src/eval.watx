;; numeric comparison for TypedArray default sort (ascending; NaN sorts last)
(func $num_cmp (param $a i64) (param $b i64) (result i32) (effects)
  (let $na f64 (call $to_num (local.get $a)))
  (let $nb f64 (call $to_num (local.get $b)))
