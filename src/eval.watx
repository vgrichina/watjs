          (if (i32.and (i32.eq (local.get $id) (i32.const 26)) (f64.gt (call $alike_len_f64 (local.get $thisv)) (f64.const 4294967295)))
            (then (call $throw_type (cstring "RangeError") (cstring "Invalid array length")) (return (call $v_undef))))
