            (br_if $flie (i32.lt_s (local.get $fli) (i32.const 0)))
            (let $fle i64 (call $dense_get (local.get $thisv) (local.get $arr) (local.get $fli)))  ;; findLast/findLastIndex Get every index (proto-inherited holes included)
            (let $fcb2 i32 (call $heap_alloc (i32.const 24)))
