;; apply a property descriptor (scope $ds) onto object scope $os at key $ks,
;; implementing the [[DefineOwnProperty]] validation + attribute-merge rules.
;; Throws TypeError (sets err) on an invalid (re)definition.
(func $apply_descriptor (param $os i32) (param $ks i32) (param $ds i32) (effects)
  (let $gs i32 (call $scope_find_local (local.get $ds) (cstring "get")))
  (let $ss i32 (call $scope_find_local (local.get $ds) (cstring "set")))
  (let $en i32 (call $scope_find_local (local.get $ds) (cstring "enumerable")))
  (let $cf i32 (call $scope_find_local (local.get $ds) (cstring "configurable")))
  (let $wr i32 (call $scope_find_local (local.get $ds) (cstring "writable")))
  (let $vs i32 (call $scope_find_local (local.get $ds) (cstring "value")))
  (let $isAcc i32 (i32.or (i32.ne (local.get $gs) (i32.const 0)) (i32.ne (local.get $ss) (i32.const 0))))
  (let $hasData i32 (i32.or (i32.ne (local.get $vs) (i32.const 0)) (i32.ne (local.get $wr) (i32.const 0))))
  ;; a descriptor cannot be both a data and an accessor descriptor
  (if (i32.and (local.get $isAcc) (local.get $hasData))
    (then (call $throw_type (cstring "TypeError") (cstring "Invalid property descriptor (data and accessor)")) (return)))
  (let $wantEnum i32 (i32.and (i32.ne (local.get $en) (i32.const 0)) (call $truthy (i64.load (local.get $en)))))
  (let $wantConf i32 (i32.and (i32.ne (local.get $cf) (i32.const 0)) (call $truthy (i64.load (local.get $cf)))))
  (let $wantWrit i32 (i32.and (i32.ne (local.get $wr) (i32.const 0)) (call $truthy (i64.load (local.get $wr)))))
  (let $old i32 (call $scope_find_local (local.get $os) (local.get $ks)))
  ;; entry_is_accessor derefs old-4, so compute it ONCE guarded (i32.and is not short-circuit)
  (let $oldAcc i32 (if i32 (i32.ne (local.get $old) (i32.const 0)) (then (call $entry_is_accessor (local.get $old))) (else (i32.const 0))))
  (if (i32.eqz (local.get $old))
    (then
      ;; new property: forbidden on a non-extensible object
      (if (call $scope_find_local (local.get $os) (cstring "@@noext"))
        (then (call $throw_type (cstring "TypeError") (cstring "Cannot define property, object is not extensible")) (return))))
    (else
      ;; redefining: if the existing prop is non-configurable, enforce the limits
      (if (i32.eqz (call $entry_configurable (local.get $old)))
        (then
          (if (local.get $wantConf) (then (call $throw_type (cstring "TypeError") (cstring "Cannot redefine non-configurable property")) (return)))
          (if (i32.and (i32.ne (local.get $en) (i32.const 0)) (i32.ne (i32.ne (local.get $wantEnum) (i32.const 0)) (i32.ne (call $entry_enumerable (local.get $old)) (i32.const 0))))
            (then (call $throw_type (cstring "TypeError") (cstring "Cannot redefine non-configurable property")) (return)))
          ;; cannot switch between data and accessor
          (if (i32.or (i32.and (local.get $isAcc) (i32.eqz (local.get $oldAcc))) (i32.and (local.get $hasData) (local.get $oldAcc)))
            (then (call $throw_type (cstring "TypeError") (cstring "Cannot redefine non-configurable property")) (return)))
          ;; non-writable data: cannot become writable nor change value
          (if (i32.and (i32.eqz (local.get $oldAcc)) (i32.eqz (call $entry_writable (local.get $old))))
            (then
              (if (local.get $wantWrit) (then (call $throw_type (cstring "TypeError") (cstring "Cannot redefine non-configurable property")) (return)))
              (if (i32.and (i32.ne (local.get $vs) (i32.const 0)) (i32.eqz (call $strict_eq (i64.load (local.get $vs)) (i64.load (local.get $old)))))
                (then (call $throw_type (cstring "TypeError") (cstring "Cannot redefine non-configurable property")) (return)))))))))
