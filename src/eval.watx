    (if (i32.and (i32.eqz (local.get $ext)) (i32.eqz (local.get $found)))
      (then (call $throw_type (cstring "TypeError") (cstring "proxy ownKeys: a key of a non-extensible target is missing from the result")) (return (call $arr_new (i32.const 1)))))
