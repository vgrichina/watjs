  (let $attrs i32 (if i32 (i32.ne (local.get $old) (i32.const 0)) (then (i32.and (call $entry_kind (local.get $old)) (i32.const 14))) (else (i32.const 0))))
  (if (i32.ne (local.get $en) (i32.const 0)) (then (set! $attrs (if i32 (local.get $wantEnum) (then (i32.or (local.get $attrs) (i32.const 2))) (else (i32.and (local.get $attrs) (i32.const -3)))))))
  (if (i32.ne (local.get $cf) (i32.const 0)) (then (set! $attrs (if i32 (local.get $wantConf) (then (i32.or (local.get $attrs) (i32.const 4))) (else (i32.and (local.get $attrs) (i32.const -5)))))))
  (if (local.get $treatAcc)
    (then
