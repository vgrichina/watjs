      (if (i32.or (call $is_array (local.get $proto)) (call $is_function (local.get $proto)))
        (then (call $scope_define (local.get $spsc) (cstring "@@protoval") (local.get $proto)))
        (else (drop (call $scope_delete (local.get $spsc) (cstring "@@protoval")))))
