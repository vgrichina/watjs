;; Proxy [[DefineOwnProperty]] invariant: after the trap returns true, validate
;; the user descriptor `desc` against the target's current own descriptor per
;; ValidateAndApplyPropertyDescriptor + the two extra proxy clauses (16b/16c).
;; Throws a TypeError on violation; otherwise returns silently.
(func $proxy_dp_check (param $tgt i64) (param $key i64) (param $desc i64) (effects)
  (let $pdb i32 (call $heap_alloc (i32.const 16)))
  (i64.store (local.get $pdb) (local.get $tgt))
  (i64.store (i32.add (local.get $pdb) (i32.const 8)) (local.get $key))
  (let $cur i64 (call $call_native (i32.const 156) (i32.const 2) (local.get $pdb) (call $v_undef)))  ;; getOwnPropertyDescriptor(tgt,key)
  (if (call $err) (then (return)))
  (let $ext i32 (call $truthy (call $call_native (i32.const 163) (i32.const 1) (call $argv1 (local.get $tgt)) (call $v_undef))))
  (if (call $err) (then (return)))
  (let $hasCfg i32 (call $truthy (call $js_in (call $mk_str (cstring "configurable")) (local.get $desc))))
  (let $dCfg i32 (call $truthy (call $get_prop (local.get $desc) (call $mk_str (cstring "configurable")))))
  (let $setCfgFalse i32 (i32.and (local.get $hasCfg) (i32.eqz (local.get $dCfg))))
  ;; targetDesc undefined
  (if (call $is_undefined (local.get $cur))
    (then
      (if (i32.eqz (local.get $ext))
        (then (call $throw_type (cstring "TypeError") (cstring "proxy defineProperty: cannot add property to a non-extensible target")) (return)))
      (if (local.get $setCfgFalse)
        (then (call $throw_type (cstring "TypeError") (cstring "proxy defineProperty: cannot define a non-configurable property absent on target")) (return)))
      (return)))
  ;; targetDesc exists
  (let $curCfg i32 (call $truthy (call $get_prop (local.get $cur) (call $mk_str (cstring "configurable")))))
  (let $curIsData i32 (call $truthy (call $js_in (call $mk_str (cstring "writable")) (local.get $cur))))
  (let $hasEnum i32 (call $truthy (call $js_in (call $mk_str (cstring "enumerable")) (local.get $desc))))
  (let $hasVal i32 (call $truthy (call $js_in (call $mk_str (cstring "value")) (local.get $desc))))
  (let $hasWr i32 (call $truthy (call $js_in (call $mk_str (cstring "writable")) (local.get $desc))))
  (let $hasGet i32 (call $truthy (call $js_in (call $mk_str (cstring "get")) (local.get $desc))))
  (let $hasSet i32 (call $truthy (call $js_in (call $mk_str (cstring "set")) (local.get $desc))))
