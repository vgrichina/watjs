                (if (i32.eq (local.get $id) (i32.const 26)) (then (if (i32.eqz (call $err)) (then (call $cdp_throw (local.get $rA) (local.get $i) (local.get $res))))))))  ;; map: CreateDataPropertyOrThrow at index (holes stay absent)
            (br_if $fe (call $err))
