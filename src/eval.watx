            (call $arr_set (local.get $mk) (local.get $mci) (call $v_hole)) (call $arr_set (local.get $mv) (local.get $mci) (call $v_hole))
            (set! $mci (i32.add (local.get $mci) (i32.const 1))) (br $mcl)))
