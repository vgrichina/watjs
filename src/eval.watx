  (if (i32.and (local.get $setCfgFalse) (local.get $curCfg))
    (then (call $throw_type (cstring "TypeError") (cstring "proxy defineProperty: incompatible non-configurable redefinition")) (return)))
  ;; 16a IsCompatible — only restrictive when the target property is non-configurable
  (if (i32.eqz (local.get $curCfg))
    (then
      (if (i32.and (local.get $hasCfg) (local.get $dCfg))
        (then (call $throw_type (cstring "TypeError") (cstring "proxy defineProperty: cannot make a non-configurable property configurable")) (return)))
      (if (local.get $hasEnum)
        (then
          (if (i32.ne (call $truthy (call $get_prop (local.get $cur) (call $mk_str (cstring "enumerable")))) (call $truthy (call $get_prop (local.get $desc) (call $mk_str (cstring "enumerable")))))
            (then (call $throw_type (cstring "TypeError") (cstring "proxy defineProperty: cannot change enumerability of a non-configurable property")) (return)))))
      ;; generic descriptor (no value/writable/get/set) imposes no further constraint
      (if (i32.or (local.get $hasVal) (i32.or (local.get $hasWr) (i32.or (local.get $hasGet) (local.get $hasSet))))
        (then
          ;; kind mismatch
          (if (i32.and (i32.or (local.get $hasVal) (local.get $hasWr)) (i32.eqz (local.get $curIsData)))
            (then (call $throw_type (cstring "TypeError") (cstring "proxy defineProperty: cannot change accessor to data on a non-configurable property")) (return)))
          (if (i32.and (i32.or (local.get $hasGet) (local.get $hasSet)) (local.get $curIsData))
            (then (call $throw_type (cstring "TypeError") (cstring "proxy defineProperty: cannot change data to accessor on a non-configurable property")) (return)))
          (if (local.get $curIsData)
            (then
              (if (i32.eqz (call $truthy (call $get_prop (local.get $cur) (call $mk_str (cstring "writable")))))
                (then  ;; current non-writable data
                  (if (i32.and (local.get $hasWr) (call $truthy (call $get_prop (local.get $desc) (call $mk_str (cstring "writable")))))
                    (then (call $throw_type (cstring "TypeError") (cstring "proxy defineProperty: cannot make a non-writable property writable")) (return)))
                  (if (local.get $hasVal)
                    (then (if (i32.eqz (call $same_value (call $get_prop (local.get $desc) (call $mk_str (cstring "value"))) (call $get_prop (local.get $cur) (call $mk_str (cstring "value")))))
                      (then (call $throw_type (cstring "TypeError") (cstring "proxy defineProperty: cannot change the value of a non-writable property")) (return))))))))
            (else  ;; current accessor
              (if (local.get $hasSet)
                (then (if (i32.eqz (call $same_value (call $get_prop (local.get $desc) (call $mk_str (cstring "set"))) (call $get_prop (local.get $cur) (call $mk_str (cstring "set")))))
                  (then (call $throw_type (cstring "TypeError") (cstring "proxy defineProperty: cannot change the setter of a non-configurable accessor")) (return)))))
              (if (local.get $hasGet)
                (then (if (i32.eqz (call $same_value (call $get_prop (local.get $desc) (call $mk_str (cstring "get"))) (call $get_prop (local.get $cur) (call $mk_str (cstring "get")))))
                  (then (call $throw_type (cstring "TypeError") (cstring "proxy defineProperty: cannot change the getter of a non-configurable accessor")) (return)))))))))))
