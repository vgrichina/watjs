    (i32.or (i32.eq (local.get $id) (i32.const 151)) (i32.or (i32.eq (local.get $id) (i32.const 414))  ;; Promise resolve/reject
    (i32.or (i32.eq (local.get $id) (i32.const 410)) (i32.or (i32.eq (local.get $id) (i32.const 411))  ;; Promise all/race
    (i32.or (i32.eq (local.get $id) (i32.const 412)) (i32.eq (local.get $id) (i32.const 413))))))))) (then (return (i32.const 1))))  ;; Promise allSettled/any — length 1
