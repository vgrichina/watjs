;; sin/cos with quadrant range reduction (n = round(x/(π/2)), r in [-π/4,π/4]).
(func $m_sin (param $x f64) (result f64) (effects)
  (if (f64.ne (local.get $x) (local.get $x)) (then (return (local.get $x))))
  (if (f64.eq (f64.abs (local.get $x)) (f64.div (f64.const 1) (f64.const 0))) (then (return (f64.div (f64.const 0) (f64.const 0)))))  ;; ±Inf → NaN
