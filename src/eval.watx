;; ToLength of an array-like's `length` as f64 (0 if NaN/negative; capped at 2^53-1).
;; Used by the generic array-like mutators to detect the 2^53-1 integer limit and
;; to address indices beyond the i32 range without overflow/looping.
;; A TypedArray's live [[ArrayLength]]. For a length-TRACKING view (@@tatrack) over a resizable
;; buffer, it is recomputed each read as (buffer.@@ablen − byteOffset) / bytesPerElement, clamped to
;; 0 when the byteOffset now exceeds the (shrunk) buffer. For a fixed-length view it is the stored
;; @@talen. Returns 0 for a non-TypedArray. Every internal @@talen read routes through this so a
;; resize is observed live.
;; scope-pointer variant (usable from obj.watx element paths which only hold the object scope).
(func $ta_live_len_p (param $pl i32) (result i32) (effects)
  (let $tln i32 (call $scope_find_local (local.get $pl) (cstring "@@talen")))
  (if (i32.eqz (local.get $tln)) (then (return (i32.const 0))))
  (let $stored i32 (i32.trunc_f64_s (call $tonum_raw (i64.load (local.get $tln)))))
  (let $track i32 (if i32 (call $scope_find_local (local.get $pl) (cstring "@@tatrack")) (then (i32.const 1)) (else (i32.const 0))))
  ;; locate the RESIZABLE backing buffer's current byteLength; a non-resizable backing (no @@abmax) or
  ;; an unavailable buffer object → a fixed view keeps its stored @@talen (zero change off the fast path).
  (let $lbsl i32 (call $scope_find_local (local.get $pl) (cstring "@@tabufobj")))
  (if (i32.eqz (local.get $lbsl)) (then (return (local.get $stored))))
  (let $lbuf i64 (i64.load (local.get $lbsl)))
  (if (i32.eqz (call $is_object (local.get $lbuf))) (then (return (local.get $stored))))
  (let $lbpl i32 (call $val_payload (local.get $lbuf)))
  (if (i32.eqz (call $scope_find_local (local.get $lbpl) (cstring "@@abmax"))) (then (return (local.get $stored))))  ;; non-resizable → stored
  (let $lablsl i32 (call $scope_find_local (local.get $lbpl) (cstring "@@ablen")))
  (if (i32.eqz (local.get $lablsl)) (then (return (local.get $stored))))
  (let $labl i32 (i32.trunc_f64_s (call $tonum_raw (i64.load (local.get $lablsl)))))
  (let $loff i32 (i32.trunc_f64_s (call $tonum_raw (i64.load (call $scope_find_local (local.get $pl) (cstring "@@taoffset"))))))
  (let $lbpe i32 (call $ta_bpe (i32.trunc_f64_s (call $tonum_raw (i64.load (call $scope_find_local (local.get $pl) (cstring "@@taelem")))))))
  (if (local.get $track)
    (then  ;; length-tracking: 0 if the offset is past the shrunk buffer, else (byteLength − offset)/bpe
      (if (i32.gt_s (local.get $loff) (local.get $labl)) (then (return (i32.const 0))))
      (return (i32.div_s (i32.sub (local.get $labl) (local.get $loff)) (local.get $lbpe)))))
  ;; fixed view: 0 if offset + length*bpe exceeds the buffer (out of bounds), else the stored @@talen
  (if (i64.gt_s (i64.add (i64.extend_i32_s (local.get $loff)) (i64.mul (i64.extend_i32_s (local.get $stored)) (i64.extend_i32_s (local.get $lbpe)))) (i64.extend_i32_s (local.get $labl))) (then (return (i32.const 0))))
  (local.get $stored))
(func $ta_live_len (param $thisv i64) (result i32) (effects)
  (if (i32.eqz (call $is_object (local.get $thisv))) (then (return (i32.const 0))))
  (call $ta_live_len_p (call $val_payload (local.get $thisv))))
;; 1 if $thisv is a FIXED-length TypedArray view over a RESIZABLE buffer that has since shrunk so the
;; view's byte range (offset + length*bpe) no longer fits — such a view is "out of bounds": its length
;; and all element access read as 0/undefined and ValidateTypedArray throws. Length-tracking views and
;; views over non-resizable buffers are never OOB.
(func $ta_is_oob (param $thisv i64) (result i32) (effects)
  (if (i32.eqz (call $is_object (local.get $thisv))) (then (return (i32.const 0))))
  (let $pl i32 (call $val_payload (local.get $thisv)))
  (if (i32.eqz (call $scope_find_local (local.get $pl) (cstring "@@taelem"))) (then (return (i32.const 0))))
  (let $istrack i32 (if i32 (call $scope_find_local (local.get $pl) (cstring "@@tatrack")) (then (i32.const 1)) (else (i32.const 0))))
  (let $obsl i32 (call $scope_find_local (local.get $pl) (cstring "@@tabufobj")))
  (if (i32.eqz (local.get $obsl)) (then (return (i32.const 0))))
  (let $obuf i64 (i64.load (local.get $obsl)))
  (if (i32.eqz (call $is_object (local.get $obuf))) (then (return (i32.const 0))))
  (let $obpl i32 (call $val_payload (local.get $obuf)))
  (if (i32.eqz (call $scope_find_local (local.get $obpl) (cstring "@@abmax"))) (then (return (i32.const 0))))  ;; non-resizable backing
  (let $oablsl i32 (call $scope_find_local (local.get $obpl) (cstring "@@ablen")))
  (if (i32.eqz (local.get $oablsl)) (then (return (i32.const 0))))
  (let $oabl i32 (i32.trunc_f64_s (call $tonum_raw (i64.load (local.get $oablsl)))))
  (let $ooff i32 (i32.trunc_f64_s (call $tonum_raw (i64.load (call $scope_find_local (local.get $pl) (cstring "@@taoffset"))))))
  ;; a length-TRACKING view is out of bounds only if its byteOffset exceeds the (shrunk) buffer
  ;; (offset == byteLength is still in bounds → a zero-length view); byteOffset/length then read 0.
  (if (local.get $istrack) (then (return (i32.gt_s (local.get $ooff) (local.get $oabl)))))
  ;; a FIXED view is out of bounds if offset + length*bpe exceeds the buffer.
  (let $olen i32 (i32.trunc_f64_s (call $tonum_raw (i64.load (call $scope_find_local (local.get $pl) (cstring "@@talen"))))))
  (let $obpe i32 (call $ta_bpe (i32.trunc_f64_s (call $tonum_raw (i64.load (call $scope_find_local (local.get $pl) (cstring "@@taelem")))))))
  (i64.gt_s (i64.add (i64.extend_i32_s (local.get $ooff)) (i64.mul (i64.extend_i32_s (local.get $olen)) (i64.extend_i32_s (local.get $obpe)))) (i64.extend_i32_s (local.get $oabl))))

(func $alike_len_f64 (param $thisv i64) (result f64) (effects)
  ;; a TypedArray's length is its internal [[ArrayLength]] (@@talen), not a (spoofable) own/
  ;; prototype "length" property; 0 when the backing buffer is detached.
  (if (call $is_object (local.get $thisv))
    (then
      (let $taln i32 (call $scope_find_local (call $val_payload (local.get $thisv)) (cstring "@@talen")))
      (if (local.get $taln)
        (then
          (if (call $ta_is_detached (local.get $thisv)) (then (return (f64.const 0))))
          (return (f64.convert_i32_s (call $ta_live_len (local.get $thisv))))))))
  (let $l f64 (call $to_num (call $get_prop (local.get $thisv) (call $mk_str (cstring "length")))))
  (if (f64.ne (local.get $l) (local.get $l)) (then (return (f64.const 0))))  ;; NaN
  (if (f64.le (local.get $l) (f64.const 0)) (then (return (f64.const 0))))
  (let $t f64 (f64.floor (local.get $l)))
  (if (f64.gt (local.get $t) (f64.const 9007199254740991)) (then (return (f64.const 9007199254740991))))
  (local.get $t))

;; Set the receiver's `length` to `valf`, throwing a TypeError if it can't be
;; written (spec mutators call Set(O,"length",..,Throw=true)). A non-object
;; receiver (string/primitive) and a non-writable own length both throw.
(func $set_length_throwing (param $thisv i64) (param $valf f64) (effects)
  (if (call $is_array (local.get $thisv))  ;; a real array's length is writable (unless frozen, which set_prop handles)
    (then (call $set_prop (local.get $thisv) (call $mk_str (cstring "length")) (call $num (local.get $valf))) (return)))
  (if (i32.eqz (call $is_object (local.get $thisv)))
    (then (call $throw_type (cstring "TypeError") (cstring "Cannot assign to read only property 'length'")) (return)))
  (let $sl i32 (call $scope_find_local (call $val_payload (local.get $thisv)) (cstring "length")))
  ;; Set(O,"length",v,Throw=true): an accessor is settable only if it has a setter (then set_prop
  ;; invokes it); a setterless accessor OR a non-writable data property is read-only → throw
  ;; (unconditionally, unlike a plain sloppy `o.length=v` which set_prop would silently ignore).
  (if (local.get $sl)
    (then
      (if (call $entry_is_accessor (local.get $sl))
        (then
          (if (i32.eqz (call $is_function (i64.load (i32.add (call $val_payload (i64.load (local.get $sl))) (i32.const 8)))))
            (then (call $throw_type (cstring "TypeError") (cstring "Cannot assign to read only property 'length'")) (return))))
        (else
          (if (i32.eqz (call $entry_writable (local.get $sl)))
            (then (call $throw_type (cstring "TypeError") (cstring "Cannot assign to read only property 'length'")) (return)))))))
  (call $set_prop (local.get $thisv) (call $mk_str (cstring "length")) (call $num (local.get $valf))))

;; ToLength of an array-like's `length` (0 if absent/negative), clamped to i32.
(func $alike_len (param $thisv i64) (result i32) (effects)
  (if (call $is_array (local.get $thisv)) (then (return (call $arr_len (call $val_payload (local.get $thisv))))))
  (if (call $is_object (local.get $thisv))  ;; TypedArray → internal [[ArrayLength]] (0 if detached)
    (then
      (let $taln i32 (call $scope_find_local (call $val_payload (local.get $thisv)) (cstring "@@talen")))
      (if (local.get $taln)
        (then
          (if (call $ta_is_detached (local.get $thisv)) (then (return (i32.const 0))))
          (return (call $ta_live_len (local.get $thisv)))))))
  (let $l i32 (call $to_int_idx (call $to_num (call $get_prop (local.get $thisv) (call $mk_str (cstring "length"))))))
  (if i32 (i32.lt_s (local.get $l) (i32.const 0)) (then (i32.const 0)) (else (local.get $l))))

;; View any value as a real array for the generic Array.prototype methods: a
;; real array is returned as-is (so mutators still mutate it); an array-like
;; object is materialized into a fresh array by reading length + indexed props
;; (capped to avoid OOM on huge lengths). Callbacks still receive the original
;; `this`, so e.g. Array.prototype.filter.call(Math, cb) sees Math as the 3rd arg.
(func $alike_arr (param $thisv i64) (result i32) (effects)
  (if (call $is_array (local.get $thisv)) (then (return (call $val_payload (local.get $thisv)))))
  (let $len i32 (call $alike_len (local.get $thisv)))
  ;; cap materialization (each index also allocates a key string); 1M overflowed
  ;; the heap on Infinity/huge `length` array-likes (OOB). 64K covers realistic
  ;; array-likes and lets huge-length sparse tests early-exit instead of crashing.
  (if (i32.gt_s (local.get $len) (i32.const 65536)) (then (set! $len (i32.const 65536))))
  (let $tmp i32 (call $arr_new (i32.add (local.get $len) (i32.const 1))))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $len)))
    ;; absent index (HasProperty false) → store a hole so iteration methods skip it,
    ;; matching real-array hole semantics for map/forEach/filter/some/every/reduce/…
    (if (call $truthy (call $js_in (call $num (f64.convert_i32_s (local.get $i))) (local.get $thisv)))
      (then (call $arr_set (local.get $tmp) (local.get $i) (call $get_prop (local.get $thisv) (call $num (f64.convert_i32_s (local.get $i))))))
      (else (call $arr_set (local.get $tmp) (local.get $i) (call $v_hole))))
    (br_if $e (call $err))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
  (i32.store (local.get $tmp) (local.get $len))  ;; preserve the full length even if the tail is absent
  (local.get $tmp))

;; safe to i64.trunc_f64_s? (finite and within i64 range — trunc traps otherwise)
(func $f64_safe_i64 (param $v f64) (result i32) (effects)
  (i32.and (f64.eq (local.get $v) (local.get $v))
    (i32.and (f64.lt (local.get $v) (f64.const 9.2e18)) (f64.gt (local.get $v) (f64.const -9.2e18)))))

;; epoch-ms from date components (UTC). month is 0-based per JS.
(func $date_make (param $y i64) (param $mo i64) (param $d i64) (param $h i64) (param $mi i64) (param $s i64) (param $ms i64) (result f64) (effects)
  ;; MakeDay: normalize month into [0,11], carrying into the year (Euclidean: floor div).
  (let $mq i64 (i64.div_s (local.get $mo) (i64.const 12)))
  (let $mr i64 (i64.rem_s (local.get $mo) (i64.const 12)))
  (if (i64.lt_s (local.get $mr) (i64.const 0)) (then (set! $mr (i64.add (local.get $mr) (i64.const 12))) (set! $mq (i64.sub (local.get $mq) (i64.const 1)))))
  (set! $y (i64.add (local.get $y) (local.get $mq)))
  (set! $mo (local.get $mr))
  (let $days i64 (call $days_from_civil (local.get $y) (i64.add (local.get $mo) (i64.const 1)) (local.get $d)))
  (let $dmr f64 (f64.convert_i64_s (i64.add (i64.add (i64.add (i64.add (i64.mul (local.get $days) (i64.const 86400000)) (i64.mul (local.get $h) (i64.const 3600000))) (i64.mul (local.get $mi) (i64.const 60000))) (i64.mul (local.get $s) (i64.const 1000))) (local.get $ms))))
  (if (i32.or (f64.ne (local.get $dmr) (local.get $dmr)) (f64.gt (f64.abs (local.get $dmr)) (f64.const 8640000000000000))) (then (return (f64.div (f64.const 0) (f64.const 0)))))
  (local.get $dmr))

;; extract a UTC date/time field from epoch ms. field: 0 year, 1 month(0-based),
;; 2 date, 3 weekday, 4 hours, 5 minutes, 6 seconds, 7 ms.
(func $date_field (param $msf f64) (param $field i32) (result i32) (effects)
  (let $ms i64 (i64.trunc_f64_s (local.get $msf)))
  (let $day i64 (i64.div_s (local.get $ms) (i64.const 86400000)))
  (if (i32.and (i64.lt_s (local.get $ms) (i64.const 0)) (i64.ne (local.get $ms) (i64.mul (local.get $day) (i64.const 86400000))))
    (then (set! $day (i64.sub (local.get $day) (i64.const 1)))))
  (let $tod i64 (i64.sub (local.get $ms) (i64.mul (local.get $day) (i64.const 86400000))))
  (if (i32.eq (local.get $field) (i32.const 4)) (then (return (i32.wrap_i64 (i64.div_s (local.get $tod) (i64.const 3600000))))))
  (if (i32.eq (local.get $field) (i32.const 5)) (then (return (i32.wrap_i64 (i64.rem_s (i64.div_s (local.get $tod) (i64.const 60000)) (i64.const 60))))))
  (if (i32.eq (local.get $field) (i32.const 6)) (then (return (i32.wrap_i64 (i64.rem_s (i64.div_s (local.get $tod) (i64.const 1000)) (i64.const 60))))))
  (if (i32.eq (local.get $field) (i32.const 7)) (then (return (i32.wrap_i64 (i64.rem_s (local.get $tod) (i64.const 1000))))))
  (if (i32.eq (local.get $field) (i32.const 3)) (then (return (i32.wrap_i64 (i64.rem_s (i64.add (i64.rem_s (i64.add (local.get $day) (i64.const 4)) (i64.const 7)) (i64.const 7)) (i64.const 7))))))
  ;; civil_from_days
  (let $z i64 (i64.add (local.get $day) (i64.const 719468)))
  (let $era i64 (i64.div_s (if i64 (i64.ge_s (local.get $z) (i64.const 0)) (then (local.get $z)) (else (i64.sub (local.get $z) (i64.const 146096)))) (i64.const 146097)))
  (let $doe i64 (i64.sub (local.get $z) (i64.mul (local.get $era) (i64.const 146097))))
  (let $yoe i64 (i64.div_s (i64.sub (i64.add (i64.sub (local.get $doe) (i64.div_s (local.get $doe) (i64.const 1460))) (i64.div_s (local.get $doe) (i64.const 36524))) (i64.div_s (local.get $doe) (i64.const 146096))) (i64.const 365)))
  (let $yy i64 (i64.add (local.get $yoe) (i64.mul (local.get $era) (i64.const 400))))
  (let $doy i64 (i64.sub (local.get $doe) (i64.add (i64.sub (i64.mul (i64.const 365) (local.get $yoe)) (i64.div_s (local.get $yoe) (i64.const 100))) (i64.div_s (local.get $yoe) (i64.const 4)))))
  (let $mp i64 (i64.div_s (i64.add (i64.mul (i64.const 5) (local.get $doy)) (i64.const 2)) (i64.const 153)))
  (let $dd i64 (i64.add (i64.sub (local.get $doy) (i64.div_s (i64.add (i64.mul (i64.const 153) (local.get $mp)) (i64.const 2)) (i64.const 5))) (i64.const 1)))
  (let $mm i64 (if i64 (i64.lt_s (local.get $mp) (i64.const 10)) (then (i64.add (local.get $mp) (i64.const 3))) (else (i64.sub (local.get $mp) (i64.const 9)))))
  (if (i64.le_s (local.get $mm) (i64.const 2)) (then (set! $yy (i64.add (local.get $yy) (i64.const 1)))))
  (if (i32.eq (local.get $field) (i32.const 0)) (then (return (i32.wrap_i64 (local.get $yy)))))
  (if (i32.eq (local.get $field) (i32.const 1)) (then (return (i32.wrap_i64 (i64.sub (local.get $mm) (i64.const 1))))))
  (return (i32.wrap_i64 (local.get $dd))))

;; TypedArray element types: 0 int8,1 uint8,2 uint8clamped,3 int16,4 uint16,
;; 5 int32,6 uint32,7 float32,8 float64.
(func $ta_bpe (param $elem i32) (result i32) (effects)
  (if i32 (i32.eq (local.get $elem) (i32.const 11)) (then (i32.const 2))  ;; 11 Float16 = 2 bytes
    (else (if i32 (i32.le_s (local.get $elem) (i32.const 2)) (then (i32.const 1))
    (else (if i32 (i32.le_s (local.get $elem) (i32.const 4)) (then (i32.const 2))
    (else (if i32 (i32.ge_s (local.get $elem) (i32.const 8)) (then (i32.const 8)) (else (i32.const 4))))))))))  ;; 8 Float64, 9 BigInt64, 10 BigUint64 = 8 bytes

;; read element idx (as f64) from a typed-array byte buffer.
(func $ta_read (param $buf i32) (param $idx i32) (param $elem i32) (result f64) (effects)
  (let $a i32 (i32.add (local.get $buf) (i32.mul (local.get $idx) (call $ta_bpe (local.get $elem)))))
  (if f64 (i32.eq (local.get $elem) (i32.const 0)) (then (f64.convert_i32_s (i32.load8_s (local.get $a))))
  (else (if f64 (i32.or (i32.eq (local.get $elem) (i32.const 1)) (i32.eq (local.get $elem) (i32.const 2))) (then (f64.convert_i32_u (i32.load8_u (local.get $a))))
  (else (if f64 (i32.eq (local.get $elem) (i32.const 3)) (then (f64.convert_i32_s (i32.load16_s (local.get $a))))
  (else (if f64 (i32.eq (local.get $elem) (i32.const 4)) (then (f64.convert_i32_u (i32.load16_u (local.get $a))))
  (else (if f64 (i32.eq (local.get $elem) (i32.const 5)) (then (f64.convert_i32_s (i32.load (local.get $a))))
  (else (if f64 (i32.eq (local.get $elem) (i32.const 6)) (then (f64.convert_i32_u (i32.load (local.get $a))))
  (else (if f64 (i32.eq (local.get $elem) (i32.const 7)) (then (f64.promote_f32 (f32.load (local.get $a))))
  (else (if f64 (i32.eq (local.get $elem) (i32.const 11)) (then (call $f16_decode (i32.load16_u (local.get $a))))
  (else (f64.load (local.get $a)))))))))))))))))))

;; write f64 value to element idx of a typed-array byte buffer (ToInt for int types).
(func $ta_write (param $buf i32) (param $idx i32) (param $elem i32) (param $val f64) (effects)
  (let $a i32 (i32.add (local.get $buf) (i32.mul (local.get $idx) (call $ta_bpe (local.get $elem)))))
  (if (i32.eq (local.get $elem) (i32.const 8)) (then (f64.store (local.get $a) (local.get $val)) (return)))
  (if (i32.eq (local.get $elem) (i32.const 7)) (then (f32.store (local.get $a) (f32.demote_f64 (local.get $val))) (return)))
  (if (i32.eq (local.get $elem) (i32.const 11)) (then (i32.store16 (local.get $a) (call $f16_encode (local.get $val))) (return)))  ;; Float16
  (if (i32.eq (local.get $elem) (i32.const 2))  ;; uint8clamped: clamp 0..255
    (then
      (let $cv f64 (local.get $val))
      (if (f64.ne (local.get $cv) (local.get $cv)) (then (set! $cv (f64.const 0))))
      (if (f64.lt (local.get $cv) (f64.const 0)) (then (set! $cv (f64.const 0))))
      (if (f64.gt (local.get $cv) (f64.const 255)) (then (set! $cv (f64.const 255))))
      (i32.store8 (local.get $a) (i32.trunc_f64_s (f64.nearest (local.get $cv)))) (return)))
  (let $iv i32 (call $to_int32 (call $num (local.get $val))))  ;; ToInt32 (handles NaN/Inf/wrap)
  (if (i32.le_s (local.get $elem) (i32.const 1)) (then (i32.store8 (local.get $a) (local.get $iv)) (return)))
  (if (i32.le_s (local.get $elem) (i32.const 4)) (then (i32.store16 (local.get $a) (local.get $iv)) (return)))
  (i32.store (local.get $a) (local.get $iv)))

;; read element idx as a JS value: BigInt64/BigUint64 (elem 9/10) → BigInt, else Number
(func $ta_read_val (param $buf i32) (param $idx i32) (param $elem i32) (result i64) (effects)
  (if i64 (i32.and (i32.ge_s (local.get $elem) (i32.const 9)) (i32.le_s (local.get $elem) (i32.const 10)))
    (then (call $mk_bigint (i64.load (i32.add (local.get $buf) (i32.mul (local.get $idx) (i32.const 8))))))
    (else (call $num (call $ta_read (local.get $buf) (local.get $idx) (local.get $elem))))))
;; %TypedArray%.from(source[, mapfn[, thisArg]]). `this` is a constructor C (not necessarily a
;; concrete TypedArray ctor): materialize the source (iterable → drain, else array-like), apply the
;; mapper, then build the result. A concrete TA ctor takes the direct build path; otherwise
;; TypedArrayCreate(C, «len») constructs via C and Sets each value (so a mapper that detaches the
;; result drops out-of-bounds writes, per [[Set]]).
(func $ta_from_impl (param $thisv i64) (param $argc i32) (param $argv i32) (result i64) (effects)
  (if (i32.eqz (call $is_constructor (local.get $thisv)))
    (then (call $throw_type (cstring "TypeError") (cstring "TypedArray.from requires a constructor as this")) (return (call $v_undef))))
  (let $tfsrc i64 (call $argn (local.get $argv) (local.get $argc) (i32.const 0)))
  (if (i32.or (call $is_null (local.get $tfsrc)) (call $is_undefined (local.get $tfsrc)))
    (then (call $throw_type (cstring "TypeError") (cstring "TypedArray.from source is null or undefined")) (return (call $v_undef))))
  (let $tfmap i64 (call $argn (local.get $argv) (local.get $argc) (i32.const 1)))
  (if (i32.and (i32.eqz (call $is_undefined (local.get $tfmap))) (i32.eqz (call $is_function (local.get $tfmap))))
    (then (call $throw_type (cstring "TypeError") (cstring "TypedArray.from mapfn is not callable")) (return (call $v_undef))))
  (let $tfa i32 (call $arr_new (i32.const 4)))
  (if (i32.or (call $is_string (local.get $tfsrc)) (i32.or (call $is_array (local.get $tfsrc))
              (i32.and (call $is_object (local.get $tfsrc)) (call $is_function (call $get_prop (local.get $tfsrc) (call $mk_str (cstring "@@iterator")))))))
    (then (call $spread_into (local.get $tfa) (local.get $tfsrc)))
    (else (set! $tfa (call $alike_arr (local.get $tfsrc)))))
  (if (call $err) (then (return (call $v_undef))))
  (if (call $is_function (local.get $tfmap))
    (then
      (let $tharg i64 (call $argn (local.get $argv) (local.get $argc) (i32.const 2)))
      (let $tfi i32 (i32.const 0))
      (let $tfb i32 (call $heap_alloc (i32.const 16)))
      (block $tfe (loop $tfl
        (br_if $tfe (i32.ge_s (local.get $tfi) (call $arr_len (local.get $tfa))))
        (i64.store (local.get $tfb) (call $arr_get (local.get $tfa) (local.get $tfi)))
        (i64.store (i32.add (local.get $tfb) (i32.const 8)) (call $num (f64.convert_i32_s (local.get $tfi))))
        (call $arr_set (local.get $tfa) (local.get $tfi) (call $call_val (local.get $tfmap) (i32.const 2) (local.get $tfb) (local.get $tharg)))
        (if (call $err) (then (return (call $v_undef))))
        (set! $tfi (i32.add (local.get $tfi) (i32.const 1))) (br $tfl)))))
  (let $tflen i32 (call $arr_len (local.get $tfa)))
  (let $tfelem i32 (call $ta_ctor_elem (local.get $thisv)))
  (if (i32.ge_s (local.get $tfelem) (i32.const 0))
    (then  ;; a concrete TypedArray constructor → build directly
      (let $tfbuf i32 (call $heap_alloc (i32.const 8)))
      (i64.store (local.get $tfbuf) (call $mk_arr (local.get $tfa)))
      (return (call $ta_make (local.get $tfelem) (i32.const 1) (local.get $tfbuf)))))
  ;; TypedArrayCreate(C, «len»): construct via C, validate it's a TypedArray, Set each value
  (let $ab i32 (call $heap_alloc (i32.const 8)))
  (i64.store (local.get $ab) (call $num (f64.convert_i32_s (local.get $tflen))))
  (let $res i64 (call $vm_construct (local.get $thisv) (i32.const 1) (local.get $ab) (local.get $thisv)))
  (if (call $err) (then (return (call $v_undef))))
  (if (i32.eqz (call $is_object (local.get $res)))
    (then (call $throw_type (cstring "TypeError") (cstring "TypedArray.from constructor did not return an object")) (return (call $v_undef))))
  (if (i32.eqz (call $scope_find_local (call $val_payload (local.get $res)) (cstring "@@taelem")))
    (then (call $throw_type (cstring "TypeError") (cstring "TypedArray.from constructor did not return a TypedArray")) (return (call $v_undef))))
  ;; TypedArrayCreate(C, «len»): the constructed TypedArray must be at least `len` long
  (if (i32.lt_s (i32.trunc_f64_s (call $tonum_raw (i64.load (call $scope_find_local (call $val_payload (local.get $res)) (cstring "@@talen"))))) (local.get $tflen))
    (then (call $throw_type (cstring "TypeError") (cstring "TypedArray.from constructor returned a too-small TypedArray")) (return (call $v_undef))))
  (let $si i32 (i32.const 0))
  (block $sfe (loop $sfl
    (br_if $sfe (i32.ge_s (local.get $si) (local.get $tflen)))
    (call $set_prop (local.get $res) (call $num (f64.convert_i32_s (local.get $si))) (call $arr_get (local.get $tfa) (local.get $si)))
    (if (call $err) (then (return (call $v_undef))))
    (set! $si (i32.add (local.get $si) (i32.const 1))) (br $sfl)))
  (local.get $res))

;; TypedArray.prototype.set copy loop. A TypedArray source may share the target's buffer, so
;; snapshot its element values before writing (an interleaved read/write would corrupt an
;; overlapping range); an array-like source has observable getters, so copy interleaved.
(func $ta_set_copy (param $stbuf i32) (param $stoff i32) (param $stelem i32) (param $src i64) (param $srclen i32) (effects)
  (let $srcta i32 (if i32 (call $is_object (local.get $src)) (then (call $scope_find_local (call $val_payload (local.get $src)) (cstring "@@taelem"))) (else (i32.const 0))))
  (if (local.get $srcta)
    (then
      (let $tmp i32 (call $heap_alloc (i32.mul (if i32 (i32.gt_s (local.get $srclen) (i32.const 0)) (then (local.get $srclen)) (else (i32.const 1))) (i32.const 8))))
      (let $i i32 (i32.const 0))
      (block $e (loop $l (br_if $e (i32.ge_s (local.get $i) (local.get $srclen)))
        (i64.store (i32.add (local.get $tmp) (i32.mul (local.get $i) (i32.const 8))) (call $get_prop (local.get $src) (call $num (f64.convert_i32_s (local.get $i)))))
        (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
      (set! $i (i32.const 0))
      (block $e2 (loop $l2 (br_if $e2 (i32.ge_s (local.get $i) (local.get $srclen)))
        (call $ta_store_val (local.get $stbuf) (i32.add (local.get $stoff) (local.get $i)) (local.get $stelem) (i64.load (i32.add (local.get $tmp) (i32.mul (local.get $i) (i32.const 8)))))
        (if (call $err) (then (return)))
        (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l2)))
      (return)))
  (let $j i32 (i32.const 0))
  (block $e3 (loop $l3 (br_if $e3 (i32.ge_s (local.get $j) (local.get $srclen)))
    (call $ta_store_val (local.get $stbuf) (i32.add (local.get $stoff) (local.get $j)) (local.get $stelem) (call $get_prop (local.get $src) (call $num (f64.convert_i32_s (local.get $j)))))
    (if (call $err) (then (return)))
    (set! $j (i32.add (local.get $j) (i32.const 1))) (br $l3))))

;; ToBigInt(value): BigInt→itself, Boolean→0n/1n, String→StringToBigInt (SyntaxError on a
;; non-integer numeric string), Object→ToPrimitive(number) then recurse; Number/Symbol/null/
;; undefined→TypeError. Sets $err on failure. (Distinct from BigInt(x), which DOES accept Numbers.)
;; StringToBigInt: parse a string as a BigInt integer literal. Valid = whitespace-trimmed integer
;; (decimal with optional sign, or 0x/0o/0b radix) — NO decimal point, NO exponent, NO Infinity/NaN.
;; Returns the BigInt value, or sets err + a SyntaxError and returns undefined. (Reuses str_to_num
;; for whitespace handling + value; adds the integer-literal format validation str_to_num lacks.)
(func $bigint_str_value (param $ks i32) (result i64) (effects)
  (let $sn f64 (call $str_to_num (local.get $ks)))
  (let $bad i32 (i32.const 0))
  (if (f64.ne (local.get $sn) (local.get $sn)) (then (set! $bad (i32.const 1))))                         ;; NaN (unparseable)
  (if (f64.gt (f64.abs (local.get $sn)) (f64.const 1.7976931348623157e308)) (then (set! $bad (i32.const 1))))  ;; Infinity
  (if (f64.ne (local.get $sn) (f64.trunc (local.get $sn))) (then (set! $bad (i32.const 1))))             ;; non-integer ("1.5")
  ;; scan for '.' (decimal point) and 'e'/'E' (exponent) — but 'e'/'E' are hex digits in a 0x literal.
  (let $hex i32 (i32.ge_s (call $str_find (local.get $ks) (cstring "0x") (i32.const 0)) (i32.const 0)))
  (if (i32.eqz (local.get $hex)) (then (if (i32.ge_s (call $str_find (local.get $ks) (cstring "0X") (i32.const 0)) (i32.const 0)) (then (set! $hex (i32.const 1))))))
  (let $sl i32 (call $str_len (local.get $ks)))
  (let $si i32 (i32.const 0))
  (block $se (loop $sloop
    (br_if $se (i32.ge_s (local.get $si) (local.get $sl)))
    (let $c i32 (call $str_byte (local.get $ks) (local.get $si)))
    (if (i32.eq (local.get $c) (i32.const 46)) (then (set! $bad (i32.const 1))))  ;; '.'
    (if (i32.eqz (local.get $hex)) (then (if (i32.or (i32.eq (local.get $c) (i32.const 101)) (i32.eq (local.get $c) (i32.const 69))) (then (set! $bad (i32.const 1))))))  ;; 'e'/'E' exponent
    (set! $si (i32.add (local.get $si) (i32.const 1))) (br $sloop)))
  (if (local.get $bad)
    (then (call $throw_type (cstring "SyntaxError") (cstring "Cannot convert string to a BigInt")) (return (call $v_undef))))
  (call $mk_bigint (call $f64_sat_i64 (local.get $sn))))

(func $to_bigint (param $v i64) (result i64) (effects)
  (let $p i64 (local.get $v))
  (if (i32.or (call $is_object (local.get $v)) (i32.or (call $is_array (local.get $v)) (call $is_function (local.get $v))))
    (then (set! $p (call $to_primitive (local.get $v))) (if (call $err) (then (return (call $v_undef))))))
  (if (call $is_bigint (local.get $p)) (then (return (local.get $p))))
  (if (call $is_boolean (local.get $p)) (then (return (call $mk_bigint (i64.extend_i32_u (call $val_payload (local.get $p)))))))
  (if (call $is_string (local.get $p))
    (then (return (call $bigint_str_value (call $val_payload (local.get $p))))))
  (call $throw_type (cstring "TypeError") (cstring "Cannot convert value to a BigInt")) (call $v_undef))

;; store a JS value into element idx: BigInt64/BigUint64 do ToBigInt, else ToNumber.
;; Sets $err on a bad coercion.
(func $ta_store_val (param $buf i32) (param $idx i32) (param $elem i32) (param $val i64) (effects)
  (if (i32.and (i32.ge_s (local.get $elem) (i32.const 9)) (i32.le_s (local.get $elem) (i32.const 10)))
    (then
      (let $bv i64 (call $to_bigint (local.get $val)))
      (if (call $err) (then (return)))
      (i64.store (i32.add (local.get $buf) (i32.mul (local.get $idx) (i32.const 8))) (call $bigint_val (local.get $bv)))
      (return)))
  (call $ta_write (local.get $buf) (local.get $idx) (local.get $elem) (call $to_num (local.get $val))))

;; DataView element-code for a getter/setter index k (Int8,Uint8,Int16,Uint16,Int32,Uint32,Float32,Float64)
(func $dv_elem (param $k i32) (result i32) (effects)
  (if i32 (i32.le_s (local.get $k) (i32.const 1)) (then (local.get $k))  ;; 0 Int8, 1 Uint8
    (else (i32.add (local.get $k) (i32.const 1)))))  ;; 2→3 Int16, 3→4 Uint16, 4→5 Int32, 5→6 Uint32, 6→7 Float32, 7→8 Float64
;; read an `elem`-typed value at byte pointer `src`, honoring little/big endian.
;; wasm is little-endian; for big-endian, reverse the bytes through scratch @520.
(func $dv_read (param $src i32) (param $elem i32) (param $little i32) (result f64) (effects)
  ;; NOTE: DataView endian scratch buffer moved 520→780 (8 bytes): @520-527 overlapped ArrayBuffer.prototype @524, so an 8-byte DataView write corrupted it (→ crash on next ArrayBuffer use).
  (let $bpe i32 (call $ta_bpe (local.get $elem)))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $bpe)))
    (i32.store8 (i32.add (i32.const 780) (local.get $i))
      (i32.load8_u (i32.add (local.get $src) (if i32 (local.get $little) (then (local.get $i)) (else (i32.sub (i32.sub (local.get $bpe) (i32.const 1)) (local.get $i)))))))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
  (call $ta_read (i32.const 780) (i32.const 0) (local.get $elem)))
;; write an `elem`-typed value to byte pointer `dst`, honoring endianness.
(func $dv_write (param $dst i32) (param $elem i32) (param $little i32) (param $val f64) (effects)
  (let $bpe i32 (call $ta_bpe (local.get $elem)))
  (call $ta_write (i32.const 780) (i32.const 0) (local.get $elem) (local.get $val))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $bpe)))
    (i32.store8 (i32.add (local.get $dst) (if i32 (local.get $little) (then (local.get $i)) (else (i32.sub (i32.sub (local.get $bpe) (i32.const 1)) (local.get $i)))))
      (i32.load8_u (i32.add (i32.const 780) (local.get $i))))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l))))

;; read 8 bytes at `src` as i64, honoring endianness (via scratch @520)
(func $dv_read_i64 (param $src i32) (param $little i32) (result i64) (effects)
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (i32.const 8)))
    (i32.store8 (i32.add (i32.const 780) (local.get $i))
      (i32.load8_u (i32.add (local.get $src) (if i32 (local.get $little) (then (local.get $i)) (else (i32.sub (i32.const 7) (local.get $i)))))))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
  (i64.load (i32.const 780)))
;; write i64 `val` to 8 bytes at `dst`, honoring endianness
(func $dv_write_i64 (param $dst i32) (param $little i32) (param $val i64) (effects)
  (i64.store (i32.const 780) (local.get $val))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (i32.const 8)))
    (i32.store8 (i32.add (local.get $dst) (if i32 (local.get $little) (then (local.get $i)) (else (i32.sub (i32.const 7) (local.get $i)))))
      (i32.load8_u (i32.add (i32.const 780) (local.get $i))))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l))))

;; decode an IEEE-754 binary16 (half-float) bit pattern $h (low 16 bits) → f64
(func $f16_decode (param $h i32) (result f64) (effects)
  (let $sign i32 (i32.and (i32.shr_u (local.get $h) (i32.const 15)) (i32.const 1)))
  (let $exp i32 (i32.and (i32.shr_u (local.get $h) (i32.const 10)) (i32.const 31)))
  (let $mant i32 (i32.and (local.get $h) (i32.const 1023)))
  (let $v f64 (f64.const 0))
  (if (i32.eq (local.get $exp) (i32.const 31))
    (then (set! $v (if f64 (i32.eqz (local.get $mant)) (then (f64.div (f64.const 1) (f64.const 0))) (else (f64.div (f64.const 0) (f64.const 0))))))
    (else (if (i32.eqz (local.get $exp))
      (then (set! $v (f64.mul (f64.convert_i32_u (local.get $mant)) (f64.const 5.9604644775390625e-08))))  ;; subnormal: mant * 2^-24
      (else  ;; normal: (1 + mant/1024) * 2^(exp-15)
        (let $pw f64 (f64.reinterpret_i64 (i64.shl (i64.extend_i32_s (i32.add (i32.sub (local.get $exp) (i32.const 15)) (i32.const 1023))) (i64.const 52))))
        (set! $v (f64.mul (f64.add (f64.const 1) (f64.div (f64.convert_i32_u (local.get $mant)) (f64.const 1024))) (local.get $pw)))))))
  ;; apply sign only to non-NaN (negating a NaN yields a -NaN bit pattern that the
  ;; NaN-boxing would alias to undefined); JS NaN is sign-agnostic anyway
  (if f64 (i32.and (local.get $sign) (f64.eq (local.get $v) (local.get $v))) (then (f64.neg (local.get $v))) (else (local.get $v))))

;; encode f64 $x to an IEEE-754 binary16 bit pattern (round-half-even)
(func $f16_encode (param $x f64) (result i32) (effects)
  (if (f64.ne (local.get $x) (local.get $x)) (then (return (i32.const 32256))))  ;; NaN → 0x7E00
  (let $sign i32 (if i32 (f64.lt (f64.copysign (f64.const 1) (local.get $x)) (f64.const 0)) (then (i32.const 32768)) (else (i32.const 0))))  ;; 0x8000
  (let $a f64 (f64.abs (local.get $x)))
  (if (f64.ge (local.get $a) (f64.const 65520)) (then (return (i32.or (local.get $sign) (i32.const 31744)))))  ;; ≥ overflow → Inf 0x7C00
  (if (f64.eq (local.get $a) (f64.const 0)) (then (return (local.get $sign))))
  ;; round |x| to binary16 precision: quantum = 2^(E-10) clamped to 2^-24
  (let $e i32 (i32.sub (i32.wrap_i64 (i64.and (i64.shr_u (i64.reinterpret_f64 (local.get $a)) (i64.const 52)) (i64.const 2047))) (i32.const 1023)))
  (let $qe i32 (i32.sub (local.get $e) (i32.const 10)))
  (if (i32.lt_s (local.get $qe) (i32.const -24)) (then (set! $qe (i32.const -24))))
  (let $q f64 (f64.reinterpret_i64 (i64.shl (i64.extend_i32_s (i32.add (local.get $qe) (i32.const 1023))) (i64.const 52))))
  (let $r f64 (f64.mul (f64.nearest (f64.div (local.get $a) (local.get $q))) (local.get $q)))  ;; binary16-exact rounded magnitude
  (if (f64.gt (local.get $r) (f64.const 65504)) (then (return (i32.or (local.get $sign) (i32.const 31744)))))  ;; rounded up past max → Inf
  (if (f64.lt (local.get $r) (f64.const 6.103515625e-05))  ;; < 2^-14 → subnormal
    (then (return (i32.or (local.get $sign) (i32.trunc_f64_s (f64.add (f64.mul (local.get $r) (f64.const 16777216)) (f64.const 0.5)))))))  ;; mant = r * 2^24
  (let $re i32 (i32.sub (i32.wrap_i64 (i64.and (i64.shr_u (i64.reinterpret_f64 (local.get $r)) (i64.const 52)) (i64.const 2047))) (i32.const 1023)))
  (let $pw f64 (f64.reinterpret_i64 (i64.shl (i64.extend_i32_s (i32.add (local.get $re) (i32.const 1023))) (i64.const 52))))
  (let $m i32 (i32.trunc_f64_s (f64.add (f64.mul (f64.sub (f64.div (local.get $r) (local.get $pw)) (f64.const 1)) (f64.const 1024)) (f64.const 0.5))))  ;; mantissa
  (i32.or (local.get $sign) (i32.or (i32.shl (i32.add (local.get $re) (i32.const 15)) (i32.const 10)) (local.get $m))))

;; read/write 2 bytes at a pointer as binary16, honoring endianness
(func $dv_read_f16 (param $src i32) (param $little i32) (result f64) (effects)
  (let $lo i32 (i32.load8_u (i32.add (local.get $src) (if i32 (local.get $little) (then (i32.const 0)) (else (i32.const 1))))))
  (let $hi i32 (i32.load8_u (i32.add (local.get $src) (if i32 (local.get $little) (then (i32.const 1)) (else (i32.const 0))))))
  (call $f16_decode (i32.or (local.get $lo) (i32.shl (local.get $hi) (i32.const 8)))))
(func $dv_write_f16 (param $dst i32) (param $little i32) (param $val f64) (effects)
  (let $h i32 (call $f16_encode (local.get $val)))
  (i32.store8 (i32.add (local.get $dst) (if i32 (local.get $little) (then (i32.const 0)) (else (i32.const 1)))) (i32.and (local.get $h) (i32.const 255)))
  (i32.store8 (i32.add (local.get $dst) (if i32 (local.get $little) (then (i32.const 1)) (else (i32.const 0)))) (i32.and (i32.shr_u (local.get $h) (i32.const 8)) (i32.const 255))))

;; GetViewByteLength + IsViewOutOfBounds for a DataView: the effective byteLength against the CURRENT
;; buffer length (@@ablen, updated on resize). Throws TypeError (sets err, returns 0) if out of bounds:
;; a length-tracking view when its offset exceeds the buffer, a fixed view when offset+length does.
;; For a non-resizable buffer this always returns @@dvlen (offset+length was validated at construction).
(func $dv_cur_len (param $thisv i64) (result i32) (effects)
  (let $ab i64 (call $get_prop (local.get $thisv) (call $mk_str (cstring "@@dvab"))))
  (let $off i32 (call $to_int_idx (call $to_num (call $get_prop (local.get $thisv) (call $mk_str (cstring "@@dvoff"))))))
  (let $len i32 (call $to_int_idx (call $to_num (call $get_prop (local.get $thisv) (call $mk_str (cstring "@@dvlen"))))))
  (let $tracksl i32 (call $scope_find_local (call $val_payload (local.get $thisv)) (cstring "@@dvtrack")))
  (let $track i32 (if i32 (local.get $tracksl) (then (call $truthy (i64.load (local.get $tracksl)))) (else (i32.const 0))))
  (let $buflen i32 (call $to_int_idx (call $to_num (call $get_prop (local.get $ab) (call $mk_str (cstring "@@ablen"))))))
  (if (local.get $track)
    (then
      (if (i32.gt_s (local.get $off) (local.get $buflen))
        (then (call $throw_type (cstring "TypeError") (cstring "DataView is out of bounds")) (return (i32.const 0))))
      (return (i32.sub (local.get $buflen) (local.get $off))))
    (else
      (if (i32.gt_s (i32.add (local.get $off) (local.get $len)) (local.get $buflen))
        (then (call $throw_type (cstring "TypeError") (cstring "DataView is out of bounds")) (return (i32.const 0))))
      (return (local.get $len))))
  (i32.const 0))

;; DataView getFloat16(476)/setFloat16(477) — separate from the 364-379 elem-typed methods
(func $dv_float16 (param $id i32) (param $argc i32) (param $argv i32) (param $thisv i64) (result i64) (effects)
  (if (i32.eqz (call $is_object (local.get $thisv)))
    (then (call $throw_type (cstring "TypeError") (cstring "DataView method called on incompatible receiver")) (return (call $v_undef))))
  (if (i32.eqz (call $scope_find_local (call $val_payload (local.get $thisv)) (cstring "@@dvab")))
    (then (call $throw_type (cstring "TypeError") (cstring "DataView method called on incompatible receiver")) (return (call $v_undef))))
  (let $boff i32 (call $to_index (call $argn (local.get $argv) (local.get $argc) (i32.const 0))))
  (if (call $err) (then (return (call $v_undef))))
  (let $dvab i64 (call $get_prop (local.get $thisv) (call $mk_str (cstring "@@dvab"))))
  (let $voff i32 (call $to_int_idx (call $to_num (call $get_prop (local.get $thisv) (call $mk_str (cstring "@@dvoff"))))))
  (let $abptr i32 (call $to_int_idx (call $to_num (call $get_prop (local.get $dvab) (call $mk_str (cstring "@@abdata"))))))
  (if (i32.eq (local.get $id) (i32.const 476))
    (then  ;; getFloat16(byteOffset, littleEndian)
      (if (call $is_detached_buf (local.get $dvab)) (then (call $throw_type (cstring "TypeError") (cstring "Cannot perform DataView operation on a detached ArrayBuffer")) (return (call $v_undef))))
      (let $vlen i32 (call $dv_cur_len (local.get $thisv)))
      (if (call $err) (then (return (call $v_undef))))
      (if (i32.gt_s (local.get $boff) (i32.sub (local.get $vlen) (i32.const 2)))
        (then (call $throw_type (cstring "RangeError") (cstring "DataView get: out of bounds")) (return (call $v_undef))))
      (return (call $num (call $dv_read_f16 (i32.add (i32.add (local.get $abptr) (local.get $voff)) (local.get $boff)) (call $truthy (call $argn (local.get $argv) (local.get $argc) (i32.const 1)))))))
    (else  ;; setFloat16(byteOffset, value, littleEndian)
      (let $sval f64 (call $to_num (call $argn (local.get $argv) (local.get $argc) (i32.const 1))))
      (if (call $err) (then (return (call $v_undef))))
      (if (call $is_detached_buf (local.get $dvab)) (then (call $throw_type (cstring "TypeError") (cstring "Cannot perform DataView operation on a detached ArrayBuffer")) (return (call $v_undef))))
      (let $vlen i32 (call $dv_cur_len (local.get $thisv)))
      (if (call $err) (then (return (call $v_undef))))
      (if (i32.gt_s (local.get $boff) (i32.sub (local.get $vlen) (i32.const 2)))
        (then (call $throw_type (cstring "RangeError") (cstring "DataView set: out of bounds")) (return (call $v_undef))))
      (call $dv_write_f16 (i32.add (i32.add (local.get $abptr) (local.get $voff)) (local.get $boff)) (call $truthy (call $argn (local.get $argv) (local.get $argc) (i32.const 2))) (local.get $sval))
      (return (call $v_undef))))
  (call $v_undef))

;; 1 if $buf is a detached ArrayBuffer (carries a truthy @@detached marker)
(func $is_detached_buf (param $buf i64) (result i32) (effects)
  (if (i32.eqz (call $is_object (local.get $buf))) (then (return (i32.const 0))))
  (let $sl i32 (call $scope_find_local (call $val_payload (local.get $buf)) (cstring "@@detached")))
  (if (local.get $sl) (then (return (call $truthy (i64.load (local.get $sl))))))
  (i32.const 0))

;; ValidateTypedArray: if $thisv is a TypedArray on a detached buffer, throw TypeError and
;; return 1; otherwise return 0 (no-op for non-TypedArrays). Cheap: one @@taelem lookup.
(func $ta_validate (param $thisv i64) (result i32) (effects)
  (if (call $is_object (local.get $thisv))
    (then
      (if (call $scope_find_local (call $val_payload (local.get $thisv)) (cstring "@@taelem"))
        (then
          (let $bo i32 (call $scope_find_local (call $val_payload (local.get $thisv)) (cstring "@@tabufobj")))
          (if (local.get $bo)
            (then (if (call $is_detached_buf (i64.load (local.get $bo)))
              (then (call $throw_type (cstring "TypeError") (cstring "TypedArray operation called on a detached ArrayBuffer")) (return (i32.const 1))))))
