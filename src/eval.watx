  (if (f64.ne (local.get $nb) (local.get $nb)) (then (return (i32.const -1))))  ;; b NaN → a before
  (if (f64.lt (local.get $na) (local.get $nb)) (then (return (i32.const -1))))
  (if (f64.gt (local.get $na) (local.get $nb)) (then (return (i32.const 1))))
