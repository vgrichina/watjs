      (let $bargc i32 (if i32 (i32.gt_s (local.get $argc) (i32.const 0)) (then (i32.sub (local.get $argc) (i32.const 1))) (else (i32.const 0))))
      (let $bbuf i32 (call $heap_alloc (i32.mul (if i32 (i32.gt_s (local.get $bargc) (i32.const 0)) (then (local.get $bargc)) (else (i32.const 1))) (i32.const 8))))
      (let $bi i32 (i32.const 0))
      (block $bbe (loop $bbl
        (br_if $bbe (i32.ge_s (local.get $bi) (local.get $bargc)))
        (i64.store (i32.add (local.get $bbuf) (i32.mul (local.get $bi) (i32.const 8))) (call $argn (local.get $argv) (local.get $argc) (i32.add (local.get $bi) (i32.const 1))))
        (set! $bi (i32.add (local.get $bi) (i32.const 1))) (br $bbl)))
