          (i64.store (i32.add (local.get $cb) (i32.const 16)) (local.get $nt))  ;; newTarget forwarded
          (let $cres i64 (call $call_val (local.get $cpt) (i32.const 3) (local.get $cb) (call $proxy_handler (local.get $cf))))
          (if (call $err) (then (return (call $v_undef))))
