  ;; --- invariants ---
  (let $ext i32 (call $truthy (call $call_native (i32.const 163) (i32.const 1) (call $argv1 (local.get $tgt)) (call $v_undef))))
  (if (call $err) (then (return (call $arr_new (i32.const 1)))))
  ;; target's own keys: names ++ symbols
  (let $tnv i64 (call $call_native (i32.const 112) (i32.const 1) (call $argv1 (local.get $tgt)) (call $v_undef)))
  (if (call $err) (then (return (call $arr_new (i32.const 1)))))
  (let $tsv i64 (call $call_native (i32.const 248) (i32.const 1) (call $argv1 (local.get $tgt)) (call $v_undef)))
  (if (call $err) (then (return (call $arr_new (i32.const 1)))))
  (let $tkeys i32 (call $arr_new (i32.const 8)))
  (let $tna i32 (call $val_payload (local.get $tnv)))
  (let $ti i32 (i32.const 0))
  (block $tne (loop $tnl
    (br_if $tne (i32.ge_s (local.get $ti) (call $arr_len (local.get $tna))))
    (call $arr_push (local.get $tkeys) (call $arr_get (local.get $tna) (local.get $ti)))
    (set! $ti (i32.add (local.get $ti) (i32.const 1))) (br $tnl)))
  (let $tsa i32 (call $val_payload (local.get $tsv)))
  (set! $ti (i32.const 0))
  (block $tse (loop $tsl
    (br_if $tse (i32.ge_s (local.get $ti) (call $arr_len (local.get $tsa))))
    (call $arr_push (local.get $tkeys) (call $arr_get (local.get $tsa) (local.get $ti)))
    (set! $ti (i32.add (local.get $ti) (i32.const 1))) (br $tsl)))
