  (if (i32.and (local.get $curIsData) (i32.eqz (local.get $curCfg)))
    (then
      (if (call $truthy (call $get_prop (local.get $cur) (call $mk_str (cstring "writable"))))
        (then
          (if (i32.and (local.get $hasWr) (i32.eqz (call $truthy (call $get_prop (local.get $desc) (call $mk_str (cstring "writable"))))))
            (then (call $throw_type (cstring "TypeError") (cstring "proxy defineProperty: cannot redefine a non-configurable writable property as non-writable")) (return))))))))

;; Proxy [[GetOwnProperty]]: validate the trap result `raw` against the target and
;; return the normalized descriptor (CompletePropertyDescriptor) or undefined.
;; Throws a TypeError on a spec invariant violation.
(func $proxy_gopd_check (param $raw i64) (param $tgt i64) (param $key i64) (result i64) (effects)
  ;; step 5: result must be Object or undefined
  (if (i32.eqz (i32.or (call $is_undefined (local.get $raw)) (i32.or (call $is_object (local.get $raw)) (i32.or (call $is_function (local.get $raw)) (call $is_array (local.get $raw))))))
    (then (call $throw_type (cstring "TypeError") (cstring "proxy getOwnPropertyDescriptor: trap result must be an object or undefined")) (return (call $v_undef))))
  (let $gqb i32 (call $heap_alloc (i32.const 16)))
  (i64.store (local.get $gqb) (local.get $tgt))
  (i64.store (i32.add (local.get $gqb) (i32.const 8)) (local.get $key))
  (let $tdesc i64 (call $call_native (i32.const 156) (i32.const 2) (local.get $gqb) (call $v_undef)))
  (if (call $err) (then (return (call $v_undef))))
  (let $gqext i32 (call $truthy (call $call_native (i32.const 163) (i32.const 1) (call $argv1 (local.get $tgt)) (call $v_undef))))
  (if (call $err) (then (return (call $v_undef))))
