      ;; slice(start[,end]) (24)
      (if (i32.eq (local.get $id) (i32.const 24))
        (then
          ;; ArraySpeciesCreate(count): if the true count exceeds 2^32-1 → RangeError
          ;; (computed in f64 since $n is capped by alike_arr at 65536)
