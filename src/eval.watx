  (let $r f64 (f64.sub (local.get $x) (f64.mul (local.get $n) (f64.const 1.5707963267948966))))
  (let $q i64 (i64.and (i64.trunc_f64_s (local.get $n)) (i64.const 3)))
  (if (i64.lt_s (local.get $q) (i64.const 0)) (then (set! $q (i64.add (local.get $q) (i64.const 4)))))
  (if (i64.eq (local.get $q) (i64.const 0)) (then (return (call $m_cos_small (local.get $r)))))
  (if (i64.eq (local.get $q) (i64.const 1)) (then (return (f64.neg (call $m_sin_small (local.get $r))))))
  (if (i64.eq (local.get $q) (i64.const 2)) (then (return (f64.neg (call $m_cos_small (local.get $r))))))
