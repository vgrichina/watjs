  (if (i32.eq (local.get $id) (i32.const 8))  ;; isFinite(x)
    (then (let $d f64 (call $to_num (call $argn (local.get $argv) (local.get $argc) (i32.const 0))))
          (return (call $mk_bool (i32.and (f64.eq (local.get $d) (local.get $d))
