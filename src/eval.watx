  (let $qHasWr i32 (call $truthy (call $js_in (call $mk_str (cstring "writable")) (local.get $raw))))
  (let $qHasGet i32 (call $truthy (call $js_in (call $mk_str (cstring "get")) (local.get $raw))))
  (let $qHasSet i32 (call $truthy (call $js_in (call $mk_str (cstring "set")) (local.get $raw))))
  (if (i32.and (i32.or (local.get $qHasVal) (local.get $qHasWr)) (i32.or (local.get $qHasGet) (local.get $qHasSet)))
