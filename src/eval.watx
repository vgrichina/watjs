;; ═══════════════════════════════════════════════════════════════
;; eval.watx — Pratt / precedence-climbing parser+evaluator
;;
;; Phase 0: expressions only (no variables yet). Parse-and-evaluate:
;; each parse_* consumes tokens via $next_token and returns a JSValue.
;; Short-circuit (&& || ?:) uses a SUPPRESS flag (register 56): when set,
;; side-effecting builtins (print) are skipped while tokens are still
;; consumed, so the untaken branch parses but produces no output.
;;
;; On error: $throw sets ERR + ERR_VAL and parse_* funcs unwind by
;; returning undefined (callers check $err()).
;; ═══════════════════════════════════════════════════════════════

(func $suppress (result i32) (effects) (i32.load (i32.const 56)))
(func $set_suppress (param $v i32) (effects) (i32.store (i32.const 56) (local.get $v)))

(func $throw (param $msg i32) (effects)
  ;; no-op while suppressed (we're skip-scanning, not executing)
  (if (i32.and (i32.eqz (call $err)) (i32.eqz (call $suppress)))
    (then (call $set_err (i32.const 1)) (call $set_err_val (call $mk_str (local.get $msg))))))

;; construct an error object of the named type (looked up in the global scope)
;; with the given message Str; falls back to a plain string if the type is absent.
(func $make_error (param $typecstr i32) (param $msg i32) (result i64) (effects)
  (let $slot i32 (call $scope_find (i32.load (i32.const 152)) (local.get $typecstr)))
  (if (i32.eqz (local.get $slot)) (then (return (call $mk_str (local.get $msg)))))
  (let $fnval i64 (i64.load (local.get $slot)))
  (if (i32.eqz (call $is_function (local.get $fnval))) (then (return (call $mk_str (local.get $msg)))))
  (let $fn i32 (call $val_payload (local.get $fnval)))
  ;; VM-function constructor (running under the bytecode VM): build the instance
  ;; directly — link to its @16 prototype and set .message (mirrors the ctor body).
  (if (i32.and (i32.ge_s (i32.load (local.get $fn)) (i32.const 1448232526)) (i32.le_s (i32.load (local.get $fn)) (i32.const 1448232528)))
    (then
      (let $vproto i64 (i64.load (i32.add (local.get $fn) (i32.const 16))))
      (let $vo i32 (call $obj_new (i32.const 8)))
      (if (call $is_object (local.get $vproto)) (then (i32.store (local.get $vo) (call $val_payload (local.get $vproto)))))
      (call $scope_define (local.get $vo) (cstring "message") (call $mk_str (local.get $msg)))
      (return (call $mk_obj (local.get $vo)))))
  (if (i32.load (local.get $fn)) (then (return (call $mk_str (local.get $msg)))))  ;; native: skip
  ;; @0==0 (production user-fn constructor) no longer exists in the single-engine build
  (call $mk_str (local.get $msg)))

;; throw a typed error (ReferenceError / TypeError / ...)
(func $throw_type (param $typecstr i32) (param $msg i32) (effects)
  (if (i32.and (i32.eqz (call $err)) (i32.eqz (call $suppress)))
    (then (call $set_err (i32.const 1)) (call $set_err_val (call $make_error (local.get $typecstr) (local.get $msg))))))

(func $cur (result i32) (effects) (call $tok_kind))
(func $advance (effects) (call $next_token))
(func $eat (param $k i32) (result i32) (effects)  ;; if cur==k, advance & return 1
  (if i32 (i32.eq (call $cur) (local.get $k))
    (then (call $advance) (i32.const 1)) (else (i32.const 0))))
(func $expect (param $k i32) (param $msg i32) (effects)
  (if (i32.eqz (call $eat (local.get $k))) (then (call $throw (local.get $msg)))))

;; ── operator helpers ──

(func $str_cmp (param $a i32) (param $b i32) (result i32) (effects)  ;; -1/0/1
  (let $la i32 (call $str_len (local.get $a)))
  (let $lb i32 (call $str_len (local.get $b)))
  (let $n i32 (if i32 (i32.lt_s (local.get $la) (local.get $lb)) (then (local.get $la)) (else (local.get $lb))))
  (let $i i32 (i32.const 0))
  (let $res i32 (i32.const 0))
  (block $brk (loop $cont
    (br_if $brk (i32.ge_s (local.get $i) (local.get $n)))
    (let $ca i32 (call $str_byte (local.get $a) (local.get $i)))
    (let $cb i32 (call $str_byte (local.get $b) (local.get $i)))
    (if (i32.lt_s (local.get $ca) (local.get $cb)) (then (set! $res (i32.const -1)) (br $brk)))
    (if (i32.gt_s (local.get $ca) (local.get $cb)) (then (set! $res (i32.const 1)) (br $brk)))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $cont)))
  (if i32 (local.get $res) (then (local.get $res))
    (else (if i32 (i32.lt_s (local.get $la) (local.get $lb)) (then (i32.const -1))
          (else (if i32 (i32.gt_s (local.get $la) (local.get $lb)) (then (i32.const 1)) (else (i32.const 0))))))))

;; ToInt32 (spec §7.1.5): NaN/Inf -> 0; else truncate toward zero mod 2^32, signed.
(func $to_int32 (param $v i64) (result i32) (effects)
  (let $d f64 (call $to_num (local.get $v)))
  (if (f64.ne (local.get $d) (local.get $d)) (then (return (i32.const 0))))  ;; NaN
  (if (i32.or (f64.eq (local.get $d) (f64.div (f64.const 1) (f64.const 0)))
                  (f64.eq (local.get $d) (f64.div (f64.const -1) (f64.const 0)))) (then (return (i32.const 0))))
  (set! $d (f64.trunc (local.get $d)))
  ;; reduce into [0, 2^32)
  (let $m f64 (f64.sub (local.get $d) (f64.mul (f64.floor (f64.div (local.get $d) (f64.const 4294967296))) (f64.const 4294967296))))
  (if (f64.ge (local.get $m) (f64.const 2147483648)) (then (set! $m (f64.sub (local.get $m) (f64.const 4294967296)))))
  (i32.trunc_f64_s (local.get $m)))

(func $js_add (param $a i64) (param $b i64) (result i64) (effects)
  ;; ToPrimitive(default) both operands first (spec 13.15.3): an object/wrapper/
  ;; Date operand may resolve to a string, which then forces string concatenation.
  (let $pa i64 (call $to_primitive (local.get $a)))
  (if (call $err) (then (return (call $v_undef))))
  (let $pb i64 (call $to_primitive (local.get $b)))
  (if (call $err) (then (return (call $v_undef))))
  (if i64 (i32.or (call $is_string (local.get $pa)) (call $is_string (local.get $pb)))
    (then (call $mk_str (call $str_concat (call $to_str (local.get $pa)) (call $to_str (local.get $pb)))))
    (else (call $num (f64.add (call $to_num (local.get $pa)) (call $to_num (local.get $pb)))))))

(func $strict_eq (param $a i64) (param $b i64) (result i32) (effects)
  (if i32 (call $is_number (local.get $a))
    (then (if i32 (call $is_number (local.get $b))
            (then (f64.eq (call $tonum_raw (local.get $a)) (call $tonum_raw (local.get $b))))
            (else (i32.const 0))))
    (else (if i32 (call $is_number (local.get $b))
            (then (i32.const 0))
            (else
              (if i32 (i32.and (call $is_string (local.get $a)) (call $is_string (local.get $b)))
                (then (call $str_eq (call $val_payload (local.get $a)) (call $val_payload (local.get $b))))
                (else (if i32 (i32.ne (call $is_string (local.get $a)) (call $is_string (local.get $b)))
                        (then (i32.const 0))
                        (else (i64.eq (local.get $a) (local.get $b)))))))))))

;; index of $key in array $keys by strict-equality, or -1 (for Map/Set)
(func $map_find (param $keys i32) (param $key i64) (result i32) (effects)
  (let $n i32 (call $arr_len (local.get $keys)))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    (if (call $strict_eq (call $arr_get (local.get $keys) (local.get $i)) (local.get $key)) (then (return (local.get $i))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (i32.const -1))

;; internal-array accessor for Map/Set: payload of object's hidden prop
(func $coll_arr (param $obj i64) (param $name i32) (result i32) (effects)
  (call $val_payload (call $get_prop (local.get $obj) (call $mk_str (local.get $name)))))

(func $loose_eq (param $a i64) (param $b i64) (result i32) (effects)
  (if i32 (call $strict_eq (local.get $a) (local.get $b)) (then (i32.const 1))
  (else
    (let $an i32 (i32.or (call $is_null (local.get $a)) (call $is_undefined (local.get $a))))
    (let $bn i32 (i32.or (call $is_null (local.get $b)) (call $is_undefined (local.get $b))))
    (if i32 (i32.or (local.get $an) (local.get $bn))
      (then (i32.and (local.get $an) (local.get $bn)))
      (else
        ;; object vs primitive: ToPrimitive(object) then re-compare (spec 7.2.15
        ;; steps 10-11). Two objects already failed strict_eq → not equal.
        (let $aobj i32 (i32.or (call $is_object (local.get $a)) (i32.or (call $is_array (local.get $a)) (call $is_function (local.get $a)))))
        (let $bobj i32 (i32.or (call $is_object (local.get $b)) (i32.or (call $is_array (local.get $b)) (call $is_function (local.get $b)))))
        (if i32 (i32.and (local.get $aobj) (i32.eqz (local.get $bobj)))
          (then (call $loose_eq (call $to_primitive (local.get $a)) (local.get $b)))
          (else (if i32 (i32.and (local.get $bobj) (i32.eqz (local.get $aobj)))
            (then (call $loose_eq (local.get $a) (call $to_primitive (local.get $b))))
            (else (if i32 (i32.or (local.get $aobj) (local.get $bobj))
              (then (i32.const 0))  ;; two objects, not the same reference
              (else
                ;; number/string/bool primitives → compare as numbers
                (let $ap i32 (i32.or (call $is_number (local.get $a)) (i32.or (call $is_string (local.get $a)) (call $is_boolean (local.get $a)))))
                (let $bp i32 (i32.or (call $is_number (local.get $b)) (i32.or (call $is_string (local.get $b)) (call $is_boolean (local.get $b)))))
                (if i32 (i32.and (local.get $ap) (local.get $bp))
                  (then (f64.eq (call $to_num (local.get $a)) (call $to_num (local.get $b))))
                  (else (i32.const 0))))))))))))))

;; relational compare: kind 29 < , 30 > , 31 <= , 32 >=

;; ── function calls & native builtins ──

(func $argn (param $argv i32) (param $argc i32) (param $i i32) (result i64) (effects)
  (if i64 (i32.lt_s (local.get $i) (local.get $argc))
    (then (i64.load (i32.add (local.get $argv) (i32.mul (local.get $i) (i32.const 8)))))
    (else (call $v_undef))))

;; days since the Unix epoch for a civil date (Howard Hinnant's algorithm).
;; y full year, m 1..12, d 1..31.
(func $days_from_civil (param $y i64) (param $m i64) (param $d i64) (result i64) (effects)
  (if (i64.le_s (local.get $m) (i64.const 2)) (then (set! $y (i64.sub (local.get $y) (i64.const 1)))))
  (let $era i64 (i64.div_s (if i64 (i64.ge_s (local.get $y) (i64.const 0)) (then (local.get $y)) (else (i64.sub (local.get $y) (i64.const 399)))) (i64.const 400)))
  (let $yoe i64 (i64.sub (local.get $y) (i64.mul (local.get $era) (i64.const 400))))
  (let $doy i64 (i64.add (i64.div_s (i64.add (i64.mul (i64.const 153) (i64.add (local.get $m) (if i64 (i64.gt_s (local.get $m) (i64.const 2)) (then (i64.const -3)) (else (i64.const 9))))) (i64.const 2)) (i64.const 5)) (i64.sub (local.get $d) (i64.const 1))))
  (let $doe i64 (i64.add (i64.sub (i64.add (i64.mul (local.get $yoe) (i64.const 365)) (i64.div_s (local.get $yoe) (i64.const 4))) (i64.div_s (local.get $yoe) (i64.const 100))) (local.get $doy)))
  (i64.sub (i64.add (i64.mul (local.get $era) (i64.const 146097)) (local.get $doe)) (i64.const 719468)))

;; epoch-ms from date components (UTC). month is 0-based per JS.
(func $date_make (param $y i64) (param $mo i64) (param $d i64) (param $h i64) (param $mi i64) (param $s i64) (param $ms i64) (result f64) (effects)
  (let $days i64 (call $days_from_civil (local.get $y) (i64.add (local.get $mo) (i64.const 1)) (local.get $d)))
  (f64.convert_i64_s (i64.add (i64.add (i64.add (i64.add (i64.mul (local.get $days) (i64.const 86400000)) (i64.mul (local.get $h) (i64.const 3600000))) (i64.mul (local.get $mi) (i64.const 60000))) (i64.mul (local.get $s) (i64.const 1000))) (local.get $ms))))

;; extract a UTC date/time field from epoch ms. field: 0 year, 1 month(0-based),
;; 2 date, 3 weekday, 4 hours, 5 minutes, 6 seconds, 7 ms.
(func $date_field (param $msf f64) (param $field i32) (result i32) (effects)
  (let $ms i64 (i64.trunc_f64_s (local.get $msf)))
  (let $day i64 (i64.div_s (local.get $ms) (i64.const 86400000)))
  (if (i32.and (i64.lt_s (local.get $ms) (i64.const 0)) (i64.ne (local.get $ms) (i64.mul (local.get $day) (i64.const 86400000))))
    (then (set! $day (i64.sub (local.get $day) (i64.const 1)))))
  (let $tod i64 (i64.sub (local.get $ms) (i64.mul (local.get $day) (i64.const 86400000))))
  (if (i32.eq (local.get $field) (i32.const 4)) (then (return (i32.wrap_i64 (i64.div_s (local.get $tod) (i64.const 3600000))))))
  (if (i32.eq (local.get $field) (i32.const 5)) (then (return (i32.wrap_i64 (i64.rem_s (i64.div_s (local.get $tod) (i64.const 60000)) (i64.const 60))))))
  (if (i32.eq (local.get $field) (i32.const 6)) (then (return (i32.wrap_i64 (i64.rem_s (i64.div_s (local.get $tod) (i64.const 1000)) (i64.const 60))))))
  (if (i32.eq (local.get $field) (i32.const 7)) (then (return (i32.wrap_i64 (i64.rem_s (local.get $tod) (i64.const 1000))))))
  (if (i32.eq (local.get $field) (i32.const 3)) (then (return (i32.wrap_i64 (i64.rem_s (i64.add (i64.rem_s (i64.add (local.get $day) (i64.const 4)) (i64.const 7)) (i64.const 7)) (i64.const 7))))))
  ;; civil_from_days
  (let $z i64 (i64.add (local.get $day) (i64.const 719468)))
  (let $era i64 (i64.div_s (if i64 (i64.ge_s (local.get $z) (i64.const 0)) (then (local.get $z)) (else (i64.sub (local.get $z) (i64.const 146096)))) (i64.const 146097)))
  (let $doe i64 (i64.sub (local.get $z) (i64.mul (local.get $era) (i64.const 146097))))
  (let $yoe i64 (i64.div_s (i64.sub (i64.add (i64.sub (local.get $doe) (i64.div_s (local.get $doe) (i64.const 1460))) (i64.div_s (local.get $doe) (i64.const 36524))) (i64.div_s (local.get $doe) (i64.const 146096))) (i64.const 365)))
  (let $yy i64 (i64.add (local.get $yoe) (i64.mul (local.get $era) (i64.const 400))))
  (let $doy i64 (i64.sub (local.get $doe) (i64.add (i64.sub (i64.mul (i64.const 365) (local.get $yoe)) (i64.div_s (local.get $yoe) (i64.const 100))) (i64.div_s (local.get $yoe) (i64.const 4)))))
  (let $mp i64 (i64.div_s (i64.add (i64.mul (i64.const 5) (local.get $doy)) (i64.const 2)) (i64.const 153)))
  (let $dd i64 (i64.add (i64.sub (local.get $doy) (i64.div_s (i64.add (i64.mul (i64.const 153) (local.get $mp)) (i64.const 2)) (i64.const 5))) (i64.const 1)))
  (let $mm i64 (if i64 (i64.lt_s (local.get $mp) (i64.const 10)) (then (i64.add (local.get $mp) (i64.const 3))) (else (i64.sub (local.get $mp) (i64.const 9)))))
  (if (i64.le_s (local.get $mm) (i64.const 2)) (then (set! $yy (i64.add (local.get $yy) (i64.const 1)))))
  (if (i32.eq (local.get $field) (i32.const 0)) (then (return (i32.wrap_i64 (local.get $yy)))))
  (if (i32.eq (local.get $field) (i32.const 1)) (then (return (i32.wrap_i64 (i64.sub (local.get $mm) (i64.const 1))))))
  (return (i32.wrap_i64 (local.get $dd))))

;; TypedArray element types: 0 int8,1 uint8,2 uint8clamped,3 int16,4 uint16,
;; 5 int32,6 uint32,7 float32,8 float64.
(func $ta_bpe (param $elem i32) (result i32) (effects)
  (if i32 (i32.le_s (local.get $elem) (i32.const 2)) (then (i32.const 1))
    (else (if i32 (i32.le_s (local.get $elem) (i32.const 4)) (then (i32.const 2))
    (else (if i32 (i32.eq (local.get $elem) (i32.const 8)) (then (i32.const 8)) (else (i32.const 4))))))))

;; read element idx (as f64) from a typed-array byte buffer.
(func $ta_read (param $buf i32) (param $idx i32) (param $elem i32) (result f64) (effects)
  (let $a i32 (i32.add (local.get $buf) (i32.mul (local.get $idx) (call $ta_bpe (local.get $elem)))))
  (if f64 (i32.eq (local.get $elem) (i32.const 0)) (then (f64.convert_i32_s (i32.load8_s (local.get $a))))
  (else (if f64 (i32.or (i32.eq (local.get $elem) (i32.const 1)) (i32.eq (local.get $elem) (i32.const 2))) (then (f64.convert_i32_u (i32.load8_u (local.get $a))))
  (else (if f64 (i32.eq (local.get $elem) (i32.const 3)) (then (f64.convert_i32_s (i32.load16_s (local.get $a))))
  (else (if f64 (i32.eq (local.get $elem) (i32.const 4)) (then (f64.convert_i32_u (i32.load16_u (local.get $a))))
  (else (if f64 (i32.eq (local.get $elem) (i32.const 5)) (then (f64.convert_i32_s (i32.load (local.get $a))))
  (else (if f64 (i32.eq (local.get $elem) (i32.const 6)) (then (f64.convert_i32_u (i32.load (local.get $a))))
  (else (if f64 (i32.eq (local.get $elem) (i32.const 7)) (then (f64.promote_f32 (f32.load (local.get $a))))
  (else (f64.load (local.get $a)))))))))))))))))

;; write f64 value to element idx of a typed-array byte buffer (ToInt for int types).
(func $ta_write (param $buf i32) (param $idx i32) (param $elem i32) (param $val f64) (effects)
  (let $a i32 (i32.add (local.get $buf) (i32.mul (local.get $idx) (call $ta_bpe (local.get $elem)))))
  (if (i32.eq (local.get $elem) (i32.const 8)) (then (f64.store (local.get $a) (local.get $val)) (return)))
  (if (i32.eq (local.get $elem) (i32.const 7)) (then (f32.store (local.get $a) (f32.demote_f64 (local.get $val))) (return)))
  (if (i32.eq (local.get $elem) (i32.const 2))  ;; uint8clamped: clamp 0..255
    (then
      (let $cv f64 (local.get $val))
      (if (f64.ne (local.get $cv) (local.get $cv)) (then (set! $cv (f64.const 0))))
      (if (f64.lt (local.get $cv) (f64.const 0)) (then (set! $cv (f64.const 0))))
      (if (f64.gt (local.get $cv) (f64.const 255)) (then (set! $cv (f64.const 255))))
      (i32.store8 (local.get $a) (i32.trunc_f64_s (f64.nearest (local.get $cv)))) (return)))
  (let $iv i32 (call $to_int32 (call $num (local.get $val))))  ;; ToInt32 (handles NaN/Inf/wrap)
  (if (i32.le_s (local.get $elem) (i32.const 1)) (then (i32.store8 (local.get $a) (local.get $iv)) (return)))
  (if (i32.le_s (local.get $elem) (i32.const 4)) (then (i32.store16 (local.get $a) (local.get $iv)) (return)))
  (i32.store (local.get $a) (local.get $iv)))

;; zero `n` bytes at `p`.
(func $ta_zero (param $p i32) (param $n i32) (effects)
  (let $i i32 (i32.const 0))
  (block $e (loop $l (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    (i32.store8 (i32.add (local.get $p) (local.get $i)) (i32.const 0))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l))))

;; construct a TypedArray of element type `elem` from the constructor arguments.
(func $ta_make (param $elem i32) (param $argc i32) (param $argv i32) (result i64) (effects)
  (let $bpe i32 (call $ta_bpe (local.get $elem)))
  (let $a0 i64 (call $argn (local.get $argv) (local.get $argc) (i32.const 0)))
  (let $len i32 (i32.const 0))
  (let $buf i32 (i32.const 0))
  (if (call $is_number (local.get $a0))
    (then
      (set! $len (i32.trunc_f64_s (call $tonum_raw (local.get $a0))))
      (set! $buf (call $heap_alloc (i32.add (i32.mul (local.get $len) (local.get $bpe)) (i32.const 8))))
      (call $ta_zero (local.get $buf) (i32.mul (local.get $len) (local.get $bpe))))
    (else (if (call $is_array (local.get $a0))
      (then
        (let $ap i32 (call $val_payload (local.get $a0)))
        (set! $len (call $arr_len (local.get $ap)))
        (set! $buf (call $heap_alloc (i32.add (i32.mul (local.get $len) (local.get $bpe)) (i32.const 8))))
        (call $ta_zero (local.get $buf) (i32.mul (local.get $len) (local.get $bpe)))
        (let $ti i32 (i32.const 0))
        (block $te (loop $tl (br_if $te (i32.ge_s (local.get $ti) (local.get $len)))
