      (if (i32.eq (local.get $id) (i32.const 22))  ;; indexOf(x[, fromIndex])
        (then
          (if (i32.eqz (local.get $n)) (then (return (call $num (f64.const -1)))))  ;; len 0 → -1 before coercing fromIndex (spec)
          (let $i i32 (i32.const 0))
          (if (i32.ge_s (local.get $argc) (i32.const 2))
            (then
              (set! $i (call $to_int_idx (call $to_num (call $argn (local.get $argv) (local.get $argc) (i32.const 1)))))
              (if (i32.lt_s (local.get $i) (i32.const 0)) (then (set! $i (i32.add (local.get $n) (local.get $i)))))
              (if (i32.lt_s (local.get $i) (i32.const 0)) (then (set! $i (i32.const 0))))))
          (block $se (loop $sl
            (br_if $se (i32.ge_s (local.get $i) (local.get $n)))
