(func $native_collections (param $id i32) (param $thisv i64) (param $argv i32) (param $argc i32) (result i64) (effects)
  ;; ── Map (id 120 ctor, 121 set, 122 get, 123 has, 124 delete, 125 forEach, 126 size, 127 clear) ──
