      (let $stelem i32 (i32.trunc_f64_s (call $tonum_raw (i64.load (local.get $stsl)))))
      (let $stlen i32 (call $to_int_idx (call $to_num (call $get_prop (local.get $thisv) (call $mk_str (cstring "@@talen"))))))
      (let $stbuf i32 (call $to_int_idx (call $to_num (call $get_prop (local.get $thisv) (call $mk_str (cstring "@@tabuf"))))))
      (let $stoff i32 (call $to_int_idx (call $to_num (call $argn (local.get $argv) (local.get $argc) (i32.const 1)))))
      (if (i32.lt_s (local.get $stoff) (i32.const 0)) (then (call $throw_type (cstring "RangeError") (cstring "TypedArray.set: offset is negative")) (return (call $v_undef))))
      (let $stsrc i64 (call $argn (local.get $argv) (local.get $argc) (i32.const 0)))
      (let $stsn i32 (call $alike_len (local.get $stsrc)))
      (if (i32.gt_s (i32.add (local.get $stoff) (local.get $stsn)) (local.get $stlen))
        (then (call $throw_type (cstring "RangeError") (cstring "TypedArray.set: source too large")) (return (call $v_undef))))
      (let $sti i32 (i32.const 0))
      (block $ste (loop $stl
        (br_if $ste (i32.ge_s (local.get $sti) (local.get $stsn)))
        (call $ta_store_val (local.get $stbuf) (i32.add (local.get $stoff) (local.get $sti)) (local.get $stelem)
          (call $get_prop (local.get $stsrc) (call $num (f64.convert_i32_s (local.get $sti)))))
        (if (call $err) (then (return (call $v_undef))))
        (set! $sti (i32.add (local.get $sti) (i32.const 1))) (br $stl)))
      (return (call $v_undef))))
  (if (i32.eq (local.get $id) (i32.const 392))  ;; ArrayBuffer.isView(arg)
    (then
      (let $iva i64 (call $argn (local.get $argv) (local.get $argc) (i32.const 0)))
      (if (i32.eqz (call $is_object (local.get $iva))) (then (return (call $v_false))))  ;; non-object → false (guard before val_payload deref)
      (return (call $mk_bool
        (i32.or (i32.ne (call $scope_find_local (call $val_payload (local.get $iva)) (cstring "@@taelem")) (i32.const 0))
                (i32.ne (call $scope_find_local (call $val_payload (local.get $iva)) (cstring "@@dvab")) (i32.const 0)))))))
  ;; getBigInt64(386)/getBigUint64(387)/setBigInt64(388)/setBigUint64(389) — 8-byte i64
  (if (i32.and (i32.ge_s (local.get $id) (i32.const 386)) (i32.le_s (local.get $id) (i32.const 389)))
    (then
      (if (i32.eqz (call $is_object (local.get $thisv)))
        (then (call $throw_type (cstring "TypeError") (cstring "DataView method called on incompatible receiver")) (return (call $v_undef))))
      (if (i32.eqz (call $scope_find_local (call $val_payload (local.get $thisv)) (cstring "@@dvab")))
        (then (call $throw_type (cstring "TypeError") (cstring "DataView method called on incompatible receiver")) (return (call $v_undef))))
      (let $bisget i32 (i32.lt_s (local.get $id) (i32.const 388)))
      (let $biboff i32 (call $to_index (call $argn (local.get $argv) (local.get $argc) (i32.const 0))))
      (if (call $err) (then (return (call $v_undef))))
      ;; setBigInt64/setBigUint64: value must be a BigInt (read it BEFORE the bounds check per spec)
      (let $bival i64 (i64.const 0))
      (if (i32.eqz (local.get $bisget))
        (then
          (let $biarg i64 (call $argn (local.get $argv) (local.get $argc) (i32.const 1)))
          (if (i32.eqz (call $is_bigint (local.get $biarg)))
            (then (call $throw_type (cstring "TypeError") (cstring "Cannot convert value to a BigInt")) (return (call $v_undef))))
          (set! $bival (call $bigint_val (local.get $biarg)))))
      (let $bivlen i32 (call $to_int_idx (call $to_num (call $get_prop (local.get $thisv) (call $mk_str (cstring "@@dvlen"))))))
      (let $bivoff i32 (call $to_int_idx (call $to_num (call $get_prop (local.get $thisv) (call $mk_str (cstring "@@dvoff"))))))
      (let $biabptr i32 (call $to_int_idx (call $to_num (call $get_prop (call $get_prop (local.get $thisv) (call $mk_str (cstring "@@dvab"))) (call $mk_str (cstring "@@abdata"))))))
      (if (i32.gt_s (i32.add (local.get $biboff) (i32.const 8)) (local.get $bivlen))
        (then (call $throw_type (cstring "RangeError") (cstring "DataView BigInt: out of bounds")) (return (call $v_undef))))
      (let $bidst i32 (i32.add (i32.add (local.get $biabptr) (local.get $bivoff)) (local.get $biboff)))
      (if (local.get $bisget)
        (then (return (call $mk_bigint (call $dv_read_i64 (local.get $bidst) (call $truthy (call $argn (local.get $argv) (local.get $argc) (i32.const 1)))))))
        (else
          (call $dv_write_i64 (local.get $bidst) (call $truthy (call $argn (local.get $argv) (local.get $argc) (i32.const 2))) (local.get $bival))
          (return (call $v_undef))))))
  (if (i32.eq (local.get $id) (i32.const 363))  ;; new DataView(buffer[, byteOffset[, byteLength]])
    (then
      (let $dvb i64 (call $argn (local.get $argv) (local.get $argc) (i32.const 0)))
      (if (i32.eqz (call $is_object (local.get $dvb)))
        (then (call $throw_type (cstring "TypeError") (cstring "DataView: buffer is not an object")) (return (call $v_undef))))
      (let $dvabsl i32 (call $scope_find_local (call $val_payload (local.get $dvb)) (cstring "@@abdata")))
      (if (i32.eqz (local.get $dvabsl))
        (then (call $throw_type (cstring "TypeError") (cstring "DataView: buffer is not an ArrayBuffer")) (return (call $v_undef))))
      (let $dvbuflen i32 (call $to_int_idx (call $to_num (call $get_prop (local.get $dvb) (call $mk_str (cstring "byteLength"))))))
      (let $dvoff i32 (call $to_index (call $argn (local.get $argv) (local.get $argc) (i32.const 1))))
      (if (call $err) (then (return (call $v_undef))))
      (if (i32.gt_s (local.get $dvoff) (local.get $dvbuflen))
        (then (call $throw_type (cstring "RangeError") (cstring "DataView: byteOffset is out of bounds")) (return (call $v_undef))))
      (let $dvlen i32 (i32.sub (local.get $dvbuflen) (local.get $dvoff)))
      (if (i32.eqz (call $is_undefined (call $argn (local.get $argv) (local.get $argc) (i32.const 2))))
        (then
          (set! $dvlen (call $to_index (call $argn (local.get $argv) (local.get $argc) (i32.const 2))))
          (if (call $err) (then (return (call $v_undef))))
          (if (i32.gt_s (i32.add (local.get $dvoff) (local.get $dvlen)) (local.get $dvbuflen))
            (then (call $throw_type (cstring "RangeError") (cstring "DataView: byteLength is out of bounds")) (return (call $v_undef))))))
      (let $dvo i32 (call $obj_new (i32.const 8)))
      (if (i32.load (i32.const 508)) (then (i32.store (local.get $dvo) (i32.load (i32.const 508)))))
      (call $scope_define (local.get $dvo) (cstring "@@dvab") (local.get $dvb))
      (call $scope_define (local.get $dvo) (cstring "@@dvoff") (call $num (f64.convert_i32_s (local.get $dvoff))))
      (call $scope_define (local.get $dvo) (cstring "@@dvlen") (call $num (f64.convert_i32_s (local.get $dvlen))))
      (return (call $mk_obj (local.get $dvo)))))
  ;; accessors (brand-checked)
  (if (i32.and (i32.ge_s (local.get $id) (i32.const 380)) (i32.le_s (local.get $id) (i32.const 382)))
    (then
      (if (i32.eqz (call $is_object (local.get $thisv)))
        (then (call $throw_type (cstring "TypeError") (cstring "DataView accessor called on incompatible receiver")) (return (call $v_undef))))
      (if (i32.eqz (call $scope_find_local (call $val_payload (local.get $thisv)) (cstring "@@dvab")))
        (then (call $throw_type (cstring "TypeError") (cstring "DataView accessor called on incompatible receiver")) (return (call $v_undef))))
      (if (i32.eq (local.get $id) (i32.const 380)) (then (return (call $get_prop (local.get $thisv) (call $mk_str (cstring "@@dvab"))))))
      (if (i32.eq (local.get $id) (i32.const 381)) (then (return (call $get_prop (local.get $thisv) (call $mk_str (cstring "@@dvlen"))))))
      (return (call $get_prop (local.get $thisv) (call $mk_str (cstring "@@dvoff"))))))
  ;; get/set
  (if (i32.and (i32.ge_s (local.get $id) (i32.const 364)) (i32.le_s (local.get $id) (i32.const 379)))
    (then
      (if (i32.eqz (call $is_object (local.get $thisv)))
        (then (call $throw_type (cstring "TypeError") (cstring "DataView method called on incompatible receiver")) (return (call $v_undef))))
      (if (i32.eqz (call $scope_find_local (call $val_payload (local.get $thisv)) (cstring "@@dvab")))
        (then (call $throw_type (cstring "TypeError") (cstring "DataView method called on incompatible receiver")) (return (call $v_undef))))
      (let $isget i32 (i32.lt_s (local.get $id) (i32.const 372)))
      (let $elem i32 (call $dv_elem (i32.sub (local.get $id) (if i32 (local.get $isget) (then (i32.const 364)) (else (i32.const 372))))))
      (let $bpe i32 (call $ta_bpe (local.get $elem)))
      (let $boff i32 (call $to_index (call $argn (local.get $argv) (local.get $argc) (i32.const 0))))
      (if (call $err) (then (return (call $v_undef))))
      (let $dvab i64 (call $get_prop (local.get $thisv) (call $mk_str (cstring "@@dvab"))))
      (let $vlen i32 (call $to_int_idx (call $to_num (call $get_prop (local.get $thisv) (call $mk_str (cstring "@@dvlen"))))))
      (let $voff i32 (call $to_int_idx (call $to_num (call $get_prop (local.get $thisv) (call $mk_str (cstring "@@dvoff"))))))
      (let $abptr i32 (call $to_int_idx (call $to_num (call $get_prop (local.get $dvab) (call $mk_str (cstring "@@abdata"))))))
      (if (local.get $isget)
        (then  ;; getX(byteOffset, littleEndian)
          (if (i32.gt_s (i32.add (local.get $boff) (local.get $bpe)) (local.get $vlen))
            (then (call $throw_type (cstring "RangeError") (cstring "DataView get: out of bounds")) (return (call $v_undef))))
          (return (call $num (call $dv_read (i32.add (i32.add (local.get $abptr) (local.get $voff)) (local.get $boff)) (local.get $elem)
            (call $truthy (call $argn (local.get $argv) (local.get $argc) (i32.const 1)))))))
        (else  ;; setX(byteOffset, value, littleEndian)
          (let $sval f64 (call $to_num (call $argn (local.get $argv) (local.get $argc) (i32.const 1))))
          (if (call $err) (then (return (call $v_undef))))
          (if (i32.gt_s (i32.add (local.get $boff) (local.get $bpe)) (local.get $vlen))
            (then (call $throw_type (cstring "RangeError") (cstring "DataView set: out of bounds")) (return (call $v_undef))))
          (call $dv_write (i32.add (i32.add (local.get $abptr) (local.get $voff)) (local.get $boff)) (local.get $elem)
            (call $truthy (call $argn (local.get $argv) (local.get $argc) (i32.const 2))) (local.get $sval))
          (return (call $v_undef))))))
  (call $v_undef))

;; zero `n` bytes at `p`.
(func $ta_zero (param $p i32) (param $n i32) (effects)
  (let $i i32 (i32.const 0))
  (block $e (loop $l (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    (i32.store8 (i32.add (local.get $p) (local.get $i)) (i32.const 0))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l))))

;; construct a TypedArray of element type `elem` from the constructor arguments.
;; per-type TypedArray prototype: parent = %TypedArray.prototype% (reg 528); pointer
;; stored at 532 + elem*4. Sets constructor + BYTES_PER_ELEMENT and links ctor.prototype.
(func $ta_type_setup (param $ctor i64) (param $elem i32) (effects)
  (let $p i32 (call $obj_new (i32.const 8)))
  (if (i32.load (i32.const 528)) (then (i32.store (local.get $p) (i32.load (i32.const 528)))))
  (i32.store (i32.add (i32.const 532) (i32.mul (local.get $elem) (i32.const 4))) (local.get $p))
  (call $scope_define (local.get $p) (cstring "constructor") (local.get $ctor))
  (call $scope_define_attr (local.get $p) (cstring "BYTES_PER_ELEMENT") (call $num (f64.convert_i32_s (call $ta_bpe (local.get $elem)))) (i32.const 0))
  (call $scope_clear_enum (local.get $p))
  (call $scope_define_attr (call $fn_def_scope (local.get $ctor)) (cstring "prototype") (call $mk_obj (local.get $p)) (i32.const 0))
  (call $scope_define_attr (call $fn_def_scope (local.get $ctor)) (cstring "BYTES_PER_ELEMENT") (call $num (f64.convert_i32_s (call $ta_bpe (local.get $elem)))) (i32.const 0))
  (call $set_prop (local.get $ctor) (call $mk_str (cstring "from")) (call $mk_native (i32.const 398) (cstring "from")))
  (call $set_prop (local.get $ctor) (call $mk_str (cstring "of")) (call $mk_native (i32.const 399) (cstring "of"))))

;; element code for a TypedArray constructor value (native ids 210-218,394,395); -1 if not one
(func $ta_ctor_elem (param $ctor i64) (result i32) (effects)
  (if (i32.eqz (call $is_function (local.get $ctor))) (then (return (i32.const -1))))
  (let $cid i32 (i32.load (call $val_payload (local.get $ctor))))
  (if i32 (i32.and (i32.ge_s (local.get $cid) (i32.const 210)) (i32.le_s (local.get $cid) (i32.const 218))) (then (i32.sub (local.get $cid) (i32.const 210)))
    (else (if i32 (i32.eq (local.get $cid) (i32.const 394)) (then (i32.const 9))
      (else (if i32 (i32.eq (local.get $cid) (i32.const 395)) (then (i32.const 10)) (else (i32.const -1))))))))

(func $ta_make (param $elem i32) (param $argc i32) (param $argv i32) (result i64) (effects)
  (let $bpe i32 (call $ta_bpe (local.get $elem)))
  (let $a0 i64 (call $argn (local.get $argv) (local.get $argc) (i32.const 0)))
  (let $len i32 (i32.const 0))
  (let $buf i32 (i32.const 0))
  (if (call $is_number (local.get $a0))
    (then
      (set! $len (call $to_index (local.get $a0)))  ;; ToIndex: RangeError on negative/Infinity/>2^53 (no trap)
      (if (call $err) (then (return (call $v_undef))))
      (set! $buf (call $heap_alloc (i32.add (i32.mul (local.get $len) (local.get $bpe)) (i32.const 8))))
      (call $ta_zero (local.get $buf) (i32.mul (local.get $len) (local.get $bpe))))
    (else (if (call $is_array (local.get $a0))
      (then
        (let $ap i32 (call $val_payload (local.get $a0)))
        (set! $len (call $arr_len (local.get $ap)))
        (set! $buf (call $heap_alloc (i32.add (i32.mul (local.get $len) (local.get $bpe)) (i32.const 8))))
        (call $ta_zero (local.get $buf) (i32.mul (local.get $len) (local.get $bpe)))
        (let $ti i32 (i32.const 0))
        (block $te (loop $tl (br_if $te (i32.ge_s (local.get $ti) (local.get $len)))
          (call $ta_store_val (local.get $buf) (local.get $ti) (local.get $elem) (call $arr_get (local.get $ap) (local.get $ti)))
          (set! $ti (i32.add (local.get $ti) (i32.const 1))) (br $tl))))
      (else (if (call $is_object (local.get $a0))
        (then
          (let $absl i32 (call $scope_find_local (call $val_payload (local.get $a0)) (cstring "@@abdata")))
          (if (local.get $absl)
            (then  ;; view over an ArrayBuffer
              (let $boff i32 (if i32 (i32.ge_s (local.get $argc) (i32.const 2)) (then (call $to_int_idx (call $to_num (call $argn (local.get $argv) (local.get $argc) (i32.const 1))))) (else (i32.const 0))))
              (set! $buf (i32.add (i32.trunc_f64_s (call $tonum_raw (i64.load (local.get $absl)))) (local.get $boff)))
              (let $ablen i32 (call $to_int_idx (call $to_num (call $get_prop (local.get $a0) (call $mk_str (cstring "byteLength"))))))
              (set! $len (if i32 (i32.ge_s (local.get $argc) (i32.const 3)) (then (call $to_int_idx (call $to_num (call $argn (local.get $argv) (local.get $argc) (i32.const 2))))) (else (i32.div_s (i32.sub (local.get $ablen) (local.get $boff)) (local.get $bpe))))))
            (else  ;; array-like / iterable with a length
              (set! $len (call $to_int_idx (call $to_num (call $get_prop (local.get $a0) (call $mk_str (cstring "length"))))))
              (set! $buf (call $heap_alloc (i32.add (i32.mul (local.get $len) (local.get $bpe)) (i32.const 8))))
              (call $ta_zero (local.get $buf) (i32.mul (local.get $len) (local.get $bpe)))
              (let $ti2 i32 (i32.const 0))
              (block $te2 (loop $tl2 (br_if $te2 (i32.ge_s (local.get $ti2) (local.get $len)))
                (call $ta_store_val (local.get $buf) (local.get $ti2) (local.get $elem) (call $get_prop (local.get $a0) (call $num (f64.convert_i32_s (local.get $ti2)))))
                (set! $ti2 (i32.add (local.get $ti2) (i32.const 1))) (br $tl2))))))
        (else (set! $buf (call $heap_alloc (i32.const 8)))))))))
  (let $to i32 (call $obj_new (i32.const 8)))
  ;; link the per-type prototype (Int8Array.prototype …) → %TypedArray.prototype%
  (let $taproto i32 (i32.load (i32.add (i32.const 532) (i32.mul (local.get $elem) (i32.const 4)))))
  (if (local.get $taproto) (then (i32.store (local.get $to) (local.get $taproto)))
    (else (if (i32.load (i32.const 528)) (then (i32.store (local.get $to) (i32.load (i32.const 528)))))))
  (call $scope_define (local.get $to) (cstring "@@taelem") (call $num (f64.convert_i32_s (local.get $elem))))
  (call $scope_define (local.get $to) (cstring "@@tabuf") (call $num (f64.convert_i32_s (local.get $buf))))
  (call $scope_define (local.get $to) (cstring "@@talen") (call $num (f64.convert_i32_s (local.get $len))))
  (call $scope_define_attr (local.get $to) (cstring "length") (call $num (f64.convert_i32_s (local.get $len))) (i32.const 12))  ;; DontEnum
  (call $scope_define_attr (local.get $to) (cstring "byteLength") (call $num (f64.convert_i32_s (i32.mul (local.get $len) (local.get $bpe)))) (i32.const 12))
  (call $scope_define_attr (local.get $to) (cstring "BYTES_PER_ELEMENT") (call $num (f64.convert_i32_s (local.get $bpe))) (i32.const 12))
  (call $mk_obj (local.get $to)))

;; build a symbol value from an internal key string and a description string.
(func $make_symbol (param $key i32) (param $desc i32) (result i64) (effects)
  (let $rec i32 (call $heap_alloc (i32.const 8)))
  (i32.store (local.get $rec) (local.get $key))
  (i32.store (i32.add (local.get $rec) (i32.const 4)) (local.get $desc))
  (call $mk_symbol (local.get $rec)))

;; integer → zero-padded decimal string of at least `w` chars (for toISOString).
(func $date_pad (param $v i32) (param $w i32) (result i32) (effects)
  (let $s i32 (call $num_to_str (f64.convert_i32_s (local.get $v))))
  (block $e (loop $l
    (br_if $e (i32.ge_s (call $str_len (local.get $s)) (local.get $w)))
    (set! $s (call $str_concat (cstring "0") (local.get $s)))
    (br $l)))
  (local.get $s))

;; read a run of decimal digits at cursor (mem 312) in string $s; advance the
;; cursor; return the value, or -1 if no digit. (helper for $parse_date_str)
(func $pd_int (param $s i32) (param $len i32) (result i32) (effects)
  (let $p i32 (i32.load (i32.const 312)))
  (let $v i32 (i32.const 0))
  (let $any i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $p) (local.get $len)))
    (let $c i32 (call $str_byte (local.get $s) (local.get $p)))
    (br_if $e (i32.or (i32.lt_s (local.get $c) (i32.const 48)) (i32.gt_s (local.get $c) (i32.const 57))))
    (set! $v (i32.add (i32.mul (local.get $v) (i32.const 10)) (i32.sub (local.get $c) (i32.const 48))))
    (set! $any (i32.const 1))
    (set! $p (i32.add (local.get $p) (i32.const 1))) (br $l)))
  (i32.store (i32.const 312) (local.get $p))
  (if i32 (local.get $any) (then (local.get $v)) (else (i32.const -1))))
;; current cursor byte (or 0 at end)
(func $pd_peek (param $s i32) (param $len i32) (result i32) (effects)
  (if i32 (i32.lt_s (i32.load (i32.const 312)) (local.get $len)) (then (call $str_byte (local.get $s) (i32.load (i32.const 312)))) (else (i32.const 0))))
;; parse an ISO-8601 date string → epoch ms, or NaN. Handles YYYY[-MM[-DD]]
;; [T HH:MM[:SS[.sss]]][Z]. (Timezone offsets other than Z are treated as UTC.)
(func $parse_date_str (param $s i32) (result f64) (effects)
  (let $len i32 (call $str_len (local.get $s)))
  (i32.store (i32.const 312) (i32.const 0))
  (let $ysign i32 (i32.const 1))  ;; ISO extended year: leading '-'/'+' followed by 6 digits
  (if (i32.eq (call $pd_peek (local.get $s) (local.get $len)) (i32.const 45))  ;; '-'
    (then (set! $ysign (i32.const -1)) (i32.store (i32.const 312) (i32.add (i32.load (i32.const 312)) (i32.const 1)))))
  (if (i32.eq (call $pd_peek (local.get $s) (local.get $len)) (i32.const 43))  ;; '+'
    (then (i32.store (i32.const 312) (i32.add (i32.load (i32.const 312)) (i32.const 1)))))
  (let $y i32 (call $pd_int (local.get $s) (local.get $len)))
  (if (i32.lt_s (local.get $y) (i32.const 0)) (then (return (f64.div (f64.const 0) (f64.const 0)))))
  ;; "-000000" (negative-zero extended year) is invalid
  (if (i32.and (i32.eq (local.get $ysign) (i32.const -1)) (i32.eqz (local.get $y))) (then (return (f64.div (f64.const 0) (f64.const 0)))))
  (set! $y (i32.mul (local.get $y) (local.get $ysign)))
  (let $mo i32 (i32.const 0)) (let $d i32 (i32.const 1))
  (let $h i32 (i32.const 0)) (let $mi i32 (i32.const 0)) (let $sec i32 (i32.const 0)) (let $ms i32 (i32.const 0))
  (if (i32.eq (call $pd_peek (local.get $s) (local.get $len)) (i32.const 45))  ;; '-'
    (then
      (i32.store (i32.const 312) (i32.add (i32.load (i32.const 312)) (i32.const 1)))
      (set! $mo (i32.sub (call $pd_int (local.get $s) (local.get $len)) (i32.const 1)))
      (if (i32.eq (call $pd_peek (local.get $s) (local.get $len)) (i32.const 45))
        (then
          (i32.store (i32.const 312) (i32.add (i32.load (i32.const 312)) (i32.const 1)))
          (set! $d (call $pd_int (local.get $s) (local.get $len)))))))
  ;; optional time part after 'T' or ' '
  (if (i32.or (i32.eq (call $pd_peek (local.get $s) (local.get $len)) (i32.const 84)) (i32.eq (call $pd_peek (local.get $s) (local.get $len)) (i32.const 32)))
    (then
      (i32.store (i32.const 312) (i32.add (i32.load (i32.const 312)) (i32.const 1)))
      (set! $h (call $pd_int (local.get $s) (local.get $len)))
      (if (i32.eq (call $pd_peek (local.get $s) (local.get $len)) (i32.const 58))  ;; ':'
        (then
          (i32.store (i32.const 312) (i32.add (i32.load (i32.const 312)) (i32.const 1)))
          (set! $mi (call $pd_int (local.get $s) (local.get $len)))
          (if (i32.eq (call $pd_peek (local.get $s) (local.get $len)) (i32.const 58))
            (then
              (i32.store (i32.const 312) (i32.add (i32.load (i32.const 312)) (i32.const 1)))
              (set! $sec (call $pd_int (local.get $s) (local.get $len)))
              (if (i32.eq (call $pd_peek (local.get $s) (local.get $len)) (i32.const 46))  ;; '.'
                (then
                  (i32.store (i32.const 312) (i32.add (i32.load (i32.const 312)) (i32.const 1)))
                  (set! $ms (call $pd_int (local.get $s) (local.get $len)))))))))))
  (if (i32.lt_s (local.get $mo) (i32.const 0)) (then (return (f64.div (f64.const 0) (f64.const 0)))))
  (call $date_make (i64.extend_i32_s (local.get $y)) (i64.extend_i32_s (local.get $mo)) (i64.extend_i32_s (local.get $d)) (i64.extend_i32_s (local.get $h)) (i64.extend_i32_s (local.get $mi)) (i64.extend_i32_s (local.get $sec)) (i64.extend_i32_s (local.get $ms))))

;; weekday (0=Sun) and month (0=Jan) 3-letter names for Date toString-family
(func $wday_name (param $w i32) (result i32) (effects)
  (if (i32.eq (local.get $w) (i32.const 0)) (then (return (cstring "Sun"))))
  (if (i32.eq (local.get $w) (i32.const 1)) (then (return (cstring "Mon"))))
  (if (i32.eq (local.get $w) (i32.const 2)) (then (return (cstring "Tue"))))
  (if (i32.eq (local.get $w) (i32.const 3)) (then (return (cstring "Wed"))))
  (if (i32.eq (local.get $w) (i32.const 4)) (then (return (cstring "Thu"))))
  (if (i32.eq (local.get $w) (i32.const 5)) (then (return (cstring "Fri"))))
  (cstring "Sat"))
(func $month_name (param $m i32) (result i32) (effects)
  (if (i32.eq (local.get $m) (i32.const 0)) (then (return (cstring "Jan"))))
  (if (i32.eq (local.get $m) (i32.const 1)) (then (return (cstring "Feb"))))
  (if (i32.eq (local.get $m) (i32.const 2)) (then (return (cstring "Mar"))))
  (if (i32.eq (local.get $m) (i32.const 3)) (then (return (cstring "Apr"))))
  (if (i32.eq (local.get $m) (i32.const 4)) (then (return (cstring "May"))))
  (if (i32.eq (local.get $m) (i32.const 5)) (then (return (cstring "Jun"))))
  (if (i32.eq (local.get $m) (i32.const 6)) (then (return (cstring "Jul"))))
  (if (i32.eq (local.get $m) (i32.const 7)) (then (return (cstring "Aug"))))
  (if (i32.eq (local.get $m) (i32.const 8)) (then (return (cstring "Sep"))))
  (if (i32.eq (local.get $m) (i32.const 9)) (then (return (cstring "Oct"))))
  (if (i32.eq (local.get $m) (i32.const 10)) (then (return (cstring "Nov"))))
  (cstring "Dec"))
;; year for the toString family: negative years get a leading '-' and >=4 zero-padded
;; digits (e.g. -1 → "-0001", -123456 → "-123456"); non-negative years pad to 4.
(func $date_year_str (param $y i32) (result i32) (effects)
  (if (i32.lt_s (local.get $y) (i32.const 0))
    (then (return (call $str_concat (cstring "-") (call $date_pad (i32.sub (i32.const 0) (local.get $y)) (i32.const 4))))))
  (call $date_pad (local.get $y) (i32.const 4)))

;; ISO-8601 year: years <0 or >9999 use a signed 6-digit form (±YYYYYY); else 4 digits.
(func $iso_year_str (param $y i32) (result i32) (effects)
  (if (i32.lt_s (local.get $y) (i32.const 0))
    (then (return (call $str_concat (cstring "-") (call $date_pad (i32.sub (i32.const 0) (local.get $y)) (i32.const 6))))))
  (if (i32.gt_s (local.get $y) (i32.const 9999))
    (then (return (call $str_concat (cstring "+") (call $date_pad (local.get $y) (i32.const 6))))))
  (call $date_pad (local.get $y) (i32.const 4)))

;; format a Date's time value: mode 0=full toString, 1=date, 2=time, 3=UTCString
(func $date_fmt (param $dtm f64) (param $mode i32) (result i32) (effects)
  (if (f64.ne (local.get $dtm) (local.get $dtm)) (then (return (cstring "Invalid Date"))))
  (let $datep i32 (call $str_concat (call $str_concat (call $str_concat (call $str_concat (call $str_concat (call $str_concat
    (call $wday_name (call $date_field (local.get $dtm) (i32.const 3))) (cstring " "))
    (call $month_name (call $date_field (local.get $dtm) (i32.const 1)))) (cstring " "))
    (call $date_pad (call $date_field (local.get $dtm) (i32.const 2)) (i32.const 2))) (cstring " "))
    (call $date_year_str (call $date_field (local.get $dtm) (i32.const 0)))))
  (let $timep i32 (call $str_concat (call $str_concat (call $str_concat (call $str_concat
    (call $date_pad (call $date_field (local.get $dtm) (i32.const 4)) (i32.const 2)) (cstring ":"))
    (call $date_pad (call $date_field (local.get $dtm) (i32.const 5)) (i32.const 2))) (cstring ":"))
    (call $date_pad (call $date_field (local.get $dtm) (i32.const 6)) (i32.const 2))))
  (if (i32.eq (local.get $mode) (i32.const 1)) (then (return (local.get $datep))))
  (if (i32.eq (local.get $mode) (i32.const 2)) (then (return (call $str_concat (local.get $timep) (cstring " GMT+0000 (Coordinated Universal Time)")))))
  (if (i32.eq (local.get $mode) (i32.const 3))  ;; UTCString: "Thu, 01 Jan 1970 00:00:00 GMT"
    (then (return (call $str_concat (call $str_concat (call $str_concat (call $str_concat (call $str_concat (call $str_concat (call $str_concat (call $str_concat (call $str_concat
      (call $wday_name (call $date_field (local.get $dtm) (i32.const 3))) (cstring ", "))
      (call $date_pad (call $date_field (local.get $dtm) (i32.const 2)) (i32.const 2))) (cstring " "))
      (call $month_name (call $date_field (local.get $dtm) (i32.const 1)))) (cstring " "))
      (call $date_year_str (call $date_field (local.get $dtm) (i32.const 0)))) (cstring " "))
      (local.get $timep)) (cstring " GMT")))))
  (call $str_concat (call $str_concat (local.get $datep) (cstring " ")) (call $str_concat (local.get $timep) (cstring " GMT+0000 (Coordinated Universal Time)"))))

;; truncate a split() result array to the optional limit argument (arg index 1).
(func $split_apply_limit (param $arr i32) (param $argv i32) (param $argc i32) (effects)
  (if (i32.ge_s (local.get $argc) (i32.const 2))
    (then
      (let $lv i64 (call $argn (local.get $argv) (local.get $argc) (i32.const 1)))
      (if (i32.eqz (call $is_undefined (local.get $lv)))
        (then
          (let $lim i32 (call $to_int_idx (call $to_num (local.get $lv))))
          (if (i32.and (i32.ge_s (local.get $lim) (i32.const 0)) (i32.gt_s (call $arr_len (local.get $arr)) (local.get $lim))) (then (i32.store (local.get $arr) (local.get $lim)))))))))

;; SameValue(a, b): like === except NaN equals NaN and +0 differs from -0.
(func $same_value (param $a i64) (param $b i64) (result i32) (effects)
  (if (i32.and (call $is_number (local.get $a)) (call $is_number (local.get $b)))
    (then
      (let $svan f64 (call $tonum_raw (local.get $a)))
      (let $svbn f64 (call $tonum_raw (local.get $b)))
      (if (i32.and (f64.ne (local.get $svan) (local.get $svan)) (f64.ne (local.get $svbn) (local.get $svbn))) (then (return (i32.const 1))))  ;; both NaN
      (if (i32.eqz (f64.eq (local.get $svan) (local.get $svbn))) (then (return (i32.const 0))))
      (if (f64.eq (local.get $svan) (f64.const 0))  ;; equal & zero → distinguish sign
        (then (return (i32.eq (f64.lt (f64.div (f64.const 1) (local.get $svan)) (f64.const 0)) (f64.lt (f64.div (f64.const 1) (local.get $svbn)) (f64.const 0))))))
      (return (i32.const 1))))
  (call $strict_eq (local.get $a) (local.get $b)))

;; [[DefineOwnProperty]] rejection. Object.defineProperty wants a thrown TypeError;
;; Reflect.defineProperty wants a `false` return. Reg 664 = soft mode (set by the
;; Reflect path around an apply_descriptor call): when set, record the failure in
;; reg 668 instead of throwing. The caller resets 664 and reads 668.
(func $def_reject (param $msg i32) (effects)
  (if (i32.load (i32.const 664))
    (then (i32.store (i32.const 668) (i32.const 1)))
    (else (call $throw_type (cstring "TypeError") (local.get $msg)))))

;; apply a property descriptor (scope $ds) onto object scope $os at key $ks,
;; implementing the [[DefineOwnProperty]] validation + attribute-merge rules.
;; Throws TypeError (sets err) on an invalid (re)definition.
;; $dval is the descriptor VALUE (any object — plain object, function, …). Read
;; fields per spec: presence via HasProperty (js_in, proto-aware), values via
;; [[Get]] (get_prop, accessor/inherited-aware, each read once).
(func $apply_descriptor (param $os i32) (param $ks i32) (param $dval i64) (effects)
  (let $gs i32 (call $truthy (call $js_in (call $mk_str (cstring "get")) (local.get $dval))))
  (let $ss i32 (call $truthy (call $js_in (call $mk_str (cstring "set")) (local.get $dval))))
  (let $en i32 (call $truthy (call $js_in (call $mk_str (cstring "enumerable")) (local.get $dval))))
  (let $cf i32 (call $truthy (call $js_in (call $mk_str (cstring "configurable")) (local.get $dval))))
  (let $wr i32 (call $truthy (call $js_in (call $mk_str (cstring "writable")) (local.get $dval))))
  (let $vs i32 (call $truthy (call $js_in (call $mk_str (cstring "value")) (local.get $dval))))
  (let $vGet i64 (if i64 (local.get $gs) (then (call $get_prop (local.get $dval) (call $mk_str (cstring "get")))) (else (call $v_undef))))
  (let $vSet i64 (if i64 (local.get $ss) (then (call $get_prop (local.get $dval) (call $mk_str (cstring "set")))) (else (call $v_undef))))
  (let $vVal i64 (if i64 (local.get $vs) (then (call $get_prop (local.get $dval) (call $mk_str (cstring "value")))) (else (call $v_undef))))
  ;; ToPropertyDescriptor: a present get/set field must be callable or undefined.
  (if (i32.and (local.get $gs) (i32.eqz (i32.or (call $is_function (local.get $vGet)) (call $is_undefined (local.get $vGet)))))
    (then (call $throw_type (cstring "TypeError") (cstring "Getter must be a function")) (return)))
  (if (i32.and (local.get $ss) (i32.eqz (i32.or (call $is_function (local.get $vSet)) (call $is_undefined (local.get $vSet)))))
    (then (call $throw_type (cstring "TypeError") (cstring "Setter must be a function")) (return)))
  (let $isAcc i32 (i32.or (i32.ne (local.get $gs) (i32.const 0)) (i32.ne (local.get $ss) (i32.const 0))))
  (let $hasData i32 (i32.or (i32.ne (local.get $vs) (i32.const 0)) (i32.ne (local.get $wr) (i32.const 0))))
  ;; a descriptor cannot be both a data and an accessor descriptor
  (if (i32.and (local.get $isAcc) (local.get $hasData))
    (then (call $throw_type (cstring "TypeError") (cstring "Invalid property descriptor (data and accessor)")) (return)))
  (let $wantEnum i32 (i32.and (i32.ne (local.get $en) (i32.const 0)) (call $truthy (call $get_prop (local.get $dval) (call $mk_str (cstring "enumerable"))))))
  (let $wantConf i32 (i32.and (i32.ne (local.get $cf) (i32.const 0)) (call $truthy (call $get_prop (local.get $dval) (call $mk_str (cstring "configurable"))))))
  (let $wantWrit i32 (i32.and (i32.ne (local.get $wr) (i32.const 0)) (call $truthy (call $get_prop (local.get $dval) (call $mk_str (cstring "writable"))))))
  (let $old i32 (call $scope_find_local (local.get $os) (local.get $ks)))
  ;; entry_is_accessor derefs old-4, so compute it ONCE guarded (i32.and is not short-circuit)
  (let $oldAcc i32 (if i32 (i32.ne (local.get $old) (i32.const 0)) (then (call $entry_is_accessor (local.get $old))) (else (i32.const 0))))
  (if (i32.eqz (local.get $old))
    (then
      ;; new property: forbidden on a non-extensible object
      (if (call $scope_find_local (local.get $os) (cstring "@@noext"))
        (then (call $def_reject (cstring "Cannot define property, object is not extensible")) (return))))
    (else
      ;; redefining: if the existing prop is non-configurable, enforce the limits
      (if (i32.eqz (call $entry_configurable (local.get $old)))
        (then
          (if (local.get $wantConf) (then (call $def_reject (cstring "Cannot redefine non-configurable property")) (return)))
          (if (i32.and (i32.ne (local.get $en) (i32.const 0)) (i32.ne (i32.ne (local.get $wantEnum) (i32.const 0)) (i32.ne (call $entry_enumerable (local.get $old)) (i32.const 0))))
            (then (call $def_reject (cstring "Cannot redefine non-configurable property")) (return)))
          ;; cannot switch between data and accessor
          (if (i32.or (i32.and (local.get $isAcc) (i32.eqz (local.get $oldAcc))) (i32.and (local.get $hasData) (local.get $oldAcc)))
            (then (call $def_reject (cstring "Cannot redefine non-configurable property")) (return)))
          ;; non-configurable accessor: a present get/set must equal the current one
          (if (local.get $oldAcc)
            (then
              (let $ocell i32 (call $val_payload (i64.load (local.get $old))))
              (if (i32.and (local.get $gs) (i32.eqz (call $strict_eq (local.get $vGet) (i64.load (local.get $ocell)))))
                (then (call $def_reject (cstring "Cannot redefine non-configurable property")) (return)))
              (if (i32.and (local.get $ss) (i32.eqz (call $strict_eq (local.get $vSet) (i64.load (i32.add (local.get $ocell) (i32.const 8))))))
                (then (call $def_reject (cstring "Cannot redefine non-configurable property")) (return)))))
          ;; non-writable data: cannot become writable nor change value
          (if (i32.and (i32.eqz (local.get $oldAcc)) (i32.eqz (call $entry_writable (local.get $old))))
            (then
              (if (local.get $wantWrit) (then (call $def_reject (cstring "Cannot redefine non-configurable property")) (return)))
              (if (i32.and (i32.ne (local.get $vs) (i32.const 0)) (i32.eqz (call $same_value (local.get $vVal) (i64.load (local.get $old)))))
                (then (call $def_reject (cstring "Cannot redefine non-configurable property")) (return)))))))))
  ;; ---- validation passed: compute merged attrs and write ----
  ;; treat as accessor if the descriptor is accessor, or it's generic over an
  ;; existing accessor.
  (let $treatAcc i32 (i32.or (local.get $isAcc) (i32.and (i32.eqz (local.get $hasData)) (local.get $oldAcc))))
  (let $attrs i32 (if i32 (i32.ne (local.get $old) (i32.const 0)) (then (i32.and (call $entry_kind (local.get $old)) (i32.const 14))) (else (i32.const 0))))
  (if (i32.ne (local.get $en) (i32.const 0)) (then (set! $attrs (if i32 (local.get $wantEnum) (then (i32.or (local.get $attrs) (i32.const 2))) (else (i32.and (local.get $attrs) (i32.const -3)))))))
  (if (i32.ne (local.get $cf) (i32.const 0)) (then (set! $attrs (if i32 (local.get $wantConf) (then (i32.or (local.get $attrs) (i32.const 4))) (else (i32.and (local.get $attrs) (i32.const -5)))))))
  (if (local.get $treatAcc)
    (then
      (call $scope_define_accessor_attr (local.get $os) (local.get $ks)
        (if i64 (local.get $gs) (then (local.get $vGet)) (else (if i64 (local.get $oldAcc) (then (i64.load (call $val_payload (i64.load (local.get $old))))) (else (call $v_undef)))))
        (if i64 (local.get $ss) (then (local.get $vSet)) (else (if i64 (local.get $oldAcc) (then (i64.load (i32.add (call $val_payload (i64.load (local.get $old))) (i32.const 8)))) (else (call $v_undef)))))
        (local.get $attrs)))
    (else
      (if (i32.ne (local.get $wr) (i32.const 0)) (then (set! $attrs (if i32 (local.get $wantWrit) (then (i32.or (local.get $attrs) (i32.const 8))) (else (i32.and (local.get $attrs) (i32.const -9)))))))
      (call $scope_define_attr (local.get $os) (local.get $ks)
        (if i64 (local.get $vs) (then (local.get $vVal))
          (else (if i64 (i32.and (i32.ne (local.get $old) (i32.const 0)) (i32.eqz (local.get $oldAcc))) (then (i64.load (local.get $old))) (else (call $v_undef)))))
        (local.get $attrs)))))

;; build a property-descriptor object from a property slot.
(func $make_descriptor (param $slot i32) (result i64) (effects)
  (let $r i32 (call $obj_new (i32.const 4)))
  (if (call $entry_is_accessor (local.get $slot))
    (then
      (let $cell i32 (call $val_payload (i64.load (local.get $slot))))
      (call $scope_define (local.get $r) (cstring "get") (i64.load (local.get $cell)))
      (call $scope_define (local.get $r) (cstring "set") (i64.load (i32.add (local.get $cell) (i32.const 8)))))
    (else
      (call $scope_define (local.get $r) (cstring "value") (i64.load (local.get $slot)))
      (call $scope_define (local.get $r) (cstring "writable") (call $mk_bool (call $entry_writable (local.get $slot))))))
  (call $scope_define (local.get $r) (cstring "enumerable") (call $mk_bool (call $entry_enumerable (local.get $slot))))
  (call $scope_define (local.get $r) (cstring "configurable") (call $mk_bool (call $entry_configurable (local.get $slot))))
  (call $mk_obj (local.get $r)))

;; define ONE property on an array (used by Object.defineProperty + defineProperties).
;; canonical index → element write; "length" {value} → resize (RangeError on invalid);
;; other named → @12 scope via apply_descriptor. RangeError surfaces via the err flag.
;; a property descriptor needs to "deopt" an array index out of the dense store
;; (into the @12 named scope) when it's an accessor OR carries non-default data
;; attributes (writable/enumerable/configurable:false). The dense store can't
;; carry per-index attributes or accessor pairs; the deopted entry lives in @12
;; and arr_get/arr_has/get_prop/set_prop consult @12 for hole indices so the
;; iteration builtins still observe it correctly.
(func $desc_needs_deopt (param $de i64) (result i32) (effects)
  (if (i32.or (call $truthy (call $js_in (call $mk_str (cstring "get")) (local.get $de)))
              (call $truthy (call $js_in (call $mk_str (cstring "set")) (local.get $de)))) (then (return (i32.const 1))))
  (if (i32.eqz (call $truthy (call $get_prop (local.get $de) (call $mk_str (cstring "writable"))))) (then (return (i32.const 1))))
  (if (i32.eqz (call $truthy (call $get_prop (local.get $de) (call $mk_str (cstring "enumerable"))))) (then (return (i32.const 1))))
  (if (i32.eqz (call $truthy (call $get_prop (local.get $de) (call $mk_str (cstring "configurable"))))) (then (return (i32.const 1))))
  (i32.const 0))

;; an array's length is writable unless made non-writable (@@lenNW marker) or frozen.
(func $arr_len_writable (param $a i32) (result i32) (effects)
  (let $p i32 (i32.load (i32.add (local.get $a) (i32.const 12))))
  (if (i32.eqz (local.get $p)) (then (return (i32.const 1))))
  (if (call $scope_find_local (local.get $p) (cstring "@@lenNW")) (then (return (i32.const 0))))
  (if (call $scope_find_local (local.get $p) (cstring "@@frozen")) (then (return (i32.const 0))))
  (i32.const 1))

;; a length-mutating Array method (push/pop/shift/unshift/splice) must throw a
;; TypeError when the array can't take the change: adding (isAdd=1) needs a
;; writable length AND extensibility; removing needs a writable length AND
;; configurable elements (sealed/frozen block it). Returns 1 (and throws) if locked.
(func $arr_mut_locked (param $arr i32) (param $isAdd i32) (result i32) (effects)
  (let $p i32 (i32.load (i32.add (local.get $arr) (i32.const 12))))
  (let $bad i32 (i32.eqz (call $arr_len_writable (local.get $arr))))  ;; @@lenNW or @@frozen
  (if (i32.and (i32.eqz (local.get $bad)) (i32.ne (local.get $p) (i32.const 0)))
    (then (if (local.get $isAdd)
      (then (if (call $scope_find_local (local.get $p) (cstring "@@noext")) (then (set! $bad (i32.const 1)))))
      (else (if (call $scope_find_local (local.get $p) (cstring "@@sealed")) (then (set! $bad (i32.const 1))))))))
  (if (local.get $bad) (then (call $throw_type (cstring "TypeError") (cstring "Cannot modify the length of a non-extensible array")) (return (i32.const 1))))
  (i32.const 0))

;; Object.defineProperty(arr, "length", desc) — the ArraySetLength algorithm
;; (ES 10.4.2.4 / 22.1.3.2). length is a non-configurable, non-enumerable data
;; property; non-writability is tracked with the @@lenNW marker in @12.
(func $arr_define_length (param $dpa i32) (param $de i64) (effects)
  ;; length is a data property — an accessor descriptor is always a TypeError
  (if (i32.or (call $truthy (call $js_in (call $mk_str (cstring "get")) (local.get $de)))
              (call $truthy (call $js_in (call $mk_str (cstring "set")) (local.get $de))))
    (then (call $throw_type (cstring "TypeError") (cstring "Cannot redefine property: length")) (return)))
  (let $hasVal i32 (call $truthy (call $js_in (call $mk_str (cstring "value")) (local.get $de))))
  (let $hasWr i32 (call $truthy (call $js_in (call $mk_str (cstring "writable")) (local.get $de))))
  (let $wantWr i32 (call $truthy (call $get_prop (local.get $de) (call $mk_str (cstring "writable")))))
  (let $hasCf i32 (call $truthy (call $js_in (call $mk_str (cstring "configurable")) (local.get $de))))
  (let $wantCf i32 (call $truthy (call $get_prop (local.get $de) (call $mk_str (cstring "configurable")))))
  (let $hasEn i32 (call $truthy (call $js_in (call $mk_str (cstring "enumerable")) (local.get $de))))
  (let $wantEn i32 (call $truthy (call $get_prop (local.get $de) (call $mk_str (cstring "enumerable")))))
  ;; ArraySetLength step order: when a value is present, ToUint32 + the RangeError
  ;; come FIRST (before the configurable/writable invariant TypeErrors).
  (let $dln i32 (i32.const 0))
  (if (local.get $hasVal)
    (then
      (let $dlnv f64 (call $to_num (call $get_prop (local.get $de) (call $mk_str (cstring "value")))))
      (set! $dln (call $to_int_idx (local.get $dlnv)))
      (if (i32.or (f64.ne (local.get $dlnv) (f64.convert_i32_s (local.get $dln))) (f64.lt (local.get $dlnv) (f64.const 0)))
        (then (call $throw_type (cstring "RangeError") (cstring "Invalid array length")) (return)))))
  ;; length is permanently non-configurable / non-enumerable
  (if (i32.and (local.get $hasCf) (local.get $wantCf)) (then (call $throw_type (cstring "TypeError") (cstring "Cannot redefine property: length")) (return)))
  (if (i32.and (local.get $hasEn) (local.get $wantEn)) (then (call $throw_type (cstring "TypeError") (cstring "Cannot redefine property: length")) (return)))
  (let $curW i32 (call $arr_len_writable (local.get $dpa)))
  ;; a non-writable length cannot be made writable again
  (if (i32.and (i32.eqz (local.get $curW)) (i32.and (local.get $hasWr) (local.get $wantWr))) (then (call $throw_type (cstring "TypeError") (cstring "Cannot redefine property: length")) (return)))
  (if (i32.eqz (local.get $hasVal))
    (then  ;; attribute-only change
      (if (i32.and (local.get $hasWr) (i32.eqz (local.get $wantWr))) (then (call $scope_define (call $arr_props (local.get $dpa)) (cstring "@@lenNW") (call $v_true))))
      (return)))
  (let $oldLen i32 (call $arr_len (local.get $dpa)))
  (if (i32.eqz (local.get $curW))
    (then  ;; non-writable: only a no-op (same length) is allowed
      (if (i32.ne (local.get $dln) (local.get $oldLen)) (then (call $throw_type (cstring "TypeError") (cstring "Cannot redefine property: length")) (return)))
      (return)))
  (if (i32.lt_s (local.get $dln) (local.get $oldLen))
    (then  ;; shrink: delete indices high→low, stop+throw at a non-configurable one
      (let $i i32 (i32.sub (local.get $oldLen) (i32.const 1)))
      (let $p i32 (i32.load (i32.add (local.get $dpa) (i32.const 12))))
      (block $done (loop $lp
        (br_if $done (i32.lt_s (local.get $i) (local.get $dln)))
        (if (local.get $p)
          (then (let $sl i32 (call $scope_find_local (local.get $p) (call $num_to_str (f64.convert_i32_s (local.get $i)))))
            (if (local.get $sl)
              (then
                (if (i32.eqz (call $entry_configurable (local.get $sl)))
                  (then (call $arr_set_length (local.get $dpa) (i32.add (local.get $i) (i32.const 1)))
                        (if (i32.and (local.get $hasWr) (i32.eqz (local.get $wantWr))) (then (call $scope_define (call $arr_props (local.get $dpa)) (cstring "@@lenNW") (call $v_true))))
                        (call $throw_type (cstring "TypeError") (cstring "Cannot delete non-configurable array index")) (return)))
                (drop (call $scope_delete (local.get $p) (call $num_to_str (f64.convert_i32_s (local.get $i)))))))))
        (set! $i (i32.sub (local.get $i) (i32.const 1)))
        (br $lp)))
      (call $arr_set_length (local.get $dpa) (local.get $dln)))
    (else (call $arr_set_length (local.get $dpa) (local.get $dln))))
  (if (i32.and (local.get $hasWr) (i32.eqz (local.get $wantWr))) (then (call $scope_define (call $arr_props (local.get $dpa)) (cstring "@@lenNW") (call $v_true)))))

(func $array_define_one (param $arrv i64) (param $ky i64) (param $de i64) (effects)
  (let $dpk i32 (call $to_str (local.get $ky)))
  (let $dpa i32 (call $val_payload (local.get $arrv)))
  (let $dpidx i32 (call $str_array_index (local.get $dpk)))
  (if (i32.ge_s (local.get $dpidx) (i32.const 0))
    (then
      ;; adding a new index at/after length is refused when length is non-writable
      (if (i32.and (i32.ge_s (local.get $dpidx) (call $arr_len (local.get $dpa))) (i32.eqz (call $arr_len_writable (local.get $dpa))))
        (then (call $throw_type (cstring "TypeError") (cstring "Cannot add property, length is not writable")) (return)))
      ;; if the index already lives in the @12 scope (previously deopted), redefine it there
      (let $dpp i32 (i32.load (i32.add (local.get $dpa) (i32.const 12))))
      (if (local.get $dpp)
        (then (if (call $scope_find_local (local.get $dpp) (local.get $dpk))
          (then (call $apply_descriptor (call $arr_props (local.get $dpa)) (local.get $dpk) (local.get $de)) (return)))))
      ;; accessor or non-default attributes → move this index to the @12 scope and
      ;; leave a hole in the dense store so it isn't double-counted
      (if (call $desc_needs_deopt (local.get $de))
        (then
          (let $aded i32 (i32.const 0))   ;; was there a present dense element here?
          (let $adev i64 (call $v_undef))
          (if (i32.lt_s (local.get $dpidx) (call $arr_len (local.get $dpa)))
            (then
              (let $adsl i32 (call $arr_slot (local.get $dpa) (local.get $dpidx)))
              (let $adv i64 (i64.load (local.get $adsl)))
              (if (i32.eqz (call $is_hole (local.get $adv))) (then (set! $aded (i32.const 1)) (set! $adev (local.get $adv))))
              (i64.store (local.get $adsl) (call $v_hole)))
            (else
              (call $arr_set_length (local.get $dpa) (i32.add (local.get $dpidx) (i32.const 1)))
              (i64.store (call $arr_slot (local.get $dpa) (local.get $dpidx)) (call $v_hole))))
          ;; seed the @12 entry with the dense element's implicit descriptor (value,
          ;; W|E|C all true) so apply_descriptor preserves attrs the new desc omits
          (if (local.get $aded) (then (call $scope_define (call $arr_props (local.get $dpa)) (local.get $dpk) (local.get $adev))))
          (call $apply_descriptor (call $arr_props (local.get $dpa)) (local.get $dpk) (local.get $de))
          (return)))
      (if (call $truthy (call $js_in (call $mk_str (cstring "value")) (local.get $de)))
        (then (call $arr_set (local.get $dpa) (local.get $dpidx) (call $get_prop (local.get $de) (call $mk_str (cstring "value")))))
        (else (call $arr_set (local.get $dpa) (local.get $dpidx) (call $v_undef)))))
    (else (if (call $str_eq (local.get $dpk) (cstring "length"))
      (then (call $arr_define_length (local.get $dpa) (local.get $de)))
      (else (call $apply_descriptor (call $arr_props (local.get $dpa)) (local.get $dpk) (local.get $de)))))))

;; URI unreserved: A-Za-z 0-9 - _ . ! ~ * ' ( )
(func $uri_unreserved (param $c i32) (result i32) (effects)
  (if (i32.and (i32.ge_s (local.get $c) (i32.const 65)) (i32.le_s (local.get $c) (i32.const 90))) (then (return (i32.const 1))))   ;; A-Z
  (if (i32.and (i32.ge_s (local.get $c) (i32.const 97)) (i32.le_s (local.get $c) (i32.const 122))) (then (return (i32.const 1))))  ;; a-z
  (if (i32.and (i32.ge_s (local.get $c) (i32.const 48)) (i32.le_s (local.get $c) (i32.const 57))) (then (return (i32.const 1))))   ;; 0-9
  ;; - _ . ! ~ = 45 95 46 33 126
  (if (i32.or (i32.eq (local.get $c) (i32.const 45)) (i32.or (i32.eq (local.get $c) (i32.const 95)) (i32.or (i32.eq (local.get $c) (i32.const 46)) (i32.or (i32.eq (local.get $c) (i32.const 33)) (i32.eq (local.get $c) (i32.const 126)))))) (then (return (i32.const 1))))
  ;; * ' ( ) = 42 39 40 41
  (if (i32.or (i32.eq (local.get $c) (i32.const 42)) (i32.or (i32.eq (local.get $c) (i32.const 39)) (i32.or (i32.eq (local.get $c) (i32.const 40)) (i32.eq (local.get $c) (i32.const 41))))) (then (return (i32.const 1))))
  (i32.const 0))
;; URI reserved (kept literal by encodeURI, kept %-encoded by decodeURI): ; , / ? : @ & = + $ #
(func $uri_reserved (param $c i32) (result i32) (effects)
  ;; ; , / ? : @ = 59 44 47 63 58 64
  (if (i32.or (i32.eq (local.get $c) (i32.const 59)) (i32.or (i32.eq (local.get $c) (i32.const 44)) (i32.or (i32.eq (local.get $c) (i32.const 47)) (i32.or (i32.eq (local.get $c) (i32.const 63)) (i32.or (i32.eq (local.get $c) (i32.const 58)) (i32.eq (local.get $c) (i32.const 64))))))) (then (return (i32.const 1))))
  ;; & = + $ # = 38 61 43 36 35
  (if (i32.or (i32.eq (local.get $c) (i32.const 38)) (i32.or (i32.eq (local.get $c) (i32.const 61)) (i32.or (i32.eq (local.get $c) (i32.const 43)) (i32.or (i32.eq (local.get $c) (i32.const 36)) (i32.eq (local.get $c) (i32.const 35)))))) (then (return (i32.const 1))))
  (i32.const 0))
(func $hexdig (param $n i32) (result i32) (effects)
  (if i32 (i32.lt_s (local.get $n) (i32.const 10)) (then (i32.add (local.get $n) (i32.const 48))) (else (i32.add (local.get $n) (i32.const 55)))))  ;; 0-9 / A-F
;; encode: copy unreserved (+ reserved when $full); others → %XX (uppercase) per byte
(func $uri_encode (param $s i32) (param $full i32) (result i32) (effects)
  (let $n i32 (call $str_len (local.get $s)))
  (let $out i32 (call $str_alloc (i32.mul (local.get $n) (i32.const 3))))
  (let $o i32 (i32.const 0)) (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    (let $c i32 (call $str_byte (local.get $s) (local.get $i)))
    (if (i32.or (call $uri_unreserved (local.get $c)) (i32.and (local.get $full) (call $uri_reserved (local.get $c))))
      (then (call $str_set_byte (local.get $out) (local.get $o) (local.get $c)) (set! $o (i32.add (local.get $o) (i32.const 1))))
      (else
        (call $str_set_byte (local.get $out) (local.get $o) (i32.const 37))  ;; '%'
        (call $str_set_byte (local.get $out) (i32.add (local.get $o) (i32.const 1)) (call $hexdig (i32.shr_u (local.get $c) (i32.const 4))))
        (call $str_set_byte (local.get $out) (i32.add (local.get $o) (i32.const 2)) (call $hexdig (i32.and (local.get $c) (i32.const 15))))
        (set! $o (i32.add (local.get $o) (i32.const 3)))))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
  (i32.store (local.get $out) (local.get $o))
  (local.get $out))
;; decode: %XX → byte; if $keepres and the byte is reserved, keep the literal %XX. Malformed % → URIError.
(func $uri_decode (param $s i32) (param $keepres i32) (result i32) (effects)
  (let $n i32 (call $str_len (local.get $s)))
  (let $out i32 (call $str_alloc (local.get $n)))
  (let $o i32 (i32.const 0)) (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    (let $c i32 (call $str_byte (local.get $s) (local.get $i)))
    (if (i32.eq (local.get $c) (i32.const 37))  ;; '%'
      (then
        (if (i32.gt_s (i32.add (local.get $i) (i32.const 2)) (i32.sub (local.get $n) (i32.const 1)))
          (then (call $throw_type (cstring "URIError") (cstring "URI malformed")) (return (local.get $out))))
        (let $h1 i32 (call $hexval (call $str_byte (local.get $s) (i32.add (local.get $i) (i32.const 1)))))
        (let $h2 i32 (call $hexval (call $str_byte (local.get $s) (i32.add (local.get $i) (i32.const 2)))))
        (if (i32.or (i32.lt_s (local.get $h1) (i32.const 0)) (i32.lt_s (local.get $h2) (i32.const 0)))
          (then (call $throw_type (cstring "URIError") (cstring "URI malformed")) (return (local.get $out))))
        (let $b i32 (i32.add (i32.mul (local.get $h1) (i32.const 16)) (local.get $h2)))
        (if (i32.and (local.get $keepres) (call $uri_reserved (local.get $b)))
          (then  ;; keep literal "%XX"
            (call $str_set_byte (local.get $out) (local.get $o) (i32.const 37))
            (call $str_set_byte (local.get $out) (i32.add (local.get $o) (i32.const 1)) (call $str_byte (local.get $s) (i32.add (local.get $i) (i32.const 1))))
            (call $str_set_byte (local.get $out) (i32.add (local.get $o) (i32.const 2)) (call $str_byte (local.get $s) (i32.add (local.get $i) (i32.const 2))))
            (set! $o (i32.add (local.get $o) (i32.const 3))))
          (else (call $str_set_byte (local.get $out) (local.get $o) (local.get $b)) (set! $o (i32.add (local.get $o) (i32.const 1)))))
        (set! $i (i32.add (local.get $i) (i32.const 3))))
      (else
        (call $str_set_byte (local.get $out) (local.get $o) (local.get $c)) (set! $o (i32.add (local.get $o) (i32.const 1)))
        (set! $i (i32.add (local.get $i) (i32.const 1)))))
    (br $l)))
  (i32.store (local.get $out) (local.get $o))
  (local.get $out))

;; [[GetPrototypeOf]]: array → Array.prototype; function → Function.prototype
;; (Function.prototype itself → Object.prototype); object → its scope parent (or null).
(func $js_get_prototype (param $ov i64) (result i64) (effects)
  ;; Proxy: getPrototypeOf trap, else target's prototype
  (if (call $is_proxy (local.get $ov))
    (then
      (let $pt i64 (call $proxy_trap (local.get $ov) (cstring "getPrototypeOf")))
      (if (call $err) (then (return (call $v_null))))
      (if (call $is_function (local.get $pt))
        (then
          (let $pgpt i64 (call $proxy_target (local.get $ov)))
          (let $pgres i64 (call $proxy_call2 (local.get $pt) (local.get $pgpt) (call $v_undef) (call $proxy_handler (local.get $ov))))
          (if (call $err) (then (return (call $v_null))))
          ;; invariant: the trap result must be an Object or null
          (if (i32.eqz (i32.or (call $is_null (local.get $pgres)) (i32.or (call $is_object (local.get $pgres)) (i32.or (call $is_array (local.get $pgres)) (call $is_function (local.get $pgres))))))
            (then (call $throw_type (cstring "TypeError") (cstring "proxy getPrototypeOf must return an object or null")) (return (call $v_null))))
          ;; invariant: if the target is non-extensible, the result must be the target's actual prototype
          (if (i32.and (call $is_object (local.get $pgpt)) (i32.ne (call $scope_find_local (call $val_payload (local.get $pgpt)) (cstring "@@noext")) (i32.const 0)))
            (then (if (i32.eqz (call $same_value (local.get $pgres) (call $js_get_prototype (local.get $pgpt))))
              (then (call $throw_type (cstring "TypeError") (cstring "proxy getPrototypeOf inconsistent with non-extensible target")) (return (call $v_null))))))
          (return (local.get $pgres)))
        (else (return (call $js_get_prototype (call $proxy_target (local.get $ov))))))))
  (if (call $is_array (local.get $ov)) (then (return (call $mk_obj (i32.load (i32.const 160))))))
  (if (call $is_function (local.get $ov))
    (then
      (if (call $strict_eq (local.get $ov) (i64.load (i32.const 336))) (then (return (call $mk_obj (i32.load (i32.const 328))))))
      (return (i64.load (i32.const 336)))))
  (if (call $is_object (local.get $ov))
    (then
      (let $par i32 (call $scope_parent (call $val_payload (local.get $ov))))
      (if (local.get $par) (then (return (call $mk_obj (local.get $par)))))))
  (call $v_null))

;; ToObject(v): objects/arrays/functions pass through; primitives → boxed wrapper.
;; null/undefined are the caller's responsibility (they must pre-check); here they
;; degrade to a fresh empty object rather than trapping.
(func $to_object (param $a i64) (result i64) (effects)
  (if (i32.or (call $is_object (local.get $a)) (i32.or (call $is_array (local.get $a)) (call $is_function (local.get $a))))
    (then (return (local.get $a))))
  (if (call $is_number (local.get $a)) (then (return (call $make_wrapper (local.get $a) (i32.load (i32.const 164))))))
  (if (call $is_string (local.get $a)) (then (return (call $make_wrapper (local.get $a) (i32.load (i32.const 156))))))
  (if (call $is_boolean (local.get $a)) (then (return (call $make_wrapper (local.get $a) (i32.load (i32.const 184))))))
  (if (call $is_bigint (local.get $a)) (then (return (call $make_wrapper (local.get $a) (i32.load (i32.const 624))))))  ;; BigInt.prototype
  (if (call $is_symbol (local.get $a)) (then (return (call $make_wrapper (local.get $a) (i32.load (i32.const 636))))))
  (call $mk_obj (call $obj_new (i32.const 8))))

;; native dispatch by id (1 = print, 2 = assert)
;; Iterator Helpers (335-357) — extracted from call_native to keep that function
;; under the compiler's per-statement recursion limit.
(func $native_iterator (param $id i32) (param $thisv i64) (param $argv i32) (param $argc i32) (result i64) (effects)
  ;; ── Iterator: abstract ctor (335) + %Iterator.prototype% eager methods ──
  (if (i32.eq (local.get $id) (i32.const 335))  ;; Iterator — abstract: throw only on DIRECT construction
    (then
      ;; subclass super() passes an instance whose [[Prototype]] is the subclass's
      ;; prototype (≠ %Iterator.prototype%); direct new Iterator() has proto === reg488.
      (if (i32.or (i32.eqz (call $is_object (local.get $thisv)))
                  (i32.eq (i32.load (call $val_payload (local.get $thisv))) (i32.load (i32.const 488))))
        (then (call $throw_type (cstring "TypeError") (cstring "Abstract class Iterator not directly constructable")) (return (call $v_undef))))
      (return (local.get $thisv))))
  (if (i32.eq (local.get $id) (i32.const 342))  ;; Iterator.prototype[@@iterator] → this
    (then (return (local.get $thisv))))
  (if (i32.eq (local.get $id) (i32.const 354))  ;; Iterator Helper .return() → close source, mark done
    (then
      (call $scope_define (call $val_payload (local.get $thisv)) (cstring "@@idone") (call $v_true))
      (call $iter_close (call $get_prop (local.get $thisv) (call $mk_str (cstring "@@isrc"))))
      (if (call $err) (then (return (call $v_undef))))
      (let $hrr i32 (call $obj_new (i32.const 2)))
      (call $scope_define (local.get $hrr) (cstring "value") (call $v_undef))
      (call $scope_define (local.get $hrr) (cstring "done") (call $v_true))
      (return (call $mk_obj (local.get $hrr)))))
  (if (i32.eq (local.get $id) (i32.const 352))  ;; get Iterator.prototype[@@toStringTag] → "Iterator"
    (then (return (call $mk_str (cstring "Iterator")))))
  (if (i32.eq (local.get $id) (i32.const 353))  ;; set [@@toStringTag] — SetterThatIgnoresPrototypeProperties
    (then
      (if (i32.eqz (call $is_object (local.get $thisv)))
        (then (call $throw_type (cstring "TypeError") (cstring "Iterator.prototype[Symbol.toStringTag] setter called on non-object")) (return (call $v_undef))))
      ;; setting on the home object (%Iterator.prototype%) itself is rejected
      (if (i32.eq (call $val_payload (local.get $thisv)) (i32.load (i32.const 488)))
