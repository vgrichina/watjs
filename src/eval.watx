      (if (call $is_object (local.get $thisv)) (then (set! $mo (call $val_payload (local.get $thisv)))))
      (call $scope_define (local.get $mo) (cstring "@@mk") (call $mk_arr (call $arr_new (i32.const 4))))
      (call $scope_define (local.get $mo) (cstring "@@mv") (call $mk_arr (call $arr_new (i32.const 4))))
      ;; new Map(iterable of [k,v]): AddEntriesFromIterable with adder = Get(map,"set")
