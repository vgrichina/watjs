;; STABLE bottom-up merge sort of the materialized array $arr[0,n) in place. O(n log n)
;; comparator calls (vs insertion sort's O(n^2)) so large arrays don't exhaust the heap.
;; Stops early if a comparator throws (err flag). Ties take the left run first (stable).
(func $merge_sort (param $arr i32) (param $n i32) (param $fn i64) (param $tanum i32) (effects)
  (if (i32.le_s (local.get $n) (i32.const 1)) (then (return)))
  (let $tmp i32 (call $arr_new (local.get $n)))
  (let $fi i32 (i32.const 0))
  (block $fe (loop $fl (br_if $fe (i32.ge_s (local.get $fi) (local.get $n))) (call $arr_push (local.get $tmp) (call $v_undef)) (set! $fi (i32.add (local.get $fi) (i32.const 1))) (br $fl)))
  (let $width i32 (i32.const 1))
  (block $we (loop $wl
    (br_if $we (i32.ge_s (local.get $width) (local.get $n)))
    (let $lo i32 (i32.const 0))
    (block $oe (loop $ol
      (br_if $oe (i32.ge_s (local.get $lo) (local.get $n)))
      (let $mid i32 (i32.add (local.get $lo) (local.get $width)))
      (if (i32.gt_s (local.get $mid) (local.get $n)) (then (set! $mid (local.get $n))))
      (let $hi i32 (i32.add (local.get $lo) (i32.mul (local.get $width) (i32.const 2))))
      (if (i32.gt_s (local.get $hi) (local.get $n)) (then (set! $hi (local.get $n))))
      (let $iL i32 (local.get $lo)) (let $iR i32 (local.get $mid)) (let $k i32 (local.get $lo))
      (block $me (loop $ml
        (br_if $me (i32.ge_s (local.get $k) (local.get $hi)))
        (let $takeLeft i32 (i32.const 0))
        (if (i32.ge_s (local.get $iL) (local.get $mid))
          (then (set! $takeLeft (i32.const 0)))
          (else (if (i32.ge_s (local.get $iR) (local.get $hi))
            (then (set! $takeLeft (i32.const 1)))
            (else (set! $takeLeft (i32.le_s (call $sort_cmp2 (local.get $fn) (call $arr_get (local.get $arr) (local.get $iL)) (call $arr_get (local.get $arr) (local.get $iR)) (local.get $tanum)) (i32.const 0)))))))
        (if (call $err) (then (return)))  ;; a throwing comparator → abort (error propagates)
        (if (local.get $takeLeft)
          (then (call $arr_set (local.get $tmp) (local.get $k) (call $arr_get (local.get $arr) (local.get $iL))) (set! $iL (i32.add (local.get $iL) (i32.const 1))))
          (else (call $arr_set (local.get $tmp) (local.get $k) (call $arr_get (local.get $arr) (local.get $iR))) (set! $iR (i32.add (local.get $iR) (i32.const 1)))))
