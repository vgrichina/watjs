        (then (if f64 (f64.gt (local.get $y) (f64.const 0)) (then (f64.div (f64.const 1) (f64.const 0))) (else (f64.const 0))))  ;; |x|>1
      (else (if f64 (f64.lt (local.get $ax) (f64.const 1))
        (then (if f64 (f64.gt (local.get $y) (f64.const 0)) (then (f64.const 0)) (else (f64.div (f64.const 1) (f64.const 0)))))  ;; |x|<1
