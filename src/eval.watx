        (let $exhit i32 (i32.const 0))
        (block $exe (loop $exl2
          (br_if $exe (i32.ge_s (local.get $exj) (call $arr_len (local.get $excl))))
          (if (call $str_eq (call $to_prop_key (local.get $pkey)) (call $to_prop_key (call $arr_get (local.get $excl) (local.get $exj)))) (then (set! $exhit (i32.const 1)) (br $exe)))
          (set! $exj (i32.add (local.get $exj) (i32.const 1))) (br $exl2)))
        (if (local.get $exhit) (then (set! $pi (i32.add (local.get $pi) (i32.const 1))) (br $l)))))
    (let $pdb i32 (call $heap_alloc (i32.const 16)))
    (i64.store (local.get $pdb) (local.get $src))
    (i64.store (i32.add (local.get $pdb) (i32.const 8)) (local.get $pkey))
    (let $pdesc i64 (call $call_native (i32.const 156) (i32.const 2) (local.get $pdb) (call $v_undef)))  ;; GetOwnProperty (gopd trap)
    (if (call $err) (then (return)))
    (if (i32.eqz (call $is_undefined (local.get $pdesc)))
      (then (if (call $truthy (call $get_prop (local.get $pdesc) (call $mk_str (cstring "enumerable"))))
        (then
          (let $pval i64 (call $get_prop (local.get $src) (local.get $pkey)))
          (if (call $err) (then (return)))
          (call $set_prop (local.get $target) (local.get $pkey) (local.get $pval))
          (if (call $err) (then (return)))))))
    (set! $pi (i32.add (local.get $pi) (i32.const 1)))
