            (br_if $je (i32.ge_s (local.get $i) (local.get $n)))
            (if (i32.gt_s (local.get $i) (i32.const 0)) (then (set! $out (call $str_concat (local.get $out) (local.get $sep)))))
            (let $e i64 (call $dense_get (local.get $thisv) (local.get $arr) (local.get $i)))  ;; join Gets every index; a real-array hole inherits Array.prototype[i]
            (if (i32.eqz (i32.or (call $is_undefined (local.get $e)) (call $is_null (local.get $e))))
