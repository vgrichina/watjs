;; a hard proxy invariant violation (caller must check $err).
(func $setproto_internal (param $o i64) (param $proto i64) (result i32) (effects)
  (if (call $is_proxy (local.get $o))
    (then
      (let $sph i64 (call $proxy_handler (local.get $o)))
      (let $sptrap i64 (call $proxy_trap (local.get $o) (cstring "setPrototypeOf")))
      (if (call $err) (then (return (i32.const 0))))
      (let $sptgt i64 (call $proxy_target (local.get $o)))
      (if (i32.eqz (call $is_function (local.get $sptrap)))
        (then (return (call $setproto_internal (local.get $sptgt) (local.get $proto)))))
      (let $sptb i32 (call $heap_alloc (i32.const 16)))
      (i64.store (local.get $sptb) (local.get $sptgt))
      (i64.store (i32.add (local.get $sptb) (i32.const 8)) (local.get $proto))
      (let $sptres i32 (call $truthy (call $call_val (local.get $sptrap) (i32.const 2) (local.get $sptb) (local.get $sph))))
      (if (call $err) (then (return (i32.const 0))))
      (if (i32.eqz (local.get $sptres)) (then (return (i32.const 0))))
      (let $spext i32 (call $truthy (call $call_native (i32.const 163) (i32.const 1) (call $argv1 (local.get $sptgt)) (call $v_undef))))
      (if (call $err) (then (return (i32.const 0))))
      (if (local.get $spext) (then (return (i32.const 1))))
      (let $sptp i64 (call $js_get_prototype (local.get $sptgt)))
      (if (call $err) (then (return (i32.const 0))))
      (if (i32.eqz (call $same_value (local.get $proto) (local.get $sptp)))
        (then (call $throw_type (cstring "TypeError") (cstring "proxy setPrototypeOf: cannot change the prototype of a non-extensible target")) (return (i32.const 0))))
      (return (i32.const 1))))
  (if (call $is_object (local.get $o))
    (then
      (let $spsc i32 (call $val_payload (local.get $o)))
      (let $spnewp i32 (if i32 (call $is_object (local.get $proto)) (then (call $val_payload (local.get $proto))) (else (i32.const 0))))
      ;; a non-extensible object's [[Prototype]] can only be set to its CURRENT value (a no-op);
      ;; changing it to a different prototype fails (Object.setPrototypeOf throws; Reflect → false).
      (if (call $scope_find_local (local.get $spsc) (cstring "@@noext"))
        (then (if (i32.ne (local.get $spnewp) (call $scope_parent (local.get $spsc))) (then (return (i32.const 0))))))
      (let $spwc i32 (local.get $spnewp))
      (block $spcyc (loop $spcycl
        (br_if $spcyc (i32.eqz (local.get $spwc)))
        (if (i32.eq (local.get $spwc) (local.get $spsc)) (then (return (i32.const 0))))  ;; cyclic → soft false
        (set! $spwc (call $scope_parent (local.get $spwc)))
