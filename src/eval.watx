      (block $be (loop $bc
        (br_if $be (i32.eq (call $cur) (i32.const 16)))  ;; ')'
        (br_if $be (i32.eq (call $cur) (i32.const 0)))
        (if (i32.eq (call $cur) (i32.const 54))  ;; ...rest (must be last)
          (then
            (call $advance)
            (let $rn i32 (call $ident_name)) (call $advance)
            (let $ra i32 (call $arr_new (i32.const 4)))
            (let $rj i32 (local.get $pi))
            (block $re (loop $rl
              (br_if $re (i32.ge_s (local.get $rj) (local.get $argc)))
              (call $arr_push (local.get $ra) (i64.load (i32.add (local.get $argv) (i32.mul (local.get $rj) (i32.const 8)))))
              (set! $rj (i32.add (local.get $rj) (i32.const 1)))
              (br $rl)))
            (call $scope_define (local.get $ns) (local.get $rn) (call $mk_arr (local.get $ra)))
            (br $be)))
        (let $pn i32 (call $ident_name)) (call $advance)
        (let $pv i64 (if i64 (i32.lt_s (local.get $pi) (local.get $argc))
                        (then (i64.load (i32.add (local.get $argv) (i32.mul (local.get $pi) (i32.const 8)))))
                        (else (call $v_undef))))
        (if (i32.eq (call $cur) (i32.const 24))  ;; = default
          (then
            (call $advance)
            (if (call $is_undefined (local.get $pv))
              (then (set! $pv (call $parse_assign)))                                   ;; missing → evaluate default
              (else (call $sup_inc) (drop (call $parse_assign)) (call $sup_dec)))))     ;; provided → skip default
        (call $scope_define (local.get $ns) (local.get $pn) (local.get $pv))
        (set! $pi (i32.add (local.get $pi) (i32.const 1)))
        (br_if $be (i32.eqz (call $eat (i32.const 22))))
        (br $bc))))
    (else
      ;; paramKind 0: simple positional names (arrows)
      (let $i i32 (i32.const 0))
      (block $be2 (loop $bc2
        (br_if $be2 (i32.ge_s (local.get $i) (local.get $np)))
        (let $pname i32 (i32.load (i32.add (i32.add (local.get $fn) (i32.const 52)) (i32.mul (local.get $i) (i32.const 4)))))
        (let $av i64 (if i64 (i32.lt_s (local.get $i) (local.get $argc))
                        (then (i64.load (i32.add (local.get $argv) (i32.mul (local.get $i) (i32.const 8)))))
                        (else (call $v_undef))))
        (call $scope_define (local.get $ns) (local.get $pname) (local.get $av))
        (set! $i (i32.add (local.get $i) (i32.const 1)))
        (br $bc2)))))
  ;; bind `arguments` (array of all passed args)
  (let $argsArr i32 (call $arr_new (i32.add (local.get $argc) (i32.const 1))))
  (let $ai i32 (i32.const 0))
  (block $age (loop $agl
    (br_if $age (i32.ge_s (local.get $ai) (local.get $argc)))
    (call $arr_push (local.get $argsArr) (i64.load (i32.add (local.get $argv) (i32.mul (local.get $ai) (i32.const 8)))))
    (set! $ai (i32.add (local.get $ai) (i32.const 1)))
    (br $agl)))
  (call $scope_define (local.get $ns) (cstring "arguments") (call $mk_arr (local.get $argsArr)))
  (call $set_cur_scope (local.get $ns))
  (call $set_src (i32.load (i32.add (local.get $fn) (i32.const 40))) (i32.load (i32.add (local.get $fn) (i32.const 44))))
  (call $cursor_restore (i32.add (local.get $fn) (i32.const 16)))
  (call $hoist_vars (local.get $ns) (i32.const 0))           ;; hoist var declarations
  (call $cursor_restore (i32.add (local.get $fn) (i32.const 16)))
  (i32.store (i32.const 88) (i32.const 0))  ;; clear RETFLAG
  (let $rv i64 (call $v_undef))
  (if (i32.eq (call $cur) (i32.const 17))  ;; '{' → statement body
    (then
      (call $parse_block)
      (if (call $retflag) (then (set! $rv (i64.load (i32.const 96))))))
    (else (set! $rv (call $parse_assign))))  ;; expression body (arrow) → implicit return
  (i32.store (i32.const 88) (i32.const 0))  ;; clear RETFLAG
  (call $clear_loopflags)                   ;; a break/continue must not escape a call
  (call $set_cur_scope (local.get $savedScope))
  (call $set_this (local.get $savedThis))
  (call $set_src (local.get $savedSrc) (local.get $savedLen))
  (call $cursor_restore (local.get $savedCur))
  (local.get $rv))

;; comparator for Array#sort: cmpFn(a,b) sign, or default string compare
(func $sort_cmp (param $fn i64) (param $a i64) (param $b i64) (result i32) (effects)
  (if i32 (call $is_function (local.get $fn))
    (then
      (let $av i32 (call $heap_alloc (i32.const 16)))
      (i64.store (local.get $av) (local.get $a))
      (i64.store (i32.add (local.get $av) (i32.const 8)) (local.get $b))
      (let $r f64 (call $to_num (call $call_val (local.get $fn) (i32.const 2) (local.get $av) (call $v_undef))))
      (if i32 (f64.lt (local.get $r) (f64.const 0)) (then (i32.const -1))
        (else (if i32 (f64.gt (local.get $r) (f64.const 0)) (then (i32.const 1)) (else (i32.const 0))))))
    (else (call $str_cmp (call $to_str (local.get $a)) (call $to_str (local.get $b))))))

;; call a function value with args + this
(func $call_val (param $fnval i64) (param $argc i32) (param $argv i32) (param $thisv i64) (result i64) (effects)
  (if (i32.eqz (call $is_function (local.get $fnval))) (then (return (call $v_undef))))
  (let $fn i32 (call $val_payload (local.get $fnval)))
  (if (i32.eq (i32.load (local.get $fn)) (i32.const 1448232526))  ;; VM-fn → run on the VM
    (then (return (call $vm_call_fn (local.get $fn) (local.get $argc) (local.get $argv) (local.get $thisv)))))
  (if i64 (i32.load (local.get $fn))
    (then (call $call_native (i32.load (local.get $fn)) (local.get $argc) (local.get $argv) (local.get $thisv)))
    (else (call $call_user (local.get $fn) (local.get $argc) (local.get $argv) (local.get $thisv)))))

;; call a function value with a given `this` and no arguments
(func $call_fn0 (param $fnval i64) (param $thisv i64) (result i64) (effects)
  (if (i32.eqz (call $is_function (local.get $fnval))) (then (return (call $v_undef))))
  (let $fn i32 (call $val_payload (local.get $fnval)))
  (let $argv i32 (call $heap_alloc (i32.const 8)))
  (if i64 (i32.eq (i32.load (local.get $fn)) (i32.const 1448232526))  ;; VM-fn → run on the VM
    (then (call $vm_call_fn (local.get $fn) (i32.const 0) (local.get $argv) (local.get $thisv)))
  (else (if i64 (i32.load (local.get $fn))
    (then (call $call_native (i32.load (local.get $fn)) (i32.const 0) (local.get $argv) (local.get $thisv)))
    (else (call $call_user (local.get $fn) (i32.const 0) (local.get $argv) (local.get $thisv)))))))

;; eval(string): re-enter the parser on the string, return the completion value.
(func $eval_string (param $s i32) (result i64) (effects)
  (let $oldsrc i32 (call $src))
  (let $oldlen i32 (call $src_len))
  (let $oldcur i32 (call $cursor_save))
  (call $set_src (i32.add (local.get $s) (i32.const 4)) (call $str_len (local.get $s)))
  (call $lex_init)
  (call $advance)
  (let $result i64 (call $v_undef))
  (block $brk (loop $cont
    (br_if $brk (i32.eq (call $cur) (i32.const 0)))
    (br_if $brk (call $unwind))
    (if (call $is_stmt_start)
      (then (call $parse_statement))
      (else (set! $result (call $parse_comma)) (drop (call $eat (i32.const 21)))))
    (br $cont)))
  (call $set_src (local.get $oldsrc) (local.get $oldlen))
  (call $cursor_restore (local.get $oldcur))
  (local.get $result))

;; parse and evaluate a call:  callee '(' args ')'
(func $parse_call (param $callee i64) (param $thisv i64) (result i64) (effects)
  (call $advance)  ;; '('
  (let $argv i32 (call $heap_alloc (i32.const 1024)))  ;; up to 128 args
  (let $argc i32 (i32.const 0))
  (block $ae (loop $ac
    (br_if $ae (i32.eq (call $cur) (i32.const 16)))  ;; ')'
    (br_if $ae (i32.eq (call $cur) (i32.const 0)))
    (br_if $ae (call $err))
    (if (i32.eq (call $cur) (i32.const 54))  ;; ...spread
      (then
        (call $advance)
        (let $sv i64 (call $parse_assign))
        (if (call $is_array (local.get $sv))
          (then
            (let $sa i32 (call $val_payload (local.get $sv)))
            (let $si i32 (i32.const 0))
            (block $se2 (loop $sl2
              (br_if $se2 (i32.ge_s (local.get $si) (call $arr_len (local.get $sa))))
              (i64.store (i32.add (local.get $argv) (i32.mul (local.get $argc) (i32.const 8))) (call $arr_get (local.get $sa) (local.get $si)))
              (set! $argc (i32.add (local.get $argc) (i32.const 1)))
              (set! $si (i32.add (local.get $si) (i32.const 1)))
              (br $sl2))))))
      (else
        (i64.store (i32.add (local.get $argv) (i32.mul (local.get $argc) (i32.const 8))) (call $parse_assign))
        (set! $argc (i32.add (local.get $argc) (i32.const 1)))))
    (br_if $ae (i32.eqz (call $eat (i32.const 22))))
    (br $ac)))
  (call $expect (i32.const 16) (cstring "expected )"))
  (if (i32.or (call $suppress) (call $err)) (then (return (call $v_undef))))
  (if (i32.eqz (call $is_function (local.get $callee)))
    (then (call $throw_type (cstring "TypeError") (cstring "not a function")) (return (call $v_undef))))
  (let $fn i32 (call $val_payload (local.get $callee)))
  (let $nat i32 (i32.load (local.get $fn)))
  (if i64 (local.get $nat)
    (then (call $call_native (local.get $nat) (local.get $argc) (local.get $argv) (local.get $thisv)))
    (else (call $call_user (local.get $fn) (local.get $argc) (local.get $argv) (local.get $thisv)))))

;; parse a function literal/declaration. as_decl=1 binds the name in scope.
;; parse a function from the '(' params ')' '{' body '}' (cursor at '('); returns fn value
;; Fn struct: @0 nativeId, @4 closureScope, @8 nparam, @12 props, @16 bodyCursor(24),
;; @40 srcPtr, @44 srcLen, @48 paramKind (1 = cursor at @52, supports default/rest;
;; 0 = name array at @52, arrows), @52 params (cursor 24B or i32 names[]).
(func $parse_fn_body (result i64) (effects)
  (call $expect (i32.const 15) (cstring "expected ("))
  (let $pcur i32 (call $cursor_save))  ;; cursor at first param token (or ')')
  ;; scan params to count them and reach ')'; skip ...rest and = default exprs
  (let $np i32 (i32.const 0))
  (block $pe (loop $pc
    (br_if $pe (i32.eq (call $cur) (i32.const 16)))  ;; ')'
    (br_if $pe (i32.eq (call $cur) (i32.const 0)))
    (if (i32.eq (call $cur) (i32.const 54)) (then (call $advance)))  ;; ...rest
    (if (i32.eq (call $cur) (i32.const 3)) (then (call $advance) (set! $np (i32.add (local.get $np) (i32.const 1)))))
    (if (i32.eq (call $cur) (i32.const 24))  ;; = default value
      (then (call $advance) (call $sup_inc) (drop (call $parse_assign)) (call $sup_dec)))
    (br_if $pe (i32.eqz (call $eat (i32.const 22))))
    (br $pc)))
  (call $expect (i32.const 16) (cstring "expected )"))
  (let $fn i32 (call $heap_alloc (i32.const 76)))
  (i32.store (local.get $fn) (i32.const 0))                                   ;; native=0
  (i32.store (i32.add (local.get $fn) (i32.const 4)) (call $cur_scope))       ;; closure scope
  (i32.store (i32.add (local.get $fn) (i32.const 8)) (local.get $np))         ;; param count (hint)
  (i32.store (i32.add (local.get $fn) (i32.const 12)) (i32.const 0))          ;; props (lazy)
  (call $cursor_store (i32.add (local.get $fn) (i32.const 16)))               ;; body cursor at '{'
  (i32.store (i32.add (local.get $fn) (i32.const 40)) (call $src))            ;; source buffer ptr
  (i32.store (i32.add (local.get $fn) (i32.const 44)) (call $src_len))        ;; source length
  (i32.store (i32.add (local.get $fn) (i32.const 48)) (i32.const 1))          ;; paramKind = cursor
  (i64.store (i32.add (local.get $fn) (i32.const 52)) (i64.load (local.get $pcur)))
  (i64.store (i32.add (local.get $fn) (i32.const 60)) (i64.load (i32.add (local.get $pcur) (i32.const 8))))
  (i64.store (i32.add (local.get $fn) (i32.const 68)) (i64.load (i32.add (local.get $pcur) (i32.const 16))))
  (call $sup_inc) (call $parse_block) (call $sup_dec)  ;; skip the body
  (call $mk_fn (local.get $fn)))

(func $parse_function (param $as_decl i32) (result i64) (effects)
  (call $advance)  ;; 'function'
  (let $name i32 (i32.const 0))
  (if (i32.eq (call $cur) (i32.const 3)) (then (set! $name (call $ident_name)) (call $advance)))
  (let $fv i64 (call $parse_fn_body))
  (call $scope_define (call $fn_props (call $val_payload (local.get $fv))) (cstring "name")
    (call $mk_str (if i32 (i32.ne (local.get $name) (i32.const 0)) (then (local.get $name)) (else (cstring "")))))
  (if (i32.and (local.get $as_decl) (i32.and (i32.ne (local.get $name) (i32.const 0)) (i32.eqz (call $suppress))))
    (then (call $scope_define (call $cur_scope) (local.get $name) (local.get $fv))))
  (local.get $fv))

;; super(args) / super.method(args): the "super prototype" is the grandparent of
;; `this` in the prototype chain (covers single-level inheritance).
(func $parse_super (result i64) (effects)
  (call $advance)  ;; 'super'
  (let $thisv i64 (call $get_this))
  (let $spo i32 (i32.const 0))
  (if (call $is_object (local.get $thisv))
    (then
      (let $p1 i32 (call $scope_parent (call $val_payload (local.get $thisv))))
      (if (local.get $p1) (then (set! $spo (call $scope_parent (local.get $p1)))))))
  ;; collect call args helper (used by both forms)
  (if (i32.eq (call $cur) (i32.const 23))  ;; super.method
    (then
      (call $advance)
      (let $mn i32 (call $ident_name))
      (call $advance)
      (let $fn i64 (call $v_undef))
      (if (local.get $spo)
        (then (let $sl i32 (call $scope_find (local.get $spo) (local.get $mn)))
              (if (local.get $sl) (then (set! $fn (i64.load (local.get $sl)))))))
      (if (i32.eq (call $cur) (i32.const 15))  ;; call it
        (then (return (call $super_call (local.get $fn) (local.get $thisv))))
        (else (return (local.get $fn))))))
  (if (i32.eq (call $cur) (i32.const 15))  ;; super(...) — call parent constructor
    (then
      (let $ctor i64 (call $v_undef))
      (if (local.get $spo)
        (then (let $cs i32 (call $scope_find_local (local.get $spo) (cstring "constructor")))
              (if (local.get $cs) (then (set! $ctor (i64.load (local.get $cs)))))))
      (return (call $super_call (local.get $ctor) (local.get $thisv)))))
  (call $v_undef))

;; parse an argument list (cursor at '(') and call `fn` with `thisv`
(func $super_call (param $fn i64) (param $thisv i64) (result i64) (effects)
  (call $advance)  ;; '('
  (let $argv i32 (call $heap_alloc (i32.const 128)))
  (let $argc i32 (i32.const 0))
  (block $ae (loop $ac
    (br_if $ae (i32.eq (call $cur) (i32.const 16)))
    (br_if $ae (i32.eq (call $cur) (i32.const 0)))
    (br_if $ae (call $err))
    (i64.store (i32.add (local.get $argv) (i32.mul (local.get $argc) (i32.const 8))) (call $parse_assign))
    (set! $argc (i32.add (local.get $argc) (i32.const 1)))
    (br_if $ae (i32.eqz (call $eat (i32.const 22))))
    (br $ac)))
  (call $expect (i32.const 16) (cstring "expected )"))
  (if (i32.or (call $suppress) (call $err)) (then (return (call $v_undef))))
  (call $call_val (local.get $fn) (local.get $argc) (local.get $argv) (local.get $thisv)))

;; class Name { constructor(){} method(){} static m(){} get/set x(){} }
(func $parse_class (param $as_decl i32) (result i64) (effects)
  (call $advance)  ;; 'class'
  (let $name i32 (i32.const 0))
  (if (i32.eq (call $cur) (i32.const 3)) (then (set! $name (call $ident_name)) (call $advance)))
  ;; extends Super
  (let $super i64 (call $v_undef))
  (let $hasSuper i32 (i32.const 0))
  (if (call $tok_is_kw (cstring "extends"))
    (then (call $advance) (set! $super (call $parse_postfix)) (set! $hasSuper (i32.const 1))))
  (call $expect (i32.const 17) (cstring "expected {"))
  (let $proto i32 (call $obj_new (i32.const 16)))
  ;; if extends, link proto chain: proto.__proto__ = Super.prototype
  (if (i32.and (local.get $hasSuper) (call $is_function (local.get $super)))
    (then (i32.store (local.get $proto) (call $val_payload (call $fn_get_prototype (call $val_payload (local.get $super)))))))
  (let $statics i32 (call $obj_new (i32.const 8)))
  (let $ctor i32 (i32.const 0))
  (block $brk (loop $cont
    (br_if $brk (i32.eq (call $cur) (i32.const 18)))  ;; '}'
    (br_if $brk (i32.eq (call $cur) (i32.const 0)))
    (br_if $brk (call $err))
    (if (i32.eq (call $cur) (i32.const 21)) (then (call $advance) (br $cont)))  ;; empty ';'
    (let $isStatic i32 (i32.const 0))
    (if (call $tok_is_kw (cstring "static")) (then (set! $isStatic (i32.const 1)) (call $advance)))
    ;; get/set accessor methods
    (if (i32.and (i32.eq (call $cur) (i32.const 3)) (i32.or (call $tok_is_kw (cstring "get")) (call $tok_is_kw (cstring "set"))))
      (then
        (let $ig i32 (call $tok_is_kw (cstring "get")))
        (call $look_save)
        (call $advance)
        (if (i32.eq (call $cur) (i32.const 3))
          (then
            (let $an i32 (call $ident_name))
            (call $advance)
            (let $af i64 (call $parse_fn_body))
            (call $scope_set_accessor (if i32 (local.get $isStatic) (then (local.get $statics)) (else (local.get $proto))) (local.get $an) (local.get $ig) (local.get $af))
            (br $cont))
          (else (call $look_restore)))))
    ;; ordinary method (or constructor)
    (let $mn i32 (call $ident_name))
    (call $advance)
    (let $mf i64 (call $parse_fn_body))
    (if (i32.and (i32.eqz (local.get $isStatic)) (call $str_eq (local.get $mn) (cstring "constructor")))
      (then (set! $ctor (call $val_payload (local.get $mf))))
      (else (call $scope_define (if i32 (local.get $isStatic) (then (local.get $statics)) (else (local.get $proto))) (local.get $mn) (local.get $mf))))
    (br $cont)))
  (call $expect (i32.const 18) (cstring "expected }"))
  ;; synthesize empty constructor if none
  (if (i32.eqz (local.get $ctor))
    (then
      (set! $ctor (call $heap_alloc (i32.const 40)))
      (i32.store (local.get $ctor) (i32.const 9999))             ;; empty-ctor sentinel
      (i32.store (i32.add (local.get $ctor) (i32.const 8)) (i32.const 0))
      (i32.store (i32.add (local.get $ctor) (i32.const 12)) (i32.const 0))))
  ;; constructor.prototype = proto ; proto.constructor = constructor
  (call $scope_define (call $fn_props (local.get $ctor)) (cstring "prototype") (call $mk_obj (local.get $proto)))
  (call $scope_define (local.get $proto) (cstring "constructor") (call $mk_fn (local.get $ctor)))
  ;; record superclass for super() (in the ctor's props)
  (if (local.get $hasSuper) (then (call $scope_define (call $fn_props (local.get $ctor)) (cstring "__super__") (local.get $super))))
  ;; copy static members onto the constructor function
  (let $si i32 (i32.const 0))
  (let $scnt i32 (call $scope_count (local.get $statics)))
  (block $se (loop $sl
    (br_if $se (i32.ge_s (local.get $si) (local.get $scnt)))
    (let $e i32 (call $scope_entry (local.get $statics) (local.get $si)))
    (call $scope_define (call $fn_props (local.get $ctor)) (i32.load (local.get $e)) (i64.load (i32.add (local.get $e) (i32.const 8))))
    (set! $si (i32.add (local.get $si) (i32.const 1)))
    (br $sl)))
  (let $cv i64 (call $mk_fn (local.get $ctor)))
  (call $scope_define (call $fn_props (local.get $ctor)) (cstring "name")
    (call $mk_str (if i32 (i32.ne (local.get $name) (i32.const 0)) (then (local.get $name)) (else (cstring "")))))
  (if (i32.and (local.get $as_decl) (i32.and (i32.ne (local.get $name) (i32.const 0)) (i32.eqz (call $suppress))))
    (then (call $scope_define (call $cur_scope) (local.get $name) (local.get $cv))))
  (local.get $cv))

(func $retflag (result i32) (effects) (i32.load (i32.const 88)))
;; does the current token begin a statement (vs an expression)?
(func $is_stmt_start (result i32) (effects)
  (if (i32.eq (call $cur) (i32.const 17)) (then (return (i32.const 1))))  ;; {
  (if (i32.eq (call $cur) (i32.const 21)) (then (return (i32.const 1))))  ;; ;
  (if (i32.ne (call $cur) (i32.const 3)) (then (return (i32.const 0))))
  (i32.or (call $tok_is_kw (cstring "var")) (i32.or (call $tok_is_kw (cstring "let")) (i32.or (call $tok_is_kw (cstring "const"))
  (i32.or (call $tok_is_kw (cstring "if")) (i32.or (call $tok_is_kw (cstring "while")) (i32.or (call $tok_is_kw (cstring "do"))
  (i32.or (call $tok_is_kw (cstring "for")) (i32.or (call $tok_is_kw (cstring "function")) (i32.or (call $tok_is_kw (cstring "return"))
  (i32.or (call $tok_is_kw (cstring "throw")) (i32.or (call $tok_is_kw (cstring "try")) (i32.or (call $tok_is_kw (cstring "break"))
  (i32.or (call $tok_is_kw (cstring "continue")) (i32.or (call $tok_is_kw (cstring "switch")) (call $tok_is_kw (cstring "class")))))))))))))))))
;; `this` binding (reg 144, i64)
(func $get_this (result i64) (effects) (i64.load (i32.const 144)))
(func $set_this (param $v i64) (effects) (i64.store (i32.const 144) (local.get $v)))
;; loop control flags: 132 = break, 136 = continue
;; labelled statements: 188 = pending label for the next loop, 192 = break/continue target label (0 = unlabelled)
(func $brkflag (result i32) (effects) (i32.load (i32.const 132)))
(func $contflag (result i32) (effects) (i32.load (i32.const 136)))
(func $clear_loopflags (effects) (i32.store (i32.const 132) (i32.const 0)) (i32.store (i32.const 136) (i32.const 0)) (i32.store (i32.const 192) (i32.const 0)))
(func $label_pending (result i32) (effects) (i32.load (i32.const 188)))
(func $set_label_pending (param $l i32) (effects) (i32.store (i32.const 188) (local.get $l)))
(func $brk_target (result i32) (effects) (i32.load (i32.const 192)))
;; does the current break/continue (target 192) apply to a loop labelled $mylabel?
(func $label_matches (param $mylabel i32) (result i32) (effects)
  (let $t i32 (call $brk_target))
  (if i32 (i32.eqz (local.get $t)) (then (i32.const 1))   ;; unlabelled → innermost loop
    (else (if i32 (local.get $mylabel) (then (call $str_eq (local.get $t) (local.get $mylabel))) (else (i32.const 0))))))
;; any non-local exit in progress (error / return / break / continue)
(func $unwind (result i32) (effects)
  (i32.or (call $err) (i32.or (call $retflag) (i32.or (call $brkflag) (call $contflag)))))

;; typeof a value -> type string
(func $typeof_val (param $v i64) (result i64) (effects)
  (if (call $is_number (local.get $v)) (then (return (call $mk_str (cstring "number")))))
  (if (call $is_string (local.get $v)) (then (return (call $mk_str (cstring "string")))))
  (if (call $is_boolean (local.get $v)) (then (return (call $mk_str (cstring "boolean")))))
  (if (call $is_undefined (local.get $v)) (then (return (call $mk_str (cstring "undefined")))))
  (if (call $is_function (local.get $v)) (then (return (call $mk_str (cstring "function")))))
  (call $mk_str (cstring "object")))  ;; null, object, array

;; ── primary ──
(func $parse_primary (result i64) (effects)
  (if (call $err) (then (return (call $v_undef))))
  (let $k i32 (call $cur))
  ;; number
  (if (i32.eq (local.get $k) (i32.const 1))
    (then (let $d f64 (call $tok_num)) (call $advance) (return (call $num (local.get $d)))))
  ;; string
  (if (i32.eq (local.get $k) (i32.const 2))
    (then
      (let $s i32 (call $decode_str (i32.add (call $src) (call $tok_start)) (call $tok_len)))
      (call $advance) (return (call $mk_str (local.get $s)))))
  ;; template literal
  (if (i32.eq (local.get $k) (i32.const 53)) (then (return (call $parse_template))))
  ;; regex literal → RegExp(pattern, flags)
  (if (i32.eq (local.get $k) (i32.const 57))
    (then
      (let $rpat i32 (call $str_from_src (i32.add (call $src) (call $tok_start)) (call $tok_len)))
      (let $rflg i32 (call $str_from_src (i32.add (call $src) (i32.load (i32.const 264))) (i32.load (i32.const 268))))
      (call $advance)
      (let $rargv i32 (call $heap_alloc (i32.const 16)))
      (i64.store (local.get $rargv) (call $mk_str (local.get $rpat)))
      (i64.store (i32.add (local.get $rargv) (i32.const 8)) (call $mk_str (local.get $rflg)))
      (return (call $call_native (i32.const 100) (i32.const 2) (local.get $rargv) (call $v_undef)))))
  ;; ( expr )
  (if (i32.eq (local.get $k) (i32.const 15))
    (then (call $advance)
          (let $v i64 (call $parse_comma))
          (call $expect (i32.const 16) (cstring "expected )"))
          (return (local.get $v))))
  ;; array literal [ ... ]
  (if (i32.eq (local.get $k) (i32.const 19))
    (then
      (call $advance)
      (let $a i32 (call $arr_new (i32.const 64)))
      (block $brk (loop $cont
        (br_if $brk (i32.eq (call $cur) (i32.const 20)))  ;; ']'
        (br_if $brk (i32.eq (call $cur) (i32.const 0)))
        (br_if $brk (call $err))
        (if (i32.eq (call $cur) (i32.const 22))  ;; elision: empty slot → undefined hole
          (then (call $arr_push (local.get $a) (call $v_undef)) (call $advance) (br $cont)))
        (if (i32.eq (call $cur) (i32.const 54))  ;; ...spread
          (then
            (call $advance)
            (let $sv i64 (call $parse_assign))
            (if (call $is_array (local.get $sv))
              (then
                (let $sa i32 (call $val_payload (local.get $sv)))
                (let $si i32 (i32.const 0))
                (block $se2 (loop $sl2
                  (br_if $se2 (i32.ge_s (local.get $si) (call $arr_len (local.get $sa))))
                  (call $arr_push (local.get $a) (call $arr_get (local.get $sa) (local.get $si)))
                  (set! $si (i32.add (local.get $si) (i32.const 1)))
                  (br $sl2))))))
          (else (call $arr_push (local.get $a) (call $parse_assign))))
        (br_if $brk (i32.eqz (call $eat (i32.const 22))))
        (br $cont)))
      (call $expect (i32.const 20) (cstring "expected ]"))
      (return (call $mk_arr (local.get $a)))))
  ;; object literal { ... }  (only reachable in expression position)
  (if (i32.eq (local.get $k) (i32.const 17))
    (then
      (call $advance)
      (let $o i32 (call $obj_new (i32.const 32)))
      (block $brk (loop $cont
        (br_if $brk (i32.eq (call $cur) (i32.const 18)))  ;; '}'
        (br_if $brk (i32.eq (call $cur) (i32.const 0)))
        (br_if $brk (call $err))
        ;; spread: { ...src } copies src's own enumerable properties
        (if (i32.eq (call $cur) (i32.const 54))
          (then
            (call $advance)
            (let $spv i64 (call $parse_assign))
            (if (call $is_object (local.get $spv))
              (then
                (let $sps i32 (call $val_payload (local.get $spv)))
                (let $spcnt i32 (call $scope_count (local.get $sps)))
                (let $spi i32 (i32.const 0))
                (block $spe (loop $spl
                  (br_if $spe (i32.ge_s (local.get $spi) (local.get $spcnt)))
                  (let $spnm i32 (i32.load (call $scope_entry (local.get $sps) (local.get $spi))))
                  (call $scope_define (local.get $o) (local.get $spnm)
                    (call $get_prop (local.get $spv) (call $mk_str (local.get $spnm))))
                  (set! $spi (i32.add (local.get $spi) (i32.const 1)))
                  (br $spl)))))
            (if (call $is_array (local.get $spv))
              (then
                (let $spa i32 (call $val_payload (local.get $spv)))
                (let $spj i32 (i32.const 0))
                (block $sae (loop $sal
                  (br_if $sae (i32.ge_s (local.get $spj) (call $arr_len (local.get $spa))))
                  (call $scope_define (local.get $o) (call $to_str (call $num (f64.convert_i32_s (local.get $spj))))
                    (call $arr_get (local.get $spa) (local.get $spj)))
                  (set! $spj (i32.add (local.get $spj) (i32.const 1)))
                  (br $sal)))))
            (br_if $brk (i32.eqz (call $eat (i32.const 22))))
            (br $cont)))
        ;; getter/setter: get/set <name>() {...}
        (if (i32.and (i32.eq (call $cur) (i32.const 3)) (i32.or (call $tok_is_kw (cstring "get")) (call $tok_is_kw (cstring "set"))))
          (then
            (let $isget i32 (call $tok_is_kw (cstring "get")))
            (call $look_save)
            (call $advance)
            ;; only an accessor if followed by a property name (not ':' or ',' or '}')
            (if (i32.or (i32.eq (call $cur) (i32.const 3)) (i32.eq (call $cur) (i32.const 2)))
              (then
                (let $akey i32 (if i32 (i32.eq (call $cur) (i32.const 2)) (then (call $decode_str (i32.add (call $src) (call $tok_start)) (call $tok_len))) (else (call $ident_name))))
                (call $advance)
                (let $afn i64 (call $parse_fn_body))
                (call $scope_set_accessor (local.get $o) (local.get $akey) (local.get $isget) (local.get $afn))
                (br_if $brk (i32.eqz (call $eat (i32.const 22))))
                (br $cont))
              (else (call $look_restore)))))
        ;; computed key: [expr]
        (if (i32.eq (call $cur) (i32.const 19))
          (then
            (call $advance)
            (let $ck i32 (call $to_str (call $parse_assign)))
            (call $expect (i32.const 20) (cstring "expected ]"))
            (call $expect (i32.const 37) (cstring "expected :"))
            (call $scope_define (local.get $o) (local.get $ck) (call $parse_assign))
            (br_if $brk (i32.eqz (call $eat (i32.const 22))))
            (br $cont)))
        ;; key: identifier or string literal
        (let $key i32 (i32.const 0))
        (if (i32.eq (call $cur) (i32.const 3))
          (then (set! $key (call $ident_name)) (call $advance))
          (else (if (i32.eq (call $cur) (i32.const 2))
            (then (set! $key (call $decode_str (i32.add (call $src) (call $tok_start)) (call $tok_len))) (call $advance))
            (else (if (i32.eq (call $cur) (i32.const 1))  ;; numeric key
              (then (set! $key (call $to_str (call $num (call $tok_num)))) (call $advance))
              (else (call $throw (cstring "bad object key")) (br $brk)))))))
        ;; shorthand { x } === { x: x }
        (if (i32.ne (call $cur) (i32.const 37))
          (then
            (call $scope_define (local.get $o) (local.get $key) (call $var_get (local.get $key)))
            (br_if $brk (i32.eqz (call $eat (i32.const 22))))
            (br $cont)))
        (call $expect (i32.const 37) (cstring "expected :"))
        (call $scope_define (local.get $o) (local.get $key) (call $parse_assign))
        (br_if $brk (i32.eqz (call $eat (i32.const 22))))
        (br $cont)))
      (call $expect (i32.const 18) (cstring "expected }"))
      (return (call $mk_obj (local.get $o)))))
  ;; identifier / keyword
  (if (i32.eq (local.get $k) (i32.const 3))
    (then
      (if (call $tok_is_kw (cstring "true")) (then (call $advance) (return (call $v_true))))
      (if (call $tok_is_kw (cstring "false")) (then (call $advance) (return (call $v_false))))
      (if (call $tok_is_kw (cstring "null")) (then (call $advance) (return (call $v_null))))
      (if (call $tok_is_kw (cstring "undefined")) (then (call $advance) (return (call $v_undef))))
      (if (call $tok_is_kw (cstring "NaN")) (then (call $advance) (return (call $num (f64.div (f64.const 0) (f64.const 0))))))
      (if (call $tok_is_kw (cstring "Infinity")) (then (call $advance) (return (call $num (f64.div (f64.const 1) (f64.const 0))))))
      (if (call $tok_is_kw (cstring "function")) (then (return (call $parse_function (i32.const 0)))))
      (if (call $tok_is_kw (cstring "this")) (then (call $advance) (return (call $get_this))))
      (if (call $tok_is_kw (cstring "new")) (then (return (call $parse_new))))
      (if (call $tok_is_kw (cstring "class")) (then (return (call $parse_class (i32.const 0)))))
      (if (call $tok_is_kw (cstring "super")) (then (return (call $parse_super))))
      ;; variable reference
      (let $nm i32 (call $ident_name))
      (let $slot i32 (call $scope_find (call $cur_scope) (local.get $nm)))
      (call $advance)
      (if (local.get $slot)
        (then (return (i64.load (local.get $slot))))
        (else
          ;; inside a typeof operand, an unresolvable reference is `undefined`, not an error
          (if (i32.load (i32.const 184)) (then (return (call $v_undef))))
          (call $throw_type (cstring "ReferenceError") (call $str_concat (local.get $nm) (cstring " is not defined")))
          (return (call $v_undef))))))
  ;; Unexpected token: throw AND consume it, so the parser always makes
  ;; progress (critical under suppress, where throw is a no-op — otherwise
  ;; the enclosing statement loop would spin forever).
  (call $throw (cstring "unexpected token"))
  (if (i32.ne (call $cur) (i32.const 0)) (then (call $advance)))
  (call $v_undef))

(func $ident_name (result i32) (effects)
  (call $str_from_src (i32.add (call $src) (call $tok_start)) (call $tok_len)))

;; template literal: concatenate literal chunks and ToString(${expr}) parts
(func $parse_template (result i64) (effects)
  (let $base i32 (i32.add (call $src) (call $tok_start)))
  (let $len i32 (call $tok_len))
  (call $advance)  ;; consume the template token (before eval_string saves the cursor)
  (let $out i32 (cstring ""))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $len)))
    (let $c i32 (i32.load8_u (i32.add (local.get $base) (local.get $i))))
    (if (i32.and (i32.eq (local.get $c) (i32.const 36)) (i32.eq (i32.load8_u (i32.add (local.get $base) (i32.add (local.get $i) (i32.const 1)))) (i32.const 123)))
      (then  ;; ${ expr }
        (set! $i (i32.add (local.get $i) (i32.const 2)))
        (let $es i32 (local.get $i))
        (let $depth i32 (i32.const 1))
        (block $ee (loop $el
          (br_if $ee (i32.ge_s (local.get $i) (local.get $len)))
          (let $d i32 (i32.load8_u (i32.add (local.get $base) (local.get $i))))
          (if (i32.eq (local.get $d) (i32.const 123)) (then (set! $depth (i32.add (local.get $depth) (i32.const 1)))))
          (if (i32.eq (local.get $d) (i32.const 125)) (then (set! $depth (i32.sub (local.get $depth) (i32.const 1))) (br_if $ee (i32.eqz (local.get $depth)))))
          (set! $i (i32.add (local.get $i) (i32.const 1)))
          (br $el)))
        (let $expr i32 (call $str_from_src (i32.add (local.get $base) (local.get $es)) (i32.sub (local.get $i) (local.get $es))))
        (set! $out (call $str_concat (local.get $out) (call $to_str (call $eval_string (local.get $expr)))))
        (set! $i (i32.add (local.get $i) (i32.const 1))))  ;; past }
      (else
        (let $ch i32 (local.get $c))
        (if (i32.eq (local.get $c) (i32.const 92))  ;; escape
          (then (set! $i (i32.add (local.get $i) (i32.const 1))) (set! $ch (call $esc_byte (i32.load8_u (i32.add (local.get $base) (local.get $i)))))))
        (let $cs i32 (call $str_alloc (i32.const 1)))
        (call $str_set_byte (local.get $cs) (i32.const 0) (local.get $ch))
        (set! $out (call $str_concat (local.get $out) (local.get $cs)))
        (set! $i (i32.add (local.get $i) (i32.const 1)))))
    (br $l)))
  (call $mk_str (local.get $out)))

;; is the current IDENT token a literal/value keyword (not a variable)?
(func $is_value_kw (result i32) (effects)
  (i32.or (call $tok_is_kw (cstring "true"))
  (i32.or (call $tok_is_kw (cstring "false"))
  (i32.or (call $tok_is_kw (cstring "null"))
  (i32.or (call $tok_is_kw (cstring "undefined"))
  (i32.or (call $tok_is_kw (cstring "NaN"))
  (i32.or (call $tok_is_kw (cstring "Infinity"))
  (i32.or (call $tok_is_kw (cstring "function"))
          (call $tok_is_kw (cstring "this"))))))))))

;; ── new Constructor(args) ──
(func $parse_new (result i64) (effects)
  (call $advance)  ;; 'new'
  (let $callee i64 (call $parse_primary))
  ;; member chain (no call)
  (block $me (loop $mc
    (let $k i32 (call $cur))
    (if (i32.eq (local.get $k) (i32.const 23))  ;; '.'
      (then (call $advance) (let $key i64 (call $mk_str (call $ident_name))) (call $advance)
            (set! $callee (call $get_prop (local.get $callee) (local.get $key))) (br $mc)))
    (if (i32.eq (local.get $k) (i32.const 19))  ;; '['
      (then (call $advance) (let $key i64 (call $parse_assign)) (call $expect (i32.const 20) (cstring "expected ]"))
            (set! $callee (call $get_prop (local.get $callee) (local.get $key))) (br $mc)))
    (br $me)))
  ;; args
  (let $argv i32 (call $heap_alloc (i32.const 128)))
  (let $argc i32 (i32.const 0))
  (if (i32.eq (call $cur) (i32.const 15))
    (then
      (call $advance)
      (block $ae (loop $ac
        (br_if $ae (i32.eq (call $cur) (i32.const 16)))
        (br_if $ae (i32.eq (call $cur) (i32.const 0)))
        (br_if $ae (call $err))
        (i64.store (i32.add (local.get $argv) (i32.mul (local.get $argc) (i32.const 8))) (call $parse_assign))
        (set! $argc (i32.add (local.get $argc) (i32.const 1)))
        (br_if $ae (i32.eqz (call $eat (i32.const 22))))
        (br $ac)))
      (call $expect (i32.const 16) (cstring "expected )"))))
  (if (i32.or (call $suppress) (call $err)) (then (return (call $v_undef))))
  (if (i32.eqz (call $is_function (local.get $callee)))
    (then (call $throw_type (cstring "TypeError") (cstring "not a constructor")) (return (call $v_undef))))
  (let $fn i32 (call $val_payload (local.get $callee)))
  (if (i32.load (local.get $fn))  ;; native constructor
    (then
      (let $nid i32 (i32.load (local.get $fn)))
      ;; 9999 = synthesized empty class constructor → just create the instance
      (if (i32.eq (local.get $nid) (i32.const 9999))
        (then
          (let $eo i32 (call $obj_new (i32.const 8)))
          (i32.store (local.get $eo) (call $val_payload (call $fn_get_prototype (local.get $fn))))
          (return (call $mk_obj (local.get $eo)))))
      ;; new Number/String/Boolean → a (truthy) wrapper object holding the primitive
      (if (i32.or (i32.eq (local.get $nid) (i32.const 4)) (i32.or (i32.eq (local.get $nid) (i32.const 5)) (i32.eq (local.get $nid) (i32.const 6))))
        (then
          (let $wo i32 (call $obj_new (i32.const 8)))
          (call $scope_define (local.get $wo) (cstring "__prim__") (call $call_native (local.get $nid) (local.get $argc) (local.get $argv) (call $v_undef)))
          (return (call $mk_obj (local.get $wo)))))
      (return (call $call_native (local.get $nid) (local.get $argc) (local.get $argv) (call $v_undef)))))
  (let $proto i64 (call $fn_get_prototype (local.get $fn)))
  (let $o i32 (call $obj_new (i32.const 16)))
  (i32.store (local.get $o) (call $val_payload (local.get $proto)))  ;; proto chain link
  (let $res i64 (call $call_user (local.get $fn) (local.get $argc) (local.get $argv) (call $mk_obj (local.get $o))))
  ;; constructor returning an object replaces the new instance
  (if (i32.and (i32.eqz (call $is_number (local.get $res)))
            (i32.or (call $is_object (local.get $res)) (i32.or (call $is_array (local.get $res)) (call $is_function (local.get $res)))))
    (then (return (local.get $res))))
  (call $mk_obj (local.get $o)))

;; ── postfix: trailing call / .member / [index] ──
;; The last member/index access records an assignment reference in registers
;; 104 (valid), 112 (container i64), 120 (key i64); calls clear it.
(func $parse_postfix (result i64) (effects)
  (let $v i64 (call $parse_primary))
  (let $oc i32 (i32.const 0))  ;; set once an optional-chain (?.) short-circuits → rest suppressed
  (block $e (loop $c
    (br_if $e (call $err))
    (let $k i32 (call $cur))
    (if (i32.eq (local.get $k) (i32.const 55))  ;; '?.' optional chaining
      (then
        (call $advance)
        ;; short-circuit the rest of the chain (yielding undefined) if base is nullish
        (if (i32.and (i32.or (call $is_null (local.get $v)) (call $is_undefined (local.get $v))) (i32.eqz (local.get $oc)))
          (then (call $sup_inc) (set! $oc (i32.const 1))))
        (if (i32.eq (call $cur) (i32.const 15))  ;; ?.(args)
          (then
            (let $thisv i64 (if i64 (i32.load (i32.const 104)) (then (i64.load (i32.const 112))) (else (call $v_undef))))
            (i32.store (i32.const 104) (i32.const 0))
            (set! $v (call $parse_call (local.get $v) (local.get $thisv)))
            (br $c)))
        (if (i32.eq (call $cur) (i32.const 19))  ;; ?.[expr]
          (then
            (call $advance)
            (let $key i64 (call $parse_assign))
            (call $expect (i32.const 20) (cstring "expected ]"))
            (let $cont i64 (local.get $v))
            (set! $v (call $get_prop (local.get $v) (local.get $key)))
            (i32.store (i32.const 104) (i32.const 1)) (i64.store (i32.const 112) (local.get $cont)) (i64.store (i32.const 120) (local.get $key))
            (br $c)))
        ;; ?.name
        (let $key i64 (call $mk_str (call $ident_name)))
        (call $advance)
        (let $cont i64 (local.get $v))
        (set! $v (call $get_prop (local.get $v) (local.get $key)))
        (i32.store (i32.const 104) (i32.const 1)) (i64.store (i32.const 112) (local.get $cont)) (i64.store (i32.const 120) (local.get $key))
        (br $c)))
    (if (i32.eq (local.get $k) (i32.const 15))  ;; '(' call
      (then
        (let $thisv i64 (if i64 (i32.load (i32.const 104)) (then (i64.load (i32.const 112))) (else (call $v_undef))))
        (i32.store (i32.const 104) (i32.const 0))
        (set! $v (call $parse_call (local.get $v) (local.get $thisv)))
        (br $c)))
    (if (i32.eq (local.get $k) (i32.const 23))  ;; '.' member
      (then
        (call $advance)
        (let $key i64 (call $mk_str (call $ident_name)))
        (call $advance)
        ;; get_prop may invoke a getter, whose body parse clears REF — so capture
        ;; the container/key into the REF regs AFTER the read, not before.
        (let $cont i64 (local.get $v))
        (set! $v (call $get_prop (local.get $v) (local.get $key)))
        (i32.store (i32.const 104) (i32.const 1)) (i64.store (i32.const 112) (local.get $cont)) (i64.store (i32.const 120) (local.get $key))
        (br $c)))
    (if (i32.eq (local.get $k) (i32.const 19))  ;; '[' index
      (then
        (call $advance)
        (let $key i64 (call $parse_assign))
        (call $expect (i32.const 20) (cstring "expected ]"))
        (let $cont i64 (local.get $v))
        (set! $v (call $get_prop (local.get $v) (local.get $key)))
        (i32.store (i32.const 104) (i32.const 1)) (i64.store (i32.const 112) (local.get $cont)) (i64.store (i32.const 120) (local.get $key))
        (br $c)))
    (br $e)))
  (if (local.get $oc) (then (call $sup_dec) (return (call $v_undef))))  ;; chain short-circuited → undefined
  (local.get $v))

;; ── unary: - + ! typeof void ──
(func $parse_unary (result i64) (effects)
  (let $k i32 (call $cur))
  ;; typeof — bare (non-keyword) identifier must not throw when unbound
  (if (i32.and (i32.eq (local.get $k) (i32.const 3)) (call $tok_is_kw (cstring "typeof")))
    (then
      (call $advance)
      (if (i32.and (i32.eq (call $cur) (i32.const 3)) (i32.eqz (call $is_value_kw)))  ;; typeof <ident>
        (then
          (call $look_save)
          (let $nm i32 (call $ident_name))
          (call $advance)
          ;; simple variable (not followed by . [ () → safe lookup
          (if (i32.eqz (i32.or (i32.eq (call $cur) (i32.const 23)) (i32.or (i32.eq (call $cur) (i32.const 19)) (i32.eq (call $cur) (i32.const 15)))))
            (then (return (call $typeof_val (call $var_get (local.get $nm))))))
          (call $look_restore)))
      ;; general operand: tolerate an unbound bare/parenthesized identifier
      ;; (typeof never throws ReferenceError for an unresolvable reference)
      (i32.store (i32.const 184) (i32.add (i32.load (i32.const 184)) (i32.const 1)))
      (let $tv i64 (call $parse_unary))
      (i32.store (i32.const 184) (i32.sub (i32.load (i32.const 184)) (i32.const 1)))
      (return (call $typeof_val (local.get $tv)))))
  (if (i32.and (i32.eq (local.get $k) (i32.const 3)) (call $tok_is_kw (cstring "void")))
    (then (call $advance) (drop (call $parse_unary)) (return (call $v_undef))))
  (if (i32.and (i32.eq (local.get $k) (i32.const 3)) (call $tok_is_kw (cstring "delete")))
    (then
      (call $advance)
      (i32.store (i32.const 104) (i32.const 0))  ;; clear REF
      (drop (call $parse_postfix))               ;; evaluate operand, records member/index ref
      (if (i32.load (i32.const 104))
        (then (if (i32.eqz (call $suppress)) (then (call $delete_prop (i64.load (i32.const 112)) (i64.load (i32.const 120)))))))
      (return (call $v_true))))
  (if (i32.eq (local.get $k) (i32.const 11))  ;; -
    (then (call $advance) (return (call $num (f64.neg (call $to_num (call $parse_unary)))))))
  (if (i32.eq (local.get $k) (i32.const 10))  ;; +
    (then (call $advance) (return (call $num (call $to_num (call $parse_unary))))))
  (if (i32.eq (local.get $k) (i32.const 33))  ;; !
    (then (call $advance) (return (call $mk_bool (i32.eqz (call $truthy (call $parse_unary)))))))
  (if (i32.eq (local.get $k) (i32.const 47))  ;; ~ bitwise not
    (then (call $advance) (return (call $num (f64.convert_i32_s (i32.xor (call $to_int32 (call $parse_unary)) (i32.const -1)))))))
  (if (i32.or (i32.eq (local.get $k) (i32.const 38)) (i32.eq (local.get $k) (i32.const 39)))  ;; prefix ++/--
    (then
      (call $advance)
      ;; simple variable: <ident> not followed by . [ ( (member/call → general path)
      (if (i32.eq (call $cur) (i32.const 3))
        (then
          (call $look_save)
          (let $nm i32 (call $ident_name))
          (call $advance)
          (if (i32.eqz (i32.or (i32.eq (call $cur) (i32.const 23)) (i32.or (i32.eq (call $cur) (i32.const 19)) (i32.eq (call $cur) (i32.const 15)))))
            (then
              (let $newn f64 (if f64 (i32.eq (local.get $k) (i32.const 38))
                                (then (f64.add (call $to_num (call $var_get_checked (local.get $nm))) (f64.const 1)))
                                (else (f64.sub (call $to_num (call $var_get_checked (local.get $nm))) (f64.const 1)))))
              (if (i32.eqz (call $suppress)) (then (call $var_set (local.get $nm) (call $num (local.get $newn)))))
              (return (call $num (local.get $newn)))))   ;; prefix yields the NEW value
          (call $look_restore)))
      ;; member/index target: parse via postfix, write back through the REF regs
      (i32.store (i32.const 104) (i32.const 0))
      (let $v i64 (call $parse_postfix))
      (if (i32.load (i32.const 104))
        (then
          (let $cont i64 (i64.load (i32.const 112)))
          (let $key i64 (i64.load (i32.const 120)))
          (let $newn2 f64 (if f64 (i32.eq (local.get $k) (i32.const 38))
                            (then (f64.add (call $to_num (local.get $v)) (f64.const 1)))
                            (else (f64.sub (call $to_num (local.get $v)) (f64.const 1)))))
          (if (i32.eqz (call $suppress)) (then (call $set_prop (local.get $cont) (local.get $key) (call $num (local.get $newn2)))))
          (return (call $num (local.get $newn2)))))
      (call $throw (cstring "invalid ++/-- target")) (return (call $v_undef))))
  (call $parse_postfix))

;; exponentiation ** (right-associative, binds tighter than * / %)
(func $parse_pow (result i64) (effects)
  (let $left i64 (call $parse_unary))
  (if i64 (i32.eq (call $cur) (i32.const 51))  ;; **
    (then
      (call $advance)
      (call $num (call $f64_pow (call $to_num (local.get $left)) (call $to_num (call $parse_pow)))))
    (else (local.get $left))))

;; ── multiplicative: * / % ──
(func $parse_mul (result i64) (effects)
  (let $left i64 (call $parse_pow))
  (block $brk (loop $cont
    (let $k i32 (call $cur))
    (br_if $brk (i32.eqz (i32.or (i32.eq (local.get $k) (i32.const 12))
                          (i32.or (i32.eq (local.get $k) (i32.const 13)) (i32.eq (local.get $k) (i32.const 14))))))
    (call $advance)
    (let $r i64 (call $parse_pow))
    (let $x f64 (call $to_num (local.get $left)))
    (let $y f64 (call $to_num (local.get $r)))
    (set! $left (call $num
      (if f64 (i32.eq (local.get $k) (i32.const 12)) (then (f64.mul (local.get $x) (local.get $y)))
      (else (if f64 (i32.eq (local.get $k) (i32.const 13)) (then (f64.div (local.get $x) (local.get $y)))
      (else (call $fmod (local.get $x) (local.get $y))))))))
    (br $cont)))
  (local.get $left))

(func $fmod (param $x f64) (param $y f64) (result f64) (effects)
  ;; x - trunc(x/y)*y
  (f64.sub (local.get $x) (f64.mul (f64.trunc (f64.div (local.get $x) (local.get $y))) (local.get $y))))

;; ── additive: + - ──
(func $parse_add (result i64) (effects)
  (let $left i64 (call $parse_mul))
  (block $brk (loop $cont
    (let $k i32 (call $cur))
    (br_if $brk (i32.eqz (i32.or (i32.eq (local.get $k) (i32.const 10)) (i32.eq (local.get $k) (i32.const 11)))))
    (call $advance)
    (let $r i64 (call $parse_mul))
    (if (i32.eq (local.get $k) (i32.const 10))
      (then (set! $left (call $js_add (local.get $left) (local.get $r))))
      (else (set! $left (call $num (f64.sub (call $to_num (local.get $left)) (call $to_num (local.get $r)))))))
    (br $cont)))
  (local.get $left))

;; ── relational: < > <= >= ──
(func $parse_rel (result i64) (effects)
  (let $left i64 (call $parse_shift))
  (block $brk (loop $cont
    (let $k i32 (call $cur))
    ;; instanceof (keyword operator)
    (if (i32.and (i32.eq (local.get $k) (i32.const 3)) (call $tok_is_kw (cstring "instanceof")))
      (then (call $advance) (set! $left (call $js_instanceof (local.get $left) (call $parse_shift))) (br $cont)))
    (if (i32.and (i32.eq (local.get $k) (i32.const 3)) (call $tok_is_kw (cstring "in")))
      (then (call $advance) (set! $left (call $js_in (local.get $left) (call $parse_shift))) (br $cont)))
    (br_if $brk (i32.eqz (i32.or (i32.eq (local.get $k) (i32.const 29)) (i32.or (i32.eq (local.get $k) (i32.const 30))
                          (i32.or (i32.eq (local.get $k) (i32.const 31)) (i32.eq (local.get $k) (i32.const 32)))))))
    (call $advance)
    (let $r i64 (call $parse_shift))
    (set! $left (call $relate (local.get $left) (local.get $r) (local.get $k)))
    (br $cont)))
  (local.get $left))

;; ── equality: == != === !== ──
(func $parse_eq (result i64) (effects)
  (let $left i64 (call $parse_rel))
  (block $brk (loop $cont
    (let $k i32 (call $cur))
    (br_if $brk (i32.eqz (i32.or (i32.eq (local.get $k) (i32.const 25)) (i32.or (i32.eq (local.get $k) (i32.const 27))
                          (i32.or (i32.eq (local.get $k) (i32.const 26)) (i32.eq (local.get $k) (i32.const 28)))))))
    (call $advance)
    (let $r i64 (call $parse_rel))
    (set! $left (call $mk_bool
      (if i32 (i32.eq (local.get $k) (i32.const 25)) (then (call $loose_eq (local.get $left) (local.get $r)))
      (else (if i32 (i32.eq (local.get $k) (i32.const 27)) (then (i32.eqz (call $loose_eq (local.get $left) (local.get $r))))
      (else (if i32 (i32.eq (local.get $k) (i32.const 26)) (then (call $strict_eq (local.get $left) (local.get $r)))
      (else (i32.eqz (call $strict_eq (local.get $left) (local.get $r)))))))))))
    (br $cont)))
  (local.get $left))

;; ── bitwise OR / XOR / AND, shifts (between && and equality / between rel and add) ──
(func $parse_bitor (result i64) (effects)
  (let $left i64 (call $parse_bitxor))
  (block $brk (loop $cont
    (br_if $brk (i32.ne (call $cur) (i32.const 45)))  ;; |
    (call $advance)
    (set! $left (call $num (f64.convert_i32_s (i32.or (call $to_int32 (local.get $left)) (call $to_int32 (call $parse_bitxor))))))
    (br $cont)))
  (local.get $left))
(func $parse_bitxor (result i64) (effects)
  (let $left i64 (call $parse_bitand))
  (block $brk (loop $cont
    (br_if $brk (i32.ne (call $cur) (i32.const 46)))  ;; ^
    (call $advance)
    (set! $left (call $num (f64.convert_i32_s (i32.xor (call $to_int32 (local.get $left)) (call $to_int32 (call $parse_bitand))))))
    (br $cont)))
  (local.get $left))
(func $parse_bitand (result i64) (effects)
  (let $left i64 (call $parse_eq))
  (block $brk (loop $cont
    (br_if $brk (i32.ne (call $cur) (i32.const 44)))  ;; &
    (call $advance)
    (set! $left (call $num (f64.convert_i32_s (i32.and (call $to_int32 (local.get $left)) (call $to_int32 (call $parse_eq))))))
    (br $cont)))
  (local.get $left))
(func $parse_shift (result i64) (effects)
  (let $left i64 (call $parse_add))
  (block $brk (loop $cont
    (let $k i32 (call $cur))
    (br_if $brk (i32.eqz (i32.or (i32.eq (local.get $k) (i32.const 48)) (i32.or (i32.eq (local.get $k) (i32.const 49)) (i32.eq (local.get $k) (i32.const 50))))))
    (call $advance)
    (let $l i32 (call $to_int32 (local.get $left)))
    (let $r i32 (i32.and (call $to_int32 (call $parse_add)) (i32.const 31)))
    (set! $left (call $num
      (if f64 (i32.eq (local.get $k) (i32.const 48)) (then (f64.convert_i32_s (i32.shl (local.get $l) (local.get $r))))
      (else (if f64 (i32.eq (local.get $k) (i32.const 49)) (then (f64.convert_i32_s (i32.shr_s (local.get $l) (local.get $r))))
      (else (f64.convert_i32_u (i32.shr_u (local.get $l) (local.get $r)))))))))
    (br $cont)))
  (local.get $left))

;; ── logical AND (&&) with short-circuit ──
(func $parse_and (result i64) (effects)
  (let $left i64 (call $parse_bitor))
  (block $brk (loop $cont
    (br_if $brk (i32.ne (call $cur) (i32.const 34)))
    (call $advance)
    (if (call $truthy (local.get $left))
      (then (set! $left (call $parse_eq)))
      (else  ;; left falsy: keep it, suppress evaluation of right
        (call $set_suppress (i32.add (call $suppress) (i32.const 1)))
        (drop (call $parse_eq))
        (call $set_suppress (i32.sub (call $suppress) (i32.const 1)))))
    (br $cont)))
  (local.get $left))

;; ── logical OR (||) with short-circuit ──
(func $parse_or (result i64) (effects)
  (let $left i64 (call $parse_and))
  (block $brk (loop $cont
    (br_if $brk (i32.ne (call $cur) (i32.const 35)))
    (call $advance)
    (if (call $truthy (local.get $left))
      (then  ;; left truthy: keep it, suppress right
        (call $set_suppress (i32.add (call $suppress) (i32.const 1)))
        (drop (call $parse_and))
        (call $set_suppress (i32.sub (call $suppress) (i32.const 1))))
      (else (set! $left (call $parse_and))))
    (br $cont)))
  (local.get $left))

;; ── ternary ?: ──
(func $parse_ternary (result i64) (effects)
  (let $cond i64 (call $parse_or))
  ;; nullish coalescing  a ?? b  (left-assoc, binds tighter than ?:)
  (block $nc (loop $ncl
    (br_if $nc (i32.ne (call $cur) (i32.const 56)))  ;; ??
    (call $advance)
    (if (i32.or (call $is_null (local.get $cond)) (call $is_undefined (local.get $cond)))
      (then (set! $cond (call $parse_or)))                  ;; left is nullish → take right
      (else                                                  ;; left present → keep it, skip right
        (call $set_suppress (i32.add (call $suppress) (i32.const 1)))
        (drop (call $parse_or))
        (call $set_suppress (i32.sub (call $suppress) (i32.const 1)))))
    (br $ncl)))
  (if i64 (i32.eq (call $cur) (i32.const 36))  ;; ?
    (then
      (call $advance)
      (if i64 (call $truthy (local.get $cond))
        (then
          (let $a i64 (call $parse_assign))
          (call $expect (i32.const 37) (cstring "expected :"))
          (call $set_suppress (i32.add (call $suppress) (i32.const 1)))
          (drop (call $parse_assign))
          (call $set_suppress (i32.sub (call $suppress) (i32.const 1)))
          (local.get $a))
        (else
          (call $set_suppress (i32.add (call $suppress) (i32.const 1)))
          (drop (call $parse_assign))
          (call $set_suppress (i32.sub (call $suppress) (i32.const 1)))
          (call $expect (i32.const 37) (cstring "expected :"))
          (call $parse_assign))))
    (else (local.get $cond))))

;; ── assignment (right-assoc): IDENT '=' expr ──
(func $var_get (param $nm i32) (result i64) (effects)
  (let $slot i32 (call $scope_find (call $cur_scope) (local.get $nm)))
  (if i64 (local.get $slot) (then (i64.load (local.get $slot))) (else (call $v_undef))))
(func $var_set (param $nm i32) (param $v i64) (effects)
  (let $slot i32 (call $scope_find (call $cur_scope) (local.get $nm)))
  (if (local.get $slot) (then (i64.store (local.get $slot) (local.get $v)))
    (else (call $scope_define (call $cur_scope) (local.get $nm) (local.get $v)))))
;; like var_get but throws ReferenceError if unbound (for ++/--/op=)
(func $var_get_checked (param $nm i32) (result i64) (effects)
  (let $slot i32 (call $scope_find (call $cur_scope) (local.get $nm)))
  (if (i32.eqz (local.get $slot))
    (then (call $throw_type (cstring "ReferenceError") (call $str_concat (local.get $nm) (cstring " is not defined"))) (return (call $v_undef))))
  (i64.load (local.get $slot)))

;; apply a compound-assignment operator (40 += 41 -= 42 *= 43 /=)
(func $compound (param $op i32) (param $old i64) (param $rhs i64) (result i64) (effects)
  (if (i32.eq (local.get $op) (i32.const 40)) (then (return (call $js_add (local.get $old) (local.get $rhs)))))
  (let $x f64 (call $to_num (local.get $old)))
  (let $y f64 (call $to_num (local.get $rhs)))
  (if (i32.eq (local.get $op) (i32.const 41)) (then (return (call $num (f64.sub (local.get $x) (local.get $y))))))
  (if (i32.eq (local.get $op) (i32.const 42)) (then (return (call $num (f64.mul (local.get $x) (local.get $y))))))
  (call $num (f64.div (local.get $x) (local.get $y))))

;; build an arrow function: cursor is at the body (expr or '{'); params given
(func $make_arrow (param $params i32) (param $np i32) (result i64) (effects)
  (let $fn i32 (call $heap_alloc (i32.add (i32.const 52) (i32.mul (local.get $np) (i32.const 4)))))
  (i32.store (local.get $fn) (i32.const 0))
  (i32.store (i32.add (local.get $fn) (i32.const 4)) (call $cur_scope))
  (i32.store (i32.add (local.get $fn) (i32.const 8)) (local.get $np))
  (i32.store (i32.add (local.get $fn) (i32.const 12)) (i32.const 0))
  (call $cursor_store (i32.add (local.get $fn) (i32.const 16)))
  (i32.store (i32.add (local.get $fn) (i32.const 40)) (call $src))
  (i32.store (i32.add (local.get $fn) (i32.const 44)) (call $src_len))
  (i32.store (i32.add (local.get $fn) (i32.const 48)) (i32.const 0))  ;; paramKind = names[]
  (let $i i32 (i32.const 0))
  (block $ce (loop $cc
    (br_if $ce (i32.ge_s (local.get $i) (local.get $np)))
    (i32.store (i32.add (i32.add (local.get $fn) (i32.const 52)) (i32.mul (local.get $i) (i32.const 4)))
               (i32.load (i32.add (local.get $params) (i32.mul (local.get $i) (i32.const 4)))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $cc)))
  (call $sup_inc)
  (if (i32.eq (call $cur) (i32.const 17)) (then (call $parse_block)) (else (drop (call $parse_assign))))
  (call $sup_dec)
  (call $mk_fn (local.get $fn)))

(func $parse_assign (result i64) (effects)
  ;; ( params ) => arrow
  (if (i32.eq (call $cur) (i32.const 15))
    (then
      (let $fc i32 (call $cursor_save))
      (call $advance)
      (let $aprm i32 (call $heap_alloc (i32.const 64)))
      (let $anp i32 (i32.const 0))
      (let $aok i32 (i32.const 1))
      (block $pe (loop $pc
        (br_if $pe (i32.eq (call $cur) (i32.const 16)))
        (if (i32.ne (call $cur) (i32.const 3)) (then (set! $aok (i32.const 0)) (br $pe)))
        (i32.store (i32.add (local.get $aprm) (i32.mul (local.get $anp) (i32.const 4))) (call $ident_name))
        (set! $anp (i32.add (local.get $anp) (i32.const 1)))
        (call $advance)
        (br_if $pe (i32.eqz (call $eat (i32.const 22))))
        (br $pc)))
      (if (i32.and (local.get $aok) (i32.eq (call $cur) (i32.const 16)))
        (then
          (call $advance)
          (if (i32.eq (call $cur) (i32.const 52))  ;; '=>'
            (then (call $advance) (return (call $make_arrow (local.get $aprm) (local.get $anp)))))))
      (call $cursor_restore (local.get $fc))))
  (if (i32.eq (call $cur) (i32.const 3))  ;; IDENT — lookahead for assignment/update/arrow
    (then
      (call $look_save)
      (let $nm i32 (call $ident_name))
      (call $advance)
      (let $op i32 (call $cur))
      (if (i32.eq (local.get $op) (i32.const 52))  ;; ident => arrow (1 param)
        (then
          (call $advance)
          (let $p1 i32 (call $heap_alloc (i32.const 8)))
          (i32.store (local.get $p1) (local.get $nm))
          (return (call $make_arrow (local.get $p1) (i32.const 1)))))
      (if (i32.eq (local.get $op) (i32.const 24))  ;; '='
        (then
          (call $advance)
          (let $rhs i64 (call $parse_assign))
          (if (i32.eqz (call $suppress)) (then (call $var_set (local.get $nm) (local.get $rhs))))
          (return (local.get $rhs))))
      (if (i32.or (i32.eq (local.get $op) (i32.const 40)) (i32.or (i32.eq (local.get $op) (i32.const 41))
            (i32.or (i32.eq (local.get $op) (i32.const 42)) (i32.eq (local.get $op) (i32.const 43)))))  ;; += -= *= /=
        (then
          (call $advance)
          (let $rhs i64 (call $parse_assign))
          (let $nv i64 (call $compound (local.get $op) (call $var_get_checked (local.get $nm)) (local.get $rhs)))
          (if (i32.eqz (call $suppress)) (then (call $var_set (local.get $nm) (local.get $nv))))
          (return (local.get $nv))))
      (if (i32.or (i32.eq (local.get $op) (i32.const 38)) (i32.eq (local.get $op) (i32.const 39)))  ;; postfix ++ / --
        (then
          (call $advance)
          (let $oldn f64 (call $to_num (call $var_get_checked (local.get $nm))))
          (let $newn f64 (if f64 (i32.eq (local.get $op) (i32.const 38))
                            (then (f64.add (local.get $oldn) (f64.const 1))) (else (f64.sub (local.get $oldn) (f64.const 1)))))
          (if (i32.eqz (call $suppress)) (then (call $var_set (local.get $nm) (call $num (local.get $newn)))))
          (return (call $num (local.get $oldn)))))  ;; postfix yields the OLD value
      (call $look_restore)))
  ;; general LHS — may be a member/index reference (obj.x = , arr[i] = )
  (i32.store (i32.const 104) (i32.const 0))  ;; clear assignment ref
  (let $v i64 (call $parse_ternary))
  (let $op2 i32 (call $cur))
  (if (i32.and (i32.load (i32.const 104)) (i32.eqz (call $err)))   ;; member/index reference target
    (then
      ;; capture the reference BEFORE parsing any RHS (RHS parsing clobbers REF regs)
      (let $rcont i64 (i64.load (i32.const 112)))
      (let $rkey i64 (i64.load (i32.const 120)))
      ;; '=' assignment
      (if (i32.eq (local.get $op2) (i32.const 24))
        (then
          (call $advance)
          (let $rhs i64 (call $parse_assign))
          (if (i32.eqz (call $suppress))
            (then (call $set_prop (local.get $rcont) (local.get $rkey) (local.get $rhs))))
          (return (local.get $rhs))))
      ;; compound += -= *= /=
      (if (i32.or (i32.eq (local.get $op2) (i32.const 40)) (i32.or (i32.eq (local.get $op2) (i32.const 41))
            (i32.or (i32.eq (local.get $op2) (i32.const 42)) (i32.eq (local.get $op2) (i32.const 43)))))
        (then
          (call $advance)
          (let $rhs2 i64 (call $parse_assign))
          (let $nv i64 (call $compound (local.get $op2) (local.get $v) (local.get $rhs2)))
          (if (i32.eqz (call $suppress))
            (then (call $set_prop (local.get $rcont) (local.get $rkey) (local.get $nv))))
          (return (local.get $nv))))
      ;; postfix ++ / -- (yields the OLD value)
      (if (i32.or (i32.eq (local.get $op2) (i32.const 38)) (i32.eq (local.get $op2) (i32.const 39)))
        (then
          (call $advance)
          (let $oldn f64 (call $to_num (local.get $v)))
          (let $newn f64 (if f64 (i32.eq (local.get $op2) (i32.const 38))
                            (then (f64.add (local.get $oldn) (f64.const 1))) (else (f64.sub (local.get $oldn) (f64.const 1)))))
          (if (i32.eqz (call $suppress))
            (then (call $set_prop (local.get $rcont) (local.get $rkey) (call $num (local.get $newn)))))
          (return (call $num (local.get $oldn)))))))
  (local.get $v))

;; comma operator (full Expression): evaluate left-to-right, yield the last.
;; Used at statement / paren / condition sites; arg/array/init use parse_assign.
(func $parse_comma (result i64) (effects)
  (let $v i64 (call $parse_assign))
  (block $brk (loop $cont
    (br_if $brk (i32.ne (call $cur) (i32.const 22)))  ;; ','
    (call $advance)
    (set! $v (call $parse_assign))
    (br $cont)))
  (local.get $v))

;; ── statements ──

(func $sup_inc (effects) (call $set_suppress (i32.add (call $suppress) (i32.const 1))))
(func $sup_dec (effects) (call $set_suppress (i32.sub (call $suppress) (i32.const 1))))

;; array destructuring: [a, b, c] = <array value already evaluated>
(func $destructure_array (param $rhs i64) (effects)
  (call $advance)  ;; '['
  (let $idx i32 (i32.const 0))
  (block $brk (loop $cont
    (br_if $brk (i32.eq (call $cur) (i32.const 20)))  ;; ']'
    (br_if $brk (i32.eq (call $cur) (i32.const 0)))
    (if (i32.eq (call $cur) (i32.const 3))
      (then
        (let $nm i32 (call $ident_name))
        (call $advance)
        (let $v i64 (call $get_prop (local.get $rhs) (call $num (f64.convert_i32_s (local.get $idx)))))
        (if (i32.eqz (call $suppress)) (then (call $scope_define (call $cur_scope) (local.get $nm) (local.get $v))))))
    (set! $idx (i32.add (local.get $idx) (i32.const 1)))
    (br_if $brk (i32.eqz (call $eat (i32.const 22))))
    (br $cont)))
  (call $expect (i32.const 20) (cstring "expected ]")))

;; object destructuring: {x, y: local} = <object value already evaluated>
(func $destructure_object (param $rhs i64) (effects)
  (call $advance)  ;; '{'
  (block $brk (loop $cont
    (br_if $brk (i32.eq (call $cur) (i32.const 18)))  ;; '}'
    (br_if $brk (i32.eq (call $cur) (i32.const 0)))
    (if (i32.eq (call $cur) (i32.const 3))
      (then
        (let $key i32 (call $ident_name))
        (call $advance)
        (let $local i32 (local.get $key))
        (if (i32.eq (call $cur) (i32.const 37))  ;; ':' alias
          (then (call $advance) (if (i32.eq (call $cur) (i32.const 3)) (then (set! $local (call $ident_name)) (call $advance)))))
        (let $v i64 (call $get_prop (local.get $rhs) (call $mk_str (local.get $key))))
        (if (i32.eqz (call $suppress)) (then (call $scope_define (call $cur_scope) (local.get $local) (local.get $v))))))
    (br_if $brk (i32.eqz (call $eat (i32.const 22))))
    (br $cont)))
  (call $expect (i32.const 18) (cstring "expected }")))

(func $parse_var (effects)
  (let $isVar i32 (call $tok_is_kw (cstring "var")))  ;; var is function-scoped (hoisted); let/const block-scoped
  (call $advance)  ;; consume var/let/const
  (block $brk (loop $cont
    ;; destructuring patterns
    (if (i32.eq (call $cur) (i32.const 19))  ;; [ array pattern
      (then
        (let $pc i32 (call $cursor_save))
        (call $sup_inc) (call $destructure_array (call $v_undef)) (call $sup_dec)  ;; skip pattern (no binding)
        (call $expect (i32.const 24) (cstring "expected ="))
        (let $rhs i64 (call $parse_assign))
        (let $endc i32 (call $cursor_save))
        (call $cursor_restore (local.get $pc))
        (call $destructure_array (local.get $rhs))  ;; bind names from rhs
        (call $cursor_restore (local.get $endc))
        (br_if $brk (i32.eqz (call $eat (i32.const 22))))
        (br $cont)))
    (if (i32.eq (call $cur) (i32.const 17))  ;; { object pattern
      (then
        (let $pc i32 (call $cursor_save))
        (call $sup_inc) (call $destructure_object (call $v_undef)) (call $sup_dec)
        (call $expect (i32.const 24) (cstring "expected ="))
        (let $rhs i64 (call $parse_assign))
        (let $endc i32 (call $cursor_save))
        (call $cursor_restore (local.get $pc))
        (call $destructure_object (local.get $rhs))
        (call $cursor_restore (local.get $endc))
        (br_if $brk (i32.eqz (call $eat (i32.const 22))))
        (br $cont)))
    (if (i32.ne (call $cur) (i32.const 3)) (then (call $throw (cstring "expected name")) (br $brk)))
    (let $nm i32 (call $ident_name))
    (call $advance)
    (let $val i64 (call $v_undef))
    (let $hasInit i32 (i32.const 0))
    (if (i32.eq (call $cur) (i32.const 24))
      (then (call $advance) (set! $val (call $parse_assign)) (set! $hasInit (i32.const 1))))
    (if (i32.eqz (call $suppress))
      (then
        (if (local.get $isVar)
          ;; var: assign to the hoisted binding (found up-chain); bare `var x;` keeps any prior value
          (then (if (local.get $hasInit) (then (call $var_set (local.get $nm) (local.get $val)))))
          ;; let/const: bind in the current (block) scope
          (else (call $scope_define (call $cur_scope) (local.get $nm) (local.get $val))))))
    (br_if $brk (i32.eqz (call $eat (i32.const 22))))  ;; ',' continues
    (br $cont))))

(func $parse_block (effects)
  (call $advance)  ;; '{'
  (let $saved i32 (call $cur_scope))
  (call $set_cur_scope (call $scope_new (local.get $saved) (i32.const 16)))
  (block $brk (loop $cont
    (br_if $brk (i32.eq (call $cur) (i32.const 18)))  ;; '}'
    (br_if $brk (i32.eq (call $cur) (i32.const 0)))
    (br_if $brk (call $unwind))
    (call $parse_statement)
    (br $cont)))
  ;; if unwinding (return/error/break/continue), the cursor isn't at '}';
  ;; the enclosing loop / caller restores it
  (if (i32.eqz (call $unwind))
    (then (call $expect (i32.const 18) (cstring "expected }"))))
  (call $set_cur_scope (local.get $saved)))

(func $parse_if (effects)
  (call $advance)  ;; 'if'
  (call $expect (i32.const 15) (cstring "expected ("))
  (let $cond i64 (call $parse_comma))
  (call $expect (i32.const 16) (cstring "expected )"))
  (let $take i32 (i32.and (i32.eqz (call $suppress)) (call $truthy (local.get $cond))))
  (if (local.get $take)
    (then (call $parse_statement))
    (else (call $sup_inc) (call $parse_statement) (call $sup_dec)))
  (if (call $tok_is_kw (cstring "else"))
    (then
      (call $advance)
      (if (i32.and (i32.eqz (call $suppress)) (i32.eqz (local.get $take)))
        (then (call $parse_statement))
        (else (call $sup_inc) (call $parse_statement) (call $sup_dec))))))

;; skip the loop body (a statement) without executing, leaving the cursor after it
(func $skip_body (param $bodycur i32) (effects)
  (call $cursor_restore (local.get $bodycur))
  (call $sup_inc) (call $parse_statement) (call $sup_dec))

(func $parse_while (effects)
  (let $mylabel i32 (call $label_pending)) (call $set_label_pending (i32.const 0))
  (call $advance)  ;; 'while'
  (call $expect (i32.const 15) (cstring "expected ("))
  (let $condcur i32 (call $cursor_save))
  (block $brk (loop $cont
    (call $cursor_restore (local.get $condcur))
    (let $cond i64 (call $parse_comma))
    (call $expect (i32.const 16) (cstring "expected )"))
    (let $bodycur i32 (call $cursor_save))
    (if (i32.or (call $suppress) (i32.or (call $err) (i32.or (call $retflag) (i32.eqz (call $truthy (local.get $cond))))))
      (then (call $skip_body (local.get $bodycur)) (br $brk)))  ;; skip body, exit
    (call $parse_statement)  ;; execute body
    (if (call $brkflag)
      (then (if (call $label_matches (local.get $mylabel)) (then (call $clear_loopflags))) (call $skip_body (local.get $bodycur)) (br $brk)))
    (if (call $contflag)
      (then (if (call $label_matches (local.get $mylabel))
        (then (i32.store (i32.const 136) (i32.const 0)) (i32.store (i32.const 192) (i32.const 0)))
        (else (call $skip_body (local.get $bodycur)) (br $brk)))))  ;; continue targets an outer loop
    (br $cont))))

;; decide for(;;) vs for-in / for-of by peeking after the loop variable
(func $parse_for_dispatch (effects)
  (let $fc i32 (call $cursor_save))  ;; at 'for'
  (call $advance)  ;; 'for'
  (drop (call $eat (i32.const 15)))  ;; '('
  (if (i32.eq (call $cur) (i32.const 3))
    (then (if (i32.or (call $tok_is_kw (cstring "var")) (i32.or (call $tok_is_kw (cstring "let")) (call $tok_is_kw (cstring "const")))) (then (call $advance)))))
  (let $inof i32 (i32.const 0))
  (if (i32.eq (call $cur) (i32.const 3))
    (then (call $advance) (if (i32.or (call $tok_is_kw (cstring "in")) (call $tok_is_kw (cstring "of"))) (then (set! $inof (i32.const 1))))))
  (call $cursor_restore (local.get $fc))
  (if (local.get $inof) (then (call $parse_for_inof)) (else (call $parse_for))))

;; for (var x in obj) / for (var x of arr|str)
(func $parse_for_inof (effects)
  (let $mylabel i32 (call $label_pending)) (call $set_label_pending (i32.const 0))
  (call $advance)  ;; 'for'
  (call $expect (i32.const 15) (cstring "expected ("))
  (if (i32.or (call $tok_is_kw (cstring "var")) (i32.or (call $tok_is_kw (cstring "let")) (call $tok_is_kw (cstring "const")))) (then (call $advance)))
  (let $vn i32 (call $ident_name))
  (call $advance)
  (let $isOf i32 (call $tok_is_kw (cstring "of")))
  (call $advance)  ;; in / of
  (let $coll i64 (call $parse_assign))
  (call $expect (i32.const 16) (cstring "expected )"))
  (let $bodycur i32 (call $cursor_save))
  ;; iterator protocol: for-of over an object that is/produces an iterator
  (if (i32.and (local.get $isOf) (call $is_object (local.get $coll)))
    (then
      (let $iter i64 (local.get $coll))
      (let $itfn i64 (call $get_prop (local.get $coll) (call $mk_str (cstring "@@iterator"))))
      (if (call $is_function (local.get $itfn))
        (then (set! $iter (call $call_fn0 (local.get $itfn) (local.get $coll)))))
      (let $nextfn i64 (call $get_prop (local.get $iter) (call $mk_str (cstring "next"))))
      (if (call $is_function (local.get $nextfn))
        (then
          (block $ibrk (loop $icont
            (br_if $ibrk (call $suppress))
            (let $r i64 (call $call_fn0 (local.get $nextfn) (local.get $iter)))
            (br_if $ibrk (call $err))
            (br_if $ibrk (call $truthy (call $get_prop (local.get $r) (call $mk_str (cstring "done")))))
            (call $var_set (local.get $vn) (call $get_prop (local.get $r) (call $mk_str (cstring "value"))))
            (call $cursor_restore (local.get $bodycur))
            (call $parse_statement)
            (if (call $brkflag) (then (if (call $label_matches (local.get $mylabel)) (then (call $clear_loopflags))) (br $ibrk)))
            (if (call $contflag)
              (then (if (call $label_matches (local.get $mylabel))
                (then (i32.store (i32.const 136) (i32.const 0)) (i32.store (i32.const 192) (i32.const 0)))
                (else (br $ibrk)))))
            (br_if $ibrk (i32.or (call $err) (call $retflag)))
            (br $icont)))
          (call $skip_body (local.get $bodycur))
          (return)))))
  ;; determine count and source kind
  (let $count i32 (i32.const 0))
  (let $payload i32 (i32.const 0))
  (if (call $is_array (local.get $coll)) (then (set! $payload (call $val_payload (local.get $coll))) (set! $count (call $arr_len (local.get $payload)))))
  (if (call $is_string (local.get $coll)) (then (set! $payload (call $val_payload (local.get $coll))) (set! $count (call $str_len (local.get $payload)))))
  (if (call $is_object (local.get $coll)) (then (set! $payload (call $val_payload (local.get $coll))) (set! $count (call $scope_count (local.get $payload)))))
  (let $i i32 (i32.const 0))
  (block $brk (loop $cont
    (br_if $brk (i32.ge_s (local.get $i) (local.get $count)))
    (br_if $brk (call $suppress))
    ;; compute the loop value/key
    (let $item i64 (call $v_undef))
    (if (local.get $isOf)
      (then  ;; values
        (if (call $is_array (local.get $coll)) (then (set! $item (call $arr_get (local.get $payload) (local.get $i)))))
        (if (call $is_string (local.get $coll)) (then (set! $item (call $str_char_at (local.get $payload) (local.get $i))))))
      (else  ;; keys (strings)
        (if (call $is_object (local.get $coll)) (then (set! $item (call $mk_str (i32.load (call $scope_entry (local.get $payload) (local.get $i)))))))
        (if (i32.or (call $is_array (local.get $coll)) (call $is_string (local.get $coll))) (then (set! $item (call $mk_str (call $num_to_str (f64.convert_i32_s (local.get $i)))))))))
    (call $var_set (local.get $vn) (local.get $item))
    (call $cursor_restore (local.get $bodycur))
    (call $parse_statement)
    (if (call $brkflag) (then (if (call $label_matches (local.get $mylabel)) (then (call $clear_loopflags))) (br $brk)))
    (if (call $contflag)
      (then (if (call $label_matches (local.get $mylabel))
        (then (i32.store (i32.const 136) (i32.const 0)) (i32.store (i32.const 192) (i32.const 0)))
        (else (br $brk)))))
    (br_if $brk (i32.or (call $err) (call $retflag)))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $cont)))
  ;; position cursor past the body
  (call $skip_body (local.get $bodycur)))

(func $parse_for (effects)
  (let $mylabel i32 (call $label_pending)) (call $set_label_pending (i32.const 0))
  (call $advance)  ;; 'for'
  (call $expect (i32.const 15) (cstring "expected ("))
  ;; init (var decl or expression or empty), consumes its ';'
  (if (i32.ne (call $cur) (i32.const 21))
    (then
      (if (i32.or (call $tok_is_kw (cstring "var")) (i32.or (call $tok_is_kw (cstring "let")) (call $tok_is_kw (cstring "const"))))
        (then (call $parse_var))
        (else (drop (call $parse_comma))))))
  (call $expect (i32.const 21) (cstring "expected ;"))
  (let $condcur i32 (call $cursor_save))
  (block $brk (loop $cont
    (call $cursor_restore (local.get $condcur))
    ;; cond (empty => true)
    (let $cond i32 (i32.const 1))
    (if (i32.ne (call $cur) (i32.const 21))
      (then (set! $cond (call $truthy (call $parse_comma)))))
    (call $expect (i32.const 21) (cstring "expected ;"))
    (let $updcur i32 (call $cursor_save))
    ;; skip update to reach body
    (call $sup_inc)
    (if (i32.ne (call $cur) (i32.const 16)) (then (drop (call $parse_comma))))
    (call $sup_dec)
    (call $expect (i32.const 16) (cstring "expected )"))
    (let $bodycur i32 (call $cursor_save))
    (if (i32.or (call $suppress) (i32.or (call $err) (i32.or (call $retflag) (i32.eqz (local.get $cond)))))
      (then (call $skip_body (local.get $bodycur)) (br $brk)))
    (call $parse_statement)        ;; body
    (if (call $brkflag)
      (then (if (call $label_matches (local.get $mylabel)) (then (call $clear_loopflags))) (call $skip_body (local.get $bodycur)) (br $brk)))
    (if (call $contflag)
      (then (if (call $label_matches (local.get $mylabel))
        (then (i32.store (i32.const 136) (i32.const 0)) (i32.store (i32.const 192) (i32.const 0)))
        (else (call $skip_body (local.get $bodycur)) (br $brk)))))  ;; continue targets an outer loop
    (if (i32.eqz (i32.or (call $err) (call $retflag)))   ;; run update unless unwinding
      (then
        (call $cursor_restore (local.get $updcur))
        (if (i32.ne (call $cur) (i32.const 16)) (then (drop (call $parse_comma))))))
    (br $cont))))

(func $parse_return (effects)
  (call $advance)  ;; 'return'
  (let $v i64 (call $v_undef))
  (if (i32.eqz (i32.or (i32.eq (call $cur) (i32.const 21))
                (i32.or (i32.eq (call $cur) (i32.const 18)) (i32.eq (call $cur) (i32.const 0)))))
    (then (set! $v (call $parse_comma))))
  (if (i32.eqz (call $suppress))
    (then (i32.store (i32.const 88) (i32.const 1)) (i64.store (i32.const 96) (local.get $v))))
  (drop (call $eat (i32.const 21))))

(func $parse_throw (effects)
  (call $advance)  ;; 'throw'
  (let $v i64 (call $parse_assign))
  (if (i32.eqz (call $suppress))
    (then (call $set_err (i32.const 1)) (call $set_err_val (local.get $v))))
  (drop (call $eat (i32.const 21))))

;; skip a 'catch' clause (header + block) without executing it
(func $skip_catch (effects)
  (if (call $tok_is_kw (cstring "catch"))
    (then
      (call $advance)
      (if (i32.eq (call $cur) (i32.const 15))
        (then (call $advance)
              (if (i32.eq (call $cur) (i32.const 3)) (then (call $advance)))
              (call $expect (i32.const 16) (cstring "expected )"))))
      (call $sup_inc) (call $parse_block) (call $sup_dec))))

;; try { ... } catch (e) { ... }
(func $parse_try (effects)
  (call $advance)  ;; 'try'
  (let $trycur i32 (call $cursor_save))  ;; at '{'
  (call $parse_block)                    ;; run try block
  ;; case A: try exited via return/break/continue (NOT error) — skip rest of try
  ;; and the catch clause, then propagate the control-flow flag.
  (if (i32.and (i32.or (call $retflag) (i32.or (call $brkflag) (call $contflag))) (i32.eqz (call $err)))
    (then
      (call $cursor_restore (local.get $trycur))
      (call $sup_inc) (call $parse_block) (call $sup_dec)  ;; skip rest of try block
      (call $skip_catch)
      (return)))
  (let $caught i32 (i32.const 0))
  (let $cval i64 (call $v_undef))
  (if (i32.and (call $err) (i32.eqz (call $suppress)))
    (then
      (set! $cval (call $err_val))
      (call $set_err (i32.const 0))
      (set! $caught (i32.const 1))
      ;; rewind and skip the rest of the try block to reach 'catch'
      (call $cursor_restore (local.get $trycur))
      (call $sup_inc) (call $parse_block) (call $sup_dec)))
  ;; 'catch'
  (if (i32.eqz (call $tok_is_kw (cstring "catch")))
    (then (call $throw (cstring "expected catch")) (return)))
  (call $advance)
  (let $ename i32 (i32.const 0))
  (if (i32.eq (call $cur) (i32.const 15))  ;; optional ( ident )
    (then
      (call $advance)
      (if (i32.eq (call $cur) (i32.const 3)) (then (set! $ename (call $ident_name)) (call $advance)))
      (call $expect (i32.const 16) (cstring "expected )"))))
  (if (local.get $caught)
    (then  ;; execute catch with the bound value
      (let $saved i32 (call $cur_scope))
      (call $set_cur_scope (call $scope_new (local.get $saved) (i32.const 8)))
      (if (i32.ne (local.get $ename) (i32.const 0))
        (then (call $scope_define (call $cur_scope) (local.get $ename) (local.get $cval))))
      (call $parse_block)
      (call $set_cur_scope (local.get $saved)))
    (else  ;; no error: skip catch block
      (call $sup_inc) (call $parse_block) (call $sup_dec))))

(func $parse_break (effects)
  (call $advance)
  (let $lbl i32 (i32.const 0))  ;; optional label
  (if (i32.eq (call $cur) (i32.const 3)) (then (set! $lbl (call $ident_name)) (call $advance)))
  (if (i32.eqz (call $suppress)) (then (i32.store (i32.const 132) (i32.const 1)) (i32.store (i32.const 192) (local.get $lbl))))
  (drop (call $eat (i32.const 21))))
(func $parse_continue (effects)
  (call $advance)
  (let $lbl i32 (i32.const 0))
  (if (i32.eq (call $cur) (i32.const 3)) (then (set! $lbl (call $ident_name)) (call $advance)))
  (if (i32.eqz (call $suppress)) (then (i32.store (i32.const 136) (i32.const 1)) (i32.store (i32.const 192) (local.get $lbl))))
  (drop (call $eat (i32.const 21))))

;; do <stmt> while ( cond )
(func $parse_do (effects)
  (let $mylabel i32 (call $label_pending)) (call $set_label_pending (i32.const 0))
  (call $advance)  ;; 'do'
  (let $bodycur i32 (call $cursor_save))
  (block $brk (loop $cont
    (call $cursor_restore (local.get $bodycur))
    (call $parse_statement)             ;; body
    (let $unwound i32 (i32.or (call $err) (call $retflag)))
    ;; if body exited early (break/continue/return/err), reposition cursor past it
    (if (i32.or (call $brkflag) (i32.or (call $contflag) (local.get $unwound)))
      (then (call $skip_body (local.get $bodycur))))
    (if (local.get $unwound) (then (br $brk)))
    ;; decide whether this loop exits, consuming our own labelled/unlabelled break/continue
    (let $exit i32 (i32.const 0))
    (if (call $brkflag)
      (then (if (call $label_matches (local.get $mylabel)) (then (call $clear_loopflags))) (set! $exit (i32.const 1))))
    (if (call $contflag)
      (then (if (call $label_matches (local.get $mylabel))
        (then (i32.store (i32.const 136) (i32.const 0)) (i32.store (i32.const 192) (i32.const 0)))
        (else (set! $exit (i32.const 1))))))
    ;; trailing while ( cond ) — always consumed to position the cursor past the statement
    (if (i32.eqz (call $tok_is_kw (cstring "while"))) (then (call $throw (cstring "expected while")) (br $brk)))
    (call $advance)
    (call $expect (i32.const 15) (cstring "expected ("))
    (let $cond i64 (call $parse_comma))
    (call $expect (i32.const 16) (cstring "expected )"))
    (drop (call $eat (i32.const 21)))
    (if (local.get $exit) (then (br $brk)))
    (if (i32.or (call $suppress) (i32.eqz (call $truthy (local.get $cond)))) (then (br $brk)))
    (br $cont))))

;; switch (disc) { case e: ...; default: ...; }
(func $parse_switch (effects)
  (call $advance)  ;; 'switch'
  (call $expect (i32.const 15) (cstring "expected ("))
  (let $disc i64 (call $parse_comma))
  (call $expect (i32.const 16) (cstring "expected )"))
  (call $expect (i32.const 17) (cstring "expected {"))
  (let $matchcur i32 (i32.const 0))
  (let $defaultcur i32 (i32.const 0))
  (let $matched i32 (i32.const 0))
  ;; Phase 1: find the matching case (or default) body position
  (block $s1 (loop $c1
    (br_if $s1 (i32.eq (call $cur) (i32.const 18)))  ;; '}'
    (br_if $s1 (i32.eq (call $cur) (i32.const 0)))
    (br_if $s1 (call $err))
    (if (call $tok_is_kw (cstring "case"))
      (then
        (call $advance)
        (let $ce i64 (call $parse_assign))
        (call $expect (i32.const 37) (cstring "expected :"))
        (if (i32.and (i32.eqz (local.get $matched)) (call $strict_eq (local.get $disc) (local.get $ce)))
          (then (set! $matchcur (call $cursor_save)) (set! $matched (i32.const 1)))))
      (else
        (if (call $tok_is_kw (cstring "default"))
          (then (call $advance) (call $expect (i32.const 37) (cstring "expected :")) (set! $defaultcur (call $cursor_save)))
          (else (call $sup_inc) (call $parse_statement) (call $sup_dec)))))  ;; skip a body statement
    (br $c1)))
  ;; cursor at '}' — remember end, then execute from the chosen label
  (let $target i32 (if i32 (local.get $matched) (then (local.get $matchcur)) (else (local.get $defaultcur))))
  (if (i32.and (i32.ne (local.get $target) (i32.const 0)) (i32.eqz (call $err)))
    (then
      (call $cursor_restore (local.get $target))
      (block $s2 (loop $c2
        (br_if $s2 (i32.eq (call $cur) (i32.const 18)))  ;; '}'
        (br_if $s2 (i32.eq (call $cur) (i32.const 0)))
        ;; fall-through past case/default labels
        (if (call $tok_is_kw (cstring "case"))
          (then (call $advance) (call $sup_inc) (drop (call $parse_assign)) (call $sup_dec)
                (call $expect (i32.const 37) (cstring "expected :")) (br $c2)))
        (if (call $tok_is_kw (cstring "default"))
          (then (call $advance) (call $expect (i32.const 37) (cstring "expected :")) (br $c2)))
        (call $parse_statement)
        (if (call $brkflag)
          (then (if (i32.eqz (call $brk_target)) (then (call $clear_loopflags)))  ;; unlabelled break exits switch; labelled propagates
                (br $s2)))
        (br_if $s2 (i32.or (call $err) (i32.or (call $retflag) (call $contflag))))  ;; propagate
        (br $c2)))))
  ;; reposition to the switch's closing '}' by brace-depth token scan (must work
  ;; even while unwinding — parse_statement is a no-op then and wouldn't advance).
  (let $d i32 (i32.const 0))
  (block $skip (loop $cs
    (br_if $skip (i32.eq (call $cur) (i32.const 0)))
    (if (i32.eq (call $cur) (i32.const 17)) (then (set! $d (i32.add (local.get $d) (i32.const 1)))))
    (if (i32.eq (call $cur) (i32.const 18))
      (then (br_if $skip (i32.eqz (local.get $d))) (set! $d (i32.sub (local.get $d) (i32.const 1)))))
    (call $advance)
    (br $cs)))
  (drop (call $eat (i32.const 18))))  ;; consume '}'

(func $parse_statement (effects)
  (if (call $unwind) (then (return)))
  (let $k i32 (call $cur))
  (if (i32.eq (local.get $k) (i32.const 17)) (then (call $parse_block) (return)))   ;; '{'
  (if (i32.eq (local.get $k) (i32.const 21)) (then (call $advance) (return)))       ;; empty ';'
  (if (i32.eq (local.get $k) (i32.const 3))
    (then
      ;; labelled statement:  IDENT : stmt   (label applies to the following loop)
      (call $look_save)
      (let $maybe i32 (call $ident_name))
      (call $advance)
      (if (i32.eq (call $cur) (i32.const 37))  ;; ':'
        (then
          (call $advance)
          (call $set_label_pending (local.get $maybe))
          (let $lblcur i32 (call $cursor_save))  ;; start of the labelled statement
          (call $parse_statement)
          (call $set_label_pending (i32.const 0))
          ;; a labelled non-loop statement (e.g. a block) absorbs a break to its own
          ;; label; re-scan it under suppress to reposition the cursor past its end.
          (if (call $brkflag)
            (then (if (call $brk_target)
              (then (if (call $str_eq (call $brk_target) (local.get $maybe))
                (then
                  (i32.store (i32.const 132) (i32.const 0)) (i32.store (i32.const 192) (i32.const 0))
                  (call $cursor_restore (local.get $lblcur))
                  (call $sup_inc) (call $parse_statement) (call $sup_dec)))))))
          (return)))
      (call $look_restore)
      (if (call $tok_is_kw (cstring "var"))      (then (call $parse_var) (drop (call $eat (i32.const 21))) (return)))
      (if (call $tok_is_kw (cstring "let"))      (then (call $parse_var) (drop (call $eat (i32.const 21))) (return)))
      (if (call $tok_is_kw (cstring "const"))    (then (call $parse_var) (drop (call $eat (i32.const 21))) (return)))
      (if (call $tok_is_kw (cstring "if"))       (then (call $parse_if) (return)))
      (if (call $tok_is_kw (cstring "while"))    (then (call $parse_while) (return)))
      (if (call $tok_is_kw (cstring "do"))       (then (call $parse_do) (return)))
      (if (call $tok_is_kw (cstring "for"))      (then (call $parse_for_dispatch) (return)))
      (if (call $tok_is_kw (cstring "function")) (then (drop (call $parse_function (i32.const 1))) (return)))
      (if (call $tok_is_kw (cstring "return"))   (then (call $parse_return) (return)))
      (if (call $tok_is_kw (cstring "throw"))    (then (call $parse_throw) (return)))
      (if (call $tok_is_kw (cstring "try"))      (then (call $parse_try) (return)))
      (if (call $tok_is_kw (cstring "break"))    (then (call $parse_break) (return)))
      (if (call $tok_is_kw (cstring "continue")) (then (call $parse_continue) (return)))
      (if (call $tok_is_kw (cstring "switch"))   (then (call $parse_switch) (return)))
      (if (call $tok_is_kw (cstring "class"))    (then (drop (call $parse_class (i32.const 1))) (return)))))
  ;; expression statement
  (drop (call $parse_comma))
  (drop (call $eat (i32.const 21))))

;; register a native builtin (nativeId) under `name` in the given scope
(func $def_native (param $scope i32) (param $name i32) (param $id i32) (result i64) (effects)
  (let $fn i32 (call $heap_alloc (i32.const 40)))
  (i32.store (local.get $fn) (local.get $id))
  (i32.store (i32.add (local.get $fn) (i32.const 8)) (i32.const 0))   ;; nparam
  (i32.store (i32.add (local.get $fn) (i32.const 12)) (i32.const 0))  ;; props (lazy)
  (call $scope_define (call $fn_props (local.get $fn)) (cstring "name") (call $mk_str (local.get $name)))
  (let $v i64 (call $mk_fn (local.get $fn)))
  (call $scope_define (local.get $scope) (local.get $name) (local.get $v))
  (local.get $v))

;; skip a nested function (cursor at 'function'): advance to its body '{' then
;; over the balanced braces, so its inner `var`s aren't hoisted to the outer scope.
(func $hoist_skip_fn (effects)
  (block $b1 (loop $l1
    (call $advance)
    (let $k i32 (call $tok_kind))
    (br_if $b1 (i32.eq (local.get $k) (i32.const 17)))  ;; '{'
    (br_if $b1 (i32.eq (local.get $k) (i32.const 0)))
    (br $l1)))
  (let $bd i32 (i32.const 1))
  (block $b2 (loop $l2
    (call $advance)
    (let $k i32 (call $tok_kind))
    (br_if $b2 (i32.eq (local.get $k) (i32.const 0)))
    (if (i32.eq (local.get $k) (i32.const 17)) (then (set! $bd (i32.add (local.get $bd) (i32.const 1)))))
    (if (i32.eq (local.get $k) (i32.const 18))
      (then (set! $bd (i32.sub (local.get $bd) (i32.const 1))) (br_if $b2 (i32.eqz (local.get $bd)))))
    (br $l2))))

;; hoist `var` declarations: pre-define their names as undefined in `scope`.
;; untilEof=1 scans the whole program; otherwise scans one function body whose
;; opening '{' is the current token. Nested function bodies are skipped.
;; (Single-declarator form handled; the common case.)
(func $hoist_vars (param $scope i32) (param $untilEof i32) (effects)
  (let $depth i32 (if i32 (local.get $untilEof) (then (i32.const 0)) (else (i32.const 1))))
  (block $done (loop $scan
    (call $advance)
    (let $k i32 (call $tok_kind))
    (br_if $done (i32.eq (local.get $k) (i32.const 0)))
    (if (i32.eq (local.get $k) (i32.const 17)) (then (set! $depth (i32.add (local.get $depth) (i32.const 1)))))
    (if (i32.eq (local.get $k) (i32.const 18))
      (then (set! $depth (i32.sub (local.get $depth) (i32.const 1)))
            (br_if $done (i32.and (i32.eqz (local.get $untilEof)) (i32.lt_s (local.get $depth) (i32.const 1))))))
    (if (i32.eq (local.get $k) (i32.const 3))
      (then
        (if (call $tok_is_kw (cstring "function")) (then (call $hoist_skip_fn)))
        (if (call $tok_is_kw (cstring "var"))
          (then
            (call $advance)
            (if (i32.eq (call $tok_kind) (i32.const 3))
              (then
                (let $nm i32 (call $ident_name))
                (if (i32.eqz (call $scope_find_local (local.get $scope) (local.get $nm)))
                  (then (call $scope_define (local.get $scope) (local.get $nm) (call $v_undef))))))))))
    (br $scan))))

;; JS prelude: error constructors (run at startup, in global scope)
;; The JS bootstrap defining the standard Error hierarchy. Shared by the re-scan
;; engine (run_prelude → eval_string) and the bytecode VM (vm_compile_prog, which
;; compiles it into the same code buffer ahead of the user program).
(func $prelude_src (result i32) (effects) (cstring
    "function Error(m){ if (m !== undefined) this.message = String(m); }\nError.prototype.name = 'Error';\nError.prototype.message = '';\nError.prototype.toString = function(){ if (this.message === '') return this.name; return this.name + ': ' + this.message; };\nfunction TypeError(m){ if (m !== undefined) this.message = String(m); }\nTypeError.prototype.name = 'TypeError'; TypeError.prototype.message = ''; TypeError.prototype.toString = Error.prototype.toString;\nfunction RangeError(m){ if (m !== undefined) this.message = String(m); }\nRangeError.prototype.name = 'RangeError'; RangeError.prototype.message = ''; RangeError.prototype.toString = Error.prototype.toString;\nfunction ReferenceError(m){ if (m !== undefined) this.message = String(m); }\nReferenceError.prototype.name = 'ReferenceError'; ReferenceError.prototype.message = ''; ReferenceError.prototype.toString = Error.prototype.toString;\nfunction SyntaxError(m){ if (m !== undefined) this.message = String(m); }\nSyntaxError.prototype.name = 'SyntaxError'; SyntaxError.prototype.message = ''; SyntaxError.prototype.toString = Error.prototype.toString;\nfunction EvalError(m){ if (m !== undefined) this.message = String(m); }\nEvalError.prototype.name = 'EvalError'; EvalError.prototype.toString = Error.prototype.toString;\nfunction URIError(m){ if (m !== undefined) this.message = String(m); }\nURIError.prototype.name = 'URIError'; URIError.prototype.toString = Error.prototype.toString;\n"))

(func $run_prelude (effects)
  (drop (call $eval_string (call $prelude_src))))

;; Register all builtins/globals into scope $g — shared by the re-scan engine
;; (eval_program) and the bytecode VM (eval_prog) so both see the same protos.
(func $setup_globals (param $g i32) (effects)
  (i32.store (i32.const 152) (local.get $g))  ;; GLOBAL_SCOPE register (for make_error)
  (drop (call $def_native (local.get $g) (cstring "print") (i32.const 1)))
  (drop (call $def_native (local.get $g) (cstring "assert") (i32.const 2)))
  (drop (call $def_native (local.get $g) (cstring "eval") (i32.const 3)))
  (drop (call $def_native (local.get $g) (cstring "Boolean") (i32.const 6)))
  (drop (call $def_native (local.get $g) (cstring "isNaN") (i32.const 7)))
  (drop (call $def_native (local.get $g) (cstring "isFinite") (i32.const 8)))
  (drop (call $def_native (local.get $g) (cstring "parseInt") (i32.const 50)))
  (drop (call $def_native (local.get $g) (cstring "parseFloat") (i32.const 51)))
  (drop (call $def_native (local.get $g) (cstring "RegExp") (i32.const 100)))
  ;; Number with NaN / Infinity constants
  (let $numproto i32 (call $scope_new (i32.const 0) (i32.const 8)))  ;; Number.prototype (reg 164)
  (i32.store (i32.const 164) (local.get $numproto))
  (call $scope_define (local.get $numproto) (cstring "toString") (call $mk_native (i32.const 145) (cstring "toString")))
  (call $scope_define (local.get $numproto) (cstring "toFixed") (call $mk_native (i32.const 146) (cstring "toFixed")))
  (let $numf i64 (call $def_native (local.get $g) (cstring "Number") (i32.const 4)))
  (call $set_prop (local.get $numf) (call $mk_str (cstring "NaN")) (call $num (f64.div (f64.const 0) (f64.const 0))))
  (call $set_prop (local.get $numf) (call $mk_str (cstring "POSITIVE_INFINITY")) (call $num (f64.div (f64.const 1) (f64.const 0))))
  (call $set_prop (local.get $numf) (call $mk_str (cstring "NEGATIVE_INFINITY")) (call $num (f64.div (f64.const -1) (f64.const 0))))
  (call $set_prop (local.get $numf) (call $mk_str (cstring "MAX_SAFE_INTEGER")) (call $num (f64.const 9007199254740991)))
  (call $set_prop (local.get $numf) (call $mk_str (cstring "isNaN")) (call $mk_native (i32.const 84) (cstring "isNaN")))
  (call $set_prop (local.get $numf) (call $mk_str (cstring "isInteger")) (call $mk_native (i32.const 85) (cstring "isInteger")))
  (call $set_prop (local.get $numf) (call $mk_str (cstring "isFinite")) (call $mk_native (i32.const 86) (cstring "isFinite")))
  (call $set_prop (local.get $numf) (call $mk_str (cstring "isSafeInteger")) (call $mk_native (i32.const 98) (cstring "isSafeInteger")))
  (call $set_prop (local.get $numf) (call $mk_str (cstring "parseInt")) (call $mk_native (i32.const 50) (cstring "parseInt")))
  (call $set_prop (local.get $numf) (call $mk_str (cstring "parseFloat")) (call $mk_native (i32.const 51) (cstring "parseFloat")))
  (call $set_prop (local.get $numf) (call $mk_str (cstring "MIN_SAFE_INTEGER")) (call $num (f64.const -9007199254740991)))
  (call $set_prop (local.get $numf) (call $mk_str (cstring "EPSILON")) (call $num (f64.const 2.220446049250313e-16)))
  (call $set_prop (local.get $numf) (call $mk_str (cstring "MAX_VALUE")) (call $num (f64.const 1.7976931348623157e308)))
  (call $set_prop (local.get $numf) (call $mk_str (cstring "MIN_VALUE")) (call $num (f64.const 5e-324)))
  (call $set_prop (local.get $numf) (call $mk_str (cstring "NaN")) (call $num (f64.div (f64.const 0) (f64.const 0))))
  (call $set_prop (local.get $numf) (call $mk_str (cstring "POSITIVE_INFINITY")) (call $num (f64.div (f64.const 1) (f64.const 0))))
  (call $set_prop (local.get $numf) (call $mk_str (cstring "NEGATIVE_INFINITY")) (call $num (f64.div (f64.const -1) (f64.const 0))))
  (let $strf i64 (call $def_native (local.get $g) (cstring "String") (i32.const 5)))
  ;; String.prototype (reg 156) — methods dispatched on string primitives
  (let $sp i32 (call $obj_new (i32.const 48)))
  (i32.store (i32.const 156) (local.get $sp))
  (call $scope_define (local.get $sp) (cstring "charAt") (call $mk_native (i32.const 11) (cstring "charAt")))
  (call $scope_define (local.get $sp) (cstring "charCodeAt") (call $mk_native (i32.const 12) (cstring "charCodeAt")))
  (call $scope_define (local.get $sp) (cstring "indexOf") (call $mk_native (i32.const 13) (cstring "indexOf")))
  (call $scope_define (local.get $sp) (cstring "slice") (call $mk_native (i32.const 14) (cstring "slice")))
  (call $scope_define (local.get $sp) (cstring "substring") (call $mk_native (i32.const 15) (cstring "substring")))
  (call $scope_define (local.get $sp) (cstring "substr") (call $mk_native (i32.const 138) (cstring "substr")))
  (call $scope_define (local.get $sp) (cstring "toUpperCase") (call $mk_native (i32.const 16) (cstring "toUpperCase")))
  (call $scope_define (local.get $sp) (cstring "toLowerCase") (call $mk_native (i32.const 17) (cstring "toLowerCase")))
  (call $scope_define (local.get $sp) (cstring "toString") (call $mk_native (i32.const 18) (cstring "toString")))
  (call $scope_define (local.get $sp) (cstring "valueOf") (call $mk_native (i32.const 18) (cstring "valueOf")))
  (call $scope_define (local.get $sp) (cstring "constructor") (local.get $strf))
  (call $scope_define (local.get $sp) (cstring "split") (call $mk_native (i32.const 60) (cstring "split")))
  (call $scope_define (local.get $sp) (cstring "trim") (call $mk_native (i32.const 61) (cstring "trim")))
  (call $scope_define (local.get $sp) (cstring "repeat") (call $mk_native (i32.const 62) (cstring "repeat")))
  (call $scope_define (local.get $sp) (cstring "includes") (call $mk_native (i32.const 63) (cstring "includes")))
  (call $scope_define (local.get $sp) (cstring "replaceAll") (call $mk_native (i32.const 141) (cstring "replaceAll")))
  (call $scope_define (local.get $sp) (cstring "startsWith") (call $mk_native (i32.const 64) (cstring "startsWith")))
  (call $scope_define (local.get $sp) (cstring "endsWith") (call $mk_native (i32.const 65) (cstring "endsWith")))
  (call $scope_define (local.get $sp) (cstring "trimStart") (call $mk_native (i32.const 113) (cstring "trimStart")))
  (call $scope_define (local.get $sp) (cstring "trimEnd") (call $mk_native (i32.const 114) (cstring "trimEnd")))
  (call $scope_define (local.get $sp) (cstring "padStart") (call $mk_native (i32.const 66) (cstring "padStart")))
  (call $scope_define (local.get $sp) (cstring "padEnd") (call $mk_native (i32.const 67) (cstring "padEnd")))
