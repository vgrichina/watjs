      (call $scope_define_attr (local.get $os) (local.get $ks)
        (if i64 (local.get $vs) (then (i64.load (local.get $vs)))
          (else (if i64 (i32.and (i32.ne (local.get $old) (i32.const 0)) (i32.eqz (local.get $oldAcc))) (then (i64.load (local.get $old))) (else (call $v_undef)))))
        (local.get $attrs)))))

;; build a property-descriptor object from a property slot.
(func $make_descriptor (param $slot i32) (result i64) (effects)
