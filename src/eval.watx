;; ═══════════════════════════════════════════════════════════════
;; eval.watx — Pratt / precedence-climbing parser+evaluator
;;
;; Phase 0: expressions only (no variables yet). Parse-and-evaluate:
;; each parse_* consumes tokens via $next_token and returns a JSValue.
;; Short-circuit (&& || ?:) uses a SUPPRESS flag (register 56): when set,
;; side-effecting builtins (print) are skipped while tokens are still
;; consumed, so the untaken branch parses but produces no output.
;;
;; On error: $throw sets ERR + ERR_VAL and parse_* funcs unwind by
;; returning undefined (callers check $err()).
;; ═══════════════════════════════════════════════════════════════

(func $suppress (result i32) (effects) (i32.load (i32.const 56)))
(func $set_suppress (param $v i32) (effects) (i32.store (i32.const 56) (local.get $v)))

(func $throw (param $msg i32) (effects)
  ;; no-op while suppressed (we're skip-scanning, not executing)
  (if (i32.and (i32.eqz (call $err)) (i32.eqz (call $suppress)))
    (then (call $set_err (i32.const 1)) (call $set_err_val (call $mk_str (local.get $msg))))))

;; construct an error object of the named type (looked up in the global scope)
;; with the given message Str; falls back to a plain string if the type is absent.
(func $make_error (param $typecstr i32) (param $msg i32) (result i64) (effects)
  (let $slot i32 (call $scope_find (i32.load (i32.const 152)) (local.get $typecstr)))
  (if (i32.eqz (local.get $slot)) (then (return (call $mk_str (local.get $msg)))))
  (let $fnval i64 (i64.load (local.get $slot)))
  (if (i32.eqz (call $is_function (local.get $fnval))) (then (return (call $mk_str (local.get $msg)))))
  (let $fn i32 (call $val_payload (local.get $fnval)))
  ;; VM-function constructor (running under the bytecode VM): build the instance
  ;; directly — link to its @16 prototype and set .message (mirrors the ctor body).
  (if (i32.and (i32.ge_s (i32.load (local.get $fn)) (i32.const 1448232526)) (i32.le_s (i32.load (local.get $fn)) (i32.const 1448232528)))
    (then
      (let $vproto i64 (i64.load (i32.add (local.get $fn) (i32.const 16))))
      (let $vo i32 (call $obj_new (i32.const 8)))
      (if (call $is_object (local.get $vproto)) (then (i32.store (local.get $vo) (call $val_payload (local.get $vproto)))))
      (call $scope_define (local.get $vo) (cstring "message") (call $mk_str (local.get $msg)))
      (return (call $mk_obj (local.get $vo)))))
  (if (i32.load (local.get $fn)) (then (return (call $mk_str (local.get $msg)))))  ;; native: skip
  (let $proto i64 (call $fn_get_prototype (local.get $fn)))
  (let $o i32 (call $obj_new (i32.const 8)))
  (i32.store (local.get $o) (call $val_payload (local.get $proto)))
  (let $argv i32 (call $heap_alloc (i32.const 8)))
  (i64.store (local.get $argv) (call $mk_str (local.get $msg)))
  (drop (call $call_user (local.get $fn) (i32.const 1) (local.get $argv) (call $mk_obj (local.get $o))))
  (call $mk_obj (local.get $o)))

;; throw a typed error (ReferenceError / TypeError / ...)
(func $throw_type (param $typecstr i32) (param $msg i32) (effects)
  (if (i32.and (i32.eqz (call $err)) (i32.eqz (call $suppress)))
    (then (call $set_err (i32.const 1)) (call $set_err_val (call $make_error (local.get $typecstr) (local.get $msg))))))

(func $cur (result i32) (effects) (call $tok_kind))
(func $advance (effects) (call $next_token))
(func $eat (param $k i32) (result i32) (effects)  ;; if cur==k, advance & return 1
  (if i32 (i32.eq (call $cur) (local.get $k))
    (then (call $advance) (i32.const 1)) (else (i32.const 0))))
(func $expect (param $k i32) (param $msg i32) (effects)
  (if (i32.eqz (call $eat (local.get $k))) (then (call $throw (local.get $msg)))))

;; ── operator helpers ──

(func $str_cmp (param $a i32) (param $b i32) (result i32) (effects)  ;; -1/0/1
  (let $la i32 (call $str_len (local.get $a)))
  (let $lb i32 (call $str_len (local.get $b)))
  (let $n i32 (if i32 (i32.lt_s (local.get $la) (local.get $lb)) (then (local.get $la)) (else (local.get $lb))))
  (let $i i32 (i32.const 0))
  (let $res i32 (i32.const 0))
  (block $brk (loop $cont
    (br_if $brk (i32.ge_s (local.get $i) (local.get $n)))
    (let $ca i32 (call $str_byte (local.get $a) (local.get $i)))
    (let $cb i32 (call $str_byte (local.get $b) (local.get $i)))
    (if (i32.lt_s (local.get $ca) (local.get $cb)) (then (set! $res (i32.const -1)) (br $brk)))
    (if (i32.gt_s (local.get $ca) (local.get $cb)) (then (set! $res (i32.const 1)) (br $brk)))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $cont)))
  (if i32 (local.get $res) (then (local.get $res))
    (else (if i32 (i32.lt_s (local.get $la) (local.get $lb)) (then (i32.const -1))
          (else (if i32 (i32.gt_s (local.get $la) (local.get $lb)) (then (i32.const 1)) (else (i32.const 0))))))))

;; ToInt32 (spec §7.1.5): NaN/Inf -> 0; else truncate toward zero mod 2^32, signed.
(func $to_int32 (param $v i64) (result i32) (effects)
  (let $d f64 (call $to_num (local.get $v)))
  (if (f64.ne (local.get $d) (local.get $d)) (then (return (i32.const 0))))  ;; NaN
  (if (i32.or (f64.eq (local.get $d) (f64.div (f64.const 1) (f64.const 0)))
                  (f64.eq (local.get $d) (f64.div (f64.const -1) (f64.const 0)))) (then (return (i32.const 0))))
  (set! $d (f64.trunc (local.get $d)))
  ;; reduce into [0, 2^32)
  (let $m f64 (f64.sub (local.get $d) (f64.mul (f64.floor (f64.div (local.get $d) (f64.const 4294967296))) (f64.const 4294967296))))
  (if (f64.ge (local.get $m) (f64.const 2147483648)) (then (set! $m (f64.sub (local.get $m) (f64.const 4294967296)))))
  (i32.trunc_f64_s (local.get $m)))

(func $js_add (param $a i64) (param $b i64) (result i64) (effects)
  (if i64 (i32.or (call $is_string (local.get $a)) (call $is_string (local.get $b)))
    (then (call $mk_str (call $str_concat (call $to_str (local.get $a)) (call $to_str (local.get $b)))))
    (else (call $num (f64.add (call $to_num (local.get $a)) (call $to_num (local.get $b)))))))

(func $strict_eq (param $a i64) (param $b i64) (result i32) (effects)
  (if i32 (call $is_number (local.get $a))
    (then (if i32 (call $is_number (local.get $b))
            (then (f64.eq (call $tonum_raw (local.get $a)) (call $tonum_raw (local.get $b))))
            (else (i32.const 0))))
    (else (if i32 (call $is_number (local.get $b))
            (then (i32.const 0))
            (else
              (if i32 (i32.and (call $is_string (local.get $a)) (call $is_string (local.get $b)))
                (then (call $str_eq (call $val_payload (local.get $a)) (call $val_payload (local.get $b))))
                (else (if i32 (i32.ne (call $is_string (local.get $a)) (call $is_string (local.get $b)))
                        (then (i32.const 0))
                        (else (i64.eq (local.get $a) (local.get $b)))))))))))

;; index of $key in array $keys by strict-equality, or -1 (for Map/Set)
(func $map_find (param $keys i32) (param $key i64) (result i32) (effects)
  (let $n i32 (call $arr_len (local.get $keys)))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    (if (call $strict_eq (call $arr_get (local.get $keys) (local.get $i)) (local.get $key)) (then (return (local.get $i))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (i32.const -1))

;; internal-array accessor for Map/Set: payload of object's hidden prop
(func $coll_arr (param $obj i64) (param $name i32) (result i32) (effects)
  (call $val_payload (call $get_prop (local.get $obj) (call $mk_str (local.get $name)))))

(func $loose_eq (param $a i64) (param $b i64) (result i32) (effects)
  (if i32 (call $strict_eq (local.get $a) (local.get $b)) (then (i32.const 1))
  (else
    (let $an i32 (i32.or (call $is_null (local.get $a)) (call $is_undefined (local.get $a))))
    (let $bn i32 (i32.or (call $is_null (local.get $b)) (call $is_undefined (local.get $b))))
    (if i32 (i32.or (local.get $an) (local.get $bn))
      (then (i32.and (local.get $an) (local.get $bn)))
      (else
        ;; number/string/bool primitives → compare as numbers
        (let $ap i32 (i32.or (call $is_number (local.get $a)) (i32.or (call $is_string (local.get $a)) (call $is_boolean (local.get $a)))))
        (let $bp i32 (i32.or (call $is_number (local.get $b)) (i32.or (call $is_string (local.get $b)) (call $is_boolean (local.get $b)))))
        (if i32 (i32.and (local.get $ap) (local.get $bp))
          (then (f64.eq (call $to_num (local.get $a)) (call $to_num (local.get $b))))
          (else (i32.const 0))))))))

;; relational compare: kind 29 < , 30 > , 31 <= , 32 >=
(func $relate (param $a i64) (param $b i64) (param $kind i32) (result i64) (effects)
  (if i64 (i32.and (call $is_string (local.get $a)) (call $is_string (local.get $b)))
    (then
      (let $c i32 (call $str_cmp (call $val_payload (local.get $a)) (call $val_payload (local.get $b))))
      (call $mk_bool
        (if i32 (i32.eq (local.get $kind) (i32.const 29)) (then (i32.lt_s (local.get $c) (i32.const 0)))
        (else (if i32 (i32.eq (local.get $kind) (i32.const 30)) (then (i32.gt_s (local.get $c) (i32.const 0)))
        (else (if i32 (i32.eq (local.get $kind) (i32.const 31)) (then (i32.le_s (local.get $c) (i32.const 0)))
        (else (i32.ge_s (local.get $c) (i32.const 0))))))))))
    (else
      (let $x f64 (call $to_num (local.get $a)))
      (let $y f64 (call $to_num (local.get $b)))
      (call $mk_bool
        (if i32 (i32.eq (local.get $kind) (i32.const 29)) (then (f64.lt (local.get $x) (local.get $y)))
        (else (if i32 (i32.eq (local.get $kind) (i32.const 30)) (then (f64.gt (local.get $x) (local.get $y)))
        (else (if i32 (i32.eq (local.get $kind) (i32.const 31)) (then (f64.le (local.get $x) (local.get $y)))
        (else (f64.ge (local.get $x) (local.get $y))))))))))))

;; ── function calls & native builtins ──

(func $argn (param $argv i32) (param $argc i32) (param $i i32) (result i64) (effects)
  (if i64 (i32.lt_s (local.get $i) (local.get $argc))
    (then (i64.load (i32.add (local.get $argv) (i32.mul (local.get $i) (i32.const 8)))))
    (else (call $v_undef))))

;; native dispatch by id (1 = print, 2 = assert)
(func $call_native (param $id i32) (param $argc i32) (param $argv i32) (param $thisv i64) (result i64) (effects)
  (if (i32.eq (local.get $id) (i32.const 1))  ;; print (console.log style)
    (then
      (let $i i32 (i32.const 0))
      (block $e (loop $c
        (br_if $e (i32.ge_s (local.get $i) (local.get $argc)))
        (if (i32.gt_s (local.get $i) (i32.const 0)) (then (call $print_str (cstring " "))))
        (call $print_str (call $to_str (call $argn (local.get $argv) (local.get $argc) (local.get $i))))
        (set! $i (i32.add (local.get $i) (i32.const 1)))
        (br $c)))
      (call $print_str (cstring "\n"))
      (return (call $v_undef))))
  ;; Function.prototype.call(thisArg, ...args) — this = the function
  (if (i32.eq (local.get $id) (i32.const 151))
    (then
      (let $ta i64 (call $argn (local.get $argv) (local.get $argc) (i32.const 0)))
      (let $n i32 (if i32 (i32.gt_s (local.get $argc) (i32.const 0)) (then (i32.sub (local.get $argc) (i32.const 1))) (else (i32.const 0))))
      (let $buf i32 (call $heap_alloc (i32.mul (if i32 (i32.gt_s (local.get $n) (i32.const 0)) (then (local.get $n)) (else (i32.const 1))) (i32.const 8))))
      (let $i i32 (i32.const 0))
      (block $cae (loop $cal
        (br_if $cae (i32.ge_s (local.get $i) (local.get $n)))
        (i64.store (i32.add (local.get $buf) (i32.mul (local.get $i) (i32.const 8))) (call $argn (local.get $argv) (local.get $argc) (i32.add (local.get $i) (i32.const 1))))
        (set! $i (i32.add (local.get $i) (i32.const 1))) (br $cal)))
      (return (call $call_val (local.get $thisv) (local.get $n) (local.get $buf) (local.get $ta)))))
  ;; Function.prototype.apply(thisArg, argArray) — this = the function
  (if (i32.eq (local.get $id) (i32.const 152))
    (then
      (let $ta i64 (call $argn (local.get $argv) (local.get $argc) (i32.const 0)))
      (let $aa i64 (call $argn (local.get $argv) (local.get $argc) (i32.const 1)))
      (let $n i32 (i32.const 0))
      (let $buf i32 (call $heap_alloc (i32.const 8)))
      (if (call $is_array (local.get $aa))
        (then
          (let $arr i32 (call $val_payload (local.get $aa)))
          (set! $n (call $arr_len (local.get $arr)))
          (set! $buf (call $heap_alloc (i32.mul (if i32 (i32.gt_s (local.get $n) (i32.const 0)) (then (local.get $n)) (else (i32.const 1))) (i32.const 8))))
          (let $i i32 (i32.const 0))
          (block $aae (loop $aal
            (br_if $aae (i32.ge_s (local.get $i) (local.get $n)))
            (i64.store (i32.add (local.get $buf) (i32.mul (local.get $i) (i32.const 8))) (call $arr_get (local.get $arr) (local.get $i)))
            (set! $i (i32.add (local.get $i) (i32.const 1))) (br $aal)))))
      (return (call $call_val (local.get $thisv) (local.get $n) (local.get $buf) (local.get $ta)))))
  (if (i32.eq (local.get $id) (i32.const 2))  ;; assert(cond[, message])
    (then
      (let $cond i64 (call $argn (local.get $argv) (local.get $argc) (i32.const 0)))
      (if (i32.eqz (call $truthy (local.get $cond)))
        (then
          (let $m i32
            (if i32 (i32.ge_s (local.get $argc) (i32.const 2))
              (then (call $str_concat (cstring "assert failed: ")
                          (call $to_str (call $argn (local.get $argv) (local.get $argc) (i32.const 1)))))
              (else (cstring "assert failed"))))
          (call $set_err (i32.const 1)) (call $set_err_val (call $mk_str (local.get $m)))))
      (return (call $v_undef))))
  (if (i32.eq (local.get $id) (i32.const 3))  ;; eval(src)
    (then
      (let $a i64 (call $argn (local.get $argv) (local.get $argc) (i32.const 0)))
      (if (call $is_string (local.get $a))
        (then (return (call $eval_string (call $val_payload (local.get $a))))))
      (return (local.get $a))))
  (if (i32.eq (local.get $id) (i32.const 4))  ;; Number(x)
    (then
      (if (i32.eqz (local.get $argc)) (then (return (call $num (f64.const 0)))))
      (return (call $num (call $to_num (call $argn (local.get $argv) (local.get $argc) (i32.const 0)))))))
  (if (i32.eq (local.get $id) (i32.const 5))  ;; String(x)
    (then
      (if (i32.eqz (local.get $argc)) (then (return (call $mk_str (cstring "")))))
      (return (call $mk_str (call $to_str (call $argn (local.get $argv) (local.get $argc) (i32.const 0)))))))
  (if (i32.eq (local.get $id) (i32.const 6))  ;; Boolean(x)
    (then (return (call $mk_bool (call $truthy (call $argn (local.get $argv) (local.get $argc) (i32.const 0)))))))
  (if (i32.eq (local.get $id) (i32.const 7))  ;; isNaN(x)
    (then (let $d f64 (call $to_num (call $argn (local.get $argv) (local.get $argc) (i32.const 0))))
          (return (call $mk_bool (f64.ne (local.get $d) (local.get $d))))))
  (if (i32.eq (local.get $id) (i32.const 8))  ;; isFinite(x)
    (then (let $d f64 (call $to_num (call $argn (local.get $argv) (local.get $argc) (i32.const 0))))
          (return (call $mk_bool (i32.and (f64.eq (local.get $d) (local.get $d))
            (i32.and (f64.ne (local.get $d) (f64.div (f64.const 1) (f64.const 0))) (f64.ne (local.get $d) (f64.div (f64.const -1) (f64.const 0)))))))))
  (if (i32.eq (local.get $id) (i32.const 9))  ;; Object(x)
    (then
      (let $a i64 (call $argn (local.get $argv) (local.get $argc) (i32.const 0)))
      (if (i32.and (i32.eqz (call $is_number (local.get $a)))
            (i32.or (call $is_object (local.get $a)) (i32.or (call $is_array (local.get $a)) (call $is_function (local.get $a)))))
        (then (return (local.get $a))))
      (return (call $mk_obj (call $obj_new (i32.const 8))))))
  (if (i32.or (i32.eq (local.get $id) (i32.const 10)) (i32.eq (local.get $id) (i32.const 112)))  ;; Object.keys / getOwnPropertyNames
    (then
      (let $a i64 (call $argn (local.get $argv) (local.get $argc) (i32.const 0)))
      (let $arr i32 (call $arr_new (i32.const 16)))
      (if (call $is_object (local.get $a))
        (then
          (let $sc i32 (call $val_payload (local.get $a)))
          (let $cnt i32 (call $scope_count (local.get $sc)))
          (let $i i32 (i32.const 0))
          (block $ke (loop $kl
            (br_if $ke (i32.ge_s (local.get $i) (local.get $cnt)))
            (call $arr_push (local.get $arr) (call $mk_str (i32.load (call $scope_entry (local.get $sc) (local.get $i)))))
            (set! $i (i32.add (local.get $i) (i32.const 1)))
            (br $kl)))))
      (return (call $mk_arr (local.get $arr)))))
  (if (i32.or (i32.eq (local.get $id) (i32.const 91)) (i32.eq (local.get $id) (i32.const 92)))  ;; Object.values/entries
    (then
      (let $a i64 (call $argn (local.get $argv) (local.get $argc) (i32.const 0)))
      (let $arr i32 (call $arr_new (i32.const 16)))
      (if (call $is_object (local.get $a))
        (then
          (let $sc i32 (call $val_payload (local.get $a)))
          (let $cnt i32 (call $scope_count (local.get $sc)))
          (let $i i32 (i32.const 0))
          (block $ke (loop $kl
            (br_if $ke (i32.ge_s (local.get $i) (local.get $cnt)))
            (let $nm i32 (i32.load (call $scope_entry (local.get $sc) (local.get $i))))
            (let $vv i64 (call $get_prop (local.get $a) (call $mk_str (local.get $nm))))
            (if (i32.eq (local.get $id) (i32.const 91))
              (then (call $arr_push (local.get $arr) (local.get $vv)))
              (else  ;; entries → [key, value]
                (let $pair i32 (call $arr_new (i32.const 2)))
                (call $arr_push (local.get $pair) (call $mk_str (local.get $nm)))
                (call $arr_push (local.get $pair) (local.get $vv))
                (call $arr_push (local.get $arr) (call $mk_arr (local.get $pair)))))
            (set! $i (i32.add (local.get $i) (i32.const 1)))
            (br $kl)))))
      (return (call $mk_arr (local.get $arr)))))
  (if (i32.eq (local.get $id) (i32.const 109))  ;; str.replaceAll(search, repl)
    (then
      (let $rals i32 (call $to_str (local.get $thisv)))
      (let $rasearch i32 (call $to_str (call $argn (local.get $argv) (local.get $argc) (i32.const 0))))
      (let $rarepl i32 (call $to_str (call $argn (local.get $argv) (local.get $argc) (i32.const 1))))
      (if (i32.eqz (call $str_len (local.get $rasearch))) (then (return (call $mk_str (local.get $rals)))))
      (let $raparts i32 (call $str_split (local.get $rals) (local.get $rasearch)))
      (let $raout i32 (cstring ""))
      (let $rai i32 (i32.const 0))
      (block $rae (loop $ral
        (br_if $rae (i32.ge_s (local.get $rai) (call $arr_len (local.get $raparts))))
        (if (i32.gt_s (local.get $rai) (i32.const 0)) (then (set! $raout (call $str_concat (local.get $raout) (local.get $rarepl)))))
        (set! $raout (call $str_concat (local.get $raout) (call $val_payload (call $arr_get (local.get $raparts) (local.get $rai)))))
        (set! $rai (i32.add (local.get $rai) (i32.const 1)))
        (br $ral)))
      (return (call $mk_str (local.get $raout)))))
  (if (i32.eq (local.get $id) (i32.const 110))  ;; Array.of(...args)
    (then
      (let $ofa i32 (call $arr_new (i32.const 4)))
      (let $ofi i32 (i32.const 0))
      (block $ofe (loop $ofl
        (br_if $ofe (i32.ge_s (local.get $ofi) (local.get $argc)))
        (call $arr_push (local.get $ofa) (call $argn (local.get $argv) (local.get $argc) (local.get $ofi)))
        (set! $ofi (i32.add (local.get $ofi) (i32.const 1)))
        (br $ofl)))
      (return (call $mk_arr (local.get $ofa)))))
