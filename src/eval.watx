      (let $aa i64 (call $argn (local.get $argv) (local.get $argc) (i32.const 1)))
      (let $n i32 (i32.const 0))
      (let $buf i32 (call $heap_alloc (i32.const 8)))
      (if (call $is_array (local.get $aa))
        (then
          (let $arr i32 (call $val_payload (local.get $aa)))
          (set! $n (call $arr_len (local.get $arr)))
          (set! $buf (call $heap_alloc (i32.mul (if i32 (i32.gt_s (local.get $n) (i32.const 0)) (then (local.get $n)) (else (i32.const 1))) (i32.const 8))))
          (let $i i32 (i32.const 0))
          (block $aae (loop $aal
            (br_if $aae (i32.ge_s (local.get $i) (local.get $n)))
            (i64.store (i32.add (local.get $buf) (i32.mul (local.get $i) (i32.const 8))) (call $arr_get (local.get $arr) (local.get $i)))
            (set! $i (i32.add (local.get $i) (i32.const 1))) (br $aal)))))
