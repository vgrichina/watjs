        (if i64 (local.get $gs) (then (i64.load (local.get $gs))) (else (if i64 (local.get $oldAcc) (then (i64.load (call $val_payload (i64.load (local.get $old))))) (else (call $v_undef)))))
        (if i64 (local.get $ss) (then (i64.load (local.get $ss))) (else (if i64 (local.get $oldAcc) (then (i64.load (i32.add (call $val_payload (i64.load (local.get $old))) (i32.const 8)))) (else (call $v_undef)))))
        (local.get $attrs)))
