    (i64.store (i32.add (local.get $dckb) (i32.const 8)) (local.get $tk))
    (let $dck i64 (call $call_native (i32.const 156) (i32.const 2) (local.get $dckb) (call $v_undef)))
    (if (call $err) (then (return (call $arr_new (i32.const 1)))))
    (let $ncfg i32 (i32.and (i32.eqz (call $is_undefined (local.get $dck))) (i32.eqz (call $truthy (call $get_prop (local.get $dck) (call $mk_str (cstring "configurable")))))))
    (if (i32.and (local.get $ncfg) (i32.eqz (local.get $found)))
