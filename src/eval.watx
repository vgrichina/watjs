              (then (call $throw_type (cstring "TypeError") (cstring "Map entry is not an object")) (call $iter_close_throw (local.get $mit)) (return (call $v_undef))))
            (i64.store (local.get $mbuf) (call $get_prop (local.get $mpair) (call $mk_str (cstring "0"))))
            (if (call $err) (then (call $iter_close_throw (local.get $mit)) (return (call $v_undef))))
            (i64.store (i32.add (local.get $mbuf) (i32.const 8)) (call $get_prop (local.get $mpair) (call $mk_str (cstring "1"))))
            (if (call $err) (then (call $iter_close_throw (local.get $mit)) (return (call $v_undef))))
            (drop (call $call_val (local.get $madder) (i32.const 2) (local.get $mbuf) (local.get $mov)))
            (if (call $err) (then (call $iter_close_throw (local.get $mit)) (return (call $v_undef))))
