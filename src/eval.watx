      ;; forEach(fn) (25) / map(fn) (26)
      (if (i32.or (i32.eq (local.get $id) (i32.const 25)) (i32.eq (local.get $id) (i32.const 26)))
        (then
          ;; map builds a result array (ArraySpeciesCreate): a source length beyond
