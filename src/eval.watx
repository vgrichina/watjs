;; x ** y for integer y (repeated multiply); fractional y -> NaN (no transcendentals)
;; ── transcendental math (polynomial approximations + range reduction) ──
;; Accurate enough for special-value/metadata tests and ordinary use; not
;; guaranteed correctly-rounded to the last ULP.

;; e^x. Range-reduce x = k*ln2 + r, e^x = 2^k * e^r, e^r via degree-8 Taylor.
(func $m_exp (param $x f64) (result f64) (effects)
  (if (f64.ne (local.get $x) (local.get $x)) (then (return (local.get $x))))            ;; NaN
  (if (f64.gt (local.get $x) (f64.const 709.782712893384)) (then (return (f64.div (f64.const 1) (f64.const 0)))))   ;; +Inf
  (if (f64.lt (local.get $x) (f64.const -745.1332191019412)) (then (return (f64.const 0))))                          ;; +0
  (let $k f64 (f64.nearest (f64.div (local.get $x) (f64.const 0.6931471805599453))))
  (let $r f64 (f64.sub (local.get $x) (f64.mul (local.get $k) (f64.const 0.6931471805599453))))
  (let $p f64 (f64.const 2.48015873015873e-05))
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $r)) (f64.const 1.984126984126984e-04)))
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $r)) (f64.const 1.388888888888889e-03)))
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $r)) (f64.const 8.333333333333333e-03)))
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $r)) (f64.const 4.1666666666666664e-02)))
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $r)) (f64.const 0.16666666666666666)))
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $r)) (f64.const 0.5)))
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $r)) (f64.const 1)))
  (set! $p (f64.add (f64.mul (local.get $p) (local.get $r)) (f64.const 1)))
  (f64.mul (local.get $p) (call $f64_pow (f64.const 2) (local.get $k))))

;; ln(x). x = m*2^e with m in [1,2); ln(x) = e*ln2 + ln(m) via atanh series.
(func $m_log (param $x f64) (result f64) (effects)
