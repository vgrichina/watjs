  (if (i64.eq (local.get $q) (i64.const 1)) (then (return (call $m_cos_small (local.get $r)))))
  (if (i64.eq (local.get $q) (i64.const 2)) (then (return (f64.neg (call $m_sin_small (local.get $r))))))
