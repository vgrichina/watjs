      (let $n i32 (if i32 (i32.gt_s (local.get $argc) (i32.const 0)) (then (i32.sub (local.get $argc) (i32.const 1))) (else (i32.const 0))))
      (let $buf i32 (call $heap_alloc (i32.mul (if i32 (i32.gt_s (local.get $n) (i32.const 0)) (then (local.get $n)) (else (i32.const 1))) (i32.const 8))))
      (let $i i32 (i32.const 0))
      (block $cae (loop $cal
        (br_if $cae (i32.ge_s (local.get $i) (local.get $n)))
        (i64.store (i32.add (local.get $buf) (i32.mul (local.get $i) (i32.const 8))) (call $argn (local.get $argv) (local.get $argc) (i32.add (local.get $i) (i32.const 1))))
        (set! $i (i32.add (local.get $i) (i32.const 1))) (br $cal)))
