;; ═══════════════════════════════════════════════════════════════
;; eval.watx — Pratt / precedence-climbing parser+evaluator
;;
;; Phase 0: expressions only (no variables yet). Parse-and-evaluate:
;; each parse_* consumes tokens via $next_token and returns a JSValue.
;; Short-circuit (&& || ?:) uses a SUPPRESS flag (register 56): when set,
;; side-effecting builtins (print) are skipped while tokens are still
;; consumed, so the untaken branch parses but produces no output.
;;
;; On error: $throw sets ERR + ERR_VAL and parse_* funcs unwind by
;; returning undefined (callers check $err()).
;; ═══════════════════════════════════════════════════════════════

(func $suppress (result i32) (effects) (i32.load (i32.const 56)))
(func $set_suppress (param $v i32) (effects) (i32.store (i32.const 56) (local.get $v)))

(func $throw (param $msg i32) (effects)
  ;; no-op while suppressed (we're skip-scanning, not executing)
  (if (i32.and (i32.eqz (call $err)) (i32.eqz (call $suppress)))
    (then (call $set_err (i32.const 1)) (call $set_err_val (call $mk_str (local.get $msg))))))

;; construct an error object of the named type (looked up in the global scope)
;; with the given message Str; falls back to a plain string if the type is absent.
(func $make_error (param $typecstr i32) (param $msg i32) (result i64) (effects)
  (let $slot i32 (call $scope_find (i32.load (i32.const 152)) (local.get $typecstr)))
  (if (i32.eqz (local.get $slot)) (then (return (call $mk_str (local.get $msg)))))
  (let $fnval i64 (i64.load (local.get $slot)))
  (if (i32.eqz (call $is_function (local.get $fnval))) (then (return (call $mk_str (local.get $msg)))))
  (let $fn i32 (call $val_payload (local.get $fnval)))
  ;; VM-function constructor (running under the bytecode VM): build the instance
  ;; directly — link to its @16 prototype and set .message (mirrors the ctor body).
  (if (i32.and (i32.ge_s (i32.load (local.get $fn)) (i32.const 1448232526)) (i32.le_s (i32.load (local.get $fn)) (i32.const 1448232528)))
    (then
      (let $vproto i64 (i64.load (i32.add (local.get $fn) (i32.const 16))))
      (let $vo i32 (call $obj_new (i32.const 8)))
      (if (call $is_object (local.get $vproto)) (then (i32.store (local.get $vo) (call $val_payload (local.get $vproto)))))
      (call $scope_define_attr (local.get $vo) (cstring "message") (call $mk_str (local.get $msg)) (i32.const 12))  ;; {W:true,E:false,C:true}
      (return (call $mk_obj (local.get $vo)))))
  (if (i32.load (local.get $fn)) (then (return (call $mk_str (local.get $msg)))))  ;; native: skip
  ;; @0==0 (production user-fn constructor) no longer exists in the single-engine build
  (call $mk_str (local.get $msg)))

;; throw a typed error (ReferenceError / TypeError / ...)
(func $throw_type (param $typecstr i32) (param $msg i32) (effects)
  (if (i32.and (i32.eqz (call $err)) (i32.eqz (call $suppress)))
    (then (call $set_err (i32.const 1)) (call $set_err_val (call $make_error (local.get $typecstr) (local.get $msg))))))

(func $cur (result i32) (effects) (call $tok_kind))
(func $advance (effects) (call $next_token))
(func $eat (param $k i32) (result i32) (effects)  ;; if cur==k, advance & return 1
  (if i32 (i32.eq (call $cur) (local.get $k))
    (then (call $advance) (i32.const 1)) (else (i32.const 0))))
(func $expect (param $k i32) (param $msg i32) (effects)
  (if (i32.eqz (call $eat (local.get $k))) (then (call $throw (local.get $msg)))))

;; ── operator helpers ──

(func $str_cmp (param $a i32) (param $b i32) (result i32) (effects)  ;; -1/0/1
  (let $la i32 (call $str_len (local.get $a)))
  (let $lb i32 (call $str_len (local.get $b)))
  (let $n i32 (if i32 (i32.lt_s (local.get $la) (local.get $lb)) (then (local.get $la)) (else (local.get $lb))))
  (let $i i32 (i32.const 0))
  (let $res i32 (i32.const 0))
  (block $brk (loop $cont
    (br_if $brk (i32.ge_s (local.get $i) (local.get $n)))
    (let $ca i32 (call $str_byte (local.get $a) (local.get $i)))
    (let $cb i32 (call $str_byte (local.get $b) (local.get $i)))
    (if (i32.lt_s (local.get $ca) (local.get $cb)) (then (set! $res (i32.const -1)) (br $brk)))
    (if (i32.gt_s (local.get $ca) (local.get $cb)) (then (set! $res (i32.const 1)) (br $brk)))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $cont)))
  (if i32 (local.get $res) (then (local.get $res))
    (else (if i32 (i32.lt_s (local.get $la) (local.get $lb)) (then (i32.const -1))
          (else (if i32 (i32.gt_s (local.get $la) (local.get $lb)) (then (i32.const 1)) (else (i32.const 0))))))))

;; ToInt32 (spec §7.1.5): NaN/Inf -> 0; else truncate toward zero mod 2^32, signed.
(func $to_int32 (param $v i64) (result i32) (effects)
  (let $d f64 (call $to_num (local.get $v)))
  (if (f64.ne (local.get $d) (local.get $d)) (then (return (i32.const 0))))  ;; NaN
  (if (i32.or (f64.eq (local.get $d) (f64.div (f64.const 1) (f64.const 0)))
                  (f64.eq (local.get $d) (f64.div (f64.const -1) (f64.const 0)))) (then (return (i32.const 0))))
  (set! $d (f64.trunc (local.get $d)))
  ;; reduce into [0, 2^32)
  (let $m f64 (f64.sub (local.get $d) (f64.mul (f64.floor (f64.div (local.get $d) (f64.const 4294967296))) (f64.const 4294967296))))
  (if (f64.ge (local.get $m) (f64.const 2147483648)) (then (set! $m (f64.sub (local.get $m) (f64.const 4294967296)))))
  (i32.trunc_f64_s (local.get $m)))

(func $js_add (param $a i64) (param $b i64) (result i64) (effects)
  ;; ToPrimitive(default) both operands first (spec 13.15.3): an object/wrapper/
  ;; Date operand may resolve to a string, which then forces string concatenation.
  (let $pa i64 (call $to_primitive (local.get $a)))
  (if (call $err) (then (return (call $v_undef))))
  (let $pb i64 (call $to_primitive (local.get $b)))
  (if (call $err) (then (return (call $v_undef))))
  (if i64 (i32.or (call $is_string (local.get $pa)) (call $is_string (local.get $pb)))
    (then
      ;; string concatenation uses abstract ToString, which throws on a Symbol
      ;; (unlike the explicit String(sym) builtin, which stays lenient).
      (if (i32.or (call $is_symbol (local.get $pa)) (call $is_symbol (local.get $pb)))
        (then (call $throw_type (cstring "TypeError") (cstring "Cannot convert a Symbol value to a string")) (return (call $v_undef))))
      (call $mk_str (call $str_concat (call $to_str (local.get $pa)) (call $to_str (local.get $pb)))))
    (else
      (if i64 (i32.or (call $is_bigint (local.get $pa)) (call $is_bigint (local.get $pb)))
        (then
          (if (i32.and (call $is_bigint (local.get $pa)) (call $is_bigint (local.get $pb)))
            (then (return (call $mk_bigint (i64.add (call $bigint_val (local.get $pa)) (call $bigint_val (local.get $pb)))))))
          (call $throw_type (cstring "TypeError") (cstring "Cannot mix BigInt and other types, use explicit conversions"))
          (return (call $v_undef)))
        (else (call $num (f64.add (call $to_num (local.get $pa)) (call $to_num (local.get $pb)))))))))

;; define a frozen constant ({writable:false, enumerable:false, configurable:false})
;; on a function (e.g. Number.EPSILON) or an object (e.g. Math.PI).
(func $def_const (param $ov i64) (param $name i32) (param $val i64) (effects)
  (if (call $is_function (local.get $ov))
    (then (call $scope_define_attr (call $fn_props (call $val_payload (local.get $ov))) (local.get $name) (local.get $val) (i32.const 0)))
    (else (call $scope_define_attr (call $val_payload (local.get $ov)) (local.get $name) (local.get $val) (i32.const 0)))))

;; the number value for a Number.prototype method `this`: a number, or a Number
;; wrapper's __prim__. TypeError otherwise. Avoids to_num (which would recurse
;; valueOf↔toString for the bare Number.prototype object).
(func $num_this (param $v i64) (result f64) (effects)
  (if (call $is_number (local.get $v)) (then (return (call $tonum_raw (local.get $v)))))
  (if (call $is_object (local.get $v))
    (then
      (let $ps i32 (call $scope_find_local (call $val_payload (local.get $v)) (cstring "__prim__")))
      (if (i32.and (i32.ne (local.get $ps) (i32.const 0)) (call $is_number (i64.load (local.get $ps))))
        (then (return (call $tonum_raw (i64.load (local.get $ps))))))))
  (call $throw_type (cstring "TypeError") (cstring "Number.prototype method called on a non-Number"))
  (f64.const 0))

(func $strict_eq (param $a i64) (param $b i64) (result i32) (effects)
  ;; BigInt: compare by value (distinct boxes for equal values), never === a non-bigint
  (if (call $is_bigint (local.get $a))
    (then (return (i32.and (call $is_bigint (local.get $b)) (i64.eq (call $bigint_val (local.get $a)) (call $bigint_val (local.get $b)))))))
  (if (call $is_bigint (local.get $b)) (then (return (i32.const 0))))
  (if i32 (call $is_number (local.get $a))
    (then (if i32 (call $is_number (local.get $b))
            (then (f64.eq (call $tonum_raw (local.get $a)) (call $tonum_raw (local.get $b))))
            (else (i32.const 0))))
    (else (if i32 (call $is_number (local.get $b))
            (then (i32.const 0))
            (else
              (if i32 (i32.and (call $is_string (local.get $a)) (call $is_string (local.get $b)))
                (then (call $str_eq (call $val_payload (local.get $a)) (call $val_payload (local.get $b))))
                (else (if i32 (i32.ne (call $is_string (local.get $a)) (call $is_string (local.get $b)))
                        (then (i32.const 0))
                        (else (i64.eq (local.get $a) (local.get $b)))))))))))

;; index of $key in array $keys by strict-equality, or -1 (for Map/Set)
(func $map_find (param $keys i32) (param $key i64) (result i32) (effects)
  (let $n i32 (call $arr_len (local.get $keys)))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    ;; Map/Set use SameValueZero: NaN matches NaN (same_value), +0 matches -0
    ;; (strict_eq) — the union of the two is exactly SameValueZero.
    (let $mfk i64 (call $arr_get (local.get $keys) (local.get $i)))
    (if (i32.or (call $strict_eq (local.get $mfk) (local.get $key)) (call $same_value (local.get $mfk) (local.get $key))) (then (return (local.get $i))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (i32.const -1))

;; internal-array accessor for Map/Set: payload of object's hidden prop
(func $coll_arr (param $obj i64) (param $name i32) (result i32) (effects)
  (call $val_payload (call $get_prop (local.get $obj) (call $mk_str (local.get $name)))))

;; GetIteratorDirect(O): O must be an object; returns its (callable) next method.
;; On error sets $err and returns undefined (caller checks $err).
(func $iter_direct_next (param $o i64) (result i64) (effects)
  (if (i32.eqz (call $is_object (local.get $o)))
    (then (call $throw_type (cstring "TypeError") (cstring "Iterator method called on a non-object")) (return (call $v_undef))))
  (let $nf i64 (call $get_prop (local.get $o) (call $mk_str (cstring "next"))))
  (if (call $err) (then (return (call $v_undef))))
  (if (i32.eqz (call $is_function (local.get $nf)))
    (then (call $throw_type (cstring "TypeError") (cstring "iterator.next is not a function")) (return (call $v_undef))))
  (local.get $nf))

;; IteratorClose(O): if O has a callable `return`, call it (errors from it surface)
(func $iter_close (param $o i64) (effects)
  (if (call $is_object (local.get $o))
    (then
      (let $rm i64 (call $get_prop (local.get $o) (call $mk_str (cstring "return"))))
      (if (i32.and (i32.eqz (call $err)) (call $is_function (local.get $rm)))
        (then (drop (call $call_val (local.get $rm) (i32.const 0) (call $heap_alloc (i32.const 8)) (local.get $o))))))))

;; IteratorClose during an abrupt completion: call return() but keep the pending
;; error (the original throw wins even if return() also throws).
(func $iter_close_throw (param $o i64) (effects)
  (let $sv i64 (call $err_val))
  (call $set_err (i32.const 0))
  (call $iter_close (local.get $o))
  (call $set_err (i32.const 1))
  (call $set_err_val (local.get $sv)))

;; build a lazy Iterator Helper object (kind: map0 filter1 take2 drop3 flatMap4)
;; WeakRef (358 ctor / 359 deref) + FinalizationRegistry (360 ctor / 361 register /
;; 362 unregister) — strong-ref, cleanup never runs (GC not observable from script)
(func $native_weakref_fr (param $id i32) (param $thisv i64) (param $argv i32) (param $argc i32) (result i64) (effects)
  (if (i32.eq (local.get $id) (i32.const 358))  ;; new WeakRef(target)
    (then
      (let $wrt i64 (call $argn (local.get $argv) (local.get $argc) (i32.const 0)))
      (if (i32.eqz (call $weakly_holdable (local.get $wrt)))
        (then (call $throw_type (cstring "TypeError") (cstring "WeakRef: target cannot be held weakly")) (return (call $v_undef))))
      (let $wro i32 (call $obj_new (i32.const 8)))
      (if (i32.load (i32.const 500)) (then (i32.store (local.get $wro) (i32.load (i32.const 500)))))
      (call $scope_define (local.get $wro) (cstring "@@wrt") (local.get $wrt))
      (return (call $mk_obj (local.get $wro)))))
  (if (i32.eq (local.get $id) (i32.const 359))  ;; WeakRef.prototype.deref()
    (then
      (if (i32.eqz (call $is_object (local.get $thisv)))
        (then (call $throw_type (cstring "TypeError") (cstring "WeakRef.prototype.deref called on incompatible receiver")) (return (call $v_undef))))
      (let $wrsl i32 (call $scope_find_local (call $val_payload (local.get $thisv)) (cstring "@@wrt")))
      (if (i32.eqz (local.get $wrsl))
        (then (call $throw_type (cstring "TypeError") (cstring "WeakRef.prototype.deref called on incompatible receiver")) (return (call $v_undef))))
      (return (i64.load (local.get $wrsl)))))
  (if (i32.eq (local.get $id) (i32.const 360))  ;; new FinalizationRegistry(cleanupCallback)
    (then
      (let $frcb i64 (call $argn (local.get $argv) (local.get $argc) (i32.const 0)))
      (if (i32.eqz (call $is_function (local.get $frcb)))
        (then (call $throw_type (cstring "TypeError") (cstring "FinalizationRegistry: cleanup callback is not callable")) (return (call $v_undef))))
      (let $fro i32 (call $obj_new (i32.const 8)))
      (if (i32.load (i32.const 504)) (then (i32.store (local.get $fro) (i32.load (i32.const 504)))))
      (call $scope_define (local.get $fro) (cstring "@@frcb") (local.get $frcb))
      (call $scope_define (local.get $fro) (cstring "@@frtok") (call $mk_arr (call $arr_new (i32.const 4))))
      (return (call $mk_obj (local.get $fro)))))
  (if (i32.and (i32.ge_s (local.get $id) (i32.const 361)) (i32.le_s (local.get $id) (i32.const 362)))
    (then
      (if (i32.eqz (call $is_object (local.get $thisv)))
        (then (call $throw_type (cstring "TypeError") (cstring "FinalizationRegistry method called on incompatible receiver")) (return (call $v_undef))))
      (if (i32.eqz (call $scope_find_local (call $val_payload (local.get $thisv)) (cstring "@@frcb")))
        (then (call $throw_type (cstring "TypeError") (cstring "FinalizationRegistry method called on incompatible receiver")) (return (call $v_undef))))
      (let $frtok i32 (call $coll_arr (local.get $thisv) (cstring "@@frtok")))
      (if (i32.eq (local.get $id) (i32.const 361))  ;; register(target, heldValue[, unregisterToken])
        (then
          (let $frt i64 (call $argn (local.get $argv) (local.get $argc) (i32.const 0)))
          (let $frh i64 (call $argn (local.get $argv) (local.get $argc) (i32.const 1)))
          (let $frtk i64 (call $argn (local.get $argv) (local.get $argc) (i32.const 2)))
          (if (i32.eqz (call $weakly_holdable (local.get $frt)))
            (then (call $throw_type (cstring "TypeError") (cstring "FinalizationRegistry.register: target cannot be held weakly")) (return (call $v_undef))))
          (if (call $strict_eq (local.get $frt) (local.get $frh))
            (then (call $throw_type (cstring "TypeError") (cstring "FinalizationRegistry.register: target and held value must not be the same")) (return (call $v_undef))))
          (if (i32.and (i32.eqz (call $is_undefined (local.get $frtk))) (i32.eqz (call $weakly_holdable (local.get $frtk))))
            (then (call $throw_type (cstring "TypeError") (cstring "FinalizationRegistry.register: unregister token cannot be held weakly")) (return (call $v_undef))))
          (call $arr_push (local.get $frtok) (local.get $frtk))
          (return (call $v_undef))))
      (if (i32.eq (local.get $id) (i32.const 362))  ;; unregister(unregisterToken)
        (then
          (let $frut i64 (call $argn (local.get $argv) (local.get $argc) (i32.const 0)))
          (if (i32.eqz (call $weakly_holdable (local.get $frut)))
            (then (call $throw_type (cstring "TypeError") (cstring "FinalizationRegistry.unregister: token cannot be held weakly")) (return (call $v_undef))))
          (let $fridx i32 (call $map_find (local.get $frtok) (local.get $frut)))
          (if (i32.lt_s (local.get $fridx) (i32.const 0)) (then (return (call $v_false))))
          (call $arr_remove (local.get $frtok) (local.get $fridx))
          (return (call $v_true))))))
  (call $v_undef))

(func $iter_helper_new (param $src i64) (param $srcnext i64) (param $kind i32) (param $fn i64) (param $n f64) (result i64) (effects)
  (let $h i32 (call $obj_new (i32.const 12)))
  (if (i32.load (i32.const 488)) (then (i32.store (local.get $h) (i32.load (i32.const 488)))))  ;; inherit %Iterator.prototype%
  (call $scope_define (local.get $h) (cstring "@@isrc") (local.get $src))
  (call $scope_define (local.get $h) (cstring "@@isn") (local.get $srcnext))
  (call $scope_define (local.get $h) (cstring "@@ikind") (call $num (f64.convert_i32_s (local.get $kind))))
  (call $scope_define (local.get $h) (cstring "@@ifn") (local.get $fn))
  (call $scope_define (local.get $h) (cstring "@@in") (call $num (local.get $n)))
  (call $scope_define (local.get $h) (cstring "@@ictr") (call $num (f64.const 0)))
  (call $scope_define (local.get $h) (cstring "@@idone") (call $v_false))
  (call $scope_define (local.get $h) (cstring "@@iinner") (call $v_undef))
  (call $scope_define_attr (local.get $h) (cstring "next") (call $mk_native (i32.const 348) (cstring "next")) (i32.const 12))  ;; DontEnum
  (call $scope_define (local.get $h) (cstring "return") (call $mk_native (i32.const 354) (cstring "return")))
  (call $mk_obj (local.get $h)))

;; CanBeHeldWeakly: objects, functions, arrays, and symbols may be weak keys
(func $weakly_holdable (param $v i64) (result i32) (effects)
  ;; a REGISTERED symbol (Symbol.for, key "@@symfor:…") cannot be held weakly
  (if (call $is_symbol (local.get $v))
    (then (return (i32.ne (call $str_indexof (call $sym_key (local.get $v)) (cstring "@@symfor:")) (i32.const 0)))))
  (i32.or (call $is_object (local.get $v))
    (i32.or (call $is_function (local.get $v)) (call $is_array (local.get $v)))))

;; ── helpers for the ES2024 Set methods (union/intersection/…) ──
;; one-argument method call (caller must check $err afterwards)
(func $call1 (param $fn i64) (param $thisv i64) (param $a0 i64) (result i64) (effects)
  (let $b i32 (call $heap_alloc (i32.const 8)))
  (i64.store (local.get $b) (local.get $a0))
  (call $call_val (local.get $fn) (i32.const 1) (local.get $b) (local.get $thisv)))

;; normalize -0 → +0 (CanonicalizeKeyedCollectionKey)
(func $norm_zero (param $v i64) (result i64) (effects)
  (if (call $is_number (local.get $v))
    (then
      (let $d f64 (call $to_num (local.get $v)))
      (if (i32.and (f64.eq (local.get $d) (f64.const 0))
                   (f64.eq (f64.div (f64.const 1) (local.get $d)) (f64.div (f64.const -1) (f64.const 0))))
        (then (return (call $num (f64.const 0)))))))
  (local.get $v))

;; push v into set-data array `sk` only if absent (SameValueZero via map_find)
(func $set_add1 (param $sk i32) (param $v i64) (effects)
  (if (i32.lt_s (call $map_find (local.get $sk) (local.get $v)) (i32.const 0))
    (then (call $arr_push (local.get $sk) (local.get $v)))))

;; GetSetRecord(other): validate set-like; store has@464 keys@472 size@456 (i32, Inf→MAX).
;; returns 1 on success; 0 on error (with $err set).
(func $gsr (param $other i64) (result i32) (effects)
  (if (i32.eqz (i32.or (call $is_object (local.get $other)) (i32.or (call $is_array (local.get $other)) (i32.or (call $is_function (local.get $other)) (call $is_proxy (local.get $other))))))  ;; any Object qualifies (arrays/functions/proxies too)
    (then (call $throw_type (cstring "TypeError") (cstring "Set-like argument must be an object")) (return (i32.const 0))))
  (let $d f64 (call $to_num (call $get_prop (local.get $other) (call $mk_str (cstring "size")))))
  (if (call $err) (then (return (i32.const 0))))
  (if (f64.ne (local.get $d) (local.get $d))  ;; NaN (covers undefined size)
    (then (call $throw_type (cstring "TypeError") (cstring "Set-like size is NaN")) (return (i32.const 0))))
  (let $ti f64 (f64.trunc (local.get $d)))
  (if (f64.lt (local.get $ti) (f64.const 0))
    (then (call $throw_type (cstring "RangeError") (cstring "Set-like size is negative")) (return (i32.const 0))))
  (if (f64.ge (local.get $ti) (f64.const 2147483647))
