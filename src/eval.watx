  (if (f64.ne (local.get $x) (local.get $x)) (then (return (f64.div (f64.const 0) (f64.const 0)))))
  ;; non-integer or out-of-range exponent: no transcendentals here — handle a few
  ;; limits, else NaN. Critically, never i32.trunc an Inf/huge value (it traps).
