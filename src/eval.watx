  (set! $p (f64.sub (f64.const 0.09090909090909091) (f64.mul (local.get $p) (local.get $a2))))  ;; 1/11
  (set! $p (f64.sub (f64.const 0.1111111111111111) (f64.mul (local.get $p) (local.get $a2))))   ;; 1/9
  (set! $p (f64.sub (f64.const 0.14285714285714285) (f64.mul (local.get $p) (local.get $a2))))  ;; 1/7
  (set! $p (f64.sub (f64.const 0.2) (f64.mul (local.get $p) (local.get $a2))))                   ;; 1/5
