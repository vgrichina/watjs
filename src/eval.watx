          (if (f64.gt (local.get $slf) (f64.const 4294967295))
            (then
              (let $sStart f64 (call $to_num (local.get $a0)))
              (if (f64.ne (local.get $sStart) (local.get $sStart)) (then (set! $sStart (f64.const 0))) (else (set! $sStart (f64.floor (local.get $sStart)))))
              (if (f64.lt (local.get $sStart) (f64.const 0))
                (then (set! $sStart (f64.add (local.get $slf) (local.get $sStart))) (if (f64.lt (local.get $sStart) (f64.const 0)) (then (set! $sStart (f64.const 0)))))
                (else (if (f64.gt (local.get $sStart) (local.get $slf)) (then (set! $sStart (local.get $slf))))))
              (let $sEnd f64 (local.get $slf))
              (if (i32.ge_s (local.get $argc) (i32.const 2))
                (then (set! $sEnd (call $to_num (call $argn (local.get $argv) (local.get $argc) (i32.const 1))))
                  (if (f64.ne (local.get $sEnd) (local.get $sEnd)) (then (set! $sEnd (f64.const 0))) (else (set! $sEnd (f64.floor (local.get $sEnd)))))
                  (if (f64.lt (local.get $sEnd) (f64.const 0))
                    (then (set! $sEnd (f64.add (local.get $slf) (local.get $sEnd))) (if (f64.lt (local.get $sEnd) (f64.const 0)) (then (set! $sEnd (f64.const 0)))))
                    (else (if (f64.gt (local.get $sEnd) (local.get $slf)) (then (set! $sEnd (local.get $slf))))))))
              (if (f64.gt (f64.sub (local.get $sEnd) (local.get $sStart)) (f64.const 4294967295))
                (then (call $throw_type (cstring "RangeError") (cstring "Invalid array length")) (return (call $v_undef))))))
          (let $start i32 (call $to_int_idx (call $to_num (local.get $a0))))
          (let $end i32 (local.get $n))
          (if (i32.and (i32.ge_s (local.get $argc) (i32.const 2)) (i32.eqz (call $is_undefined (call $argn (local.get $argv) (local.get $argc) (i32.const 1)))))  ;; undefined end → length
            (then (set! $end (call $to_int_idx (call $to_num (call $argn (local.get $argv) (local.get $argc) (i32.const 1)))))))
          (if (i32.lt_s (local.get $start) (i32.const 0)) (then (set! $start (i32.add (local.get $n) (local.get $start)))))
          (if (i32.lt_s (local.get $end) (i32.const 0)) (then (set! $end (i32.add (local.get $n) (local.get $end)))))
          (if (i32.lt_s (local.get $start) (i32.const 0)) (then (set! $start (i32.const 0))))
          (if (i32.gt_s (local.get $end) (local.get $n)) (then (set! $end (local.get $n))))
          (let $scount i32 (i32.sub (local.get $end) (local.get $start)))
          (if (i32.lt_s (local.get $scount) (i32.const 0)) (then (set! $scount (i32.const 0))))
          (let $rA i64 (call $array_species_create (local.get $thisv) (local.get $scount)))
          (if (call $err) (then (return (call $v_undef))))
          (let $sn i32 (i32.const 0))
          (let $i i32 (local.get $start))
          (block $ce (loop $cl
            (br_if $ce (i32.ge_s (local.get $i) (local.get $end)))
            (if (call $arr_has (local.get $arr) (local.get $i))  ;; HasProperty → CreateDataPropertyOrThrow; holes stay absent
              (then (call $cdp_throw (local.get $rA) (local.get $sn) (call $arr_get (local.get $arr) (local.get $i)))
                    (if (call $err) (then (return (call $v_undef))))))
            (set! $sn (i32.add (local.get $sn) (i32.const 1)))
