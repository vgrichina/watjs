;; ═══════════════════════════════════════════════════════════════
;; json.watx — JSON.stringify (recursive serializer).
;; JSON.parse is implemented in eval.watx by re-evaluating "(" + text + ")".
;; ═══════════════════════════════════════════════════════════════

;; lowercase hex digit for a nibble 0..15
(func $json_hexd (param $d i32) (result i32) (effects)
  (if i32 (i32.lt_s (local.get $d) (i32.const 10))
    (then (i32.add (local.get $d) (i32.const 48)))
    (else (i32.add (local.get $d) (i32.const 87)))))

;; quote a string with JSON escaping → heap Str including the surrounding quotes
(func $json_quote (param $s i32) (result i32) (effects)
  (let $n i32 (call $str_len (local.get $s)))
  (let $out i32 (cstring "\""))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    (let $c i32 (call $str_byte (local.get $s) (local.get $i)))
    (let $esc i32 (i32.const 0))  ;; escape sequence Str, or 0 = none
    (if (i32.eq (local.get $c) (i32.const 34)) (then (set! $esc (cstring "\\\""))))
    (if (i32.eq (local.get $c) (i32.const 92)) (then (set! $esc (cstring "\\\\"))))
    (if (i32.eq (local.get $c) (i32.const 8))  (then (set! $esc (cstring "\\b"))))
    (if (i32.eq (local.get $c) (i32.const 12)) (then (set! $esc (cstring "\\f"))))
    (if (i32.eq (local.get $c) (i32.const 10)) (then (set! $esc (cstring "\\n"))))
    (if (i32.eq (local.get $c) (i32.const 9))  (then (set! $esc (cstring "\\t"))))
    (if (i32.eq (local.get $c) (i32.const 13)) (then (set! $esc (cstring "\\r"))))
    ;; other control chars < 0x20 → \u00XX (lowercase hex)
    (if (i32.and (i32.eqz (local.get $esc)) (i32.lt_s (local.get $c) (i32.const 32)))
      (then
        (let $u i32 (call $str_alloc (i32.const 6)))
        (call $str_set_byte (local.get $u) (i32.const 0) (i32.const 92))
        (call $str_set_byte (local.get $u) (i32.const 1) (i32.const 117))
        (call $str_set_byte (local.get $u) (i32.const 2) (i32.const 48))
        (call $str_set_byte (local.get $u) (i32.const 3) (i32.const 48))
        (call $str_set_byte (local.get $u) (i32.const 4) (call $json_hexd (i32.and (i32.shr_u (local.get $c) (i32.const 4)) (i32.const 15))))
        (call $str_set_byte (local.get $u) (i32.const 5) (call $json_hexd (i32.and (local.get $c) (i32.const 15))))
        (set! $esc (local.get $u))))
    (if (local.get $esc)
      (then (set! $out (call $str_concat (local.get $out) (local.get $esc))))
      (else
        (let $ch i32 (call $str_alloc (i32.const 1)))
        (call $str_set_byte (local.get $ch) (i32.const 0) (local.get $c))
        (set! $out (call $str_concat (local.get $out) (local.get $ch)))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (call $str_concat (local.get $out) (cstring "\"")))

;; serialize value → heap Str ptr, or 0 for undefined/function (skip / "null").
(func $json_str (param $v i64) (result i32) (effects)
  (if (call $is_number (local.get $v))
    (then
      (let $d f64 (call $tonum_raw (local.get $v)))
      (if i32 (i32.and (f64.eq (local.get $d) (local.get $d)) (i32.and (f64.ne (local.get $d) (f64.div (f64.const 1) (f64.const 0))) (f64.ne (local.get $d) (f64.div (f64.const -1) (f64.const 0)))))
        (then (return (call $num_to_str (local.get $d))))
        (else (return (cstring "null"))))))
  (if (call $is_boolean (local.get $v)) (then (return (if i32 (call $val_payload (local.get $v)) (then (cstring "true")) (else (cstring "false"))))))
  (if (call $is_null (local.get $v)) (then (return (cstring "null"))))
  (if (call $is_string (local.get $v)) (then (return (call $json_quote (call $val_payload (local.get $v))))))
  (if (call $is_array (local.get $v))
    (then
      (let $a i32 (call $val_payload (local.get $v)))
      (let $n i32 (call $arr_len (local.get $a)))
      (let $out i32 (cstring "["))
      (let $i i32 (i32.const 0))
      (block $e (loop $l
        (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
        (if (i32.gt_s (local.get $i) (i32.const 0)) (then (set! $out (call $str_concat (local.get $out) (cstring ",")))))
        (let $es i32 (call $json_str (call $arr_get (local.get $a) (local.get $i))))
        (if (i32.eqz (local.get $es)) (then (set! $es (cstring "null"))))
        (set! $out (call $str_concat (local.get $out) (local.get $es)))
        (set! $i (i32.add (local.get $i) (i32.const 1)))
        (br $l)))
      (return (call $str_concat (local.get $out) (cstring "]")))))
  (if (call $is_object (local.get $v))
    (then
      ;; iterate own enumerable keys in spec order (integer keys first, ascending)
      (let $keys i32 (call $own_enum_keys (local.get $v) (i32.const 0)))
      (let $cnt i32 (call $arr_len (local.get $keys)))
      (let $out i32 (cstring "{"))
      (let $i i32 (i32.const 0))
      (let $first i32 (i32.const 1))
      (block $e (loop $l
        (br_if $e (i32.ge_s (local.get $i) (local.get $cnt)))
        (let $nmv i64 (call $arr_get (local.get $keys) (local.get $i)))
        (let $nm i32 (call $val_payload (local.get $nmv)))
        (let $vs i32 (call $json_str (call $get_prop (local.get $v) (local.get $nmv))))
        (if (i32.ne (local.get $vs) (i32.const 0))
          (then
            (if (i32.eqz (local.get $first)) (then (set! $out (call $str_concat (local.get $out) (cstring ",")))))
            (set! $first (i32.const 0))
            (set! $out (call $str_concat (local.get $out) (call $json_quote (local.get $nm))))
            (set! $out (call $str_concat (local.get $out) (cstring ":")))
            (set! $out (call $str_concat (local.get $out) (local.get $vs)))))
        (set! $i (i32.add (local.get $i) (i32.const 1)))
        (br $l)))
      (return (call $str_concat (local.get $out) (cstring "}")))))
  (i32.const 0))  ;; undefined / function

;; ═══════════════════════════════════════════════════════════════
;; JSON.parse — a strict, validating recursive-descent parser.
;; Builds JS values directly and throws SyntaxError on malformed input.
;; Cursor state: slot 404 = pos, 408 = src Str ptr, 412 = byte length.
;; ═══════════════════════════════════════════════════════════════
(func $jp_pos (result i32) (effects) (i32.load (i32.const 404)))
(func $jp_setpos (param $p i32) (effects) (i32.store (i32.const 404) (local.get $p)))
(func $jp_src (result i32) (effects) (i32.load (i32.const 408)))
(func $jp_len (result i32) (effects) (i32.load (i32.const 412)))
(func $jp_adv (effects) (call $jp_setpos (i32.add (call $jp_pos) (i32.const 1))))
(func $jp_cur (result i32) (effects)  ;; current byte, or -1 at/after end
  (if i32 (i32.lt_s (call $jp_pos) (call $jp_len))
    (then (call $str_byte (call $jp_src) (call $jp_pos)))
    (else (i32.const -1))))
(func $jp_err (param $msg i32) (effects)
  (call $throw_type (cstring "SyntaxError") (local.get $msg)))
(func $jp_isdigit (param $c i32) (result i32) (effects)
  (i32.and (i32.ge_s (local.get $c) (i32.const 48)) (i32.le_s (local.get $c) (i32.const 57))))

;; skip JSON whitespace (space, tab, LF, CR only)
(func $jp_ws (effects)
  (block $e (loop $l
    (let $c i32 (call $jp_cur))
    (br_if $e (i32.eqz (i32.or (i32.eq (local.get $c) (i32.const 32))
                       (i32.or (i32.eq (local.get $c) (i32.const 9))
                       (i32.or (i32.eq (local.get $c) (i32.const 10))
                               (i32.eq (local.get $c) (i32.const 13)))))))
    (call $jp_adv)
    (br $l))))

;; consume zero-or-more decimal digits; return how many were consumed
(func $jp_digits (result i32) (effects)
  (let $n i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.eqz (call $jp_isdigit (call $jp_cur))))
    (call $jp_adv)
    (set! $n (i32.add (local.get $n) (i32.const 1)))
    (br $l)))
  (local.get $n))

;; parse 4 hex digits (cursor at first); return value, advancing past all 4
(func $jp_hex4 (result i32) (effects)
  (let $v i32 (i32.const 0))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (i32.const 4)))
    (let $c i32 (call $jp_cur))
    (let $d i32 (i32.const -1))
    (if (call $jp_isdigit (local.get $c)) (then (set! $d (i32.sub (local.get $c) (i32.const 48)))))
    (if (i32.and (i32.ge_s (local.get $c) (i32.const 97)) (i32.le_s (local.get $c) (i32.const 102))) (then (set! $d (i32.add (i32.sub (local.get $c) (i32.const 97)) (i32.const 10)))))
    (if (i32.and (i32.ge_s (local.get $c) (i32.const 65)) (i32.le_s (local.get $c) (i32.const 70))) (then (set! $d (i32.add (i32.sub (local.get $c) (i32.const 65)) (i32.const 10)))))
    (if (i32.lt_s (local.get $d) (i32.const 0)) (then (call $jp_err (cstring "Bad Unicode escape in JSON")) (return (i32.const 0))))
    (set! $v (i32.add (i32.mul (local.get $v) (i32.const 16)) (local.get $d)))
    (call $jp_adv)
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (local.get $v))

;; parse a string (cursor at opening quote) → heap Str ptr (0 on error)
(func $jp_string (result i32) (effects)
  (call $jp_adv)  ;; consume opening quote
  (let $max i32 (i32.sub (call $jp_len) (call $jp_pos)))
  (let $buf i32 (call $str_alloc (local.get $max)))
  (let $o i32 (i32.const 0))
  (block $e (loop $l
    (let $c i32 (call $jp_cur))
    (if (i32.lt_s (local.get $c) (i32.const 0)) (then (call $jp_err (cstring "Unterminated string in JSON")) (return (i32.const 0))))
    (if (i32.eq (local.get $c) (i32.const 34)) (then (call $jp_adv) (br $e)))  ;; closing quote
    (if (i32.lt_s (local.get $c) (i32.const 32)) (then (call $jp_err (cstring "Bad control character in string literal in JSON")) (return (i32.const 0))))
    (if (i32.eq (local.get $c) (i32.const 92))
      (then
        (call $jp_adv)  ;; consume backslash
        (let $e2 i32 (call $jp_cur))
        (let $out i32 (i32.const -1))
        (if (i32.eq (local.get $e2) (i32.const 34)) (then (set! $out (i32.const 34))))
        (if (i32.eq (local.get $e2) (i32.const 92)) (then (set! $out (i32.const 92))))
        (if (i32.eq (local.get $e2) (i32.const 47)) (then (set! $out (i32.const 47))))
        (if (i32.eq (local.get $e2) (i32.const 98)) (then (set! $out (i32.const 8))))
        (if (i32.eq (local.get $e2) (i32.const 102)) (then (set! $out (i32.const 12))))
        (if (i32.eq (local.get $e2) (i32.const 110)) (then (set! $out (i32.const 10))))
        (if (i32.eq (local.get $e2) (i32.const 114)) (then (set! $out (i32.const 13))))
        (if (i32.eq (local.get $e2) (i32.const 116)) (then (set! $out (i32.const 9))))
        (if (i32.eq (local.get $e2) (i32.const 117))
          (then
            (call $jp_adv)  ;; consume 'u'
            (let $cp i32 (call $jp_hex4))
            (if (call $err) (then (return (i32.const 0))))
            (call $str_set_byte (local.get $buf) (local.get $o) (i32.and (local.get $cp) (i32.const 255)))
            (set! $o (i32.add (local.get $o) (i32.const 1)))
            (br $l)))
        (if (i32.lt_s (local.get $out) (i32.const 0)) (then (call $jp_err (cstring "Bad escaped character in JSON")) (return (i32.const 0))))
        (call $str_set_byte (local.get $buf) (local.get $o) (local.get $out))
        (set! $o (i32.add (local.get $o) (i32.const 1)))
        (call $jp_adv)
        (br $l)))
    (call $str_set_byte (local.get $buf) (local.get $o) (local.get $c))
    (set! $o (i32.add (local.get $o) (i32.const 1)))
    (call $jp_adv)
    (br $l)))
  (i32.store (local.get $buf) (local.get $o))  ;; fix length header to actual
  (local.get $buf))

;; parse a number (cursor at '-' or first digit) → number JSValue
(func $jp_number (result i64) (effects)
  (let $start i32 (call $jp_pos))
  (if (i32.eq (call $jp_cur) (i32.const 45)) (then (call $jp_adv)))  ;; minus
  (let $c i32 (call $jp_cur))
  (if (i32.eq (local.get $c) (i32.const 48))
    (then (call $jp_adv))  ;; lone leading zero
    (else
      (if (i32.and (i32.ge_s (local.get $c) (i32.const 49)) (i32.le_s (local.get $c) (i32.const 57)))
        (then (drop (call $jp_digits)))
        (else (call $jp_err (cstring "Unexpected token in JSON")) (return (call $v_undef))))))
  (if (i32.eq (call $jp_cur) (i32.const 46))  ;; fraction
    (then
      (call $jp_adv)
      (if (i32.eqz (call $jp_digits)) (then (call $jp_err (cstring "Unterminated fractional number in JSON")) (return (call $v_undef))))))
  (if (i32.or (i32.eq (call $jp_cur) (i32.const 101)) (i32.eq (call $jp_cur) (i32.const 69)))  ;; e / E
    (then
      (call $jp_adv)
      (if (i32.or (i32.eq (call $jp_cur) (i32.const 43)) (i32.eq (call $jp_cur) (i32.const 45))) (then (call $jp_adv)))
      (if (i32.eqz (call $jp_digits)) (then (call $jp_err (cstring "Exponent part is missing a number in JSON")) (return (call $v_undef))))))
  (let $len i32 (i32.sub (call $jp_pos) (local.get $start)))
  (let $s i32 (call $str_alloc (local.get $len)))
  (let $k i32 (i32.const 0))
  (block $ce (loop $cl
    (br_if $ce (i32.ge_s (local.get $k) (local.get $len)))
    (call $str_set_byte (local.get $s) (local.get $k) (call $str_byte (call $jp_src) (i32.add (local.get $start) (local.get $k))))
    (set! $k (i32.add (local.get $k) (i32.const 1)))
    (br $cl)))
  (call $num (call $str_to_num (local.get $s))))

;; match a literal keyword (true/false/null) at cursor
(func $jp_lit (param $word i32) (param $val i64) (result i64) (effects)
  (let $n i32 (call $str_len (local.get $word)))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    (if (i32.ne (call $jp_cur) (call $str_byte (local.get $word) (local.get $i)))
      (then (call $jp_err (cstring "Unexpected token in JSON")) (return (call $v_undef))))
    (call $jp_adv)
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (local.get $val))

(func $jp_object (result i64) (effects)
  (let $o i32 (call $obj_new (i32.const 4)))
  (call $jp_adv)  ;; consume {
  (call $jp_ws)
  (if (i32.eq (call $jp_cur) (i32.const 125)) (then (call $jp_adv) (return (call $mk_obj (local.get $o)))))
  (block $done (loop $members
    (call $jp_ws)
    (if (i32.ne (call $jp_cur) (i32.const 34)) (then (call $jp_err (cstring "Expected property name or '}' in JSON")) (return (call $v_undef))))
    (let $key i32 (call $jp_string))
    (if (call $err) (then (return (call $v_undef))))
    (call $jp_ws)
    (if (i32.ne (call $jp_cur) (i32.const 58)) (then (call $jp_err (cstring "Expected ':' after property name in JSON")) (return (call $v_undef))))
    (call $jp_adv)  ;; consume :
    (let $val i64 (call $jp_value))
    (if (call $err) (then (return (call $v_undef))))
    (call $scope_define (local.get $o) (local.get $key) (local.get $val))  ;; CreateDataProperty: own enumerable data prop (so "__proto__" is a real own prop, not the setter)
    (call $jp_ws)
    (let $c i32 (call $jp_cur))
    (if (i32.eq (local.get $c) (i32.const 44)) (then (call $jp_adv) (br $members)))
    (if (i32.eq (local.get $c) (i32.const 125)) (then (call $jp_adv) (br $done)))
    (call $jp_err (cstring "Expected ',' or '}' after property value in JSON")) (return (call $v_undef))))
  (call $mk_obj (local.get $o)))

(func $jp_array (result i64) (effects)
  (let $a i32 (call $arr_new (i32.const 4)))
  (call $jp_adv)  ;; consume [
  (call $jp_ws)
  (if (i32.eq (call $jp_cur) (i32.const 93)) (then (call $jp_adv) (return (call $mk_arr (local.get $a)))))
  (block $done (loop $elems
    (let $val i64 (call $jp_value))
    (if (call $err) (then (return (call $v_undef))))
    (call $arr_push (local.get $a) (local.get $val))
    (call $jp_ws)
    (let $c i32 (call $jp_cur))
    (if (i32.eq (local.get $c) (i32.const 44)) (then (call $jp_adv) (br $elems)))
    (if (i32.eq (local.get $c) (i32.const 93)) (then (call $jp_adv) (br $done)))
    (call $jp_err (cstring "Expected ',' or ']' after array element in JSON")) (return (call $v_undef))))
  (call $mk_arr (local.get $a)))

(func $jp_value (result i64) (effects)
  (call $jp_ws)
  (let $c i32 (call $jp_cur))
  (if (i32.eq (local.get $c) (i32.const 123)) (then (return (call $jp_object))))   ;; {
  (if (i32.eq (local.get $c) (i32.const 91)) (then (return (call $jp_array))))    ;; [
  (if (i32.eq (local.get $c) (i32.const 34)) (then (return (call $mk_str (call $jp_string)))))  ;; "
  (if (i32.eq (local.get $c) (i32.const 116)) (then (return (call $jp_lit (cstring "true") (call $v_true)))))
  (if (i32.eq (local.get $c) (i32.const 102)) (then (return (call $jp_lit (cstring "false") (call $v_false)))))
  (if (i32.eq (local.get $c) (i32.const 110)) (then (return (call $jp_lit (cstring "null") (call $v_null)))))
  (if (i32.or (i32.eq (local.get $c) (i32.const 45)) (call $jp_isdigit (local.get $c)))
    (then (return (call $jp_number))))
  (call $jp_err (cstring "Unexpected token in JSON"))
  (call $v_undef))

;; top-level entry: parse the whole source; trailing junk is a SyntaxError.
;; CreateDataProperty(obj, key, v) via [[DefineOwnProperty]] with a full {W,E,C} data
;; descriptor — Reflect.defineProperty (native 206) so a Proxy defineProperty trap runs
;; (throw propagated) and an ordinary non-configurable property blocks the redefine
;; (returns false, no throw), matching CreateDataProperty. Sets $err on a propagated throw.
(func $json_create_data_prop (param $obj i64) (param $key i32) (param $v i64) (effects)
  (let $jdesc i64 (call $mk_obj (call $obj_new (i32.const 8))))
  (call $set_prop (local.get $jdesc) (call $mk_str (cstring "value")) (local.get $v))
  (call $set_prop (local.get $jdesc) (call $mk_str (cstring "writable")) (call $mk_bool (i32.const 1)))
  (call $set_prop (local.get $jdesc) (call $mk_str (cstring "enumerable")) (call $mk_bool (i32.const 1)))
  (call $set_prop (local.get $jdesc) (call $mk_str (cstring "configurable")) (call $mk_bool (i32.const 1)))
  (let $jcbuf i32 (call $heap_alloc (i32.const 24)))
  (i64.store (local.get $jcbuf) (local.get $obj))
  (i64.store (i32.add (local.get $jcbuf) (i32.const 8)) (call $mk_str (local.get $key)))
  (i64.store (i32.add (local.get $jcbuf) (i32.const 16)) (local.get $jdesc))
  (drop (call $call_native (i32.const 206) (i32.const 3) (local.get $jcbuf) (call $v_undef))))

;; InternalizeJSONProperty: recursively apply a JSON.parse reviver bottom-up.
(func $json_revive (param $holder i64) (param $key i32) (param $reviver i64) (result i64) (effects)
  (let $val i64 (call $get_prop (local.get $holder) (call $mk_str (local.get $key))))
  (if (call $is_array (local.get $val))
    (then
      (let $ja i32 (call $val_payload (local.get $val)))
      (let $ji i32 (i32.const 0))
      (block $jae (loop $jal (br_if $jae (i32.ge_s (local.get $ji) (call $arr_len (local.get $ja))))
        (let $je i64 (call $json_revive (local.get $val) (call $num_to_str (f64.convert_i32_s (local.get $ji))) (local.get $reviver)))
        (if (call $is_undefined (local.get $je))
          (then (i64.store (call $arr_slot (local.get $ja) (local.get $ji)) (call $v_hole)))
          (else (call $arr_set (local.get $ja) (local.get $ji) (local.get $je))))
        (set! $ji (i32.add (local.get $ji) (i32.const 1))) (br $jal))))
    (else (if (call $is_object (local.get $val))
      (then
        (let $jkeys i32 (call $own_enum_keys (local.get $val) (i32.const 0)))
        (let $ji2 i32 (i32.const 0))
        (block $joe (loop $jol (br_if $joe (i32.ge_s (local.get $ji2) (call $arr_len (local.get $jkeys))))
          (let $jk i32 (call $val_payload (call $arr_get (local.get $jkeys) (local.get $ji2))))
          (let $je2 i64 (call $json_revive (local.get $val) (local.get $jk) (local.get $reviver)))
          (if (call $is_undefined (local.get $je2))
            ;; reviver returned undefined → ? val.[[Delete]](P) via Reflect.deleteProperty
            ;; (native 203): respects configurability for an ordinary object (non-configurable
            ;; stays, no throw) AND routes through a Proxy deleteProperty trap, propagating its throw.
            (then
              (let $jdbuf i32 (call $heap_alloc (i32.const 16)))
              (i64.store (local.get $jdbuf) (local.get $val))
              (i64.store (i32.add (local.get $jdbuf) (i32.const 8)) (call $mk_str (local.get $jk)))
              (drop (call $call_native (i32.const 203) (i32.const 2) (local.get $jdbuf) (call $v_undef)))
              (if (call $err) (then (return (call $v_undef)))))
            (else  ;; CreateDataProperty(val, P, newElement) via [[DefineOwnProperty]] (proxy-aware, throws propagated)
              (call $json_create_data_prop (local.get $val) (local.get $jk) (local.get $je2))
              (if (call $err) (then (return (call $v_undef))))))
          (set! $ji2 (i32.add (local.get $ji2) (i32.const 1))) (br $jol)))))))
  (let $jav i32 (call $heap_alloc (i32.const 16)))
  (i64.store (local.get $jav) (call $mk_str (local.get $key)))
  (i64.store (i32.add (local.get $jav) (i32.const 8)) (local.get $val))
  (call $call_val (local.get $reviver) (i32.const 2) (local.get $jav) (local.get $holder)))

(func $json_parse (param $src i32) (result i64) (effects)
  (i32.store (i32.const 408) (local.get $src))
  (i32.store (i32.const 412) (call $str_len (local.get $src)))
  (i32.store (i32.const 404) (i32.const 0))
  (let $v i64 (call $jp_value))
  (if (call $err) (then (return (call $v_undef))))
  (call $jp_ws)
  (if (i32.lt_s (call $jp_pos) (call $jp_len))
    (then (call $jp_err (cstring "Unexpected non-whitespace character after JSON")) (return (call $v_undef))))
  (local.get $v))

;; ═══════════════════════════════════════════════════════════════
;; JSON.stringify — spec-compliant SerializeJSONProperty.
;; State slots: 416 = gap Str ptr (0 none); 424 = replacer fn (i64);
;; 432 = PropertyList arr ptr (0 none); 436 = circular-stack base;
;; 440 = circular-stack depth.
;; ═══════════════════════════════════════════════════════════════
(func $jstk_has (param $p i32) (result i32) (effects)
  (let $n i32 (i32.load (i32.const 440)))
  (let $b i32 (i32.load (i32.const 436)))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    (if (i32.eq (i32.load (i32.add (local.get $b) (i32.shl (local.get $i) (i32.const 2)))) (local.get $p)) (then (return (i32.const 1))))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
  (i32.const 0))
(func $jstk_push (param $p i32) (effects)
  (let $n i32 (i32.load (i32.const 440)))
  (i32.store (i32.add (i32.load (i32.const 436)) (i32.shl (local.get $n) (i32.const 2))) (local.get $p))
  (i32.store (i32.const 440) (i32.add (local.get $n) (i32.const 1))))
(func $jstk_pop (effects)
  (i32.store (i32.const 440) (i32.sub (i32.load (i32.const 440)) (i32.const 1))))

;; SerializeJSONProperty(key, holder, indent) → heap Str ptr, or 0 to omit.
(func $jstr_prop (param $key i64) (param $holder i64) (param $indent i32) (result i32) (effects)
  (let $v i64 (call $get_prop (local.get $holder) (local.get $key)))
  (if (call $err) (then (return (i32.const 0))))
  ;; toJSON
  (if (i32.or (call $is_object (local.get $v)) (i32.or (call $is_array (local.get $v)) (call $is_bigint (local.get $v))))
    (then
      (let $tj i64 (call $get_prop (local.get $v) (call $mk_str (cstring "toJSON"))))
      (if (call $err) (then (return (i32.const 0))))
      (if (call $is_function (local.get $tj))
        (then
          (let $a i32 (call $heap_alloc (i32.const 8)))
          (i64.store (local.get $a) (local.get $key))
          (set! $v (call $call_val (local.get $tj) (i32.const 1) (local.get $a) (local.get $v)))
          (if (call $err) (then (return (i32.const 0))))))))
  ;; replacer function
  (let $rep i64 (i64.load (i32.const 424)))
  (if (call $is_function (local.get $rep))
    (then
      (let $a2 i32 (call $heap_alloc (i32.const 16)))
      (i64.store (local.get $a2) (local.get $key))
      (i64.store (i32.add (local.get $a2) (i32.const 8)) (local.get $v))
      (set! $v (call $call_val (local.get $rep) (i32.const 2) (local.get $a2) (local.get $holder)))
      (if (call $err) (then (return (i32.const 0))))))
  ;; Number/String/Boolean/BigInt wrapper objects: per spec a Number wrapper is
  ;; ToNumber'd and a String wrapper ToString'd (invoking overridden valueOf/toString),
  ;; NOT just read off the boxed primitive. Boolean/BigInt use the boxed value.
  (if (call $is_object (local.get $v))
    (then
      (let $ps i32 (call $scope_find_local (call $val_payload (local.get $v)) (cstring "__prim__")))
      (if (local.get $ps)
        (then
          (let $pv i64 (i64.load (local.get $ps)))
          (if (call $is_number (local.get $pv)) (then (set! $v (call $num (call $to_num (local.get $v)))))
            (else (if (call $is_string (local.get $pv)) (then (set! $v (call $mk_str (call $to_str (local.get $v)))))
              (else (set! $v (local.get $pv))))))  ;; boolean / bigint
          (if (call $err) (then (return (i32.const 0))))))))
  ;; raw JSON (JSON.rawJSON): a null-proto object with [[IsRawJSON]] → emit its text verbatim
  (if (call $is_object (local.get $v))
    (then (if (call $scope_find_local (call $val_payload (local.get $v)) (cstring "@@israwjson"))
      (then (return (call $val_payload (call $get_prop (local.get $v) (call $mk_str (cstring "rawJSON")))))))))
  ;; primitives
  (if (call $is_null (local.get $v)) (then (return (cstring "null"))))
  (if (call $is_boolean (local.get $v)) (then (return (if i32 (call $val_payload (local.get $v)) (then (cstring "true")) (else (cstring "false"))))))
  (if (call $is_string (local.get $v)) (then (return (call $json_quote (call $val_payload (local.get $v))))))
  (if (call $is_number (local.get $v))
    (then
      (let $d f64 (call $tonum_raw (local.get $v)))
      (if (i32.and (f64.eq (local.get $d) (local.get $d)) (i32.and (f64.ne (local.get $d) (f64.div (f64.const 1) (f64.const 0))) (f64.ne (local.get $d) (f64.div (f64.const -1) (f64.const 0)))))
        (then (return (call $num_to_str (local.get $d))))
        (else (return (cstring "null"))))))
  (if (call $is_bigint (local.get $v))
    (then (call $throw_type (cstring "TypeError") (cstring "Do not know how to serialize a BigInt")) (return (i32.const 0))))
  (if (call $json_isarray (local.get $v)) (then (return (call $jstr_arr (local.get $v) (local.get $indent)))))  ;; IsArray (sees through proxies)
  (if (call $is_object (local.get $v)) (then (return (call $jstr_obj (local.get $v) (local.get $indent)))))
  (i32.const 0))  ;; undefined / function → omit

;; IsArray that sees through Proxies (SerializeJSONProperty uses IsArray, not a tag check)
(func $json_isarray (param $v i64) (result i32) (effects)
  (let $x i64 (local.get $v))
  (block $e (loop $l (br_if $e (i32.eqz (call $is_proxy (local.get $x)))) (set! $x (call $proxy_target (local.get $x))) (br $l)))
  (call $is_array (local.get $x)))

(func $jstr_arr (param $v i64) (param $indent i32) (result i32) (effects)
  (let $p i32 (call $val_payload (local.get $v)))
  (if (call $jstk_has (local.get $p)) (then (call $throw_type (cstring "TypeError") (cstring "Converting circular structure to JSON")) (return (i32.const 0))))
  (call $jstk_push (local.get $p))
  ;; length via Get (proxy-aware) so a Proxy-over-array serializes as an array
  (let $n i32 (call $to_int_idx (call $to_num (call $get_prop (local.get $v) (call $mk_str (cstring "length"))))))
  (if (call $err) (then (call $jstk_pop) (return (i32.const 0))))
  (let $gap i32 (i32.load (i32.const 416)))
  (let $ni i32 (local.get $indent))
  (if (local.get $gap) (then (set! $ni (call $str_concat (local.get $indent) (local.get $gap)))))
  (let $out i32 (cstring "["))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    (if (i32.gt_s (local.get $i) (i32.const 0)) (then (set! $out (call $str_concat (local.get $out) (cstring ",")))))
    (if (local.get $gap) (then (set! $out (call $str_concat (call $str_concat (local.get $out) (cstring "\n")) (local.get $ni)))))
    (let $es i32 (call $jstr_prop (call $mk_str (call $num_to_str (f64.convert_i32_s (local.get $i)))) (local.get $v) (local.get $ni)))
    (if (call $err) (then (call $jstk_pop) (return (i32.const 0))))
    (if (i32.eqz (local.get $es)) (then (set! $es (cstring "null"))))
    (set! $out (call $str_concat (local.get $out) (local.get $es)))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
  (if (local.get $gap) (then (if (i32.gt_s (local.get $n) (i32.const 0))
    (then (set! $out (call $str_concat (call $str_concat (local.get $out) (cstring "\n")) (local.get $indent)))))))
  (call $jstk_pop)
  (call $str_concat (local.get $out) (cstring "]")))

(func $jstr_obj (param $v i64) (param $indent i32) (result i32) (effects)
  (let $p i32 (call $val_payload (local.get $v)))
  (if (call $jstk_has (local.get $p)) (then (call $throw_type (cstring "TypeError") (cstring "Converting circular structure to JSON")) (return (i32.const 0))))
  (call $jstk_push (local.get $p))
  (let $plist i32 (i32.load (i32.const 432)))
  (let $keys i32 (if i32 (local.get $plist) (then (local.get $plist)) (else (call $own_enum_keys (local.get $v) (i32.const 0)))))
  (let $cnt i32 (call $arr_len (local.get $keys)))
  (let $gap i32 (i32.load (i32.const 416)))
  (let $ni i32 (local.get $indent))
  (if (local.get $gap) (then (set! $ni (call $str_concat (local.get $indent) (local.get $gap)))))
  (let $sep i32 (if i32 (local.get $gap) (then (cstring ": ")) (else (cstring ":"))))
  (let $out i32 (cstring "{"))
  (let $first i32 (i32.const 1))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $cnt)))
    (let $kv i64 (call $arr_get (local.get $keys) (local.get $i)))
    (let $es i32 (call $jstr_prop (local.get $kv) (local.get $v) (local.get $ni)))
    (if (call $err) (then (call $jstk_pop) (return (i32.const 0))))
    (if (local.get $es)
      (then
        (if (i32.eqz (local.get $first)) (then (set! $out (call $str_concat (local.get $out) (cstring ",")))))
        (set! $first (i32.const 0))
        (if (local.get $gap) (then (set! $out (call $str_concat (call $str_concat (local.get $out) (cstring "\n")) (local.get $ni)))))
        (set! $out (call $str_concat (local.get $out) (call $json_quote (call $val_payload (local.get $kv)))))
        (set! $out (call $str_concat (local.get $out) (local.get $sep)))
        (set! $out (call $str_concat (local.get $out) (local.get $es)))))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
  (if (local.get $gap) (then (if (i32.eqz (local.get $first))
    (then (set! $out (call $str_concat (call $str_concat (local.get $out) (cstring "\n")) (local.get $indent)))))))
  (call $jstk_pop)
  (call $str_concat (local.get $out) (cstring "}")))

;; build the gap string from the `space` argument (Number → N spaces, capped 10;
;; String → first 10 chars; else ""). Returns Str ptr (empty Str if no gap).
(func $jstr_gap (param $sp i64) (result i32) (effects)
  ;; a Number-wrapper space is ToNumber'd and a String-wrapper ToString'd (invoking an
  ;; overridden valueOf/toString), not read off the boxed primitive
  (if (call $is_object (local.get $sp))
    (then
      (let $ps i32 (call $scope_find_local (call $val_payload (local.get $sp)) (cstring "__prim__")))
      (if (local.get $ps)
        (then
          (let $pv i64 (i64.load (local.get $ps)))
          (if (call $is_number (local.get $pv)) (then (set! $sp (call $num (call $to_num (local.get $sp)))))
            (else (if (call $is_string (local.get $pv)) (then (set! $sp (call $mk_str (call $to_str (local.get $sp)))))
              (else (set! $sp (local.get $pv))))))
          (if (call $err) (then (return (i32.const 0))))))))
  (if (call $is_number (local.get $sp))
    (then
      (let $nn i32 (i32.trunc_f64_s (call $tonum_raw (local.get $sp))))
      (if (i32.gt_s (local.get $nn) (i32.const 10)) (then (set! $nn (i32.const 10))))
      (if (i32.lt_s (local.get $nn) (i32.const 1)) (then (return (i32.const 0))))
      (let $g i32 (call $str_alloc (local.get $nn)))
      (let $k i32 (i32.const 0))
      (block $e (loop $l
        (br_if $e (i32.ge_s (local.get $k) (local.get $nn)))
        (call $str_set_byte (local.get $g) (local.get $k) (i32.const 32))
        (set! $k (i32.add (local.get $k) (i32.const 1))) (br $l)))
      (return (local.get $g))))
  (if (call $is_string (local.get $sp))
    (then
      (let $s i32 (call $val_payload (local.get $sp)))
      (let $sl i32 (call $str_len (local.get $s)))
      (if (i32.lt_s (local.get $sl) (i32.const 1)) (then (return (i32.const 0))))
      (if (i32.gt_s (local.get $sl) (i32.const 10)) (then (set! $sl (i32.const 10))))
      (let $g2 i32 (call $str_alloc (local.get $sl)))
      (let $k2 i32 (i32.const 0))
      (block $e2 (loop $l2
        (br_if $e2 (i32.ge_s (local.get $k2) (local.get $sl)))
        (call $str_set_byte (local.get $g2) (local.get $k2) (call $str_byte (local.get $s) (local.get $k2)))
        (set! $k2 (i32.add (local.get $k2) (i32.const 1))) (br $l2)))
      (return (local.get $g2))))
  (i32.const 0))

;; build the PropertyList from a replacer array → arr of unique String keys.
(func $jstr_plist (param $rep i64) (result i32) (effects)
  (let $ra i32 (call $val_payload (local.get $rep)))
  (let $n i32 (call $arr_len (local.get $ra)))
  (let $out i32 (call $arr_new (i32.const 8)))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    (let $el i64 (call $arr_get (local.get $ra) (local.get $i)))
    (let $key i32 (i32.const 0))
    (if (call $is_string (local.get $el)) (then (set! $key (call $val_payload (local.get $el)))))
    (if (call $is_number (local.get $el)) (then (set! $key (call $num_to_str (call $tonum_raw (local.get $el))))))
    ;; a String/Number WRAPPER object → ToString(object) which invokes its (possibly
    ;; overridden) toString; a Boolean wrapper (or any other object) is ignored.
    (if (call $is_object (local.get $el))
      (then
        (let $ps i32 (call $scope_find_local (call $val_payload (local.get $el)) (cstring "__prim__")))
        (if (local.get $ps)
          (then
            (let $pv i64 (i64.load (local.get $ps)))
            (if (i32.or (call $is_string (local.get $pv)) (call $is_number (local.get $pv)))
              (then (set! $key (call $to_str (local.get $el)))))))))
    (if (local.get $key)
      (then
        ;; dedup
        (let $dup i32 (i32.const 0))
        (let $j i32 (i32.const 0))
        (block $de (loop $dl
          (br_if $de (i32.ge_s (local.get $j) (call $arr_len (local.get $out))))
          (if (call $str_eq (call $val_payload (call $arr_get (local.get $out) (local.get $j))) (local.get $key)) (then (set! $dup (i32.const 1)) (br $de)))
          (set! $j (i32.add (local.get $j) (i32.const 1))) (br $dl)))
        (if (i32.eqz (local.get $dup)) (then (call $arr_push (local.get $out) (call $mk_str (local.get $key)))))))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
  (local.get $out))

;; top-level JSON.stringify(value, replacer, space) → Str ptr, or 0 if undefined.
(func $json_stringify (param $value i64) (param $rep i64) (param $sp i64) (result i32) (effects)
  (i64.store (i32.const 424) (call $v_undef))
  (i32.store (i32.const 432) (i32.const 0))
  (if (call $is_function (local.get $rep))
    (then (i64.store (i32.const 424) (local.get $rep)))
    (else (if (call $is_array (local.get $rep)) (then (i32.store (i32.const 432) (call $jstr_plist (local.get $rep)))))))
  (i32.store (i32.const 416) (call $jstr_gap (local.get $sp)))
  (i32.store (i32.const 436) (call $heap_alloc (i32.const 4096)))
  (i32.store (i32.const 440) (i32.const 0))
  (let $w i32 (call $obj_new (i32.const 2)))
  (call $set_prop (call $mk_obj (local.get $w)) (call $mk_str (cstring "")) (local.get $value))
  (call $jstr_prop (call $mk_str (cstring "")) (call $mk_obj (local.get $w)) (cstring "")))
