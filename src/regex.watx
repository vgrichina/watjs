;; Validate a RegExp modifier group `(?<add>:` / `(?<add>-<remove>:` starting at $start (the first char
;; after `(?`, known NOT to be `:`/`=`/`!`/`<`). add/remove flags may only be i, m, s; no duplicate
;; within a set; no flag in BOTH add and remove; a `-` requires a non-empty remove; the group may not be
;; empty. Throws SyntaxError (sets err) on any violation and returns $start; otherwise returns the
;; position just after the `:`. (Only validates syntax — the modifiers are not yet applied in matching.)
(func $re_validate_modifiers (param $pat i32) (param $n i32) (param $start i32) (result i32) (effects)
  (let $i i32 (local.get $start))
  (let $ai i32 (i32.const 0)) (let $am i32 (i32.const 0)) (let $as i32 (i32.const 0))  ;; add i/m/s
  (let $ri i32 (i32.const 0)) (let $rm i32 (i32.const 0)) (let $rs i32 (i32.const 0))  ;; remove i/m/s
  (let $dash i32 (i32.const 0)) (let $nadd i32 (i32.const 0)) (let $nrem i32 (i32.const 0))
  (block $e (loop $l
    (if (i32.ge_s (local.get $i) (local.get $n)) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Invalid regular expression: unterminated modifier group")) (return (local.get $start))))
    (let $mc i32 (call $str_byte (local.get $pat) (local.get $i)))
    (if (i32.eq (local.get $mc) (i32.const 58)) (then (br $e)))  ;; ':'
    (if (i32.eq (local.get $mc) (i32.const 45))  ;; '-'
      (then
        (if (local.get $dash) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Invalid modifier group")) (return (local.get $start))))
        (set! $dash (i32.const 1)) (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
    (if (i32.eq (local.get $mc) (i32.const 105))  ;; 'i'
      (then (if (local.get $dash) (then (if (local.get $ri) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Duplicate modifier flag")) (return (local.get $start)))) (set! $ri (i32.const 1)) (set! $nrem (i32.add (local.get $nrem) (i32.const 1)))) (else (if (local.get $ai) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Duplicate modifier flag")) (return (local.get $start)))) (set! $ai (i32.const 1)) (set! $nadd (i32.add (local.get $nadd) (i32.const 1))))) (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
    (if (i32.eq (local.get $mc) (i32.const 109))  ;; 'm'
      (then (if (local.get $dash) (then (if (local.get $rm) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Duplicate modifier flag")) (return (local.get $start)))) (set! $rm (i32.const 1)) (set! $nrem (i32.add (local.get $nrem) (i32.const 1)))) (else (if (local.get $am) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Duplicate modifier flag")) (return (local.get $start)))) (set! $am (i32.const 1)) (set! $nadd (i32.add (local.get $nadd) (i32.const 1))))) (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
    (if (i32.eq (local.get $mc) (i32.const 115))  ;; 's'
      (then (if (local.get $dash) (then (if (local.get $rs) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Duplicate modifier flag")) (return (local.get $start)))) (set! $rs (i32.const 1)) (set! $nrem (i32.add (local.get $nrem) (i32.const 1)))) (else (if (local.get $as) (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Duplicate modifier flag")) (return (local.get $start)))) (set! $as (i32.const 1)) (set! $nadd (i32.add (local.get $nadd) (i32.const 1))))) (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
    ;; any other char is not a valid modifier flag
    (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Invalid modifier flag")) (return (local.get $start))))
  ;; at ':' — final checks
  (if (i32.or (i32.and (local.get $ai) (local.get $ri)) (i32.or (i32.and (local.get $am) (local.get $rm)) (i32.and (local.get $as) (local.get $rs))))
    (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Modifier added and removed")) (return (local.get $start))))  ;; flag in both add and remove
  ;; a `-` with an empty remove set is VALID (`(?i-:a)`); only a fully-empty group is an error.
  (if (i32.and (i32.eqz (local.get $nadd)) (i32.eqz (local.get $nrem)))
    (then (i32.store (i32.const 400) (i32.const 1)) (call $throw_type (cstring "SyntaxError") (cstring "Empty modifier group")) (return (local.get $start))))
  (i32.add (local.get $i) (i32.const 1)))  ;; position after ':'
(func $re_isletter (param $c i32) (result i32) (effects)  ;; a-z / A-Z
  (i32.or (i32.and (i32.ge_s (local.get $c) (i32.const 97)) (i32.le_s (local.get $c) (i32.const 122)))
          (i32.and (i32.ge_s (local.get $c) (i32.const 65)) (i32.le_s (local.get $c) (i32.const 90)))))
;; IdentifierStart (permissive, byte-level): ASCII letter / _ / $ ; any non-ASCII byte (part of a UTF-8
;; unicode identifier char) is accepted so unicode group names like (?<π>…) aren't rejected.
(func $re_id_start (param $c i32) (result i32) (effects)
  (if (call $re_isletter (local.get $c)) (then (return (i32.const 1))))
  (if (i32.eq (local.get $c) (i32.const 95)) (then (return (i32.const 1))))  ;; _
  (if (i32.eq (local.get $c) (i32.const 36)) (then (return (i32.const 1))))  ;; $
  (i32.ge_u (local.get $c) (i32.const 128)))
;; IdentifierPart: IdentifierStart + ASCII digit
(func $re_id_part (param $c i32) (result i32) (effects)
  (if (call $re_id_start (local.get $c)) (then (return (i32.const 1))))
  (i32.and (i32.ge_s (local.get $c) (i32.const 48)) (i32.le_s (local.get $c) (i32.const 57))))
(func $re_ishex (param $c i32) (result i32) (effects)  ;; 0-9 a-f A-F
  (if (i32.and (i32.ge_s (local.get $c) (i32.const 48)) (i32.le_s (local.get $c) (i32.const 57))) (then (return (i32.const 1))))
  (if (i32.and (i32.ge_s (local.get $c) (i32.const 97)) (i32.le_s (local.get $c) (i32.const 102))) (then (return (i32.const 1))))
  (i32.and (i32.ge_s (local.get $c) (i32.const 65)) (i32.le_s (local.get $c) (i32.const 70))))
;; single-char escapes valid as CharacterEscape/CharacterClassEscape in BOTH atom and class: f n r t v d D s S w W
(func $re_esc_simple_ok (param $c i32) (result i32) (effects)
  (if (call $re_byte_in (local.get $c) (i32.const 102)) (then (return (i32.const 1))))  ;; f
  (if (call $re_byte_in (local.get $c) (i32.const 110)) (then (return (i32.const 1))))  ;; n
  (if (call $re_byte_in (local.get $c) (i32.const 114)) (then (return (i32.const 1))))  ;; r
  (if (call $re_byte_in (local.get $c) (i32.const 116)) (then (return (i32.const 1))))  ;; t
  (if (call $re_byte_in (local.get $c) (i32.const 118)) (then (return (i32.const 1))))  ;; v
  (if (call $re_byte_in (local.get $c) (i32.const 100)) (then (return (i32.const 1))))  ;; d
  (if (call $re_byte_in (local.get $c) (i32.const 68)) (then (return (i32.const 1))))   ;; D
  (if (call $re_byte_in (local.get $c) (i32.const 115)) (then (return (i32.const 1))))  ;; s
  (if (call $re_byte_in (local.get $c) (i32.const 83)) (then (return (i32.const 1))))   ;; S
  (if (call $re_byte_in (local.get $c) (i32.const 119)) (then (return (i32.const 1))))  ;; w
  (if (call $re_byte_in (local.get $c) (i32.const 87)) (then (return (i32.const 1))))   ;; W
  (i32.const 0))
;; CharacterClassEscape: d D s S w W (+ p P property escapes) — NOT a valid endpoint of a class range
(func $re_is_cce (param $c i32) (result i32) (effects)
  (if (call $re_byte_in (local.get $c) (i32.const 100)) (then (return (i32.const 1))))  ;; d
  (if (call $re_byte_in (local.get $c) (i32.const 68)) (then (return (i32.const 1))))   ;; D
  (if (call $re_byte_in (local.get $c) (i32.const 115)) (then (return (i32.const 1))))  ;; s
  (if (call $re_byte_in (local.get $c) (i32.const 83)) (then (return (i32.const 1))))   ;; S
  (if (call $re_byte_in (local.get $c) (i32.const 119)) (then (return (i32.const 1))))  ;; w
  (if (call $re_byte_in (local.get $c) (i32.const 87)) (then (return (i32.const 1))))   ;; W
  (if (call $re_byte_in (local.get $c) (i32.const 112)) (then (return (i32.const 1))))  ;; p
  (if (call $re_byte_in (local.get $c) (i32.const 80)) (then (return (i32.const 1))))   ;; P
  (i32.const 0))
;; SyntaxCharacter identity escape (^ $ \ . * + ? ( ) [ ] { } |) + '/'
(func $re_esc_syntaxchar (param $c i32) (result i32) (effects)
  (if (call $re_byte_in (local.get $c) (i32.const 94)) (then (return (i32.const 1))))   ;; ^
  (if (call $re_byte_in (local.get $c) (i32.const 36)) (then (return (i32.const 1))))   ;; $
  (if (call $re_byte_in (local.get $c) (i32.const 92)) (then (return (i32.const 1))))   ;; backslash
  (if (call $re_byte_in (local.get $c) (i32.const 46)) (then (return (i32.const 1))))   ;; .
  (if (call $re_byte_in (local.get $c) (i32.const 42)) (then (return (i32.const 1))))   ;; *
  (if (call $re_byte_in (local.get $c) (i32.const 43)) (then (return (i32.const 1))))   ;; +
  (if (call $re_byte_in (local.get $c) (i32.const 63)) (then (return (i32.const 1))))   ;; ?
  (if (call $re_byte_in (local.get $c) (i32.const 40)) (then (return (i32.const 1))))   ;; (
  (if (call $re_byte_in (local.get $c) (i32.const 41)) (then (return (i32.const 1))))   ;; )
  (if (call $re_byte_in (local.get $c) (i32.const 91)) (then (return (i32.const 1))))   ;; [
  (if (call $re_byte_in (local.get $c) (i32.const 93)) (then (return (i32.const 1))))   ;; ]
  (if (call $re_byte_in (local.get $c) (i32.const 123)) (then (return (i32.const 1))))  ;; {
  (if (call $re_byte_in (local.get $c) (i32.const 125)) (then (return (i32.const 1))))  ;; }
  (if (call $re_byte_in (local.get $c) (i32.const 124)) (then (return (i32.const 1))))  ;; |
  (if (call $re_byte_in (local.get $c) (i32.const 47)) (then (return (i32.const 1))))   ;; /
  (i32.const 0))

;; --- \p{...} UnicodeProperty validation (u-mode). Data tables are absent so matching
;; returns false, but the property NAME/VALUE grammar is validated: an unsupported or
;; misspelled property is a SyntaxError (test262 property-escapes negative tests). ---

;; compare $len bytes: $a[$as..] vs $b[$bs..]
(func $re_bytes_eq (param $a i32) (param $as i32) (param $b i32) (param $bs i32) (param $len i32) (result i32) (effects)
  (let $k i32 (i32.const 0))
  (loop $lp
    (if (i32.ge_s (local.get $k) (local.get $len)) (then (return (i32.const 1))))
    (if (i32.ne (call $str_byte (local.get $a) (i32.add (local.get $as) (local.get $k)))
                (call $str_byte (local.get $b) (i32.add (local.get $bs) (local.get $k))))
      (then (return (i32.const 0))))
    (set! $k (i32.add (local.get $k) (i32.const 1)))
    (br $lp))
  (i32.const 0))

;; is $pat[$s..$e) present as a whole segment in the '|'-delimited list cstring $list?
(func $re_dlist_has (param $pat i32) (param $s i32) (param $e i32) (param $list i32) (result i32) (effects)
  (let $len i32 (i32.sub (local.get $e) (local.get $s)))
  (let $ll i32 (call $str_len (local.get $list)))
  (let $i i32 (i32.const 0))
  (loop $lp
    (if (i32.ge_s (local.get $i) (local.get $ll)) (then (return (i32.const 0))))
    (if (i32.eq (call $str_byte (local.get $list) (local.get $i)) (i32.const 124))  ;; '|'
      (then
        (let $segs i32 (i32.add (local.get $i) (i32.const 1)))
        (let $j i32 (local.get $segs))
        (loop $fl
          (if (i32.lt_s (local.get $j) (local.get $ll))
            (then
              (if (i32.ne (call $str_byte (local.get $list) (local.get $j)) (i32.const 124))
                (then (set! $j (i32.add (local.get $j) (i32.const 1))) (br $fl))))))
        (if (i32.and (i32.ne (local.get $len) (i32.const 0))
                     (i32.eq (i32.sub (local.get $j) (local.get $segs)) (local.get $len)))
          (then
            (if (call $re_bytes_eq (local.get $pat) (local.get $s) (local.get $list) (local.get $segs) (local.get $len))
              (then (return (i32.const 1))))))
        (set! $i (local.get $j)))
      (else (set! $i (i32.add (local.get $i) (i32.const 1)))))
    (br $lp))
  (i32.const 0))

;; are all of $pat[$s..$e) UnicodePropertyValue chars [A-Za-z0-9_], and non-empty?
(func $re_prop_ident_ok (param $pat i32) (param $s i32) (param $e i32) (result i32) (effects)
  (if (i32.ge_s (local.get $s) (local.get $e)) (then (return (i32.const 0))))
  (let $k i32 (local.get $s))
  (loop $lp
    (if (i32.lt_s (local.get $k) (local.get $e))
      (then
        (let $c i32 (call $str_byte (local.get $pat) (local.get $k)))
        (if (i32.eqz (i32.or
              (i32.or
                (i32.and (i32.ge_s (local.get $c) (i32.const 65)) (i32.le_s (local.get $c) (i32.const 90)))
                (i32.and (i32.ge_s (local.get $c) (i32.const 97)) (i32.le_s (local.get $c) (i32.const 122))))
              (i32.or
                (i32.and (i32.ge_s (local.get $c) (i32.const 48)) (i32.le_s (local.get $c) (i32.const 57)))
                (i32.eq (local.get $c) (i32.const 95)))))
          (then (return (i32.const 0))))
        (set! $k (i32.add (local.get $k) (i32.const 1)))
        (br $lp))))
  (i32.const 1))

;; supported binary Unicode property names (canonical + aliases)
(func $re_prop_bin_list (result i32) (effects)
  (cstring "|ASCII|ASCII_Hex_Digit|AHex|Alphabetic|Alpha|Any|Assigned|Bidi_Control|Bidi_C|Bidi_Mirrored|Bidi_M|Case_Ignorable|CI|Cased|Changes_When_Casefolded|CWCF|Changes_When_Casemapped|CWCM|Changes_When_Lowercased|CWL|Changes_When_NFKC_Casefolded|CWKCF|Changes_When_Titlecased|CWT|Changes_When_Uppercased|CWU|Dash|Default_Ignorable_Code_Point|DI|Deprecated|Dep|Diacritic|Dia|Emoji|Emoji_Component|EComp|Emoji_Modifier|EMod|Emoji_Modifier_Base|EBase|Emoji_Presentation|EPres|Extended_Pictographic|ExtPict|Extender|Ext|Grapheme_Base|Gr_Base|Grapheme_Extend|Gr_Ext|Hex_Digit|Hex|IDS_Binary_Operator|IDSB|IDS_Trinary_Operator|IDST|ID_Continue|IDC|ID_Start|IDS|Ideographic|Ideo|Join_Control|Join_C|Logical_Order_Exception|LOE|Lowercase|Lower|Math|Noncharacter_Code_Point|NChar|Pattern_Syntax|Pat_Syn|Pattern_White_Space|Pat_WS|Quotation_Mark|QMark|Radical|Regional_Indicator|RI|Sentence_Terminal|STerm|Soft_Dotted|SD|Terminal_Punctuation|Term|Unified_Ideograph|UIdeo|Uppercase|Upper|Variation_Selector|VS|White_Space|space|XID_Continue|XIDC|XID_Start|XIDS|"))

;; supported General_Category values (canonical + aliases)
(func $re_prop_gc_list (result i32) (effects)
  (cstring "|Cased_Letter|LC|Close_Punctuation|Pe|Connector_Punctuation|Pc|Control|Cc|cntrl|Currency_Symbol|Sc|Dash_Punctuation|Pd|Decimal_Number|Nd|digit|Enclosing_Mark|Me|Final_Punctuation|Pf|Format|Cf|Initial_Punctuation|Pi|Letter|L|Letter_Number|Nl|Line_Separator|Zl|Lowercase_Letter|Ll|Mark|Combining_Mark|M|Math_Symbol|Sm|Modifier_Letter|Lm|Modifier_Symbol|Sk|Nonspacing_Mark|Mn|Number|N|Open_Punctuation|Ps|Other|C|Other_Letter|Lo|Other_Number|No|Other_Punctuation|Po|Other_Symbol|So|Paragraph_Separator|Zp|Private_Use|Co|Punctuation|P|punct|Separator|Z|Space_Separator|Zs|Spacing_Mark|Mc|Surrogate|Cs|Symbol|S|Titlecase_Letter|Lt|Unassigned|Cn|Uppercase_Letter|Lu|"))

;; validate the content between \p{ and }: $pat[$cs..$ce). Throws SyntaxError if the
;; property name/value is not a supported UnicodePropertyExpression.
(func $re_validate_prop (param $pat i32) (param $cs i32) (param $ce i32) (effects)
  (if (i32.ge_s (local.get $cs) (local.get $ce))
    (then (call $throw_type (cstring "SyntaxError") (cstring "Invalid property name")) (return)))
  ;; locate '='
  (let $eq i32 (i32.const -1))
  (let $i i32 (local.get $cs))
  (loop $lp
    (if (i32.lt_s (local.get $i) (local.get $ce))
      (then
        (if (i32.eq (call $str_byte (local.get $pat) (local.get $i)) (i32.const 61))  ;; '='
          (then (set! $eq (local.get $i)))
          (else (set! $i (i32.add (local.get $i) (i32.const 1))) (br $lp))))))
  (if (i32.ge_s (local.get $eq) (i32.const 0))
    (then
      ;; PropertyName=PropertyValue form
      (let $ve i32 (i32.add (local.get $eq) (i32.const 1)))
      (if (i32.eqz (call $re_prop_ident_ok (local.get $pat) (local.get $ve) (local.get $ce)))
        (then (call $throw_type (cstring "SyntaxError") (cstring "Invalid property value")) (return)))
      (if (call $re_dlist_has (local.get $pat) (local.get $cs) (local.get $eq) (cstring "|General_Category|gc|"))
        (then
          (if (i32.eqz (call $re_dlist_has (local.get $pat) (local.get $ve) (local.get $ce) (call $re_prop_gc_list)))
            (then (call $throw_type (cstring "SyntaxError") (cstring "Invalid property value")) (return)))
          (return)))
      (if (call $re_dlist_has (local.get $pat) (local.get $cs) (local.get $eq) (cstring "|Script|sc|Script_Extensions|scx|"))
        (then (return)))  ;; Script/scx: no data table; accept any well-formed value
      (call $throw_type (cstring "SyntaxError") (cstring "Invalid property key")) (return))
    (else
      ;; LoneUnicodePropertyNameOrValue: binary property OR General_Category value
      (if (i32.eqz (call $re_prop_ident_ok (local.get $pat) (local.get $cs) (local.get $ce)))
        (then (call $throw_type (cstring "SyntaxError") (cstring "Invalid property name")) (return)))
      (if (call $re_dlist_has (local.get $pat) (local.get $cs) (local.get $ce) (call $re_prop_bin_list))
        (then (return)))
      (if (call $re_dlist_has (local.get $pat) (local.get $cs) (local.get $ce) (call $re_prop_gc_list))
        (then (return)))
      (call $throw_type (cstring "SyntaxError") (cstring "Invalid property name")) (return))))
;; u-mode escape consumer. $pos = index of the char right AFTER the backslash; $inclass=1 inside [...].
;; Returns the index AFTER the whole escape. On an invalid u-mode escape, throws SyntaxError and
;; returns $pos (caller must check $err). Compound escapes (\c \x \u \p \P \k) require their
;; continuation — a BARE prefix is a SyntaxError, unlike sloppy mode.
(func $re_uesc_consume (param $pat i32) (param $n i32) (param $pos i32) (param $inclass i32) (result i32) (effects)
  (if (i32.ge_s (local.get $pos) (local.get $n))
    (then (call $throw_type (cstring "SyntaxError") (cstring "\\ at end of pattern")) (return (local.get $pos))))
  (let $c i32 (call $str_byte (local.get $pat) (local.get $pos)))
  ;; f n r t v d D s S w W — always valid, one char
  (if (call $re_esc_simple_ok (local.get $c)) (then (return (i32.add (local.get $pos) (i32.const 1)))))
  ;; b — valid in both (atom: \b assertion; class: backspace)
  (if (i32.eq (local.get $c) (i32.const 98)) (then (return (i32.add (local.get $pos) (i32.const 1)))))
  ;; B — valid only in atom (\B assertion); invalid inside a class
  (if (i32.eq (local.get $c) (i32.const 66))
    (then (if (local.get $inclass) (then (call $throw_type (cstring "SyntaxError") (cstring "Invalid class escape \\B")) (return (local.get $pos))))
          (return (i32.add (local.get $pos) (i32.const 1)))))
  ;; SyntaxCharacter / '/' identity escape — one char
  (if (call $re_esc_syntaxchar (local.get $c)) (then (return (i32.add (local.get $pos) (i32.const 1)))))
  ;; '-' — valid ClassEscape only inside a class
  (if (i32.eq (local.get $c) (i32.const 45))
    (then (if (local.get $inclass) (then (return (i32.add (local.get $pos) (i32.const 1)))))))
  ;; \0 (not followed by a digit) = NUL, valid in both atom and class. A LegacyOctalEscape (\0 followed
  ;; by a digit) is invalid in u-mode.
  (if (i32.eq (local.get $c) (i32.const 48))  ;; '0'
    (then
      (let $nx i32 (i32.add (local.get $pos) (i32.const 1)))
      (if (i32.and (i32.lt_s (local.get $nx) (local.get $n))
                   (i32.and (i32.ge_s (call $str_byte (local.get $pat) (local.get $nx)) (i32.const 48)) (i32.le_s (call $str_byte (local.get $pat) (local.get $nx)) (i32.const 57))))
        (then (call $throw_type (cstring "SyntaxError") (cstring "Invalid octal escape in unicode pattern")) (return (local.get $pos))))
      (return (i32.add (local.get $pos) (i32.const 1)))))
  ;; \1-\9 : a DecimalEscape (backreference) in an ATOM — valid form here, the caller range-checks it.
  ;; Inside a class it is NOT a valid ClassEscape (no backrefs / legacy octal) — SyntaxError.
  (if (i32.and (i32.ge_s (local.get $c) (i32.const 49)) (i32.le_s (local.get $c) (i32.const 57)))
    (then
      (if (local.get $inclass) (then (call $throw_type (cstring "SyntaxError") (cstring "Invalid class escape: decimal in unicode pattern")) (return (local.get $pos))))
      (return (i32.add (local.get $pos) (i32.const 1)))))
  ;; \c ControlLetter
  (if (i32.eq (local.get $c) (i32.const 99))
    (then
      (if (i32.and (i32.lt_s (i32.add (local.get $pos) (i32.const 1)) (local.get $n))
                   (call $re_isletter (call $str_byte (local.get $pat) (i32.add (local.get $pos) (i32.const 1)))))
        (then (return (i32.add (local.get $pos) (i32.const 2)))))
      (call $throw_type (cstring "SyntaxError") (cstring "Invalid \\c escape")) (return (local.get $pos))))
  ;; \x HexDigit HexDigit
  (if (i32.eq (local.get $c) (i32.const 120))
    (then
      (if (i32.and (i32.lt_s (i32.add (local.get $pos) (i32.const 2)) (local.get $n))
                   (i32.and (call $re_ishex (call $str_byte (local.get $pat) (i32.add (local.get $pos) (i32.const 1))))
                            (call $re_ishex (call $str_byte (local.get $pat) (i32.add (local.get $pos) (i32.const 2))))))
        (then (return (i32.add (local.get $pos) (i32.const 3)))))
      (call $throw_type (cstring "SyntaxError") (cstring "Invalid \\x escape")) (return (local.get $pos))))
  ;; \u RegExpUnicodeEscapeSequence: u{ Hex+ } | u HexHexHexHex
  (if (i32.eq (local.get $c) (i32.const 117))
    (then
      (let $p1 i32 (i32.add (local.get $pos) (i32.const 1)))
      (if (i32.and (i32.lt_s (local.get $p1) (local.get $n)) (i32.eq (call $str_byte (local.get $pat) (local.get $p1)) (i32.const 123)))  ;; u{...}
        (then
          (let $uj i32 (i32.add (local.get $p1) (i32.const 1)))
          (let $uh i32 (i32.const 0))
          (block $ue (loop $ul
            (br_if $ue (i32.ge_s (local.get $uj) (local.get $n)))
            (let $ucc i32 (call $str_byte (local.get $pat) (local.get $uj)))
            (if (i32.eq (local.get $ucc) (i32.const 125)) (then (br $ue)))  ;; '}'
            (if (i32.eqz (call $re_ishex (local.get $ucc))) (then (call $throw_type (cstring "SyntaxError") (cstring "Invalid \\u{} escape")) (return (local.get $pos))))
            (set! $uh (i32.add (local.get $uh) (i32.const 1))) (set! $uj (i32.add (local.get $uj) (i32.const 1))) (br $ul)))
          (if (i32.or (i32.ge_s (local.get $uj) (local.get $n)) (i32.eqz (local.get $uh)))
            (then (call $throw_type (cstring "SyntaxError") (cstring "Invalid \\u{} escape")) (return (local.get $pos))))
          (return (i32.add (local.get $uj) (i32.const 1)))))  ;; past '}'
      ;; u HHHH — four hex digits
      (if (i32.and (i32.lt_s (i32.add (local.get $pos) (i32.const 4)) (local.get $n))
                   (i32.and (call $re_ishex (call $str_byte (local.get $pat) (i32.add (local.get $pos) (i32.const 1))))
                   (i32.and (call $re_ishex (call $str_byte (local.get $pat) (i32.add (local.get $pos) (i32.const 2))))
                   (i32.and (call $re_ishex (call $str_byte (local.get $pat) (i32.add (local.get $pos) (i32.const 3))))
                            (call $re_ishex (call $str_byte (local.get $pat) (i32.add (local.get $pos) (i32.const 4))))))))
        (then (return (i32.add (local.get $pos) (i32.const 5)))))
      (call $throw_type (cstring "SyntaxError") (cstring "Invalid \\u escape")) (return (local.get $pos))))
  ;; \p{...} / \P{...} — UnicodePropertyValueExpression (invalid inside a class only for lone \p; \p{} is valid in both)
  (if (i32.or (i32.eq (local.get $c) (i32.const 112)) (i32.eq (local.get $c) (i32.const 80)))
    (then
      (let $pp1 i32 (i32.add (local.get $pos) (i32.const 1)))
      (if (i32.and (i32.lt_s (local.get $pp1) (local.get $n)) (i32.eq (call $str_byte (local.get $pat) (local.get $pp1)) (i32.const 123)))
        (then
          (let $pj i32 (i32.add (local.get $pp1) (i32.const 1)))
          (block $ppe (loop $ppl
            (br_if $ppe (i32.ge_s (local.get $pj) (local.get $n)))
            (if (i32.eq (call $str_byte (local.get $pat) (local.get $pj)) (i32.const 125)) (then (br $ppe)))
            (set! $pj (i32.add (local.get $pj) (i32.const 1))) (br $ppl)))
          (if (i32.ge_s (local.get $pj) (local.get $n)) (then (call $throw_type (cstring "SyntaxError") (cstring "Invalid \\p{} escape")) (return (local.get $pos))))
          (call $re_validate_prop (local.get $pat) (i32.add (local.get $pp1) (i32.const 1)) (local.get $pj))
          (return (i32.add (local.get $pj) (i32.const 1)))))  ;; past '}'
      (call $throw_type (cstring "SyntaxError") (cstring "Invalid \\p escape")) (return (local.get $pos))))
  ;; \k GroupName — named backreference (atom only; invalid inside a class)
  (if (i32.eq (local.get $c) (i32.const 107))
    (then
      (if (local.get $inclass) (then (call $throw_type (cstring "SyntaxError") (cstring "Invalid class escape \\k")) (return (local.get $pos))))
      (let $kp1 i32 (i32.add (local.get $pos) (i32.const 1)))
      (if (i32.and (i32.lt_s (local.get $kp1) (local.get $n)) (i32.eq (call $str_byte (local.get $pat) (local.get $kp1)) (i32.const 60)))  ;; '<'
        (then
          (let $kj i32 (i32.add (local.get $kp1) (i32.const 1)))
          (block $ke (loop $kl
            (br_if $ke (i32.ge_s (local.get $kj) (local.get $n)))
            (if (i32.eq (call $str_byte (local.get $pat) (local.get $kj)) (i32.const 62)) (then (br $ke)))  ;; '>'
            (set! $kj (i32.add (local.get $kj) (i32.const 1))) (br $kl)))
          (if (i32.ge_s (local.get $kj) (local.get $n)) (then (call $throw_type (cstring "SyntaxError") (cstring "Invalid \\k<> escape")) (return (local.get $pos))))
          (return (i32.add (local.get $kj) (i32.const 1)))))  ;; past '>'
      (call $throw_type (cstring "SyntaxError") (cstring "Invalid \\k escape")) (return (local.get $pos))))
  ;; anything else (incl. an alphabetic char A-Z/a-z not matched above) — invalid u-mode IdentityEscape
  (call $throw_type (cstring "SyntaxError") (cstring "Invalid escape in unicode pattern")) (local.get $pos))

;; validate RegExp flags: each must be one of d/g/i/m/s/u/v/y, no duplicates, and u+v are mutually
;; exclusive → SyntaxError (throws; mirrors the runtime check in eval.watx). Used at parse time so a
;; RegularExpressionLiteral with bad flags is an early error.
(func $re_check_flags (param $flg i32) (effects)
  (let $fl i32 (call $str_len (local.get $flg)))
  (let $fi i32 (i32.const 0))
  (let $fseen i32 (i32.const 0))
  (block $fve (loop $fvl
    (br_if $fve (i32.ge_s (local.get $fi) (local.get $fl)))
    (let $fc i32 (call $str_byte (local.get $flg) (local.get $fi)))
    (let $fbit i32 (i32.const 0))
    (if (i32.eq (local.get $fc) (i32.const 103)) (then (set! $fbit (i32.const 1))))    ;; g
    (if (i32.eq (local.get $fc) (i32.const 105)) (then (set! $fbit (i32.const 2))))    ;; i
    (if (i32.eq (local.get $fc) (i32.const 109)) (then (set! $fbit (i32.const 4))))    ;; m
    (if (i32.eq (local.get $fc) (i32.const 115)) (then (set! $fbit (i32.const 8))))    ;; s
    (if (i32.eq (local.get $fc) (i32.const 117)) (then (set! $fbit (i32.const 16))))   ;; u
    (if (i32.eq (local.get $fc) (i32.const 121)) (then (set! $fbit (i32.const 32))))   ;; y
    (if (i32.eq (local.get $fc) (i32.const 100)) (then (set! $fbit (i32.const 64))))   ;; d
    (if (i32.eq (local.get $fc) (i32.const 118)) (then (set! $fbit (i32.const 128))))  ;; v
    (if (i32.or (i32.eqz (local.get $fbit)) (i32.and (local.get $fseen) (local.get $fbit)))
      (then (call $throw_type (cstring "SyntaxError") (cstring "Invalid regular expression flags")) (return)))
    (set! $fseen (i32.or (local.get $fseen) (local.get $fbit)))
    (set! $fi (i32.add (local.get $fi) (i32.const 1)))
    (br $fvl)))
  (if (i32.eq (i32.and (local.get $fseen) (i32.const 144)) (i32.const 144))
    (then (call $throw_type (cstring "SyntaxError") (cstring "Invalid regular expression flags: u and v cannot be combined")) (return))))

(func $re_check_quant (param $pat i32) (param $ustrict i32) (effects)  ;; $ustrict=1 for `u`/`v` mode (stricter syntax)
  (let $n i32 (call $str_len (local.get $pat)))
  (let $i i32 (i32.const 0))
  (let $st i32 (i32.const 0))
  (let $depth i32 (i32.const 0))  ;; open '(' groups
  (let $astk i32 (i32.const 0))  ;; bit N set = the group open at level N is a lookahead/lookbehind ASSERTION (up to 32 levels)
  (let $lbstk i32 (i32.const 0))  ;; bit N set = that assertion is a LOOKBEHIND (never quantifiable, any mode)
  (let $ngroups i32 (if i32 (local.get $ustrict) (then (call $re_count_groups (local.get $pat) (local.get $n))) (else (i32.const 0))))  ;; u-mode: for backref-count validation
  (let $hasnamed i32 (call $re_has_named (local.get $pat) (local.get $n)))  ;; pattern has a named group → `\k` is a mandatory named backref (all modes)
  (if (local.get $hasnamed) (then (call $re_check_dup_names (local.get $pat) (local.get $n)) (if (call $err) (then (return)))))  ;; two same-named groups that can both participate → SyntaxError
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    (let $c i32 (call $str_byte (local.get $pat) (local.get $i)))
    (if (i32.eq (local.get $c) (i32.const 92))  ;; '\' escaped atom
      (then
        (if (i32.ge_s (i32.add (local.get $i) (i32.const 1)) (local.get $n)) (then (call $throw_type (cstring "SyntaxError") (cstring "\\ at end of pattern")) (return)))  ;; trailing backslash
        (let $esc1 i32 (call $str_byte (local.get $pat) (i32.add (local.get $i) (i32.const 1))))
        ;; \k named backreference: when the pattern has a named group, `\k` MUST be `\k<name>` referencing
        ;; an EXISTING group (all modes; forward refs valid). Bare/incomplete `\k` or a dangling/empty name
        ;; is a SyntaxError. (Without named groups, sloppy `\k` is a literal 'k' — the fallthrough below.)
        (if (i32.and (i32.eq (local.get $esc1) (i32.const 107)) (local.get $hasnamed))
          (then
            (if (i32.or (i32.ge_s (i32.add (local.get $i) (i32.const 2)) (local.get $n)) (i32.ne (call $str_byte (local.get $pat) (i32.add (local.get $i) (i32.const 2))) (i32.const 60)))  ;; not `\k<`
              (then (call $throw_type (cstring "SyntaxError") (cstring "Invalid \\k named backreference")) (return)))
            (let $kns i32 (i32.add (local.get $i) (i32.const 3)))
            (let $kne i32 (local.get $kns))
            (block $kve (loop $kvl
              (if (i32.ge_s (local.get $kne) (local.get $n)) (then (call $throw_type (cstring "SyntaxError") (cstring "Unterminated \\k<name>")) (return)))
              (if (i32.eq (call $str_byte (local.get $pat) (local.get $kne)) (i32.const 62)) (then (br $kve)))
              (set! $kne (i32.add (local.get $kne) (i32.const 1))) (br $kvl)))
            (if (i32.eq (local.get $kne) (local.get $kns)) (then (call $throw_type (cstring "SyntaxError") (cstring "Empty \\k<name>")) (return)))
            (if (i32.eqz (call $re_named_group_exists (local.get $pat) (local.get $n) (local.get $kns) (local.get $kne)))
              (then (call $throw_type (cstring "SyntaxError") (cstring "\\k reference to a non-existent group")) (return)))
            (set! $st (i32.const 1)) (set! $i (i32.add (local.get $kne) (i32.const 1))) (br $l)))
        ;; u/v mode: validate the escape FORM (compound escapes \c \x \u \p \P \k require their
        ;; continuation) and advance past the WHOLE escape via $re_uesc_consume. A bare `\A`/`\c`/`\p`
        ;; etc. is a SyntaxError (sloppy mode allows any IdentityEscape — the fallthrough below).
        (if (local.get $ustrict)
          (then
            (let $adv i32 (call $re_uesc_consume (local.get $pat) (local.get $n) (i32.add (local.get $i) (i32.const 1)) (i32.const 0)))
            (if (call $err) (then (return)))
            ;; a decimal escape `\<n>` (n≥1) is a backreference — SyntaxError if n exceeds the group count
            (if (i32.and (i32.ge_s (local.get $esc1) (i32.const 49)) (i32.le_s (local.get $esc1) (i32.const 57)))  ;; 1-9
              (then
                (let $bn i32 (i32.const 0))
                (let $bj i32 (i32.add (local.get $i) (i32.const 1)))
                (block $bne (loop $bnl
                  (br_if $bne (i32.ge_s (local.get $bj) (local.get $n)))
                  (let $bd i32 (call $str_byte (local.get $pat) (local.get $bj)))
                  (br_if $bne (i32.or (i32.lt_s (local.get $bd) (i32.const 48)) (i32.gt_s (local.get $bd) (i32.const 57))))
                  (set! $bn (i32.add (i32.mul (local.get $bn) (i32.const 10)) (i32.sub (local.get $bd) (i32.const 48))))
                  (set! $bj (i32.add (local.get $bj) (i32.const 1))) (br $bnl)))
                (if (i32.gt_s (local.get $bn) (local.get $ngroups))
                  (then (call $throw_type (cstring "SyntaxError") (cstring "Invalid regular expression: backreference to non-existent group")) (return)))))
            (set! $st (i32.const 1)) (set! $i (local.get $adv)) (br $l)))
        ;; sloppy mode: `\p{...}` / `\P{...}` → skip the whole `{...}` so its '{' is not read as a quantifier
        (if (i32.and (i32.or (i32.eq (local.get $esc1) (i32.const 112)) (i32.eq (local.get $esc1) (i32.const 80)))
                     (i32.and (i32.lt_s (i32.add (local.get $i) (i32.const 2)) (local.get $n)) (i32.eq (call $str_byte (local.get $pat) (i32.add (local.get $i) (i32.const 2))) (i32.const 123))))
          (then
            (set! $i (i32.add (local.get $i) (i32.const 3)))  ;; past `\p{`
            (block $pce (loop $pcl
              (br_if $pce (i32.ge_s (local.get $i) (local.get $n)))
              (let $pcc i32 (call $str_byte (local.get $pat) (local.get $i)))
              (set! $i (i32.add (local.get $i) (i32.const 1)))
              (br_if $pce (i32.eq (local.get $pcc) (i32.const 125)))  ;; '}'
              (br $pcl)))
            (set! $st (i32.const 1)) (br $l)))
        (set! $st (i32.const 1)) (set! $i (i32.add (local.get $i) (i32.const 2))) (br $l)))
    (if (i32.eq (local.get $c) (i32.const 91))  ;; '[' char class
      (then
        (set! $i (i32.add (local.get $i) (i32.const 1)))
        (let $closed i32 (i32.const 0))
        (let $prevatom i32 (i32.const 0))  ;; a left class-atom is pending (candidate range LHS)
        (let $prevcce i32 (i32.const 0))   ;; that pending atom is a CharacterClassEscape
        (let $penddash i32 (i32.const 0))  ;; a '-' range operator is pending; the next atom is the RHS
        (let $dashcce i32 (i32.const 0))   ;; the range LHS was a CCE
        ;; a leading '^' negates the class and is not itself a class-atom
        (if (i32.and (i32.lt_s (local.get $i) (local.get $n)) (i32.eq (call $str_byte (local.get $pat) (local.get $i)) (i32.const 94)))
          (then (set! $i (i32.add (local.get $i) (i32.const 1)))))
        (block $ce (loop $cl
          (br_if $ce (i32.ge_s (local.get $i) (local.get $n)))
          (let $cc i32 (call $str_byte (local.get $pat) (local.get $i)))
          (if (i32.eq (local.get $cc) (i32.const 93)) (then (set! $closed (i32.const 1)) (set! $i (i32.add (local.get $i) (i32.const 1))) (br $ce)))  ;; ']' closes
          ;; '-' between two atoms is a RANGE operator; otherwise a literal '-'
          (if (i32.eq (local.get $cc) (i32.const 45))
            (then
              (if (i32.and (local.get $prevatom) (i32.and (i32.lt_s (i32.add (local.get $i) (i32.const 1)) (local.get $n)) (i32.ne (call $str_byte (local.get $pat) (i32.add (local.get $i) (i32.const 1))) (i32.const 93))))
                (then (set! $penddash (i32.const 1)) (set! $dashcce (local.get $prevcce)) (set! $prevatom (i32.const 0)) (set! $i (i32.add (local.get $i) (i32.const 1))) (br $cl))
                (else (set! $prevatom (i32.const 1)) (set! $prevcce (i32.const 0)) (set! $i (i32.add (local.get $i) (i32.const 1))) (br $cl)))))
          ;; consume ONE class-atom; $atomcce = whether it is a CharacterClassEscape
          (let $atomcce i32 (i32.const 0))
          (if (i32.eq (local.get $cc) (i32.const 92))  ;; '\' escape inside the class
            (then
              (if (i32.lt_s (i32.add (local.get $i) (i32.const 1)) (local.get $n)) (then (set! $atomcce (call $re_is_cce (call $str_byte (local.get $pat) (i32.add (local.get $i) (i32.const 1)))))))
              (if (local.get $ustrict)
                (then (set! $i (call $re_uesc_consume (local.get $pat) (local.get $n) (i32.add (local.get $i) (i32.const 1)) (i32.const 1))) (if (call $err) (then (return))))
                (else (set! $i (i32.add (local.get $i) (i32.const 2))))))
            (else (set! $i (i32.add (local.get $i) (i32.const 1)))))  ;; single-character atom
          ;; if a '-' range was pending, this atom is the RHS endpoint — a CCE on either side is invalid in u-mode
          (if (local.get $penddash)
            (then
              (if (i32.and (local.get $ustrict) (i32.or (local.get $dashcce) (local.get $atomcce)))
                (then (call $throw_type (cstring "SyntaxError") (cstring "Invalid character class range in unicode pattern")) (return)))
              (set! $penddash (i32.const 0)) (set! $prevatom (i32.const 0)) (set! $prevcce (i32.const 0)))
            (else (set! $prevatom (i32.const 1)) (set! $prevcce (local.get $atomcce))))
          (br $cl)))
        (if (i32.eqz (local.get $closed)) (then (call $throw_type (cstring "SyntaxError") (cstring "Unterminated character class")) (return)))
        (set! $st (i32.const 1)) (br $l)))
    (if (i32.eq (local.get $c) (i32.const 40))  ;; '(' open group (skip (?: (?= (?! (?<= (?<! (?<name>)
      (then
        (set! $i (i32.add (local.get $i) (i32.const 1)))
        (let $isassert i32 (i32.const 0))  ;; 1 if this group is a lookahead/lookbehind assertion
        (let $islb i32 (i32.const 0))       ;; 1 if this group is a lookbehind assertion specifically
        (if (i32.and (i32.lt_s (local.get $i) (local.get $n)) (i32.eq (call $str_byte (local.get $pat) (local.get $i)) (i32.const 63)))  ;; '?'
          (then
            (set! $i (i32.add (local.get $i) (i32.const 1)))
            (if (i32.and (i32.lt_s (local.get $i) (local.get $n)) (i32.eq (call $str_byte (local.get $pat) (local.get $i)) (i32.const 60)))  ;; '<'
              (then
                (set! $i (i32.add (local.get $i) (i32.const 1)))
                ;; `(?<=` / `(?<!` are lookbehind ASSERTIONS; `(?<name>` is a named capture (the '=' / '!' path is skipped)
                (if (i32.and (i32.lt_s (local.get $i) (local.get $n)) (i32.or (i32.eq (call $str_byte (local.get $pat) (local.get $i)) (i32.const 61)) (i32.eq (call $str_byte (local.get $pat) (local.get $i)) (i32.const 33))))
                  (then (set! $isassert (i32.const 1)) (set! $islb (i32.const 1))))
                (if (i32.and (i32.lt_s (local.get $i) (local.get $n)) (i32.eqz (i32.or (i32.eq (call $str_byte (local.get $pat) (local.get $i)) (i32.const 61)) (i32.eq (call $str_byte (local.get $pat) (local.get $i)) (i32.const 33)))))
                  ;; `(?<name>` — validate the RegExpIdentifierName: non-empty, IdentifierStart then
                  ;; IdentifierPart*, terminated by '>'. A '\' begins a RegExpUnicodeEscapeSequence
                  ;; (accepted permissively). Applies in all modes (GroupSpecifier is not Annex-B-relaxed).
                  (then
                    (let $gnst i32 (local.get $i))
                    (let $gnf i32 (i32.const 1))
                    (block $gne (loop $gnl
                      (if (i32.ge_s (local.get $i) (local.get $n)) (then (call $throw_type (cstring "SyntaxError") (cstring "Unterminated group name")) (return)))
                      (let $gnc i32 (call $str_byte (local.get $pat) (local.get $i)))
                      (if (i32.eq (local.get $gnc) (i32.const 62))  ;; '>'
                        (then
                          (if (i32.eq (local.get $i) (local.get $gnst)) (then (call $throw_type (cstring "SyntaxError") (cstring "Empty group name")) (return)))
                          (set! $i (i32.add (local.get $i) (i32.const 1))) (br $gne)))
                      (if (i32.eq (local.get $gnc) (i32.const 92))  ;; '\' RegExpUnicodeEscapeSequence → skip permissively
                        (then (set! $i (i32.add (local.get $i) (i32.const 2))) (set! $gnf (i32.const 0)) (br $gnl)))
                      (if (local.get $gnf)
                        (then (if (i32.eqz (call $re_id_start (local.get $gnc))) (then (call $throw_type (cstring "SyntaxError") (cstring "Invalid group name")) (return))))
                        (else (if (i32.eqz (call $re_id_part (local.get $gnc))) (then (call $throw_type (cstring "SyntaxError") (cstring "Invalid group name")) (return)))))
                      (set! $gnf (i32.const 0))
                      (set! $i (i32.add (local.get $i) (i32.const 1))) (br $gnl))))))
              ;; not `(?<…` — either `(?:` / `(?=` / `(?!` (consume one char) or a modifier group `(?flags…:` (validate)
              (else
                ;; `(?=` / `(?!` are lookahead ASSERTIONS
                (if (i32.and (i32.lt_s (local.get $i) (local.get $n)) (i32.or (i32.eq (call $str_byte (local.get $pat) (local.get $i)) (i32.const 61)) (i32.eq (call $str_byte (local.get $pat) (local.get $i)) (i32.const 33))))
                  (then (set! $isassert (i32.const 1))))
                (if (i32.and (i32.lt_s (local.get $i) (local.get $n)) (i32.eqz (i32.or (i32.eq (call $str_byte (local.get $pat) (local.get $i)) (i32.const 58)) (i32.or (i32.eq (call $str_byte (local.get $pat) (local.get $i)) (i32.const 61)) (i32.eq (call $str_byte (local.get $pat) (local.get $i)) (i32.const 33))))))
                (then (set! $i (call $re_validate_modifiers (local.get $pat) (local.get $n) (local.get $i))) (if (call $err) (then (return))))
                (else (set! $i (i32.add (local.get $i) (i32.const 1)))))))))
        ;; record whether the group at this level is an assertion (only up to 32 nesting levels)
        (if (i32.lt_s (local.get $depth) (i32.const 31))
          (then
            (if (local.get $isassert)
                  (then (set! $astk (i32.or (local.get $astk) (i32.shl (i32.const 1) (local.get $depth)))))
                  (else (set! $astk (i32.and (local.get $astk) (i32.xor (i32.shl (i32.const 1) (local.get $depth)) (i32.const -1))))))
            (if (local.get $islb)
                  (then (set! $lbstk (i32.or (local.get $lbstk) (i32.shl (i32.const 1) (local.get $depth)))))
                  (else (set! $lbstk (i32.and (local.get $lbstk) (i32.xor (i32.shl (i32.const 1) (local.get $depth)) (i32.const -1))))))))
        (set! $depth (i32.add (local.get $depth) (i32.const 1))) (set! $st (i32.const 0)) (br $l)))
    (if (i32.eq (local.get $c) (i32.const 124)) (then (set! $st (i32.const 0)) (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))  ;; '|'
    (if (i32.eq (local.get $c) (i32.const 41))  ;; ')'
      (then
        (if (i32.le_s (local.get $depth) (i32.const 0)) (then (call $throw_type (cstring "SyntaxError") (cstring "Unmatched ')'")) (return)))
        (set! $depth (i32.sub (local.get $depth) (i32.const 1)))
        ;; A following quantifier is invalid (leave st=0 → "Nothing to repeat") when the closing group is:
        ;; a LOOKBEHIND assertion (never a QuantifiableAssertion, ANY mode), or a lookahead assertion in
        ;; u/v mode (sloppy keeps st=1 — Annex B allows `(?=)*`).
        (if (i32.and (i32.lt_s (local.get $depth) (i32.const 31))
              (i32.or (i32.and (i32.shr_u (local.get $lbstk) (local.get $depth)) (i32.const 1))
                      (i32.and (local.get $ustrict) (i32.and (i32.shr_u (local.get $astk) (local.get $depth)) (i32.const 1)))))
          (then (set! $st (i32.const 0)))
          (else (set! $st (i32.const 1))))
        (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
    (if (i32.or (i32.eq (local.get $c) (i32.const 42)) (i32.eq (local.get $c) (i32.const 43)))  ;; '*' '+'
      (then
        (if (i32.ne (local.get $st) (i32.const 1)) (then (call $throw_type (cstring "SyntaxError") (cstring "Nothing to repeat")) (return)))
        (set! $st (i32.const 2)) (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
    (if (i32.eq (local.get $c) (i32.const 63))  ;; '?'
      (then
        (if (i32.eq (local.get $st) (i32.const 0)) (then (call $throw_type (cstring "SyntaxError") (cstring "Nothing to repeat")) (return)))
        (if (i32.eq (local.get $st) (i32.const 1)) (then (set! $st (i32.const 2))) (else (set! $st (i32.const 0))))
        (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
    (if (i32.eq (local.get $c) (i32.const 123))  ;; '{' — a quantifier only if well-formed {n}/{n,}/{n,m}
      (then
        (let $j i32 (i32.add (local.get $i) (i32.const 1)))
        (let $minv i32 (i32.const 0)) (let $mind i32 (i32.const 0))
        (block $de (loop $dl (br_if $de (i32.ge_s (local.get $j) (local.get $n))) (let $dc i32 (call $str_byte (local.get $pat) (local.get $j))) (br_if $de (i32.or (i32.lt_s (local.get $dc) (i32.const 48)) (i32.gt_s (local.get $dc) (i32.const 57)))) (if (i32.lt_s (local.get $minv) (i32.const 100000000)) (then (set! $minv (i32.add (i32.mul (local.get $minv) (i32.const 10)) (i32.sub (local.get $dc) (i32.const 48)))))) (set! $mind (i32.add (local.get $mind) (i32.const 1))) (set! $j (i32.add (local.get $j) (i32.const 1))) (br $dl)))
        (let $ok i32 (i32.const 0)) (let $hasmax i32 (i32.const 0)) (let $maxv i32 (i32.const 0)) (let $maxd i32 (i32.const 0))
        (if (i32.gt_s (local.get $mind) (i32.const 0))
          (then
            (if (i32.and (i32.lt_s (local.get $j) (local.get $n)) (i32.eq (call $str_byte (local.get $pat) (local.get $j)) (i32.const 44)))  ;; ','
              (then (set! $hasmax (i32.const 1)) (set! $j (i32.add (local.get $j) (i32.const 1))) (block $d2e (loop $d2l (br_if $d2e (i32.ge_s (local.get $j) (local.get $n))) (let $dc2 i32 (call $str_byte (local.get $pat) (local.get $j))) (br_if $d2e (i32.or (i32.lt_s (local.get $dc2) (i32.const 48)) (i32.gt_s (local.get $dc2) (i32.const 57)))) (if (i32.lt_s (local.get $maxv) (i32.const 100000000)) (then (set! $maxv (i32.add (i32.mul (local.get $maxv) (i32.const 10)) (i32.sub (local.get $dc2) (i32.const 48)))))) (set! $maxd (i32.add (local.get $maxd) (i32.const 1))) (set! $j (i32.add (local.get $j) (i32.const 1))) (br $d2l)))))
            (if (i32.and (i32.lt_s (local.get $j) (local.get $n)) (i32.eq (call $str_byte (local.get $pat) (local.get $j)) (i32.const 125)))  ;; '}'
              (then (set! $ok (i32.const 1)) (set! $j (i32.add (local.get $j) (i32.const 1)))))))
        (if (local.get $ok)
          (then
            (if (i32.ne (local.get $st) (i32.const 1)) (then (call $throw_type (cstring "SyntaxError") (cstring "Nothing to repeat")) (return)))
            ;; {n,m} with an explicit finite max < min is a SyntaxError
            (if (i32.and (local.get $hasmax) (i32.and (i32.gt_s (local.get $maxd) (i32.const 0)) (i32.gt_s (local.get $minv) (local.get $maxv))))
              (then (call $throw_type (cstring "SyntaxError") (cstring "numbers out of order in {} quantifier")) (return)))
            (set! $st (i32.const 2)) (set! $i (local.get $j)) (br $l))
          ;; u/v mode: a `{` that is not a well-formed quantifier is an "incomplete quantifier" SyntaxError
          ;; (in sloppy mode it is a lenient literal `{`).
          (else
            (if (local.get $ustrict) (then (call $throw_type (cstring "SyntaxError") (cstring "Incomplete quantifier")) (return)))
            (set! $st (i32.const 1)) (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))))
    ;; u/v mode: a lone unescaped `}` or `]` (not consumed by a quantifier / char class above) is a
    ;; SyntaxError (sloppy mode treats it as a literal). `{` is handled by the quantifier branch above.
    (if (i32.and (local.get $ustrict) (i32.or (i32.eq (local.get $c) (i32.const 125)) (i32.eq (local.get $c) (i32.const 93))))
      (then (call $throw_type (cstring "SyntaxError") (cstring "Lone quantifier brace or bracket in unicode pattern")) (return)))
    (set! $st (i32.const 1)) (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
  (if (i32.gt_s (local.get $depth) (i32.const 0)) (then (call $throw_type (cstring "SyntaxError") (cstring "Unmatched '('")) (return))))

;; the [[OriginalFlags]] string ptr of a RegExp (empty string if absent) — used when the RegExp
;; constructor is given undefined flags for a RegExp pattern (new RegExp(/x/gi) → flags "gi").
(func $re_flags_of (param $v i64) (result i32) (effects)
  (if i32 (call $is_object (local.get $v))
    (then
      (let $fsl i32 (call $scope_find_local (call $val_payload (local.get $v)) (cstring "__re_flags__")))
      (if i32 (local.get $fsl)
        (then (let $fv i64 (i64.load (local.get $fsl)))
              (if i32 (call $is_string (local.get $fv)) (then (call $val_payload (local.get $fv))) (else (cstring ""))))
        (else (cstring ""))))
    (else (cstring ""))))

;; RegExpCreate(pattern, flags): build a fresh RegExp object (parent = RegExp.prototype) from
;; already-stringified pattern/flags. Used by String.prototype.match/matchAll/search to delegate
;; to RegExp.prototype[@@match/@@matchAll/@@search] per spec (so a subclass override is honored).
(func $mk_regexp (param $pat i32) (param $flg i32) (result i64) (effects)
  (let $ro i32 (call $obj_new (i32.const 8)))
  (i32.store (local.get $ro) (i32.load (i32.const 324)))  ;; scope parent = RegExp.prototype
  (call $scope_define_attr (local.get $ro) (cstring "__re_src__") (call $mk_str (local.get $pat)) (i32.const 0))
  (call $scope_define_attr (local.get $ro) (cstring "__re_flags__") (call $mk_str (local.get $flg)) (i32.const 0))
  (call $scope_define_attr (local.get $ro) (cstring "lastIndex") (call $num (f64.const 0)) (i32.const 8))
  (call $mk_obj (local.get $ro)))

;; RegExpExec(R, S): if R.exec is callable, Call(exec, R, «S») and validate the result
;; is Object|null; else (R must be a RegExp) run the builtin exec (native 167). $sval is
;; the string VALUE. Returns an array | null | whatever a user exec returns; sets $err on abrupt.
(func $regexp_exec (param $rx i64) (param $sval i64) (result i64) (effects)
  (let $rex i64 (call $get_prop (local.get $rx) (call $mk_str (cstring "exec"))))
  (if (call $err) (then (return (call $v_undef))))
  (if (call $is_function (local.get $rex))
    (then
      (let $rer i64 (call $call_val (local.get $rex) (i32.const 1) (call $argv1 (local.get $sval)) (local.get $rx)))
      (if (call $err) (then (return (call $v_undef))))
      (if (i32.eqz (i32.or (call $is_object (local.get $rer)) (i32.or (call $is_array (local.get $rer)) (call $is_null (local.get $rer)))))
        (then (call $throw_type (cstring "TypeError") (cstring "exec method must return an Object or null")) (return (call $v_undef))))
      (return (local.get $rer))))
  (if (i32.eqz (call $is_regexp (local.get $rx)))
    (then (call $throw_type (cstring "TypeError") (cstring "RegExpExec called on a non-RegExp object")) (return (call $v_undef))))
  (call $call_native (i32.const 167) (i32.const 1) (call $argv1 (local.get $sval)) (local.get $rx)))

;; convenience: search a Str subject for a Str pattern. start offset or -1.
(func $re_search_str (param $patStr i32) (param $subStr i32) (result i32) (effects)
  (call $re_search (i32.add (local.get $patStr) (i32.const 4)) (call $str_len (local.get $patStr))
                   (i32.add (local.get $subStr) (i32.const 4)) (call $str_len (local.get $subStr))))

;; like re_search but begins scanning at byte offset $from (for g/y exec via lastIndex)
(func $re_search_from (param $p i32) (param $plen i32) (param $s i32) (param $slen i32) (param $from i32) (result i32) (effects)
  (call $re_reset_caps (local.get $p) (local.get $plen))
  (let $start i32 (local.get $from))
  (if (i32.lt_s (local.get $start) (i32.const 0)) (then (set! $start (i32.const 0))))
  (block $e (loop $l
    (br_if $e (i32.gt_s (local.get $start) (local.get $slen)))
    (let $r i32 (call $re_match_alt (local.get $p) (i32.const 0) (local.get $plen) (local.get $s) (local.get $slen) (local.get $start)))
    (if (i32.ge_s (local.get $r) (i32.const 0)) (then (i32.store (i32.const 168) (local.get $r)) (return (local.get $start))))
    (set! $start (i32.add (local.get $start) (i32.const 1)))
    (br $l)))
  (i32.const -1))

(func $re_search_str_from (param $patStr i32) (param $subStr i32) (param $from i32) (result i32) (effects)
  (call $re_search_from (i32.add (local.get $patStr) (i32.const 4)) (call $str_len (local.get $patStr))
                   (i32.add (local.get $subStr) (i32.const 4)) (call $str_len (local.get $subStr)) (local.get $from)))

;; sticky ('y') match: the match must begin EXACTLY at byte offset $from (no forward
;; scan). Returns $from on success (reg 168 = match end) else -1.
(func $re_match_str_at (param $patStr i32) (param $subStr i32) (param $from i32) (result i32) (effects)
  (let $p i32 (i32.add (local.get $patStr) (i32.const 4)))
  (let $plen i32 (call $str_len (local.get $patStr)))
  (let $s i32 (i32.add (local.get $subStr) (i32.const 4)))
  (let $slen i32 (call $str_len (local.get $subStr)))
  (call $re_reset_caps (local.get $p) (local.get $plen))
  (if (i32.or (i32.lt_s (local.get $from) (i32.const 0)) (i32.gt_s (local.get $from) (local.get $slen))) (then (return (i32.const -1))))
  (let $r i32 (call $re_match_alt (local.get $p) (i32.const 0) (local.get $plen) (local.get $s) (local.get $slen) (local.get $from)))
  (if (i32.ge_s (local.get $r) (i32.const 0)) (then (i32.store (i32.const 168) (local.get $r)) (return (local.get $from))))
  (i32.const -1))
