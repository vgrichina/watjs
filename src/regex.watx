;; ═══════════════════════════════════════════════════════════════
;; regex.watx — backtracking regular-expression matcher
;;
;; Subset: literal chars, '.', char classes [..]/[^..] with ranges and
;; escapes, \d \w \s \D \W \S \n \t \r and \<char> literals, anchors ^ $,
;; greedy quantifiers * + ? {n} {n,} {n,m}. (No groups/alternation/backrefs.)
;;
;; All positions are byte offsets. Pattern and subject are raw byte regions.
;; re_search stores the match END byte offset in register 168 (RE_END).
;; ═══════════════════════════════════════════════════════════════

;; ASCII lowercase; case-aware char equality (reg 272 = ignorecase 'i' flag)
(func $re_lc (param $c i32) (result i32) (effects)
  (if i32 (i32.and (i32.ge_s (local.get $c) (i32.const 65)) (i32.le_s (local.get $c) (i32.const 90)))
    (then (i32.add (local.get $c) (i32.const 32))) (else (local.get $c))))
(func $re_eqc (param $a i32) (param $b i32) (result i32) (effects)
  (if i32 (i32.load (i32.const 272))
    (then (i32.eq (call $re_lc (local.get $a)) (call $re_lc (local.get $b))))
    (else (i32.eq (local.get $a) (local.get $b)))))

;; does string `s` contain byte `ch`?
(func $str_has_char (param $s i32) (param $ch i32) (result i32) (effects)
  (let $n i32 (call $str_len (local.get $s)))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    (if (i32.eq (call $str_byte (local.get $s) (local.get $i)) (local.get $ch)) (then (return (i32.const 1))))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
  (i32.const 0))

;; set reg 272 (ignorecase 'i') and 276 (global 'g') from a regex value's flags
(func $re_apply_flags (param $v i64) (effects)
  (i32.store (i32.const 272) (i32.const 0)) (i32.store (i32.const 276) (i32.const 0))
  (if (call $is_object (local.get $v))
    (then
      (let $sl i32 (call $scope_find_local (call $val_payload (local.get $v)) (cstring "__re_flags__")))
      (if (local.get $sl)
        (then
          (let $fv i64 (i64.load (local.get $sl)))
          (if (call $is_string (local.get $fv))
            (then
              (i32.store (i32.const 272) (call $str_has_char (call $val_payload (local.get $fv)) (i32.const 105)))
              (i32.store (i32.const 276) (call $str_has_char (call $val_payload (local.get $fv)) (i32.const 103))))))))))

;; does escape letter `e` match char `ch`?  (ch = -1 means past end)
(func $re_esc_match (param $e i32) (param $ch i32) (result i32) (effects)
  (if (i32.lt_s (local.get $ch) (i32.const 0)) (then (return (i32.const 0))))
  (if (i32.eq (local.get $e) (i32.const 100))  ;; \d
    (then (return (i32.and (i32.ge_s (local.get $ch) (i32.const 48)) (i32.le_s (local.get $ch) (i32.const 57))))))
  (if (i32.eq (local.get $e) (i32.const 68))   ;; \D
    (then (return (i32.eqz (i32.and (i32.ge_s (local.get $ch) (i32.const 48)) (i32.le_s (local.get $ch) (i32.const 57)))))))
  (if (i32.eq (local.get $e) (i32.const 119))  ;; \w
    (then (return (call $re_is_word (local.get $ch)))))
  (if (i32.eq (local.get $e) (i32.const 87))   ;; \W
    (then (return (i32.eqz (call $re_is_word (local.get $ch))))))
  (if (i32.eq (local.get $e) (i32.const 115))  ;; \s
    (then (return (call $re_is_ws (local.get $ch)))))
  (if (i32.eq (local.get $e) (i32.const 83))   ;; \S
    (then (return (i32.eqz (call $re_is_ws (local.get $ch))))))
  ;; literal escapes: \n \t \r \<char>
  (let $lit i32 (local.get $e))
  (if (i32.eq (local.get $e) (i32.const 110)) (then (set! $lit (i32.const 10))))
  (if (i32.eq (local.get $e) (i32.const 116)) (then (set! $lit (i32.const 9))))
  (if (i32.eq (local.get $e) (i32.const 114)) (then (set! $lit (i32.const 13))))
  (call $re_eqc (local.get $ch) (local.get $lit)))

(func $re_is_word (param $ch i32) (result i32) (effects)
  (i32.or (i32.and (i32.ge_s (local.get $ch) (i32.const 48)) (i32.le_s (local.get $ch) (i32.const 57)))
    (i32.or (i32.and (i32.ge_s (local.get $ch) (i32.const 65)) (i32.le_s (local.get $ch) (i32.const 90)))
      (i32.or (i32.and (i32.ge_s (local.get $ch) (i32.const 97)) (i32.le_s (local.get $ch) (i32.const 122)))
              (i32.eq (local.get $ch) (i32.const 95))))))
(func $re_is_ws (param $ch i32) (result i32) (effects)
  (i32.or (i32.eq (local.get $ch) (i32.const 32)) (i32.or (i32.eq (local.get $ch) (i32.const 9))
    (i32.or (i32.eq (local.get $ch) (i32.const 10)) (i32.or (i32.eq (local.get $ch) (i32.const 13)) (i32.eq (local.get $ch) (i32.const 12)))))))

;; byte at pattern offset i (p = absolute addr), or -1 if i>=plen
(func $re_pb (param $p i32) (param $plen i32) (param $i i32) (result i32) (effects)
  (if i32 (i32.ge_s (local.get $i) (local.get $plen)) (then (i32.const -1)) (else (i32.load8_u (i32.add (local.get $p) (local.get $i))))))

;; end offset of the atom starting at ppos
(func $re_atom_end (param $p i32) (param $plen i32) (param $ppos i32) (result i32) (effects)
  (let $c i32 (call $re_pb (local.get $p) (local.get $plen) (local.get $ppos)))
  (if (i32.eq (local.get $c) (i32.const 92)) (then (return (i32.add (local.get $ppos) (i32.const 2)))))  ;; \X
  (if (i32.eq (local.get $c) (i32.const 91))  ;; [..]
    (then
      (let $i i32 (i32.add (local.get $ppos) (i32.const 1)))
      (if (i32.eq (call $re_pb (local.get $p) (local.get $plen) (local.get $i)) (i32.const 94)) (then (set! $i (i32.add (local.get $i) (i32.const 1)))))  ;; ^
      (if (i32.eq (call $re_pb (local.get $p) (local.get $plen) (local.get $i)) (i32.const 93)) (then (set! $i (i32.add (local.get $i) (i32.const 1)))))  ;; literal ] first
      (block $e (loop $l
        (let $d i32 (call $re_pb (local.get $p) (local.get $plen) (local.get $i)))
        (br_if $e (i32.lt_s (local.get $d) (i32.const 0)))
        (br_if $e (i32.eq (local.get $d) (i32.const 93)))  ;; ]
        (if (i32.eq (local.get $d) (i32.const 92)) (then (set! $i (i32.add (local.get $i) (i32.const 1)))))  ;; skip escaped
        (set! $i (i32.add (local.get $i) (i32.const 1)))
        (br $l)))
      (return (i32.add (local.get $i) (i32.const 1)))))  ;; past ]
  (i32.add (local.get $ppos) (i32.const 1)))

;; does char class [start..end) (between [ and ]) match `ch`?
(func $re_class_match (param $p i32) (param $start i32) (param $end i32) (param $ch i32) (result i32) (effects)
  (if (i32.lt_s (local.get $ch) (i32.const 0)) (then (return (i32.const 0))))
  (let $i i32 (local.get $start))
  (let $neg i32 (i32.const 0))
  (if (i32.eq (i32.load8_u (i32.add (local.get $p) (local.get $i))) (i32.const 94)) (then (set! $neg (i32.const 1)) (set! $i (i32.add (local.get $i) (i32.const 1)))))
  (let $found i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $end)))
    (let $c i32 (i32.load8_u (i32.add (local.get $p) (local.get $i))))
    (if (i32.eq (local.get $c) (i32.const 92))  ;; escape in class
      (then
        (if (call $re_esc_match (i32.load8_u (i32.add (local.get $p) (i32.add (local.get $i) (i32.const 1)))) (local.get $ch)) (then (set! $found (i32.const 1))))
        (set! $i (i32.add (local.get $i) (i32.const 2)))
        (br $l)))
    ;; range a-b ?
    (if (i32.and (i32.lt_s (i32.add (local.get $i) (i32.const 2)) (local.get $end))
          (i32.eq (i32.load8_u (i32.add (local.get $p) (i32.add (local.get $i) (i32.const 1)))) (i32.const 45)))
      (then
        (let $hi i32 (i32.load8_u (i32.add (local.get $p) (i32.add (local.get $i) (i32.const 2)))))
        (if (i32.and (i32.ge_s (local.get $ch) (local.get $c)) (i32.le_s (local.get $ch) (local.get $hi))) (then (set! $found (i32.const 1))))
        (set! $i (i32.add (local.get $i) (i32.const 3)))
        (br $l)))
    (if (i32.eq (local.get $ch) (local.get $c)) (then (set! $found (i32.const 1))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (if i32 (local.get $neg) (then (i32.eqz (local.get $found))) (else (local.get $found))))

;; does the atom [astart,aend) match char `ch`?
(func $re_atom_match (param $p i32) (param $astart i32) (param $aend i32) (param $ch i32) (result i32) (effects)
  (if (i32.lt_s (local.get $ch) (i32.const 0)) (then (return (i32.const 0))))
  (let $c i32 (i32.load8_u (i32.add (local.get $p) (local.get $astart))))
  (if (i32.eq (local.get $c) (i32.const 46)) (then (return (i32.ne (local.get $ch) (i32.const 10)))))  ;; .
  (if (i32.eq (local.get $c) (i32.const 92)) (then (return (call $re_esc_match (i32.load8_u (i32.add (local.get $p) (i32.add (local.get $astart) (i32.const 1)))) (local.get $ch)))))  ;; \X
  (if (i32.eq (local.get $c) (i32.const 91)) (then (return (call $re_class_match (local.get $p) (i32.add (local.get $astart) (i32.const 1)) (i32.sub (local.get $aend) (i32.const 1)) (local.get $ch)))))  ;; [..]
  (call $re_eqc (local.get $ch) (local.get $c)))

;; match pattern[ppos..] against subject starting at spos; return END spos or -1
(func $re_match (param $p i32) (param $plen i32) (param $ppos i32) (param $s i32) (param $slen i32) (param $spos i32) (result i32) (effects)
  (if (i32.ge_s (local.get $ppos) (local.get $plen)) (then (return (local.get $spos))))
  (let $c i32 (i32.load8_u (i32.add (local.get $p) (local.get $ppos))))
  (if (i32.eq (local.get $c) (i32.const 94))  ;; ^
    (then (if (i32.eqz (local.get $spos)) (then (return (call $re_match (local.get $p) (local.get $plen) (i32.add (local.get $ppos) (i32.const 1)) (local.get $s) (local.get $slen) (local.get $spos)))) (else (return (i32.const -1))))))
  (if (i32.eq (local.get $c) (i32.const 36))  ;; $
    (then (if (i32.eq (local.get $spos) (local.get $slen)) (then (return (call $re_match (local.get $p) (local.get $plen) (i32.add (local.get $ppos) (i32.const 1)) (local.get $s) (local.get $slen) (local.get $spos)))) (else (return (i32.const -1))))))
  (let $aend i32 (call $re_atom_end (local.get $p) (local.get $plen) (local.get $ppos)))
  (let $q i32 (call $re_pb (local.get $p) (local.get $plen) (local.get $aend)))
  (let $min i32 (i32.const 1))
  (let $max i32 (i32.const 1))
  (let $qend i32 (local.get $aend))
  (if (i32.eq (local.get $q) (i32.const 42)) (then (set! $min (i32.const 0)) (set! $max (i32.add (local.get $slen) (i32.const 1))) (set! $qend (i32.add (local.get $aend) (i32.const 1)))))  ;; *
  (if (i32.eq (local.get $q) (i32.const 43)) (then (set! $min (i32.const 1)) (set! $max (i32.add (local.get $slen) (i32.const 1))) (set! $qend (i32.add (local.get $aend) (i32.const 1)))))  ;; +
  (if (i32.eq (local.get $q) (i32.const 63)) (then (set! $min (i32.const 0)) (set! $max (i32.const 1)) (set! $qend (i32.add (local.get $aend) (i32.const 1)))))  ;; ?
  (if (i32.eq (local.get $q) (i32.const 123)) (then (call $re_parse_brace (local.get $p) (local.get $plen) (local.get $aend))  ;; {n,m} → sets regs 172/176/180
    (set! $min (i32.load (i32.const 172))) (set! $max (i32.load (i32.const 176))) (set! $qend (i32.load (i32.const 180)))))
  ;; greedy: count consecutive atom matches up to max
  (let $count i32 (i32.const 0))
  (block $ce (loop $cl
    (br_if $ce (i32.ge_s (local.get $count) (local.get $max)))
    (br_if $ce (i32.ge_s (i32.add (local.get $spos) (local.get $count)) (local.get $slen)))
    (br_if $ce (i32.eqz (call $re_atom_match (local.get $p) (local.get $ppos) (local.get $aend) (i32.load8_u (i32.add (local.get $s) (i32.add (local.get $spos) (local.get $count)))))))
    (set! $count (i32.add (local.get $count) (i32.const 1)))
    (br $cl)))
  ;; backtrack from count down to min
  (block $be (loop $bl
    (br_if $be (i32.lt_s (local.get $count) (local.get $min)))
    (let $r i32 (call $re_match (local.get $p) (local.get $plen) (local.get $qend) (local.get $s) (local.get $slen) (i32.add (local.get $spos) (local.get $count))))
    (if (i32.ge_s (local.get $r) (i32.const 0)) (then (return (local.get $r))))
    (set! $count (i32.sub (local.get $count) (i32.const 1)))
    (br $bl)))
  (i32.const -1))

;; parse {n}, {n,}, {n,m} at brace pos → regs 172 min, 176 max, 180 qend
(func $re_parse_brace (param $p i32) (param $plen i32) (param $bpos i32) (effects)
  (let $i i32 (i32.add (local.get $bpos) (i32.const 1)))
  (let $n i32 (i32.const 0))
  (block $e1 (loop $l1
    (let $d i32 (call $re_pb (local.get $p) (local.get $plen) (local.get $i)))
    (br_if $e1 (i32.eqz (i32.and (i32.ge_s (local.get $d) (i32.const 48)) (i32.le_s (local.get $d) (i32.const 57)))))
    (set! $n (i32.add (i32.mul (local.get $n) (i32.const 10)) (i32.sub (local.get $d) (i32.const 48))))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l1)))
  (i32.store (i32.const 172) (local.get $n))
  (i32.store (i32.const 176) (local.get $n))  ;; default max = n
  (if (i32.eq (call $re_pb (local.get $p) (local.get $plen) (local.get $i)) (i32.const 44))  ;; ','
    (then
      (set! $i (i32.add (local.get $i) (i32.const 1)))
      (if (i32.eq (call $re_pb (local.get $p) (local.get $plen) (local.get $i)) (i32.const 125))  ;; {n,}
        (then (i32.store (i32.const 176) (i32.const 1000000)))
        (else
          (let $m i32 (i32.const 0))
          (block $e2 (loop $l2
            (let $d i32 (call $re_pb (local.get $p) (local.get $plen) (local.get $i)))
            (br_if $e2 (i32.eqz (i32.and (i32.ge_s (local.get $d) (i32.const 48)) (i32.le_s (local.get $d) (i32.const 57)))))
            (set! $m (i32.add (i32.mul (local.get $m) (i32.const 10)) (i32.sub (local.get $d) (i32.const 48))))
            (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l2)))
          (i32.store (i32.const 176) (local.get $m))))))
  (i32.store (i32.const 180) (i32.add (local.get $i) (i32.const 1))))  ;; past '}'

;; search subject for first match; return START offset (or -1), END in reg 168
(func $re_search (param $p i32) (param $plen i32) (param $s i32) (param $slen i32) (result i32) (effects)
  (let $start i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.gt_s (local.get $start) (local.get $slen)))
    (let $r i32 (call $re_match (local.get $p) (local.get $plen) (i32.const 0) (local.get $s) (local.get $slen) (local.get $start)))
    (if (i32.ge_s (local.get $r) (i32.const 0)) (then (i32.store (i32.const 168) (local.get $r)) (return (local.get $start))))
    (set! $start (i32.add (local.get $start) (i32.const 1)))
    (br $l)))
  (i32.const -1))

;; pattern Str from a value: a regex object's __re_src__, else ToString(value)
(func $re_pat_of (param $v i64) (result i32) (effects)
  (if i32 (call $is_object (local.get $v))
    (then
      (let $sl i32 (call $scope_find_local (call $val_payload (local.get $v)) (cstring "__re_src__")))
      (if i32 (local.get $sl)
        (then (let $sv i64 (i64.load (local.get $sl)))
              (if i32 (call $is_string (local.get $sv)) (then (call $val_payload (local.get $sv))) (else (call $to_str (local.get $v)))))
        (else (call $to_str (local.get $v)))))
    (else (call $to_str (local.get $v)))))

;; convenience: search a Str subject for a Str pattern. start offset or -1.
(func $re_search_str (param $patStr i32) (param $subStr i32) (result i32) (effects)
  (call $re_search (i32.add (local.get $patStr) (i32.const 4)) (call $str_len (local.get $patStr))
                   (i32.add (local.get $subStr) (i32.const 4)) (call $str_len (local.get $subStr))))
