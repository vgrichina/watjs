;; ═══════════════════════════════════════════════════════════════
;; regex.watx — backtracking regular-expression matcher
;;
;; Subset: literal chars, '.', char classes [..]/[^..] with ranges and
;; escapes, \d \w \s \D \W \S \n \t \r and \<char> literals, anchors ^ $,
;; greedy quantifiers * + ? {n} {n,} {n,m}. (No groups/alternation/backrefs.)
;;
;; All positions are byte offsets. Pattern and subject are raw byte regions.
;; re_search stores the match END byte offset in register 168 (RE_END).
;; ═══════════════════════════════════════════════════════════════

;; ASCII lowercase; case-aware char equality (reg 272 = ignorecase 'i' flag)
(func $re_lc (param $c i32) (result i32) (effects)
  (if i32 (i32.and (i32.ge_s (local.get $c) (i32.const 65)) (i32.le_s (local.get $c) (i32.const 90)))
    (then (i32.add (local.get $c) (i32.const 32))) (else (local.get $c))))
(func $re_eqc (param $a i32) (param $b i32) (result i32) (effects)
  (if i32 (i32.load (i32.const 272))
    (then (i32.eq (call $re_lc (local.get $a)) (call $re_lc (local.get $b))))
    (else (i32.eq (local.get $a) (local.get $b)))))
;; toggle ASCII letter case (for case-insensitive char-class ranges)
(func $re_swapc (param $c i32) (result i32) (effects)
  (if i32 (i32.and (i32.ge_s (local.get $c) (i32.const 65)) (i32.le_s (local.get $c) (i32.const 90)))
    (then (i32.add (local.get $c) (i32.const 32)))
    (else (if i32 (i32.and (i32.ge_s (local.get $c) (i32.const 97)) (i32.le_s (local.get $c) (i32.const 122)))
            (then (i32.sub (local.get $c) (i32.const 32))) (else (local.get $c))))))

;; does string `s` contain byte `ch`?
(func $str_has_char (param $s i32) (param $ch i32) (result i32) (effects)
  (let $n i32 (call $str_len (local.get $s)))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    (if (i32.eq (call $str_byte (local.get $s) (local.get $i)) (local.get $ch)) (then (return (i32.const 1))))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
  (i32.const 0))

;; replacement string for a match [ms,me): if repisfn, call repfn(matchStr,offset,whole)
(func $re_repl_of (param $repfn i64) (param $repisfn i32) (param $replstr i32) (param $sub i32) (param $ms i32) (param $me i32) (result i32) (effects)
  (if i32 (local.get $repisfn)
    (then
      ;; callback args per spec: (match, p1..pN, offset, string [, groups])
      (let $ng i32 (i32.load (i32.const 284)))  ;; number of capture groups
      (let $hasnm i32 (i32.ne (i32.load (i32.const 604)) (i32.const 0)))  ;; named groups → extra trailing arg
      (let $nargs i32 (i32.add (i32.add (local.get $ng) (i32.const 3)) (local.get $hasnm)))
      (let $av i32 (call $heap_alloc (i32.mul (local.get $nargs) (i32.const 8))))
      (i64.store (local.get $av) (call $mk_str (call $substr (local.get $sub) (local.get $ms) (i32.sub (local.get $me) (local.get $ms)))))  ;; match
      (let $gi i32 (i32.const 0))
      (block $ge (loop $gl
        (br_if $ge (i32.ge_s (local.get $gi) (local.get $ng)))
        (let $gcb i32 (i32.add (i32.load (i32.const 280)) (i32.mul (local.get $gi) (i32.const 8))))
        (let $gcs i32 (i32.load (local.get $gcb)))
        (i64.store (i32.add (local.get $av) (i32.mul (i32.add (local.get $gi) (i32.const 1)) (i32.const 8)))
          (if i64 (i32.ge_s (local.get $gcs) (i32.const 0))
            (then (call $mk_str (call $substr (local.get $sub) (local.get $gcs) (i32.sub (i32.load (i32.add (local.get $gcb) (i32.const 4))) (local.get $gcs)))))
            (else (call $v_undef))))  ;; unmatched group → undefined
        (set! $gi (i32.add (local.get $gi) (i32.const 1)))
        (br $gl)))
      (i64.store (i32.add (local.get $av) (i32.mul (i32.add (local.get $ng) (i32.const 1)) (i32.const 8))) (call $num (f64.convert_i32_s (local.get $ms))))  ;; offset
      (i64.store (i32.add (local.get $av) (i32.mul (i32.add (local.get $ng) (i32.const 2)) (i32.const 8))) (call $mk_str (local.get $sub)))  ;; string
      (if (local.get $hasnm) (then (i64.store (i32.add (local.get $av) (i32.mul (i32.add (local.get $ng) (i32.const 3)) (i32.const 8))) (call $re_groups_obj (local.get $sub) (i32.const 0)))))  ;; groups
      (call $to_str (call $call_val (local.get $repfn) (local.get $nargs) (local.get $av) (call $v_undef))))
    (else  ;; expand $&, $$, $1-$9 in the replacement string
      (if i32 (i32.eqz (call $str_has_char (local.get $replstr) (i32.const 36)))
        (then (local.get $replstr))
        (else
          (let $out i32 (cstring ""))
          (let $i i32 (i32.const 0))
          (let $rl i32 (call $str_len (local.get $replstr)))
          (block $e (loop $l
            (br_if $e (i32.ge_s (local.get $i) (local.get $rl)))
            (let $ch i32 (call $str_byte (local.get $replstr) (local.get $i)))
            (if (i32.and (i32.eq (local.get $ch) (i32.const 36)) (i32.lt_s (i32.add (local.get $i) (i32.const 1)) (local.get $rl)))  ;; '$' + something
              (then
                (let $nx i32 (call $str_byte (local.get $replstr) (i32.add (local.get $i) (i32.const 1))))
                (if (i32.eq (local.get $nx) (i32.const 36))  ;; $$
                  (then (set! $out (call $str_concat (local.get $out) (cstring "$"))) (set! $i (i32.add (local.get $i) (i32.const 2))) (br $l)))
                (if (i32.eq (local.get $nx) (i32.const 38))  ;; $& whole match
                  (then (set! $out (call $str_concat (local.get $out) (call $substr (local.get $sub) (local.get $ms) (i32.sub (local.get $me) (local.get $ms))))) (set! $i (i32.add (local.get $i) (i32.const 2))) (br $l)))
                (if (i32.eq (local.get $nx) (i32.const 96))  ;; $` portion before the match
                  (then (set! $out (call $str_concat (local.get $out) (call $substr (local.get $sub) (i32.const 0) (local.get $ms)))) (set! $i (i32.add (local.get $i) (i32.const 2))) (br $l)))
                (if (i32.eq (local.get $nx) (i32.const 39))  ;; $' portion after the match
                  (then (set! $out (call $str_concat (local.get $out) (call $substr (local.get $sub) (local.get $me) (i32.sub (call $str_len (local.get $sub)) (local.get $me))))) (set! $i (i32.add (local.get $i) (i32.const 2))) (br $l)))
                ;; $<name> named-group reference (only when the pattern has named groups)
                (if (i32.and (i32.eq (local.get $nx) (i32.const 60)) (i32.load (i32.const 604)))  ;; '<'
                  (then
                    (let $rns i32 (i32.add (local.get $i) (i32.const 2)))
                    (let $rne i32 (local.get $rns))
                    (block $rne2 (loop $rnl (br_if $rne2 (i32.or (i32.ge_s (local.get $rne) (local.get $rl)) (i32.eq (call $str_byte (local.get $replstr) (local.get $rne)) (i32.const 62)))) (set! $rne (i32.add (local.get $rne) (i32.const 1))) (br $rnl)))
                    (let $rgi i32 (call $re_name_to_gidx (i32.add (local.get $replstr) (i32.const 4)) (local.get $rns) (local.get $rne)))
                    (if (i32.gt_s (local.get $rgi) (i32.const 0))
                      (then
                        (let $rcb i32 (i32.add (i32.load (i32.const 280)) (i32.mul (i32.sub (local.get $rgi) (i32.const 1)) (i32.const 8))))
                        (let $rcs i32 (i32.load (local.get $rcb)))
                        (if (i32.ge_s (local.get $rcs) (i32.const 0)) (then (set! $out (call $str_concat (local.get $out) (call $substr (local.get $sub) (local.get $rcs) (i32.sub (i32.load (i32.add (local.get $rcb) (i32.const 4))) (local.get $rcs)))))))))
                    (set! $i (i32.add (local.get $rne) (i32.const 1))) (br $l)))
                (if (i32.and (i32.ge_s (local.get $nx) (i32.const 49)) (i32.le_s (local.get $nx) (i32.const 57)))  ;; $1-$9
                  (then
                    (let $gn i32 (i32.sub (local.get $nx) (i32.const 48)))
                    (if (i32.le_s (local.get $gn) (i32.load (i32.const 284)))
                      (then
                        (let $cb i32 (i32.add (i32.load (i32.const 280)) (i32.mul (i32.sub (local.get $gn) (i32.const 1)) (i32.const 8))))
                        (let $cs i32 (i32.load (local.get $cb)))
                        (if (i32.ge_s (local.get $cs) (i32.const 0)) (then (set! $out (call $str_concat (local.get $out) (call $substr (local.get $sub) (local.get $cs) (i32.sub (i32.load (i32.add (local.get $cb) (i32.const 4))) (local.get $cs)))))))
                        (set! $i (i32.add (local.get $i) (i32.const 2))) (br $l))
                      (else (set! $out (call $str_concat (local.get $out) (call $substr (local.get $replstr) (local.get $i) (i32.const 2)))) (set! $i (i32.add (local.get $i) (i32.const 2))) (br $l)))))))
            (set! $out (call $str_concat (local.get $out) (call $substr (local.get $replstr) (local.get $i) (i32.const 1))))
            (set! $i (i32.add (local.get $i) (i32.const 1)))
            (br $l)))
          (local.get $out))))))

;; one capture (1-based $n) from a RegExpExec RESULT object → Str ptr ("" if the
;; capture is undefined). Reads Get(result, ToString(n)), so it works for a custom exec.
(func $sub_cap (param $result i64) (param $n i32) (result i32) (effects)
  (let $cv i64 (call $get_prop (local.get $result) (call $mk_str (call $num_to_str (f64.convert_i32_s (local.get $n))))))
  (if (call $err) (then (return (cstring ""))))
  (if (call $is_undefined (local.get $cv)) (then (return (cstring ""))))
  (call $to_str (local.get $cv)))

;; GetSubstitution(matched, str, position, result, nCaptures, namedCaptures, replacement).
;; Expands $$ $& $` $' $n $nn $<name> reading captures from the RESULT object. Returns a Str ptr.
(func $get_substitution (param $matched i32) (param $sval i32) (param $position i32) (param $result i64) (param $ncap i32) (param $named i64) (param $repl i32) (result i32) (effects)
  (let $mlen i32 (call $str_len (local.get $matched)))
  (let $slen i32 (call $str_len (local.get $sval)))
  (let $tail i32 (i32.add (local.get $position) (local.get $mlen)))
  (if (i32.eqz (call $str_has_char (local.get $repl) (i32.const 36))) (then (return (local.get $repl))))
  (let $out i32 (cstring ""))
  (let $i i32 (i32.const 0))
  (let $rl i32 (call $str_len (local.get $repl)))
  (let $hasnamed i32 (i32.eqz (i32.or (call $is_undefined (local.get $named)) (call $is_null (local.get $named)))))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $rl)))
    (let $ch i32 (call $str_byte (local.get $repl) (local.get $i)))
    (if (i32.and (i32.eq (local.get $ch) (i32.const 36)) (i32.lt_s (i32.add (local.get $i) (i32.const 1)) (local.get $rl)))  ;; '$' + something
      (then
        (let $nx i32 (call $str_byte (local.get $repl) (i32.add (local.get $i) (i32.const 1))))
        (if (i32.eq (local.get $nx) (i32.const 36))  ;; $$
          (then (set! $out (call $str_concat (local.get $out) (cstring "$"))) (set! $i (i32.add (local.get $i) (i32.const 2))) (br $l)))
        (if (i32.eq (local.get $nx) (i32.const 38))  ;; $&
          (then (set! $out (call $str_concat (local.get $out) (local.get $matched))) (set! $i (i32.add (local.get $i) (i32.const 2))) (br $l)))
        (if (i32.eq (local.get $nx) (i32.const 96))  ;; $` (before)
          (then (set! $out (call $str_concat (local.get $out) (call $substr (local.get $sval) (i32.const 0) (local.get $position)))) (set! $i (i32.add (local.get $i) (i32.const 2))) (br $l)))
        (if (i32.eq (local.get $nx) (i32.const 39))  ;; $' (after)
          (then (set! $out (call $str_concat (local.get $out) (call $substr (local.get $sval) (local.get $tail) (i32.sub (local.get $slen) (local.get $tail))))) (set! $i (i32.add (local.get $i) (i32.const 2))) (br $l)))
        (if (i32.and (i32.eq (local.get $nx) (i32.const 60)) (local.get $hasnamed))  ;; $<name>
          (then
            (let $ns i32 (i32.add (local.get $i) (i32.const 2)))
            (let $ne i32 (local.get $ns))
            (block $ne2 (loop $nl (br_if $ne2 (i32.or (i32.ge_s (local.get $ne) (local.get $rl)) (i32.eq (call $str_byte (local.get $repl) (local.get $ne)) (i32.const 62)))) (set! $ne (i32.add (local.get $ne) (i32.const 1))) (br $nl)))
            ;; only consume the group if a closing '>' was found
            (if (i32.lt_s (local.get $ne) (local.get $rl))
              (then
                (let $gv i64 (call $get_prop (local.get $named) (call $mk_str (call $substr (local.get $repl) (local.get $ns) (i32.sub (local.get $ne) (local.get $ns))))))
                (if (call $err) (then (return (cstring ""))))
                (if (i32.eqz (call $is_undefined (local.get $gv))) (then (set! $out (call $str_concat (local.get $out) (call $to_str (local.get $gv))))))
                (set! $i (i32.add (local.get $ne) (i32.const 1))) (br $l)))))
        (if (i32.and (i32.ge_s (local.get $nx) (i32.const 48)) (i32.le_s (local.get $nx) (i32.const 57)))  ;; $0-$9 — a 2-digit $nn (e.g. $01) takes precedence, else 1-digit $n (n>=1)
          (then
            (let $d1 i32 (i32.sub (local.get $nx) (i32.const 48)))
            (let $two i32 (i32.const -1))
            (if (i32.lt_s (i32.add (local.get $i) (i32.const 2)) (local.get $rl))
              (then (let $c2 i32 (call $str_byte (local.get $repl) (i32.add (local.get $i) (i32.const 2))))
                (if (i32.and (i32.ge_s (local.get $c2) (i32.const 48)) (i32.le_s (local.get $c2) (i32.const 57)))
                  (then (set! $two (i32.add (i32.mul (local.get $d1) (i32.const 10)) (i32.sub (local.get $c2) (i32.const 48))))))))
            (if (i32.and (i32.ge_s (local.get $two) (i32.const 1)) (i32.le_s (local.get $two) (local.get $ncap)))  ;; two-digit group $nn (01..ncap)
              (then (set! $out (call $str_concat (local.get $out) (call $sub_cap (local.get $result) (local.get $two)))) (set! $i (i32.add (local.get $i) (i32.const 3))) (br $l)))
            (if (i32.and (i32.ge_s (local.get $d1) (i32.const 1)) (i32.le_s (local.get $d1) (local.get $ncap)))  ;; single-digit group $n ($0 is not a capture)
              (then (set! $out (call $str_concat (local.get $out) (call $sub_cap (local.get $result) (local.get $d1)))) (set! $i (i32.add (local.get $i) (i32.const 2))) (br $l)))))))
    (set! $out (call $str_concat (local.get $out) (call $substr (local.get $repl) (local.get $i) (i32.const 1))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (local.get $out))

;; Set(regex, "lastIndex", v, true) — the spec Throw=true means a non-writable own
;; lastIndex throws a TypeError regardless of strict mode (unlike a normal store).
(func $re_set_lastindex (param $rx i64) (param $v i64) (effects)
  (if (call $is_object (local.get $rx))
    (then
      (let $sl i32 (call $scope_find_local (call $val_payload (local.get $rx)) (cstring "lastIndex")))
      (if (local.get $sl)
        (then (if (i32.eqz (call $entry_writable (local.get $sl)))
          (then (call $throw_type (cstring "TypeError") (cstring "Cannot assign to read only property 'lastIndex'")) (return)))))))
  (call $set_prop (local.get $rx) (call $mk_str (cstring "lastIndex")) (local.get $v)))

;; index of `ndl` in `hay` at/after `from`, or -1
(func $str_find (param $hay i32) (param $ndl i32) (param $from i32) (result i32) (effects)
  (let $hl i32 (call $str_len (local.get $hay)))
  (let $nl i32 (call $str_len (local.get $ndl)))
  (let $i i32 (local.get $from))
  (block $e (loop $l
    (br_if $e (i32.gt_s (i32.add (local.get $i) (local.get $nl)) (local.get $hl)))
    (let $j i32 (i32.const 0)) (let $ok i32 (i32.const 1))
    (block $je (loop $jl
      (br_if $je (i32.ge_s (local.get $j) (local.get $nl)))
      (if (i32.ne (call $str_byte (local.get $hay) (i32.add (local.get $i) (local.get $j))) (call $str_byte (local.get $ndl) (local.get $j))) (then (set! $ok (i32.const 0)) (br $je)))
      (set! $j (i32.add (local.get $j) (i32.const 1))) (br $jl)))
    (if (local.get $ok) (then (return (local.get $i))))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
  (i32.const -1))

;; set reg 272 (ignorecase 'i') and 276 (global 'g') from a regex value's flags
(func $re_apply_flags (param $v i64) (effects)
  (i32.store (i32.const 272) (i32.const 0)) (i32.store (i32.const 276) (i32.const 0)) (i32.store (i32.const 644) (i32.const 0))
  (if (call $is_object (local.get $v))
    (then
      (let $sl i32 (call $scope_find_local (call $val_payload (local.get $v)) (cstring "__re_flags__")))
      (if (local.get $sl)
        (then
          (let $fv i64 (i64.load (local.get $sl)))
          (if (call $is_string (local.get $fv))
            (then
              (i32.store (i32.const 272) (call $str_has_char (call $val_payload (local.get $fv)) (i32.const 105)))
              (i32.store (i32.const 276) (call $str_has_char (call $val_payload (local.get $fv)) (i32.const 103)))
              (i32.store (i32.const 644) (call $str_has_char (call $val_payload (local.get $fv)) (i32.const 121))))))))))  ;; 'y' sticky → reg 644

;; does escape letter `e` match char `ch`?  (ch = -1 means past end)
(func $re_esc_match (param $e i32) (param $ch i32) (result i32) (effects)
  (if (i32.lt_s (local.get $ch) (i32.const 0)) (then (return (i32.const 0))))
  (if (i32.eq (local.get $e) (i32.const 100))  ;; \d
    (then (return (i32.and (i32.ge_s (local.get $ch) (i32.const 48)) (i32.le_s (local.get $ch) (i32.const 57))))))
  (if (i32.eq (local.get $e) (i32.const 68))   ;; \D
    (then (return (i32.eqz (i32.and (i32.ge_s (local.get $ch) (i32.const 48)) (i32.le_s (local.get $ch) (i32.const 57)))))))
  (if (i32.eq (local.get $e) (i32.const 119))  ;; \w
    (then (return (call $re_is_word (local.get $ch)))))
  (if (i32.eq (local.get $e) (i32.const 87))   ;; \W
    (then (return (i32.eqz (call $re_is_word (local.get $ch))))))
  (if (i32.eq (local.get $e) (i32.const 115))  ;; \s
    (then (return (call $re_is_ws (local.get $ch)))))
  (if (i32.eq (local.get $e) (i32.const 83))   ;; \S
    (then (return (i32.eqz (call $re_is_ws (local.get $ch))))))
  ;; literal escapes: \n \t \r \<char>
  (let $lit i32 (local.get $e))
  (if (i32.eq (local.get $e) (i32.const 110)) (then (set! $lit (i32.const 10))))
  (if (i32.eq (local.get $e) (i32.const 116)) (then (set! $lit (i32.const 9))))
  (if (i32.eq (local.get $e) (i32.const 114)) (then (set! $lit (i32.const 13))))
  (call $re_eqc (local.get $ch) (local.get $lit)))

(func $re_is_word (param $ch i32) (result i32) (effects)
  (i32.or (i32.and (i32.ge_s (local.get $ch) (i32.const 48)) (i32.le_s (local.get $ch) (i32.const 57)))
    (i32.or (i32.and (i32.ge_s (local.get $ch) (i32.const 65)) (i32.le_s (local.get $ch) (i32.const 90)))
      (i32.or (i32.and (i32.ge_s (local.get $ch) (i32.const 97)) (i32.le_s (local.get $ch) (i32.const 122)))
              (i32.eq (local.get $ch) (i32.const 95))))))
(func $re_is_ws (param $ch i32) (result i32) (effects)
  (i32.or (i32.eq (local.get $ch) (i32.const 32)) (i32.or (i32.eq (local.get $ch) (i32.const 9))
    (i32.or (i32.eq (local.get $ch) (i32.const 10)) (i32.or (i32.eq (local.get $ch) (i32.const 13)) (i32.eq (local.get $ch) (i32.const 12)))))))

;; byte at pattern offset i (p = absolute addr), or -1 if i>=plen
(func $re_pb (param $p i32) (param $plen i32) (param $i i32) (result i32) (effects)
  (if i32 (i32.ge_s (local.get $i) (local.get $plen)) (then (i32.const -1)) (else (i32.load8_u (i32.add (local.get $p) (local.get $i))))))

;; end offset of the atom starting at ppos
(func $re_atom_end (param $p i32) (param $plen i32) (param $ppos i32) (result i32) (effects)
  (let $c i32 (call $re_pb (local.get $p) (local.get $plen) (local.get $ppos)))
  (if (i32.eq (local.get $c) (i32.const 92)) (then (return (i32.add (local.get $ppos) (i32.const 2)))))  ;; \X
  (if (i32.eq (local.get $c) (i32.const 91))  ;; [..]
    (then
      (let $i i32 (i32.add (local.get $ppos) (i32.const 1)))
      (if (i32.eq (call $re_pb (local.get $p) (local.get $plen) (local.get $i)) (i32.const 94)) (then (set! $i (i32.add (local.get $i) (i32.const 1)))))  ;; ^
      (if (i32.eq (call $re_pb (local.get $p) (local.get $plen) (local.get $i)) (i32.const 93)) (then (set! $i (i32.add (local.get $i) (i32.const 1)))))  ;; literal ] first
      (block $e (loop $l
        (let $d i32 (call $re_pb (local.get $p) (local.get $plen) (local.get $i)))
        (br_if $e (i32.lt_s (local.get $d) (i32.const 0)))
        (br_if $e (i32.eq (local.get $d) (i32.const 93)))  ;; ]
        (if (i32.eq (local.get $d) (i32.const 92)) (then (set! $i (i32.add (local.get $i) (i32.const 1)))))  ;; skip escaped
        (set! $i (i32.add (local.get $i) (i32.const 1)))
        (br $l)))
      (return (i32.add (local.get $i) (i32.const 1)))))  ;; past ]
  (i32.add (local.get $ppos) (i32.const 1)))

;; does char class [start..end) (between [ and ]) match `ch`?
(func $re_class_match (param $p i32) (param $start i32) (param $end i32) (param $ch i32) (result i32) (effects)
  (if (i32.lt_s (local.get $ch) (i32.const 0)) (then (return (i32.const 0))))
  (let $i i32 (local.get $start))
  (let $neg i32 (i32.const 0))
  (if (i32.eq (i32.load8_u (i32.add (local.get $p) (local.get $i))) (i32.const 94)) (then (set! $neg (i32.const 1)) (set! $i (i32.add (local.get $i) (i32.const 1)))))
  (let $found i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $end)))
    (let $c i32 (i32.load8_u (i32.add (local.get $p) (local.get $i))))
    (if (i32.eq (local.get $c) (i32.const 92))  ;; escape in class
      (then
        (if (call $re_esc_match (i32.load8_u (i32.add (local.get $p) (i32.add (local.get $i) (i32.const 1)))) (local.get $ch)) (then (set! $found (i32.const 1))))
        (set! $i (i32.add (local.get $i) (i32.const 2)))
        (br $l)))
    ;; range a-b ?
    (if (i32.and (i32.lt_s (i32.add (local.get $i) (i32.const 2)) (local.get $end))
          (i32.eq (i32.load8_u (i32.add (local.get $p) (i32.add (local.get $i) (i32.const 1)))) (i32.const 45)))
      (then
        (let $hi i32 (i32.load8_u (i32.add (local.get $p) (i32.add (local.get $i) (i32.const 2)))))
        (if (i32.and (i32.ge_s (local.get $ch) (local.get $c)) (i32.le_s (local.get $ch) (local.get $hi))) (then (set! $found (i32.const 1))))
        (if (i32.load (i32.const 272))  ;; case-insensitive: also test the swapped-case char
          (then (if (i32.and (i32.ge_s (call $re_swapc (local.get $ch)) (local.get $c)) (i32.le_s (call $re_swapc (local.get $ch)) (local.get $hi))) (then (set! $found (i32.const 1))))))
        (set! $i (i32.add (local.get $i) (i32.const 3)))
        (br $l)))
    (if (call $re_eqc (local.get $ch) (local.get $c)) (then (set! $found (i32.const 1))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (if i32 (local.get $neg) (then (i32.eqz (local.get $found))) (else (local.get $found))))

;; does the atom [astart,aend) match char `ch`?
(func $re_atom_match (param $p i32) (param $astart i32) (param $aend i32) (param $ch i32) (result i32) (effects)
  (if (i32.lt_s (local.get $ch) (i32.const 0)) (then (return (i32.const 0))))
  (let $c i32 (i32.load8_u (i32.add (local.get $p) (local.get $astart))))
  (if (i32.eq (local.get $c) (i32.const 46)) (then (return (i32.ne (local.get $ch) (i32.const 10)))))  ;; .
  (if (i32.eq (local.get $c) (i32.const 92)) (then (return (call $re_esc_match (i32.load8_u (i32.add (local.get $p) (i32.add (local.get $astart) (i32.const 1)))) (local.get $ch)))))  ;; \X
  (if (i32.eq (local.get $c) (i32.const 91)) (then (return (call $re_class_match (local.get $p) (i32.add (local.get $astart) (i32.const 1)) (i32.sub (local.get $aend) (i32.const 1)) (local.get $ch)))))  ;; [..]
  (call $re_eqc (local.get $ch) (local.get $c)))

;; match pattern[ppos..] against subject starting at spos; return END spos or -1
(func $re_match (param $p i32) (param $plen i32) (param $ppos i32) (param $s i32) (param $slen i32) (param $spos i32) (result i32) (effects)
  (if (i32.ge_s (local.get $ppos) (local.get $plen)) (then (return (local.get $spos))))
  (let $c i32 (i32.load8_u (i32.add (local.get $p) (local.get $ppos))))
  (if (i32.eq (local.get $c) (i32.const 94))  ;; ^
    (then (if (i32.eqz (local.get $spos)) (then (return (call $re_match (local.get $p) (local.get $plen) (i32.add (local.get $ppos) (i32.const 1)) (local.get $s) (local.get $slen) (local.get $spos)))) (else (return (i32.const -1))))))
  (if (i32.eq (local.get $c) (i32.const 36))  ;; $
    (then (if (i32.eq (local.get $spos) (local.get $slen)) (then (return (call $re_match (local.get $p) (local.get $plen) (i32.add (local.get $ppos) (i32.const 1)) (local.get $s) (local.get $slen) (local.get $spos)))) (else (return (i32.const -1))))))
  ;; backreference \1..\9 (numbered) or \k<name> (named)
  (if (i32.eq (local.get $c) (i32.const 92))  ;; '\'
    (then
      (let $bnc i32 (call $re_pb (local.get $p) (local.get $plen) (i32.add (local.get $ppos) (i32.const 1))))
      (if (i32.and (i32.ge_s (local.get $bnc) (i32.const 49)) (i32.le_s (local.get $bnc) (i32.const 57)))  ;; '1'..'9'
        (then
          (let $br i32 (call $re_match_backref (i32.sub (local.get $bnc) (i32.const 48)) (local.get $s) (local.get $slen) (local.get $spos)))
          (if (i32.lt_s (local.get $br) (i32.const 0)) (then (return (i32.const -1))))
          (return (call $re_match (local.get $p) (local.get $plen) (i32.add (local.get $ppos) (i32.const 2)) (local.get $s) (local.get $slen) (local.get $br)))))
      (if (i32.and (i32.eq (local.get $bnc) (i32.const 107)) (i32.eq (call $re_pb (local.get $p) (local.get $plen) (i32.add (local.get $ppos) (i32.const 2))) (i32.const 60)))  ;; \k<
        (then
          (let $kns i32 (i32.add (local.get $ppos) (i32.const 3)))
          (let $kne i32 (local.get $kns))
          (block $kne2 (loop $knl (br_if $kne2 (i32.or (i32.ge_s (local.get $kne) (local.get $plen)) (i32.eq (i32.load8_u (i32.add (local.get $p) (local.get $kne))) (i32.const 62)))) (set! $kne (i32.add (local.get $kne) (i32.const 1))) (br $knl)))
          (let $kr i32 (call $re_match_backref (call $re_name_to_gidx (local.get $p) (local.get $kns) (local.get $kne)) (local.get $s) (local.get $slen) (local.get $spos)))
          (if (i32.lt_s (local.get $kr) (i32.const 0)) (then (return (i32.const -1))))
          (return (call $re_match (local.get $p) (local.get $plen) (i32.add (local.get $kne) (i32.const 1)) (local.get $s) (local.get $slen) (local.get $kr)))))))
  (if (i32.eq (local.get $c) (i32.const 40))  ;; '(' group (capturing, (?:non-capturing), or (?=/(?! lookahead)
    (then
      (let $gend i32 (call $re_group_end (local.get $p) (local.get $plen) (local.get $ppos)))  ;; ')' position
      (let $after i32 (i32.add (local.get $gend) (i32.const 1)))
      (let $pfx i32 (call $re_pb (local.get $p) (local.get $plen) (i32.add (local.get $ppos) (i32.const 1))))   ;; char after '('
      (let $pfx2 i32 (call $re_pb (local.get $p) (local.get $plen) (i32.add (local.get $ppos) (i32.const 2))))  ;; char after that
      ;; (?=...) positive / (?!...) negative lookahead — zero-width assertion
      (if (i32.and (i32.eq (local.get $pfx) (i32.const 63)) (i32.or (i32.eq (local.get $pfx2) (i32.const 61)) (i32.eq (local.get $pfx2) (i32.const 33))))
        (then
          (let $lm i32 (call $re_match_alt (local.get $p) (i32.add (local.get $ppos) (i32.const 3)) (local.get $gend) (local.get $s) (local.get $slen) (local.get $spos)))
          (let $lok i32 (if i32 (i32.eq (local.get $pfx2) (i32.const 61)) (then (i32.ge_s (local.get $lm) (i32.const 0))) (else (i32.lt_s (local.get $lm) (i32.const 0)))))
          (if (local.get $lok)
            (then (return (call $re_match (local.get $p) (local.get $plen) (local.get $after) (local.get $s) (local.get $slen) (local.get $spos))))  ;; continue at SAME spos
            (else (return (i32.const -1))))))
      ;; (?<=...) / (?<!...) lookbehind — zero-width: the body must match ENDING at spos.
      ;; Scan candidate starts j≤spos and match the body constrained to [0,spos) (pass
      ;; spos as the effective length) so it can't overshoot; success = some j ends at spos.
      (if (i32.and (i32.eq (local.get $pfx) (i32.const 63)) (i32.and (i32.eq (local.get $pfx2) (i32.const 60)) (i32.or (i32.eq (call $re_pb (local.get $p) (local.get $plen) (i32.add (local.get $ppos) (i32.const 3))) (i32.const 61)) (i32.eq (call $re_pb (local.get $p) (local.get $plen) (i32.add (local.get $ppos) (i32.const 3))) (i32.const 33)))))
        (then
          (let $lbneg i32 (i32.eq (call $re_pb (local.get $p) (local.get $plen) (i32.add (local.get $ppos) (i32.const 3))) (i32.const 33)))
          (let $lbBody i32 (i32.add (local.get $ppos) (i32.const 4)))
          (let $lbFound i32 (i32.const 0))
          (let $lj i32 (local.get $spos))
          (block $lbe (loop $lbl
            (br_if $lbe (i32.lt_s (local.get $lj) (i32.const 0)))
            (if (i32.eq (call $re_match_alt (local.get $p) (local.get $lbBody) (local.get $gend) (local.get $s) (local.get $spos) (local.get $lj)) (local.get $spos)) (then (set! $lbFound (i32.const 1)) (br $lbe)))
            (set! $lj (i32.sub (local.get $lj) (i32.const 1))) (br $lbl)))
          (if (if i32 (local.get $lbneg) (then (i32.eqz (local.get $lbFound))) (else (local.get $lbFound)))
            (then (return (call $re_match (local.get $p) (local.get $plen) (local.get $after) (local.get $s) (local.get $slen) (local.get $spos))))
            (else (return (i32.const -1))))))
      ;; (?:...) non-capturing → body at +3, gidx 0; (?<name>...) named capture → body
      ;; past '>', counts as a capture; else plain capturing → +1
      (let $gstart i32 (i32.add (local.get $ppos) (i32.const 1)))
      (let $gidx i32 (i32.const 0))
      (if (i32.and (i32.eq (local.get $pfx) (i32.const 63)) (i32.eq (local.get $pfx2) (i32.const 58)))  ;; (?:
        (then (set! $gstart (i32.add (local.get $ppos) (i32.const 3))))
        (else
          (if (call $re_is_cap_group (local.get $p) (local.get $ppos))
            (then
              (set! $gidx (call $re_group_idx (local.get $p) (local.get $ppos)))
              (if (i32.eq (local.get $pfx) (i32.const 63))  ;; (?<name> → skip past '>'
                (then
                  (let $np i32 (i32.add (local.get $ppos) (i32.const 3)))
                  (block $npe (loop $npl (br_if $npe (i32.or (i32.ge_s (local.get $np) (local.get $gend)) (i32.eq (i32.load8_u (i32.add (local.get $p) (local.get $np))) (i32.const 62)))) (set! $np (i32.add (local.get $np) (i32.const 1))) (br $npl)))
                  (set! $gstart (i32.add (local.get $np) (i32.const 1))))))
            (else (set! $gstart (i32.add (local.get $ppos) (i32.const 3)))))))  ;; other (? non-capturing
      (let $gq i32 (call $re_pb (local.get $p) (local.get $plen) (local.get $after)))
      (let $gmin i32 (i32.const 1)) (let $gmax i32 (i32.const 1)) (let $gqend i32 (local.get $after))
      (if (i32.eq (local.get $gq) (i32.const 42)) (then (set! $gmin (i32.const 0)) (set! $gmax (i32.add (local.get $slen) (i32.const 1))) (set! $gqend (i32.add (local.get $after) (i32.const 1)))))
      (if (i32.eq (local.get $gq) (i32.const 43)) (then (set! $gmin (i32.const 1)) (set! $gmax (i32.add (local.get $slen) (i32.const 1))) (set! $gqend (i32.add (local.get $after) (i32.const 1)))))
      (if (i32.eq (local.get $gq) (i32.const 63)) (then (set! $gmin (i32.const 0)) (set! $gmax (i32.const 1)) (set! $gqend (i32.add (local.get $after) (i32.const 1)))))
      (if (i32.eq (local.get $gq) (i32.const 123)) (then (call $re_parse_brace (local.get $p) (local.get $plen) (local.get $after)) (set! $gmin (i32.load (i32.const 172))) (set! $gmax (i32.load (i32.const 176))) (set! $gqend (i32.load (i32.const 180)))))
      (return (call $re_group_rep (local.get $p) (local.get $plen) (local.get $gstart) (local.get $gend) (local.get $gqend) (local.get $gmin) (local.get $gmax) (local.get $s) (local.get $slen) (local.get $spos) (local.get $gidx)))))
  (let $aend i32 (call $re_atom_end (local.get $p) (local.get $plen) (local.get $ppos)))
  (let $q i32 (call $re_pb (local.get $p) (local.get $plen) (local.get $aend)))
  (let $min i32 (i32.const 1))
  (let $max i32 (i32.const 1))
  (let $qend i32 (local.get $aend))
  (if (i32.eq (local.get $q) (i32.const 42)) (then (set! $min (i32.const 0)) (set! $max (i32.add (local.get $slen) (i32.const 1))) (set! $qend (i32.add (local.get $aend) (i32.const 1)))))  ;; *
  (if (i32.eq (local.get $q) (i32.const 43)) (then (set! $min (i32.const 1)) (set! $max (i32.add (local.get $slen) (i32.const 1))) (set! $qend (i32.add (local.get $aend) (i32.const 1)))))  ;; +
  (if (i32.eq (local.get $q) (i32.const 63)) (then (set! $min (i32.const 0)) (set! $max (i32.const 1)) (set! $qend (i32.add (local.get $aend) (i32.const 1)))))  ;; ?
  (if (i32.eq (local.get $q) (i32.const 123)) (then (call $re_parse_brace (local.get $p) (local.get $plen) (local.get $aend))  ;; {n,m} → sets regs 172/176/180
    (set! $min (i32.load (i32.const 172))) (set! $max (i32.load (i32.const 176))) (set! $qend (i32.load (i32.const 180)))))
  ;; lazy modifier: a '?' right after the quantifier (a+?, a*?, a??, a{2,3}?)
  (let $lazy i32 (i32.const 0))
  (if (i32.or (i32.eq (local.get $q) (i32.const 42)) (i32.or (i32.eq (local.get $q) (i32.const 43)) (i32.or (i32.eq (local.get $q) (i32.const 63)) (i32.eq (local.get $q) (i32.const 123)))))
    (then (if (i32.eq (call $re_pb (local.get $p) (local.get $plen) (local.get $qend)) (i32.const 63))
      (then (set! $lazy (i32.const 1)) (set! $qend (i32.add (local.get $qend) (i32.const 1)))))))
  ;; count consecutive atom matches up to max
  (let $count i32 (i32.const 0))
  (block $ce (loop $cl
    (br_if $ce (i32.ge_s (local.get $count) (local.get $max)))
    (br_if $ce (i32.ge_s (i32.add (local.get $spos) (local.get $count)) (local.get $slen)))
    (br_if $ce (i32.eqz (call $re_atom_match (local.get $p) (local.get $ppos) (local.get $aend) (i32.load8_u (i32.add (local.get $s) (i32.add (local.get $spos) (local.get $count)))))))
    (set! $count (i32.add (local.get $count) (i32.const 1)))
    (br $cl)))
  (if (local.get $lazy)
    (then  ;; lazy: try the FEWEST repetitions first, expanding up to count
      (let $tc i32 (local.get $min))
      (block $le (loop $ll
        (br_if $le (i32.gt_s (local.get $tc) (local.get $count)))
        (let $r i32 (call $re_match (local.get $p) (local.get $plen) (local.get $qend) (local.get $s) (local.get $slen) (i32.add (local.get $spos) (local.get $tc))))
        (if (i32.ge_s (local.get $r) (i32.const 0)) (then (return (local.get $r))))
        (set! $tc (i32.add (local.get $tc) (i32.const 1)))
        (br $ll)))
      (return (i32.const -1))))
  ;; greedy: backtrack from count down to min
  (block $be (loop $bl
    (br_if $be (i32.lt_s (local.get $count) (local.get $min)))
    (let $r i32 (call $re_match (local.get $p) (local.get $plen) (local.get $qend) (local.get $s) (local.get $slen) (i32.add (local.get $spos) (local.get $count))))
    (if (i32.ge_s (local.get $r) (i32.const 0)) (then (return (local.get $r))))
    (set! $count (i32.sub (local.get $count) (i32.const 1)))
    (br $bl)))
  (i32.const -1))

;; parse {n}, {n,}, {n,m} at brace pos → regs 172 min, 176 max, 180 qend
(func $re_parse_brace (param $p i32) (param $plen i32) (param $bpos i32) (effects)
  (let $i i32 (i32.add (local.get $bpos) (i32.const 1)))
  (let $n i32 (i32.const 0))
  (block $e1 (loop $l1
    (let $d i32 (call $re_pb (local.get $p) (local.get $plen) (local.get $i)))
    (br_if $e1 (i32.eqz (i32.and (i32.ge_s (local.get $d) (i32.const 48)) (i32.le_s (local.get $d) (i32.const 57)))))
    (set! $n (i32.add (i32.mul (local.get $n) (i32.const 10)) (i32.sub (local.get $d) (i32.const 48))))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l1)))
  (i32.store (i32.const 172) (local.get $n))
  (i32.store (i32.const 176) (local.get $n))  ;; default max = n
  (if (i32.eq (call $re_pb (local.get $p) (local.get $plen) (local.get $i)) (i32.const 44))  ;; ','
    (then
      (set! $i (i32.add (local.get $i) (i32.const 1)))
      (if (i32.eq (call $re_pb (local.get $p) (local.get $plen) (local.get $i)) (i32.const 125))  ;; {n,}
        (then (i32.store (i32.const 176) (i32.const 1000000)))
        (else
          (let $m i32 (i32.const 0))
          (block $e2 (loop $l2
            (let $d i32 (call $re_pb (local.get $p) (local.get $plen) (local.get $i)))
            (br_if $e2 (i32.eqz (i32.and (i32.ge_s (local.get $d) (i32.const 48)) (i32.le_s (local.get $d) (i32.const 57)))))
            (set! $m (i32.add (i32.mul (local.get $m) (i32.const 10)) (i32.sub (local.get $d) (i32.const 48))))
            (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l2)))
          (i32.store (i32.const 176) (local.get $m))))))
  (i32.store (i32.const 180) (i32.add (local.get $i) (i32.const 1))))  ;; past '}'

;; index of the next TOP-LEVEL '|' in [from, to) (respecting [..], \, and nested ()), or to
(func $re_find_pipe (param $p i32) (param $from i32) (param $to i32) (result i32) (effects)
  (let $i i32 (local.get $from))
  (let $incls i32 (i32.const 0))
  (let $depth i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $to)))
    (let $c i32 (i32.load8_u (i32.add (local.get $p) (local.get $i))))
    (if (i32.eq (local.get $c) (i32.const 92)) (then (set! $i (i32.add (local.get $i) (i32.const 2))) (br $l)))  ;; \ escape
    (if (i32.eq (local.get $c) (i32.const 91)) (then (set! $incls (i32.const 1))))  ;; [
    (if (i32.eq (local.get $c) (i32.const 93)) (then (set! $incls (i32.const 0))))  ;; ]
    (if (i32.eqz (local.get $incls))
      (then
        (if (i32.eq (local.get $c) (i32.const 40)) (then (set! $depth (i32.add (local.get $depth) (i32.const 1)))))  ;; (
        (if (i32.eq (local.get $c) (i32.const 41)) (then (set! $depth (i32.sub (local.get $depth) (i32.const 1)))))  ;; )
        (if (i32.and (i32.eq (local.get $c) (i32.const 124)) (i32.eqz (local.get $depth))) (then (return (local.get $i))))))  ;; |
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (local.get $to))

;; 1 if the '(' at pos opens a CAPTURING group: a plain '(' or '(?<name>' (named),
;; but NOT (?:, (?=, (?!, (?<=, (?<! .
(func $re_is_cap_group (param $p i32) (param $pos i32) (result i32) (effects)
  (if (i32.ne (i32.load8_u (i32.add (local.get $p) (i32.add (local.get $pos) (i32.const 1)))) (i32.const 63)) (then (return (i32.const 1))))  ;; '(' not '(?'
  (if (i32.eq (i32.load8_u (i32.add (local.get $p) (i32.add (local.get $pos) (i32.const 2)))) (i32.const 60))  ;; '(?<'
    (then
      (let $c3 i32 (i32.load8_u (i32.add (local.get $p) (i32.add (local.get $pos) (i32.const 3)))))
      (if (i32.or (i32.eq (local.get $c3) (i32.const 61)) (i32.eq (local.get $c3) (i32.const 33))) (then (return (i32.const 0))))  ;; (?<= (?<! lookbehind
      (return (i32.const 1))))  ;; (?<name>
  (i32.const 0))  ;; (?: (?= (?! …

;; index of the ')' matching the '(' at ppos (handles nesting, [..], \)
(func $re_group_end (param $p i32) (param $plen i32) (param $ppos i32) (result i32) (effects)
  (let $i i32 (i32.add (local.get $ppos) (i32.const 1)))
  (let $incls i32 (i32.const 0))
  (let $depth i32 (i32.const 1))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $plen)))
    (let $c i32 (i32.load8_u (i32.add (local.get $p) (local.get $i))))
    (if (i32.eq (local.get $c) (i32.const 92)) (then (set! $i (i32.add (local.get $i) (i32.const 2))) (br $l)))
    (if (i32.eq (local.get $c) (i32.const 91)) (then (set! $incls (i32.const 1))))
    (if (i32.eq (local.get $c) (i32.const 93)) (then (set! $incls (i32.const 0))))
    (if (i32.eqz (local.get $incls))
      (then
        (if (i32.eq (local.get $c) (i32.const 40)) (then (set! $depth (i32.add (local.get $depth) (i32.const 1)))))
        (if (i32.eq (local.get $c) (i32.const 41)) (then (set! $depth (i32.sub (local.get $depth) (i32.const 1))) (br_if $e (i32.eqz (local.get $depth)))))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (local.get $i))  ;; position of the matching ')'

;; 1-based capture index of the '(' at ppos = count of capturing '(' before it
(func $re_group_idx (param $p i32) (param $ppos i32) (result i32) (effects)
  (let $i i32 (i32.const 0))
  (let $incls i32 (i32.const 0))
  (let $n i32 (i32.const 1))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $ppos)))
    (let $c i32 (i32.load8_u (i32.add (local.get $p) (local.get $i))))
    (if (i32.eq (local.get $c) (i32.const 92)) (then (set! $i (i32.add (local.get $i) (i32.const 2))) (br $l)))
    (if (i32.eq (local.get $c) (i32.const 91)) (then (set! $incls (i32.const 1))))
    (if (i32.eq (local.get $c) (i32.const 93)) (then (set! $incls (i32.const 0))))
    ;; only a capturing '(' counts (plain '(' or '(?<name>') — not (?:/(?=/(?!/(?<=/(?<!
    (if (i32.and (i32.eqz (local.get $incls)) (i32.and (i32.eq (local.get $c) (i32.const 40)) (call $re_is_cap_group (local.get $p) (local.get $i)))) (then (set! $n (i32.add (local.get $n) (i32.const 1)))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (local.get $n))

;; capture store: reg 280 = base (cap[2k]=start, cap[2k+1]=end for group k+1), 284 = ngroups
(func $re_reset_caps (param $p i32) (param $plen i32) (effects)
  (if (i32.eqz (i32.load (i32.const 280))) (then (i32.store (i32.const 280) (call $heap_alloc (i32.const 512)))))
  (if (i32.eqz (i32.load (i32.const 600))) (then (i32.store (i32.const 600) (call $heap_alloc (i32.const 512)))))  ;; group-name table (Str ptr per group, 0 = unnamed)
  (i32.store (i32.const 604) (i32.const 0))  ;; hasNamed flag
  (let $i i32 (i32.const 0))
  (block $e (loop $l (br_if $e (i32.ge_s (local.get $i) (i32.const 128)))
    (i32.store (i32.add (i32.load (i32.const 280)) (i32.mul (local.get $i) (i32.const 4))) (i32.const -1))
    (i32.store (i32.add (i32.load (i32.const 600)) (i32.mul (local.get $i) (i32.const 4))) (i32.const 0))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
  ;; count capturing groups + record (?<name> names
  (let $j i32 (i32.const 0)) (let $incls i32 (i32.const 0)) (let $g i32 (i32.const 0))
  (block $e2 (loop $l2
    (br_if $e2 (i32.ge_s (local.get $j) (local.get $plen)))
    (let $c i32 (i32.load8_u (i32.add (local.get $p) (local.get $j))))
    (if (i32.eq (local.get $c) (i32.const 92)) (then (set! $j (i32.add (local.get $j) (i32.const 2))) (br $l2)))
    (if (i32.eq (local.get $c) (i32.const 91)) (then (set! $incls (i32.const 1))))
    (if (i32.eq (local.get $c) (i32.const 93)) (then (set! $incls (i32.const 0))))
    (if (i32.and (i32.eqz (local.get $incls)) (i32.and (i32.eq (local.get $c) (i32.const 40)) (call $re_is_cap_group (local.get $p) (local.get $j))))
      (then
        (set! $g (i32.add (local.get $g) (i32.const 1)))
        ;; (?<name> → extract name [j+3, '>') into a Str at names[g]
        (if (i32.eq (i32.load8_u (i32.add (local.get $p) (i32.add (local.get $j) (i32.const 1)))) (i32.const 63))
          (then
            (let $ns i32 (i32.add (local.get $j) (i32.const 3)))
            (let $ne i32 (local.get $ns))
            (block $nme (loop $nml (br_if $nme (i32.or (i32.ge_s (local.get $ne) (local.get $plen)) (i32.eq (i32.load8_u (i32.add (local.get $p) (local.get $ne))) (i32.const 62)))) (set! $ne (i32.add (local.get $ne) (i32.const 1))) (br $nml)))
            (let $nstr i32 (call $str_alloc (i32.sub (local.get $ne) (local.get $ns))))
            (let $nk i32 (i32.const 0))
            (block $nce (loop $ncl (br_if $nce (i32.ge_s (i32.add (local.get $ns) (local.get $nk)) (local.get $ne)))
              (call $str_set_byte (local.get $nstr) (local.get $nk) (i32.load8_u (i32.add (local.get $p) (i32.add (local.get $ns) (local.get $nk)))))
              (set! $nk (i32.add (local.get $nk) (i32.const 1))) (br $ncl)))
            (i32.store (i32.add (i32.load (i32.const 600)) (i32.mul (local.get $g) (i32.const 4))) (local.get $nstr))
            (i32.store (i32.const 604) (i32.const 1))))))
    (set! $j (i32.add (local.get $j) (i32.const 1))) (br $l2)))
  (i32.store (i32.const 284) (local.get $g)))
(func $re_set_cap (param $gidx i32) (param $start i32) (param $end i32) (effects)
  (if (i32.le_s (local.get $gidx) (i32.const 0)) (then (return)))  ;; non-capturing group → no slot
  (i32.store (i32.add (i32.load (i32.const 280)) (i32.mul (i32.sub (local.get $gidx) (i32.const 1)) (i32.const 8))) (local.get $start))
  (i32.store (i32.add (i32.load (i32.const 280)) (i32.add (i32.mul (i32.sub (local.get $gidx) (i32.const 1)) (i32.const 8)) (i32.const 4))) (local.get $end)))

;; match a backreference to capture group `gidx` at `spos`; returns the end
;; position (>= spos), or -1 on mismatch. An unset group matches the empty string.
(func $re_match_backref (param $gidx i32) (param $s i32) (param $slen i32) (param $spos i32) (result i32) (effects)
  (if (i32.le_s (local.get $gidx) (i32.const 0)) (then (return (local.get $spos))))
  (let $bst i32 (i32.load (i32.add (i32.load (i32.const 280)) (i32.mul (i32.sub (local.get $gidx) (i32.const 1)) (i32.const 8)))))
  (let $ben i32 (i32.load (i32.add (i32.load (i32.const 280)) (i32.add (i32.mul (i32.sub (local.get $gidx) (i32.const 1)) (i32.const 8)) (i32.const 4)))))
  (if (i32.lt_s (local.get $bst) (i32.const 0)) (then (return (local.get $spos))))
  (let $blen i32 (i32.sub (local.get $ben) (local.get $bst)))
  (if (i32.gt_s (i32.add (local.get $spos) (local.get $blen)) (local.get $slen)) (then (return (i32.const -1))))
  (let $bi i32 (i32.const 0))
  (block $bce (loop $bcl
    (br_if $bce (i32.ge_s (local.get $bi) (local.get $blen)))
    (if (i32.eqz (call $re_eqc (i32.load8_u (i32.add (local.get $s) (i32.add (local.get $spos) (local.get $bi)))) (i32.load8_u (i32.add (local.get $s) (i32.add (local.get $bst) (local.get $bi)))))) (then (return (i32.const -1))))
    (set! $bi (i32.add (local.get $bi) (i32.const 1))) (br $bcl)))
  (i32.add (local.get $spos) (local.get $blen)))

;; group index whose recorded name equals the pattern bytes p[ns,ne), else 0.
(func $re_name_to_gidx (param $p i32) (param $ns i32) (param $ne i32) (result i32) (effects)
  (let $nl i32 (i32.sub (local.get $ne) (local.get $ns)))
  (let $g i32 (i32.const 1))
  (block $e (loop $l
    (br_if $e (i32.gt_s (local.get $g) (i32.load (i32.const 284))))
    (let $nm i32 (i32.load (i32.add (i32.load (i32.const 600)) (i32.mul (local.get $g) (i32.const 4)))))
    (if (local.get $nm)
      (then (if (i32.eq (call $str_len (local.get $nm)) (local.get $nl))
        (then
          (let $eq i32 (i32.const 1)) (let $k i32 (i32.const 0))
          (block $ce (loop $cl (br_if $ce (i32.ge_s (local.get $k) (local.get $nl)))
            (if (i32.ne (call $str_byte (local.get $nm) (local.get $k)) (i32.load8_u (i32.add (local.get $p) (i32.add (local.get $ns) (local.get $k))))) (then (set! $eq (i32.const 0)) (br $ce)))
            (set! $k (i32.add (local.get $k) (i32.const 1))) (br $cl)))
          (if (local.get $eq) (then (return (local.get $g))))))))
    (set! $g (i32.add (local.get $g) (i32.const 1))) (br $l)))
  (i32.const 0))

;; define `groups` on a match-result's @12 scope `rprops`: undefined when the
;; pattern has no named groups, else a null-prototype object {name: captureValue}.
;; the null-prototype groups object {name: captureValue}, or undefined if the
;; pattern has no named groups.
(func $re_groups_obj (param $sub i32) (param $off i32) (result i64) (effects)
  (if (i32.eqz (i32.load (i32.const 604))) (then (return (call $v_undef))))
  (let $go i32 (call $scope_new (i32.const 0) (i32.const 8)))  ;; null prototype (spec)
  (let $g i32 (i32.const 1))
  (block $ge (loop $gl
    (br_if $ge (i32.gt_s (local.get $g) (i32.load (i32.const 284))))
    (let $nm i32 (i32.load (i32.add (i32.load (i32.const 600)) (i32.mul (local.get $g) (i32.const 4)))))
    (if (local.get $nm)
      (then
        (let $cb i32 (i32.add (i32.load (i32.const 280)) (i32.mul (i32.sub (local.get $g) (i32.const 1)) (i32.const 8))))
        (let $cs i32 (i32.load (local.get $cb)))
        (if (i32.lt_s (local.get $cs) (i32.const 0))
          (then (call $scope_define (local.get $go) (local.get $nm) (call $v_undef)))
          (else (call $scope_define (local.get $go) (local.get $nm) (call $mk_str (call $substr (local.get $sub) (i32.add (local.get $off) (local.get $cs)) (i32.sub (i32.load (i32.add (local.get $cb) (i32.const 4))) (local.get $cs)))))))))
    (set! $g (i32.add (local.get $g) (i32.const 1))) (br $gl)))
  (call $mk_obj (local.get $go)))
(func $re_set_groups (param $sub i32) (param $off i32) (param $rprops i32) (effects)
  (call $scope_define (local.get $rprops) (cstring "groups") (call $re_groups_obj (local.get $sub) (local.get $off))))

;; match a quantified group: body [gstart,gend), then rest from qend. Count-based
;; variable-length repetition (greedy, backtracking on the rep count).
(func $re_group_rep (param $p i32) (param $plen i32) (param $gstart i32) (param $gend i32) (param $qend i32) (param $min i32) (param $max i32) (param $s i32) (param $slen i32) (param $spos i32) (param $gidx i32) (result i32) (effects)
  (let $positions i32 (call $heap_alloc (i32.const 1024)))
  (i32.store (local.get $positions) (local.get $spos))
  (let $count i32 (i32.const 0))
  (let $cp i32 (local.get $spos))
  (block $ce (loop $cl
    (br_if $ce (i32.ge_s (local.get $count) (local.get $max)))
    (let $e i32 (call $re_match_alt (local.get $p) (local.get $gstart) (local.get $gend) (local.get $s) (local.get $slen) (local.get $cp)))
    (br_if $ce (i32.lt_s (local.get $e) (i32.const 0)))  ;; body failed → stop
    (set! $count (i32.add (local.get $count) (i32.const 1)))
    (i32.store (i32.add (local.get $positions) (i32.mul (local.get $count) (i32.const 4))) (local.get $e))
    ;; a zero-progress (empty) match is counted ONCE (so it can satisfy min) but then we
    ;; stop, to avoid looping forever on an empty body / empty-matching group.
    (br_if $ce (i32.le_s (local.get $e) (local.get $cp)))
    (set! $cp (local.get $e))
    (br $cl)))
  (block $be (loop $bl
    (br_if $be (i32.lt_s (local.get $count) (local.get $min)))
    (let $bp i32 (i32.load (i32.add (local.get $positions) (i32.mul (local.get $count) (i32.const 4)))))
    (if (i32.gt_s (local.get $count) (i32.const 0))
      (then (call $re_set_cap (local.get $gidx) (i32.load (i32.add (local.get $positions) (i32.mul (i32.sub (local.get $count) (i32.const 1)) (i32.const 4)))) (local.get $bp))))
    (let $r i32 (call $re_match (local.get $p) (local.get $plen) (local.get $qend) (local.get $s) (local.get $slen) (local.get $bp)))
    (if (i32.ge_s (local.get $r) (i32.const 0)) (then (return (local.get $r))))
    (set! $count (i32.sub (local.get $count) (i32.const 1)))
    (br $bl)))
  (i32.const -1))

;; match at spos, trying each top-level alternative in [from,to) left-to-right
(func $re_match_alt (param $p i32) (param $from i32) (param $to i32) (param $s i32) (param $slen i32) (param $spos i32) (result i32) (effects)
  (let $segstart i32 (local.get $from))
  (block $e (loop $l
    (let $segend i32 (call $re_find_pipe (local.get $p) (local.get $segstart) (local.get $to)))
    (let $r i32 (call $re_match (local.get $p) (local.get $segend) (local.get $segstart) (local.get $s) (local.get $slen) (local.get $spos)))
    (if (i32.ge_s (local.get $r) (i32.const 0)) (then (return (local.get $r))))
    (br_if $e (i32.ge_s (local.get $segend) (local.get $to)))
    (set! $segstart (i32.add (local.get $segend) (i32.const 1)))
    (br $l)))
  (i32.const -1))

;; search subject for first match; return START offset (or -1), END in reg 168
(func $re_search (param $p i32) (param $plen i32) (param $s i32) (param $slen i32) (result i32) (effects)
  (call $re_reset_caps (local.get $p) (local.get $plen))
  (let $start i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.gt_s (local.get $start) (local.get $slen)))
    (let $r i32 (call $re_match_alt (local.get $p) (i32.const 0) (local.get $plen) (local.get $s) (local.get $slen) (local.get $start)))
    (if (i32.ge_s (local.get $r) (i32.const 0)) (then (i32.store (i32.const 168) (local.get $r)) (return (local.get $start))))
    (set! $start (i32.add (local.get $start) (i32.const 1)))
    (br $l)))
  (i32.const -1))

;; pattern Str from a value: a regex object's __re_src__, else ToString(value)
(func $re_pat_of (param $v i64) (result i32) (effects)
  (if i32 (call $is_object (local.get $v))
    (then
      (let $sl i32 (call $scope_find_local (call $val_payload (local.get $v)) (cstring "__re_src__")))
      (if i32 (local.get $sl)
        (then (let $sv i64 (i64.load (local.get $sl)))
              (if i32 (call $is_string (local.get $sv)) (then (call $val_payload (local.get $sv))) (else (call $to_str (local.get $v)))))
        (else (call $to_str (local.get $v)))))
    (else (call $to_str (local.get $v)))))

;; RegExpExec(R, S): if R.exec is callable, Call(exec, R, «S») and validate the result
;; is Object|null; else (R must be a RegExp) run the builtin exec (native 167). $sval is
;; the string VALUE. Returns an array | null | whatever a user exec returns; sets $err on abrupt.
(func $regexp_exec (param $rx i64) (param $sval i64) (result i64) (effects)
  (let $rex i64 (call $get_prop (local.get $rx) (call $mk_str (cstring "exec"))))
  (if (call $err) (then (return (call $v_undef))))
  (if (call $is_function (local.get $rex))
    (then
      (let $rer i64 (call $call_val (local.get $rex) (i32.const 1) (call $argv1 (local.get $sval)) (local.get $rx)))
      (if (call $err) (then (return (call $v_undef))))
      (if (i32.eqz (i32.or (call $is_object (local.get $rer)) (i32.or (call $is_array (local.get $rer)) (call $is_null (local.get $rer)))))
        (then (call $throw_type (cstring "TypeError") (cstring "exec method must return an Object or null")) (return (call $v_undef))))
      (return (local.get $rer))))
  (if (i32.eqz (call $is_regexp (local.get $rx)))
    (then (call $throw_type (cstring "TypeError") (cstring "RegExpExec called on a non-RegExp object")) (return (call $v_undef))))
  (call $call_native (i32.const 167) (i32.const 1) (call $argv1 (local.get $sval)) (local.get $rx)))

;; convenience: search a Str subject for a Str pattern. start offset or -1.
(func $re_search_str (param $patStr i32) (param $subStr i32) (result i32) (effects)
  (call $re_search (i32.add (local.get $patStr) (i32.const 4)) (call $str_len (local.get $patStr))
                   (i32.add (local.get $subStr) (i32.const 4)) (call $str_len (local.get $subStr))))

;; like re_search but begins scanning at byte offset $from (for g/y exec via lastIndex)
(func $re_search_from (param $p i32) (param $plen i32) (param $s i32) (param $slen i32) (param $from i32) (result i32) (effects)
  (call $re_reset_caps (local.get $p) (local.get $plen))
  (let $start i32 (local.get $from))
  (if (i32.lt_s (local.get $start) (i32.const 0)) (then (set! $start (i32.const 0))))
  (block $e (loop $l
    (br_if $e (i32.gt_s (local.get $start) (local.get $slen)))
    (let $r i32 (call $re_match_alt (local.get $p) (i32.const 0) (local.get $plen) (local.get $s) (local.get $slen) (local.get $start)))
    (if (i32.ge_s (local.get $r) (i32.const 0)) (then (i32.store (i32.const 168) (local.get $r)) (return (local.get $start))))
    (set! $start (i32.add (local.get $start) (i32.const 1)))
    (br $l)))
  (i32.const -1))

(func $re_search_str_from (param $patStr i32) (param $subStr i32) (param $from i32) (result i32) (effects)
  (call $re_search_from (i32.add (local.get $patStr) (i32.const 4)) (call $str_len (local.get $patStr))
                   (i32.add (local.get $subStr) (i32.const 4)) (call $str_len (local.get $subStr)) (local.get $from)))

;; sticky ('y') match: the match must begin EXACTLY at byte offset $from (no forward
;; scan). Returns $from on success (reg 168 = match end) else -1.
(func $re_match_str_at (param $patStr i32) (param $subStr i32) (param $from i32) (result i32) (effects)
  (let $p i32 (i32.add (local.get $patStr) (i32.const 4)))
  (let $plen i32 (call $str_len (local.get $patStr)))
  (let $s i32 (i32.add (local.get $subStr) (i32.const 4)))
  (let $slen i32 (call $str_len (local.get $subStr)))
  (call $re_reset_caps (local.get $p) (local.get $plen))
  (if (i32.or (i32.lt_s (local.get $from) (i32.const 0)) (i32.gt_s (local.get $from) (local.get $slen))) (then (return (i32.const -1))))
  (let $r i32 (call $re_match_alt (local.get $p) (i32.const 0) (local.get $plen) (local.get $s) (local.get $slen) (local.get $from)))
  (if (i32.ge_s (local.get $r) (i32.const 0)) (then (i32.store (i32.const 168) (local.get $r)) (return (local.get $from))))
  (i32.const -1))
