;; duplicates (different alternatives) ALWAYS have a '|' between them, so they're never flagged; an
;; unrelated intervening '|' merely suppresses the check (a missed case, never a false alarm).
(func $re_check_dup_names (param $pat i32) (param $n i32) (effects)
  (let $j i32 (i32.const 0)) (let $jcl i32 (i32.const 0))
  (block $je (loop $jl
    (br_if $je (i32.ge_s (local.get $j) (local.get $n)))
    (let $jc i32 (call $str_byte (local.get $pat) (local.get $j)))
    (if (i32.eq (local.get $jc) (i32.const 92)) (then (set! $j (i32.add (local.get $j) (i32.const 2))) (br $jl)))
    (if (i32.and (i32.eq (local.get $jc) (i32.const 91)) (i32.eqz (local.get $jcl))) (then (set! $jcl (i32.const 1)) (set! $j (i32.add (local.get $j) (i32.const 1))) (br $jl)))
    (if (i32.and (i32.eq (local.get $jc) (i32.const 93)) (local.get $jcl)) (then (set! $jcl (i32.const 0)) (set! $j (i32.add (local.get $j) (i32.const 1))) (br $jl)))
    (if (i32.and (i32.and (i32.eq (local.get $jc) (i32.const 40)) (i32.eqz (local.get $jcl)))
                 (i32.and (i32.lt_s (i32.add (local.get $j) (i32.const 3)) (local.get $n))
                          (i32.and (i32.eq (call $str_byte (local.get $pat) (i32.add (local.get $j) (i32.const 1))) (i32.const 63))
                                   (i32.eq (call $str_byte (local.get $pat) (i32.add (local.get $j) (i32.const 2))) (i32.const 60)))))
      (then
        (let $jc3 i32 (call $str_byte (local.get $pat) (i32.add (local.get $j) (i32.const 3))))
        (if (i32.eqz (i32.or (i32.eq (local.get $jc3) (i32.const 61)) (i32.eq (local.get $jc3) (i32.const 33))))
          (then
            (let $ns i32 (i32.add (local.get $j) (i32.const 3)))
            (let $ne i32 (local.get $ns))
            (block $ge2 (loop $gl2 (br_if $ge2 (i32.ge_s (local.get $ne) (local.get $n))) (if (i32.eq (call $str_byte (local.get $pat) (local.get $ne)) (i32.const 62)) (then (br $ge2))) (set! $ne (i32.add (local.get $ne) (i32.const 1))) (br $gl2)))
            ;; scan FORWARD from this name's '>' for another (?<same>; a '|' (outside a class) before it clears the flag
            (let $k i32 (i32.add (local.get $ne) (i32.const 1))) (let $sawpipe i32 (i32.const 0)) (let $kcl i32 (i32.const 0))
            (block $ke (loop $kl
              (br_if $ke (i32.ge_s (local.get $k) (local.get $n)))
              (let $kc i32 (call $str_byte (local.get $pat) (local.get $k)))
              (if (i32.eq (local.get $kc) (i32.const 92)) (then (set! $k (i32.add (local.get $k) (i32.const 2))) (br $kl)))
              (if (i32.and (i32.eq (local.get $kc) (i32.const 91)) (i32.eqz (local.get $kcl))) (then (set! $kcl (i32.const 1)) (set! $k (i32.add (local.get $k) (i32.const 1))) (br $kl)))
              (if (i32.and (i32.eq (local.get $kc) (i32.const 93)) (local.get $kcl)) (then (set! $kcl (i32.const 0)) (set! $k (i32.add (local.get $k) (i32.const 1))) (br $kl)))
              (if (i32.and (i32.eq (local.get $kc) (i32.const 124)) (i32.eqz (local.get $kcl))) (then (set! $sawpipe (i32.const 1))))  ;; '|' outside a class
              (if (i32.and (i32.and (i32.eq (local.get $kc) (i32.const 40)) (i32.eqz (local.get $kcl)))
                           (i32.and (i32.lt_s (i32.add (local.get $k) (i32.const 3)) (local.get $n))
                                    (i32.and (i32.eq (call $str_byte (local.get $pat) (i32.add (local.get $k) (i32.const 1))) (i32.const 63))
                                             (i32.eq (call $str_byte (local.get $pat) (i32.add (local.get $k) (i32.const 2))) (i32.const 60)))))
                (then
                  (let $kc3 i32 (call $str_byte (local.get $pat) (i32.add (local.get $k) (i32.const 3))))
                  (if (i32.eqz (i32.or (i32.eq (local.get $kc3) (i32.const 61)) (i32.eq (local.get $kc3) (i32.const 33))))
                    (then
                      (let $ns2 i32 (i32.add (local.get $k) (i32.const 3)))
                      (let $ne2 i32 (local.get $ns2))
                      (block $g2e (loop $g2l (br_if $g2e (i32.ge_s (local.get $ne2) (local.get $n))) (if (i32.eq (call $str_byte (local.get $pat) (local.get $ne2)) (i32.const 62)) (then (br $g2e))) (set! $ne2 (i32.add (local.get $ne2) (i32.const 1))) (br $g2l)))
                      (if (i32.and (i32.eqz (local.get $sawpipe)) (i32.eq (i32.sub (local.get $ne) (local.get $ns)) (i32.sub (local.get $ne2) (local.get $ns2))))
                        (then
                          (let $eq i32 (i32.const 1)) (let $m i32 (i32.const 0)) (let $tl i32 (i32.sub (local.get $ne) (local.get $ns)))
                          (block $ce (loop $cl (br_if $ce (i32.ge_s (local.get $m) (local.get $tl)))
                            (if (i32.ne (call $str_byte (local.get $pat) (i32.add (local.get $ns) (local.get $m))) (call $str_byte (local.get $pat) (i32.add (local.get $ns2) (local.get $m)))) (then (set! $eq (i32.const 0)) (br $ce)))
                            (set! $m (i32.add (local.get $m) (i32.const 1))) (br $cl)))
                          (if (local.get $eq) (then (call $throw_type (cstring "SyntaxError") (cstring "Duplicate capture group name")) (return)))))))))
              (set! $k (i32.add (local.get $k) (i32.const 1))) (br $kl)))
            (set! $j (i32.add (local.get $ne) (i32.const 1))) (br $jl)))))
    (set! $j (i32.add (local.get $j) (i32.const 1))) (br $jl))))
;; does the pattern contain a capturing named group whose name equals pat[$ns,$ne)? (forward refs valid)
(func $re_named_group_exists (param $pat i32) (param $n i32) (param $ns i32) (param $ne i32) (result i32) (effects)
  (let $tlen i32 (i32.sub (local.get $ne) (local.get $ns)))
  (let $i i32 (i32.const 0)) (let $inclass i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    (let $c i32 (call $str_byte (local.get $pat) (local.get $i)))
    (if (i32.eq (local.get $c) (i32.const 92)) (then (set! $i (i32.add (local.get $i) (i32.const 2))) (br $l)))
    (if (i32.and (i32.eq (local.get $c) (i32.const 91)) (i32.eqz (local.get $inclass))) (then (set! $inclass (i32.const 1)) (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
    (if (i32.and (i32.eq (local.get $c) (i32.const 93)) (local.get $inclass)) (then (set! $inclass (i32.const 0)) (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
    (if (i32.and (i32.and (i32.eq (local.get $c) (i32.const 40)) (i32.eqz (local.get $inclass)))
                 (i32.and (i32.lt_s (i32.add (local.get $i) (i32.const 3)) (local.get $n))
                          (i32.and (i32.eq (call $str_byte (local.get $pat) (i32.add (local.get $i) (i32.const 1))) (i32.const 63))
                                   (i32.eq (call $str_byte (local.get $pat) (i32.add (local.get $i) (i32.const 2))) (i32.const 60)))))
      (then
        (let $c3 i32 (call $str_byte (local.get $pat) (i32.add (local.get $i) (i32.const 3))))
        (if (i32.eqz (i32.or (i32.eq (local.get $c3) (i32.const 61)) (i32.eq (local.get $c3) (i32.const 33))))
          (then
            (let $gs i32 (i32.add (local.get $i) (i32.const 3)))
            (let $ge i32 (local.get $gs))
            (block $ge2 (loop $gl2 (br_if $ge2 (i32.ge_s (local.get $ge) (local.get $n))) (if (i32.eq (call $str_byte (local.get $pat) (local.get $ge)) (i32.const 62)) (then (br $ge2))) (set! $ge (i32.add (local.get $ge) (i32.const 1))) (br $gl2)))
            (if (i32.eq (i32.sub (local.get $ge) (local.get $gs)) (local.get $tlen))
              (then
                (let $eq i32 (i32.const 1)) (let $k i32 (i32.const 0))
                (block $ce (loop $cl (br_if $ce (i32.ge_s (local.get $k) (local.get $tlen)))
                  (if (i32.ne (call $str_byte (local.get $pat) (i32.add (local.get $gs) (local.get $k))) (call $str_byte (local.get $pat) (i32.add (local.get $ns) (local.get $k)))) (then (set! $eq (i32.const 0)) (br $ce)))
                  (set! $k (i32.add (local.get $k) (i32.const 1))) (br $cl)))
                (if (local.get $eq) (then (return (i32.const 1))))))
            (set! $i (i32.add (local.get $ge) (i32.const 1))) (br $l)))))
