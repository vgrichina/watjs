        (let $r i32 (call $re_match (local.get $p) (local.get $plen) (local.get $qend) (local.get $s) (local.get $slen) (i32.add (local.get $spos) (call $re_cp_boff (local.get $s) (local.get $spos) (local.get $tc) (local.get $slen)))))
        (if (i32.ge_s (local.get $r) (i32.const 0)) (then (return (local.get $r))))
        (set! $tc (i32.add (local.get $tc) (i32.const 1)))
        (br $ll)))
      (return (i32.const -1))))
  ;; greedy: backtrack from count down to min
  (block $be (loop $bl
    (br_if $be (i32.lt_s (local.get $count) (local.get $min)))
    (let $r i32 (call $re_match (local.get $p) (local.get $plen) (local.get $qend) (local.get $s) (local.get $slen) (i32.add (local.get $spos) (call $re_cp_boff (local.get $s) (local.get $spos) (local.get $count) (local.get $slen)))))
    (if (i32.ge_s (local.get $r) (i32.const 0)) (then (return (local.get $r))))
    (set! $count (i32.sub (local.get $count) (i32.const 1)))
    (br $bl)))
  (i32.const -1))

;; parse {n}, {n,}, {n,m} at brace pos → regs 172 min, 176 max, 180 qend
(func $re_parse_brace (param $p i32) (param $plen i32) (param $bpos i32) (effects)
  (let $i i32 (i32.add (local.get $bpos) (i32.const 1)))
  (let $n i32 (i32.const 0))
  (block $e1 (loop $l1
    (let $d i32 (call $re_pb (local.get $p) (local.get $plen) (local.get $i)))
    (br_if $e1 (i32.eqz (i32.and (i32.ge_s (local.get $d) (i32.const 48)) (i32.le_s (local.get $d) (i32.const 57)))))
    (set! $n (i32.add (i32.mul (local.get $n) (i32.const 10)) (i32.sub (local.get $d) (i32.const 48))))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l1)))
  (i32.store (i32.const 172) (local.get $n))
  (i32.store (i32.const 176) (local.get $n))  ;; default max = n
  (if (i32.eq (call $re_pb (local.get $p) (local.get $plen) (local.get $i)) (i32.const 44))  ;; ','
    (then
      (set! $i (i32.add (local.get $i) (i32.const 1)))
      (if (i32.eq (call $re_pb (local.get $p) (local.get $plen) (local.get $i)) (i32.const 125))  ;; {n,}
        (then (i32.store (i32.const 176) (i32.const 1000000)))
        (else
          (let $m i32 (i32.const 0))
          (block $e2 (loop $l2
            (let $d i32 (call $re_pb (local.get $p) (local.get $plen) (local.get $i)))
            (br_if $e2 (i32.eqz (i32.and (i32.ge_s (local.get $d) (i32.const 48)) (i32.le_s (local.get $d) (i32.const 57)))))
            (set! $m (i32.add (i32.mul (local.get $m) (i32.const 10)) (i32.sub (local.get $d) (i32.const 48))))
            (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l2)))
          (i32.store (i32.const 176) (local.get $m))))))
  (i32.store (i32.const 180) (i32.add (local.get $i) (i32.const 1))))  ;; past '}'

;; index of the next TOP-LEVEL '|' in [from, to) (respecting [..], \, and nested ()), or to
(func $re_find_pipe (param $p i32) (param $from i32) (param $to i32) (result i32) (effects)
  (let $i i32 (local.get $from))
  (let $incls i32 (i32.const 0))
  (let $depth i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $to)))
    (let $c i32 (i32.load8_u (i32.add (local.get $p) (local.get $i))))
    (if (i32.eq (local.get $c) (i32.const 92)) (then (set! $i (i32.add (local.get $i) (i32.const 2))) (br $l)))  ;; \ escape
    (if (i32.eq (local.get $c) (i32.const 91)) (then (set! $incls (i32.const 1))))  ;; [
    (if (i32.eq (local.get $c) (i32.const 93)) (then (set! $incls (i32.const 0))))  ;; ]
    (if (i32.eqz (local.get $incls))
      (then
        (if (i32.eq (local.get $c) (i32.const 40)) (then (set! $depth (i32.add (local.get $depth) (i32.const 1)))))  ;; (
        (if (i32.eq (local.get $c) (i32.const 41)) (then (set! $depth (i32.sub (local.get $depth) (i32.const 1)))))  ;; )
        (if (i32.and (i32.eq (local.get $c) (i32.const 124)) (i32.eqz (local.get $depth))) (then (return (local.get $i))))))  ;; |
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (local.get $to))

;; 1 if the '(' at pos opens a CAPTURING group: a plain '(' or '(?<name>' (named),
;; but NOT (?:, (?=, (?!, (?<=, (?<! .
(func $re_is_cap_group (param $p i32) (param $pos i32) (result i32) (effects)
  (if (i32.ne (i32.load8_u (i32.add (local.get $p) (i32.add (local.get $pos) (i32.const 1)))) (i32.const 63)) (then (return (i32.const 1))))  ;; '(' not '(?'
  (if (i32.eq (i32.load8_u (i32.add (local.get $p) (i32.add (local.get $pos) (i32.const 2)))) (i32.const 60))  ;; '(?<'
    (then
      (let $c3 i32 (i32.load8_u (i32.add (local.get $p) (i32.add (local.get $pos) (i32.const 3)))))
      (if (i32.or (i32.eq (local.get $c3) (i32.const 61)) (i32.eq (local.get $c3) (i32.const 33))) (then (return (i32.const 0))))  ;; (?<= (?<! lookbehind
      (return (i32.const 1))))  ;; (?<name>
  (i32.const 0))  ;; (?: (?= (?! …

;; index of the ')' matching the '(' at ppos (handles nesting, [..], \)
(func $re_group_end (param $p i32) (param $plen i32) (param $ppos i32) (result i32) (effects)
  (let $i i32 (i32.add (local.get $ppos) (i32.const 1)))
  (let $incls i32 (i32.const 0))
  (let $depth i32 (i32.const 1))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $plen)))
    (let $c i32 (i32.load8_u (i32.add (local.get $p) (local.get $i))))
    (if (i32.eq (local.get $c) (i32.const 92)) (then (set! $i (i32.add (local.get $i) (i32.const 2))) (br $l)))
    (if (i32.eq (local.get $c) (i32.const 91)) (then (set! $incls (i32.const 1))))
    (if (i32.eq (local.get $c) (i32.const 93)) (then (set! $incls (i32.const 0))))
    (if (i32.eqz (local.get $incls))
      (then
        (if (i32.eq (local.get $c) (i32.const 40)) (then (set! $depth (i32.add (local.get $depth) (i32.const 1)))))
        (if (i32.eq (local.get $c) (i32.const 41)) (then (set! $depth (i32.sub (local.get $depth) (i32.const 1))) (br_if $e (i32.eqz (local.get $depth)))))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (local.get $i))  ;; position of the matching ')'

;; 1-based capture index of the '(' at ppos = count of capturing '(' before it
(func $re_group_idx (param $p i32) (param $ppos i32) (result i32) (effects)
  (let $i i32 (i32.const 0))
  (let $incls i32 (i32.const 0))
  (let $n i32 (i32.const 1))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $ppos)))
    (let $c i32 (i32.load8_u (i32.add (local.get $p) (local.get $i))))
    (if (i32.eq (local.get $c) (i32.const 92)) (then (set! $i (i32.add (local.get $i) (i32.const 2))) (br $l)))
    (if (i32.eq (local.get $c) (i32.const 91)) (then (set! $incls (i32.const 1))))
    (if (i32.eq (local.get $c) (i32.const 93)) (then (set! $incls (i32.const 0))))
    ;; only a capturing '(' counts (plain '(' or '(?<name>') — not (?:/(?=/(?!/(?<=/(?<!
    (if (i32.and (i32.eqz (local.get $incls)) (i32.and (i32.eq (local.get $c) (i32.const 40)) (call $re_is_cap_group (local.get $p) (local.get $i)))) (then (set! $n (i32.add (local.get $n) (i32.const 1)))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (local.get $n))

;; capture store: reg 280 = base (cap[2k]=start, cap[2k+1]=end for group k+1), 284 = ngroups
(func $re_reset_caps (param $p i32) (param $plen i32) (effects)
  (if (i32.eqz (i32.load (i32.const 280))) (then (i32.store (i32.const 280) (call $heap_alloc (i32.const 512)))))
  (if (i32.eqz (i32.load (i32.const 600))) (then (i32.store (i32.const 600) (call $heap_alloc (i32.const 512)))))  ;; group-name table (Str ptr per group, 0 = unnamed)
  (i32.store (i32.const 604) (i32.const 0))  ;; hasNamed flag
  ;; continuation-frame stack: reg 616 = base ptr (256 frames × 16 bytes: patstart,patend,gidx,gstartspos),
  ;; reg 620 = depth. Lets a group body backtrack against the pattern AFTER the group (real CPS matching).
  (if (i32.eqz (i32.load (i32.const 616))) (then (i32.store (i32.const 616) (call $heap_alloc (i32.const 4096)))))
  (i32.store (i32.const 620) (i32.const 0))  ;; continuation depth
  (i32.store (i32.const 632) (i32.const 0))  ;; continuation FLOOR — base case stops chaining once depth<=floor
  (let $i i32 (i32.const 0))
  (block $e (loop $l (br_if $e (i32.ge_s (local.get $i) (i32.const 128)))
    (i32.store (i32.add (i32.load (i32.const 280)) (i32.mul (local.get $i) (i32.const 4))) (i32.const -1))
    (i32.store (i32.add (i32.load (i32.const 600)) (i32.mul (local.get $i) (i32.const 4))) (i32.const 0))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
  ;; count capturing groups + record (?<name> names
  (let $j i32 (i32.const 0)) (let $incls i32 (i32.const 0)) (let $g i32 (i32.const 0))
  (block $e2 (loop $l2
    (br_if $e2 (i32.ge_s (local.get $j) (local.get $plen)))
    (let $c i32 (i32.load8_u (i32.add (local.get $p) (local.get $j))))
    (if (i32.eq (local.get $c) (i32.const 92)) (then (set! $j (i32.add (local.get $j) (i32.const 2))) (br $l2)))
    (if (i32.eq (local.get $c) (i32.const 91)) (then (set! $incls (i32.const 1))))
    (if (i32.eq (local.get $c) (i32.const 93)) (then (set! $incls (i32.const 0))))
    (if (i32.and (i32.eqz (local.get $incls)) (i32.and (i32.eq (local.get $c) (i32.const 40)) (call $re_is_cap_group (local.get $p) (local.get $j))))
      (then
        (set! $g (i32.add (local.get $g) (i32.const 1)))
        ;; (?<name> → extract name [j+3, '>') into a Str at names[g]
        (if (i32.eq (i32.load8_u (i32.add (local.get $p) (i32.add (local.get $j) (i32.const 1)))) (i32.const 63))
          (then
            (let $ns i32 (i32.add (local.get $j) (i32.const 3)))
            (let $ne i32 (local.get $ns))
            (block $nme (loop $nml (br_if $nme (i32.or (i32.ge_s (local.get $ne) (local.get $plen)) (i32.eq (i32.load8_u (i32.add (local.get $p) (local.get $ne))) (i32.const 62)))) (set! $ne (i32.add (local.get $ne) (i32.const 1))) (br $nml)))
            (let $nstr i32 (call $str_alloc (i32.sub (local.get $ne) (local.get $ns))))
            (let $nk i32 (i32.const 0))
            (block $nce (loop $ncl (br_if $nce (i32.ge_s (i32.add (local.get $ns) (local.get $nk)) (local.get $ne)))
              (call $str_set_byte (local.get $nstr) (local.get $nk) (i32.load8_u (i32.add (local.get $p) (i32.add (local.get $ns) (local.get $nk)))))
              (set! $nk (i32.add (local.get $nk) (i32.const 1))) (br $ncl)))
            (i32.store (i32.add (i32.load (i32.const 600)) (i32.mul (local.get $g) (i32.const 4))) (local.get $nstr))
            (i32.store (i32.const 604) (i32.const 1))))))
    (set! $j (i32.add (local.get $j) (i32.const 1))) (br $l2)))
  (i32.store (i32.const 284) (local.get $g)))
(func $re_set_cap (param $gidx i32) (param $start i32) (param $end i32) (effects)
  (if (i32.le_s (local.get $gidx) (i32.const 0)) (then (return)))  ;; non-capturing group → no slot
  (i32.store (i32.add (i32.load (i32.const 280)) (i32.mul (i32.sub (local.get $gidx) (i32.const 1)) (i32.const 8))) (local.get $start))
  (i32.store (i32.add (i32.load (i32.const 280)) (i32.add (i32.mul (i32.sub (local.get $gidx) (i32.const 1)) (i32.const 8)) (i32.const 4))) (local.get $end)))

;; save / restore the whole capture array (128 i32 slots at reg 280) to/from a scratch
;; buffer — used to roll back a failed extra quantifier iteration so it can't corrupt
;; the captures the continuation sees.
(func $re_caps_save (param $dst i32) (effects)
  (let $src i32 (i32.load (i32.const 280)))
  (let $i i32 (i32.const 0))
  (block $e (loop $l (br_if $e (i32.ge_s (local.get $i) (i32.const 128)))
    (i32.store (i32.add (local.get $dst) (i32.mul (local.get $i) (i32.const 4))) (i32.load (i32.add (local.get $src) (i32.mul (local.get $i) (i32.const 4)))))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l))))
(func $re_caps_restore (param $src i32) (effects)
  (let $dst i32 (i32.load (i32.const 280)))
  (let $i i32 (i32.const 0))
  (block $e (loop $l (br_if $e (i32.ge_s (local.get $i) (i32.const 128)))
    (i32.store (i32.add (local.get $dst) (i32.mul (local.get $i) (i32.const 4))) (i32.load (i32.add (local.get $src) (i32.mul (local.get $i) (i32.const 4)))))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l))))

;; clear the captures of every capturing group whose '(' lies in [gstart,gend) — the
;; body of a quantified group. Per spec RepeatMatcher, each iteration starts with the
;; body's inner captures reset to undefined, so a group that matched in an earlier
;; iteration but not the final one ends up undefined (not stale).
(func $re_clear_caps_in (param $p i32) (param $gstart i32) (param $gend i32) (effects)
  (let $i i32 (local.get $gstart))
  (let $incls i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $gend)))
    (let $c i32 (i32.load8_u (i32.add (local.get $p) (local.get $i))))
    (if (i32.eq (local.get $c) (i32.const 92)) (then (set! $i (i32.add (local.get $i) (i32.const 2))) (br $l)))  ;; skip escaped
    (if (i32.eq (local.get $c) (i32.const 91)) (then (set! $incls (i32.const 1))))
    (if (i32.eq (local.get $c) (i32.const 93)) (then (set! $incls (i32.const 0))))
    (if (i32.and (i32.eqz (local.get $incls)) (i32.and (i32.eq (local.get $c) (i32.const 40)) (call $re_is_cap_group (local.get $p) (local.get $i))))
      (then (call $re_set_cap (call $re_group_idx (local.get $p) (local.get $i)) (i32.const -1) (i32.const -1))))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
  )

;; match a backreference to capture group `gidx` at `spos`; returns the end
;; position (>= spos), or -1 on mismatch. An unset group matches the empty string.
(func $re_match_backref (param $gidx i32) (param $s i32) (param $slen i32) (param $spos i32) (result i32) (effects)
  (if (i32.le_s (local.get $gidx) (i32.const 0)) (then (return (local.get $spos))))
  (let $bst i32 (i32.load (i32.add (i32.load (i32.const 280)) (i32.mul (i32.sub (local.get $gidx) (i32.const 1)) (i32.const 8)))))
  (let $ben i32 (i32.load (i32.add (i32.load (i32.const 280)) (i32.add (i32.mul (i32.sub (local.get $gidx) (i32.const 1)) (i32.const 8)) (i32.const 4)))))
  (if (i32.lt_s (local.get $bst) (i32.const 0)) (then (return (local.get $spos))))
  (let $blen i32 (i32.sub (local.get $ben) (local.get $bst)))
  (if (i32.gt_s (i32.add (local.get $spos) (local.get $blen)) (local.get $slen)) (then (return (i32.const -1))))
  (let $bi i32 (i32.const 0))
  (block $bce (loop $bcl
    (br_if $bce (i32.ge_s (local.get $bi) (local.get $blen)))
    (if (i32.eqz (call $re_eqc (i32.load8_u (i32.add (local.get $s) (i32.add (local.get $spos) (local.get $bi)))) (i32.load8_u (i32.add (local.get $s) (i32.add (local.get $bst) (local.get $bi)))))) (then (return (i32.const -1))))
    (set! $bi (i32.add (local.get $bi) (i32.const 1))) (br $bcl)))
  (i32.add (local.get $spos) (local.get $blen)))

;; group index whose recorded name equals the pattern bytes p[ns,ne), else 0.
;; ES2025 duplicate group names (same name in different alternatives): prefer the group that
;; actually PARTICIPATED (has a set capture, start >= 0) so `\k<name>` / `$<name>` resolve to the
;; matched alternative; fall back to the first same-named group when none participated.
(func $re_name_to_gidx (param $p i32) (param $ns i32) (param $ne i32) (result i32) (effects)
  (let $nl i32 (i32.sub (local.get $ne) (local.get $ns)))
  (let $g i32 (i32.const 1))
  (let $fallback i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.gt_s (local.get $g) (i32.load (i32.const 284))))
    (let $nm i32 (i32.load (i32.add (i32.load (i32.const 600)) (i32.mul (local.get $g) (i32.const 4)))))
    (if (local.get $nm)
      (then (if (i32.eq (call $str_len (local.get $nm)) (local.get $nl))
        (then
          (let $eq i32 (i32.const 1)) (let $k i32 (i32.const 0))
          (block $ce (loop $cl (br_if $ce (i32.ge_s (local.get $k) (local.get $nl)))
            (if (i32.ne (call $str_byte (local.get $nm) (local.get $k)) (i32.load8_u (i32.add (local.get $p) (i32.add (local.get $ns) (local.get $k))))) (then (set! $eq (i32.const 0)) (br $ce)))
            (set! $k (i32.add (local.get $k) (i32.const 1))) (br $cl)))
          (if (local.get $eq)
            (then
              ;; participated? capture start (reg 280 base, stride 8) >= 0 → this is the winner
              (if (i32.ge_s (i32.load (i32.add (i32.load (i32.const 280)) (i32.mul (i32.sub (local.get $g) (i32.const 1)) (i32.const 8)))) (i32.const 0))
                (then (return (local.get $g))))
              (if (i32.eqz (local.get $fallback)) (then (set! $fallback (local.get $g))))))))))
    (set! $g (i32.add (local.get $g) (i32.const 1))) (br $l)))
  (local.get $fallback))

;; define `groups` on a match-result's @12 scope `rprops`: undefined when the
;; pattern has no named groups, else a null-prototype object {name: captureValue}.
;; the null-prototype groups object {name: captureValue}, or undefined if the
;; pattern has no named groups.
(func $re_groups_obj (param $sub i32) (param $off i32) (result i64) (effects)
  (if (i32.eqz (i32.load (i32.const 604))) (then (return (call $v_undef))))
  (let $go i32 (call $scope_new (i32.const 0) (i32.const 8)))  ;; null prototype (spec)
  (let $g i32 (i32.const 1))
  (block $ge (loop $gl
    (br_if $ge (i32.gt_s (local.get $g) (i32.load (i32.const 284))))
    (let $nm i32 (i32.load (i32.add (i32.load (i32.const 600)) (i32.mul (local.get $g) (i32.const 4)))))
    (if (local.get $nm)
      (then
        (let $cb i32 (i32.add (i32.load (i32.const 280)) (i32.mul (i32.sub (local.get $g) (i32.const 1)) (i32.const 8))))
        (let $cs i32 (i32.load (local.get $cb)))
        ;; ES2025 duplicate group names (same name in different alternatives): a group that CAPTURED
        ;; wins; a non-capturing (undefined) same-name group must NOT overwrite it — only define
        ;; undefined when the name isn't already present.
        (if (i32.lt_s (local.get $cs) (i32.const 0))
          (then (if (i32.eqz (call $scope_find_local (local.get $go) (local.get $nm))) (then (call $scope_define (local.get $go) (local.get $nm) (call $v_undef)))))
          (else (call $scope_define (local.get $go) (local.get $nm) (call $mk_str (call $substr (local.get $sub) (i32.add (local.get $off) (local.get $cs)) (i32.sub (i32.load (i32.add (local.get $cb) (i32.const 4))) (local.get $cs)))))))))
    (set! $g (i32.add (local.get $g) (i32.const 1))) (br $gl)))
  (call $mk_obj (local.get $go)))
(func $re_set_groups (param $sub i32) (param $off i32) (param $rprops i32) (effects)
  (call $scope_define (local.get $rprops) (cstring "groups") (call $re_groups_obj (local.get $sub) (local.get $off))))

;; for the 'd' (hasIndices) flag: the named-group [[start,end]] object (undefined if no named groups)
(func $re_groups_indices_obj (result i64) (effects)
  (if (i32.eqz (i32.load (i32.const 604))) (then (return (call $v_undef))))
  (let $go i32 (call $scope_new (i32.const 0) (i32.const 8)))  ;; null prototype (spec)
  (let $g i32 (i32.const 1))
  (block $ge (loop $gl
    (br_if $ge (i32.gt_s (local.get $g) (i32.load (i32.const 284))))
    (let $nm i32 (i32.load (i32.add (i32.load (i32.const 600)) (i32.mul (local.get $g) (i32.const 4)))))
    (if (local.get $nm)
      (then
        (let $cb i32 (i32.add (i32.load (i32.const 280)) (i32.mul (i32.sub (local.get $g) (i32.const 1)) (i32.const 8))))
        (let $cs i32 (i32.load (local.get $cb)))
        (if (i32.lt_s (local.get $cs) (i32.const 0))
          (then (if (i32.eqz (call $scope_find_local (local.get $go) (local.get $nm))) (then (call $scope_define (local.get $go) (local.get $nm) (call $v_undef)))))  ;; duplicate name: a captured group wins over undefined
          (else
            (let $pr i32 (call $arr_new (i32.const 2)))
            (call $arr_push (local.get $pr) (call $num (f64.convert_i32_s (local.get $cs))))
            (call $arr_push (local.get $pr) (call $num (f64.convert_i32_s (i32.load (i32.add (local.get $cb) (i32.const 4))))))
            (call $scope_define (local.get $go) (local.get $nm) (call $mk_arr (local.get $pr)))))))
    (set! $g (i32.add (local.get $g) (i32.const 1))) (br $gl)))
  (call $mk_obj (local.get $go)))

;; match a quantified group: body [gstart,gend), then rest from qend. Count-based
;; A non-quantified group (exactly once): try EACH alternative and, for each, match the CONTINUATION
;; (the rest of the pattern from qend). This makes alternation a real backtracking point — e.g.
;; `(a|ab)c` on "abc" must try `a` then, when `c` fails, retry `ab`. (re_match_alt alone returns only
;; the first matching alternative, so `re_group_rep` committed to it and could not backtrack the choice.)
(func $re_group_once (param $p i32) (param $plen i32) (param $gstart i32) (param $gend i32) (param $qend i32) (param $s i32) (param $slen i32) (param $spos i32) (param $gidx i32) (result i32) (effects)
  ;; push a continuation frame: after the body ends, match [qend, plen) and capture gidx over
  ;; [spos, body-end]. The body (per alternative) then backtracks against this continuation via re_match's
  ;; base case — so `(a*)a`, `(\d*)\d(\d+)`, and nested-quantifier groups give up characters as needed.
  (let $gfn i32 (i32.load (i32.const 620)))
  (let $gfb i32 (i32.add (i32.load (i32.const 616)) (i32.mul (local.get $gfn) (i32.const 16))))
  (i32.store (local.get $gfb) (local.get $qend))
  (i32.store (i32.add (local.get $gfb) (i32.const 4)) (local.get $plen))
  (i32.store (i32.add (local.get $gfb) (i32.const 8)) (local.get $gidx))
  (i32.store (i32.add (local.get $gfb) (i32.const 12)) (local.get $spos))
  (i32.store (i32.const 620) (i32.add (local.get $gfn) (i32.const 1)))
  (let $gret i32 (i32.const -1))
  (let $segstart i32 (local.get $gstart))
  (block $e (loop $l
    (let $segend i32 (call $re_find_pipe (local.get $p) (local.get $segstart) (local.get $gend)))
    ;; match this alternative [segstart, segend); its base case (at segend) chains the pushed continuation
    (let $me i32 (call $re_match (local.get $p) (local.get $segend) (local.get $segstart) (local.get $s) (local.get $slen) (local.get $spos)))
    (if (i32.ge_s (local.get $me) (i32.const 0)) (then (set! $gret (local.get $me)) (br $e)))
    (br_if $e (i32.ge_s (local.get $segend) (local.get $gend)))
    (set! $segstart (i32.add (local.get $segend) (i32.const 1)))
    (br $l)))
  (i32.store (i32.const 620) (local.get $gfn))  ;; pop the frame
  (local.get $gret))

;; scoped modifier group `(?add-remove:body)` — non-capturing. Applies i/m/s flag adds/removes
;; (regs 272/652/660) for the BODY match only, restoring them for the continuation. Nesting works
;; because each level saves the current global flags and restores them. Exactly-once (the tested
;; forms are never quantified); `qend` = the position right after ')'.
(func $re_mod_group (param $p i32) (param $plen i32) (param $ppos i32) (param $gend i32) (param $qend i32) (param $s i32) (param $slen i32) (param $spos i32) (result i32) (effects)
  ;; parse flags between `(?` and `:` → add/rem bit-masks (bit0=i/272, bit1=m/652, bit2=s/660)
  (let $j i32 (i32.add (local.get $ppos) (i32.const 2)))
  (let $add i32 (i32.const 0)) (let $rem i32 (i32.const 0)) (let $neg i32 (i32.const 0))
  (block $pe (loop $pl
    (br_if $pe (i32.ge_s (local.get $j) (local.get $gend)))
    (let $fc i32 (i32.load8_u (i32.add (local.get $p) (local.get $j))))
    (br_if $pe (i32.eq (local.get $fc) (i32.const 58)))  ;; ':'
    (if (i32.eq (local.get $fc) (i32.const 45)) (then (set! $neg (i32.const 1)))  ;; '-'
      (else
        (let $bit i32 (i32.const 0))
        (if (i32.eq (local.get $fc) (i32.const 105)) (then (set! $bit (i32.const 1))))  ;; i
        (if (i32.eq (local.get $fc) (i32.const 109)) (then (set! $bit (i32.const 2))))  ;; m
        (if (i32.eq (local.get $fc) (i32.const 115)) (then (set! $bit (i32.const 4))))  ;; s
        (if (local.get $neg)
          (then (set! $rem (i32.or (local.get $rem) (local.get $bit))))
          (else (set! $add (i32.or (local.get $add) (local.get $bit)))))))
    (set! $j (i32.add (local.get $j) (i32.const 1))) (br $pl)))
  (let $bodystart i32 (i32.add (local.get $j) (i32.const 1)))  ;; past ':'
  (let $o272 i32 (i32.load (i32.const 272)))
  (let $o652 i32 (i32.load (i32.const 652)))
  (let $o660 i32 (i32.load (i32.const 660)))
  (let $segstart i32 (local.get $bodystart))
  (block $e (loop $l
    (let $segend i32 (call $re_find_pipe (local.get $p) (local.get $segstart) (local.get $gend)))
    ;; apply modifier flags for the body
    (if (i32.and (local.get $add) (i32.const 1)) (then (i32.store (i32.const 272) (i32.const 1))))
    (if (i32.and (local.get $rem) (i32.const 1)) (then (i32.store (i32.const 272) (i32.const 0))))
    (if (i32.and (local.get $add) (i32.const 2)) (then (i32.store (i32.const 652) (i32.const 1))))
    (if (i32.and (local.get $rem) (i32.const 2)) (then (i32.store (i32.const 652) (i32.const 0))))
    (if (i32.and (local.get $add) (i32.const 4)) (then (i32.store (i32.const 660) (i32.const 1))))
    (if (i32.and (local.get $rem) (i32.const 4)) (then (i32.store (i32.const 660) (i32.const 0))))
    ;; the modifier-group body is matched BOUNDED (its own continuation is handled explicitly below), so
    ;; raise the floor for the body match — don't let it chain an outer group's continuation.
    (let $modfloor i32 (i32.load (i32.const 632)))
    (i32.store (i32.const 632) (i32.load (i32.const 620)))
    (let $me i32 (call $re_match (local.get $p) (local.get $segend) (local.get $segstart) (local.get $s) (local.get $slen) (local.get $spos)))
    (i32.store (i32.const 632) (local.get $modfloor))
    ;; restore flags before the continuation
    (i32.store (i32.const 272) (local.get $o272))
    (i32.store (i32.const 652) (local.get $o652))
    (i32.store (i32.const 660) (local.get $o660))
    (if (i32.ge_s (local.get $me) (i32.const 0))
      (then
        (let $r i32 (call $re_match (local.get $p) (local.get $plen) (local.get $qend) (local.get $s) (local.get $slen) (local.get $me)))
        (if (i32.ge_s (local.get $r) (i32.const 0)) (then (return (local.get $r))))))
    (br_if $e (i32.ge_s (local.get $segend) (local.get $gend)))
    (set! $segstart (i32.add (local.get $segend) (i32.const 1)))
    (br $l)))
  (i32.const -1))

;; variable-length repetition (greedy, backtracking on the rep count).
(func $re_group_rep (param $p i32) (param $plen i32) (param $gstart i32) (param $gend i32) (param $qend i32) (param $min i32) (param $max i32) (param $s i32) (param $slen i32) (param $spos i32) (param $gidx i32) (param $greedy i32) (result i32) (effects)
  ;; exactly-once group → try each alternative against the continuation (real backtracking).
  (if (i32.and (i32.eq (local.get $min) (i32.const 1)) (i32.eq (local.get $max) (i32.const 1)))
    (then (return (call $re_group_once (local.get $p) (local.get $plen) (local.get $gstart) (local.get $gend) (local.get $qend) (local.get $s) (local.get $slen) (local.get $spos) (local.get $gidx)))))
  ;; LAZY repetition (`(ab)*?`, `(a|b)+?c`): try the FEWEST reps first — match the `min` required reps, then
  ;; repeatedly try the continuation BEFORE consuming another rep, up to `max`.
  (if (i32.eqz (local.get $greedy))
    (then
      (let $lcp i32 (local.get $spos))
      (let $lcount i32 (i32.const 0))
      (let $lprev i32 (local.get $spos))
      (block $lme (loop $lml
        (br_if $lme (i32.ge_s (local.get $lcount) (local.get $min)))
        (call $re_clear_caps_in (local.get $p) (local.get $gstart) (local.get $gend))
        (let $le i32 (call $re_match_alt (local.get $p) (local.get $gstart) (local.get $gend) (local.get $s) (local.get $slen) (local.get $lcp)))
        (if (i32.lt_s (local.get $le) (i32.const 0)) (then (return (i32.const -1))))  ;; can't satisfy min → fail
        (set! $lprev (local.get $lcp)) (set! $lcp (local.get $le)) (set! $lcount (i32.add (local.get $lcount) (i32.const 1)))
        (br $lml)))
      (block $lde (loop $ldl
        (if (i32.gt_s (local.get $lcount) (i32.const 0)) (then (call $re_set_cap (local.get $gidx) (local.get $lprev) (local.get $lcp))))
        (let $lr i32 (call $re_match (local.get $p) (local.get $plen) (local.get $qend) (local.get $s) (local.get $slen) (local.get $lcp)))
        (if (i32.ge_s (local.get $lr) (i32.const 0)) (then (return (local.get $lr))))
        (br_if $lde (i32.ge_s (local.get $lcount) (local.get $max)))  ;; no more reps allowed
        (call $re_clear_caps_in (local.get $p) (local.get $gstart) (local.get $gend))
        (let $le2 i32 (call $re_match_alt (local.get $p) (local.get $gstart) (local.get $gend) (local.get $s) (local.get $slen) (local.get $lcp)))
        (if (i32.lt_s (local.get $le2) (i32.const 0)) (then (br $lde)))  ;; body can't match → no more reps
        (if (i32.le_s (local.get $le2) (local.get $lcp)) (then (br $lde)))  ;; empty rep → no progress, stop
        (set! $lprev (local.get $lcp)) (set! $lcp (local.get $le2)) (set! $lcount (i32.add (local.get $lcount) (i32.const 1)))
        (br $ldl)))
      (return (i32.const -1))))
  (let $positions i32 (call $heap_alloc (i32.const 1024)))
  (i32.store (local.get $positions) (local.get $spos))
  (let $count i32 (i32.const 0))
  (let $cp i32 (local.get $spos))
  (let $capsnap i32 (call $heap_alloc (i32.const 512)))
  (block $ce (loop $cl
    (br_if $ce (i32.ge_s (local.get $count) (local.get $max)))
    (call $re_caps_save (local.get $capsnap))  ;; snapshot before the attempt
    (call $re_clear_caps_in (local.get $p) (local.get $gstart) (local.get $gend))  ;; reset inner captures per iteration
    (let $e i32 (call $re_match_alt (local.get $p) (local.get $gstart) (local.get $gend) (local.get $s) (local.get $slen) (local.get $cp)))
    (if (i32.lt_s (local.get $e) (i32.const 0)) (then (call $re_caps_restore (local.get $capsnap)) (br $ce)))  ;; body failed → roll back, stop
    ;; zero-progress (empty) iteration: per RepeatMatcher, a min=0 iteration that makes no
    ;; progress FAILS (the group matches 0 times). So only count an empty match while still
    ;; below min (needed to satisfy it); once min is met, roll it back so its inner captures
    ;; stay undefined, and stop (also avoids looping forever on an empty body).
    (if (i32.le_s (local.get $e) (local.get $cp))
      (then
        (if (i32.lt_s (local.get $count) (local.get $min))
          (then
            (set! $count (i32.add (local.get $count) (i32.const 1)))
            (i32.store (i32.add (local.get $positions) (i32.mul (local.get $count) (i32.const 4))) (local.get $e)))
          (else (call $re_caps_restore (local.get $capsnap))))
        (br $ce)))
    (set! $count (i32.add (local.get $count) (i32.const 1)))
    (i32.store (i32.add (local.get $positions) (i32.mul (local.get $count) (i32.const 4))) (local.get $e))
    (set! $cp (local.get $e))
    (br $cl)))
  (block $be (loop $bl
    (br_if $be (i32.lt_s (local.get $count) (local.get $min)))
    (if (i32.gt_s (local.get $count) (i32.const 0))
      (then
        ;; the last KEPT iteration: re-match its body from its start against the continuation, so the body's
        ;; internal quantifiers can GIVE BACK characters (e.g. `([a-z]+)*x`, nested `(([a-z]+)*([a-z])\.)+`).
        ;; re_group_once tries the maximal body first (subsumes the old fixed-end behaviour), then shorter,
        ;; and sets this group's capture (last-iteration-wins) at the body→continuation transition.
        (let $istart i32 (i32.load (i32.add (local.get $positions) (i32.mul (i32.sub (local.get $count) (i32.const 1)) (i32.const 4)))))
        (let $r2 i32 (call $re_group_once (local.get $p) (local.get $plen) (local.get $gstart) (local.get $gend) (local.get $qend) (local.get $s) (local.get $slen) (local.get $istart) (local.get $gidx)))
        (if (i32.ge_s (local.get $r2) (i32.const 0)) (then (return (local.get $r2)))))
      (else
        ;; zero iterations kept → just the continuation from the start position
        (let $r0 i32 (call $re_match (local.get $p) (local.get $plen) (local.get $qend) (local.get $s) (local.get $slen) (i32.load (local.get $positions))))
        (if (i32.ge_s (local.get $r0) (i32.const 0)) (then (return (local.get $r0))))))
    (set! $count (i32.sub (local.get $count) (i32.const 1)))
    (br $bl)))
  (i32.const -1))

;; quantified backreference: match group `gidx` [min,max] times (greedy, count-based
;; backtracking), then the continuation from qend. min=max=1 → a single plain backref.
;; A zero-progress (empty backref) match is counted once then stops (empty-match guard),
;; matching re_group_rep's semantics.
(func $re_backref_rep (param $p i32) (param $plen i32) (param $gidx i32) (param $qend i32) (param $min i32) (param $max i32) (param $s i32) (param $slen i32) (param $spos i32) (result i32) (effects)
  (let $positions i32 (call $heap_alloc (i32.const 1024)))
  (i32.store (local.get $positions) (local.get $spos))
  (let $count i32 (i32.const 0))
  (let $cp i32 (local.get $spos))
  (block $ce (loop $cl
    (br_if $ce (i32.ge_s (local.get $count) (local.get $max)))
    (let $e i32 (call $re_match_backref (local.get $gidx) (local.get $s) (local.get $slen) (local.get $cp)))
    (br_if $ce (i32.lt_s (local.get $e) (i32.const 0)))  ;; backref failed → stop
    (set! $count (i32.add (local.get $count) (i32.const 1)))
    (i32.store (i32.add (local.get $positions) (i32.mul (local.get $count) (i32.const 4))) (local.get $e))
    (br_if $ce (i32.le_s (local.get $e) (local.get $cp)))  ;; empty match: count once, stop
    (set! $cp (local.get $e))
    (br $cl)))
  (block $be (loop $bl
    (br_if $be (i32.lt_s (local.get $count) (local.get $min)))
    (let $bp i32 (i32.load (i32.add (local.get $positions) (i32.mul (local.get $count) (i32.const 4)))))
    (let $r i32 (call $re_match (local.get $p) (local.get $plen) (local.get $qend) (local.get $s) (local.get $slen) (local.get $bp)))
    (if (i32.ge_s (local.get $r) (i32.const 0)) (then (return (local.get $r))))
    (set! $count (i32.sub (local.get $count) (i32.const 1)))
    (br $bl)))
  (i32.const -1))

;; match at spos, trying each top-level alternative in [from,to) left-to-right
(func $re_match_alt (param $p i32) (param $from i32) (param $to i32) (param $s i32) (param $slen i32) (param $spos i32) (result i32) (effects)
  ;; a BOUNDED sub-match (lookahead/lookbehind, a quantified-group iteration, or the top-level): its result
  ;; is a local end position, so it must NOT chain the OUTER continuation. Raise the FLOOR to the current
  ;; depth: nested groups push their frames ABOVE it (never overwriting outer frames), and the base case
  ;; returns spos once depth drops back to the floor. Restore floor+depth after.
  (let $altfloor i32 (i32.load (i32.const 632)))
  (let $altdepth i32 (i32.load (i32.const 620)))
  (i32.store (i32.const 632) (local.get $altdepth))
  (let $segstart i32 (local.get $from))
  (block $e (loop $l
    (let $segend i32 (call $re_find_pipe (local.get $p) (local.get $segstart) (local.get $to)))
    (let $r i32 (call $re_match (local.get $p) (local.get $segend) (local.get $segstart) (local.get $s) (local.get $slen) (local.get $spos)))
    (if (i32.ge_s (local.get $r) (i32.const 0)) (then (i32.store (i32.const 632) (local.get $altfloor)) (i32.store (i32.const 620) (local.get $altdepth)) (return (local.get $r))))
    (br_if $e (i32.ge_s (local.get $segend) (local.get $to)))
    (set! $segstart (i32.add (local.get $segend) (i32.const 1)))
    (br $l)))
  (i32.store (i32.const 632) (local.get $altfloor))
  (i32.store (i32.const 620) (local.get $altdepth))
  (i32.const -1))

;; search subject for first match; return START offset (or -1), END in reg 168
(func $re_search (param $p i32) (param $plen i32) (param $s i32) (param $slen i32) (result i32) (effects)
  (let $start i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.gt_s (local.get $start) (local.get $slen)))
    ;; each start position is a fresh match attempt — clear captures so a failed attempt at an
    ;; earlier position can't leave stale captures visible to a later one (matters for backrefs,
    ;; esp. `\k<name>` to a group in a not-taken alternation branch).
    (call $re_reset_caps (local.get $p) (local.get $plen))
    (let $r i32 (call $re_match_alt (local.get $p) (i32.const 0) (local.get $plen) (local.get $s) (local.get $slen) (local.get $start)))
    (if (i32.ge_s (local.get $r) (i32.const 0)) (then (i32.store (i32.const 168) (local.get $r)) (return (local.get $start))))
    (set! $start (i32.add (local.get $start) (i32.const 1)))
    (br $l)))
  (i32.const -1))

;; pattern Str from a value: a regex object's __re_src__, else ToString(value)
(func $re_pat_of (param $v i64) (result i32) (effects)
  (if i32 (call $is_object (local.get $v))
    (then
      (let $sl i32 (call $scope_find_local (call $val_payload (local.get $v)) (cstring "__re_src__")))
      (if i32 (local.get $sl)
        (then (let $sv i64 (i64.load (local.get $sl)))
              (if i32 (call $is_string (local.get $sv)) (then (call $val_payload (local.get $sv))) (else (call $to_str (local.get $v)))))
        (else (call $to_str (local.get $v)))))
    (else (call $to_str (local.get $v)))))

;; Validate quantifier PLACEMENT in a regex pattern: a quantifier (* + ? {n,m}) must follow a
;; quantifiable atom and may not stack on another quantifier (`a**`, `++a`, `x{1}{1,}` → SyntaxError).
;; A trailing lazy `?` (a*?, a??) is allowed. Conservative: assertions ^ $ are treated as atoms
;; (lenient, never false-flagged); char classes, escapes, and (?:/(?=/(?!/(?<…> groups are skipped.
;; state: 0 = nothing to quantify, 1 = quantifiable atom, 2 = just after a greedy quantifier.
;; Is `c` a valid character right after `\` in a u/v-mode pattern (OUTSIDE a character class)? Valid:
;; a CharacterClassEscape/CharacterEscape letter (b B c d D f k n p P r s S t u v w W x), a digit
;; (0 = NUL, 1-9 = backref), or an IdentityEscape of a SyntaxCharacter (^ $ \ . * + ? ( ) [ ] { } |)
;; or '/'. Any OTHER char (e.g. \A, \a, \-, \e) is a SyntaxError in u-mode.
(func $re_byte_in (param $c i32) (param $t i32) (result i32) (effects) (i32.eq (local.get $c) (local.get $t)))
;; Count CAPTURING groups in a pattern: a `(` outside a char class that is NOT `(?:` / `(?=` / `(?!` /
;; `(?<=` / `(?<!` / a modifier group `(?flags…:`. A `(?<name>` IS capturing. Escapes and class interiors
;; are skipped. Used to validate u-mode decimal-escape backreferences (`\n` with n > count → SyntaxError).
(func $re_count_groups (param $pat i32) (param $n i32) (result i32) (effects)
  (let $i i32 (i32.const 0))
  (let $cnt i32 (i32.const 0))
  (let $inclass i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    (let $c i32 (call $str_byte (local.get $pat) (local.get $i)))
    (if (i32.eq (local.get $c) (i32.const 92)) (then (set! $i (i32.add (local.get $i) (i32.const 2))) (br $l)))  ;; \X
    (if (i32.and (i32.eq (local.get $c) (i32.const 91)) (i32.eqz (local.get $inclass))) (then (set! $inclass (i32.const 1)) (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))  ;; [
    (if (i32.and (i32.eq (local.get $c) (i32.const 93)) (local.get $inclass)) (then (set! $inclass (i32.const 0)) (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))  ;; ]
    (if (i32.and (i32.eq (local.get $c) (i32.const 40)) (i32.eqz (local.get $inclass)))  ;; ( outside a class
      (then
        (let $iscap i32 (i32.const 1))
        (if (i32.and (i32.lt_s (i32.add (local.get $i) (i32.const 1)) (local.get $n)) (i32.eq (call $str_byte (local.get $pat) (i32.add (local.get $i) (i32.const 1))) (i32.const 63)))  ;; (?
          (then
            (let $c2 i32 (call $str_byte (local.get $pat) (i32.add (local.get $i) (i32.const 2))))
            (if (i32.eq (local.get $c2) (i32.const 60))  ;; (?<
              (then
                (let $c3 i32 (call $str_byte (local.get $pat) (i32.add (local.get $i) (i32.const 3))))
                (if (i32.or (i32.eq (local.get $c3) (i32.const 61)) (i32.eq (local.get $c3) (i32.const 33))) (then (set! $iscap (i32.const 0)))))  ;; (?<= (?<! → non-cap; (?<name> → cap
              (else (set! $iscap (i32.const 0))))))  ;; (?: (?= (?! or a modifier (?flags: → non-capturing
