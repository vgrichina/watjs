;; ═══════════════════════════════════════════════════════════════
;; value.watx — NaN-boxed JSValue representation
;;
;; A JSValue is an i64 `bits`. Reinterpreted as f64 it IS a number,
;; UNLESS the top 13 bits equal the negative-quiet-NaN prefix
;; 0xFFF8_0000_0000_0000, in which case it is a "boxed" non-number:
;;
;;   63                    50 48 47                              0
;;  ┌────────────────────────┬─────┬──────────────────────────────┐
;;  │ 1 11111111111 1 (=0xFFF8)│ tag │          payload (48 bits)    │
;;  └────────────────────────┴─────┴──────────────────────────────┘
;;
;; A computed f64 NaN is the POSITIVE quiet NaN (0x7FF8...), sign bit 0,
;; so it never collides with the boxed (sign bit 1) space → it reads as
;; a number, which is correct (JS NaN is a number).
;;
;; tag: 0=undefined 1=null 2=boolean 3=int(reserved) 4=string 5=object
;; Numbers are always stored as f64 (no int tag used yet).
;; ═══════════════════════════════════════════════════════════════

;; --- box / unbox primitives ---

;; reinterpret an f64 as a JSValue (number). A NaN is canonicalized to the POSITIVE quiet NaN
;; (0x7FF8…): a negative NaN (0xFFF8…, e.g. from `-NaN`) would otherwise collide with the boxed
;; (sign-bit-1) tag space — is_number would read it as a boxed value and `-NaN === -NaN` would be true.
(func $num (param $d f64) (result i64)
  (effects)
  (if i64 (f64.ne (local.get $d) (local.get $d))
    (then (i64.const 0x7FF8000000000000))
    (else (i64.reinterpret_f64 (local.get $d)))))

;; reinterpret a JSValue as f64 (caller must know it's a number)
(func $tonum_raw (param $v i64) (result f64)
  (effects)
  (f64.reinterpret_i64 (local.get $v)))

;; is this value a number? (not in the boxed prefix space)
(func $is_number (param $v i64) (result i32)
  (effects)
  (i64.ne (i64.and (local.get $v) (i64.const 0xFFF8000000000000))
          (i64.const 0xFFF8000000000000)))

;; build a boxed value from a 3-bit tag and a 32-bit payload
(func $box (param $tag i32) (param $payload i32) (result i64)
  (effects)
  (i64.or
    (i64.or (i64.const 0xFFF8000000000000)
            (i64.shl (i64.extend_i32_u (local.get $tag)) (i64.const 48)))
    (i64.extend_i32_u (local.get $payload))))

;; tag of a boxed value (meaningless for numbers)
(func $val_tag (param $v i64) (result i32)
  (effects)
  (i32.and (i32.wrap_i64 (i64.shr_u (local.get $v) (i64.const 48))) (i32.const 7)))

;; low-32-bit payload (pointer or int) of a boxed value
(func $val_payload (param $v i64) (result i32)
  (effects)
  (i32.wrap_i64 (local.get $v)))

;; --- singletons & constructors ---

(func $v_undef (result i64) (effects) (call $box (i32.const 0) (i32.const 0)))
;; array "hole" sentinel: undefined-tagged but payload 1 (real undefined is 0),
;; so it reads as undefined yet is distinguishable for HasProperty/enumeration.
(func $v_hole  (result i64) (effects) (call $box (i32.const 0) (i32.const 1)))
(func $is_hole (param $v i64) (result i32) (effects) (i64.eq (local.get $v) (call $v_hole)))
;; TDZ sentinel (undefined-tagged, payload 2): an uninitialized binding — currently the
;; `this` of a derived constructor before super() is called. Reading it → ReferenceError.
(func $v_tdz  (result i64) (effects) (call $box (i32.const 0) (i32.const 2)))
(func $is_tdz (param $v i64) (result i32) (effects) (i64.eq (local.get $v) (call $v_tdz)))
(func $v_null  (result i64) (effects) (call $box (i32.const 1) (i32.const 0)))
(func $v_false (result i64) (effects) (call $box (i32.const 2) (i32.const 0)))
(func $v_true  (result i64) (effects) (call $box (i32.const 2) (i32.const 1)))

(func $mk_bool (param $b i32) (result i64)
  (effects)
  (if i64 (local.get $b) (then (call $v_true)) (else (call $v_false))))

(func $mk_str (param $ptr i32) (result i64)
  (effects)
  (call $box (i32.const 4) (local.get $ptr)))

(func $mk_obj (param $ptr i32) (result i64)
  (effects)
  (call $box (i32.const 5) (local.get $ptr)))

(func $mk_fn (param $ptr i32) (result i64)
  (effects)
  (call $box (i32.const 6) (local.get $ptr)))

(func $is_function (param $v i64) (result i32) (effects)
  (i32.and (i32.eqz (call $is_number (local.get $v)))
           (i32.eq (call $val_tag (local.get $v)) (i32.const 6))))

;; Symbol: tag 7, payload = a Str holding the symbol's unique internal key
;; (well-known symbols use sentinel keys like "@@iterator"; user symbols
;; "@@sym:<n>:<desc>"). The key doubles as the property name when a symbol is
;; used as a computed object key.
(func $mk_symbol (param $ptr i32) (result i64) (effects)
  (call $box (i32.const 3) (local.get $ptr)))
;; BigInt shares tag 3 (symbol) but its record begins with a brand word
;; (1112101681 = 'BIG1') that a symbol record (keyStr pointer) never holds.
;; Stored 64-bit only (no arbitrary precision yet): [brand i32 @0][value i64 @8].
(func $mk_bigint (param $v i64) (result i64) (effects)
  (let $p i32 (call $heap_alloc (i32.const 16)))
  (i32.store (local.get $p) (i32.const 1112101681))
  (i64.store (i32.add (local.get $p) (i32.const 8)) (local.get $v))
  (call $box (i32.const 3) (local.get $p)))
(func $is_bigint (param $v i64) (result i32) (effects)
  (if i32 (i32.and (i32.eqz (call $is_number (local.get $v))) (i32.eq (call $val_tag (local.get $v)) (i32.const 3)))
    (then (i32.eq (i32.load (call $val_payload (local.get $v))) (i32.const 1112101681)))
    (else (i32.const 0))))
(func $bigint_val (param $v i64) (result i64) (effects)
  (i64.load (i32.add (call $val_payload (local.get $v)) (i32.const 8))))
;; symbol = tag 3 that is NOT a bigint
(func $is_symbol (param $v i64) (result i32) (effects)
  (if i32 (i32.and (i32.eqz (call $is_number (local.get $v))) (i32.eq (call $val_tag (local.get $v)) (i32.const 3)))
    (then (i32.ne (i32.load (call $val_payload (local.get $v))) (i32.const 1112101681)))
    (else (i32.const 0))))

;; --- type predicates ---

(func $is_undefined (param $v i64) (result i32) (effects)
  (i64.eq (local.get $v) (call $v_undef)))
(func $is_null (param $v i64) (result i32) (effects)
  (i64.eq (local.get $v) (call $v_null)))
(func $is_boolean (param $v i64) (result i32) (effects)
  (i32.and (i32.eqz (call $is_number (local.get $v)))
           (i32.eq (call $val_tag (local.get $v)) (i32.const 2))))
(func $is_string (param $v i64) (result i32) (effects)
  (i32.and (i32.eqz (call $is_number (local.get $v)))
           (i32.eq (call $val_tag (local.get $v)) (i32.const 4))))
(func $is_object (param $v i64) (result i32) (effects)
  (i32.and (i32.eqz (call $is_number (local.get $v)))
           (i32.eq (call $val_tag (local.get $v)) (i32.const 5))))

;; ToBoolean (spec §7.1.2)
;; the single $262.IsHTMLDDA object (the `document.all` [[IsHTMLDDA]] emulation): its scope pointer is
;; stashed in reg 1180 at setup. It is a real object but behaves like `undefined` for typeof / ToBoolean /
;; abstract-equality-with-null-or-undefined. Pointer identity (one shared object) makes the check cheap.
(func $is_htmldda (param $v i64) (result i32) (effects)
  (if i32 (call $is_object (local.get $v))
    (then (i32.and (i32.ne (i32.load (i32.const 1180)) (i32.const 0)) (i32.eq (call $val_payload (local.get $v)) (i32.load (i32.const 1180)))))
    (else (i32.const 0))))

(func $truthy (param $v i64) (result i32)
  (effects)
  (if i32 (call $is_number (local.get $v))
    (then
      ;; true unless 0, -0, or NaN
      (let $d f64 (call $tonum_raw (local.get $v)))
      (i32.and (f64.ne (local.get $d) (f64.const 0))
               (f64.eq (local.get $d) (local.get $d))))  ;; NaN != NaN
    (else
      (if i32 (call $is_undefined (local.get $v)) (then (i32.const 0))
      (else (if i32 (call $is_null (local.get $v)) (then (i32.const 0))
      (else (if i32 (call $is_boolean (local.get $v))
               (then (call $val_payload (local.get $v)))
      (else (if i32 (call $is_string (local.get $v))
               (then (i32.gt_s (call $str_len (call $val_payload (local.get $v))) (i32.const 0)))
      (else (if i32 (call $is_bigint (local.get $v))
               (then (i64.ne (call $bigint_val (local.get $v)) (i64.const 0)))  ;; 0n is falsy
      (else (if i32 (call $is_htmldda (local.get $v)) (then (i32.const 0)) (else (i32.const 1)))))))))))))))) ;; objects/symbols are truthy; IsHTMLDDA is falsy
