;; ═══════════════════════════════════════════════════════════════
;; tostring.watx — ToString / ToNumber
;;
;; Number formatting uses a scratch buffer at address 256 (inside the
;; register zone, after the registers) and copies the result into a
;; heap Str via $str_from_src (which takes an absolute source address).
;;
;; NOTE: fractional formatting is approximate (up to 15 digits, trailing
;; zeros trimmed) — not the spec's shortest-round-trip. Integers are exact.
;; ═══════════════════════════════════════════════════════════════

;; Number-formatting scratch. Base moved 256 -> 50000: fmt_sig assembles the result at
;; scratch[0..~130] and writes a digit temp at scratch+200 and scratch+400..+501. At base 256
;; that hit fixed registers — the completion reg @288, finally bases @320/@360, newTarget @656,
;; and the @704..@736 async/%TypedArray%/iterator-proto regs — so formatting a long number
;; (e.g. toExponential(100), >~58 frac digits) corrupted them, OOB-trapping at eval teardown.
;; 50000 is well clear of all fixed registers and below the heap base (131072).
(func $scratch (result i32) (effects) (i32.const 50000))

;; Format a non-negative i64 into scratch[start..], return new index (end).
(func $emit_u64 (param $start i32) (param $val i64) (result i32) (effects)
  (if i32 (i64.eqz (local.get $val))
    (then
      (i32.store8 (i32.add (call $scratch) (local.get $start)) (i32.const 48)) ;; '0'
      (i32.add (local.get $start) (i32.const 1)))
    (else
      ;; write digits backward into a 24-byte temp at scratch+200
      (let $tmp i32 (i32.add (call $scratch) (i32.const 200)))
      (let $i i32 (i32.const 24))
      (block $de (loop $dl
        (br_if $de (i64.eqz (local.get $val)))
        (set! $i (i32.sub (local.get $i) (i32.const 1)))
        (i32.store8 (i32.add (local.get $tmp) (local.get $i))
          (i32.add (i32.const 48) (i32.wrap_i64 (i64.rem_u (local.get $val) (i64.const 10)))))
        (set! $val (i64.div_u (local.get $val) (i64.const 10)))
        (br $dl)))
      ;; copy temp[i..24) forward into scratch[start..]
      (let $j i32 (local.get $start))
      (block $ce (loop $cl
        (br_if $ce (i32.ge_s (local.get $i) (i32.const 24)))
        (i32.store8 (i32.add (call $scratch) (local.get $j)) (i32.load8_u (i32.add (local.get $tmp) (local.get $i))))
        (set! $i (i32.add (local.get $i) (i32.const 1)))
        (set! $j (i32.add (local.get $j) (i32.const 1)))
        (br $cl)))
      (local.get $j))))

;; Format a non-negative integral f64 (any magnitude) into scratch[start..]
;; using most-significant-digit extraction — avoids the i64.trunc trap for
;; values above ~9.2e18. Exact up to 2^53; approximate (but non-trapping) above.
(func $emit_f64int (param $start i32) (param $v f64) (result i32) (effects)
  (if i32 (f64.lt (local.get $v) (f64.const 1))
    (then
      (i32.store8 (i32.add (call $scratch) (local.get $start)) (i32.const 48)) ;; '0'
      (i32.add (local.get $start) (i32.const 1)))
    (else
      (let $p f64 (f64.const 1))  ;; largest power of 10 <= v
      (block $pe (loop $pl
        (br_if $pe (f64.gt (f64.mul (local.get $p) (f64.const 10)) (local.get $v)))
        (set! $p (f64.mul (local.get $p) (f64.const 10)))
        (br $pl)))
      (let $n i32 (local.get $start))
      (block $de (loop $dl
        (let $dig i32 (i32.trunc_f64_s (f64.floor (f64.div (local.get $v) (local.get $p)))))
        (if (i32.gt_s (local.get $dig) (i32.const 9)) (then (set! $dig (i32.const 9))))
        (if (i32.lt_s (local.get $dig) (i32.const 0)) (then (set! $dig (i32.const 0))))
        (i32.store8 (i32.add (call $scratch) (local.get $n)) (i32.add (i32.const 48) (local.get $dig)))
        (set! $n (i32.add (local.get $n) (i32.const 1)))
        (set! $v (f64.sub (local.get $v) (f64.mul (f64.convert_i32_s (local.get $dig)) (local.get $p))))
        (set! $p (f64.div (local.get $p) (f64.const 10)))
        (br_if $de (f64.lt (local.get $p) (f64.const 1)))
        (br $dl)))
      (local.get $n))))

;; Exponential notation "d.dddde±XX" for very large/small magnitudes.
(func $num_to_exp (param $d f64) (result i32) (effects)
  (let $n i32 (i32.const 0))
  (let $ax f64 (f64.abs (local.get $d)))
  (if (f64.lt (local.get $d) (f64.const 0))
    (then (i32.store8 (i32.add (call $scratch) (local.get $n)) (i32.const 45))
          (set! $n (i32.add (local.get $n) (i32.const 1)))))
  ;; normalize ax into [1,10), tracking decimal exponent $e
  (let $e i32 (i32.const 0))
  (block $ue (loop $ul
    (br_if $ue (f64.lt (local.get $ax) (f64.const 10)))
    (set! $ax (f64.div (local.get $ax) (f64.const 10)))
    (set! $e (i32.add (local.get $e) (i32.const 1)))
    (br $ul)))
  (block $le (loop $ll
    (br_if $le (f64.ge (local.get $ax) (f64.const 1)))
    (set! $ax (f64.mul (local.get $ax) (f64.const 10)))
    (set! $e (i32.sub (local.get $e) (i32.const 1)))
    (br $ll)))
  ;; leading digit
  (let $dig i32 (i32.trunc_f64_s (f64.floor (local.get $ax))))
  (i32.store8 (i32.add (call $scratch) (local.get $n)) (i32.add (i32.const 48) (local.get $dig)))
  (set! $n (i32.add (local.get $n) (i32.const 1)))
  (set! $ax (f64.sub (local.get $ax) (f64.convert_i32_s (local.get $dig))))
  ;; '.' then up to 16 fractional significant digits (trailing zeros trimmed)
  (let $dot i32 (local.get $n))
  (i32.store8 (i32.add (call $scratch) (local.get $n)) (i32.const 46))
  (set! $n (i32.add (local.get $n) (i32.const 1)))
  (let $lastnz i32 (local.get $dot))  ;; if no nonzero frac digit, drop the '.'
  (let $k i32 (i32.const 0))
  (block $fe (loop $fl
    (br_if $fe (i32.ge_s (local.get $k) (i32.const 16)))
    (set! $ax (f64.mul (local.get $ax) (f64.const 10)))
    (let $dg i32 (i32.trunc_f64_s (f64.floor (local.get $ax))))
    (if (i32.gt_s (local.get $dg) (i32.const 9)) (then (set! $dg (i32.const 9))))
    (if (i32.lt_s (local.get $dg) (i32.const 0)) (then (set! $dg (i32.const 0))))
    (set! $ax (f64.sub (local.get $ax) (f64.convert_i32_s (local.get $dg))))
    (i32.store8 (i32.add (call $scratch) (local.get $n)) (i32.add (i32.const 48) (local.get $dg)))
    (set! $n (i32.add (local.get $n) (i32.const 1)))
    (if (i32.ne (local.get $dg) (i32.const 0)) (then (set! $lastnz (local.get $n))))
    (set! $k (i32.add (local.get $k) (i32.const 1)))
    (br $fl)))
  (set! $n (local.get $lastnz))
  ;; 'e', sign, exponent magnitude
  (i32.store8 (i32.add (call $scratch) (local.get $n)) (i32.const 101))  ;; 'e'
  (set! $n (i32.add (local.get $n) (i32.const 1)))
  (if (i32.ge_s (local.get $e) (i32.const 0))
    (then (i32.store8 (i32.add (call $scratch) (local.get $n)) (i32.const 43)))   ;; '+'
    (else (i32.store8 (i32.add (call $scratch) (local.get $n)) (i32.const 45))    ;; '-'
          (set! $e (i32.sub (i32.const 0) (local.get $e)))))
  (set! $n (i32.add (local.get $n) (i32.const 1)))
  (set! $n (call $emit_u64 (local.get $n) (i64.extend_i32_u (local.get $e))))
  (call $str_from_src (call $scratch) (local.get $n)))

;; Convert a number (f64) to a heap Str.
;; integer → string in `radix` (2..36). Integer part only.
(func $num_to_radix (param $n i32) (param $radix i32) (result i32) (effects)
  (let $buf i32 (call $heap_alloc (i32.const 64)))
  (let $pos i32 (i32.const 64))
  (let $neg i32 (i32.lt_s (local.get $n) (i32.const 0)))
  (if (local.get $neg) (then (set! $n (i32.sub (i32.const 0) (local.get $n)))))
  (if (i32.eqz (local.get $n))
    (then (set! $pos (i32.sub (local.get $pos) (i32.const 1))) (i32.store8 (i32.add (local.get $buf) (local.get $pos)) (i32.const 48)))
    (else
      (block $e (loop $l
        (br_if $e (i32.eqz (local.get $n)))
        (let $dig i32 (i32.rem_u (local.get $n) (local.get $radix)))
        (set! $pos (i32.sub (local.get $pos) (i32.const 1)))
        (i32.store8 (i32.add (local.get $buf) (local.get $pos)) (if i32 (i32.lt_s (local.get $dig) (i32.const 10)) (then (i32.add (i32.const 48) (local.get $dig))) (else (i32.add (i32.const 87) (local.get $dig)))))
        (set! $n (i32.div_u (local.get $n) (local.get $radix)))
        (br $l)))))
  (if (local.get $neg) (then (set! $pos (i32.sub (local.get $pos) (i32.const 1))) (i32.store8 (i32.add (local.get $buf) (local.get $pos)) (i32.const 45))))
  (call $str_from_src (i32.add (local.get $buf) (local.get $pos)) (i32.sub (i32.const 64) (local.get $pos))))

;; float → string in `radix` (2..36), including a fractional part: (3.5).toString(2)="11.1"
(func $num_to_radix_f (param $x f64) (param $radix i32) (result i32) (effects)
  (let $neg i32 (f64.lt (local.get $x) (f64.const 0)))
  (let $a f64 (f64.abs (local.get $x)))
  (let $ip f64 (f64.floor (local.get $a)))
  (let $istr i32 (call $num_to_radix (i32.trunc_f64_s (local.get $ip)) (local.get $radix)))
  (let $res i32 (if i32 (local.get $neg) (then (call $str_concat (cstring "-") (local.get $istr))) (else (local.get $istr))))
  (let $frac f64 (f64.sub (local.get $a) (local.get $ip)))
  (if (f64.gt (local.get $frac) (f64.const 0))
    (then
      (let $fbuf i32 (call $heap_alloc (i32.const 40)))
      (i32.store8 (local.get $fbuf) (i32.const 46))  ;; '.'
      (let $fn i32 (i32.const 1))
      (let $rf f64 (f64.convert_i32_s (local.get $radix)))
      (block $fe (loop $fl
        (br_if $fe (i32.ge_s (local.get $fn) (i32.const 21)))   ;; cap ~20 fractional digits
        (br_if $fe (f64.le (local.get $frac) (f64.const 0)))
        (set! $frac (f64.mul (local.get $frac) (local.get $rf)))
        (let $d i32 (i32.trunc_f64_s (f64.floor (local.get $frac))))
        (i32.store8 (i32.add (local.get $fbuf) (local.get $fn))
          (if i32 (i32.lt_s (local.get $d) (i32.const 10)) (then (i32.add (i32.const 48) (local.get $d))) (else (i32.add (i32.const 87) (local.get $d)))))
        (set! $frac (f64.sub (local.get $frac) (f64.floor (local.get $frac))))
        (set! $fn (i32.add (local.get $fn) (i32.const 1)))
        (br $fl)))
      (set! $res (call $str_concat (local.get $res) (call $str_from_src (local.get $fbuf) (local.get $fn))))))
  (local.get $res))

;; number → fixed-point string with `d` decimals (Number.prototype.toFixed)
(func $num_to_fixed (param $x f64) (param $d i32) (result i32) (effects)
  (let $neg i32 (f64.lt (local.get $x) (f64.const 0)))
  (set! $x (f64.abs (local.get $x)))
  (let $pow f64 (f64.const 1)) (let $i i32 (i32.const 0))
  (block $pe (loop $pl (br_if $pe (i32.ge_s (local.get $i) (local.get $d))) (set! $pow (f64.mul (local.get $pow) (f64.const 10))) (set! $i (i32.add (local.get $i) (i32.const 1))) (br $pl)))
  (let $scaled f64 (f64.floor (f64.add (f64.mul (local.get $x) (local.get $pow)) (f64.const 0.5))))
  (let $intp f64 (f64.floor (f64.div (local.get $scaled) (local.get $pow))))
  (let $fracf f64 (f64.sub (local.get $scaled) (f64.mul (local.get $intp) (local.get $pow))))
  (let $res i32 (call $num_to_str (local.get $intp)))
  (if (i32.gt_s (local.get $d) (i32.const 0))
    (then
      (let $fbuf i32 (call $str_alloc (local.get $d)))
      (let $fv i32 (i32.trunc_f64_s (local.get $fracf)))
      (let $k i32 (i32.sub (local.get $d) (i32.const 1)))
      (block $fe (loop $fl
        (br_if $fe (i32.lt_s (local.get $k) (i32.const 0)))
        (call $str_set_byte (local.get $fbuf) (local.get $k) (i32.add (i32.const 48) (i32.rem_u (local.get $fv) (i32.const 10))))
        (set! $fv (i32.div_u (local.get $fv) (i32.const 10)))
        (set! $k (i32.sub (local.get $k) (i32.const 1)))
        (br $fl)))
      (set! $res (call $str_concat (local.get $res) (call $str_concat (cstring ".") (local.get $fbuf))))))
  (if (local.get $neg) (then (set! $res (call $str_concat (cstring "-") (local.get $res)))))
  (local.get $res))

;; 10^p as an exact u64 (p in [0,19]).
(func $pow10u (param $p i32) (result i64) (effects)
  (let $r i64 (i64.const 1)) (let $i i32 (i32.const 0))
  (block $e (loop $l (br_if $e (i32.ge_s (local.get $i) (local.get $p)))
    (set! $r (i64.mul (local.get $r) (i64.const 10))) (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
  (local.get $r))

;; Format |ax| (ax>0, normal range) with exactly $p significant digits, placing
;; the decimal point / choosing exponential form per ECMAScript Number::toString.
;; Returns an unsigned heap Str. Digits come from one rounded scaling of ax
;; (m = round(ax * 10^(p-1-exp10))), so a single rounding — accurate where it
;; round-trips. Caller searches p=1..17 for the shortest that round-trips.
(func $fmt_sig (param $ax f64) (param $p i32) (param $trim i32) (param $expthresh i32) (result i32) (effects)
  ;; exp10 = floor(log10(ax)) via normalization into [1,10)
  (let $e i32 (i32.const 0)) (let $t f64 (local.get $ax))
  (block $ge (loop $gl (br_if $ge (f64.lt (local.get $t) (f64.const 10)))
    (set! $t (f64.div (local.get $t) (f64.const 10))) (set! $e (i32.add (local.get $e) (i32.const 1))) (br $gl)))
  (block $le (loop $ll (br_if $le (f64.ge (local.get $t) (f64.const 1)))
    (set! $t (f64.mul (local.get $t) (f64.const 10))) (set! $e (i32.sub (local.get $e) (i32.const 1))) (br $ll)))
  ;; f64 carries only ~17 significant digits; extracting more via i64 overflows
  ;; (ax*10^scale can exceed 2^64). Extract pdig=min(p,17) digits, then zero-pad to p.
  (let $pdig i32 (if i32 (i32.gt_s (local.get $p) (i32.const 17)) (then (i32.const 17)) (else (local.get $p))))
  (let $scale i32 (i32.sub (i32.sub (local.get $pdig) (i32.const 1)) (local.get $e)))
  (let $m i64 (i64.trunc_f64_u (f64.add (f64.mul (local.get $ax) (call $pow10 (f64.convert_i32_s (local.get $scale)))) (f64.const 0.5))))
  ;; rounding carry pushed it to pdig+1 digits → shift back, bump exponent
  (if (i64.ge_u (local.get $m) (call $pow10u (local.get $pdig)))
    (then (set! $m (i64.div_u (local.get $m) (i64.const 10))) (set! $e (i32.add (local.get $e) (i32.const 1)))))
  ;; write the pdig digits of m (zero-padded) into db = scratch+400, then '0'-fill to p
  (let $db i32 (i32.add (call $scratch) (i32.const 400)))
  (let $kf i32 (local.get $pdig))
  (block $fe (loop $fl (br_if $fe (i32.ge_s (local.get $kf) (local.get $p)))
    (i32.store8 (i32.add (local.get $db) (local.get $kf)) (i32.const 48)) (set! $kf (i32.add (local.get $kf) (i32.const 1))) (br $fl)))
  (let $k i32 (i32.sub (local.get $pdig) (i32.const 1)))
  (block $we (loop $wl (br_if $we (i32.lt_s (local.get $k) (i32.const 0)))
    (i32.store8 (i32.add (local.get $db) (local.get $k)) (i32.add (i32.const 48) (i32.wrap_i64 (i64.rem_u (local.get $m) (i64.const 10)))))
    (set! $m (i64.div_u (local.get $m) (i64.const 10))) (set! $k (i32.sub (local.get $k) (i32.const 1))) (br $wl)))
  ;; assemble into scratch[0..]
  (let $n i32 (i32.const 0))
  (let $pp1 i32 (i32.add (local.get $e) (i32.const 1)))  ;; digits before the point
  (if (i32.or (i32.lt_s (local.get $e) (i32.const -6)) (i32.ge_s (local.get $e) (local.get $expthresh)))
    (then  ;; exponential: d.ddd e±XX
      (i32.store8 (i32.add (call $scratch) (local.get $n)) (i32.load8_u (local.get $db))) (set! $n (i32.add (local.get $n) (i32.const 1)))
      (let $last i32 (local.get $p))  ;; trim trailing zeros among db[1..p)
      (if (local.get $trim) (then (block $te (loop $tl (br_if $te (i32.le_s (local.get $last) (i32.const 1)))
        (br_if $te (i32.ne (i32.load8_u (i32.add (local.get $db) (i32.sub (local.get $last) (i32.const 1)))) (i32.const 48)))
        (set! $last (i32.sub (local.get $last) (i32.const 1))) (br $tl)))))
      (if (i32.gt_s (local.get $last) (i32.const 1))
        (then
          (i32.store8 (i32.add (call $scratch) (local.get $n)) (i32.const 46)) (set! $n (i32.add (local.get $n) (i32.const 1)))
          (let $j i32 (i32.const 1))
          (block $ce (loop $cl (br_if $ce (i32.ge_s (local.get $j) (local.get $last)))
            (i32.store8 (i32.add (call $scratch) (local.get $n)) (i32.load8_u (i32.add (local.get $db) (local.get $j))))
            (set! $n (i32.add (local.get $n) (i32.const 1))) (set! $j (i32.add (local.get $j) (i32.const 1))) (br $cl)))))
      (i32.store8 (i32.add (call $scratch) (local.get $n)) (i32.const 101)) (set! $n (i32.add (local.get $n) (i32.const 1)))  ;; 'e'
      (if (i32.ge_s (local.get $e) (i32.const 0))
        (then (i32.store8 (i32.add (call $scratch) (local.get $n)) (i32.const 43)))   ;; '+'
        (else (i32.store8 (i32.add (call $scratch) (local.get $n)) (i32.const 45)) (set! $e (i32.sub (i32.const 0) (local.get $e)))))  ;; '-'
      (set! $n (i32.add (local.get $n) (i32.const 1)))
      (set! $n (call $emit_u64 (local.get $n) (i64.extend_i32_u (local.get $e)))))
    (else (if (i32.le_s (local.get $pp1) (i32.const 0))
      (then  ;; 0.000ddd
        (i32.store8 (i32.add (call $scratch) (local.get $n)) (i32.const 48)) (set! $n (i32.add (local.get $n) (i32.const 1)))  ;; '0'
        (i32.store8 (i32.add (call $scratch) (local.get $n)) (i32.const 46)) (set! $n (i32.add (local.get $n) (i32.const 1)))  ;; '.'
        (let $z i32 (i32.sub (i32.const 0) (local.get $pp1)))
        (block $ze (loop $zl (br_if $ze (i32.le_s (local.get $z) (i32.const 0)))
          (i32.store8 (i32.add (call $scratch) (local.get $n)) (i32.const 48)) (set! $n (i32.add (local.get $n) (i32.const 1)))
          (set! $z (i32.sub (local.get $z) (i32.const 1))) (br $zl)))
        (let $last i32 (local.get $p))  ;; trim trailing zeros
        (if (local.get $trim) (then (block $t2 (loop $tl2 (br_if $t2 (i32.le_s (local.get $last) (i32.const 1)))
          (br_if $t2 (i32.ne (i32.load8_u (i32.add (local.get $db) (i32.sub (local.get $last) (i32.const 1)))) (i32.const 48)))
          (set! $last (i32.sub (local.get $last) (i32.const 1))) (br $tl2)))))
        (let $j i32 (i32.const 0))
        (block $c2 (loop $cl2 (br_if $c2 (i32.ge_s (local.get $j) (local.get $last)))
          (i32.store8 (i32.add (call $scratch) (local.get $n)) (i32.load8_u (i32.add (local.get $db) (local.get $j))))
          (set! $n (i32.add (local.get $n) (i32.const 1))) (set! $j (i32.add (local.get $j) (i32.const 1))) (br $cl2))))
      (else (if (i32.ge_s (local.get $pp1) (local.get $p))
        (then  ;; integer with trailing zeros: ddd000
          (let $j i32 (i32.const 0))
          (block $c3 (loop $cl3 (br_if $c3 (i32.ge_s (local.get $j) (local.get $p)))
            (i32.store8 (i32.add (call $scratch) (local.get $n)) (i32.load8_u (i32.add (local.get $db) (local.get $j))))
            (set! $n (i32.add (local.get $n) (i32.const 1))) (set! $j (i32.add (local.get $j) (i32.const 1))) (br $cl3)))
          (let $z i32 (i32.sub (local.get $pp1) (local.get $p)))
          (block $z3 (loop $zl3 (br_if $z3 (i32.le_s (local.get $z) (i32.const 0)))
            (i32.store8 (i32.add (call $scratch) (local.get $n)) (i32.const 48)) (set! $n (i32.add (local.get $n) (i32.const 1)))
            (set! $z (i32.sub (local.get $z) (i32.const 1))) (br $zl3))))
        (else  ;; ddd.ddd
          (let $j i32 (i32.const 0))
          (block $c4 (loop $cl4 (br_if $c4 (i32.ge_s (local.get $j) (local.get $pp1)))
            (i32.store8 (i32.add (call $scratch) (local.get $n)) (i32.load8_u (i32.add (local.get $db) (local.get $j))))
            (set! $n (i32.add (local.get $n) (i32.const 1))) (set! $j (i32.add (local.get $j) (i32.const 1))) (br $cl4)))
          (let $last i32 (local.get $p))  ;; trim trailing zeros after the point
          (if (local.get $trim) (then (block $t4 (loop $tl4 (br_if $t4 (i32.le_s (local.get $last) (local.get $pp1)))
            (br_if $t4 (i32.ne (i32.load8_u (i32.add (local.get $db) (i32.sub (local.get $last) (i32.const 1)))) (i32.const 48)))
            (set! $last (i32.sub (local.get $last) (i32.const 1))) (br $tl4)))))
          (if (i32.gt_s (local.get $last) (local.get $pp1))
            (then
              (i32.store8 (i32.add (call $scratch) (local.get $n)) (i32.const 46)) (set! $n (i32.add (local.get $n) (i32.const 1)))  ;; '.'
              (let $j2 i32 (local.get $pp1))
              (block $c5 (loop $cl5 (br_if $c5 (i32.ge_s (local.get $j2) (local.get $last)))
                (i32.store8 (i32.add (call $scratch) (local.get $n)) (i32.load8_u (i32.add (local.get $db) (local.get $j2))))
                (set! $n (i32.add (local.get $n) (i32.const 1))) (set! $j2 (i32.add (local.get $j2) (i32.const 1))) (br $cl5)))))))))))
  (call $str_from_src (call $scratch) (local.get $n)))

(func $num_to_str (param $d f64) (result i32) (effects)
  ;; NaN
  (if (f64.ne (local.get $d) (local.get $d)) (then (return (cstring "NaN"))))
  ;; +/- Infinity
  (if (f64.eq (local.get $d) (f64.div (f64.const 1) (f64.const 0))) (then (return (cstring "Infinity"))))
  (if (f64.eq (local.get $d) (f64.div (f64.const -1) (f64.const 0))) (then (return (cstring "-Infinity"))))
  ;; zero (incl. -0 → "0")
  (if (f64.eq (local.get $d) (f64.const 0)) (then (return (cstring "0"))))

  (let $neg i32 (f64.lt (local.get $d) (f64.const 0)))
  (let $ax f64 (f64.abs (local.get $d)))

  ;; exact integer fast path (proven, exact): integral and < 1e21
  (let $ipart f64 (f64.floor (local.get $ax)))
  (if (i32.and (f64.eq (local.get $ipart) (local.get $ax)) (f64.lt (local.get $ax) (f64.const 1e21)))
    (then
      (let $n i32 (i32.const 0))
      (if (local.get $neg) (then (i32.store8 (i32.add (call $scratch) (local.get $n)) (i32.const 45)) (set! $n (i32.add (local.get $n) (i32.const 1)))))
      (if (f64.lt (local.get $ax) (f64.const 9.2e18))
        (then (set! $n (call $emit_u64 (local.get $n) (i64.trunc_f64_u (local.get $ax)))))
        (else (set! $n (call $emit_f64int (local.get $n) (local.get $ax)))))
      (return (call $str_from_src (call $scratch) (local.get $n)))))

  ;; extreme magnitudes (pow10 would overflow in fmt_sig) → approximate exp form
  (if (i32.or (f64.lt (local.get $ax) (f64.const 1e-290)) (f64.gt (local.get $ax) (f64.const 1e290)))
    (then (return (call $num_to_exp (local.get $d)))))

  ;; shortest round-trip: smallest p in [1,17] whose formatting parses back to ax
  (let $res i32 (i32.const 0))
  (let $p i32 (i32.const 1))
  (block $se (loop $sl
    (br_if $se (i32.gt_s (local.get $p) (i32.const 17)))
    (let $s i32 (call $fmt_sig (local.get $ax) (local.get $p) (i32.const 1) (i32.const 21)))
    (if (f64.eq (call $str_to_num (local.get $s)) (local.get $ax)) (then (set! $res (local.get $s)) (br $se)))
    (set! $p (i32.add (local.get $p) (i32.const 1)))
    (br $sl)))
  (if (i32.eqz (local.get $res)) (then (set! $res (call $fmt_sig (local.get $ax) (i32.const 17) (i32.const 1) (i32.const 21)))))
  (if (local.get $neg) (then (set! $res (call $str_concat (cstring "-") (local.get $res)))))
  (local.get $res))

;; Number.prototype.toPrecision(p): exactly p significant digits, zero-padded (no
;; trailing-zero trim). Reuses fmt_sig with trim=0.
(func $num_to_precision (param $d f64) (param $p i32) (result i32) (effects)
  (if (f64.ne (local.get $d) (local.get $d)) (then (return (cstring "NaN"))))
  (if (f64.eq (local.get $d) (f64.div (f64.const 1) (f64.const 0))) (then (return (cstring "Infinity"))))
  (if (f64.eq (local.get $d) (f64.div (f64.const -1) (f64.const 0))) (then (return (cstring "-Infinity"))))
  (let $neg i32 (f64.lt (local.get $d) (f64.const 0)))
  (let $ax f64 (f64.abs (local.get $d)))
  (let $res i32 (i32.const 0))
  (if (f64.eq (local.get $ax) (f64.const 0))
    (then  ;; 0 → "0" or "0.00…" (p-1 zeros)
      (set! $res (cstring "0"))
      (if (i32.gt_s (local.get $p) (i32.const 1))
        (then
          (set! $res (call $str_concat (local.get $res) (cstring ".")))
          (let $z i32 (i32.sub (local.get $p) (i32.const 1)))
          (block $ze (loop $zl (br_if $ze (i32.le_s (local.get $z) (i32.const 0)))
            (set! $res (call $str_concat (local.get $res) (cstring "0"))) (set! $z (i32.sub (local.get $z) (i32.const 1))) (br $zl))))))
    (else (set! $res (call $fmt_sig (local.get $ax) (local.get $p) (i32.const 0) (local.get $p)))))
  (if (local.get $neg) (then (set! $res (call $str_concat (cstring "-") (local.get $res)))))
  (local.get $res))

;; Number.prototype.toExponential(d): "m.ddde±XX" with d fractional digits.
;; Reuses fmt_sig with a very negative exp-threshold so it always picks the
;; exponential layout, p = d+1 significant digits, no trailing-zero trim.
(func $num_to_exponential (param $x f64) (param $d i32) (result i32) (effects)
  (if (f64.ne (local.get $x) (local.get $x)) (then (return (cstring "NaN"))))
  (if (f64.eq (local.get $x) (f64.div (f64.const 1) (f64.const 0))) (then (return (cstring "Infinity"))))
  (if (f64.eq (local.get $x) (f64.div (f64.const -1) (f64.const 0))) (then (return (cstring "-Infinity"))))
  (let $neg i32 (f64.lt (local.get $x) (f64.const 0)))
  (let $ax f64 (f64.abs (local.get $x)))
  (let $res i32 (i32.const 0))
  (if (f64.eq (local.get $ax) (f64.const 0))
    (then
      (set! $res (cstring "0"))
      (if (i32.gt_s (local.get $d) (i32.const 0))
        (then
          (set! $res (call $str_concat (local.get $res) (cstring ".")))
          (let $z i32 (local.get $d))
          (block $ze (loop $zl (br_if $ze (i32.le_s (local.get $z) (i32.const 0)))
            (set! $res (call $str_concat (local.get $res) (cstring "0"))) (set! $z (i32.sub (local.get $z) (i32.const 1))) (br $zl)))))
      (set! $res (call $str_concat (local.get $res) (cstring "e+0"))))
    (else (set! $res (call $fmt_sig (local.get $ax) (i32.add (local.get $d) (i32.const 1)) (i32.const 0) (i32.const -1000000)))))
  (if (local.get $neg) (then (set! $res (call $str_concat (cstring "-") (local.get $res)))))
  (local.get $res))

;; symbol record accessors (payload → [keyStr i32 @0][descStr i32 @4])
(func $sym_key (param $v i64) (result i32) (effects) (i32.load (call $val_payload (local.get $v))))
(func $sym_desc (param $v i64) (result i32) (effects) (i32.load (i32.add (call $val_payload (local.get $v)) (i32.const 4))))
;; description as a STRING ("" for an absent description) — for string-building callers
(func $sym_desc_str (param $v i64) (result i32) (effects)
  (let $d i32 (call $sym_desc (local.get $v)))
  (if i32 (local.get $d) (then (local.get $d)) (else (cstring ""))))

;; property-key coercion: a symbol → its internal key string; else ToString.
;; ToPropertyKey: ToPrimitive(string) then — if the result is a Symbol, use its key (NOT ToString,
;; which would throw); else ToString. Handles an object whose toString/@@toPrimitive returns a Symbol.
(func $to_prop_key (param $v i64) (result i32) (effects)
  (if (call $is_symbol (local.get $v)) (then (return (call $sym_key (local.get $v)))))
  (let $p i64 (local.get $v))
  (if (i32.or (call $is_object (local.get $v)) (i32.or (call $is_array (local.get $v)) (call $is_function (local.get $v))))
    (then (set! $p (call $to_primitive_h (local.get $v) (i32.const 2))) (if (call $err) (then (return (i32.const 0))))))  ;; string hint
  (if (call $is_symbol (local.get $p)) (then (return (call $sym_key (local.get $p)))))
  (call $to_str (local.get $p)))

;; ToPropertyKey returning a VALUE (i64): a Symbol key stays the Symbol — so proxy traps (and any
;; caller that forwards the key to user code) receive the real Symbol, not its internal "@@sym:"
;; storage string; everything else is coerced to a String value. Mirrors $to_prop_key's coercion.
(func $to_prop_key_val (param $v i64) (result i64) (effects)
  (if (call $is_symbol (local.get $v)) (then (return (local.get $v))))
  (let $p i64 (local.get $v))
  (if (i32.or (call $is_object (local.get $v)) (i32.or (call $is_array (local.get $v)) (call $is_function (local.get $v))))
    (then (set! $p (call $to_primitive_h (local.get $v) (i32.const 2))) (if (call $err) (then (return (call $v_undef))))))
  (if (call $is_symbol (local.get $p)) (then (return (local.get $p))))
  (if (call $is_string (local.get $p)) (then (return (local.get $p))))
  (call $mk_str (call $to_str (local.get $p))))

;; ToString of any JSValue → heap Str pointer. (Symbols → "Symbol(desc)" — lenient;
;; spec ToString(symbol) throws, but that breaks many internal call sites.)
;; signed 64-bit integer → decimal string (for BigInt ToString)
(func $i64_to_str (param $v i64) (result i32) (effects)
  (if (i64.eqz (local.get $v)) (then (return (cstring "0"))))
  (let $neg i32 (i64.lt_s (local.get $v) (i64.const 0)))
  (let $u i64 (if i64 (local.get $neg) (then (i64.sub (i64.const 0) (local.get $v))) (else (local.get $v))))
  ;; digits into a 24-byte scratch, back to front
  (let $buf i32 (call $heap_alloc (i32.const 24)))
  (let $p i32 (i32.const 24))
  (block $de (loop $dl
    (set! $p (i32.sub (local.get $p) (i32.const 1)))
    (i32.store8 (i32.add (local.get $buf) (local.get $p)) (i32.add (i32.const 48) (i32.wrap_i64 (i64.rem_u (local.get $u) (i64.const 10)))))
    (set! $u (i64.div_u (local.get $u) (i64.const 10)))
    (br_if $de (i64.eqz (local.get $u)))
    (br $dl)))
  (let $len i32 (i32.sub (i32.const 24) (local.get $p)))
  (let $s i32 (call $str_alloc (i32.add (local.get $len) (if i32 (local.get $neg) (then (i32.const 1)) (else (i32.const 0))))))
  (let $o i32 (i32.const 0))
  (if (local.get $neg) (then (call $str_set_byte (local.get $s) (i32.const 0) (i32.const 45)) (set! $o (i32.const 1))))
  (let $i i32 (i32.const 0))
  (block $ce (loop $cl
    (br_if $ce (i32.ge_s (local.get $i) (local.get $len)))
    (call $str_set_byte (local.get $s) (i32.add (local.get $o) (local.get $i)) (i32.load8_u (i32.add (i32.add (local.get $buf) (local.get $p)) (local.get $i))))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $cl)))
  (local.get $s))

(func $to_str (param $v i64) (result i32) (effects)
  (if i32 (call $is_bigint (local.get $v))
    (then (call $i64_to_str (call $bigint_val (local.get $v))))
    (else
  (if i32 (call $is_symbol (local.get $v))
    (then (call $str_concat (call $str_concat (cstring "Symbol(") (call $sym_desc_str (local.get $v))) (cstring ")")))
    (else
  (if i32 (call $is_number (local.get $v))
    (then (call $num_to_str (call $tonum_raw (local.get $v))))
    (else
      (if i32 (call $is_string (local.get $v)) (then (call $val_payload (local.get $v)))
      (else (if i32 (call $is_undefined (local.get $v)) (then (cstring "undefined"))
      (else (if i32 (call $is_null (local.get $v)) (then (cstring "null"))
      (else (if i32 (call $is_boolean (local.get $v))
               (then (if i32 (call $val_payload (local.get $v)) (then (cstring "true")) (else (cstring "false"))))
      (else (call $obj_to_str (local.get $v)))))))))))))))))

;; ToString for objects/arrays/functions: invoke a toString method if present.
;; ToString(object) = ToPrimitive(O, string hint): @@toPrimitive, else toString()
;; THEN valueOf() (string-hint order), else __prim__ wrapper, else "[object Object]".
;; Mirrors $obj_to_num. Errors surface via the err flag (the cstring "" is a dummy).
;; ToString of a primitive ToPrimitive result: a Symbol throws (unlike lenient $to_str
;; / String(symbol)). Used for the values methods/@@toPrimitive return inside obj_to_str.
(func $prim_to_str (param $p i64) (result i32) (effects)
  (if (call $is_symbol (local.get $p)) (then (call $throw_type (cstring "TypeError") (cstring "Cannot convert a Symbol value to a string")) (return (cstring ""))))
  (call $to_str (local.get $p)))

(func $obj_to_str (param $v i64) (result i32) (effects)
  ;; arrays and functions go through OrdinaryToPrimitive too (so an overridden
  ;; Array.prototype.toString / Function.prototype.toString is honored), not a
  ;; hardcoded join / "function".
  (if (i32.or (call $is_object (local.get $v)) (i32.or (call $is_array (local.get $v)) (call $is_function (local.get $v))))
    (then
      ;; Symbol.toPrimitive (string hint) is authoritative
      (let $stpf i64 (call $get_prop (local.get $v) (call $mk_str (cstring "@@toPrimitive"))))
      (if (call $err) (then (return (cstring ""))))
      ;; GetMethod: @@toPrimitive present but neither undefined/null nor callable → TypeError
      (if (i32.and (i32.eqz (i32.or (call $is_undefined (local.get $stpf)) (call $is_null (local.get $stpf))))
                   (i32.eqz (i32.or (call $is_function (local.get $stpf)) (call $is_proxy (local.get $stpf)))))
        (then (call $throw_type (cstring "TypeError") (cstring "@@toPrimitive is not a function")) (return (cstring ""))))
      (if (i32.or (call $is_function (local.get $stpf)) (call $is_proxy (local.get $stpf)))
        (then
          (let $stpa i32 (call $heap_alloc (i32.const 8)))
          (i64.store (local.get $stpa) (call $mk_str (cstring "string")))
          (let $stpr i64 (call $call_val (local.get $stpf) (i32.const 1) (local.get $stpa) (local.get $v)))
          (if (call $err) (then (return (cstring ""))))
          (if (i32.or (call $is_object (local.get $stpr)) (i32.or (call $is_array (local.get $stpr)) (call $is_function (local.get $stpr))))
            (then (call $throw_type (cstring "TypeError") (cstring "Cannot convert object to primitive value")) (return (cstring ""))))
          (return (call $prim_to_str (local.get $stpr)))))
      ;; @@toPrimitive present but not callable (and not null) → TypeError
      (if (i32.eqz (i32.or (call $is_undefined (local.get $stpf)) (call $is_null (local.get $stpf))))
        (then (call $throw_type (cstring "TypeError") (cstring "@@toPrimitive is not a function")) (return (cstring ""))))
      (let $shad i32 (i32.const 0))  ;; a method returned an object
      ;; toString first (string hint)
      (let $sts i64 (call $get_prop (local.get $v) (call $mk_str (cstring "toString"))))
      (if (call $err) (then (return (cstring ""))))
      (if (call $is_function (local.get $sts))
        (then
          (let $sr i64 (call $call_fn0 (local.get $sts) (local.get $v)))
          (if (call $err) (then (return (cstring ""))))
          (if (i32.eqz (i32.or (call $is_object (local.get $sr)) (i32.or (call $is_array (local.get $sr)) (call $is_function (local.get $sr))))) (then (return (call $prim_to_str (local.get $sr)))))
          (set! $shad (i32.const 1))))
      ;; then valueOf
      (let $svo i64 (call $get_prop (local.get $v) (call $mk_str (cstring "valueOf"))))
      (if (call $err) (then (return (cstring ""))))
      (if (call $is_function (local.get $svo))
        (then
          (let $sr2 i64 (call $call_fn0 (local.get $svo) (local.get $v)))
          (if (call $err) (then (return (cstring ""))))
          (if (i32.eqz (i32.or (call $is_object (local.get $sr2)) (i32.or (call $is_array (local.get $sr2)) (call $is_function (local.get $sr2))))) (then (return (call $prim_to_str (local.get $sr2)))))
          (set! $shad (i32.const 1))))
      ;; wrapper object (new String/Number/Boolean): ToString of the boxed primitive
      (if (call $is_object (local.get $v))
        (then
          (let $pslot i32 (call $scope_find_local (call $val_payload (local.get $v)) (cstring "__prim__")))
          (if (local.get $pslot) (then (return (call $to_str (i64.load (local.get $pslot))))))))
      ;; neither toString nor valueOf was callable (or a method returned an object) →
      ;; OrdinaryToPrimitive has no usable result → TypeError
      (call $throw_type (cstring "TypeError") (cstring "Cannot convert object to primitive value"))
      (return (cstring ""))))
  (if (call $is_function (local.get $v)) (then (return (cstring "function"))))
  (cstring "[object Object]"))

;; Array#toString: comma-joined element strings (undefined/null -> empty).
(func $arr_join (param $v i64) (result i32) (effects)
  (let $a i32 (call $val_payload (local.get $v)))
  (let $n i32 (call $arr_len (local.get $a)))
  (let $out i32 (cstring ""))
  (let $i i32 (i32.const 0))
  (block $brk (loop $cont
    (br_if $brk (i32.ge_s (local.get $i) (local.get $n)))
    (if (i32.gt_s (local.get $i) (i32.const 0)) (then (set! $out (call $str_concat (local.get $out) (cstring ",")))))
    (let $e i64 (call $arr_get (local.get $a) (local.get $i)))
    (if (i32.eqz (i32.or (call $is_undefined (local.get $e)) (call $is_null (local.get $e))))
      (then (set! $out (call $str_concat (local.get $out) (call $to_str (local.get $e))))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $cont)))
  (local.get $out))

;; ToNumber of any JSValue → f64.
(func $to_num (param $v i64) (result f64) (effects)
  (if f64 (call $is_number (local.get $v))
    (then (call $tonum_raw (local.get $v)))
    (else
      (if f64 (call $is_bigint (local.get $v))
        (then (f64.convert_i64_s (call $bigint_val (local.get $v))))  ;; for == / relational (Number(bigint) is separate)
      (else
      (if f64 (call $is_boolean (local.get $v))
        (then (f64.convert_i32_s (call $val_payload (local.get $v))))
      (else (if f64 (call $is_null (local.get $v)) (then (f64.const 0))
      (else (if f64 (call $is_string (local.get $v))
               (then (call $str_to_num (call $val_payload (local.get $v))))
      (else (if f64 (call $is_array (local.get $v))
               (then (call $str_to_num (call $to_str (local.get $v))))  ;; array: ToPrimitive→toString(join)→ToNumber ([5]→5, []→0)
      (else (if f64 (call $is_object (local.get $v))
               (then (call $obj_to_num (local.get $v)))
      (else (if f64 (call $is_symbol (local.get $v))
               ;; ToNumber(Symbol) throws; loose_eq excludes symbols before this,
               ;; so only genuine numeric coercion (+sym, sym*2, sym<1) reaches here
               (then (call $throw_type (cstring "TypeError") (cstring "Cannot convert a Symbol value to a number")) (f64.div (f64.const 0) (f64.const 0)))
               (else (f64.div (f64.const 0) (f64.const 0)))))))))))))))))))  ;; undefined → NaN

;; ToNumber for a Number-format argument (toFixed/toString radix/toPrecision/
;; toExponential digits). Unlike the == / relational path, here ToNumber(BigInt)
;; is a TypeError. Symbol already throws inside $to_num.
(func $tonum_fmtarg (param $v i64) (result f64) (effects)
  ;; ToNumber: ToPrimitive(number) FIRST, so an object whose valueOf/@@toPrimitive yields
  ;; a BigInt (or Symbol) throws TypeError — not only a directly-passed BigInt.
  (let $p i64 (call $to_primitive_h (local.get $v) (i32.const 1)))
  (if (call $err) (then (return (f64.div (f64.const 0) (f64.const 0)))))
  (if (call $is_bigint (local.get $p))
    (then (call $throw_type (cstring "TypeError") (cstring "Cannot convert a BigInt value to a number")) (return (f64.div (f64.const 0) (f64.const 0)))))
  (call $to_num (local.get $p)))

;; ToNumber for an object: prefer valueOf(), then __prim__ wrapper slot, else NaN.
(func $obj_to_num (param $v i64) (result f64) (effects)
  ;; Symbol.toPrimitive (number hint) is authoritative for ToNumber(object)
  (let $ntpf i64 (call $get_prop (local.get $v) (call $mk_str (cstring "@@toPrimitive"))))
  (if (call $err) (then (return (f64.div (f64.const 0) (f64.const 0)))))  ;; throwing @@toPrimitive getter
  (if (i32.and (i32.eqz (i32.or (call $is_undefined (local.get $ntpf)) (call $is_null (local.get $ntpf))))
               (i32.eqz (i32.or (call $is_function (local.get $ntpf)) (call $is_proxy (local.get $ntpf)))))
    (then (call $throw_type (cstring "TypeError") (cstring "@@toPrimitive is not a function")) (return (f64.div (f64.const 0) (f64.const 0)))))
  (if (i32.or (call $is_function (local.get $ntpf)) (call $is_proxy (local.get $ntpf)))
    (then
      (let $ntpa i32 (call $heap_alloc (i32.const 8)))
      (i64.store (local.get $ntpa) (call $mk_str (cstring "number")))
      (let $ntpr i64 (call $call_val (local.get $ntpf) (i32.const 1) (local.get $ntpa) (local.get $v)))
      (if (call $err) (then (return (f64.div (f64.const 0) (f64.const 0)))))
      (if (i32.or (call $is_object (local.get $ntpr)) (i32.or (call $is_array (local.get $ntpr)) (call $is_function (local.get $ntpr))))
        (then (call $throw_type (cstring "TypeError") (cstring "Cannot convert object to primitive value")) (return (f64.div (f64.const 0) (f64.const 0)))))
      (return (call $to_num (local.get $ntpr)))))
  (let $had i32 (i32.const 0))  ;; saw a user valueOf/toString that returned an object
  (let $vo i64 (call $get_prop (local.get $v) (call $mk_str (cstring "valueOf"))))
  (if (call $is_function (local.get $vo))
    (then
      (let $r i64 (call $call_fn0 (local.get $vo) (local.get $v)))
      (if (i32.eqz (call $is_object (local.get $r))) (then (return (call $to_num (local.get $r)))))
      (set! $had (i32.const 1))))
  ;; then toString (ToPrimitive number hint)
  (let $ts i64 (call $get_prop (local.get $v) (call $mk_str (cstring "toString"))))
  (if (call $is_function (local.get $ts))
    (then
      (let $r2 i64 (call $call_fn0 (local.get $ts) (local.get $v)))
      (if (i32.eqz (call $is_object (local.get $r2))) (then (return (call $to_num (local.get $r2)))))
      (set! $had (i32.const 1))))
  (let $o i32 (call $val_payload (local.get $v)))
  (let $slot i32 (call $scope_find_local (local.get $o) (cstring "__prim__")))
  (if (local.get $slot) (then (return (call $to_num (i64.load (local.get $slot))))))
  ;; a user valueOf/toString existed but returned an object → genuine TypeError.
  (if (local.get $had)
    (then
      (call $throw_type (cstring "TypeError") (cstring "Cannot convert object to primitive value"))
      (return (f64.div (f64.const 0) (f64.const 0)))))
  ;; ordinary object with no usable method: ToPrimitive falls back to the default
  ;; ToString ("[object Object]") → ToNumber → NaN (not a TypeError).
  (call $str_to_num (call $obj_to_str (local.get $v))))

;; ToPrimitive. $hint: 0 default, 1 number, 2 string. number order is
;; valueOf→toString, string order is toString→valueOf. The "default" hint acts
;; as number for ordinary objects and as string for Date. Primitives pass
;; through; throws TypeError if a present valueOf/toString both return objects.
(func $to_primitive_h (param $v i64) (param $hint i32) (result i64) (effects)
  ;; already a primitive
  (if (i32.eqz (i32.or (call $is_object (local.get $v)) (i32.or (call $is_array (local.get $v)) (call $is_function (local.get $v)))))
    (then (return (local.get $v))))
  ;; arrays stringify via join
  (if (call $is_array (local.get $v)) (then (return (call $mk_str (call $arr_join (local.get $v))))))
  ;; Symbol.toPrimitive (key "@@toPrimitive"): if a callable, it is authoritative
  (if (call $is_object (local.get $v))
    (then
      (let $tpf i64 (call $get_prop (local.get $v) (call $mk_str (cstring "@@toPrimitive"))))
      (if (call $err) (then (return (call $v_undef))))  ;; throwing @@toPrimitive getter (GetMethod) propagates
      ;; GetMethod: @@toPrimitive present but neither undefined/null nor callable → TypeError
      (if (i32.and (i32.eqz (i32.or (call $is_undefined (local.get $tpf)) (call $is_null (local.get $tpf))))
                   (i32.eqz (i32.or (call $is_function (local.get $tpf)) (call $is_proxy (local.get $tpf)))))
        (then (call $throw_type (cstring "TypeError") (cstring "@@toPrimitive is not a function")) (return (call $v_undef))))
      (if (i32.or (call $is_function (local.get $tpf)) (call $is_proxy (local.get $tpf)))
        (then
          (let $hintstr i32 (cstring "default"))
          (if (i32.eq (local.get $hint) (i32.const 1)) (then (set! $hintstr (cstring "number"))))
          (if (i32.eq (local.get $hint) (i32.const 2)) (then (set! $hintstr (cstring "string"))))
          (let $tpa i32 (call $heap_alloc (i32.const 8)))
          (i64.store (local.get $tpa) (call $mk_str (local.get $hintstr)))
          (let $tpr i64 (call $call_val (local.get $tpf) (i32.const 1) (local.get $tpa) (local.get $v)))
          (if (call $err) (then (return (call $v_undef))))
          (if (i32.or (call $is_object (local.get $tpr)) (i32.or (call $is_array (local.get $tpr)) (call $is_function (local.get $tpr))))
            (then (call $throw_type (cstring "TypeError") (cstring "Cannot convert object to primitive value")) (return (call $v_undef))))
          (return (local.get $tpr))))))
  ;; string-order when the hint is "string", or "default" on a Date (own @@time)
  (let $strFirst i32 (i32.eq (local.get $hint) (i32.const 2)))
  (if (i32.and (i32.eq (local.get $hint) (i32.const 0)) (call $is_object (local.get $v)))
    (then (if (call $scope_find_local (call $val_payload (local.get $v)) (cstring "@@time"))
            (then (set! $strFirst (i32.const 1))))))
  (let $had i32 (i32.const 0))
  (let $m1 i32 (cstring "valueOf"))
  (let $m2 i32 (cstring "toString"))
  (if (local.get $strFirst) (then (set! $m1 (cstring "toString")) (set! $m2 (cstring "valueOf"))))
  (let $f1 i64 (call $get_prop (local.get $v) (call $mk_str (local.get $m1))))
  (if (call $is_function (local.get $f1))
    (then
      (let $r1 i64 (call $call_fn0 (local.get $f1) (local.get $v)))
      (if (i32.eqz (i32.or (call $is_object (local.get $r1)) (i32.or (call $is_array (local.get $r1)) (call $is_function (local.get $r1)))))
        (then (return (local.get $r1))))
      (set! $had (i32.const 1))))
  (let $f2 i64 (call $get_prop (local.get $v) (call $mk_str (local.get $m2))))
  (if (call $is_function (local.get $f2))
    (then
      (let $r2 i64 (call $call_fn0 (local.get $f2) (local.get $v)))
      (if (i32.eqz (i32.or (call $is_object (local.get $r2)) (i32.or (call $is_array (local.get $r2)) (call $is_function (local.get $r2)))))
        (then (return (local.get $r2))))
      (set! $had (i32.const 1))))
  ;; wrapper objects (new String/Number/Boolean) carry the boxed primitive
  (if (call $is_object (local.get $v))
    (then
      (let $slot i32 (call $scope_find_local (call $val_payload (local.get $v)) (cstring "__prim__")))
      (if (local.get $slot) (then (return (i64.load (local.get $slot)))))))
  ;; user method(s) present but returned objects → TypeError
  (if (local.get $had)
    (then
      (call $throw_type (cstring "TypeError") (cstring "Cannot convert object to primitive value"))
      (return (call $v_undef))))
  ;; ordinary object / function: default ToString brand
  (call $mk_str (call $obj_to_str (local.get $v))))

;; ToPrimitive with the default hint (used by `+` and `==`).
(func $to_primitive (param $v i64) (result i64) (effects)
  (call $to_primitive_h (local.get $v) (i32.const 0)))

;; Lexicographic (code-unit / byte) string less-than: 1 if a < b, else 0.
(func $str_less (param $a i32) (param $b i32) (result i32) (effects)
  (let $la i32 (call $str_len (local.get $a)))
  (let $lb i32 (call $str_len (local.get $b)))
  (let $n i32 (if i32 (i32.lt_s (local.get $la) (local.get $lb)) (then (local.get $la)) (else (local.get $lb))))
  (let $i i32 (i32.const 0))
  (block $brk (loop $cont
    (br_if $brk (i32.ge_s (local.get $i) (local.get $n)))
    (let $ca i32 (call $str_byte (local.get $a) (local.get $i)))
    (let $cb i32 (call $str_byte (local.get $b) (local.get $i)))
    (if (i32.lt_u (local.get $ca) (local.get $cb)) (then (return (i32.const 1))))
    (if (i32.gt_u (local.get $ca) (local.get $cb)) (then (return (i32.const 0))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $cont)))
  ;; common prefix equal → shorter string is less
  (i32.lt_s (local.get $la) (local.get $lb)))

;; Abstract Relational Comparison a < b (LeftFirst). Returns 0 false, 1 true,
;; 2 undefined (a NaN operand). Both operands ToPrimitive(number); two string
;; primitives compare lexicographically, otherwise numerically.
(func $js_less (param $a i64) (param $b i64) (result i32) (effects)
  (let $pa i64 (call $to_primitive_h (local.get $a) (i32.const 1)))
  (if (call $err) (then (return (i32.const 0))))
  (let $pb i64 (call $to_primitive_h (local.get $b) (i32.const 1)))
  (if (call $err) (then (return (i32.const 0))))
  (if (i32.and (call $is_string (local.get $pa)) (call $is_string (local.get $pb)))
    (then (return (call $str_less (call $val_payload (local.get $pa)) (call $val_payload (local.get $pb))))))
  (let $na f64 (call $to_num (local.get $pa)))
  (let $nb f64 (call $to_num (local.get $pb)))
  (if (i32.or (f64.ne (local.get $na) (local.get $na)) (f64.ne (local.get $nb) (local.get $nb)))
    (then (return (i32.const 2))))  ;; NaN → undefined
  (if i32 (f64.lt (local.get $na) (local.get $nb)) (then (i32.const 1)) (else (i32.const 0))))

;; Parse a string as a number: sign, digits, fraction, and e/E exponent.
;; Accumulates up to 17 significant digits into a u64 mantissa + decimal
;; exponent, then combines. Fast path (<=15 sig digits, |exp|<=22) uses a
;; single exact multiply/divide → correctly rounded. Empty→0, bad→NaN.
;; True if s[pos..] begins with the literal string `lit`.
(func $str_match_at (param $s i32) (param $pos i32) (param $lit i32) (result i32) (effects)
  (let $n i32 (call $str_len (local.get $lit)))
  (if (i32.gt_s (i32.add (local.get $pos) (local.get $n)) (call $str_len (local.get $s))) (then (return (i32.const 0))))
  (let $k i32 (i32.const 0))
  (block $b (loop $l
    (br_if $b (i32.ge_s (local.get $k) (local.get $n)))
    (if (i32.ne (call $str_byte (local.get $s) (i32.add (local.get $pos) (local.get $k))) (call $str_byte (local.get $lit) (local.get $k)))
      (then (return (i32.const 0))))
    (set! $k (i32.add (local.get $k) (i32.const 1))) (br $l)))
  (i32.const 1))

;; True if every byte from pos to len is ASCII whitespace (or pos>=len).
(func $str_rest_ws (param $s i32) (param $pos i32) (param $len i32) (result i32) (effects)
  (block $b (loop $l
    (br_if $b (i32.ge_s (local.get $pos) (local.get $len)))
    (let $w i32 (call $ws_fwd_len (local.get $s) (local.get $pos)))  ;; ASCII + UTF-8 Unicode whitespace
    (if (i32.eqz (local.get $w)) (then (return (i32.const 0))))
    (set! $pos (i32.add (local.get $pos) (local.get $w))) (br $l)))
  (i32.const 1))

;; Parse a base-`base` (2/8/16) integer at s[pos..]; trailing whitespace OK.
;; Empty or any invalid digit → NaN. Accumulates in f64.
(func $str_radix (param $s i32) (param $pos i32) (param $len i32) (param $base i32) (result f64) (effects)
  (let $val f64 (f64.const 0))
  (let $any i32 (i32.const 0))
  (let $bf f64 (f64.convert_i32_s (local.get $base)))
  (block $b (loop $l
    (br_if $b (i32.ge_s (local.get $pos) (local.get $len)))
    (let $c i32 (call $str_byte (local.get $s) (local.get $pos)))
    (let $dv i32 (i32.const -1))
    (if (i32.and (i32.ge_s (local.get $c) (i32.const 48)) (i32.le_s (local.get $c) (i32.const 57))) (then (set! $dv (i32.sub (local.get $c) (i32.const 48)))))
    (if (i32.and (i32.ge_s (local.get $c) (i32.const 97)) (i32.le_s (local.get $c) (i32.const 102))) (then (set! $dv (i32.add (i32.sub (local.get $c) (i32.const 97)) (i32.const 10)))))
    (if (i32.and (i32.ge_s (local.get $c) (i32.const 65)) (i32.le_s (local.get $c) (i32.const 70))) (then (set! $dv (i32.add (i32.sub (local.get $c) (i32.const 65)) (i32.const 10)))))
    (if (i32.or (i32.lt_s (local.get $dv) (i32.const 0)) (i32.ge_s (local.get $dv) (local.get $base))) (then (br $b)))
    (set! $val (f64.add (f64.mul (local.get $val) (local.get $bf)) (f64.convert_i32_s (local.get $dv))))
    (set! $any (i32.const 1))
    (set! $pos (i32.add (local.get $pos) (i32.const 1))) (br $l)))
  (if (i32.eqz (local.get $any)) (then (return (f64.div (f64.const 0) (f64.const 0)))))
  (if (i32.eqz (call $str_rest_ws (local.get $s) (local.get $pos) (local.get $len))) (then (return (f64.div (f64.const 0) (f64.const 0)))))
  (local.get $val))

;; copy s[from..to) into a fresh Str
(func $str_slice_simple (param $s i32) (param $from i32) (param $to i32) (result i32) (effects)
  (let $ln i32 (i32.sub (local.get $to) (local.get $from)))
  (if (i32.lt_s (local.get $ln) (i32.const 0)) (then (set! $ln (i32.const 0))))
  (let $r i32 (call $str_alloc (local.get $ln)))
  (let $k i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $k) (local.get $ln)))
    (call $str_set_byte (local.get $r) (local.get $k) (call $str_byte (local.get $s) (i32.add (local.get $from) (local.get $k))))
    (set! $k (i32.add (local.get $k) (i32.const 1))) (br $l)))
  (local.get $r))

;; does `word` occur at s[pos..]?
(func $str_prefix_at (param $s i32) (param $pos i32) (param $word i32) (result i32) (effects)
  (let $wn i32 (call $str_len (local.get $word)))
  (if (i32.gt_s (i32.add (local.get $pos) (local.get $wn)) (call $str_len (local.get $s))) (then (return (i32.const 0))))
  (let $k i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $k) (local.get $wn)))
    (if (i32.ne (call $str_byte (local.get $s) (i32.add (local.get $pos) (local.get $k))) (call $str_byte (local.get $word) (local.get $k))) (then (return (i32.const 0))))
    (set! $k (i32.add (local.get $k) (i32.const 1))) (br $l)))
  (i32.const 1))

;; parseFloat: parse the longest valid decimal-literal PREFIX (ignoring trailing
;; junk), per spec — NOT requiring the whole string to be numeric. NaN if none.
(func $parse_float (param $s i32) (result f64) (effects)
  (let $n i32 (call $str_len (local.get $s)))
  (let $i i32 (i32.const 0))
  (block $wse (loop $wsl  ;; skip leading StrWhiteSpace / line terminators
    (br_if $wse (i32.ge_s (local.get $i) (local.get $n)))
    (let $c i32 (call $str_byte (local.get $s) (local.get $i)))
    (if (call $is_space (local.get $c))   ;; ASCII TAB/LF/VT/FF/CR/SP
      (then (set! $i (i32.add (local.get $i) (i32.const 1))) (br $wsl)))
    ;; NBSP (C2 A0)
    (if (i32.and (i32.eq (local.get $c) (i32.const 194)) (i32.lt_s (i32.add (local.get $i) (i32.const 1)) (local.get $n)))
      (then (if (i32.eq (call $str_byte (local.get $s) (i32.add (local.get $i) (i32.const 1))) (i32.const 160))
        (then (set! $i (i32.add (local.get $i) (i32.const 2))) (br $wsl)))))
    ;; LS/PS (E2 80 A8/A9)
    (if (i32.and (i32.eq (local.get $c) (i32.const 226)) (i32.lt_s (i32.add (local.get $i) (i32.const 2)) (local.get $n)))
      (then (if (i32.and (i32.eq (call $str_byte (local.get $s) (i32.add (local.get $i) (i32.const 1))) (i32.const 128))
              (i32.or (i32.eq (call $str_byte (local.get $s) (i32.add (local.get $i) (i32.const 2))) (i32.const 168))
                      (i32.eq (call $str_byte (local.get $s) (i32.add (local.get $i) (i32.const 2))) (i32.const 169))))
        (then (set! $i (i32.add (local.get $i) (i32.const 3))) (br $wsl)))))
    ;; BOM (EF BB BF)
    (if (i32.and (i32.eq (local.get $c) (i32.const 239)) (i32.lt_s (i32.add (local.get $i) (i32.const 2)) (local.get $n)))
      (then (if (i32.and (i32.eq (call $str_byte (local.get $s) (i32.add (local.get $i) (i32.const 1))) (i32.const 187))
                         (i32.eq (call $str_byte (local.get $s) (i32.add (local.get $i) (i32.const 2))) (i32.const 191)))
        (then (set! $i (i32.add (local.get $i) (i32.const 3))) (br $wsl)))))
    (br $wse)))
  (let $start i32 (local.get $i))
  (if (i32.lt_s (local.get $i) (local.get $n))  ;; optional sign
    (then
      (let $sc i32 (call $str_byte (local.get $s) (local.get $i)))
      (if (i32.or (i32.eq (local.get $sc) (i32.const 43)) (i32.eq (local.get $sc) (i32.const 45))) (then (set! $i (i32.add (local.get $i) (i32.const 1)))))))
  (if (call $str_prefix_at (local.get $s) (local.get $i) (cstring "Infinity"))  ;; [+-]Infinity
    (then (return (call $str_to_num (call $str_slice_simple (local.get $s) (local.get $start) (i32.add (local.get $i) (i32.const 8)))))))
  (let $md i32 (i32.const 0))  ;; mantissa digit count
  (block $ie (loop $il  ;; integer digits
    (br_if $ie (i32.ge_s (local.get $i) (local.get $n)))
    (let $d i32 (call $str_byte (local.get $s) (local.get $i)))
    (br_if $ie (i32.eqz (i32.and (i32.ge_s (local.get $d) (i32.const 48)) (i32.le_s (local.get $d) (i32.const 57)))))
    (set! $md (i32.add (local.get $md) (i32.const 1)))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $il)))
  (if (i32.and (i32.lt_s (local.get $i) (local.get $n)) (i32.eq (call $str_byte (local.get $s) (local.get $i)) (i32.const 46)))  ;; '.'
    (then
      (set! $i (i32.add (local.get $i) (i32.const 1)))
      (block $fe (loop $fl  ;; fraction digits
        (br_if $fe (i32.ge_s (local.get $i) (local.get $n)))
        (let $d2 i32 (call $str_byte (local.get $s) (local.get $i)))
        (br_if $fe (i32.eqz (i32.and (i32.ge_s (local.get $d2) (i32.const 48)) (i32.le_s (local.get $d2) (i32.const 57)))))
        (set! $md (i32.add (local.get $md) (i32.const 1)))
        (set! $i (i32.add (local.get $i) (i32.const 1))) (br $fl)))))
  (if (i32.eqz (local.get $md)) (then (return (f64.div (f64.const 0) (f64.const 0)))))  ;; no digits → NaN
  (if (i32.and (i32.lt_s (local.get $i) (local.get $n)) (i32.or (i32.eq (call $str_byte (local.get $s) (local.get $i)) (i32.const 101)) (i32.eq (call $str_byte (local.get $s) (local.get $i)) (i32.const 69))))  ;; e/E exponent
    (then
      (let $esave i32 (local.get $i))
      (set! $i (i32.add (local.get $i) (i32.const 1)))
      (if (i32.and (i32.lt_s (local.get $i) (local.get $n)) (i32.or (i32.eq (call $str_byte (local.get $s) (local.get $i)) (i32.const 43)) (i32.eq (call $str_byte (local.get $s) (local.get $i)) (i32.const 45)))) (then (set! $i (i32.add (local.get $i) (i32.const 1)))))
      (let $ed i32 (i32.const 0))
      (block $ee (loop $el
        (br_if $ee (i32.ge_s (local.get $i) (local.get $n)))
        (let $d3 i32 (call $str_byte (local.get $s) (local.get $i)))
        (br_if $ee (i32.eqz (i32.and (i32.ge_s (local.get $d3) (i32.const 48)) (i32.le_s (local.get $d3) (i32.const 57)))))
        (set! $ed (i32.add (local.get $ed) (i32.const 1)))
        (set! $i (i32.add (local.get $i) (i32.const 1))) (br $el)))
      (if (i32.eqz (local.get $ed)) (then (set! $i (local.get $esave))))))  ;; no exp digits → roll back 'e'
  (call $str_to_num (call $str_slice_simple (local.get $s) (local.get $start) (local.get $i))))

(func $str_to_num (param $s i32) (result f64) (effects)
  (let $len i32 (call $str_len (local.get $s)))
  (let $i i32 (i32.const 0))
  ;; skip leading WhiteSpace/LineTerminator (ASCII + all UTF-8 Unicode spaces)
  (block $sl1 (loop $ll1
    (br_if $sl1 (i32.ge_s (local.get $i) (local.get $len)))
    (let $w i32 (call $ws_fwd_len (local.get $s) (local.get $i)))
    (br_if $sl1 (i32.eqz (local.get $w)))
    (set! $i (i32.add (local.get $i) (local.get $w))) (br $ll1)))
  (if (i32.ge_s (local.get $i) (local.get $len)) (then (return (f64.const 0))))  ;; empty / all whitespace → 0
  (let $sign f64 (f64.const 1))
  (let $signSeen i32 (i32.const 0))
  (let $c0 i32 (call $str_byte (local.get $s) (local.get $i)))
  (if (i32.eq (local.get $c0) (i32.const 43)) (then (set! $i (i32.add (local.get $i) (i32.const 1))) (set! $signSeen (i32.const 1))))
  (if (i32.eq (local.get $c0) (i32.const 45)) (then (set! $sign (f64.const -1)) (set! $i (i32.add (local.get $i) (i32.const 1))) (set! $signSeen (i32.const 1))))
  ;; Infinity (a sign is allowed)
  (if (call $str_match_at (local.get $s) (local.get $i) (cstring "Infinity"))
    (then
      (set! $i (i32.add (local.get $i) (i32.const 8)))
      (if (call $str_rest_ws (local.get $s) (local.get $i) (local.get $len))
        (then (return (f64.mul (local.get $sign) (f64.div (f64.const 1) (f64.const 0)))))
        (else (return (f64.div (f64.const 0) (f64.const 0)))))))
  ;; 0x / 0o / 0b radix integer — only without a sign
  (if (i32.and (i32.eqz (local.get $signSeen)) (i32.lt_s (i32.add (local.get $i) (i32.const 1)) (local.get $len)))
    (then
      (if (i32.eq (call $str_byte (local.get $s) (local.get $i)) (i32.const 48))
        (then
          (let $px i32 (call $str_byte (local.get $s) (i32.add (local.get $i) (i32.const 1))))
          (if (i32.or (i32.eq (local.get $px) (i32.const 120)) (i32.eq (local.get $px) (i32.const 88))) (then (return (call $str_radix (local.get $s) (i32.add (local.get $i) (i32.const 2)) (local.get $len) (i32.const 16)))))
          (if (i32.or (i32.eq (local.get $px) (i32.const 111)) (i32.eq (local.get $px) (i32.const 79))) (then (return (call $str_radix (local.get $s) (i32.add (local.get $i) (i32.const 2)) (local.get $len) (i32.const 8)))))
          (if (i32.or (i32.eq (local.get $px) (i32.const 98)) (i32.eq (local.get $px) (i32.const 66))) (then (return (call $str_radix (local.get $s) (i32.add (local.get $i) (i32.const 2)) (local.get $len) (i32.const 2)))))))))
  ;; decimal: integer digits, fraction, optional e/E exponent
  (let $mant i64 (i64.const 0))
  (let $nd i32 (i32.const 0))     ;; significant digits accumulated
  (let $exp i32 (i32.const 0))    ;; power-of-ten to apply to mant
  (let $any i32 (i32.const 0))
  (let $dot i32 (i32.const 0))
  (block $ie (loop $il
    (br_if $ie (i32.ge_s (local.get $i) (local.get $len)))
    (let $d i32 (call $str_byte (local.get $s) (local.get $i)))
    (if (i32.eq (local.get $d) (i32.const 46))           ;; '.'
      (then
        (if (local.get $dot) (then (br $ie)))            ;; a second dot ends the number
        (set! $dot (i32.const 1))
        (set! $i (i32.add (local.get $i) (i32.const 1)))
        (br $il)))
    (br_if $ie (i32.eqz (i32.and (i32.ge_s (local.get $d) (i32.const 48)) (i32.le_s (local.get $d) (i32.const 57)))))
    (set! $any (i32.const 1))
    (if (i32.lt_s (local.get $nd) (i32.const 17))
      (then
        (set! $mant (i64.add (i64.mul (local.get $mant) (i64.const 10)) (i64.extend_i32_s (i32.sub (local.get $d) (i32.const 48)))))
        (set! $nd (i32.add (local.get $nd) (i32.const 1)))
        (if (local.get $dot) (then (set! $exp (i32.sub (local.get $exp) (i32.const 1))))))
      (else
        (if (i32.eqz (local.get $dot)) (then (set! $exp (i32.add (local.get $exp) (i32.const 1)))))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $il)))
  ;; e/E exponent
  (let $sawE i32 (i32.const 0))
  (let $edig i32 (i32.const 0))
  (if (i32.lt_s (local.get $i) (local.get $len))
    (then
      (let $ec i32 (call $str_byte (local.get $s) (local.get $i)))
      (if (i32.or (i32.eq (local.get $ec) (i32.const 101)) (i32.eq (local.get $ec) (i32.const 69)))
        (then
          (set! $sawE (i32.const 1))
          (set! $i (i32.add (local.get $i) (i32.const 1)))
          (let $es i32 (i32.const 1))
          (if (i32.lt_s (local.get $i) (local.get $len))
            (then
              (let $sc i32 (call $str_byte (local.get $s) (local.get $i)))
              (if (i32.eq (local.get $sc) (i32.const 43)) (then (set! $i (i32.add (local.get $i) (i32.const 1)))))
              (if (i32.eq (local.get $sc) (i32.const 45)) (then (set! $es (i32.const -1)) (set! $i (i32.add (local.get $i) (i32.const 1)))))))
          (let $en i32 (i32.const 0))
          (block $ee (loop $el
            (br_if $ee (i32.ge_s (local.get $i) (local.get $len)))
            (let $ed i32 (call $str_byte (local.get $s) (local.get $i)))
            (br_if $ee (i32.eqz (i32.and (i32.ge_s (local.get $ed) (i32.const 48)) (i32.le_s (local.get $ed) (i32.const 57)))))
            (set! $en (i32.add (i32.mul (local.get $en) (i32.const 10)) (i32.sub (local.get $ed) (i32.const 48))))
            (set! $edig (i32.add (local.get $edig) (i32.const 1)))
            (set! $i (i32.add (local.get $i) (i32.const 1))) (br $el)))
          (set! $exp (i32.add (local.get $exp) (i32.mul (local.get $es) (local.get $en))))))))
  ;; 'e' with no exponent digits, leftover non-whitespace, or no mantissa → NaN
  (if (i32.and (local.get $sawE) (i32.eqz (local.get $edig))) (then (return (f64.div (f64.const 0) (f64.const 0)))))
  (if (i32.eqz (call $str_rest_ws (local.get $s) (local.get $i) (local.get $len))) (then (return (f64.div (f64.const 0) (f64.const 0)))))
  (if (i32.eqz (local.get $any)) (then (return (f64.div (f64.const 0) (f64.const 0)))))
  (let $r f64 (f64.convert_i64_s (local.get $mant)))
  (let $res f64 (local.get $r))
  ;; combine mant·10^exp — MUST match $lex_number's slow path exactly, or a literal
  ;; and Number("<same digits>") round-trip to different f64 bits (toExponential()
  ;; no-arg then over-counts digits). Exact range: one mul/div by pow10; out of
  ;; range: step by *10 / /10 (keeps denormals representable, same rounding chain).
  (if (i32.ne (local.get $exp) (i32.const 0))
    (then
      (if (i32.and (i32.le_s (local.get $nd) (i32.const 15)) (i32.and (i32.ge_s (local.get $exp) (i32.const -22)) (i32.le_s (local.get $exp) (i32.const 22))))
        (then
          (if (i32.gt_s (local.get $exp) (i32.const 0))
            (then (set! $res (f64.mul (local.get $r) (call $pow10 (f64.convert_i32_s (local.get $exp))))))
            (else (set! $res (f64.div (local.get $r) (call $pow10 (f64.convert_i32_s (i32.sub (i32.const 0) (local.get $exp)))))))))
        (else
          (let $k i32 (if i32 (i32.lt_s (local.get $exp) (i32.const 0)) (then (i32.sub (i32.const 0) (local.get $exp))) (else (local.get $exp))))
          (let $neg i32 (i32.lt_s (local.get $exp) (i32.const 0)))
          (let $ei i32 (i32.const 0))
          (block $xe (loop $xl
            (br_if $xe (i32.ge_s (local.get $ei) (local.get $k)))
            (set! $res (if f64 (local.get $neg) (then (f64.div (local.get $res) (f64.const 10))) (else (f64.mul (local.get $res) (f64.const 10)))))
            (set! $ei (i32.add (local.get $ei) (i32.const 1)))
            (br $xl)))))))
  (f64.mul (local.get $sign) (local.get $res)))
