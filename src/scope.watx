;; ═══════════════════════════════════════════════════════════════
;; scope.watx — lexical environments (variable bindings)
;;
;; Scope layout:
;;   [parent:i32 @0][count:i32 @4][cap:i32 @8][pad:i32 @12]
;;   entries @16: each 16 bytes = [namePtr:i32][pad:i32][value:i64 @8]
;;
;; Names are heap Str pointers, compared by content (str_eq).
;; The current scope pointer lives in register GLOBAL (40); a chain of
;; parents reaches the global scope.
;; ═══════════════════════════════════════════════════════════════

(func $cur_scope (result i32) (effects) (i32.load (i32.const 40)))
(func $set_cur_scope (param $s i32) (effects) (i32.store (i32.const 40) (local.get $s)))

;; allocate a new scope with given parent and capacity for `cap` entries.
;; Header is 16 bytes [parent@0][count@4][cap@8][entriesPtr@12]; the entries
;; live in a SEPARATE block so they can be relocated on growth while the header
;; (and thus every pointer to the scope) stays valid.
(func $scope_new (param $parent i32) (param $cap i32) (result i32) (effects)
  (let $cp i32 (if i32 (i32.lt_s (local.get $cap) (i32.const 4)) (then (i32.const 4)) (else (local.get $cap))))
  (let $s i32 (call $heap_alloc (i32.const 16)))
  (i32.store (local.get $s) (local.get $parent))
  (i32.store (i32.add (local.get $s) (i32.const 4)) (i32.const 0))
  (i32.store (i32.add (local.get $s) (i32.const 8)) (local.get $cp))
  (i32.store (i32.add (local.get $s) (i32.const 12)) (call $heap_alloc (i32.mul (local.get $cp) (i32.const 16))))
  (local.get $s))

(func $scope_parent (param $s i32) (result i32) (effects) (i32.load (local.get $s)))
(func $scope_count (param $s i32) (result i32) (effects) (i32.load (i32.add (local.get $s) (i32.const 4))))
(func $scope_entry (param $s i32) (param $i i32) (result i32) (effects)
  (i32.add (i32.load (i32.add (local.get $s) (i32.const 12))) (i32.mul (local.get $i) (i32.const 16))))

;; ensure room for one more entry; double + relocate the entries block if full.
(func $scope_ensure (param $s i32) (effects)
  (let $cnt i32 (i32.load (i32.add (local.get $s) (i32.const 4))))
  (let $cap i32 (i32.load (i32.add (local.get $s) (i32.const 8))))
  (if (i32.ge_s (local.get $cnt) (local.get $cap))
    (then
      (let $ncap i32 (i32.mul (local.get $cap) (i32.const 2)))
      (let $old i32 (i32.load (i32.add (local.get $s) (i32.const 12))))
      (let $new i32 (call $heap_alloc (i32.mul (local.get $ncap) (i32.const 16))))
      (let $bytes i32 (i32.mul (local.get $cnt) (i32.const 16)))
      (let $k i32 (i32.const 0))
      (block $e (loop $l
        (br_if $e (i32.ge_s (local.get $k) (local.get $bytes)))
        (i32.store (i32.add (local.get $new) (local.get $k)) (i32.load (i32.add (local.get $old) (local.get $k))))
        (set! $k (i32.add (local.get $k) (i32.const 4)))
        (br $l)))
      (i32.store (i32.add (local.get $s) (i32.const 8)) (local.get $ncap))
      (i32.store (i32.add (local.get $s) (i32.const 12)) (local.get $new)))))

;; find the value-slot pointer for `name` within scope `s` only (not parents);
;; returns 0 if absent.
(func $scope_find_local (param $s i32) (param $name i32) (result i32) (effects)
  (let $n i32 (call $scope_count (local.get $s)))
  (let $i i32 (i32.const 0))
  (let $found i32 (i32.const 0))
  (block $brk (loop $cont
    (br_if $brk (i32.ge_s (local.get $i) (local.get $n)))
    (let $e i32 (call $scope_entry (local.get $s) (local.get $i)))
    (if (call $str_eq (i32.load (local.get $e)) (local.get $name))
      (then (set! $found (i32.add (local.get $e) (i32.const 8))) (br $brk)))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $cont)))
  (local.get $found))

;; find value-slot for `name` walking up the scope chain; 0 if unbound.
(func $scope_find (param $s i32) (param $name i32) (result i32) (effects)
  (let $cur i32 (local.get $s))
  (let $slot i32 (i32.const 0))
  (block $brk (loop $cont
    (br_if $brk (i32.eqz (local.get $cur)))
    (set! $slot (call $scope_find_local (local.get $cur) (local.get $name)))
    (br_if $brk (local.get $slot))
    (set! $cur (call $scope_parent (local.get $cur)))
    (br $cont)))
  (local.get $slot))

;; set just the getter (isGet=1) or setter (isGet=0) of `name`, merging with an
;; existing accessor (so separate get/set definitions combine).
(func $scope_set_accessor (param $s i32) (param $name i32) (param $isGet i32) (param $fn i64) (effects)
  (let $slot i32 (call $scope_find_local (local.get $s) (local.get $name)))
  (if (local.get $slot)
    (then
      (if (call $entry_is_accessor (local.get $slot))
        (then  ;; update existing accessor cell in place
          (let $cell i32 (i32.wrap_i64 (i64.load (local.get $slot))))
          (i64.store (i32.add (local.get $cell) (if i32 (local.get $isGet) (then (i32.const 0)) (else (i32.const 8)))) (local.get $fn))
          (return)))))
  ;; otherwise create a fresh accessor
  (call $scope_define_accessor (local.get $s) (local.get $name)
    (if i64 (local.get $isGet) (then (local.get $fn)) (else (call $v_undef)))
    (if i64 (local.get $isGet) (then (call $v_undef)) (else (local.get $fn)))))

;; delete `name` from scope `s` (own only). Returns 1 if it was present.
(func $scope_delete (param $s i32) (param $name i32) (result i32) (effects)
  (let $n i32 (call $scope_count (local.get $s)))
  (let $i i32 (i32.const 0))
  (block $brk (loop $cont
    (br_if $brk (i32.ge_s (local.get $i) (local.get $n)))
    (if (call $str_eq (i32.load (call $scope_entry (local.get $s) (local.get $i))) (local.get $name))
      (then
        (let $j i32 (local.get $i))
        (block $se (loop $sl
          (br_if $se (i32.ge_s (i32.add (local.get $j) (i32.const 1)) (local.get $n)))
          (let $dst i32 (call $scope_entry (local.get $s) (local.get $j)))
          (let $src i32 (call $scope_entry (local.get $s) (i32.add (local.get $j) (i32.const 1))))
          (i32.store (local.get $dst) (i32.load (local.get $src)))
          (i64.store (i32.add (local.get $dst) (i32.const 8)) (i64.load (i32.add (local.get $src) (i32.const 8))))
          (set! $j (i32.add (local.get $j) (i32.const 1)))
          (br $sl)))
        (i32.store (i32.add (local.get $s) (i32.const 4)) (i32.sub (local.get $n) (i32.const 1)))
        (return (i32.const 1))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $cont)))
  (i32.const 0))

;; Entry layout: [namePtr:i32 @0][kind:i32 @4][value:i64 @8] (16 bytes).
;; kind is a bitfield: bit0 = accessor (value = ptr to [get:i64][set:i64]);
;; bit1 = enumerable; bit2 = configurable; bit3 = writable (data only).
;; The value slot returned by scope_find* is entry+8, so the kind flag is at slot-4.
;; Data default = E|C|W = 14; accessor default = ACC|E|C = 7.
(func $entry_kind (param $slot i32) (result i32) (effects) (i32.load (i32.sub (local.get $slot) (i32.const 4))))
(func $entry_is_accessor (param $slot i32) (result i32) (effects) (i32.and (call $entry_kind (local.get $slot)) (i32.const 1)))
(func $entry_enumerable (param $slot i32) (result i32) (effects) (i32.and (call $entry_kind (local.get $slot)) (i32.const 2)))
(func $entry_configurable (param $slot i32) (result i32) (effects) (i32.and (call $entry_kind (local.get $slot)) (i32.const 4)))
(func $entry_writable (param $slot i32) (result i32) (effects) (i32.and (call $entry_kind (local.get $slot)) (i32.const 8)))

;; define (or overwrite) data `name`=`val` in scope `s` (default attrs E|C|W).
(func $scope_define (param $s i32) (param $name i32) (param $val i64) (effects)
  (let $slot i32 (call $scope_find_local (local.get $s) (local.get $name)))
  (if (local.get $slot)
    (then
      ;; overwriting an accessor with data → reset to default data attrs;
      ;; overwriting an existing data prop preserves its attributes.
      (if (call $entry_is_accessor (local.get $slot)) (then (i32.store (i32.sub (local.get $slot) (i32.const 4)) (i32.const 14))))
      (i64.store (local.get $slot) (local.get $val)))
    (else
      (call $scope_ensure (local.get $s))
      (let $i i32 (call $scope_count (local.get $s)))
      (let $e i32 (call $scope_entry (local.get $s) (local.get $i)))
      (i32.store (local.get $e) (local.get $name))
      (i32.store (i32.add (local.get $e) (i32.const 4)) (i32.const 14))  ;; data E|C|W
      (i64.store (i32.add (local.get $e) (i32.const 8)) (local.get $val))
      (i32.store (i32.add (local.get $s) (i32.const 4)) (i32.add (local.get $i) (i32.const 1))))))

;; define data `name`=`val` with explicit attribute bits (E=2,C=4,W=8) — for
;; Object.defineProperty. Always forces a data property with exactly `attrs`.
(func $scope_define_attr (param $s i32) (param $name i32) (param $val i64) (param $attrs i32) (effects)
  (let $slot i32 (call $scope_find_local (local.get $s) (local.get $name)))
  (if (local.get $slot)
    (then (i32.store (i32.sub (local.get $slot) (i32.const 4)) (i32.and (local.get $attrs) (i32.const 14))) (i64.store (local.get $slot) (local.get $val)))
    (else
      (call $scope_ensure (local.get $s))
      (let $i i32 (call $scope_count (local.get $s)))
      (let $e i32 (call $scope_entry (local.get $s) (local.get $i)))
      (i32.store (local.get $e) (local.get $name))
      (i32.store (i32.add (local.get $e) (i32.const 4)) (i32.and (local.get $attrs) (i32.const 14)))
      (i64.store (i32.add (local.get $e) (i32.const 8)) (local.get $val))
      (i32.store (i32.add (local.get $s) (i32.const 4)) (i32.add (local.get $i) (i32.const 1))))))

;; clear the enumerable bit on EVERY own property of scope `s` — used to make
;; built-in objects/prototypes non-enumerable (spec: builtins are DontEnum).
(func $scope_clear_enum (param $s i32) (effects)
  (if (i32.eqz (local.get $s)) (then (return)))
  (let $n i32 (call $scope_count (local.get $s)))
  (let $i i32 (i32.const 0))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    (let $k i32 (i32.add (call $scope_entry (local.get $s) (local.get $i)) (i32.const 4)))
    (i32.store (local.get $k) (i32.and (i32.load (local.get $k)) (i32.const -3)))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l))))

;; define an accessor property (getter/setter) on scope `s` (default attrs ACC|E|C).
(func $scope_define_accessor (param $s i32) (param $name i32) (param $get i64) (param $set i64) (effects)
  (call $scope_define_accessor_attr (local.get $s) (local.get $name) (local.get $get) (local.get $set) (i32.const 7)))

;; define an accessor with explicit attribute bits (must include bit0=accessor).
(func $scope_define_accessor_attr (param $s i32) (param $name i32) (param $get i64) (param $set i64) (param $attrs i32) (effects)
  (let $cell i32 (call $heap_alloc (i32.const 16)))
  (i64.store (local.get $cell) (local.get $get))
  (i64.store (i32.add (local.get $cell) (i32.const 8)) (local.get $set))
  (let $kind i32 (i32.or (local.get $attrs) (i32.const 1)))
  (let $slot i32 (call $scope_find_local (local.get $s) (local.get $name)))
  (if (local.get $slot)
    (then (i32.store (i32.sub (local.get $slot) (i32.const 4)) (local.get $kind)) (i64.store (local.get $slot) (i64.extend_i32_u (local.get $cell))))
    (else
      (call $scope_ensure (local.get $s))
      (let $i i32 (call $scope_count (local.get $s)))
      (let $e i32 (call $scope_entry (local.get $s) (local.get $i)))
      (i32.store (local.get $e) (local.get $name))
      (i32.store (i32.add (local.get $e) (i32.const 4)) (local.get $kind))
      (i64.store (i32.add (local.get $e) (i32.const 8)) (i64.extend_i32_u (local.get $cell)))
      (i32.store (i32.add (local.get $s) (i32.const 4)) (i32.add (local.get $i) (i32.const 1))))))
