;; ═══════════════════════════════════════════════════════════════
;; scope.watx — lexical environments (variable bindings)
;;
;; Scope layout:
;;   [parent:i32 @0][count:i32 @4][cap:i32 @8][pad:i32 @12]
;;   entries @16: each 16 bytes = [namePtr:i32][pad:i32][value:i64 @8]
;;
;; Names are heap Str pointers, compared by content (str_eq).
;; The current scope pointer lives in register GLOBAL (40); a chain of
;; parents reaches the global scope.
;; ═══════════════════════════════════════════════════════════════

(func $cur_scope (result i32) (effects) (i32.load (i32.const 40)))
(func $set_cur_scope (param $s i32) (effects) (i32.store (i32.const 40) (local.get $s)))

;; allocate a new scope with given parent and capacity for `cap` entries
(func $scope_new (param $parent i32) (param $cap i32) (result i32) (effects)
  (let $s i32 (call $heap_alloc (i32.add (i32.const 16) (i32.mul (local.get $cap) (i32.const 16)))))
  (i32.store (local.get $s) (local.get $parent))
  (i32.store (i32.add (local.get $s) (i32.const 4)) (i32.const 0))
  (i32.store (i32.add (local.get $s) (i32.const 8)) (local.get $cap))
  (local.get $s))

(func $scope_parent (param $s i32) (result i32) (effects) (i32.load (local.get $s)))
(func $scope_count (param $s i32) (result i32) (effects) (i32.load (i32.add (local.get $s) (i32.const 4))))
(func $scope_entry (param $s i32) (param $i i32) (result i32) (effects)
  (i32.add (i32.add (local.get $s) (i32.const 16)) (i32.mul (local.get $i) (i32.const 16))))

;; find the value-slot pointer for `name` within scope `s` only (not parents);
;; returns 0 if absent.
(func $scope_find_local (param $s i32) (param $name i32) (result i32) (effects)
  (let $n i32 (call $scope_count (local.get $s)))
  (let $i i32 (i32.const 0))
  (let $found i32 (i32.const 0))
  (block $brk (loop $cont
    (br_if $brk (i32.ge_s (local.get $i) (local.get $n)))
    (let $e i32 (call $scope_entry (local.get $s) (local.get $i)))
    (if (call $str_eq (i32.load (local.get $e)) (local.get $name))
      (then (set! $found (i32.add (local.get $e) (i32.const 8))) (br $brk)))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $cont)))
  (local.get $found))

;; find value-slot for `name` walking up the scope chain; 0 if unbound.
(func $scope_find (param $s i32) (param $name i32) (result i32) (effects)
  (let $cur i32 (local.get $s))
  (let $slot i32 (i32.const 0))
  (block $brk (loop $cont
    (br_if $brk (i32.eqz (local.get $cur)))
    (set! $slot (call $scope_find_local (local.get $cur) (local.get $name)))
    (br_if $brk (local.get $slot))
    (set! $cur (call $scope_parent (local.get $cur)))
    (br $cont)))
  (local.get $slot))

;; define (or overwrite) `name`=`val` in scope `s`. Grows by linear append;
;; assumes capacity is sufficient (scopes are sized generously).
(func $scope_define (param $s i32) (param $name i32) (param $val i64) (effects)
  (let $slot i32 (call $scope_find_local (local.get $s) (local.get $name)))
  (if (local.get $slot)
    (then (i64.store (local.get $slot) (local.get $val)))
    (else
      (let $i i32 (call $scope_count (local.get $s)))
      (let $e i32 (call $scope_entry (local.get $s) (local.get $i)))
      (i32.store (local.get $e) (local.get $name))
      (i64.store (i32.add (local.get $e) (i32.const 8)) (local.get $val))
      (i32.store (i32.add (local.get $s) (i32.const 4)) (i32.add (local.get $i) (i32.const 1))))))
