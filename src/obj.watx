;; ═══════════════════════════════════════════════════════════════
;; obj.watx — objects and arrays
;;
;; Object = a parentless "scope" (property map): reuses scope_new /
;;   scope_find_local / scope_define. Value tag 5.
;; Array  = [length:i32 @0][cap:i32 @4][pad @8..15][elements: i64 @16].
;;   Value tag 7.
;;
;; get_prop/set_prop dispatch on the container's type. Property keys are
;; coerced to strings (objects) or integers (array indices).
;; ═══════════════════════════════════════════════════════════════

(func $is_array (param $v i64) (result i32) (effects)
  (i32.and (i32.eqz (call $is_number (local.get $v)))
           (i32.eq (call $val_tag (local.get $v)) (i32.const 7))))
(func $mk_arr (param $ptr i32) (result i64) (effects) (call $box (i32.const 7) (local.get $ptr)))

;; --- objects ---
;; new object — its [[Prototype]] is Object.prototype (reg 328; 0 during early
;; setup before Object.prototype exists, and for Object.prototype itself).
(func $obj_new (param $cap i32) (result i32) (effects) (call $scope_new (i32.load (i32.const 328)) (local.get $cap)))

;; --- arrays --- header [length:i32 @0][cap:i32 @4][data:i32 @8]; data block separate (growable)
(func $arr_new (param $cap i32) (result i32) (effects)
  (if (i32.lt_s (local.get $cap) (i32.const 4)) (then (set! $cap (i32.const 4))))
  (let $a i32 (call $heap_alloc (i32.const 16)))
  (i32.store (local.get $a) (i32.const 0))                       ;; length
  (i32.store (i32.add (local.get $a) (i32.const 4)) (local.get $cap))
  (i32.store (i32.add (local.get $a) (i32.const 8)) (call $heap_alloc (i32.mul (local.get $cap) (i32.const 8))))
  (i32.store (i32.add (local.get $a) (i32.const 12)) (i32.const 0))  ;; @12 named-property scope (lazy, 0 = none)
  (local.get $a))

;; Canonical array index encoded in a string ("0".."2147483647", no leading
;; zeros, no sign/dot) → that index, else -1. (Indices >= 2^31 exceed our i32
;; element addressing and are treated as named properties.)
(func $str_array_index (param $ks i32) (result i32) (effects)
  (let $n i32 (call $str_len (local.get $ks)))
  (if (i32.eqz (local.get $n)) (then (return (i32.const -1))))
  (if (i32.and (i32.gt_s (local.get $n) (i32.const 1)) (i32.eq (call $str_byte (local.get $ks) (i32.const 0)) (i32.const 48))) (then (return (i32.const -1))))  ;; leading zero
  (let $i i32 (i32.const 0))
  (block $b (loop $l
    (br_if $b (i32.ge_s (local.get $i) (local.get $n)))
    (let $c i32 (call $str_byte (local.get $ks) (local.get $i)))
    (if (i32.or (i32.lt_s (local.get $c) (i32.const 48)) (i32.gt_s (local.get $c) (i32.const 57))) (then (return (i32.const -1))))
    (set! $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
  (if (i32.gt_s (local.get $n) (i32.const 10)) (then (return (i32.const -1))))  ;; > 10 digits can't be < 2^31
  (let $v f64 (call $str_to_num (local.get $ks)))
  (if (f64.ge (local.get $v) (f64.const 2147483648)) (then (return (i32.const -1))))
  (i32.trunc_f64_s (local.get $v)))

;; get-or-create an array's named-property scope (for non-index keys like
;; a.foo or a[2**32-1]; element storage stays in the @8 data block)
(func $arr_props (param $a i32) (result i32) (effects)
  (let $p i32 (i32.load (i32.add (local.get $a) (i32.const 12))))
  (if i32 (local.get $p) (then (local.get $p))
    (else
      (let $np i32 (call $scope_new (i32.const 0) (i32.const 8)))
      (i32.store (i32.add (local.get $a) (i32.const 12)) (local.get $np))
      (local.get $np))))
(func $arr_len (param $a i32) (result i32) (effects) (i32.load (local.get $a)))
(func $arr_cap (param $a i32) (result i32) (effects) (i32.load (i32.add (local.get $a) (i32.const 4))))
(func $arr_data (param $a i32) (result i32) (effects) (i32.load (i32.add (local.get $a) (i32.const 8))))
(func $arr_slot (param $a i32) (param $i i32) (result i32) (effects)
  (i32.add (call $arr_data (local.get $a)) (i32.mul (local.get $i) (i32.const 8))))
(func $arr_grow (param $a i32) (param $mincap i32) (effects)
  (let $nc i32 (i32.mul (call $arr_cap (local.get $a)) (i32.const 2)))
  (if (i32.lt_s (local.get $nc) (local.get $mincap)) (then (set! $nc (local.get $mincap))))
  (let $nd i32 (call $heap_alloc (i32.mul (local.get $nc) (i32.const 8))))
  (let $od i32 (call $arr_data (local.get $a)))
  (let $i i32 (i32.const 0))
  (let $n i32 (call $arr_len (local.get $a)))
  (block $brk (loop $cont
    (br_if $brk (i32.ge_s (local.get $i) (local.get $n)))
    (i64.store (i32.add (local.get $nd) (i32.mul (local.get $i) (i32.const 8))) (i64.load (i32.add (local.get $od) (i32.mul (local.get $i) (i32.const 8)))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $cont)))
  (i32.store (i32.add (local.get $a) (i32.const 4)) (local.get $nc))
  (i32.store (i32.add (local.get $a) (i32.const 8)) (local.get $nd)))
;; 1 if dense-hole index $i is actually a "deopted" accessor index parked in @12.
(func $arr_idx_deopted (param $a i32) (param $i i32) (result i32) (effects)
  (let $p i32 (i32.load (i32.add (local.get $a) (i32.const 12))))
  (if (i32.eqz (local.get $p)) (then (return (i32.const 0))))
  (i32.ne (call $scope_find_local (local.get $p) (call $num_to_str (f64.convert_i32_s (local.get $i)))) (i32.const 0)))
;; value of a deopted accessor/data index in @12 (invokes the getter); v_hole if
;; the index is NOT deopted (caller then treats it as a genuine hole → undefined).
(func $arr_hole_deopt (param $a i32) (param $i i32) (result i64) (effects)
  (let $p i32 (i32.load (i32.add (local.get $a) (i32.const 12))))
  (if (i32.eqz (local.get $p)) (then (return (call $v_hole))))
  (let $slot i32 (call $scope_find_local (local.get $p) (call $num_to_str (f64.convert_i32_s (local.get $i)))))
  (if (i32.eqz (local.get $slot)) (then (return (call $v_hole))))
  (if (call $entry_is_accessor (local.get $slot))
    (then
      (let $g i64 (i64.load (call $val_payload (i64.load (local.get $slot)))))
      (if (call $is_function (local.get $g)) (then (return (call $call_fn0 (local.get $g) (call $mk_arr (local.get $a))))))
      (return (call $v_undef))))
  (i64.load (local.get $slot)))
(func $arr_get (param $a i32) (param $i i32) (result i64) (effects)
  (if (i32.or (i32.lt_s (local.get $i) (i32.const 0)) (i32.ge_s (local.get $i) (call $arr_len (local.get $a)))) (then (return (call $v_undef))))
  (let $e i64 (i64.load (call $arr_slot (local.get $a) (local.get $i))))
  (if (call $is_hole (local.get $e))
    (then  ;; a hole reads as undefined — unless it's a deopted accessor/data index
      (let $d i64 (call $arr_hole_deopt (local.get $a) (local.get $i)))
      (if (call $is_hole (local.get $d)) (then (return (call $v_undef))))
      (return (local.get $d))))
  (local.get $e))
;; 1 if index $i is a present (non-hole, in-bounds) element
(func $arr_has (param $a i32) (param $i i32) (result i32) (effects)
  (if (i32.or (i32.lt_s (local.get $i) (i32.const 0)) (i32.ge_s (local.get $i) (call $arr_len (local.get $a)))) (then (return (i32.const 0))))
  (if (i32.eqz (call $is_hole (i64.load (call $arr_slot (local.get $a) (local.get $i))))) (then (return (i32.const 1))))
  (call $arr_idx_deopted (local.get $a) (local.get $i)))
(func $arr_set (param $a i32) (param $i i32) (param $v i64) (effects)
  (if (i32.lt_s (local.get $i) (i32.const 0)) (then (return)))
  (if (i32.ge_s (local.get $i) (call $arr_cap (local.get $a))) (then (call $arr_grow (local.get $a) (i32.add (local.get $i) (i32.const 1)))))
  ;; writing past the end leaves a gap → fill it with holes (sparse), not garbage
  (if (i32.gt_s (local.get $i) (call $arr_len (local.get $a)))
    (then
      (let $g i32 (call $arr_len (local.get $a)))
      (block $ge (loop $gl
        (br_if $ge (i32.ge_s (local.get $g) (local.get $i)))
        (i64.store (call $arr_slot (local.get $a) (local.get $g)) (call $v_hole))
        (set! $g (i32.add (local.get $g) (i32.const 1))) (br $gl)))))
  (i64.store (call $arr_slot (local.get $a) (local.get $i)) (local.get $v))
  (if (i32.ge_s (local.get $i) (call $arr_len (local.get $a)))
    (then (i32.store (local.get $a) (i32.add (local.get $i) (i32.const 1))))))
(func $arr_push (param $a i32) (param $v i64) (effects)
  (call $arr_set (local.get $a) (call $arr_len (local.get $a)) (local.get $v)))
;; set the array length to $n: truncate (drop the tail) or extend (with holes).
(func $arr_set_length (param $a i32) (param $n i32) (effects)
  (let $cur i32 (call $arr_len (local.get $a)))
  (if (i32.lt_s (local.get $n) (local.get $cur))
    (then (i32.store (local.get $a) (local.get $n)))  ;; truncate
    (else (if (i32.gt_s (local.get $n) (local.get $cur))
      (then
        (if (i32.gt_s (local.get $n) (call $arr_cap (local.get $a))) (then (call $arr_grow (local.get $a) (local.get $n))))
        (let $g i32 (local.get $cur))
        (block $e (loop $l
          (br_if $e (i32.ge_s (local.get $g) (local.get $n)))
          (i64.store (call $arr_slot (local.get $a) (local.get $g)) (call $v_hole))
          (set! $g (i32.add (local.get $g) (i32.const 1))) (br $l)))
        (i32.store (local.get $a) (local.get $n)))))))
;; remove element at index $i, shifting the tail down; decrements length
(func $arr_remove (param $a i32) (param $i i32) (effects)
  (let $n i32 (call $arr_len (local.get $a)))
  (let $j i32 (local.get $i))
  (block $e (loop $l
    (br_if $e (i32.ge_s (i32.add (local.get $j) (i32.const 1)) (local.get $n)))
    (i64.store (call $arr_slot (local.get $a) (local.get $j)) (i64.load (call $arr_slot (local.get $a) (i32.add (local.get $j) (i32.const 1)))))
    (set! $j (i32.add (local.get $j) (i32.const 1)))
    (br $l)))
  (if (i32.gt_s (local.get $n) (i32.const 0)) (then (i32.store (local.get $a) (i32.sub (local.get $n) (i32.const 1))))))
;; append elements of $src to $dest, recursing into nested arrays while depth>0
;; FlattenIntoArray: add each non-hole element of `src` to `target` via CreateDataPropertyOrThrow
;; (so a non-extensible / frozen species-created target throws TypeError), recursing into nested
;; arrays up to `depth`. `idxptr` is a heap cell holding the running write index (shared across the
;; recursion so nested flattening keeps appending). Stops on the first abrupt CreateDataProperty.
(func $arr_flatten (param $src i32) (param $target i64) (param $depth i32) (param $idxptr i32) (effects)
  (let $i i32 (i32.const 0))
  (let $n i32 (call $arr_len (local.get $src)))
  (block $e (loop $l
    (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
    (br_if $e (call $err))  ;; a prior CreateDataPropertyOrThrow threw → stop
    (if (call $arr_has (local.get $src) (local.get $i))  ;; flat skips holes (HasProperty)
      (then
        (let $el i64 (call $arr_get (local.get $src) (local.get $i)))
        (if (i32.and (i32.gt_s (local.get $depth) (i32.const 0)) (call $is_array (local.get $el)))
          (then (call $arr_flatten (call $val_payload (local.get $el)) (local.get $target) (i32.sub (local.get $depth) (i32.const 1)) (local.get $idxptr)))
          (else
            (call $cdp_throw (local.get $target) (i32.load (local.get $idxptr)) (local.get $el))
            (i32.store (local.get $idxptr) (i32.add (i32.load (local.get $idxptr)) (i32.const 1)))))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $l))))

;; one-character string from byte index of a string object
;; UTF-8 code-point byte length from a lead byte (1 for ASCII/continuation, 2/3/4 for multi-byte).
;; String ITERATION (for-of / spread / @@iterator) yields code points, so it advances by this.
(func $str_cp_len (param $b i32) (result i32) (effects)
  (if i32 (i32.lt_u (local.get $b) (i32.const 0xC0)) (then (i32.const 1))       ;; ASCII or a stray continuation byte
    (else (if i32 (i32.lt_u (local.get $b) (i32.const 0xE0)) (then (i32.const 2))
      (else (if i32 (i32.lt_u (local.get $b) (i32.const 0xF0)) (then (i32.const 3))
        (else (i32.const 4))))))))
;; the code-point CHARACTER (a string of its 1-4 UTF-8 bytes) at byte index $i.
(func $str_cp_at (param $s i32) (param $i i32) (result i64) (effects)
  (let $cl i32 (call $str_cp_len (call $str_byte (local.get $s) (local.get $i))))
  (if (i32.gt_s (i32.add (local.get $i) (local.get $cl)) (call $str_len (local.get $s)))
    (then (set! $cl (i32.sub (call $str_len (local.get $s)) (local.get $i)))))  ;; clamp a truncated trailing sequence
  (call $mk_str (call $substr (local.get $s) (local.get $i) (local.get $cl))))
(func $str_char_at (param $s i32) (param $i i32) (result i64) (effects)
  (if i64 (i32.and (i32.ge_s (local.get $i) (i32.const 0)) (i32.lt_s (local.get $i) (call $str_len (local.get $s))))
    (then
      (let $c i32 (call $str_alloc (i32.const 1)))
      (call $str_set_byte (local.get $c) (i32.const 0) (call $str_byte (local.get $s) (local.get $i)))
      (call $mk_str (local.get $c)))
    (else (call $v_undef))))

;; substring: copy `len` bytes of string `s` starting at byte `start`
(func $substr (param $s i32) (param $start i32) (param $len i32) (result i32) (effects)
  (if (i32.lt_s (local.get $len) (i32.const 0)) (then (set! $len (i32.const 0))))
  (let $p i32 (call $str_alloc (local.get $len)))
  (let $i i32 (i32.const 0))
  (block $brk (loop $cont
    (br_if $brk (i32.ge_s (local.get $i) (local.get $len)))
    (call $str_set_byte (local.get $p) (local.get $i) (call $str_byte (local.get $s) (i32.add (local.get $start) (local.get $i))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $cont)))
  (local.get $p))

;; index of `needle` in `hay`, or -1
(func $str_indexof (param $hay i32) (param $needle i32) (result i32) (effects)
  (let $hl i32 (call $str_len (local.get $hay)))
  (let $nl i32 (call $str_len (local.get $needle)))
  (if (i32.eqz (local.get $nl)) (then (return (i32.const 0))))
  (let $i i32 (i32.const 0))
  (let $last i32 (i32.add (i32.sub (local.get $hl) (local.get $nl)) (i32.const 1)))
  (block $brk (loop $cont
    (br_if $brk (i32.ge_s (local.get $i) (local.get $last)))
    (let $j i32 (i32.const 0))
    (let $ok i32 (i32.const 1))
    (block $mb (loop $ml
      (br_if $mb (i32.ge_s (local.get $j) (local.get $nl)))
      (if (i32.ne (call $str_byte (local.get $hay) (i32.add (local.get $i) (local.get $j))) (call $str_byte (local.get $needle) (local.get $j)))
        (then (set! $ok (i32.const 0)) (br $mb)))
      (set! $j (i32.add (local.get $j) (i32.const 1)))
      (br $ml)))
    (if (local.get $ok) (then (return (local.get $i))))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $cont)))
  (i32.const -1))

;; ASCII case conversion (upper=1 to upper, else to lower)
(func $str_case (param $s i32) (param $upper i32) (result i32) (effects)
  (let $n i32 (call $str_len (local.get $s)))
  (let $p i32 (call $str_alloc (local.get $n)))
  (let $i i32 (i32.const 0))
  (block $brk (loop $cont
    (br_if $brk (i32.ge_s (local.get $i) (local.get $n)))
    (let $c i32 (call $str_byte (local.get $s) (local.get $i)))
    (if (local.get $upper)
      (then (if (i32.and (i32.ge_s (local.get $c) (i32.const 97)) (i32.le_s (local.get $c) (i32.const 122))) (then (set! $c (i32.sub (local.get $c) (i32.const 32))))))
      (else (if (i32.and (i32.ge_s (local.get $c) (i32.const 65)) (i32.le_s (local.get $c) (i32.const 90))) (then (set! $c (i32.add (local.get $c) (i32.const 32)))))))
    (call $str_set_byte (local.get $p) (local.get $i) (local.get $c))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $cont)))
  (local.get $p))

;; trim ASCII whitespace from both ends
;; byte-length (1/2/3) of a JS WhiteSpace/LineTerminator char starting at byte $i,
;; else 0. Covers ASCII (\t\n\v\f\r space) + UTF-8 NBSP(C2A0),  ,  -200A,
;;  /9,  ,  , 　, BOM ﻿.
(func $ws_fwd_len (param $s i32) (param $i i32) (result i32) (effects)
  (let $c i32 (call $str_byte (local.get $s) (local.get $i)))
  (if (i32.or (i32.and (i32.ge_s (local.get $c) (i32.const 9)) (i32.le_s (local.get $c) (i32.const 13))) (i32.eq (local.get $c) (i32.const 32))) (then (return (i32.const 1))))
  (if (i32.and (i32.eq (local.get $c) (i32.const 194)) (i32.eq (call $str_byte (local.get $s) (i32.add (local.get $i) (i32.const 1))) (i32.const 160))) (then (return (i32.const 2))))  ;; C2 A0
  (if (i32.eq (local.get $c) (i32.const 225))  ;; E1 9A 80 = U+1680
    (then (if (i32.and (i32.eq (call $str_byte (local.get $s) (i32.add (local.get $i) (i32.const 1))) (i32.const 154)) (i32.eq (call $str_byte (local.get $s) (i32.add (local.get $i) (i32.const 2))) (i32.const 128))) (then (return (i32.const 3))))))
  (if (i32.eq (local.get $c) (i32.const 226))  ;; E2 8x xx
    (then
      (let $b1 i32 (call $str_byte (local.get $s) (i32.add (local.get $i) (i32.const 1))))
      (let $b2 i32 (call $str_byte (local.get $s) (i32.add (local.get $i) (i32.const 2))))
      (if (i32.eq (local.get $b1) (i32.const 128))  ;; E2 80 xx
        (then (if (i32.or (i32.and (i32.ge_s (local.get $b2) (i32.const 128)) (i32.le_s (local.get $b2) (i32.const 138))) (i32.or (i32.eq (local.get $b2) (i32.const 168)) (i32.or (i32.eq (local.get $b2) (i32.const 169)) (i32.eq (local.get $b2) (i32.const 175))))) (then (return (i32.const 3))))))  ;; 2000-200A, 2028, 2029, 202F
      (if (i32.and (i32.eq (local.get $b1) (i32.const 129)) (i32.eq (local.get $b2) (i32.const 159))) (then (return (i32.const 3))))))  ;; E2 81 9F = U+205F
  (if (i32.eq (local.get $c) (i32.const 227))  ;; E3 80 80 = U+3000
    (then (if (i32.and (i32.eq (call $str_byte (local.get $s) (i32.add (local.get $i) (i32.const 1))) (i32.const 128)) (i32.eq (call $str_byte (local.get $s) (i32.add (local.get $i) (i32.const 2))) (i32.const 128))) (then (return (i32.const 3))))))
  (if (i32.eq (local.get $c) (i32.const 239))  ;; EF BB BF = U+FEFF (BOM)
    (then (if (i32.and (i32.eq (call $str_byte (local.get $s) (i32.add (local.get $i) (i32.const 1))) (i32.const 187)) (i32.eq (call $str_byte (local.get $s) (i32.add (local.get $i) (i32.const 2))) (i32.const 191))) (then (return (i32.const 3))))))
  (i32.const 0))
;; byte-length of a whitespace char ENDING at byte $b (i.e. just before $b), else 0.
(func $ws_bwd_len (param $s i32) (param $b i32) (result i32) (effects)
  (if (i32.le_s (local.get $b) (i32.const 0)) (then (return (i32.const 0))))
  (let $last i32 (call $str_byte (local.get $s) (i32.sub (local.get $b) (i32.const 1))))
  (if (i32.lt_s (local.get $last) (i32.const 128)) (then (return (call $ws_fwd_len (local.get $s) (i32.sub (local.get $b) (i32.const 1))))))  ;; ASCII
  ;; multibyte: walk back over continuation bytes (0x80-0xBF) to the lead byte
  (let $st i32 (i32.sub (local.get $b) (i32.const 1)))
  (block $we (loop $wl
    (br_if $we (i32.le_s (local.get $st) (i32.const 0)))
    (br_if $we (i32.ge_s (call $str_byte (local.get $s) (local.get $st)) (i32.const 192)))  ;; found lead byte (>=0xC0) → stop
    (set! $st (i32.sub (local.get $st) (i32.const 1)))  ;; continuation byte → keep walking back
    (br $wl)))
  (let $w i32 (call $ws_fwd_len (local.get $s) (local.get $st)))
  (if (i32.eq (i32.add (local.get $st) (local.get $w)) (local.get $b)) (then (return (local.get $w))))
  (i32.const 0))
(func $str_trim (param $s i32) (result i32) (effects)
  (let $n i32 (call $str_len (local.get $s)))
  (let $a i32 (i32.const 0))
  (let $b i32 (local.get $n))
  (block $l1 (loop $c1
    (br_if $l1 (i32.ge_s (local.get $a) (local.get $b)))
    (let $w i32 (call $ws_fwd_len (local.get $s) (local.get $a)))
    (br_if $l1 (i32.eqz (local.get $w)))
    (set! $a (i32.add (local.get $a) (local.get $w))) (br $c1)))
  (block $l2 (loop $c2
    (br_if $l2 (i32.le_s (local.get $b) (local.get $a)))
    (let $w2 i32 (call $ws_bwd_len (local.get $s) (local.get $b)))
    (br_if $l2 (i32.eqz (local.get $w2)))
    (set! $b (i32.sub (local.get $b) (local.get $w2))) (br $c2)))
