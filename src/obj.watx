    (then
      (let $sfn i32 (call $val_payload (local.get $cont)))
      ;; VM function: own/static props go into its @16 prototype scope (allocate one if absent)
      (if (i32.and (i32.ge_s (i32.load (local.get $sfn)) (i32.const 1448232526)) (i32.le_s (i32.load (local.get $sfn)) (i32.const 1448232528)))
        (then
          ;; assigning `.prototype` REPLACES the prototype object (@16), so new
