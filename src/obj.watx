              (i64.store (local.get $gbuf) (local.get $ptgt))
              (i64.store (i32.add (local.get $gbuf) (i32.const 8)) (call $mk_str (call $to_prop_key (local.get $key))))
              (i64.store (i32.add (local.get $gbuf) (i32.const 16)) (local.get $cont))
              (return (call $call_val (local.get $gtrap) (i32.const 3) (local.get $gbuf) (call $v_undef)))))
