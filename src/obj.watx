  ;; configurable). Only NATIVE fns have a @12 props scope; for VM fns @12 is
  ;; the code pointer, so never deref it as a scope here.
  (if (call $str_eq (local.get $ks) (cstring "length"))
    (then
      (if (i32.eqz (i32.and (i32.ge_s (i32.load (local.get $fn)) (i32.const 1448232526)) (i32.le_s (i32.load (local.get $fn)) (i32.const 1448232528))))
        (then
          (let $lp i32 (i32.load (i32.add (local.get $fn) (i32.const 12))))
          (if (local.get $lp) (then (if (call $scope_find_local (local.get $lp) (cstring "@@dellen")) (then (return (i32.const 0))))))))
      (return (i32.const 1))))
