      (if (call $str_eq (local.get $akey) (cstring "propertyIsEnumerable")) (then (return (call $mk_native (i32.const 159) (cstring "propertyIsEnumerable")))))
      (if (call $str_eq (local.get $akey) (cstring "toString")) (then (return (call $mk_native (i32.const 23) (cstring "toString")))))  ;; Array#toString = join
