      (if (local.get $ap)
        (then
          (let $slot i32 (call $scope_find_local (local.get $ap) (local.get $akey)))
          (if (local.get $slot) (then (return (i64.load (local.get $slot)))))))
      ;; Object.prototype fallback (arrays inherit these)
