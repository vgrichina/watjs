      (if (call $str_eq (local.get $ks) (cstring "call")) (then (return (call $mk_native (i32.const 194) (cstring "call")))))
      (if (call $str_eq (local.get $ks) (cstring "apply")) (then (return (call $mk_native (i32.const 195) (cstring "apply")))))
      (if (call $str_eq (local.get $ks) (cstring "bind")) (then (return (call $mk_native (i32.const 153) (cstring "bind")))))
