          (if (call $str_eq (call $to_prop_key (local.get $key)) (cstring "prototype"))
            (then (i64.store (i32.add (local.get $sfn) (i32.const 16)) (local.get $val)) (return)))
          (let $sproto i64 (i64.load (i32.add (local.get $sfn) (i32.const 16))))
          (if (i32.eqz (call $is_object (local.get $sproto)))
            (then (set! $sproto (call $mk_obj (call $obj_new (i32.const 8)))) (i64.store (i32.add (local.get $sfn) (i32.const 16)) (local.get $sproto))))
