            (then (return (call $mk_bool (i32.lt_s (local.get $tik) (call $ta_live_len_p (call $val_payload (local.get $obj))))))))))))
  (if (call $is_object (local.get $obj))
    (then
      ;; own property?
      (if (call $scope_find_local (call $val_payload (local.get $obj)) (call $to_prop_key (local.get $key)))
        (then (return (call $v_true))))
      ;; walk [[Prototype]] one level via js_get_prototype and recurse, so an exotic prototype
      ;; (a Proxy — or an array/function) invokes its own [[HasProperty]] instead of being read as
      ;; a flat scope (which never fires a Proxy's `has` trap for `key in Object.create(proxy)`).
      (let $inpr i64 (call $js_get_prototype (local.get $obj)))
      (if (i32.or (call $is_object (local.get $inpr)) (i32.or (call $is_array (local.get $inpr)) (call $is_function (local.get $inpr))))
        (then (return (call $js_in (local.get $key) (local.get $inpr)))))
      (return (call $v_false))))
  (if (call $is_array (local.get $obj))
    (then
      (if (call $key_is_length (local.get $key)) (then (return (call $v_true))))
      (let $aip i32 (call $val_payload (local.get $obj)))
      ;; element index present (non-hole)? present → true; hole → fall through to
      ;; the @12 (deopted-index) scope and the prototype chain (a hole can be inherited)
      (let $aidx i32 (call $str_array_index (call $to_prop_key (local.get $key))))
      (if (i32.ge_s (local.get $aidx) (i32.const 0)) (then (if (call $arr_has (local.get $aip) (local.get $aidx)) (then (return (call $v_true))))))
      ;; named property in the @12 scope?
      (let $anp i32 (i32.load (i32.add (local.get $aip) (i32.const 12))))
      (if (local.get $anp) (then (if (call $scope_find_local (local.get $anp) (call $to_prop_key (local.get $key))) (then (return (call $v_true))))))
      ;; inherited: walk Array.prototype (reg 160) → Object.prototype (scope_find walks parents)
      (let $aproto i32 (i32.load (i32.const 160)))
      (if (local.get $aproto) (then (if (call $scope_find (local.get $aproto) (call $to_prop_key (local.get $key))) (then (return (call $v_true))))))
      (return (call $v_false))))
  (if (call $is_function (local.get $obj))
    (then
      (if (call $fn_own (call $val_payload (local.get $obj)) (call $to_prop_key (local.get $key))) (then (return (call $v_true))))
      (return (call $mk_bool (i32.ne (call $fn_inherited_slot (call $to_prop_key (local.get $key))) (i32.const 0))))))
