          (if (local.get $asl)
            (then
              (let $idx i32 (i32.trunc_f64_s (call $tonum_raw (local.get $key))))
              (if (i32.and (i32.ge_s (local.get $idx) (i32.const 0)) (i32.lt_s (local.get $idx) (i32.trunc_f64_s (call $tonum_raw (i64.load (call $scope_find_local (local.get $o) (cstring "@@anp")))))))
                (then
