      (if (local.get $sfs) (then (if (i32.eqz (call $entry_writable (local.get $sfs))) (then (return)))))
      (call $scope_define (call $fn_props (local.get $sfn)) (local.get $sfk) (local.get $val))
      (return)))
  (call $throw_type (cstring "TypeError") (cstring "cannot set property of non-object")))
