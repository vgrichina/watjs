          (if (call $str_eq (local.get $ks) (cstring "length")) (then (return (call $num (f64.convert_i32_s (i32.load (i32.add (local.get $fn) (i32.const 8))))))))
          (if (call $str_eq (local.get $ks) (cstring "name"))  ;; declared/inferred name @(28+np*4), 0 → ""
