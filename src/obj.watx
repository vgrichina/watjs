        (br_if $wse (i32.ge_s (local.get $wsi) (local.get $wsln)))
        (call $scope_define_attr (local.get $wo) (call $num_to_str (f64.convert_i32_s (local.get $wsi))) (call $str_char_at (local.get $wsp) (local.get $wsi)) (i32.const 2))
        (set! $wsi (i32.add (local.get $wsi) (i32.const 1)))
