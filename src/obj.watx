      (if (local.get $phsl)
        (then
          (let $ptgt i64 (i64.load (call $scope_find_local (local.get $o) (cstring "@@ptarget"))))
          (let $gtrap i64 (call $get_prop (i64.load (local.get $phsl)) (call $mk_str (cstring "get"))))
          (if (call $is_function (local.get $gtrap))
            (then
