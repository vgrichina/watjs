      (if (call $str_eq (local.get $sks) (cstring "description")) (then (return (call $mk_str (call $sym_desc (local.get $cont))))))
      (if (call $str_eq (local.get $sks) (cstring "toString")) (then (return (call $mk_native (i32.const 199) (cstring "toString")))))
      (if (call $str_eq (local.get $sks) (cstring "valueOf")) (then (return (local.get $cont))))
