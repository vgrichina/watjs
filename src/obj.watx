      (let $wsln i32 (call $str_len (local.get $wsp)))
      (call $scope_define_attr (local.get $wo) (cstring "length") (call $num (f64.convert_i32_s (local.get $wsln))) (i32.const 0))
      (let $wsi i32 (i32.const 0))
