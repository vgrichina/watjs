      (i32.store (i32.add (local.get $fn) (i32.const 12)) (local.get $np))
      (local.get $np))))

;; Build a primitive wrapper object (new Number/String/Boolean or Object(prim)):
;; a fresh scope whose prototype chain is $proto (which carries .constructor and
;; valueOf/toString), holding the boxed value in __prim__.
(func $make_wrapper (param $prim i64) (param $proto i32) (result i64) (effects)
