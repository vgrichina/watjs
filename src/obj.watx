  (call $v_false))

;; set_prop(container, key, val)
;; in a strict [[Set]] (reg 392 set by the SETPROP_STRICT/SETIDX_STRICT opcodes), a
;; refused write (non-writable data, getter-only accessor, add to non-extensible)
;; throws a TypeError instead of being silently ignored.
(func $set_fail (effects)
  (if (i32.load (i32.const 392)) (then (call $throw_type (cstring "TypeError") (cstring "Cannot assign to read only property")))))
;; a deopted array index (accessor / non-default-attr data) lives in the @12 scope.
;; returns 1 if `ks` is such an entry (write handled: setter invoked / data stored /
;; refusal via set_fail), else 0 (caller writes the dense element).
(func $arr_deopt_set (param $a i32) (param $ks i32) (param $val i64) (param $cont i64) (result i32) (effects)
  (let $p i32 (i32.load (i32.add (local.get $a) (i32.const 12))))
  (if (i32.eqz (local.get $p)) (then (return (i32.const 0))))
  (let $slot i32 (call $scope_find_local (local.get $p) (local.get $ks)))
  (if (i32.eqz (local.get $slot)) (then (return (i32.const 0))))
  (if (call $entry_is_accessor (local.get $slot))
    (then
      (let $set i64 (i64.load (i32.add (call $val_payload (i64.load (local.get $slot))) (i32.const 8))))
      (if (call $is_function (local.get $set))
        (then (let $av i32 (call $heap_alloc (i32.const 8))) (i64.store (local.get $av) (local.get $val)) (drop (call $call_val (local.get $set) (i32.const 1) (local.get $av) (local.get $cont))))
        (else (call $set_fail)))
      (return (i32.const 1))))
  (if (i32.eqz (call $entry_writable (local.get $slot))) (then (call $set_fail) (return (i32.const 1))))
  (i64.store (local.get $slot) (local.get $val))
  (i32.const 1))
;; 1 if string $ks is a CanonicalNumericIndexString: ToString(ToNumber(ks)) === ks, or ks is "-0".
(func $ta_is_canon_str (param $ks i32) (result i32) (effects)
  (i32.or (call $str_eq (call $num_to_str (call $to_num (call $mk_str (local.get $ks)))) (local.get $ks))
          (call $str_eq (local.get $ks) (cstring "-0"))))

;; IsValidIntegerIndex: $n is a non-negative integer (not -0) below $len.
(func $ta_valid_idx (param $n f64) (param $len i32) (result i32) (effects)
  (i32.and (f64.eq (local.get $n) (local.get $n))                          ;; not NaN
    (i32.and (f64.eq (local.get $n) (f64.floor (local.get $n)))           ;; integer
      (i32.and (f64.ge (local.get $n) (f64.const 0))
        (i32.and (f64.lt (local.get $n) (f64.convert_i32_s (local.get $len)))
                 (i32.eqz (i32.and (f64.eq (local.get $n) (f64.const 0))  ;; reject -0
                                   (f64.lt (f64.copysign (f64.const 1) (local.get $n)) (f64.const 0)))))))))

;; IntegerIndexedExoticObject [[Delete]] classification for `delete ta[key]`:
;; 0 = key is not a canonical numeric index on a TypedArray (do the ordinary delete),
;; 1 = canonical numeric index that is NOT a valid element (delete succeeds, returns true),
;; 2 = a valid in-bounds integer index (cannot be deleted → false / strict TypeError).
(func $ta_delete_kind (param $dobj i64) (param $dkey i64) (result i32) (effects)
  (if (i32.eqz (call $is_object (local.get $dobj))) (then (return (i32.const 0))))
  (let $o i32 (call $val_payload (local.get $dobj)))
  (if (i32.eqz (call $scope_find_local (local.get $o) (cstring "@@taelem"))) (then (return (i32.const 0))))
  (let $n f64 (f64.const 0))
  (if (call $is_number (local.get $dkey))
    (then (set! $n (call $tonum_raw (local.get $dkey))))
    (else
      (if (i32.eqz (call $is_string (local.get $dkey))) (then (return (i32.const 0))))
      (if (i32.eqz (call $ta_is_canon_str (call $val_payload (local.get $dkey)))) (then (return (i32.const 0))))
      (set! $n (call $to_num (local.get $dkey)))))
  ;; a detached buffer makes every integer index invalid → the delete succeeds (true)
  (if (call $ta_is_detached (local.get $dobj)) (then (return (i32.const 1))))
  (let $len i32 (call $ta_live_len_p (local.get $o)))
  (if (call $ta_valid_idx (local.get $n) (local.get $len)) (then (return (i32.const 2))))
  (i32.const 1))

;; IntegerIndexedExoticObject [[Set]] for a canonical numeric index on a TypedArray (scope $o).
;; Returns 1 if $key is a CanonicalNumericIndexString (the write was performed, or dropped for an
;; out-of-bounds / detached / non-integer index — but ToNumber/ToBigInt(value) still ran once),
;; 0 if $key is an ordinary property key (caller falls back to ordinary [[Set]]).
(func $ta_set_elem (param $o i32) (param $key i64) (param $val i64) (result i32) (effects)
  (let $n f64 (f64.const 0))
  (if (call $is_number (local.get $key))
    (then (set! $n (call $tonum_raw (local.get $key))))   ;; a Number key is always a numeric index
    (else
      (if (i32.eqz (call $is_string (local.get $key))) (then (return (i32.const 0))))
      ;; canonical iff ToString(ToNumber(key)) === key, or key is the literal "-0"
      (let $ks i32 (call $val_payload (local.get $key)))
      (let $cn f64 (call $to_num (local.get $key)))
      (if (i32.eqz (i32.or (call $str_eq (call $num_to_str (local.get $cn)) (local.get $ks)) (call $str_eq (local.get $ks) (cstring "-0"))))
        (then (return (i32.const 0))))
      (set! $n (local.get $cn))))
  (let $elem i32 (i32.trunc_f64_s (call $tonum_raw (i64.load (call $scope_find_local (local.get $o) (cstring "@@taelem"))))))
  (let $bo i32 (call $scope_find_local (local.get $o) (cstring "@@tabufobj")))
  (let $len i32 (call $ta_live_len_p (local.get $o)))
  (let $buf i32 (i32.trunc_f64_s (call $tonum_raw (i64.load (call $scope_find_local (local.get $o) (cstring "@@tabuf"))))))
  (if (i32.and (i32.ge_s (local.get $elem) (i32.const 9)) (i32.le_s (local.get $elem) (i32.const 10)))
    (then  ;; BigInt TypedArray: ToBigInt(value) happens once, before the index validity check
      (let $bv i64 (call $to_bigint (local.get $val)))
      (if (call $err) (then (return (i32.const 1))))
      (if (local.get $bo) (then (if (call $is_detached_buf (i64.load (local.get $bo))) (then (return (i32.const 1))))))
      (if (call $ta_valid_idx (local.get $n) (local.get $len))
        (then (i64.store (i32.add (local.get $buf) (i32.mul (i32.trunc_f64_s (local.get $n)) (i32.const 8))) (call $bigint_val (local.get $bv)))))
      (return (i32.const 1))))
  ;; numeric TypedArray: ToNumber(value) runs once, regardless of index validity.
  ;; ToNumber(BigInt) is a TypeError (a BigInt can't be assigned to a non-BigInt TypedArray).
  (if (call $is_bigint (local.get $val))
    (then (call $throw_type (cstring "TypeError") (cstring "Cannot convert a BigInt to a number")) (return (i32.const 1))))
  (let $cval f64 (call $to_num (local.get $val)))
  (if (call $err) (then (return (i32.const 1))))
  (if (local.get $bo) (then (if (call $is_detached_buf (i64.load (local.get $bo))) (then (return (i32.const 1))))))
  (if (call $ta_valid_idx (local.get $n) (local.get $len))
    (then (call $ta_write (local.get $buf) (i32.trunc_f64_s (local.get $n)) (local.get $elem) (local.get $cval))))
  (i32.const 1))

(func $set_prop (param $cont i64) (param $key i64) (param $val i64) (effects)
  (if (call $is_array (local.get $cont))
    (then
      (let $a i32 (call $val_payload (local.get $cont)))
      ;; frozen / non-extensible enforcement (markers parked in the @12 named-prop scope)
      (let $ap12 i32 (i32.load (i32.add (local.get $a) (i32.const 12))))
      (let $afroz i32 (if i32 (local.get $ap12) (then (i32.ne (call $scope_find_local (local.get $ap12) (cstring "@@frozen")) (i32.const 0))) (else (i32.const 0))))
      (let $anoext i32 (if i32 (local.get $ap12) (then (i32.ne (call $scope_find_local (local.get $ap12) (cstring "@@noext")) (i32.const 0))) (else (i32.const 0))))
      (if (local.get $afroz) (then (call $set_fail) (return)))  ;; frozen → refuse all writes
      (if (call $is_number (local.get $key))
        (then
          ;; finite integer in i32 range → element; else (NaN/>=2^31/fractional)
          ;; is a named property, handled below — never trap on the trunc
          (let $aset f64 (call $tonum_raw (local.get $key)))
          (if (i32.and (f64.eq (local.get $aset) (local.get $aset))
                (i32.and (f64.ge (local.get $aset) (f64.const 0))
                  (i32.and (f64.lt (local.get $aset) (f64.const 2147483648))
                           (f64.eq (local.get $aset) (f64.floor (local.get $aset))))))
            (then
              (let $nsi i32 (i32.trunc_f64_s (local.get $aset)))
              ;; deopted index (accessor / attributed) → @12 scope takes the write
              (if (local.get $ap12) (then (if (call $arr_deopt_set (local.get $a) (call $num_to_str (f64.convert_i32_s (local.get $nsi))) (local.get $val) (local.get $cont)) (then (return)))))
              ;; non-extensible: refuse a write that would ADD a new index (>= length)
              (if (i32.and (local.get $anoext) (i32.ge_s (local.get $nsi) (call $arr_len (local.get $a)))) (then (call $set_fail) (return)))
              (call $arr_set (local.get $a) (local.get $nsi) (local.get $val)) (return)))))
      (let $askey i32 (call $to_prop_key (local.get $key)))
      ;; a string key that's a canonical index (a["3"]=…) writes an element
      (let $ssidx i32 (call $str_array_index (local.get $askey)))
      (if (i32.ge_s (local.get $ssidx) (i32.const 0))
        (then
          (if (local.get $ap12) (then (if (call $arr_deopt_set (local.get $a) (local.get $askey) (local.get $val) (local.get $cont)) (then (return)))))
          (if (i32.and (local.get $anoext) (i32.ge_s (local.get $ssidx) (call $arr_len (local.get $a)))) (then (call $set_fail) (return)))
          (call $arr_set (local.get $a) (local.get $ssidx) (local.get $val)) (return)))
      ;; `length` assignment resizes the array (truncate / extend with holes);
      ;; a non-integer / negative / out-of-i32-range value → RangeError.
      (if (call $str_eq (local.get $askey) (cstring "length"))
        (then
          (if (i32.eqz (call $arr_len_writable (local.get $a))) (then (call $set_fail) (return)))
          (let $lnv f64 (call $to_num (local.get $val)))
          (let $ln i32 (call $to_int_idx (local.get $lnv)))
          (if (i32.or (f64.ne (local.get $lnv) (f64.convert_i32_s (local.get $ln))) (f64.lt (local.get $lnv) (f64.const 0)))
            (then (call $throw_type (cstring "RangeError") (cstring "Invalid array length")) (return)))
          ;; non-extensible: a length increase would add (hole) indices → refuse
          (if (i32.and (local.get $anoext) (i32.gt_s (local.get $ln) (call $arr_len (local.get $a)))) (then (call $set_fail) (return)))
          (call $arr_set_length (local.get $a) (local.get $ln))
          (return)))
      ;; named property on an array (a.foo, a[2**32-1], …) → @12 scope. An existing
      ;; accessor fires its setter; an existing data prop respects [[Writable]].
      (if (local.get $ap12) (then (if (call $arr_deopt_set (local.get $a) (local.get $askey) (local.get $val) (local.get $cont)) (then (return)))))
      ;; Non-extensible refuses adding a NOT-already-present named property.
      (if (i32.and (local.get $anoext) (i32.eqz (i32.ne (call $scope_find_local (call $arr_props (local.get $a)) (local.get $askey)) (i32.const 0))))
        (then (call $set_fail) (return)))
      (call $scope_define (call $arr_props (local.get $a)) (local.get $askey) (local.get $val))
      (return)))
  (if (call $is_object (local.get $cont))
    (then
      (let $o i32 (call $val_payload (local.get $cont)))
      ;; Proxy: dispatch to the handler's set trap, else forward to the target
      (let $phsl i32 (call $scope_find_local (local.get $o) (cstring "@@phandler")))
      (if (local.get $phsl)
        (then
          (let $strap i64 (call $proxy_trap (local.get $cont) (cstring "set")))  ;; revoked / non-callable → TypeError
          (if (call $err) (then (return)))
          (let $ptgt i64 (call $proxy_target (local.get $cont)))
          (if (call $is_function (local.get $strap))
            (then
              (let $skv i64 (call $to_prop_key_val (local.get $key)))  ;; Symbol key stays a Symbol for the trap
              (if (call $err) (then (return)))
              (let $sbuf i32 (call $heap_alloc (i32.const 32)))
              (i64.store (local.get $sbuf) (local.get $ptgt))
              (i64.store (i32.add (local.get $sbuf) (i32.const 8)) (local.get $skv))
              (i64.store (i32.add (local.get $sbuf) (i32.const 16)) (local.get $val))
              (i64.store (i32.add (local.get $sbuf) (i32.const 24)) (local.get $cont))
              (let $sres i32 (call $truthy (call $call_val (local.get $strap) (i32.const 4) (local.get $sbuf) (call $proxy_handler (local.get $cont)))))
              (if (call $err) (then (return)))
              (if (i32.eqz (local.get $sres))
                (then (call $set_fail) (return)))  ;; trap refused the write → strict throws
              ;; trap returned true → invariant against a non-configurable own
              ;; property of target: a non-writable data property's value must
              ;; SameValue V, and a setterless accessor cannot be written
              (let $sdb i32 (call $heap_alloc (i32.const 16)))
              (i64.store (local.get $sdb) (local.get $ptgt))
              (i64.store (i32.add (local.get $sdb) (i32.const 8)) (local.get $skv))
              (let $sdesc i64 (call $call_native (i32.const 156) (i32.const 2) (local.get $sdb) (call $v_undef)))
              (if (call $err) (then (return)))
              (if (i32.eqz (call $is_undefined (local.get $sdesc)))
                (then
                  (if (i32.eqz (call $truthy (call $get_prop (local.get $sdesc) (call $mk_str (cstring "configurable")))))
                    (then
                      (if (call $truthy (call $js_in (call $mk_str (cstring "writable")) (local.get $sdesc)))
                        (then  ;; data property
                          (if (i32.eqz (call $truthy (call $get_prop (local.get $sdesc) (call $mk_str (cstring "writable")))))
                            (then
                              (if (i32.eqz (call $same_value (local.get $val) (call $get_prop (local.get $sdesc) (call $mk_str (cstring "value")))))
                                (then (call $throw_type (cstring "TypeError") (cstring "proxy set: cannot change non-writable non-configurable data property")) (return))))))
                        (else  ;; accessor property
                          (if (call $is_undefined (call $get_prop (local.get $sdesc) (call $mk_str (cstring "set"))))
                            (then (call $throw_type (cstring "TypeError") (cstring "proxy set: cannot write non-configurable accessor without setter")) (return)))))))))
              (return)))
          (call $set_prop (local.get $ptgt) (local.get $key) (local.get $val))
          (return)))
      ;; TypedArray: a canonical numeric index (Number or numeric string) → IntegerIndexedElementSet
      ;; (write to the byte buffer, or a no-op for out-of-bounds/detached, never a named property).
      (if (call $scope_find_local (local.get $o) (cstring "@@taelem"))
        (then (if (call $ta_set_elem (local.get $o) (local.get $key) (local.get $val)) (then (return)))))
      ;; Object.freeze: data writes / new props are refused (strict: throw), but an own
      ;; accessor still fires its setter — fall through to the accessor handling below.
      (if (call $scope_find_local (local.get $o) (cstring "@@frozen"))
        (then
          (let $frsl i32 (call $scope_find_local (local.get $o) (call $to_prop_key (local.get $key))))
          (if (local.get $frsl)
            (then (if (i32.eqz (call $entry_is_accessor (local.get $frsl))) (then (call $set_fail) (return))))
            (else (call $set_fail) (return)))))
      ;; mapped arguments: writing a numeric index (number OR canonical string) < @@anp writes the
      ;; parameter slot (gOPD reads the live param, so the own-prop shell needn't be synced).
      (let $smidx i32 (i32.const -1))
      (if (call $is_number (local.get $key))
        (then (let $smkn f64 (call $tonum_raw (local.get $key)))  ;; range-guard against i32.trunc_f64_s trap
              (if (i32.and (f64.ge (local.get $smkn) (f64.const 0)) (f64.lt (local.get $smkn) (f64.const 2147483648)))
                (then (set! $smidx (i32.trunc_f64_s (local.get $smkn)))))))
      (if (call $is_string (local.get $key)) (then (set! $smidx (call $str_array_index (call $val_payload (local.get $key))))))
      (if (i32.ge_s (local.get $smidx) (i32.const 0))
        (then (if (call $args_mapped (local.get $o) (local.get $smidx))
          (then
            (call $args_set_param (local.get $o) (local.get $smidx) (local.get $val))
            (return)))))
      (let $ks i32 (call $to_prop_key (local.get $key)))
      (let $slot i32 (call $scope_find (local.get $o) (local.get $ks)))
      (if (local.get $slot)  ;; guard before entry_kind (i32.and would deref slot-4 even when 0)
        (then
          (if (call $entry_is_accessor (local.get $slot))
            (then  ;; accessor → call setter
              (let $set i64 (i64.load (i32.add (call $val_payload (i64.load (local.get $slot))) (i32.const 8))))
              (if (call $is_function (local.get $set))
                (then
                  (let $av i32 (call $heap_alloc (i32.const 8)))
                  (i64.store (local.get $av) (local.get $val))
                  (drop (call $call_val (local.get $set) (i32.const 1) (local.get $av) (local.get $cont))))
                (else (call $set_fail)))  ;; getter-only accessor → strict throws
              (return)))
          ;; non-writable data property → ignore the assignment (strict: throw)
          (if (i32.eqz (call $entry_writable (local.get $slot))) (then (call $set_fail) (return)))))
      ;; adding a NEW own property to a non-extensible object (preventExtensions/
      ;; seal/freeze) is refused (no own slot yet + @@noext marker present); strict: throw.
      (if (i32.and (i32.eqz (call $scope_find_local (local.get $o) (local.get $ks)))
                   (i32.ne (call $scope_find_local (local.get $o) (cstring "@@noext")) (i32.const 0)))
        (then (call $set_fail) (return)))
      (call $scope_define (local.get $o) (local.get $ks) (local.get $val))
      (return)))
  (if (call $is_function (local.get $cont))
    (then
      ;; 'caller'/'arguments' are the restricted %ThrowTypeError% accessors inherited from
      ;; Function.prototype — assigning them invokes the throwing setter (no own override here).
      (if (i32.or (call $str_eq (call $to_prop_key (local.get $key)) (cstring "caller")) (call $str_eq (call $to_prop_key (local.get $key)) (cstring "arguments")))
        (then (call $throw_type (cstring "TypeError") (cstring "'caller' and 'arguments' are restricted function properties")) (return)))
      (let $sfn i32 (call $val_payload (local.get $cont)))
      ;; VM function: own/static props go into its @16 prototype scope (allocate one if absent)
      (if (i32.and (i32.ge_s (i32.load (local.get $sfn)) (i32.const 1448232526)) (i32.le_s (i32.load (local.get $sfn)) (i32.const 1448232528)))
        (then
          ;; assigning `.prototype` REPLACES the prototype object (@16), so new
          ;; instances inherit from it — not a nested prototype.prototype property
          (if (call $str_eq (call $to_prop_key (local.get $key)) (cstring "prototype"))
            (then
              ;; class ctor (flags bit3) or a defineProperty'd non-writable prototype (bit5) → refuse the write
              (let $spf i32 (i32.load (i32.add (i32.add (local.get $sfn) (i32.const 32)) (i32.mul (i32.load (i32.add (local.get $sfn) (i32.const 8))) (i32.const 4)))))
              (if (i32.and (local.get $spf) (i32.const 264)) (then (call $set_fail) (return)))
              (i64.store (i32.add (local.get $sfn) (i32.const 16)) (local.get $val)) (return)))
          (let $sosc i32 (call $fn_ownsc (local.get $sfn)))  ;; own (static) prop scope @(48+np*4)
          (let $svk i32 (call $to_prop_key (local.get $key)))
          (let $svs i32 (call $scope_find_local (local.get $sosc) (local.get $svk)))
          ;; `name`/`length` are non-writable own props by default (set at creation in the
          ;; fn struct, reported {W:false} by getOwnPropertyDescriptor) — a plain assignment
          ;; is refused unless they have been redefined as a writable own-prop entry.
          (if (i32.and (i32.eqz (local.get $svs)) (i32.or (call $str_eq (local.get $svk) (cstring "name")) (call $str_eq (local.get $svk) (cstring "length"))))
            (then (call $set_fail) (return)))
          ;; adding a NEW own prop to a non-extensible (preventExtensions/seal/freeze) function is refused
          (if (i32.and (i32.eqz (local.get $svs)) (i32.ne (call $scope_find_local (local.get $sosc) (cstring "@@noext")) (i32.const 0)))
            (then (call $set_fail) (return)))
          (if (local.get $svs)
            (then
              (if (call $entry_is_accessor (local.get $svs))  ;; named accessor on a user function → fire setter
                (then
                  (let $sset i64 (i64.load (i32.add (call $val_payload (i64.load (local.get $svs))) (i32.const 8))))
                  (if (call $is_function (local.get $sset))
                    (then (let $sav i32 (call $heap_alloc (i32.const 8))) (i64.store (local.get $sav) (local.get $val)) (drop (call $call_val (local.get $sset) (i32.const 1) (local.get $sav) (local.get $cont)))))
                  (return)))
              (if (i32.eqz (call $entry_writable (local.get $svs))) (then (return)))))  ;; non-writable own → ignore
          (call $scope_define (local.get $sosc) (local.get $svk) (local.get $val))
          (return)))
      (let $sfk i32 (call $to_prop_key (local.get $key)))
      ;; name/length (and any other non-writable own data prop) refuse the assignment;
      ;; set_fail makes a strict [[Set]] throw instead of silently ignoring it.
      (let $sfs i32 (call $scope_find_local (call $fn_props (local.get $sfn)) (local.get $sfk)))
      (if (local.get $sfs)
        (then (if (i32.eqz (call $entry_writable (local.get $sfs))) (then (call $set_fail) (return))))
        (else  ;; not an explicit @12 entry: name/length are non-writable computed defaults
          (if (i32.or (call $str_eq (local.get $sfk) (cstring "length")) (call $str_eq (local.get $sfk) (cstring "name")))
            (then (call $set_fail) (return)))))
      (call $scope_define (call $fn_props (local.get $sfn)) (local.get $sfk) (local.get $val))
      (return)))
  ;; primitive base: null/undefined → always TypeError; a number/string/boolean/symbol/bigint
  ;; auto-boxes to a temp wrapper whose [[Set]] with a primitive receiver returns false →
  ;; sloppy = silent no-op, strict = TypeError (set_fail honors reg 392).
  (if (i32.or (call $is_null (local.get $cont)) (call $is_undefined (local.get $cont)))
    (then (call $throw_type (cstring "TypeError") (cstring "Cannot set property of null or undefined")))
    (else (call $set_fail))))
