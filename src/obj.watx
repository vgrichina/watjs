      ;; mapped arguments: writing a numeric index < @@anp writes the parameter slot
      (if (call $is_number (local.get $key))
        (then
          (let $asl i32 (call $scope_find_local (local.get $o) (cstring "@@as")))
          (if (local.get $asl)
            (then
              (let $idx i32 (i32.trunc_f64_s (call $tonum_raw (local.get $key))))
              (if (i32.and (i32.ge_s (local.get $idx) (i32.const 0)) (i32.lt_s (local.get $idx) (i32.trunc_f64_s (call $tonum_raw (i64.load (call $scope_find_local (local.get $o) (cstring "@@anp")))))))
                (then
                  (let $asc i32 (i32.trunc_f64_s (call $tonum_raw (i64.load (local.get $asl)))))
                  (let $afn i32 (i32.trunc_f64_s (call $tonum_raw (i64.load (call $scope_find_local (local.get $o) (cstring "@@af"))))))
                  (call $scope_define (local.get $asc) (i32.load (i32.add (i32.add (local.get $afn) (i32.const 28)) (i32.mul (local.get $idx) (i32.const 4)))) (local.get $val))
