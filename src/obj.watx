                  (let $afn i32 (i32.trunc_f64_s (call $tonum_raw (i64.load (call $scope_find_local (local.get $o) (cstring "@@af"))))))
                  (let $aps i32 (call $scope_find (local.get $asc) (i32.load (i32.add (i32.add (local.get $afn) (i32.const 28)) (i32.mul (local.get $idx) (i32.const 4))))))
                  (return (if i64 (local.get $aps) (then (i64.load (local.get $aps))) (else (call $v_undef))))))))))
