          (let $svs i32 (call $scope_find_local (call $val_payload (local.get $sproto)) (local.get $svk)))
          (if (local.get $svs) (then (if (i32.eqz (call $entry_writable (local.get $svs))) (then (return)))))  ;; non-writable own → ignore
