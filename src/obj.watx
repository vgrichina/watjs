      ;; TypedArray: numeric index → write to the byte buffer
      (let $tael i32 (call $scope_find_local (local.get $o) (cstring "@@taelem")))
      (if (i32.and (i32.ne (local.get $tael) (i32.const 0)) (call $is_number (local.get $key)))
        (then
          (let $tidx i32 (i32.trunc_f64_s (call $tonum_raw (local.get $key))))
          (let $tln i32 (i32.trunc_f64_s (call $tonum_raw (i64.load (call $scope_find_local (local.get $o) (cstring "@@talen"))))))
          (if (i32.and (i32.ge_s (local.get $tidx) (i32.const 0)) (i32.lt_s (local.get $tidx) (local.get $tln)))
            (then (call $ta_write (i32.trunc_f64_s (call $tonum_raw (i64.load (call $scope_find_local (local.get $o) (cstring "@@tabuf"))))) (local.get $tidx) (i32.trunc_f64_s (call $tonum_raw (i64.load (local.get $tael)))) (call $to_num (local.get $val)))))
