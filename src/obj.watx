;; parseInt(string, radix) core: leading integer in the given radix (0=auto)
(func $parse_int_str (param $s i32) (param $radix i32) (result f64) (effects)
  (let $len i32 (call $str_len (local.get $s)))
  (let $i i32 (i32.const 0))
  (block $sk (loop $sl  ;; skip leading StrWhiteSpace — the full Zs set + line terminators (ws_fwd_len)
    (br_if $sk (i32.ge_s (local.get $i) (local.get $len)))
    (let $wl i32 (call $ws_fwd_len (local.get $s) (local.get $i)))
    (br_if $sk (i32.eqz (local.get $wl)))
    (set! $i (i32.add (local.get $i) (local.get $wl)))
    (br $sl)))
  (let $sign f64 (f64.const 1))
  (if (i32.lt_s (local.get $i) (local.get $len))
    (then
      (let $c i32 (call $str_byte (local.get $s) (local.get $i)))
      (if (i32.eq (local.get $c) (i32.const 43)) (then (set! $i (i32.add (local.get $i) (i32.const 1)))))
      (if (i32.eq (local.get $c) (i32.const 45)) (then (set! $sign (f64.const -1)) (set! $i (i32.add (local.get $i) (i32.const 1)))))))
  ;; radix range: R != 0 and (R < 2 or R > 36) → NaN
  (if (i32.and (i32.ne (local.get $radix) (i32.const 0))
        (i32.or (i32.lt_s (local.get $radix) (i32.const 2)) (i32.gt_s (local.get $radix) (i32.const 36))))
    (then (return (f64.div (f64.const 0) (f64.const 0)))))
  ;; 0x prefix
  (if (i32.and (i32.or (i32.eqz (local.get $radix)) (i32.eq (local.get $radix) (i32.const 16))) (i32.lt_s (i32.add (local.get $i) (i32.const 1)) (local.get $len)))
    (then
      (if (i32.and (i32.eq (call $str_byte (local.get $s) (local.get $i)) (i32.const 48))
            (i32.or (i32.eq (call $str_byte (local.get $s) (i32.add (local.get $i) (i32.const 1))) (i32.const 120))
                    (i32.eq (call $str_byte (local.get $s) (i32.add (local.get $i) (i32.const 1))) (i32.const 88))))
        (then (set! $radix (i32.const 16)) (set! $i (i32.add (local.get $i) (i32.const 2)))))))
  (if (i32.eqz (local.get $radix)) (then (set! $radix (i32.const 10))))
  (let $val f64 (f64.const 0))
  (let $any i32 (i32.const 0))
  (block $de (loop $dl
    (br_if $de (i32.ge_s (local.get $i) (local.get $len)))
    (let $d i32 (call $digit36 (call $str_byte (local.get $s) (local.get $i))))
    (br_if $de (i32.or (i32.lt_s (local.get $d) (i32.const 0)) (i32.ge_s (local.get $d) (local.get $radix))))
    (set! $val (f64.add (f64.mul (local.get $val) (f64.convert_i32_s (local.get $radix))) (f64.convert_i32_s (local.get $d))))
    (set! $any (i32.const 1))
    (set! $i (i32.add (local.get $i) (i32.const 1)))
    (br $dl)))
  (if f64 (i32.eqz (local.get $any)) (then (f64.div (f64.const 0) (f64.const 0))) (else (f64.mul (local.get $sign) (local.get $val)))))

;; key is "length"?
(func $key_is_length (param $key i64) (result i32) (effects)
  ;; must short-circuit: i32.and evaluates BOTH operands, so str_eq would deref
  ;; val_payload(key) even for a number key (whose bits aren't a pointer) → OOB.
  (if i32 (call $is_string (local.get $key))
    (then (call $str_eq (call $val_payload (local.get $key)) (cstring "length")))
    (else (i32.const 0))))

;; look up an inherited property slot for a function: Function.prototype (reg 336)
;; then Object.prototype (reg 328). Returns the slot ptr, or 0 if not found.
(func $fn_inherited_slot (param $ks i32) (result i32) (effects)
  (let $fpv i64 (i64.load (i32.const 336)))
  (if (call $is_function (local.get $fpv))
    (then
      (let $fpp i32 (i32.load (i32.add (call $val_payload (local.get $fpv)) (i32.const 12))))
      (if (local.get $fpp)
        (then
          (let $s i32 (call $scope_find (local.get $fpp) (local.get $ks)))
          (if (local.get $s) (then (return (local.get $s))))))))
  (let $op i32 (i32.load (i32.const 328)))
  (if (local.get $op)
    (then
      (let $s2 i32 (call $scope_find (local.get $op) (local.get $ks)))
      (if (local.get $s2) (then (return (local.get $s2))))))
  (i32.const 0))

;; Resolve a method/property inherited from Object.prototype (reg 328) for a
;; primitive receiver whose own wrapper prototype lookup missed — returns the
;; STORED slot (stable identity), invoking a getter if the slot is an accessor,
;; else undefined. Used by the number/boolean/bigint/string get_prop tails.
(func $inherit_objproto (param $key i64) (param $cont i64) (result i64) (effects)
  (let $op i32 (i32.load (i32.const 328)))
  (if (local.get $op)
    (then
      (let $oslot i32 (call $scope_find_local (local.get $op) (call $to_prop_key (local.get $key))))
      (if (local.get $oslot)
        (then
          (if (call $entry_is_accessor (local.get $oslot))
            (then (let $og i64 (i64.load (call $val_payload (i64.load (local.get $oslot))))) (if (call $is_function (local.get $og)) (then (return (call $call_fn0 (local.get $og) (local.get $cont))))) (return (call $v_undef))))
          (return (i64.load (local.get $oslot)))))))
  (call $v_undef))

;; ── mapped-arguments [[ParameterMap]] helpers (scope $o = the arguments object) ──
;; An index is still mapped to its parameter iff idx∈[0,@@anp) AND its own property exists
;; as a WRITABLE data property. Severing (defineProperty writable:false / accessor) makes the
;; own prop non-writable/accessor, and delete removes it — both auto-unmap via this derivation
;; (no separate sever-set needed).
;; Once an index is deleted (or sever-redefined) from the [[ParameterMap]] it is PERMANENTLY
;; unmapped — even if a fresh writable own data property is later created at that index (which
;; would otherwise re-satisfy the derivation below). A per-index sever bit (idx<31) records this.
(func $args_severed (param $o i32) (param $idx i32) (result i32) (effects)
  (if (i32.ge_s (local.get $idx) (i32.const 31)) (then (return (i32.const 0))))
  (let $ml i32 (call $scope_find_local (local.get $o) (cstring "@@umask")))
  (if (i32.eqz (local.get $ml)) (then (return (i32.const 0))))
  (i32.and (i32.shr_u (i32.trunc_f64_s (call $tonum_raw (i64.load (local.get $ml)))) (local.get $idx)) (i32.const 1)))
(func $args_sever (param $o i32) (param $idx i32) (effects)
  (if (i32.lt_s (local.get $idx) (i32.const 0)) (then (return)))
  (if (i32.ge_s (local.get $idx) (i32.const 31)) (then (return)))
  (if (i32.eqz (call $scope_find_local (local.get $o) (cstring "@@as"))) (then (return)))  ;; only real mapped-args objects
  (let $ml i32 (call $scope_find_local (local.get $o) (cstring "@@umask")))
  (let $mv i32 (if i32 (local.get $ml) (then (i32.trunc_f64_s (call $tonum_raw (i64.load (local.get $ml))))) (else (i32.const 0))))
  (call $scope_define (local.get $o) (cstring "@@umask") (call $num (f64.convert_i32_s (i32.or (local.get $mv) (i32.shl (i32.const 1) (local.get $idx)))))))

(func $args_mapped (param $o i32) (param $idx i32) (result i32) (effects)
  (if (i32.lt_s (local.get $idx) (i32.const 0)) (then (return (i32.const 0))))
  (let $asl i32 (call $scope_find_local (local.get $o) (cstring "@@as")))
  (if (i32.eqz (local.get $asl)) (then (return (i32.const 0))))
  (let $anpl i32 (call $scope_find_local (local.get $o) (cstring "@@anp")))
  (if (i32.eqz (local.get $anpl)) (then (return (i32.const 0))))
  (if (i32.ge_s (local.get $idx) (i32.trunc_f64_s (call $tonum_raw (i64.load (local.get $anpl))))) (then (return (i32.const 0))))
  (if (call $args_severed (local.get $o) (local.get $idx)) (then (return (i32.const 0))))
  (let $ps i32 (call $scope_find_local (local.get $o) (call $num_to_str (f64.convert_i32_s (local.get $idx)))))
  (if (i32.eqz (local.get $ps)) (then (return (i32.const 0))))
  (if (call $entry_is_accessor (local.get $ps)) (then (return (i32.const 0))))
  (call $entry_writable (local.get $ps)))
;; read the parameter slot aliased by arguments index $idx (caller ensures args_mapped)
(func $args_get_param (param $o i32) (param $idx i32) (result i64) (effects)
  (let $asc i32 (i32.trunc_f64_s (call $tonum_raw (i64.load (call $scope_find_local (local.get $o) (cstring "@@as"))))))
  (let $afn i32 (i32.trunc_f64_s (call $tonum_raw (i64.load (call $scope_find_local (local.get $o) (cstring "@@af"))))))
  (let $aps i32 (call $scope_find (local.get $asc) (i32.load (i32.add (i32.add (local.get $afn) (i32.const 28)) (i32.mul (local.get $idx) (i32.const 4))))))
  (if i64 (local.get $aps) (then (i64.load (local.get $aps))) (else (call $v_undef))))
;; write the parameter slot aliased by arguments index $idx
(func $args_set_param (param $o i32) (param $idx i32) (param $val i64) (effects)
  (let $asc i32 (i32.trunc_f64_s (call $tonum_raw (i64.load (call $scope_find_local (local.get $o) (cstring "@@as"))))))
  (let $afn i32 (i32.trunc_f64_s (call $tonum_raw (i64.load (call $scope_find_local (local.get $o) (cstring "@@af"))))))
  (call $scope_define (local.get $asc) (i32.load (i32.add (i32.add (local.get $afn) (i32.const 28)) (i32.mul (local.get $idx) (i32.const 4)))) (local.get $val)))

;; get_prop(container, key) -> value
(func $get_prop (param $cont i64) (param $key i64) (result i64) (effects)
  (if (call $is_array (local.get $cont))
    (then
      (let $a i32 (call $val_payload (local.get $cont)))
      (if (call $key_is_length (local.get $key))
        (then (return (call $num (f64.convert_i32_s (call $arr_len (local.get $a)))))))
      (if (call $is_number (local.get $key))
        (then
          ;; only a finite integer in i32 range is an element index; others
          ;; (NaN/>=2^31/fractional) → undefined (guard the trapping trunc)
          (let $aget f64 (call $tonum_raw (local.get $key)))
          (if (i32.and (f64.eq (local.get $aget) (local.get $aget))
                (i32.and (f64.ge (local.get $aget) (f64.const 0))
                  (i32.and (f64.lt (local.get $aget) (f64.const 2147483648))
                           (f64.eq (local.get $aget) (f64.floor (local.get $aget))))))
            (then
              (let $nidx i32 (i32.trunc_f64_s (local.get $aget)))
              ;; a deopted index (accessor / attributed) lives in the @12 scope
              (let $adp i32 (i32.load (i32.add (local.get $a) (i32.const 12))))
              (if (local.get $adp)
                (then (let $dsl i32 (call $scope_find_local (local.get $adp) (call $num_to_str (f64.convert_i32_s (local.get $nidx)))))
                  (if (local.get $dsl)
                    (then
                      (if (call $entry_is_accessor (local.get $dsl))
                        (then (let $dg i64 (i64.load (call $val_payload (i64.load (local.get $dsl))))) (if (call $is_function (local.get $dg)) (then (return (call $call_fn0 (local.get $dg) (local.get $cont))))) (return (call $v_undef))))
                      (return (i64.load (local.get $dsl)))))))
              ;; present element → value; absent (hole / out of range) walks the prototype chain
              (if (call $arr_has (local.get $a) (local.get $nidx))
                (then (return (call $arr_get (local.get $a) (local.get $nidx))))
                (else (return (call $get_prop (call $js_get_prototype (local.get $cont)) (local.get $key)))))))))
            ;; non-index numeric falls through to the lookups below
      (let $akey i32 (call $to_prop_key (local.get $key)))
      (if (call $str_eq (local.get $akey) (cstring "__proto__")) (then (return (call $js_get_prototype (local.get $cont)))))  ;; → Array.prototype
      ;; a string key that's a canonical index ("0", a["3"]) is an element (check @12 deopt first)
      (let $asidx i32 (call $str_array_index (local.get $akey)))
      (if (i32.ge_s (local.get $asidx) (i32.const 0))
        (then
          (let $adp2 i32 (i32.load (i32.add (local.get $a) (i32.const 12))))
          (if (local.get $adp2)
            (then (let $dsl2 i32 (call $scope_find_local (local.get $adp2) (local.get $akey)))
              (if (local.get $dsl2)
                (then
                  (if (call $entry_is_accessor (local.get $dsl2))
                    (then (let $dg2 i64 (i64.load (call $val_payload (i64.load (local.get $dsl2))))) (if (call $is_function (local.get $dg2)) (then (return (call $call_fn0 (local.get $dg2) (local.get $cont))))) (return (call $v_undef))))
                  (return (i64.load (local.get $dsl2)))))))
          ;; present own element → its value; an absent index (hole / out of range) walks the
          ;; prototype chain so it inherits Array.prototype[idx] / Object.prototype[idx] if defined
          (if (call $arr_has (local.get $a) (local.get $asidx))
            (then (return (call $arr_get (local.get $a) (local.get $asidx))))
            (else (return (call $get_prop (call $js_get_prototype (local.get $cont)) (local.get $key)))))))
      ;; named properties (a.foo, a[2**32-1], …) live in the @12 scope
      (let $aprops i32 (i32.load (i32.add (local.get $a) (i32.const 12))))
      (if (local.get $aprops)
        (then
          (let $apslot i32 (call $scope_find_local (local.get $aprops) (local.get $akey)))
          (if (local.get $apslot)
            (then
              (if (call $entry_is_accessor (local.get $apslot))  ;; a named accessor (defineProperty get/set on an array) → invoke getter
                (then (let $apg i64 (i64.load (call $val_payload (i64.load (local.get $apslot))))) (if (call $is_function (local.get $apg)) (then (return (call $call_fn0 (local.get $apg) (local.get $cont))))) (return (call $v_undef))))
              (return (i64.load (local.get $apslot)))))))
      ;; methods from Array.prototype (reg 160)
      (let $ap i32 (i32.load (i32.const 160)))
      (if (local.get $ap)
        (then
          (let $slot i32 (call $scope_find_local (local.get $ap) (local.get $akey)))
          (if (local.get $slot) (then (return (i64.load (local.get $slot)))))))
      ;; Object.prototype fallback (arrays inherit these) — return the STORED slot
      ;; so identity is stable (e.g. [].hasOwnProperty === Object.prototype.hasOwnProperty,
      ;; [].valueOf is defined). Invoke a getter if the slot is an accessor (e.g. __proto__).
      (let $op i32 (i32.load (i32.const 328)))
      (if (local.get $op)
        (then
          (let $oslot i32 (call $scope_find_local (local.get $op) (local.get $akey)))
          (if (local.get $oslot)
            (then
              (if (call $entry_is_accessor (local.get $oslot))
                (then (let $og i64 (i64.load (call $val_payload (i64.load (local.get $oslot))))) (if (call $is_function (local.get $og)) (then (return (call $call_fn0 (local.get $og) (local.get $cont))))) (return (call $v_undef))))
              (return (i64.load (local.get $oslot)))))))
      (return (call $v_undef))))
  (if (call $is_number (local.get $cont))  ;; number methods via Number.prototype (reg 164)
    (then
      (let $np i32 (i32.load (i32.const 164)))
      (if (local.get $np)
        (then
          (let $nslot i32 (call $scope_find_local (local.get $np) (call $to_prop_key (local.get $key))))
          (if (local.get $nslot) (then (return (i64.load (local.get $nslot)))))))
      (return (call $inherit_objproto (local.get $key) (local.get $cont)))))
  (if (call $is_boolean (local.get $cont))  ;; boolean methods via Boolean.prototype (reg 184)
    (then
      (let $bp i32 (i32.load (i32.const 184)))
      (if (local.get $bp)
        (then
          (let $bslot i32 (call $scope_find_local (local.get $bp) (call $to_prop_key (local.get $key))))
          (if (local.get $bslot) (then (return (i64.load (local.get $bslot)))))))
      (return (call $inherit_objproto (local.get $key) (local.get $cont)))))
  (if (call $is_bigint (local.get $cont))  ;; BigInt methods via BigInt.prototype (reg 624)
    (then
      (let $gbp i32 (i32.load (i32.const 624)))
      (if (local.get $gbp)
        (then
          (let $gbslot i32 (call $scope_find_local (local.get $gbp) (call $to_prop_key (local.get $key))))
          (if (local.get $gbslot) (then (return (i64.load (local.get $gbslot)))))))
      (return (call $inherit_objproto (local.get $key) (local.get $cont)))))
  (if (call $is_string (local.get $cont))
    (then
      (if (call $key_is_length (local.get $key))
        (then (return (call $num (f64.convert_i32_s (call $str_len (call $val_payload (local.get $cont))))))))
      (if (call $is_number (local.get $key))
        (then
          ;; only a finite in-range integer indexes a character; NaN / >=2^31 /
          ;; fractional fall through to property lookup → undefined (and guard the
          ;; trunc, which traps on NaN or out-of-i32-range floats)
          (let $kidx f64 (call $tonum_raw (local.get $key)))
          (if (i32.and (f64.eq (local.get $kidx) (local.get $kidx))
                (i32.and (f64.ge (local.get $kidx) (f64.const -2147483648))
                  (i32.and (f64.lt (local.get $kidx) (f64.const 2147483648))
                           (f64.eq (local.get $kidx) (f64.floor (local.get $kidx))))))
            (then (return (call $str_char_at (call $val_payload (local.get $cont)) (i32.trunc_f64_s (local.get $kidx))))))))
      ;; numeric-string key (e.g. "0") → canonical char index
      (if (call $is_string (local.get $key))
        (then
          (let $skidx i32 (call $str_array_index (call $val_payload (local.get $key))))
          (if (i32.and (i32.ge_s (local.get $skidx) (i32.const 0)) (i32.lt_s (local.get $skidx) (call $str_len (call $val_payload (local.get $cont)))))
            (then (return (call $str_char_at (call $val_payload (local.get $cont)) (local.get $skidx)))))))
      ;; methods / constructor from String.prototype (reg 156)
      (let $sp i32 (i32.load (i32.const 156)))
      (if (local.get $sp)
