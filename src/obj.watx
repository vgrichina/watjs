      (let $ks i32 (call $to_prop_key (local.get $key)))
      (let $slot i32 (call $scope_find (local.get $o) (local.get $ks)))
      (if (local.get $slot)  ;; guard before entry_kind (i32.and would deref slot-4 even when 0)
        (then
          (if (call $entry_is_accessor (local.get $slot))
            (then  ;; accessor → call setter
              (let $set i64 (i64.load (i32.add (call $val_payload (i64.load (local.get $slot))) (i32.const 8))))
              (if (call $is_function (local.get $set))
                (then
                  (let $av i32 (call $heap_alloc (i32.const 8)))
                  (i64.store (local.get $av) (local.get $val))
                  (drop (call $call_val (local.get $set) (i32.const 1) (local.get $av) (local.get $cont)))))
