        (then (return (call $mk_native (i32.const 93) (cstring "hasOwnProperty")))))
      (if (call $str_eq (call $to_prop_key (local.get $key)) (cstring "propertyIsEnumerable"))
        (then (return (call $mk_native (i32.const 159) (cstring "propertyIsEnumerable")))))
      (return (call $v_undef))))
  (if (call $is_function (local.get $cont))
    (then
      (let $fn i32 (call $val_payload (local.get $cont)))
      (let $ks i32 (call $to_prop_key (local.get $key)))
